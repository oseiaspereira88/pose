{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019BQmgR3ESaeTGhdHM79NJb","type":"tool_result","content":"800\t\n801\tfunc cmdReviewAttest(root string, args []string, stdout, stderr io.Writer) int {\n802\t\tif len(args) >= 2 && args[0] == \"--envelope\" {\n803\t\t\tapply := false\n804\t\t\tif len(args) == 3 && args[2] == \"--apply\" {\n805\t\t\t\tapply = true\n806\t\t\t} else if len(args) != 2 {\n807\t\t\t\tfmt.Fprintln(stderr, \"Usage: pose review attest --envelope <project-relative-path> [--apply]\")\n808\t\t\t\treturn 2\n809\t\t\t}\n810\t\t\tstore := cliGovernedStore(root)\n811\t\t\tattestation, err := store.ImportReviewAttestationEnvelope(args[1], apply)\n812\t\t\tif reportApprovalRefusal(stdout, stderr, \"pose review attest\", err) {\n813\t\t\t\treturn 1\n814\t\t\t}\n815\t\t\tif reportCommittedAttestation(store, stdout, stderr, \"pose review attest\", attestation, err) {\n816\t\t\t\treturn 0\n817\t\t\t}\n818\t\t\tif err != nil {\n819\t\t\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n820\t\t\t\treturn 1\n821\t\t\t}\n822\t\t\t// A verified signature is not an admissible approval: the preview\n823\t\t\t// reports what the domain writer would refuse (spec\n824\t\t\t// pose-review-approval-domain-preflight R6).\n825\t\t\tif refusals := store.PreflightReviewAttestation(attestation, time.Now()); !apply && len(refusals) > 0 {\n826\t\t\t\treportAttestPreflight(stdout, stderr, \"pose review attest\", refusals)\n827\t\t\t\treturn 1\n828\t\t\t}\n829\t\t\tfmt.Fprintf(stdout, \"review_attestation.envelope=verified\\nreview_attestation.id=%s\\nreview_attestation.bundle_id=%s\\nreview_attestation.apply=%t\\n\", attestation.AttestationID, attestation.BundleID, apply)\n830\t\t\treturn 0\n831\t\t}\n832\t\tvar target, reviewer, decision, expectedPlanDigest string\n833\t\tvar evidence, findings, rawTools, rawCriteria, rawMappings []string\n834\t\t// Attribution roles are explicit flags and never derived from --reviewer\n835\t\t// (spec pose-review-attribution-roles).\n836\t\tvar attribution posemodel.ReviewAttribution\n837\t\tattributed := false\n838\t\tapply := false\n839\t\t// A native issuer signs the attestation in place of recording it unsigned\n840\t\t// (spec pose-native-attestation-issuer).\n841\t\tvar signWith, reviewExecution, implementationPrincipal, implementationExecution, claimTTL, runID, runProof string\n842\t\tclaimAuthority := false\n843\t\tfor i := 0; i < len(args); i++ {\n844\t\t\tswitch args[i] {\n845\t\t\tcase \"--authority\":\n846\t\t\t\tclaimAuthority = true\n847\t\t\tcase \"--run\", \"--run-proof\", \"--sign\", \"--review-execution\", \"--implementation-principal\", \"--implementation-execution\", \"--claim-ttl\":\n848\t\t\t\tif i+1 >= len(args) {\n849\t\t\t\t\trender(stdout, stderr).Failure(\"pose review attest: missing option value\")\n850\t\t\t\t\treturn 2\n851\t\t\t\t}\n852\t\t\t\ti++\n853\t\t\t\tswitch args[i-1] {\n854\t\t\t\tcase \"--run\":\n855\t\t\t\t\trunID = args[i]\n856\t\t\t\tcase \"--run-proof\":\n857\t\t\t\t\trunProof = args[i]\n858\t\t\t\tcase \"--sign\":\n859\t\t\t\t\tsignWith = args[i]\n860\t\t\t\tcase \"--review-execution\":\n861\t\t\t\t\treviewExecution = args[i]\n862\t\t\t\tcase \"--implementation-principal\":\n863\t\t\t\t\timplementationPrincipal = args[i]\n864\t\t\t\tcase \"--implementation-execution\":\n865\t\t\t\t\timplementationExecution = args[i]\n866\t\t\t\tcase \"--claim-ttl\":\n867\t\t\t\t\tclaimTTL = args[i]\n868\t\t\t\t}\n869\t\t\tcase \"--prepared-by\", \"--concluded-by\", \"--confirmed-by\", \"--applied-by\", \"--confirmation-mode\":\n870\t\t\t\tif i+1 >= len(args) {\n871\t\t\t\t\trender(stdout, stderr).Failure(\"pose review attest: missing option value\")\n872\t\t\t\t\treturn 2\n873\t\t\t\t}\n874\t\t\t\ti++\n875\t\t\t\tattributed = true\n876\t\t\t\tswitch args[i-1] {\n877\t\t\t\tcase \"--prepared-by\":\n878\t\t\t\t\tattribution.PreparedBy = args[i]\n879\t\t\t\tcase \"--concluded-by\":\n880\t\t\t\t\tattribution.ConcludedBy = args[i]\n881\t\t\t\tcase \"--confirmed-by\":\n882\t\t\t\t\tattribution.ConfirmedBy = args[i]\n883\t\t\t\tcase \"--applied-by\":\n884\t\t\t\t\tattribution.AppliedBy = args[i]\n885\t\t\t\tcase \"--confirmation-mode\":\n886\t\t\t\t\tattribution.ConfirmationMode = args[i]\n887\t\t\t\t}\n888\t\t\tcase \"--reviewer\", \"--decision\", \"--evidence\", \"--finding\", \"--tool\", \"--criterion\", \"--mapping\", \"--plan-digest\":\n889\t\t\t\tif i+1 >= len(args) {\n890\t\t\t\t\tfmt.Fprintln(stderr, \"pose review attest: missing option value\")\n891\t\t\t\t\treturn 2\n892\t\t\t\t}\n893\t\t\t\ti++\n894\t\t\t\tswitch args[i-1] {\n895\t\t\t\tcase \"--reviewer\":\n896\t\t\t\t\treviewer = args[i]\n897\t\t\t\tcase \"--decision\":\n898\t\t\t\t\tdecision = args[i]\n899\t\t\t\tcase \"--evidence\":\n900\t\t\t\t\tevidence = append(evidence, args[i])\n901\t\t\t\tcase \"--finding\":\n902\t\t\t\t\tfindings = append(findings, args[i])\n903\t\t\t\tcase \"--criterion\":\n904\t\t\t\t\trawCriteria = append(rawCriteria, args[i])\n905\t\t\t\tcase \"--mapping\":\n906\t\t\t\t\trawMappings = append(rawMappings, args[i])\n907\t\t\t\tcase \"--tool\":\n908\t\t\t\t\trawTools = append(rawTools, args[i])\n909\t\t\t\tcase \"--plan-digest\":\n910\t\t\t\t\texpectedPlanDigest = args[i]\n911\t\t\t\t}\n912\t\t\tcase \"--apply\":\n913\t\t\t\tapply = true\n914\t\t\tdefault:\n915\t\t\t\tif strings.HasPrefix(args[i], \"-\") || target != \"\" {\n916\t\t\t\t\tfmt.Fprintf(stderr, \"pose review attest: unexpected argument %q\\n\", args[i])\n917\t\t\t\t\treturn 2\n918\t\t\t\t}\n919\t\t\t\ttarget = args[i]\n920\t\t\t}\n921\t\t}\n922\t\tif target == \"\" || reviewer == \"\" || decision == \"\" || len(evidence) == 0 {\n923\t\t\tfmt.Fprintln(stderr, \"pose review attest: bundle, reviewer, decision and at least one evidence ref are required\")\n924\t\t\treturn 2\n925\t\t}\n926\t\tstore := cliGovernedStore(root)\n927\t\tif runID != \"\" && store.IsDelegationTaskRun(runID) {\n928\t\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(posemodel.ErrDelegationTaskRun(runID).Error(), \"pose: \"))\n929\t\t\treturn 1\n930\t\t}\n931\t\tbundle, err := resolveReviewAttestBundle(store, target)\n932\t\tif err != nil {\n933\t\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n934\t\t\treturn 1\n935\t\t}\n936\t\tif expectedPlanDigest != \"\" && expectedPlanDigest != bundle.Payload.Plan.PlanDigest {\n937\t\t\tfmt.Fprintf(stderr, \"pose review attest: expected plan digest %s, current is %s\\n\", expectedPlanDigest, bundle.Payload.Plan.PlanDigest)\n938\t\t\treturn 1\n939\t\t}\n940\t\tplan := posemodel.ReviewPlan{Criteria: bundle.Payload.Plan.Criteria, Tools: bundle.Payload.Plan.Tools, Structure: bundle.Payload.Plan.Structure}\n941\t\t// The flags are decoded here; their admissibility is judged once, by the\n942\t\t// domain writer every channel shares (spec pose-review-approval-domain-preflight R7).\n943\t\ttools, err := decodeReviewToolDispositions(plan, rawTools)\n944\t\tif err != nil {\n945\t\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n946\t\t\treturn 2\n947\t\t}\n948\t\tparsedFindings, err := parseCLIReviewFindings(findings)\n949\t\tif err != nil {\n950\t\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n951\t\t\treturn 2\n952\t\t}\n953\t\tsort.Strings(evidence)\n954\t\tcriteria, err := reviewCriterionDispositions(plan, evidence, rawCriteria)\n955\t\tif err != nil {\n956\t\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n957\t\t\treturn 2\n958\t\t}\n959\t\tcriteria, err = applyReviewCriterionMappings(plan, criteria, rawMappings)\n960\t\tif err != nil {\n961\t\t\trender(stdout, stderr).Failure(fmt.Sprintf(\"pose review attest: %v\", err))\n962\t\t\treturn 2\n963\t\t}\n964\t\tatt := posemodel.ReviewAttestation{BundleID: bundle.BundleID, BundleDigest: bundle.BundleDigest, Reviewer: reviewer, Decision: decision, Criteria: criteria, Tools: tools, EvidenceRefs: evidence, Findings: parsedFindings}\n965\t\tif runID != \"\" || runProof != \"\" {\n966\t\t\tif runID == \"\" || runProof == \"\" || signWith == \"\" {\n967\t\t\t\treturn usageError(stderr, \"pose review attest: --run and --run-proof require each other and --sign\")\n968\t\t\t}\n969\t\t\tatt.Run = &posemodel.ReviewRunReference{RunID: runID, ProofID: runProof}\n970\t\t}\n971\t\tif attributed {\n972\t\t\tattribution.SchemaVersion = posemodel.ReviewAttributionSchemaVersion\n973\t\t\tatt.Attribution = &attribution\n974\t\t\tif attribution.ConfirmedBy != \"\" {\n975\t\t\t\t// The confirmation is bound to exactly what this command writes.\n976\t\t\t\tattribution.ConfirmationDigest = posemodel.ReviewConfirmationDigest(att)\n977\t\t\t}\n978\t\t\tif err := posemodel.ValidateReviewAttribution(att); err != nil {\n979\t\t\t\trender(stdout, stderr).Failure(fmt.Sprintf(\"pose review attest: %v\", err))\n980\t\t\t\treturn 2\n981\t\t\t}\n982\t\t}\n983\t\tif claimAuthority && signWith == \"\" {\n984\t\t\trender(stdout, stderr).Failure(\"pose review attest: --authority needs --sign <issuer>: a claim is only as good as its signature\")\n985\t\t\treturn 2\n986\t\t}\n987\t\tif signWith != \"\" {\n988\t\t\treturn signAndRecordAttestation(store, att, signWith, claimAuthority, reviewExecution, implementationPrincipal, implementationExecution, claimTTL, apply, stdout, stderr)\n989\t\t}\n990\t\tif !apply {\n991\t\t\t// The preview runs the domain writer's own admission; apply gets the\n992\t\t\t// same answer from the writer itself.\n993\t\t\tif refusals := store.PreflightReviewAttestation(att, time.Now()); len(refusals) > 0 {\n994\t\t\t\treportAttestPreflight(stdout, stderr, \"pose review attest\", refusals)\n995\t\t\t\treturn 1\n996\t\t\t}\n997\t\t\tfmt.Fprintf(stdout, \"review_attestation.plan=record\\nreview_attestation.bundle_id=%s\\nreview_attestation.bundle_digest=%s\\nreview_attestation.plan_digest=%s\\nreview_attestation.apply=false\\n\", bundle.BundleID, bundle.BundleDigest, bundle.Payload.Plan.PlanDigest)\n998\t\t\treturn 0\n999\t\t}\n1000\t\tatt, err = store.RecordReviewAttestation(att, time.Now())\n1001\t\tif reportApprovalRefusal(stdout, stderr, \"pose review attest\", err) {\n1002\t\t\treturn 1\n1003\t\t}\n1004\t\tif reportCommittedAttestation(store, stdout, stderr, \"pose review attest\", att, err) {\n1005\t\t\treturn 0\n1006\t\t}\n1007\t\tif err != nil {\n1008\t\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n1009\t\t\treturn 1\n1010\t\t}\n1011\t\tfmt.Fprintf(stdout, \"Review attestation recorded: %s\\n\", filepath.Join(root, filepath.FromSlash(att.Path)))\n1012\t\treturn 0\n1013\t}\n1014\t\n1015\t// signAndRecordAttestation signs att with a native issuer key and records it\n1016\t// through the same envelope verification an external issuer's envelope takes,\n1017\t// so a natively signed attestation is held to exactly the same proof.\n1018\tfunc signAndRecordAttestation(store posemodel.Store, att posemodel.ReviewAttestation, issuer string, claimAuthority bool, reviewExecution, implementationPrincipal, implementationExecution, claimTTL string, apply bool, stdout, stderr io.Writer) int {\n1019\t\tkey, err := posemodel.LoadIssuerKey(store.Root, issuer)\n1020\t\tif err != nil {\n1021\t\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n1022\t\t\treturn 1\n1023\t\t}\n1024\t\tvar authority *posemodel.NativeAuthority\n1025\t\tif claimAuthority {\n1026\t\t\tif reviewExecution == \"\" {\n1027\t\t\t\trender(stdout, stderr).Failure(\"pose review attest: --authority needs --review-execution <id> naming this review's run\")\n1028\t\t\t\treturn 2\n1029\t\t\t}\n1030\t\t\tauthority = &posemodel.NativeAuthority{ReviewExecution: reviewExecution, ImplementationPrincipal: implementationPrincipal, ImplementationExecution: implementationExecution}\n1031\t\t\tif claimTTL != \"\" {\n1032\t\t\t\tttl, err := time.ParseDuration(claimTTL)\n1033\t\t\t\tif err != nil || ttl <= 0 {\n1034\t\t\t\t\trender(stdout, stderr).Failure(\"pose review attest: --claim-ttl must be a positive duration such as 720h\")\n1035\t\t\t\t\treturn 2\n1036\t\t\t\t}\n1037\t\t\t\tauthority.TTL = ttl\n1038\t\t\t}\n1039\t\t}\n1040\t\tnow := time.Now()\n1041\t\tenvelope, err := store.SignReviewAttestation(att, key, authority, now)\n1042\t\tif err != nil {\n1043\t\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n1044\t\t\treturn 1\n1045\t\t}\n1046\t\t// Verify the envelope first: the preflight has to see the attestation as\n1047\t\t// it will be recorded, signature included.\n1048\t\tverified, err := store.RecordReviewAttestationEnvelope(envelope, false)\n1049\t\tif err != nil {\n1050\t\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n1051\t\t\treturn 1\n1052\t\t}\n1053\t\tif refusals := store.PreflightReviewAttestation(verified, now); !apply && len(refusals) > 0 {\n1054\t\t\treportAttestPreflight(stdout, stderr, \"pose review attest\", refusals)\n1055\t\t\treturn 1\n1056\t\t}\n1057\t\trecorded := verified\n1058\t\tif apply {\n1059\t\t\trecorded, err = store.RecordReviewAttestationEnvelope(envelope, true)\n1060\t\t\tif reportApprovalRefusal(stdout, stderr, \"pose review attest\", err) {\n1061\t\t\t\treturn 1\n1062\t\t\t}\n1063\t\t\tif reportCommittedAttestation(store, stdout, stderr, \"pose review attest\", recorded, err) {\n1064\t\t\t\treturn 0\n1065\t\t\t}\n1066\t\t\tif err != nil {\n1067\t\t\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n1068\t\t\t\treturn 1\n1069\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"80dbe885-2788-40c9-9897-bbed5ab60b46","timestamp":"2026-11-28T02:44:46.062Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-6ee95d62f8/worktree/pose-mcp/internal/cli/review_closeout.go","content":"\nfunc cmdReviewAttest(root string, args []string, stdout, stderr io.Writer) int {\n\tif len(args) >= 2 && args[0] == \"--envelope\" {\n\t\tapply := false\n\t\tif len(args) == 3 && args[2] == \"--apply\" {\n\t\t\tapply = true\n\t\t} else if len(args) != 2 {\n\t\t\tfmt.Fprintln(stderr, \"Usage: pose review attest --envelope <project-relative-path> [--apply]\")\n\t\t\treturn 2\n\t\t}\n\t\tstore := cliGovernedStore(root)\n\t\tattestation, err := store.ImportReviewAttestationEnvelope(args[1], apply)\n\t\tif reportApprovalRefusal(stdout, stderr, \"pose review attest\", err) {\n\t\t\treturn 1\n\t\t}\n\t\tif reportCommittedAttestation(store, stdout, stderr, \"pose review attest\", attestation, err) {\n\t\t\treturn 0\n\t\t}\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\t// A verified signature is not an admissible approval: the preview\n\t\t// reports what the domain writer would refuse (spec\n\t\t// pose-review-approval-domain-preflight R6).\n\t\tif refusals := store.PreflightReviewAttestation(attestation, time.Now()); !apply && len(refusals) > 0 {\n\t\t\treportAttestPreflight(stdout, stderr, \"pose review attest\", refusals)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"review_attestation.envelope=verified\\nreview_attestation.id=%s\\nreview_attestation.bundle_id=%s\\nreview_attestation.apply=%t\\n\", attestation.AttestationID, attestation.BundleID, apply)\n\t\treturn 0\n\t}\n\tvar target, reviewer, decision, expectedPlanDigest string\n\tvar evidence, findings, rawTools, rawCriteria, rawMappings []string\n\t// Attribution roles are explicit flags and never derived from --reviewer\n\t// (spec pose-review-attribution-roles).\n\tvar attribution posemodel.ReviewAttribution\n\tattributed := false\n\tapply := false\n\t// A native issuer signs the attestation in place of recording it unsigned\n\t// (spec pose-native-attestation-issuer).\n\tvar signWith, reviewExecution, implementationPrincipal, implementationExecution, claimTTL, runID, runProof string\n\tclaimAuthority := false\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--authority\":\n\t\t\tclaimAuthority = true\n\t\tcase \"--run\", \"--run-proof\", \"--sign\", \"--review-execution\", \"--implementation-principal\", \"--implementation-execution\", \"--claim-ttl\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\trender(stdout, stderr).Failure(\"pose review attest: missing option value\")\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\ti++\n\t\t\tswitch args[i-1] {\n\t\t\tcase \"--run\":\n\t\t\t\trunID = args[i]\n\t\t\tcase \"--run-proof\":\n\t\t\t\trunProof = args[i]\n\t\t\tcase \"--sign\":\n\t\t\t\tsignWith = args[i]\n\t\t\tcase \"--review-execution\":\n\t\t\t\treviewExecution = args[i]\n\t\t\tcase \"--implementation-principal\":\n\t\t\t\timplementationPrincipal = args[i]\n\t\t\tcase \"--implementation-execution\":\n\t\t\t\timplementationExecution = args[i]\n\t\t\tcase \"--claim-ttl\":\n\t\t\t\tclaimTTL = args[i]\n\t\t\t}\n\t\tcase \"--prepared-by\", \"--concluded-by\", \"--confirmed-by\", \"--applied-by\", \"--confirmation-mode\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\trender(stdout, stderr).Failure(\"pose review attest: missing option value\")\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\ti++\n\t\t\tattributed = true\n\t\t\tswitch args[i-1] {\n\t\t\tcase \"--prepared-by\":\n\t\t\t\tattribution.PreparedBy = args[i]\n\t\t\tcase \"--concluded-by\":\n\t\t\t\tattribution.ConcludedBy = args[i]\n\t\t\tcase \"--confirmed-by\":\n\t\t\t\tattribution.ConfirmedBy = args[i]\n\t\t\tcase \"--applied-by\":\n\t\t\t\tattribution.AppliedBy = args[i]\n\t\t\tcase \"--confirmation-mode\":\n\t\t\t\tattribution.ConfirmationMode = args[i]\n\t\t\t}\n\t\tcase \"--reviewer\", \"--decision\", \"--evidence\", \"--finding\", \"--tool\", \"--criterion\", \"--mapping\", \"--plan-digest\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\tfmt.Fprintln(stderr, \"pose review attest: missing option value\")\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\ti++\n\t\t\tswitch args[i-1] {\n\t\t\tcase \"--reviewer\":\n\t\t\t\treviewer = args[i]\n\t\t\tcase \"--decision\":\n\t\t\t\tdecision = args[i]\n\t\t\tcase \"--evidence\":\n\t\t\t\tevidence = append(evidence, args[i])\n\t\t\tcase \"--finding\":\n\t\t\t\tfindings = append(findings, args[i])\n\t\t\tcase \"--criterion\":\n\t\t\t\trawCriteria = append(rawCriteria, args[i])\n\t\t\tcase \"--mapping\":\n\t\t\t\trawMappings = append(rawMappings, args[i])\n\t\t\tcase \"--tool\":\n\t\t\t\trawTools = append(rawTools, args[i])\n\t\t\tcase \"--plan-digest\":\n\t\t\t\texpectedPlanDigest = args[i]\n\t\t\t}\n\t\tcase \"--apply\":\n\t\t\tapply = true\n\t\tdefault:\n\t\t\tif strings.HasPrefix(args[i], \"-\") || target != \"\" {\n\t\t\t\tfmt.Fprintf(stderr, \"pose review attest: unexpected argument %q\\n\", args[i])\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\ttarget = args[i]\n\t\t}\n\t}\n\tif target == \"\" || reviewer == \"\" || decision == \"\" || len(evidence) == 0 {\n\t\tfmt.Fprintln(stderr, \"pose review attest: bundle, reviewer, decision and at least one evidence ref are required\")\n\t\treturn 2\n\t}\n\tstore := cliGovernedStore(root)\n\tif runID != \"\" && store.IsDelegationTaskRun(runID) {\n\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(posemodel.ErrDelegationTaskRun(runID).Error(), \"pose: \"))\n\t\treturn 1\n\t}\n\tbundle, err := resolveReviewAttestBundle(store, target)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif expectedPlanDigest != \"\" && expectedPlanDigest != bundle.Payload.Plan.PlanDigest {\n\t\tfmt.Fprintf(stderr, \"pose review attest: expected plan digest %s, current is %s\\n\", expectedPlanDigest, bundle.Payload.Plan.PlanDigest)\n\t\treturn 1\n\t}\n\tplan := posemodel.ReviewPlan{Criteria: bundle.Payload.Plan.Criteria, Tools: bundle.Payload.Plan.Tools, Structure: bundle.Payload.Plan.Structure}\n\t// The flags are decoded here; their admissibility is judged once, by the\n\t// domain writer every channel shares (spec pose-review-approval-domain-preflight R7).\n\ttools, err := decodeReviewToolDispositions(plan, rawTools)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n\t\treturn 2\n\t}\n\tparsedFindings, err := parseCLIReviewFindings(findings)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n\t\treturn 2\n\t}\n\tsort.Strings(evidence)\n\tcriteria, err := reviewCriterionDispositions(plan, evidence, rawCriteria)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n\t\treturn 2\n\t}\n\tcriteria, err = applyReviewCriterionMappings(plan, criteria, rawMappings)\n\tif err != nil {\n\t\trender(stdout, stderr).Failure(fmt.Sprintf(\"pose review attest: %v\", err))\n\t\treturn 2\n\t}\n\tatt := posemodel.ReviewAttestation{BundleID: bundle.BundleID, BundleDigest: bundle.BundleDigest, Reviewer: reviewer, Decision: decision, Criteria: criteria, Tools: tools, EvidenceRefs: evidence, Findings: parsedFindings}\n\tif runID != \"\" || runProof != \"\" {\n\t\tif runID == \"\" || runProof == \"\" || signWith == \"\" {\n\t\t\treturn usageError(stderr, \"pose review attest: --run and --run-proof require each other and --sign\")\n\t\t}\n\t\tatt.Run = &posemodel.ReviewRunReference{RunID: runID, ProofID: runProof}\n\t}\n\tif attributed {\n\t\tattribution.SchemaVersion = posemodel.ReviewAttributionSchemaVersion\n\t\tatt.Attribution = &attribution\n\t\tif attribution.ConfirmedBy != \"\" {\n\t\t\t// The confirmation is bound to exactly what this command writes.\n\t\t\tattribution.ConfirmationDigest = posemodel.ReviewConfirmationDigest(att)\n\t\t}\n\t\tif err := posemodel.ValidateReviewAttribution(att); err != nil {\n\t\t\trender(stdout, stderr).Failure(fmt.Sprintf(\"pose review attest: %v\", err))\n\t\t\treturn 2\n\t\t}\n\t}\n\tif claimAuthority && signWith == \"\" {\n\t\trender(stdout, stderr).Failure(\"pose review attest: --authority needs --sign <issuer>: a claim is only as good as its signature\")\n\t\treturn 2\n\t}\n\tif signWith != \"\" {\n\t\treturn signAndRecordAttestation(store, att, signWith, claimAuthority, reviewExecution, implementationPrincipal, implementationExecution, claimTTL, apply, stdout, stderr)\n\t}\n\tif !apply {\n\t\t// The preview runs the domain writer's own admission; apply gets the\n\t\t// same answer from the writer itself.\n\t\tif refusals := store.PreflightReviewAttestation(att, time.Now()); len(refusals) > 0 {\n\t\t\treportAttestPreflight(stdout, stderr, \"pose review attest\", refusals)\n\t\t\treturn 1\n\t\t}\n\t\tfmt.Fprintf(stdout, \"review_attestation.plan=record\\nreview_attestation.bundle_id=%s\\nreview_attestation.bundle_digest=%s\\nreview_attestation.plan_digest=%s\\nreview_attestation.apply=false\\n\", bundle.BundleID, bundle.BundleDigest, bundle.Payload.Plan.PlanDigest)\n\t\treturn 0\n\t}\n\tatt, err = store.RecordReviewAttestation(att, time.Now())\n\tif reportApprovalRefusal(stdout, stderr, \"pose review attest\", err) {\n\t\treturn 1\n\t}\n\tif reportCommittedAttestation(store, stdout, stderr, \"pose review attest\", att, err) {\n\t\treturn 0\n\t}\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose review attest: %v\\n\", err)\n\t\treturn 1\n\t}\n\tfmt.Fprintf(stdout, \"Review attestation recorded: %s\\n\", filepath.Join(root, filepath.FromSlash(att.Path)))\n\treturn 0\n}\n\n// signAndRecordAttestation signs att with a native issuer key and records it\n// through the same envelope verification an external issuer's envelope takes,\n// so a natively signed attestation is held to exactly the same proof.\nfunc signAndRecordAttestation(store posemodel.Store, att posemodel.ReviewAttestation, issuer string, claimAuthority bool, reviewExecution, implementationPrincipal, implementationExecution, claimTTL string, apply bool, stdout, stderr io.Writer) int {\n\tkey, err := posemodel.LoadIssuerKey(store.Root, issuer)\n\tif err != nil {\n\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n\t\treturn 1\n\t}\n\tvar authority *posemodel.NativeAuthority\n\tif claimAuthority {\n\t\tif reviewExecution == \"\" {\n\t\t\trender(stdout, stderr).Failure(\"pose review attest: --authority needs --review-execution <id> naming this review's run\")\n\t\t\treturn 2\n\t\t}\n\t\tauthority = &posemodel.NativeAuthority{ReviewExecution: reviewExecution, ImplementationPrincipal: implementationPrincipal, ImplementationExecution: implementationExecution}\n\t\tif claimTTL != \"\" {\n\t\t\tttl, err := time.ParseDuration(claimTTL)\n\t\t\tif err != nil || ttl <= 0 {\n\t\t\t\trender(stdout, stderr).Failure(\"pose review attest: --claim-ttl must be a positive duration such as 720h\")\n\t\t\t\treturn 2\n\t\t\t}\n\t\t\tauthority.TTL = ttl\n\t\t}\n\t}\n\tnow := time.Now()\n\tenvelope, err := store.SignReviewAttestation(att, key, authority, now)\n\tif err != nil {\n\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n\t\treturn 1\n\t}\n\t// Verify the envelope first: the preflight has to see the attestation as\n\t// it will be recorded, signature included.\n\tverified, err := store.RecordReviewAttestationEnvelope(envelope, false)\n\tif err != nil {\n\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n\t\treturn 1\n\t}\n\tif refusals := store.PreflightReviewAttestation(verified, now); !apply && len(refusals) > 0 {\n\t\treportAttestPreflight(stdout, stderr, \"pose review attest\", refusals)\n\t\treturn 1\n\t}\n\trecorded := verified\n\tif apply {\n\t\trecorded, err = store.RecordReviewAttestationEnvelope(envelope, true)\n\t\tif reportApprovalRefusal(stdout, stderr, \"pose review attest\", err) {\n\t\t\treturn 1\n\t\t}\n\t\tif reportCommittedAttestation(store, stdout, stderr, \"pose review attest\", recorded, err) {\n\t\t\treturn 0\n\t\t}\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose review attest: \" + strings.TrimPrefix(err.Error(), \"pose: \"))\n\t\t\treturn 1\n\t\t}","numLines":270,"startLine":800,"totalLines":2620}},"tool_result_meta":[{"id":"toolu_019BQmgR3ESaeTGhdHM79NJb","permission_decision