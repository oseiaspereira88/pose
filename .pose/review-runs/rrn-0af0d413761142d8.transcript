{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"git status --short && nl -ba pose-mcp/internal/pose/accepted_limits.go | sed -n '1,155p' && nl -ba pose-mcp/internal/cli/lintspec.go | sed -n '1190,1230p' && test -x /var/tmp/pose-work-go/pose-ready && ls -l /var/tmp/pose-work-go/pose-ready\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Accepted limits (spec pose-review-declared-threat-model): a spec declares\n     4\t// the residual limits of a guarantee it makes, each with a stable id and why\n     5\t// it is accepted. The review plan seals them; the brief lists them; a\n     6\t// reviewer classifies a finding that falls inside one as within that limit,\n     7\t// or disputes the limit as a finding of its own. A declared limit never\n     8\t// hides a defect inside the declared scope: it is visible in the bundle, the\n     9\t// brief and the attestation.\n    10\t\n    11\timport (\n    12\t\t\"regexp\"\n    13\t\t\"strings\"\n    14\t)\n    15\t\n    16\t// ReviewAcceptedLimit is one declared residual limit.\n    17\ttype ReviewAcceptedLimit struct {\n    18\t\tID   string `json:\"id\"`\n    19\t\tText string `json:\"text\"`\n    20\t\t// Spec names the spec that declared the limit when the scope holds more\n    21\t\t// than one; the id is then qualified as <spec>#L<N> (review round 1, N1).\n    22\t\tSpec string `json:\"spec,omitempty\"`\n    23\t}\n    24\t\n    25\tvar acceptedLimitRE = regexp.MustCompile(`^-\\s+(L[1-9][0-9]*):\\s+(.+)$`)\n    26\t\n    27\t// acceptedLimitReasonRE finds the reason that follows the marker.\n    28\tvar acceptedLimitReasonRE = regexp.MustCompile(`(?i)(?:accepted because|aceito porque)(.*)$`)\n    29\t\n    30\t// acceptedLimitReasonWordRE is a word with at least one letter.\n    31\tvar acceptedLimitReasonWordRE = regexp.MustCompile(`\\p{L}+`)\n    32\t\n    33\t// hasAcceptedLimitReason requires a reason after the marker of at least two\n    34\t// words with letters: neither the marker alone (review round 1, N2) nor\n    35\t// punctuation (round 2, N1) says why a limit is accepted.\n    36\tfunc hasAcceptedLimitReason(text string) bool {\n    37\t\tm := acceptedLimitReasonRE.FindStringSubmatch(text)\n    38\t\treturn m != nil && len(acceptedLimitReasonWordRE.FindAllString(m[1], -1)) >= 2\n    39\t}\n    40\t\n    41\t// ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n    42\t// It returns the limits and the problems that keep the section from being\n    43\t// read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n    44\t// limit that does not say why it is accepted (\"Accepted because ...\" or\n    45\t// \"Aceito porque ...\").\n    46\tfunc ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n    47\t\tvar limits []ReviewAcceptedLimit\n    48\t\tvar problems []string\n    49\t\tin := false\n    50\t\tseen := map[string]bool{}\n    51\t\tfor _, line := range strings.Split(body, \"\\n\") {\n    52\t\t\ttrimmed := strings.TrimSpace(line)\n    53\t\t\tif strings.HasPrefix(trimmed, \"#\") {\n    54\t\t\t\tin = strings.EqualFold(strings.TrimSpace(strings.TrimLeft(trimmed, \"#\")), \"Accepted limits\") || strings.EqualFold(strings.TrimSpace(strings.TrimLeft(trimmed, \"#\")), \"Limites aceitos\")\n    55\t\t\t\tcontinue\n    56\t\t\t}\n    57\t\t\tif !in || !strings.HasPrefix(trimmed, \"- \") {\n    58\t\t\t\tcontinue\n    59\t\t\t}\n    60\t\t\tm := acceptedLimitRE.FindStringSubmatch(trimmed)\n    61\t\t\tif m == nil {\n    62\t\t\t\tproblems = append(problems, \"accepted limit \"+quoteLedgerText(trimmed)+\" is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n    63\t\t\t\tcontinue\n    64\t\t\t}\n    65\t\t\tif seen[m[1]] {\n    66\t\t\t\tproblems = append(problems, \"accepted limit \"+m[1]+\" is declared twice\")\n    67\t\t\t\tcontinue\n    68\t\t\t}\n    69\t\t\tseen[m[1]] = true\n    70\t\t\tif !hasAcceptedLimitReason(m[2]) {\n    71\t\t\t\tproblems = append(problems, \"accepted limit \"+m[1]+\" does not say why it is accepted ('Accepted because ...')\")\n    72\t\t\t}\n    73\t\t\tlimits = append(limits, ReviewAcceptedLimit{ID: m[1], Text: strings.TrimSpace(m[2])})\n    74\t\t}\n    75\t\treturn limits, problems\n    76\t}\n    77\t\n    78\t// acceptedLimitsOf collects the limits the scope's specs declare.\n    79\tfunc (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n    80\t\tspecs, err := s.reviewScopeSpecs(scope)\n    81\t\tif err != nil {\n    82\t\t\treturn nil\n    83\t\t}\n    84\t\treturn acceptedLimitsOfSpecs(specs)\n    85\t}\n    86\t\n    87\t// acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\n    88\t// by its spec when there is more than one spec.\n    89\tfunc acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\n    90\t\tvar out []ReviewAcceptedLimit\n    91\t\tfor _, spec := range specs {\n    92\t\t\tlimits, _ := ParseAcceptedLimits(spec.Body)\n    93\t\t\tfor _, l := range limits {\n    94\t\t\t\t// Ids are spec-local: across specs each is qualified by its spec,\n    95\t\t\t\t// so a finding names exactly one sealed limit.\n    96\t\t\t\tif len(specs) > 1 {\n    97\t\t\t\t\tl.ID, l.Spec = spec.Slug+\"#\"+l.ID, spec.Slug\n    98\t\t\t\t}\n    99\t\t\t\tout = append(out, l)\n   100\t\t\t}\n   101\t\t}\n   102\t\treturn out\n   103\t}\n   104\t\n   105\t// sealedAcceptedLimit reports whether the bundle sealed limit id.\n   106\tfunc sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n   107\t\tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\n   108\t\t\tif l.ID == id {\n   109\t\t\t\treturn true\n   110\t\t\t}\n   111\t\t}\n   112\t\treturn false\n   113\t}\n  1190\t\tentries, err := os.ReadDir(filepath.Join(root, \".pose\", \"adr\"))\n  1191\t\tif err != nil {\n  1192\t\t\treturn nil\n  1193\t\t}\n  1194\t\tvar citing []string\n  1195\t\tfor _, e := range entries {\n  1196\t\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".md\") {\n  1197\t\t\t\tcontinue\n  1198\t\t\t}\n  1199\t\t\traw, err := os.ReadFile(filepath.Join(root, \".pose\", \"adr\", e.Name()))\n  1200\t\t\tif err != nil || !strings.Contains(string(raw), slug) {\n  1201\t\t\t\tcontinue\n  1202\t\t\t}\n  1203\t\t\tciting = append(citing, string(raw))\n  1204\t\t}\n  1205\t\tif len(citing) == 0 {\n  1206\t\t\treturn nil\n  1207\t\t}\n  1208\t\tvar missing []string\n  1209\t\tfor _, l := range limits {\n  1210\t\t\tfound := false\n  1211\t\t\t// The id as a word: L10 does not name L1 (review round 1, N3).\n  1212\t\t\tnamed := regexp.MustCompile(`\\b` + regexp.QuoteMeta(l.ID) + `\\b`)\n  1213\t\t\tfor _, adr := range citing {\n  1214\t\t\t\tfound = found || named.MatchString(adr)\n  1215\t\t\t}\n  1216\t\t\tif !found {\n  1217\t\t\t\tmissing = append(missing, \"DoR: accepted limit \"+l.ID+\" is not named by the ADR that cites \"+slug)\n  1218\t\t\t}\n  1219\t\t}\n  1220\t\treturn missing\n  1221\t}\n-rwxr-xr-x 1 go go 49260557 Nov 25 15:19 /var/tmp/pose-work-go/pose-ready\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/accepted_limits_test.go | sed -n '1,190p' && git diff --stat 4151a841a5b2a1f99d563dd44a087afadb8fac77..f00c140e5c2fe4c70e1f2c3c4ec40a7bfc34678e && git diff --unified=80 4151a841a5b2a1f99d563dd44a087afadb8fac77..f00c140e5c2fe4c70e1f2c3c4ec40a7bfc34678e -- pose-mcp/internal/pose/accepted_limits.go pose-mcp/internal/pose/accepted_limits_test.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/accepted_limits_test.go | sed -n '1,190p' && git diff --stat 4151a841a5b2a1f99d563dd44a087afadb8fac77..f00c140e5c2fe4c70e1f2c3c4ec40a7bfc34678e && git diff --unified=80 4151a841a5b2a1f99d563dd44a087afadb8fac77..f00c140e5c2fe4c70e1f2c3c4ec40a7bfc34678e -- pose-mcp/internal/pose/accepted_limits.go pose-mcp/internal/pose/accepted_limits_test.go\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"os\"\n     5\t\t\"path/filepath\"\n     6\t\t\"strings\"\n     7\t\t\"testing\"\n     8\t)\n     9\t\n    10\tconst limitsSection = `\n    11\t### Accepted limits\n    12\t- L1: A process that clears its environment escapes. Accepted because the shim covers it.\n    13\t- L2: Windows is untested here. Accepted because the host is Linux.\n    14\t`\n    15\t\n    16\t// Spec pose-review-declared-threat-model R1: the section is read as\n    17\t// written, and what does not say why it is accepted is reported.\n    18\tfunc TestAcceptedLimitsAreParsed(t *testing.T) {\n    19\t\tlimits, problems := ParseAcceptedLimits(\"## 3. Technical Plan\\n\" + limitsSection + \"\\n### Other\\n- L9: not a limit here.\\n\")\n    20\t\tif len(problems) != 0 || len(limits) != 2 || limits[0].ID != \"L1\" || limits[1].ID != \"L2\" {\n    21\t\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n    22\t\t}\n    23\t\t_, problems = ParseAcceptedLimits(\"### Accepted limits\\n- L1: no reason given.\\n- L1: twice. Accepted because yes.\\n- X1: wrong id. Accepted because no.\\n- L3: a marker with nothing after it. Accepted because\\n\")\n    24\t\tjoined := strings.Join(problems, \"\\n\")\n    25\t\tfor _, want := range []string{\"L1 does not say why it is accepted\", \"L1 is declared twice\", \"is not written as\", \"L3 does not say why it is accepted\"} {\n    26\t\t\tif !strings.Contains(joined, want) {\n    27\t\t\t\tt.Fatalf(\"missing problem %q in %v\", want, problems)\n    28\t\t\t}\n    29\t\t}\n    30\t}\n    31\t\n    32\t// R1: the review plan seals the limits the spec declares, and they enter the\n    33\t// plan digest; a spec without limits keeps its digest.\n    34\tfunc TestTheReviewPlanSealsTheAcceptedLimits(t *testing.T) {\n    35\t\troot, store := reviewBundleFixture(t)\n    36\t\tbefore, err := store.ReviewPlan(\"spec:backend\")\n    37\t\tif err != nil || len(before.AcceptedLimits) != 0 {\n    38\t\t\tt.Fatalf(\"plan without limits: %+v %v\", before.AcceptedLimits, err)\n    39\t\t}\n    40\t\tpath := filepath.Join(root, \".pose/specs/backend/spec.md\")\n    41\t\traw, _ := os.ReadFile(path)\n    42\t\tif err := os.WriteFile(path, []byte(strings.Replace(string(raw), \"### Technical risks\", strings.TrimPrefix(limitsSection, \"\\n\")+\"\\n### Technical risks\", 1)), 0o644); err != nil {\n    43\t\t\tt.Fatal(err)\n    44\t\t}\n    45\t\tafter, err := store.ReviewPlan(\"spec:backend\")\n    46\t\tif err != nil || len(after.AcceptedLimits) != 2 || after.AcceptedLimits[0].ID != \"L1\" {\n    47\t\t\tt.Fatalf(\"plan with limits: %+v %v\", after.AcceptedLimits, err)\n    48\t\t}\n    49\t\twithout := after\n    50\t\twithout.AcceptedLimits = nil\n    51\t\tif digest, err := digestReviewPlan(without); err != nil || digest == after.PlanDigest {\n    52\t\t\tt.Fatalf(\"the accepted limits did not enter the plan digest: %v\", err)\n    53\t\t}\n    54\t}\n    55\t\n    56\t// R2, R3: a follow-up the reviewer classifies inside a sealed limit is\n    57\t// recorded within-limit, naming it, and does not block an approval whatever\n    58\t// its severity; a limit the bundle did not seal accepts nothing.\n    59\tfunc TestAFindingWithinASealedLimitDoesNotBlockApproval(t *testing.T) {\n    60\t\tvar bundle ReviewBundle\n    61\t\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"x. Accepted because y.\"}}\n    62\t\tdraft := ReviewDraft{Decision: \"approved\", Findings: []ReviewDraftFinding{\n    63\t\t\t{ID: \"N1\", Severity: \"high\", Disposition: \"follow-up\", Summary: \"an orphan that clears its environment escapes; that is L1\", Limit: \"L1\"},\n    64\t\t}}\n    65\t\tatt := reviewAttestationFromDraft(ReviewRun{RunID: \"rrn-0000000000000001\"}, bundle, draft, \"agent:reviewer\")\n    66\t\tif len(att.Findings) != 1 || att.Findings[0].Disposition != \"within-limit\" || att.Findings[0].Limit != \"L1\" {\n    67\t\t\tt.Fatalf(\"the finding was not recorded within its limit: %+v\", att.Findings)\n    68\t\t}\n    69\t\tatt.Decision = \"approved\"\n    70\t\tif blockers := reviewFindingDecisionBlockers(bundle, att); len(blockers) != 0 {\n    71\t\t\tt.Fatalf(\"a finding within a sealed limit blocked the approval: %v\", blockers)\n    72\t\t}\n    73\t\tatt.Findings[0].Limit = \"L9\"\n    74\t\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"L9, which this bundle did not seal\") {\n    75\t\t\tt.Fatalf(\"an unsealed limit was accepted: %s\", blockers)\n    76\t\t}\n    77\t\tatt.Findings[0].Limit, att.Findings[0].Rationale = \"L1\", \"\"\n    78\t\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"without saying why\") {\n    79\t\t\tt.Fatalf(\"a finding within a limit without a reason was accepted: %s\", blockers)\n    80\t\t}\n    81\t}\n    82\t\n    83\t// Review round 1, N1: across the specs of a composite scope each limit is\n    84\t// qualified by its spec, so a finding names exactly one.\n    85\tfunc TestLimitsAcrossSpecsAreQualified(t *testing.T) {\n    86\t\tbody := \"### Accepted limits\\n- L1: one. Accepted because it is rare.\\n\"\n    87\t\tsingle := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}})\n    88\t\tif len(single) != 1 || single[0].ID != \"L1\" || single[0].Spec != \"\" {\n    89\t\t\tt.Fatalf(\"a single spec's limit was qualified: %+v\", single)\n    90\t\t}\n    91\t\tboth := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}, {Slug: \"beta\", Body: body}})\n    92\t\tif len(both) != 2 || both[0].ID != \"alpha#L1\" || both[1].ID != \"beta#L1\" || both[1].Spec != \"beta\" {\n    93\t\t\tt.Fatalf(\"limits across specs are ambiguous: %+v\", both)\n    94\t\t}\n    95\t}\n    96\t\n    97\t// Review round 2, N1: punctuation is not a reason, and a reason may start\n    98\t// with a one-letter word.\n    99\tfunc TestAnAcceptedLimitNeedsWordsAsItsReason(t *testing.T) {\n   100\t\tfor text, want := range map[string]bool{\n   101\t\t\t\"x. Accepted because ..\":                false,\n   102\t\t\t\"x. Accepted because -- !\":              false,\n   103\t\t\t\"x. Accepted because rare\":              false,\n   104\t\t\t\"x. Accepted because a shim covers it.\": true,\n   105\t\t\t\"x. Aceito porque o shim cobre o caso.\": true,\n   106\t\t} {\n   107\t\t\tif got := hasAcceptedLimitReason(text); got != want {\n   108\t\t\t\tt.Errorf(\"%q: reason=%t, want %t\", text, got, want)\n   109\t\t\t}\n   110\t\t}\n   111\t}\n .pose/indexes/delivery-integrity.json              |  898 ++---\n .pose/indexes/generation.json                      |   12 +-\n .pose/indexes/spec-graph.json                      | 1172 +++----\n .pose/results/delivery-validation.json             |  946 ++---\n .pose/results/threat-binding.md                    |    1 +\n .../d75f4a25d6e1952cff849907/000001.json           |   11 +\n .../d75f4a25d6e1952cff849907/000001.result.json    |    6 +\n .../review-attestations/rva-2f60516517cbd191.json  |  209 ++\n .pose/review-bundles/rvb-7fc937432992b746.json     | 3666 ++++++++++++++++++++\n .pose/review-conclusions/rrn-256db7e6eea5a6e2.json |   13 +\n .pose/review-run-ledger/rrn-256db7e6eea5a6e2.json  |    8 +\n ...e8abf7befe84dad9609c882b7f6c46ff0ca3ae0378.json |   23 +\n .../review-runs/rrn-256db7e6eea5a6e2.events.ndjson |   77 +\n .pose/review-runs/rrn-256db7e6eea5a6e2.json        |  154 +\n .pose/review-runs/rrn-256db7e6eea5a6e2.transcript  |   81 +\n ...2026-11-23-pose-review-declared-threat-model.md |    3 +-\n pose-mcp/internal/pose/accepted_limits.go          |   18 +-\n pose-mcp/internal/pose/accepted_limits_test.go     |   16 +\n 18 files changed, 5798 insertions(+), 1516 deletions(-)\ndiff --git a/pose-mcp/internal/pose/accepted_limits.go b/pose-mcp/internal/pose/accepted_limits.go\nindex d3a80ffe..853c8a5f 100644\n--- a/pose-mcp/internal/pose/accepted_limits.go\n+++ b/pose-mcp/internal/pose/accepted_limits.go\n@@ -1,103 +1,113 @@\n package pose\n \n // Accepted limits (spec pose-review-declared-threat-model): a spec declares\n // the residual limits of a guarantee it makes, each with a stable id and why\n // it is accepted. The review plan seals them; the brief lists them; a\n // reviewer classifies a finding that falls inside one as within that limit,\n // or disputes the limit as a finding of its own. A declared limit never\n // hides a defect inside the declared scope: it is visible in the bundle, the\n // brief and the attestation.\n \n import (\n \t\"regexp\"\n \t\"strings\"\n )\n \n // ReviewAcceptedLimit is one declared residual limit.\n type ReviewAcceptedLimit struct {\n \tID   string `json:\"id\"`\n \tText string `json:\"text\"`\n \t// Spec names the spec that declared the limit when the scope holds more\n \t// than one; the id is then qualified as <spec>#L<N> (review round 1, N1).\n \tSpec string `json:\"spec,omitempty\"`\n }\n \n var acceptedLimitRE = regexp.MustCompile(`^-\\s+(L[1-9][0-9]*):\\s+(.+)$`)\n \n-// acceptedLimitReasonRE requires a reason after the marker, not the marker\n-// alone (review round 1, N2).\n-var acceptedLimitReasonRE = regexp.MustCompile(`(?i)(accepted because|aceito porque)\\s+\\S{2,}`)\n+// acceptedLimitReasonRE finds the reason that follows the marker.\n+var acceptedLimitReasonRE = regexp.MustCompile(`(?i)(?:accepted because|aceito porque)(.*)$`)\n+\n+// acceptedLimitReasonWordRE is a word with at least one letter.\n+var acceptedLimitReasonWordRE = regexp.MustCompile(`\\p{L}+`)\n+\n+// hasAcceptedLimitReason requires a reason after the marker of at least two\n+// words with letters: neither the marker alone (review round 1, N2) nor\n+// punctuation (round 2, N1) says why a limit is accepted.\n+func hasAcceptedLimitReason(text string) bool {\n+\tm := acceptedLimitReasonRE.FindStringSubmatch(text)\n+\treturn m != nil && len(acceptedLimitReasonWordRE.FindAllString(m[1], -1)) >= 2\n+}\n \n // ParseAcceptedLimits reads the `### Accepted limits` section of a spec body.\n // It returns the limits and the problems that keep the section from being\n // read as written: a bullet that is not `- L<N>: ...`, a repeated id, or a\n // limit that does not say why it is accepted (\"Accepted because ...\" or\n // \"Aceito porque ...\").\n func ParseAcceptedLimits(body string) ([]ReviewAcceptedLimit, []string) {\n \tvar limits []ReviewAcceptedLimit\n \tvar problems []string\n \tin := false\n \tseen := map[string]bool{}\n \tfor _, line := range strings.Split(body, \"\\n\") {\n \t\ttrimmed := strings.TrimSpace(line)\n \t\tif strings.HasPrefix(trimmed, \"#\") {\n \t\t\tin = strings.EqualFold(strings.TrimSpace(strings.TrimLeft(trimmed, \"#\")), \"Accepted limits\") || strings.EqualFold(strings.TrimSpace(strings.TrimLeft(trimmed, \"#\")), \"Limites aceitos\")\n \t\t\tcontinue\n \t\t}\n \t\tif !in || !strings.HasPrefix(trimmed, \"- \") {\n \t\t\tcontinue\n \t\t}\n \t\tm := acceptedLimitRE.FindStringSubmatch(trimmed)\n \t\tif m == nil {\n \t\t\tproblems = append(problems, \"accepted limit \"+quoteLedgerText(trimmed)+\" is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n \t\t\tcontinue\n \t\t}\n \t\tif seen[m[1]] {\n \t\t\tproblems = append(problems, \"accepted limit \"+m[1]+\" is declared twice\")\n \t\t\tcontinue\n \t\t}\n \t\tseen[m[1]] = true\n-\t\tif !acceptedLimitReasonRE.MatchString(m[2]) {\n+\t\tif !hasAcceptedLimitReason(m[2]) {\n \t\t\tproblems = append(problems, \"accepted limit \"+m[1]+\" does not say why it is accepted ('Accepted because ...')\")\n \t\t}\n \t\tlimits = append(limits, ReviewAcceptedLimit{ID: m[1], Text: strings.TrimSpace(m[2])})\n \t}\n \treturn limits, problems\n }\n \n // acceptedLimitsOf collects the limits the scope's specs declare.\n func (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\n \tspecs, err := s.reviewScopeSpecs(scope)\n \tif err != nil {\n \t\treturn nil\n \t}\n \treturn acceptedLimitsOfSpecs(specs)\n }\n \n // acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\n // by its spec when there is more than one spec.\n func acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\n \tvar out []ReviewAcceptedLimit\n \tfor _, spec := range specs {\n \t\tlimits, _ := ParseAcceptedLimits(spec.Body)\n \t\tfor _, l := range limits {\n \t\t\t// Ids are spec-local: across specs each is qualified by its spec,\n \t\t\t// so a finding names exactly one sealed limit.\n \t\t\tif len(specs) > 1 {\n \t\t\t\tl.ID, l.Spec = spec.Slug+\"#\"+l.ID, spec.Slug\n \t\t\t}\n \t\t\tout = append(out, l)\n \t\t}\n \t}\n \treturn out\n }\n \n // sealedAcceptedLimit reports whether the bundle sealed limit id.\n func sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\n \tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\n \t\tif l.ID == id {\n \t\t\treturn true\n \t\t}\n \t}\n \treturn false\n }\ndiff --git a/pose-mcp/internal/pose/accepted_limits_test.go b/pose-mcp/internal/pose/accepted_limits_test.go\nindex 6df5888c..d46e86fd 100644\n--- a/pose-mcp/internal/pose/accepted_limits_test.go\n+++ b/pose-mcp/internal/pose/accepted_limits_test.go\n@@ -16,80 +16,96 @@ const limitsSection = `\n // Spec pose-review-declared-threat-model R1: the section is read as\n // written, and what does not say why it is accepted is reported.\n func TestAcceptedLimitsAreParsed(t *testing.T) {\n \tlimits, problems := ParseAcceptedLimits(\"## 3. Technical Plan\\n\" + limitsSection + \"\\n### Other\\n- L9: not a limit here.\\n\")\n \tif len(problems) != 0 || len(limits) != 2 || limits[0].ID != \"L1\" || limits[1].ID != \"L2\" {\n \t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n \t}\n \t_, problems = ParseAcceptedLimits(\"### Accepted limits\\n- L1: no reason given.\\n- L1: twice. Accepted because yes.\\n- X1: wrong id. Accepted because no.\\n- L3: a marker with nothing after it. Accepted because\\n\")\n \tjoined := strings.Join(problems, \"\\n\")\n \tfor _, want := range []string{\"L1 does not say why it is accepted\", \"L1 is declared twice\", \"is not written as\", \"L3 does not say why it is accepted\"} {\n \t\tif !strings.Contains(joined, want) {\n \t\t\tt.Fatalf(\"missing problem %q in %v\", want, problems)\n \t\t}\n \t}\n }\n \n // R1: the review plan seals the limits the spec declares, and they enter the\n // plan digest; a spec without limits keeps its digest.\n func TestTheReviewPlanSealsTheAcceptedLimits(t *testing.T) {\n \troot, store := reviewBundleFixture(t)\n \tbefore, err := store.ReviewPlan(\"spec:backend\")\n \tif err != nil || len(before.AcceptedLimits) != 0 {\n \t\tt.Fatalf(\"plan without limits: %+v %v\", before.AcceptedLimits, err)\n \t}\n \tpath := filepath.Join(root, \".pose/specs/backend/spec.md\")\n \traw, _ := os.ReadFile(path)\n \tif err := os.WriteFile(path, []byte(strings.Replace(string(raw), \"### Technical risks\", strings.TrimPrefix(limitsSection, \"\\n\")+\"\\n### Technical risks\", 1)), 0o644); err != nil {\n \t\tt.Fatal(err)\n \t}\n \tafter, err := store.ReviewPlan(\"spec:backend\")\n \tif err != nil || len(after.AcceptedLimits) != 2 || after.AcceptedLimits[0].ID != \"L1\" {\n \t\tt.Fatalf(\"plan with limits: %+v %v\", after.AcceptedLimits, err)\n \t}\n \twithout := after\n \twithout.AcceptedLimits = nil\n \tif digest, err := digestReviewPlan(without); err != nil || digest == after.PlanDigest {\n \t\tt.Fatalf(\"the accepted limits did not enter the plan digest: %v\", err)\n \t}\n }\n \n // R2, R3: a follow-up the reviewer classifies inside a sealed limit is\n // recorded within-limit, naming it, and does not block an approval whatever\n // its severity; a limit the bundle did not seal accepts nothing.\n func TestAFindingWithinASealedLimitDoesNotBlockApproval(t *testing.T) {\n \tvar bundle ReviewBundle\n \tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"x. Accepted because y.\"}}\n \tdraft := ReviewDraft{Decision: \"approved\", Findings: []ReviewDraftFinding{\n \t\t{ID: \"N1\", Severity: \"high\", Disposition: \"follow-up\", Summary: \"an orphan that clears its environment escapes; that is L1\", Limit: \"L1\"},\n \t}}\n \tatt := reviewAttestationFromDraft(ReviewRun{RunID: \"rrn-0000000000000001\"}, bundle, draft, \"agent:reviewer\")\n \tif len(att.Findings) != 1 || att.Findings[0].Disposition != \"within-limit\" || att.Findings[0].Limit != \"L1\" {\n \t\tt.Fatalf(\"the finding was not recorded within its limit: %+v\", att.Findings)\n \t}\n \tatt.Decision = \"approved\"\n \tif blockers := reviewFindingDecisionBlockers(bundle, att); len(blockers) != 0 {\n \t\tt.Fatalf(\"a finding within a sealed limit blocked the approval: %v\", blockers)\n \t}\n \tatt.Findings[0].Limit = \"L9\"\n \tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"L9, which this bundle did not seal\") {\n \t\tt.Fatalf(\"an unsealed limit was accepted: %s\", blockers)\n \t}\n \tatt.Findings[0].Limit, att.Findings[0].Rationale = \"L1\", \"\"\n \tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"without saying why\") {\n \t\tt.Fatalf(\"a finding within a limit without a reason was accepted: %s\", blockers)\n \t}\n }\n \n // Review round 1, N1: across the specs of a composite scope each limit is\n // qualified by its spec, so a finding names exactly one.\n func TestLimitsAcrossSpecsAreQualified(t *testing.T) {\n \tbody := \"### Accepted limits\\n- L1: one. Accepted because it is rare.\\n\"\n \tsingle := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}})\n \tif len(single) != 1 || single[0].ID != \"L1\" || single[0].Spec != \"\" {\n \t\tt.Fatalf(\"a single spec's limit was qualified: %+v\", single)\n \t}\n \tboth := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}, {Slug: \"beta\", Body: body}})\n \tif len(both) != 2 || both[0].ID != \"alpha#L1\" || both[1].ID != \"beta#L1\" || both[1].Spec != \"beta\" {\n \t\tt.Fatalf(\"limits across specs are ambiguous: %+v\", both)\n \t}\n }\n+\n+// Review round 2, N1: punctuation is not a reason, and a reason may start\n+// with a one-letter word.\n+func TestAnAcceptedLimitNeedsWordsAsItsReason(t *testing.T) {\n+\tfor text, want := range map[string]bool{\n+\t\t\"x. Accepted because ..\":                false,\n+\t\t\"x. Accepted because -- !\":              false,\n+\t\t\"x. Accepted because rare\":              false,\n+\t\t\"x. Accepted because a shim covers it.\": true,\n+\t\t\"x. Aceito porque o shim cobre o caso.\": true,\n+\t} {\n+\t\tif got := hasAcceptedLimitReason(text); got != want {\n+\t\t\tt.Errorf(\"%q: reason=%t, want %t\", text, got, want)\n+\t\t}\n+\t}\n+}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"The round 3 code now rejects punctuation-only reasons and accepts reasons starting with a one-letter word, so R2-N1 appears fixed. I’m checking the new matcher’s boundaries next; its marker search is unanchored, which may let a negated “not accepted because …” line pass readiness."}}
