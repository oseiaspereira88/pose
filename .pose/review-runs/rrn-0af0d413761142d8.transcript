{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '230,275p' && nl -ba pose-mcp/internal/pose/review_rounds.go | sed -n '310,350p' && nl -ba pose-mcp/internal/pose/review_draft_check.go | sed -n '1,170p'\"","aggregated_output":"   230\tfunc draftReviewDecision(output string) string {\n   231\t\tdraft, err := ParseReviewDraft(output)\n   232\t\tswitch {\n   233\t\tcase err != nil:\n   234\t\t\treturn \"unknown\"\n   235\t\tcase draft != nil:\n   236\t\t\treturn draft.Decision\n   237\t\t}\n   238\t\treturn legacyReviewDecision(output)\n   239\t}\n   240\t\n   241\tfunc validateReviewDraft(d ReviewDraft) error {\n   242\t\tif d.Schema != ReviewDraftSchema {\n   243\t\t\treturn fmt.Errorf(\"the draft's schema is %q, not %s\", d.Schema, ReviewDraftSchema)\n   244\t\t}\n   245\t\tswitch d.Decision {\n   246\t\tcase \"approved\", \"changes-requested\", \"rejected\":\n   247\t\tdefault:\n   248\t\t\treturn fmt.Errorf(\"the draft's decision %q is not approved, changes-requested or rejected\", d.Decision)\n   249\t\t}\n   250\t\tif len(d.Findings) > reviewDraftMaxFindings || len(d.PriorFindings) > reviewDraftMaxFindings || len(d.Sweep) > reviewDraftMaxText {\n   251\t\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n   252\t\t}\n   253\t\tseen := map[string]bool{}\n   254\t\tfor _, f := range d.Findings {\n   255\t\t\tswitch {\n   256\t\t\tcase !reviewFindingID.MatchString(f.ID) || reviewRoundPrefix.MatchString(f.ID) || seen[f.ID]:\n   257\t\t\t\treturn fmt.Errorf(\"finding id %q is not a unique identifier without a round prefix\", f.ID)\n   258\t\t\tcase f.Severity != \"high\" && f.Severity != \"medium\" && f.Severity != \"low\":\n   259\t\t\t\treturn fmt.Errorf(\"finding %s: severity %q is not high, medium or low\", f.ID, f.Severity)\n   260\t\t\tcase f.Disposition != \"blocker\" && f.Disposition != \"follow-up\":\n   261\t\t\t\treturn fmt.Errorf(\"finding %s: disposition %q is not blocker or follow-up\", f.ID, f.Disposition)\n   262\t\t\tcase strings.TrimSpace(f.Summary) == \"\" || len(f.Summary) > reviewDraftMaxText || len(f.File) > 1024 || f.Line < 0:\n   263\t\t\t\treturn fmt.Errorf(\"finding %s needs a bounded summary and location\", f.ID)\n   264\t\t\t}\n   265\t\t\tseen[f.ID] = true\n   266\t\t}\n   267\t\tanswered := map[string]bool{}\n   268\t\tfor _, c := range d.Criteria {\n   269\t\t\tswitch {\n   270\t\t\tcase ValidateSlug(c.ID) != nil || answered[c.ID]:\n   271\t\t\t\treturn fmt.Errorf(\"criterion %q is not a unique criterion id\", c.ID)\n   272\t\t\tcase c.Disposition != \"passed\" && c.Disposition != \"finding\" && c.Disposition != \"not-applicable\":\n   273\t\t\t\treturn fmt.Errorf(\"criterion %s: disposition %q is not passed, finding or not-applicable\", c.ID, c.Disposition)\n   274\t\t\tcase len(c.Evidence) > reviewDraftMaxText || len(c.Rationale) > reviewDraftMaxText || len(c.Mappings) > reviewDraftMaxFindings:\n   275\t\t\t\treturn fmt.Errorf(\"criterion %s exceeds its bounds\", c.ID)\n   310\t\tfor _, q := range d.Questions {\n   311\t\t\tswitch {\n   312\t\t\tcase !adjudicationQuestionID.MatchString(q.ID) || asked[q.ID]:\n   313\t\t\t\treturn fmt.Errorf(\"question %q is not a unique decision or requirement id\", q.ID)\n   314\t\t\tcase q.Verdict != AdjudicationHolds && q.Verdict != AdjudicationDoesNotHold && q.Verdict != AdjudicationCannotDetermine:\n   315\t\t\t\treturn fmt.Errorf(\"question %s: verdict %q is not holds, does-not-hold or cannot-determine\", q.ID, q.Verdict)\n   316\t\t\tcase strings.TrimSpace(q.Rationale) == \"\" || len(q.Rationale) > reviewDraftMaxText || len(q.Evidence) > reviewDraftMaxText:\n   317\t\t\t\treturn fmt.Errorf(\"question %s needs a bounded rationale\", q.ID)\n   318\t\t\t}\n   319\t\t\tasked[q.ID] = true\n   320\t\t}\n   321\t\tobserved := map[string]bool{}\n   322\t\tfor _, sf := range d.Surfaces {\n   323\t\t\tswitch {\n   324\t\t\tcase !deliveryRefRE.MatchString(sf.Ref) || observed[sf.Ref]:\n   325\t\t\t\treturn fmt.Errorf(\"surface %q is not a unique delivery target\", sf.Ref)\n   326\t\t\tcase sf.Outcome != SmokeObserved && sf.Outcome != SmokeNotObserved && sf.Outcome != SmokeNotReachable:\n   327\t\t\t\treturn fmt.Errorf(\"surface %s: outcome %q is not observed, not-observed or not-reachable\", sf.Ref, sf.Outcome)\n   328\t\t\tcase len(sf.Commands) == 0 || len(sf.Commands) > 64 || strings.TrimSpace(sf.Observed) == \"\" || len(sf.Observed) > reviewDraftMaxText:\n   329\t\t\t\treturn fmt.Errorf(\"surface %s needs the commands run and what was observed\", sf.Ref)\n   330\t\t\t}\n   331\t\t\tfor _, c := range sf.Commands {\n   332\t\t\t\tif strings.TrimSpace(c) == \"\" || len(c) > 1024 {\n   333\t\t\t\t\treturn fmt.Errorf(\"surface %s: a command must be non-empty and bounded\", sf.Ref)\n   334\t\t\t\t}\n   335\t\t\t}\n   336\t\t\tobserved[sf.Ref] = true\n   337\t\t}\n   338\t\taccounted := map[string]bool{}\n   339\t\tfor _, p := range d.PriorFindings {\n   340\t\t\tswitch {\n   341\t\t\tcase !reviewCarriedID.MatchString(p.ID) || accounted[p.ID]:\n   342\t\t\t\treturn fmt.Errorf(\"prior finding id %q is not a unique carried identifier\", p.ID)\n   343\t\t\tcase p.Status != PriorFindingFixed && p.Status != PriorFindingPartial && p.Status != PriorFindingNotFixed && p.Status != PriorFindingSuperseded:\n   344\t\t\t\treturn fmt.Errorf(\"prior finding %s: status %q is not fixed, partial, not-fixed or superseded\", p.ID, p.Status)\n   345\t\t\tcase len(p.Evidence) > reviewDraftMaxText:\n   346\t\t\t\treturn fmt.Errorf(\"prior finding %s: evidence exceeds its bound\", p.ID)\n   347\t\t\t}\n   348\t\t\taccounted[p.ID] = true\n   349\t\t}\n   350\t\treturn nil\n     1\tpackage pose\n     2\t\n     3\t// Draft check (spec pose-review-readiness-before-seal R3): the reasons the\n     4\t// conclusion step and the attestation preflight would refuse a reviewer's\n     5\t// draft, computed before the run ends and without writing anything. It\n     6\t// reuses the same parsers and content checks; only the run's own proof,\n     7\t// signature and identity, which do not exist yet, are left out.\n     8\t//\n     9\t// A sealed checkout holds the subject, not the bundle sealed over it nor the\n    10\t// run ledger, so the dispatch writes both to the run's private directory and\n    11\t// names it in ReviewDraftContextEnv.\n    12\t\n    13\timport (\n    14\t\t\"encoding/json\"\n    15\t\t\"fmt\"\n    16\t\t\"os\"\n    17\t\t\"path/filepath\"\n    18\t\t\"strings\"\n    19\t\t\"time\"\n    20\t)\n    21\t\n    22\t// ReviewDraftContextEnv names the file holding the bundle and round a draft\n    23\t// is checked against inside a delegated review.\n    24\tconst ReviewDraftContextEnv = \"POSE_REVIEW_DRAFT_CONTEXT\"\n    25\t\n    26\t// ReviewCLIEnv names the executable of the engine that dispatched a review,\n    27\t// so the reviewer checks its draft with it and not with another installed\n    28\t// `pose` (review round 1).\n    29\tconst ReviewCLIEnv = \"POSE_REVIEW_CLI\"\n    30\t\n    31\tconst reviewDraftContextSchema = \"pose.review-draft-context/v1\"\n    32\t\n    33\t// ReviewDraftContext is what a draft is judged against: the sealed bundle and\n    34\t// the findings its round must account for.\n    35\ttype ReviewDraftContext struct {\n    36\t\tSchema string              `json:\"schema\"`\n    37\t\tBundle ReviewBundle        `json:\"bundle\"`\n    38\t\tRound  int                 `json:\"round\"`\n    39\t\tOpen   []ReviewOpenFinding `json:\"open,omitempty\"`\n    40\t}\n    41\t\n    42\t// ReviewDraftContextFor builds the context of bundle from the run ledger.\n    43\tfunc (s Store) ReviewDraftContextFor(bundle ReviewBundle) (ReviewDraftContext, error) {\n    44\t\tround, err := s.ReviewRoundOf(bundle)\n    45\t\tif err != nil {\n    46\t\t\treturn ReviewDraftContext{}, err\n    47\t\t}\n    48\t\treturn ReviewDraftContext{Schema: reviewDraftContextSchema, Bundle: bundle, Round: round.Number, Open: round.Open}, nil\n    49\t}\n    50\t\n    51\t// writeReviewDraftContext writes ctx under dir and returns its path.\n    52\tfunc writeReviewDraftContext(dir string, ctx ReviewDraftContext) (string, error) {\n    53\t\traw, err := json.Marshal(ctx)\n    54\t\tif err != nil {\n    55\t\t\treturn \"\", err\n    56\t\t}\n    57\t\tpath := filepath.Join(dir, \"pose-review-draft-context.json\")\n    58\t\treturn path, os.WriteFile(path, raw, 0o600)\n    59\t}\n    60\t\n    61\t// ReadReviewDraftContext reads a context file a dispatch wrote.\n    62\tfunc ReadReviewDraftContext(path string) (ReviewDraftContext, error) {\n    63\t\tvar ctx ReviewDraftContext\n    64\t\traw, err := os.ReadFile(path)\n    65\t\tif err != nil {\n    66\t\t\treturn ctx, err\n    67\t\t}\n    68\t\tif err := json.Unmarshal(raw, &ctx); err != nil {\n    69\t\t\treturn ctx, fmt.Errorf(\"pose: reading draft context %s: %w\", path, err)\n    70\t\t}\n    71\t\tif ctx.Schema != reviewDraftContextSchema || ctx.Bundle.BundleID == \"\" {\n    72\t\t\treturn ctx, fmt.Errorf(\"pose: %s is not a review draft context\", path)\n    73\t\t}\n    74\t\treturn ctx, nil\n    75\t}\n    76\t\n    77\t// CheckReviewDraft returns every reason a draft for ref would be refused at\n    78\t// conclusion, or nil when none applies. ref is a bundle id, or a run id whose\n    79\t// bundle is used.\n    80\tfunc (s Store) CheckReviewDraft(ref, output string, now time.Time) ([]string, error) {\n    81\t\tbundleID := ref\n    82\t\tif strings.HasPrefix(ref, \"rrn-\") {\n    83\t\t\trun, err := s.LoadProvenanceReviewRun(ref)\n    84\t\t\tif err != nil {\n    85\t\t\t\treturn nil, err\n    86\t\t\t}\n    87\t\t\tbundleID = run.BundleID\n    88\t\t}\n    89\t\tbundle, err := s.LoadReviewBundle(bundleID)\n    90\t\tif err != nil {\n    91\t\t\treturn nil, err\n    92\t\t}\n    93\t\tctx, err := s.ReviewDraftContextFor(bundle)\n    94\t\tif err != nil {\n    95\t\t\treturn nil, err\n    96\t\t}\n    97\t\treturn s.CheckReviewDraftIn(ctx, output, now), nil\n    98\t}\n    99\t\n   100\t// CheckReviewDraftIn judges output against ctx.\n   101\tfunc (s Store) CheckReviewDraftIn(ctx ReviewDraftContext, output string, now time.Time) []string {\n   102\t\tvar reasons []string\n   103\t\tdraft, err := ParseReviewDraft(output)\n   104\t\tswitch {\n   105\t\tcase err != nil:\n   106\t\t\treasons = append(reasons, \"the conclusion cannot be read: \"+err.Error())\n   107\t\tcase draft == nil:\n   108\t\t\treasons = append(reasons, \"the final message carries no pose-draft block\")\n   109\t\t}\n   110\t\tif err == nil {\n   111\t\t\tround := ReviewRound{Number: ctx.Round, Open: ctx.Open}\n   112\t\t\tif problems := ValidateRoundDraft(round, output); len(problems) > 0 {\n   113\t\t\t\treasons = append(reasons, \"the draft does not account for its round: \"+strings.Join(problems, \"; \"))\n   114\t\t\t}\n   115\t\t}\n   116\t\tif draft != nil && reviewDecisionApproves(draft.Decision) {\n   117\t\t\tbundle := ctx.Bundle\n   118\t\t\trun := ReviewRun{RunID: \"draft-check\", BundleID: bundle.BundleID, Kind: ReviewBriefKindReview}\n   119\t\t\tatt := reviewAttestationFromDraft(run, bundle, *draft, \"agent:draft-check/unknown\")\n   120\t\t\tcompleted, err := completeReviewAttestation(bundle, att, now)\n   121\t\t\tif err != nil {\n   122\t\t\t\treasons = append(reasons, \"the attestation preflight refuses it: \"+strings.TrimPrefix(err.Error(), \"pose: \"))\n   123\t\t\t} else if blockers := s.attestationContentBlockers(bundle, completed, false); len(blockers) > 0 {\n   124\t\t\t\treasons = append(reasons, \"the attestation preflight refuses it: \"+strings.Join(uniqueSorted(blockers), \"; \"))\n   125\t\t\t}\n   126\t\t}\n   127\t\treturn reasons\n   128\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_32","type":"agent_message","text":"Both required validation commands finished unsuccessfully before compilation because the read-only checkout prevented Go build/cache writes; the sealed build and test evidence remains available, and the focused suite passed. I’ve traced the current digest/serialization and conclusion gates; the remaining issue is the unbounded acceptance marker, which lets a negated declaration pass lint. I’m checking that the repository stayed untouched, then I’ll run draft-check."}}
