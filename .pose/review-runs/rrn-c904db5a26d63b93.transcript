rity.go:490:\tspecCommits, err := allCommitsWithSpecTrailersIn(files, root)\npose-mcp/internal/cli/artifact_integrity.go:658:\tspecTrailers, trailerOrder, err := allCommitsWithSpecTrailersOrderedIn(files, root)\npose-mcp/internal/cli/artifact_integrity.go:783:func cmdArtifactCheck(root string, args []string, stdout, stderr io.Writer) int {\npose-mcp/internal/cli/artifact_integrity.go:898:\t\tfmt.Fprintf(stdout, \"artifact.spec=%s\\nartifact.change_set=%s\\nartifact.change_set.base=%s\\nartifact.change_set.head=%s\\nartifact.change_set.commits=%d\\nartifact.diff_digest=%s\\nartifact.claims=%d\\nartifact.observed=%d\\nartifact.findings=%d\\n\",\n","exit_code":0,"status":"completed"}}
