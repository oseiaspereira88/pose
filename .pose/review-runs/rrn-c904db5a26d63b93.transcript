{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '60,105p' pose-mcp/internal/pose/spec_trailers.go; sed -n '1,110p' pose-mcp/internal/cli/artifact_integrity.go; sed -n '1,45p' .pose/results/delivery-validation.json; sed -n '4255,4285p' .pose/results/delivery-validation.json; rg -n 'artifact-check|surface-check|assess' pose-mcp/internal/cli/dispatch.go pose-mcp/internal/cli/*commands* 2>/dev/null\"","aggregated_output":"\t\t\t\tif spec != \"\" {\n\t\t\t\t\tspecCommits[spec] = append(specCommits[spec], sha)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn specCommits\n}\n\n// RawHistoryGit is a git command on root's raw object history: replace refs\n// (--no-replace-objects) and grafts (GIT_GRAFT_FILE at the always-empty null\n// device, which overrides both the repository's graft file and one the\n// environment names) never change which commits carry a trailer, what a change\n// set holds, or what a later removal is judged on (spec\n// pose-delivery-later-removal R3, review round 4 LR-R4-01).\nfunc RawHistoryGit(root string, args ...string) *exec.Cmd {\n\treturn gitCommand(append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// RawHistoryGitContext is RawHistoryGit under ctx.\nfunc RawHistoryGitContext(ctx context.Context, root string, args ...string) *exec.Cmd {\n\treturn gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n}\n\n// GitHooksDir is the directory git runs the hooks of root from: a linked worktree shares the\n// one of its common directory, and core.hooksPath moves it. Where git cannot answer it is\n// `.git/hooks`, which is where a repository would keep them.\nfunc GitHooksDir(root string) string {\n\tout, err := RawHistoryGit(root, \"rev-parse\", \"--git-path\", \"hooks\").Output()\n\tif err != nil {\n\t\treturn filepath.Join(root, \".git\", \"hooks\")\n\t}\n\tdir := strings.TrimSuffix(string(out), \"\\n\")\n\tif filepath.IsAbs(dir) {\n\t\treturn dir\n\t}\n\treturn filepath.Join(root, dir)\n}\n\n// RawGit is RawHistoryGit for a caller whose arguments already say where to read.\nfunc RawGit(args ...string) *exec.Cmd {\n\treturn gitCommand(append([]string{\"--no-replace-objects\"}, args...)...)\n}\n\n// SpecTrailerCommits reads the history of root and returns the commits that carry the trailer of\n// slug, the way the attribution of change sets does. An error is a history that could not be\npackage cli\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"errors\"\n\t\"fmt\"\n\t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n\t\"hash\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nvar safeGitRevision = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._/~^+-]{0,127}$`)\n\nfunc validateGitRevision(value string) error {\n\tif !safeGitRevision.MatchString(value) || strings.Contains(value, \"..\") || strings.Contains(value, \"@{\") || strings.HasPrefix(value, \"-\") {\n\t\treturn fmt.Errorf(\"unsafe Git revision %q\", value)\n\t}\n\treturn nil\n}\n\n// gitOutputBounded reads raw object history (posemodel.RawHistoryGit), so the\n// change sets a later removal is judged on are the ones it judges (review\n// round 3 of spec pose-delivery-later-removal, LR-R3-01).\nfunc gitOutputBounded(root string, limit int, args ...string) ([]byte, error) {\n\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n\tdefer cancel()\n\treturn gitOutputBoundedContext(ctx, root, limit, args...)\n}\n\nfunc gitOutputBoundedContext(ctx context.Context, root string, limit int, args ...string) ([]byte, error) {\n\tcmd := posemodel.RawHistoryGitContext(ctx, root, args...)\n\tcmd.WaitDelay = 2 * time.Second\n\tvar stdout, stderr bytes.Buffer\n\tcmd.Stdout = &limitedBuffer{buf: &stdout, limit: limit}\n\tcmd.Stderr = &limitedBuffer{buf: &stderr, limit: 64 * 1024}\n\tif err := cmd.Run(); err != nil {\n\t\tif ctx.Err() != nil {\n\t\t\treturn nil, fmt.Errorf(\"git %s failed: %w\", args[0], ctx.Err())\n\t\t}\n\t\treturn nil, fmt.Errorf(\"git %s failed: %w: %s\", args[0], err, strings.TrimSpace(stderr.String()))\n\t}\n\treturn stdout.Bytes(), nil\n}\n\n// gitStreamBounded streams a raw-history read into sink, bounded like\n// gitOutputBounded, without retaining the output.\nfunc gitStreamBounded(root string, limit int, sink io.Writer, args ...string) error {\n\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n\tdefer cancel()\n\tcmd := posemodel.RawHistoryGitContext(ctx, root, args...)\n\tcmd.WaitDelay = 2 * time.Second\n\tvar stderr bytes.Buffer\n\tcmd.Stdout = &streamThrough{limit: limit, sink: sink}\n\tcmd.Stderr = &limitedBuffer{buf: &stderr, limit: 64 * 1024}\n\tif err := cmd.Run(); err != nil {\n\t\tif ctx.Err() != nil {\n\t\t\treturn fmt.Errorf(\"git %s failed: %w\", args[0], ctx.Err())\n\t\t}\n\t\treturn fmt.Errorf(\"git %s failed: %w: %s\", args[0], err, strings.TrimSpace(stderr.String()))\n\t}\n\treturn nil\n}\n\n// streamThrough counts the bytes against the limit, keeping none, and\n// forwards them to sink.\ntype streamThrough struct {\n\tlimit   int\n\tsink    io.Writer\n\twritten int\n}\n\nfunc (w *streamThrough) Write(data []byte) (int, error) {\n\tif w.written+len(data) > w.limit {\n\t\treturn 0, fmt.Errorf(\"bounded Git output exceeded %d bytes\", w.limit)\n\t}\n\tw.written += len(data)\n\treturn w.sink.Write(data)\n}\n\n// gitOutputBoundedIn preserves the raw-history command policy while routing\n// the exact output through an operation read view when Files carries one.\nfunc gitOutputBoundedIn(files posemodel.Files, root string, limit int, args ...string) ([]byte, error) {\n\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)\n\tdefer cancel()\n\tout, err := posemodel.CaptureGovernanceRawHistoryGitContextIn(files, ctx, root, \"index.delivery-integrity\", int64(limit), args...)\n\t// The capture retains bounded stderr on ExitError. Keep that forensic cause\n\t// in collection gaps as well as the typed unknown error; never retry outside\n\t// the view or use partial stdout after a failed history read.\n\tvar exit *exec.ExitError\n\tif errors.As(err, &exit) {\n\t\tif detail := strings.TrimSpace(string(exit.Stderr)); detail != \"\" {\n\t\t\treturn nil, fmt.Errorf(\"%w: %s\", err, detail)\n\t\t}\n\t}\n{\n  \"schema_version\": 1,\n  \"generated_at\": \"2026-11-15T16:28:49Z\",\n  \"mode\": \"strict\",\n  \"git_head\": \"6a4d2c59d80f00c49f6a1ac6350cbc3ad6678d59\",\n  \"matrix_sha256\": \"sha256:26f001b80e2a1074c589e02b84238ebf15b209d7a1769c6277bad4657bf8d0cc\",\n  \"provenance_digest\": \"sha256:26cb1a2659148cfd2622aaac72bb10b4f2a41fbb2f0f451bcd0ceb2db59b48ab\",\n  \"scope_provenance\": {\n    \"artifact-claims-stop-at-the-section-end\": \"sha256:c0083ea34012c3ec78814d53d3bdb83918132e90f23fee8ff51903aee8672622\",\n    \"calendar-dates-tolerate-utc-stamping\": \"sha256:36f9125ec27177733affb1bfac1d5dddc2a61a6e2bddbabca5207aad9946e5d6\",\n    \"check-builds-the-delivery-graph-once\": \"sha256:3174d521faa7402018e6ae4d4997e54e202161c3ecce5b4b201fe562d4f9aa62\",\n    \"check-strict-verdict-names-its-mode\": \"sha256:1d9cc42d870578aa5ff51c90731ae7223b3eb557274ea068c64cb0a52474dc56\",\n    \"check-worker-count-is-the-machines\": \"sha256:04c5a4dff210561c33a4962d03260fbe182590395502b6934e4c6706aa761737\",\n    \"parse-the-delivery-index-once-per-content\": \"sha256:ae5d8b0932f1af046d6e11de948b778462600aa90e4145c9d7ed1fdcffea1534\",\n    \"pose-abm-atomic-start\": \"sha256:e36e11646857b79bce10a0a54b0af05d244ff4df24180718e67459e5f0c10436\",\n    \"pose-abm-authority-fixture-clock\": \"sha256:793fc700f81bcdac8f31e00d63a0cf98e5dcebe6d72559a27fedf1cd260ce6c0\",\n    \"pose-abm-capability-adoption\": \"sha256:04e3cb5db413fc18b0baef48b3630f3c1257a8a903a2e36d57356070e60be103\",\n    \"