n-request-recovery-and-preflight\": \"sha256:b49ced479077d3c17d966ac24118944d1849c6c5d0f2e25532fa605c6a1e4c0a\",\n    \"pose-action-request-resolution\": \"sha256:bc622517b26db6e9f0b35834e24fbde210cc984d27c11d17110f9c49ec706aca\",\n    \"pose-action-requests\": \"sha256:85116b16918adfa846c3ae9ef6685bf7f06ccfbe3be2b255223e7337b72334a4\",\n    \"pose-action-runtime-currency-gate\": \"sha256:afbd9397cf55900b904a6c359fb96cbd07e150f4286f959d8ce058c2a628e818\",\n    \"pose-action-target-and-node-scoping\": \"sha256:108f636bf4dc7198e82aaaaa4fb3d268df044991b2d26d69c8a014edf4f4c614\",\n    \"pose-action-waiver-and-supersession-authority\": \"sha256:3a422e634acdc543081d9768a96767d29cce06aa5722d4330780cd720f790124\",\n    \"pose-actions-node24-bump\": \"sha256:aaff42b0f2fb8f9cae03dda5866664ce308568935287d928be069be522b5f0c4\",\n    \"pose-adaptive-assessment-freshness\": \"sha256:a2b7d101380d90d22735d9817cf9a47fa49860e182eeed739189e44186017b1c\",\n    \"pose-adaptive-rule-delivery\": \"sha256:1f1acc8351772b002161e0eb6a42a815dcd9707ef1764aeee8e57d52ac0b888b\",\n    \"pose-adopt-request-keeps-the-reason\": \"sha256:bb6b9b695a1f81fc2be18cbe71f102d1e9ee1110b51d418f1d85aaa4e90935b8\",\n    \"pose-adopt-request-shows-what-it-sets\": \"sha256:41ea2b5c99ac2e23111f69513f32a5a7c7450a4a706d1fdb79c84918b57d3128\",\n      \"severity\": \"required\",\n      \"evidence_class\": \"integration\",\n      \"outcome\": \"pass\",\n      \"duration_seconds\": 2.406779218,\n      \"output\": \"ok  \\tgithub.com/harne8/pose-mcp/internal/pose\\t0.129s\\nok  \\tgithub.com/harne8/pose-mcp/internal/cli\\t1.387s\\n\"\n    },\n    {\n      \"id\": \"pose-mcp/go/federated-proof-reads-each-input-once-integration\",\n      \"module\": \"pose-mcp\",\n      \"stack\": \"go\",\n      \"name\": \"federated-proof-reads-each-input-once-integration\",\n      \"program\": \"go\",\n      \"args\": [\n        \"test\",\n        \"./internal/pose\",\n        \"-run\",\n        \"TestCurrentMaterialIsReadOncePerCommit|TestCurrentMaterialFollowsAMovedHead|TestCurrentMaterialWithoutAHeadIsNotKept|TestCurrentMaterialKeptDigestsAreBounded|TestEvidenceIsJudgedAgainstTheCurrentMaterial|TestAReleaseSnapshotIsReadOncePerCommit|TestAKeptReleaseSnapshotIsCopiedToEachReader|TestAMovedReleaseTagIsReadAtItsNewCommit|TestAFailedReleaseSnapshotReadIsNotKept|TestAReleaseTagPeelIsKeptPerObject|TestAListedReleaseTagResolvesAsAloneOne|TestABundleHeaderIsParsedOncePerContent|TestAKeptValueIsComputedOnceForConcurrentMisses|TestADeclinedKeptValueIsComputedAgain|TestAnUnreadableMaterialIsAskedAgain|TestASnapshotWithGapsIsReadAgain|TestAFailedReleaseTagPeelIsAskedAgain|TestARecoveredReadIsComputedOnceAndKept|TestABoundCrossingKeepsAPendingKey|TestAConcurrentBurstKeepsNoMoreThanTheBound\",\n        \"-count=1\"\n      ],\n      \"severity\": \"required\",\n      \"evidence_class\": \"integration\",\n      \"outcome\": \"pass\",\n      \"duration_seconds\": 0.647762623,\n      \"output\": \"ok  \\tgithub.com/harne8/pose-mcp/internal/pose\\t0.298s\\n\"\n    },\n    {\n      \"id\": \"pose-mcp/go/adopt-request-shows-what-it-sets-integration\",\n      \"module\": \"pose-mcp\",\n      \"stack\": \"go\",\n      \"name\": \"adopt-request-shows-what-it-sets-integration\",\n      \"program\": \"go\",\n","exit_code":2,"status":"failed"}}
