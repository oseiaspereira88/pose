{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '419,445p' pose-mcp/internal/cli/artifact_integrity.go; sed -n '783,855p' pose-mcp/internal/cli/artifact_integrity.go; sed -n '1,35p' .pose/results/delivery-validation.json; git log --all --format='%h %s' --grep='reads-each-input-once' -5\"","aggregated_output":"// allCommitsWithSpecTrailersOrderedIn reads the trailer log once and returns\n// it both per spec and in log order.\nfunc allCommitsWithSpecTrailersOrderedIn(files posemodel.Files, root string) (map[string][]string, []posemodel.SpecTrailerLogEntry, error) {\n\tout, err := gitOutputBoundedIn(files, root, 32*1024*1024, posemodel.SpecTrailerLogArgs...)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn posemodel.ParseSpecTrailerLog(out), posemodel.ParseSpecTrailerLogOrdered(out), nil\n}\n\n// trailerPatchDigests streams the patch of each attributed commit once, in\n// log order, into the digest of every spec that holds it, so a commit carrying\n// several specs' trailers is read once instead of once per spec (spec\n// pose-index-streams-each-commit-once). Each spec's digest is the SHA-256 of\n// its commits' patches concatenated in its own order, exactly as resolving\n// its change set alone computes it. A spec naming the same commit twice is\n// left to that per-spec path, since one stream cannot feed it twice in order.\n// A failed read fails every spec that holds the commit.\nfunc trailerPatchDigests(files posemodel.Files, root string, order []posemodel.SpecTrailerLogEntry, wanted map[string]bool) (map[string][]byte, map[string]error) {\n\trepeated := map[string]bool{}\n\tfor _, entry := range order {\n\t\tseen := map[string]bool{}\n\t\tfor _, spec := range entry.Specs {\n\t\t\tif seen[spec] {\n\t\t\t\trepeated[spec] = true\n\t\t\t}\n\t\t\tseen[spec] = true\nfunc cmdArtifactCheck(root string, args []string, stdout, stderr io.Writer) int {\n\tvar spec, from, to string\n\tstrict, jsonOutput := true, false\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--spec\", \"--from\", \"--to\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn usageError(stderr, \"Usage: pose artifact-check --spec <slug> [--from rev --to rev] [--strict|--tolerant] [--json]\")\n\t\t\t}\n\t\t\ti++\n\t\t\tswitch args[i-1] {\n\t\t\tcase \"--spec\":\n\t\t\t\tspec = args[i]\n\t\t\tcase \"--from\":\n\t\t\t\tfrom = args[i]\n\t\t\tcase \"--to\":\n\t\t\t\tto = args[i]\n\t\t\t}\n\t\tcase \"--strict\":\n\t\t\tstrict = true\n\t\tcase \"--tolerant\":\n\t\t\tstrict = false\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tdefault:\n\t\t\treturn usageError(stderr, \"Usage: pose artifact-check --spec <slug> [--from rev --to rev] [--strict|--tolerant] [--json]\")\n\t\t}\n\t}\n\tstore := posemodel.Store{Root: root}\n\tfull, err := store.GetSpec(spec)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tpolicy, err := posemodel.LoadArtifactPolicy(root)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\treturn 1\n\t}\n\tclaims, found, err := posemodel.ParseArtifactClaims(*full, policy)\n\tif err != nil || !found || len(claims) == 0 {\n\t\tfmt.Fprintf(stderr, \"pose artifact-check: spec %s has no valid artifact declaration: %v\\n\", spec, err)\n\t\treturn 1\n\t}\n\tvar sets []posemodel.ChangeSet\n\tif from != \"\" || to != \"\" {\n\t\tset, err := resolveGitChangeSet(root, spec, from, to)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose artifact-check: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tsets = append(sets, set)\n\t} else {\n\t\tfor _, recorded := range loadRecordedChangeSets(root) {\n\t\t\tif recorded.Spec == spec {\n\t\t\t\tsets = append(sets, recorded)\n\t\t\t}\n\t\t}\n\t\tif set, err := resolveGitChangeSet(root, spec, \"\", \"\"); err == nil {\n\t\t\talreadyPresent := false\n\t\t\tfor _, existing := range sets {\n\t\t\t\tif existing.ID == set.ID {\n\t\t\t\t\talreadyPresent = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !alreadyPresent {\n\t\t\t\tsets = append(sets, set)\n\t\t\t}\n\t\t}\n\t\tif len(sets) == 0 {\n\t\t\tfmt.Fprintf(stderr, \"pose artifact-check: no commits carry POSE-Spec: %s\\n\", spec)\n\t\t\treturn 1\n{\n  \"schema_version\": 1,\n  \"generated_at\": \"2026-11-15T16:28:49Z\",\n  \"mode\": \"strict\",\n  \"git_head\": \"6a4d2c59d80f00c49f6a1ac6350cbc3ad6678d59\",\n  \"matrix_sha256\": \"sha256:26f001b80e2a1074c589e02b84238ebf15b209d7a1769c6277bad4657bf8d0cc\",\n  \"provenance_digest\": \"sha256:26cb1a2659148cfd2622aaac72bb10b4f2a41fbb2f0f451bcd0ceb2db59b48ab\",\n  \"scope_provenance\": {\n    \"artifact-claims-stop-at-the-section-end\": \"sha256:c0083ea34012c3ec78814d53d3bdb83918132e90f23fee8ff51903aee8672622\",\n    \"calendar-dates-tolerate-utc-stamping\": \"sha256:36f9125ec27177733affb1bfac1d5dddc2a61a6e2bddbabca5207aad9946e5d6\",\n    \"check-builds-the-delivery-graph-once\": \"sha256:3174d521faa7402018e6ae4d4997e54e202161c3ecce5b4b201fe562d4f9aa62\",\n    \"check-strict-verdict-names-its-mode\": \"sha256:1d9cc42d870578aa5ff51c90731ae7223b3eb557274ea068c64cb0a52474dc56\",\n    \"check-worker-count-is-the-machines\": \"sha256:04c5a4dff210561c33a4962d03260fbe182590395502b6934e4c6706aa761737\",\n    \"parse-the-delivery-index-once-per-content\": \"sha256:ae5d8b0932f1af046d6e11de948b778462600aa90e4145c9d7ed1fdcffea1534\",\n    \"pose-abm-atomic-start\": \"sha256:e36e11646857b79bce10a0a54b0af05d244ff4df24180718e67459e5f0c10436\",\n    \"pose-abm-authority-fixture-clock\": \"sha256:793fc700f81bcdac8f31e00d63a0cf98e5dcebe6d72559a27fedf1cd260ce6c0\",\n    \"pose-abm-capability-adoption\": \"sha256:04e3cb5db413fc18b0baef48b3630f3c1257a8a903a2e36d57356070e60be103\",\n    \"pose-abm-causality-attestation\": \"sha256:7c5fdcb4edbc392f77c3de2b1f7eadad80504b114707eec6d7e44cc0f89b8bdc\",\n    \"pose-abm-contract-nodes\": \"sha256:88784d154e5604fd7bb149493eb3aafd5ac54613a141b4dc083de223a8100668\",\n    \"pose-abm-design-basis\": \"sha