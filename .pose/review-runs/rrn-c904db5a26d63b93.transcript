{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc \"ps -eo pid,ppid,comm,etime --sort=pid | tail -25; sed -n '1,100p' pose-mcp/internal/pose/release_archive.go; sed -n '1,100p' pose-mcp/internal/pose/review_operation_view.go; rg -n 'TODO|FIXME|stub|panic' pose-mcp/internal/pose/kept_cache.go pose-mcp/internal/pose/material_binding.go pose-mcp/internal/pose/release_manifest_integrity.go pose-mcp/internal/pose/review_operation_view.go pose-mcp/internal/cli/material_engine.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/usr/bin/bash -lc \"ps -eo pid,ppid,comm,etime --sort=pid | tail -25; sed -n '1,100p' pose-mcp/internal/pose/release_archive.go; sed -n '1,100p' pose-mcp/internal/pose/review_operation_view.go; rg -n 'TODO|FIXME|stub|panic' pose-mcp/internal/pose/kept_cache.go pose-mcp/internal/pose/material_binding.go pose-mcp/internal/pose/release_manifest_integrity.go pose-mcp/internal/pose/review_operation_view.go pose-mcp/internal/cli/material_engine.go\"","aggregated_output":"    PID    PPID COMMAND             ELAPSED\n      1       0 codex                 00:00\n      2       1 bash                  00:00\n      3       2 ps                    00:00\n      4       2 tail                  00:00\npackage pose\n\n// Release archival as a witness (spec pose-release-archival-attested-by-the-ledger).\n//\n// A spec declares the changelog fragment it adds under\n// .pose/changelogs/unreleased/. `pose release prepare` then moves it under\n// .pose/changelogs/<version>/, in a commit no change set of the spec contains.\n// After the cut, no claim the spec can hold passes both existence and action:\n// the pending path is gone, and a rename was never performed by the spec.\n//\n// Prepare used to rewrite the claim into that rename. It failed the action\n// check on every released spec, and it changed the Technical Plan — the\n// semantic section a sealed review bundle digests — of any spec closed before\n// the cut. The release manifest already records which fragment it archived, for\n// which spec, with which digest; it is read here as a witness of its own,\n// distinct from declaration and from Git observation.\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"errors\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// ArchivedFragment is what one release manifest attests about one fragment it\n// consumed.\ntype ArchivedFragment struct {\n\tVersion string `json:\"version\"`\n\tSpec    string `json:\"spec\"`\n\t// Pending is where the spec declared the fragment; Archived is where the\n\t// release moved it.\n\tPending  string `json:\"pending\"`\n\tArchived string `json:\"archived\"`\n\t// Intact reports whether the archived file still has the digest the\n\t// manifest froze. A changed fragment is not the one the release attests.\n\tIntact bool `json:\"intact\"`\n\t// Manifest is the manifest that attests it, and ManifestDigest the SHA-256\n\t// of its bytes, so the graph's input changes if the attestation does. Like\n\t// the archived file, the manifest must be tracked to count: an untracked\n\t// manifest is not part of the selected head.\n\tManifest       string `json:\"manifest\"`\n\tManifestDigest string `json:\"manifest_digest\"`\n}\n\nconst pendingFragmentDir = \".pose/changelogs/unreleased/\"\n\n// LoadArchivedFragments reads every release manifest under root and returns\n// what each attests, sorted by archived path. A manifest that cannot be read\n// attests nothing; `pose release check` is where it is reported.\nfunc LoadArchivedFragments(root string) []ArchivedFragment {\n\treturn LoadArchivedFragmentsIn(NativeFiles(), root)\n}\n\nfunc LoadArchivedFragmentsIn(files Files, root string) []ArchivedFragment {\n\tentries, err := files.ReadDir(filepath.Join(root, \".pose\", \"releases\"))\n\tif err != nil {\n\t\treturn nil\n\t}\n\tarchived := []ArchivedFragment{}\n\trefs, listed := releaseTagRefs(root)\n\tfor _, entry := range entries {\n\t\tif !entry.IsDir() || ValidateReleaseVersion(entry.Name()) != nil {\n\t\t\tcontinue\n\t\t}\n\t\tmanifest, err := LoadReleaseManifestIn(files, root, entry.Name())\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tmanifestPath := \".pose/releases/\" + entry.Name() + \"/manifest.json\"\n\t\tmanifestRaw, err := files.ReadFile(filepath.Join(root, filepath.FromSlash(manifestPath)))\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tmanifestSum := sha256.Sum256(manifestRaw)\n\t\t// A release that has a tag is the cut the tag holds: a manifest of the working tree that is\n\t\t// not that cut attests nothing.\n\t\tboundToTag := true\n\t\t// The tags' refs are listed once for all releases, and the snapshot is\n\t\t// read at the commit the tag was resolved to (spec\n\t\t// pose-federated-proof-reads-each-input-once).\n\t\tvar commit string\n\t\tvar annotated bool\n\t\tvar tagErr error\n\t\tif listed {\n\t\t\tcommit, annotated, tagErr = resolveListedReleaseTag(root, entry.Name(), refs)\n\t\t} else {\n\t\t\tcommit, annotated, tagErr = ResolveReleaseTag(root, entry.Name())\n\t\t}\n\t\tif tagErr == nil {\n\t\t\tif snap, snapErr := readReleaseSnapshotAtCommit(root, entry.Name(), commit, annotated); snapErr != nil || ReleaseDigest(string(manifestRaw)) != snap.ManifestDigest {\n\t\t\t\tboundToTag = false\n\t\t\t}\n\t\t} else if !errors.Is(tagErr, ErrReleaseTagMissing) {\n\t\t\tboundToTag = false\n\t\t}\n\t\tfor _, fragment := range manifest.Fragments {\n\t\t\tif fragment.Spec == \"\" || fragment.Path == \"\" || strings.ContainsAny(fragment.Path, `/\\`) {\n\t\t\t\tcontinue\npackage pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"strings\"\n\t\"sync\"\n\t\"sync/atomic\"\n)\n\ntype reviewHeaderObservation struct {\n\towner      string\n\tloss       *SourceLoss\n\tdigest     [32]byte\n\treadError  string\n\tinputBytes int\n}\n\n// readReviewBundleHeader is the same classification for cached and live reads.\n// A known different owner is skippable only after whole-JSON and ambiguity checks.\nfunc readReviewBundleHeader(files Files, dir, name string) reviewHeaderObservation {\n\trel := filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\", name))\n\traw, err := files.ReadFile(filepath.Join(dir, name))\n\tif err != nil {\n\t\tloss := SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossReadError, Detail: err.Error()}\n\t\treturn reviewHeaderObservation{loss: &loss, readError: err.Error()}\n\t}\n\tresult := reviewHeaderObservation{digest: sha256.Sum256(raw), inputBytes: len(raw)}\n\t// What a bundle's bytes say about their scope is a function of the\n\t// bytes: it is parsed once per content digest, so a governance check\n\t// that reads every bundle for every scope parses each content once\n\t// (spec pose-federated-proof-reads-each-input-once).\n\tparsed := reviewBundleHeaderParses.get(string(result.digest[:]), func() (reviewBundleHeaderParse, bool) {\n\t\treturn parseReviewBundleHeader(raw, rel), true\n\t})\n\tresult.owner = parsed.owner\n\tif parsed.loss != nil {\n\t\tloss := *parsed.loss\n\t\tloss.Artifact = rel\n\t\tresult.loss = &loss\n\t}\n\treturn result\n}\n\n// parseReviewBundleHeader reads the scope a bundle's bytes declare, or why\n// they declare none.\nfunc parseReviewBundleHeader(raw []byte, rel string) reviewBundleHeaderParse {\n\tvar header struct {\n\t\tPayload struct {\n\t\t\tScope struct {\n\t\t\t\tRef string `json:\"ref\"`\n\t\t\t} `json:\"scope\"`\n\t\t} `json:\"payload\"`\n\t}\n\tvar loss SourceLoss\n\tswitch {\n\tcase json.Unmarshal(raw, &header) != nil:\n\t\tloss = attributeLoss(SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossParseError, Detail: \"the record is not valid JSON\"}, raw, \"payload\", \"scope\", \"ref\")\n\tcase func() bool { _, _, ambiguous := sniffJSONString(raw, \"payload\", \"scope\", \"ref\"); return ambiguous }():\n\t\tloss = SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossInvalid, Detail: \"the record names its scope more than once\"}\n\tcase header.Payload.Scope.Ref == \"\":\n\t\tloss = SourceLoss{Producer: \"review-bundles\", Artifact: rel, Kind: LossParseError, Detail: \"the record names no scope\"}\n\tdefault:\n\t\treturn reviewBundleHeaderParse{owner: header.Payload.Scope.Ref}\n\t}\n\treturn reviewBundleHeaderParse{loss: &loss}\n}\n\n// reviewBundleHeaderParses keeps, per content digest, the scope a bundle\n// names or why it names none; bounded for a long-running process.\nvar reviewBundleHeaderParses = newKeptCache[reviewBundleHeaderParse](50000)\n\ntype reviewBundleHeaderParse struct {\n\towner string\n\tloss  *SourceLoss\n}\n\ntype reviewOperationView struct {\n\tcoordinator      *reviewOperationView\n\tcoordinatorStore Store\n\tscopeBase        Store\n\tscopeRoots       map[string]string\n\tscopeConflicts   map[string]bool\n\tscopeInit        sync.Once\n\tscopeInitErr     error\n\n\tspecOnce        sync.Once\n\tspecUsed        bool\n\tspecErr         error\n\tspecFallback    bool\n\tspecEntries     []Spec\n\tspecBySlug      map[string]int\n\tspecBodyMu      sync.Mutex\n\tspecBodySeen    []bool\n\tspecBodyDigests [][32]byte\n","exit_code":1,"status":"failed"}}
