{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '232,335p' pose-mcp/internal/pose/git_snapshot_integrity.go; sed -n '605,718p' pose-mcp/internal/pose/governance_read_view_git.go\"","aggregated_output":"\nfunc gitMaterializedChangesForIn(files Files, root, commit string, matters func(string) bool, producer string) ([]string, error) {\n\tfiles = FilesOrNative(files)\n\tif producer != \"\" {\n\t\tproducer = governanceProducerFromFiles(files, producer)\n\t}\n\trunGit := func(root string, args ...string) ([]byte, error) {\n\t\tif len(args) == 5 && args[0] == \"ls-tree\" {\n\t\t\treturn listCommittedTree(root, args[4])\n\t\t}\n\t\treturn snapshotGit(root, args...)\n\t}\n\tworktreeIdentity := dispatchWorktreeIdentity\n\tif producer != \"\" {\n\t\trunGit = func(root string, args ...string) ([]byte, error) {\n\t\t\treturn captureGovernanceGit(files, root, producer, args...)\n\t\t}\n\t\tworktreeIdentity = func(root string) (string, error) {\n\t\t\treturn dispatchWorktreeIdentityGoverned(files, root, producer)\n\t\t}\n\t}\n\tvar err error\n\troot, err = filepath.Abs(root)\n\tif err != nil {\n\t\treturn nil, &GitSnapshotError{\"root\", err}\n\t}\n\tif _, err := worktreeIdentity(root); err != nil {\n\t\treturn nil, err\n\t}\n\tout, err := runGit(root, \"ls-tree\", \"-r\", \"-l\", \"-z\", commit)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tbudget := gitSnapshotBudget(gitCommittedTreeBytes(out))\n\tvar changed []string\n\tvar total int64\n\tcount := 0\n\tfor _, record := range bytes.Split(out, []byte{0}) {\n\t\tif len(record) == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tcount++\n\t\tif count > 100000 {\n\t\t\treturn nil, &GitSnapshotError{\"tree snapshot\", fmt.Errorf(\"exceeds 100000 entries\")}\n\t\t}\n\t\ti := bytes.IndexByte(record, '\\t')\n\t\tif i < 0 {\n\t\t\treturn nil, &GitSnapshotError{\"tree protocol\", fmt.Errorf(\"missing path\")}\n\t\t}\n\t\tfields := strings.Fields(string(record[:i]))\n\t\tif len(fields) != 4 {\n\t\t\treturn nil, &GitSnapshotError{\"tree protocol\", fmt.Errorf(\"invalid entry\")}\n\t\t}\n\t\tfields = fields[:3]\n\t\tpath := string(record[i+1:])\n\t\tif fields[0] == \"160000\" && matters != nil && !matters(path) {\n\t\t\tcontinue\n\t\t}\n\t\tfull := filepath.Join(root, filepath.FromSlash(path))\n\t\t// Lstat every parent: a link in a parent must never read outside root.\n\t\tunsafe := false\n\t\tfor parent := filepath.Dir(full); parent != root; parent = filepath.Dir(parent) {\n\t\t\tif parent == filepath.Dir(parent) {\n\t\t\t\treturn nil, &GitSnapshotError{\"path\", fmt.Errorf(\"path outside worktree: %q\", path)}\n\t\t\t}\n\t\t\tvar info os.FileInfo\n\t\t\tvar e error\n\t\t\tif producer != \"\" {\n\t\t\t\tinfo, e = files.Lstat(parent)\n\t\t\t} else {\n\t\t\t\tinfo, e = os.Lstat(parent)\n\t\t\t}\n\t\t\tif e != nil || !info.IsDir() {\n\t\t\t\tunsafe = true\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif unsafe {\n\t\t\tchanged = append(changed, path)\n\t\t\tcontinue\n\t\t}\n\t\tvar info os.FileInfo\n\t\tvar e error\n\t\tif producer != \"\" {\n\t\t\tinfo, e = files.Lstat(full)\n\t\t} else {\n\t\t\tinfo, e = os.Lstat(full)\n\t\t}\n\t\tif os.IsNotExist(e) {\n\t\t\tchanged = append(changed, path)\n\t\t\tcontinue\n\t\t}\n\t\tif e != nil {\n\t\t\treturn nil, &GitSnapshotError{\"lstat \" + path, e}\n\t\t}\n\t\tif fields[0] == \"160000\" {\n\t\t\tif !info.IsDir() {\n\t\t\t\tchanged = append(changed, path)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif _, err := worktreeIdentity(full); err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t\thead, e := runGit(full, \"rev-parse\", \"--verify\", \"HEAD\")\nfunc runGovernanceGitCommand(files Files, root string, args []string, limit int64) ([]byte, error) {\n\tstdout, _, err := runGovernanceGitCommandOutput(files, root, args, limit)\n\treturn stdout, err\n}\n\nfunc runGovernanceGitCommandContext(ctx context.Context, files Files, root string, args []string, limit int64) ([]byte, error) {\n\tstdout, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, args, limit)\n\treturn stdout, err\n}\n\nfunc runGovernanceGitCommandOutput(files Files, root string, args []string, limit int64) ([]byte, []byte, error) {\n\treturn runGovernanceGitCommandOutputAdmitted(files, root, args, limit, nil)\n}\n\nfunc runGovernanceGitCommandOutputContext(ctx context.Context, files Files, root string, args []string, limit int64) ([]byte, []byte, error) {\n\treturn runGovernanceGitCommandOutputAdmittedContext(ctx, files, root, args, limit, nil)\n}\n\n// runGovernanceGitCommandOutputAdmitted admits each stream chunk before the\n// bounded output buffer retains it. The operation callback is shared with\n// Files reads, so concurrent producers cannot spend the same remaining bytes.\nfunc runGovernanceGitCommandOutputAdmitted(files Files, root string, args []string, limit int64, admit func(int64) bool) ([]byte, []byte, error) {\n\treturn runGovernanceGitCommandOutputAdmittedContext(context.Background(), files, root, args, limit, admit)\n}\n\n// runGovernanceGitCommandOutputAdmittedContext admits each stream chunk before\n// the bounded output buffer retains it and executes Git under ctx.\n// governanceGitEnv is added to every Git command the governance read view\n// runs, captured or streamed. Governance classifies Git's failures by what\n// Git writes to stderr, so Git writes it untranslated: a translated \"not a\n// git repository\" left a directory outside any repository unknown under\n// pt_BR (spec pose-governance-git-reads-untranslated).\nvar governanceGitEnv = []string{\"GIT_OPTIONAL_LOCKS=0\", \"LC_ALL=C\", \"LANGUAGE=C\"}\n\nfunc runGovernanceGitCommandOutputAdmittedContext(ctx context.Context, files Files, root string, args []string, limit int64, admit func(int64) bool) ([]byte, []byte, error) {\n\tif limit < 0 {\n\t\treturn nil, nil, errGovernanceReadViewBudget\n\t}\n\tfiles = FilesOrNative(files)\n\tif ctx == nil {\n\t\tctx = context.Background()\n\t}\n\tcmd := gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n\tcmd.WaitDelay = 2 * time.Second\n\tcmd.Env = append(cmd.Env, governanceGitEnv...)\n\toutput := &boundedGovernanceGitOutput{limit: limit, admit: admit}\n\tcmd.Stdout = governanceGitStream{output: output, stderr: false}\n\tcmd.Stderr = governanceGitStream{output: output, stderr: true}\n\terr := cmd.Run()\n\tstdout, stderr, exceeded := output.values()\n\tif exceeded {\n\t\treturn nil, nil, errGovernanceReadViewBudget\n\t}\n\tif err != nil {\n\t\tif exit, ok := err.(*exec.ExitError); ok {\n\t\t\texit.Stderr = append([]byte(nil), stderr...)\n\t\t}\n\t\treturn stdout, stderr, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n\t}\n\tif len(stderr) > 0 {\n\t\tdetail := strings.TrimSpace(string(stderr))\n\t\tif detail == \"\" {\n\t\t\tdetail = \"Git wrote unclassified stderr output\"\n\t\t}\n\t\treturn stdout, stderr, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: errors.New(detail)}\n\t}\n\treturn stdout, stderr, nil\n}\n\ntype boundedGovernanceGitOutput struct {\n\tmu       sync.Mutex\n\tlimit    int64\n\tused     int64\n\tadmit    func(int64) bool\n\tstdout   bytes.Buffer\n\tstderr   bytes.Buffer\n\texceeded bool\n}\n\ntype governanceGitStream struct {\n\toutput *boundedGovernanceGitOutput\n\tstderr bool\n}\n\nfunc (stream governanceGitStream) Write(data []byte) (int, error) {\n\toutput := stream.output\n\toutput.mu.Lock()\n\tdefer output.mu.Unlock()\n\tif output.exceeded || int64(len(data)) > output.limit-output.used {\n\t\toutput.exceeded = true\n\t\treturn 0, errGovernanceReadViewBudget\n\t}\n\tif output.admit != nil && !output.admit(int64(len(data))) {\n\t\toutput.exceeded = true\n\t\treturn 0, errGovernanceReadViewBudget\n\t}\n\tvar err error\n\tif stream.stderr {\n\t\t_, err = output.stderr.Write(data)\n\t} else {\n\t\t_, err = output.stdout.Write(data)\n\t}\n\tif err == nil {\n\t\toutput.used += int64(len(data))\n\t}\n\treturn len(data), err\n}\n\nfunc (output *boundedGovernanceGitOutput) values() ([]byte, []byte, bool) {\n\toutput.mu.Lock()\n\tdefer output.mu.Unlock()\n\treturn append([]byte(nil), output.stdout.Bytes()...), append([]byte(nil), output.stderr.Bytes()...), output.exceeded\n}\n","exit_code":0,"status":"completed"}}
