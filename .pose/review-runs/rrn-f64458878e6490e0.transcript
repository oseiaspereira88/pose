klink         string\n   444\t\t// inventoryBytes bounds the bytes the worktree's cleanup may remove: the\n   445\t\t// checked-out commit's tree plus the snapshot margin, read from the\n   446\t\t// coordinator repository when the worktree is registered (spec\n   447\t\t// pose-git-snapshot-budget-scales-with-the-tree).\n   448\t\tinventoryBytes int64\n   449\t}\n   450\t\n   451\tfunc (s Store) captureReviewCleanupOwnership(runtime *os.Root, worktree string, marker []byte) (*reviewCleanupOwnership, error) {\n   452\t\traw, err := snapshotGit(s.Root, \"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\")\n   453\t\tif err != nil {\n   454\t\t\treturn nil, err\n   455\t\t}\n   456\t\tparent := filepath.Join(strings.TrimSpace(string(raw)), \"worktrees\")\n   457\t\tpath := strings.TrimSpace(strings.TrimPrefix(string(marker), \"gitdir: \"))\n   458\t\tif !strings.HasPrefix(string(marker), \"gitdir: \") || !filepath.IsAbs(path) || filepath.Dir(path) != parent {\n   459\t\t\treturn nil, fmt.Errorf(\"unexpected worktree registration\")\n   460\t\t}\n   461\t\tregistry, err := os.OpenRoot(parent)\n   462\t\tif err != nil {\n   463\t\t\treturn nil, err\n   464\t\t}\n   465\t\tname := filepath.Base(path)\n   466\t\tinfo, err := registry.Lstat(name)\n   467\t\tif err != nil || !info.IsDir() {\n   468\t\t\tregistry.Close()\n   469\t\t\treturn nil, fmt.Errorf(\"worktree registration unavailable\")\n   470\t\t}\n   471\t\to := &reviewCleanupOwnership{runtime: runtime, registry: registry, registration: name, registrationInfo: info, backlink: filepath.Join(worktree, \".git\"), inventoryBytes: gitSnapshotMarginBytes}\n   472\t\tif head, err := registry.ReadFile(filepath.Join(name, \"HEAD\")); err == nil {\n   473\t\t\tif commit := strings.TrimSpace(string(head)); !strings.HasPrefix(commit, \"ref:\") && commit != \"\" {\n   474\t\t\t\tif listing, err := listCommittedTree(s.Root, commit); err == nil {\n   475\t\t\t\t\to.inventoryBytes = gitSnapshotBudget(gitCommittedTreeBytes(listing))\n   476\t\t\t\t}\n   477\t\t\t}\n   478\t\t}\n   479\t\tchild, err := registry.OpenRoot(name)\n   480\t\tif err != nil {\n   481\t\t\tregistry.Close()\n   482\t\t\treturn nil, err\n   483\t\t}\n   484\t\tbacklink, err := readReviewRootFile(child, \"gitdir\", 4096)\n   485\t\tchild.Close()\n   486\t\tif err != nil || strings.TrimSpace(string(backlink)) != o.backlink {\n   487\t\t\tregistry.Close()\n   488\t\t\treturn nil, fmt.Errorf(\"worktree registration backlink differs\")\n   489\t\t}\n   490\t\treturn o, nil\n   491\t}\n   492\t\n   493\tfunc (s Store) cleanupReviewResources(tmp string, owned os.FileInfo, worktree string, worktreeOwned os.FileInfo, gitMarker []byte, ownership ...*reviewCleanupOwnership) error {\n   494\t\tvar o *reviewCleanupOwnership\n   495\t\tif len(ownership) > 0 {\n   496\t\t\to = ownership[0]\n   497\t\t}\n   498\t\tcurrent, err := os.Lstat(tmp)\n   499\t\tif errors.Is(err, os.ErrNotExist) {\n   500\t\t\tif (o != nil && !o.removed) || (o == nil && worktreeOwned != nil) {\n   501\t\t\t\treturn fmt.Errorf(\"runtime path disappeared without confirmed cleanup; resources may remain\")\n   502\t\t\t}\n   503\t\t\treturn nil\n   504\t\t}\n   505\t\tif err != nil || !current.IsDir() || !os.SameFile(owned, current) {\n   506\t\t\treturn fmt.Errorf(\"cleanup refused: runtime directory identity changed\")\n   507\t\t}\n   508\t\n   509\t\tvar root *os.Root\n   510\t\tif o != nil {\n   511\t\t\troot = o.runtime\n   512\t\t} else {\n   513\t\t\troot, err = os.OpenRoot(tmp)\n   514\t\t\tif err != nil {\n   515\t\t\t\treturn fmt.Errorf(\"runtime cleanup root unavailable\")\n   516\t\t\t}\n   517\t\t\tdefer root.Close()\n   518\t\t}\n   519\t\tstat, err := root.Stat(\".\")\n   520\t\tif err != nil || !os.SameFile(owned, stat) {\n   521\t\t\treturn fmt.Errorf(\"runtime cleanup root identity changed\")\n   522\t\t}\n   523\t\tif worktreeOwned != nil {\n   524\t\t\tinfo, err := root.Lstat(\"worktree\")\n   525\t\t\tif err != nil && !errors.Is(err, os.ErrNotExist) {\n   526\t\t\t\treturn fmt.Errorf(\"worktree cleanup unavailable\")\n   527\t\t\t}\n   528\t\t\tif err == nil {\n   529\t\t\t\tmarker, e := readReviewRootFile(root, \"worktree/.git\", 4096)\n   530\t\t\t\tif e != nil || !info.IsDir() || !os.SameFile(worktreeOwned, info) || !bytes.Equal(marker, gitMarker) {\n   531\t\t\t\t\treturn fmt.Errorf(\"cleanup refused: worktree identity changed\")\n   532\t\t\t\t}\n   533\t\t\t}\n   534\t\t\tif o == nil || o.registry == nil {\n   535\t\t\t\treturn fmt.Errorf(\"cleanup registration ownership unavailable; resources retained\")\n   536\t\t\t}\n   537\t\t\tinfo, e := o.registry.Lstat(o.registration)\n   538\t\t\tif e != nil || !info.IsDir() || !os.SameFile(info, o.registrationInfo) {\n   539\t\t\t\treturn fmt.Errorf(\"cleanup registration identity changed\")\n   540\t\t\t}\n   541\t\t\tregistration, e := o.registry.OpenRoot(o.registration)\n   542\t\t\tif e != nil {\n   543\t\t\t\treturn fmt.Errorf(\"cleanup registration unavailable\")\n   544\t\t\t}\n   545\t\t\tdefer registration.Close()\n   546\t\t\tinfo, e = registration.Stat(\".\")\n   547\t\t\tif e != nil || !os.SameFile(info, o.registrationInfo) {\n   548\t\t\t\treturn fmt.Errorf(\"cleanup registration identity changed\")\n   549\t\t\t}\n   550\t\t\tbacklink, e := readReviewRootFile(registration, \"gitdir\", 4096)\n   551\t\t\tif e != nil || strings.TrimSpace(string(backlink)) != o.backlink {\n   552\t\t\t\treturn fmt.Errorf(\"cleanup registration backlink changed\")\n   553\t\t\t}\n   554\t\t\tfor _, lock := range []string{\"locked\", \"index.lock\", \"HEAD.lock\"} {\n   555\t\t\t\tif _, e := registration.Lstat(lock); !errors.Is(e, os.ErrNotExist) {\n   556\t\t\t\t\treturn fmt.Errorf(\"worktree registration has a live or unknown lock; resources retained\")\n   557\t\t\t\t}\n   558\t\t\t}\n   559\t\t\tif err == nil {\n   560\t\t\t\ttree, e := root.OpenRoot(\"worktree\")\n   561\t\t\t\tif e != nil {\n   562\t\t\t\t\treturn fmt.Errorf(\"worktree cleanup root unavailable\")\n   563\t\t\t\t}\n   564\t\t\t\tinfo, e := tree.Stat(\".\")\n   565\t\t\t\tif e != nil || !os.SameFile(info, worktreeOwned) {\n   566\t\t\t\t\ttree.Close()\n   567\t\t\t\t\treturn fmt.Errorf(\"worktree cleanup identity changed\")\n   568\t\t\t\t}\n   569\t\t\t\tlimit := gitSnapshotMarginBytes\n   570\t\t\t\tif o.inventoryBytes > limit {\n   571\t\t\t\t\tlimit = o.inventoryBytes\n   572\t\t\t\t}\n   573\t\t\t\te = removeReviewOwnedContents(tree, 100000, limit)\n   574\t\t\t\ttree.Close()\n   575\t\t\t\tif e != nil {\n   576\t\t\t\t\treturn e\n   577\t\t\t\t}\n   578\t\t\t\tif e := root.Remove(\"worktree\"); e != nil && !errors.Is(e, os.ErrNotExist) {\n   579\t\t\t\t\treturn fmt.Errorf(\"worktree cleanup incomplete\")\n   580\t\t\t\t}\n   581\t\t\t}\n   582\t\t\tif e := removeReviewOwnedContents(registration, 1024, 256<<20); e != nil {\n   583\t\t\t\treturn e\n   584\t\t\t}\n   585\t\t\tregistration.Close()\n   586\t\t\tif e := o.registry.Remove(o.registration); e != nil && !errors.Is(e, os.ErrNotExist) {\n   587\t\t\t\treturn fmt.Errorf(\"worktree registration cleanup incomplete\")\n   588\t\t\t}\n   589\t\t} else if _, e := root.Lstat(\"worktree\"); !errors.Is(e, os.ErrNotExist) {\n   590\t\t\treturn fmt.Errorf(\"partial worktree setup has no verified ownership; resources retained\")\n   591\t\t}\n   592\t\tif err := removeReviewGoBuildLeftovers(root); err != nil {\n   593\t\t\treturn err\n   594\t\t}\n   595\t\tif err := removeReviewOwnedContents(root, reviewRuntimeMaxEntries, 128<<20); err != nil {\n   596\t\t\treturn err\n   597\t\t}\n   598\t\tcurrent, err = os.Lstat(tmp)\n   599\t\tif err != nil || !os.SameFile(owned, current) {\n   600\t\t\treturn fmt.Errorf(\"runtime path changed during cleanup; replacement retained\")\n   601\t\t}\n   602\t\tif err := os.Remove(tmp); err != nil && !errors.Is(err, os.ErrNotExist) {\n   603\t\t\treturn fmt.Errorf(\"runtime directory cleanup incomplete\")\n   604\t\t}\n   605\t\tif o != nil {\n   606\t\t\to.removed = true\n   607\t\t}\n   608\t\treturn nil\n   609\t}\n   610\t\n   611\t// reviewGoBuildDir names the temporary build directory the Go toolchain\n   612\t// creates under the TMPDIR the engine gives a review run.\n   613\tvar reviewGoBuildDir = regexp.MustCompile(`^go-build[0-9]+$`)\n   614\t\n   615\t// reviewGoBuildBeforeOpen runs after a go-build name is listed and before it\n   616\t// is opened, reviewGoBuildAfterContents after the directory is emptied and\n   617\t// before its name is checked again, and reviewGoBuildBeforeRemove between that\n   618\t// check and the removal; tests use them to change the name there.\n   619\tvar (\n   620\t\treviewGoBuildBeforeOpen    = func(string) {}\n   621\t\treviewGoBuildAfterContents = func(string) {}\n   622\t\treviewGoBuildBeforeRemove  = func(string) {}\n   623\t)\n   624\t\n   625\t// removeReviewGoBuildLeftovers removes the Go build directories a reviewer's\n   626\t// interrupted `go test` or `go build` left at the top of the run's runtime\n   627\t// directory, each under its own bounded inventory, before the runtime's own\n   628\t// inventory, which a single test binary can exceed (spec\n   629\t// pose-review-cleanup-removes-go-build-leftovers). Only a real directory is\n   630\t// removed; the platform implementation opens it without blocking and only as\n   631\t// a directory, so a link, a FIFO or any other entry stays for the runtime\n   632\t// inventory to judge.\n   633\tfunc removeReviewGoBuildLeftovers(root *os.Root) error {\n   634\t\t// The top level is read in bounded batches and each go-build directory\n   635\t\t// is removed as it is read, so nothing accumulates; only the other\n   636\t\t// entries, which the runtime inventory will judge, count against its\n   637\t\t// bound (review rounds 5 and 6, N6 and N10).\n   638\t\tdir, err := root.Open(\".\")\n   639\t\tif err != nil {\n   640\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n   641\t\t}\n   642\t\tdefer dir.Close()\n   643\t\tothers := 0\n   644\t\tfor {\n   645\t\t\tbatch, err := dir.Readdirnames(256)\n   646\t\t\tfor _, name := range batch {\n   647\t\t\t\tif !reviewGoBuildDir.MatchString(name) {\n   648\t\t\t\t\tothers++\n   649\t\t\t\t\tif others > reviewRuntimeMaxEntries {\n   650\t\t\t\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n   651\t\t\t\t\t}\n   652\t\t\t\t\tcontinue\n   653\t\t\t\t}\n   654\t\t\t\tif err := removeReviewGoBuildDir(root, name); err != nil {\n   655\t\t\t\t\treturn err\n   656\t\t\t\t}\n   657\t\t\t}\n   658\t\t\tif len(batch) == 0 {\n   659\t\t\t\tif err == nil || errors.Is(err, io.EOF) {\n   660\t\t\t\t\treturn nil\n   661\t\t\t\t}\n   662\t\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n   663\t\t\t}\n   664\t\t}\n   665\t}\n   666\t\n   667\t// reviewRuntimeMaxEntries is the runtime inventory's own entry bound.\n   668\tconst reviewRuntimeMaxEntries = 4096\n   669\t\n   670\tfunc removeReviewOwnedContents(root *os.Root, maxFiles int, maxBytes int64) error {\n   671\t\tpaths := []string{}\n   672\t\tvar total int64\n   673\t\terr := fs.WalkDir(root.FS(), \".\", func(path string, d fs.DirEntry, err error) error {\n   674\t\t\tif err != nil {\n   675\t\t\t\treturn err\n   676\t\t\t}\n   677\t\t\tif path == \".\" {\n   678\t\t\t\treturn nil\n   679\t\t\t}\n   680\t\t\tif len(paths) >= maxFiles || strings.Count(path, \"/\") > 128 {\n","exit_code":0,"status":"completed"}}
