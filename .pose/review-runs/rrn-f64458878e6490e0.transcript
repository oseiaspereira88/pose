{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/git_snapshot_integrity.go | sed -n '1,430p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"context\"\n     6\t\t\"crypto/sha1\"\n     7\t\t\"crypto/sha256\"\n     8\t\t\"encoding/hex\"\n     9\t\t\"errors\"\n    10\t\t\"fmt\"\n    11\t\t\"hash\"\n    12\t\t\"io\"\n    13\t\t\"io/fs\"\n    14\t\t\"os\"\n    15\t\t\"os/exec\"\n    16\t\t\"path\"\n    17\t\t\"path/filepath\"\n    18\t\t\"runtime\"\n    19\t\t\"sort\"\n    20\t\t\"strconv\"\n    21\t\t\"strings\"\n    22\t\t\"time\"\n    23\t)\n    24\t\n    25\t// The bytes a snapshot reads are bounded by the committed tree it compares\n    26\t// against plus a margin, never less than the margin alone and never more than\n    27\t// the ceiling: a fixed bound stopped every closeout once a repository's\n    28\t// committed tree outgrew it (spec pose-git-snapshot-budget-scales-with-the-tree).\n    29\tvar (\n    30\t\tgitSnapshotMarginBytes  int64 = 256 << 20\n    31\t\tgitSnapshotCeilingBytes int64 = 4 << 30\n    32\t)\n    33\t\n    34\tfunc gitSnapshotBudget(committedBytes int64) int64 {\n    35\t\tif committedBytes < 0 {\n    36\t\t\tcommittedBytes = 0\n    37\t\t}\n    38\t\tif committedBytes > gitSnapshotCeilingBytes-gitSnapshotMarginBytes {\n    39\t\t\treturn gitSnapshotCeilingBytes\n    40\t\t}\n    41\t\treturn committedBytes + gitSnapshotMarginBytes\n    42\t}\n    43\t\n    44\t// A committed tree listing is read through a bounded buffer under a\n    45\t// deadline: 100,000 entries of ordinary paths fit well inside it, and a\n    46\t// listing past it fails closed before it is retained (review N2).\n    47\tvar (\n    48\t\tgitTreeListingMaxBytes int64 = 64 << 20\n    49\t\tgitTreeListingTimeout        = 2 * time.Minute\n    50\t)\n    51\t\n    52\t// listCommittedTree returns `ls-tree -r -l -z commit` of root, bounded.\n    53\tfunc listCommittedTree(root, commit string) ([]byte, error) {\n    54\t\tctx, cancel := context.WithTimeout(context.Background(), gitTreeListingTimeout)\n    55\t\tdefer cancel()\n    56\t\treturn runGovernanceGitCommandContext(ctx, NativeFiles(), root, []string{\"ls-tree\", \"-r\", \"-l\", \"-z\", commit}, gitTreeListingMaxBytes)\n    57\t}\n    58\t\n    59\t// gitCommittedTreeBytes sums the blob sizes of an `ls-tree -r -l -z` listing.\n    60\tfunc gitCommittedTreeBytes(listing []byte) int64 {\n    61\t\tvar total int64\n    62\t\tfor _, record := range bytes.Split(listing, []byte{0}) {\n    63\t\t\ti := bytes.IndexByte(record, '\\t')\n    64\t\t\tif i < 0 {\n    65\t\t\t\tcontinue\n    66\t\t\t}\n    67\t\t\tfields := strings.Fields(string(record[:i]))\n    68\t\t\tif len(fields) == 4 {\n    69\t\t\t\tif size, err := strconv.ParseInt(fields[3], 10, 64); err == nil && size > 0 {\n    70\t\t\t\t\ttotal += size\n    71\t\t\t\t}\n    72\t\t\t}\n    73\t\t}\n    74\t\treturn total\n    75\t}\n    76\t\n    77\t// Snapshot disk, including ignored files. Git status alone cannot witness\n    78\t// creation of an ignored output. WalkDir never follows a directory symlink.\n    79\tfunc dispatchDiskSnapshot(root string) (map[string]string, error) {\n    80\t\tentries := map[string]string{}\n    81\t\tvar total int64\n    82\t\tcommitted := int64(0)\n    83\t\tif listing, err := listCommittedTree(root, \"HEAD\"); err == nil {\n    84\t\t\tcommitted = gitCommittedTreeBytes(listing)\n    85\t\t}\n    86\t\tbudget := gitSnapshotBudget(committed)\n    87\t\terr := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {\n    88\t\t\tif err != nil {\n    89\t\t\t\treturn err\n    90\t\t\t}\n    91\t\t\trel, err := filepath.Rel(root, path)\n    92\t\t\tif err != nil {\n    93\t\t\t\treturn err\n    94\t\t\t}\n    95\t\t\tif rel == \".\" {\n    96\t\t\t\treturn nil\n    97\t\t\t}\n    98\t\t\tif rel == \".git\" {\n    99\t\t\t\tif entry.IsDir() {\n   100\t\t\t\t\treturn filepath.SkipDir\n   101\t\t\t\t}\n   102\t\t\t\treturn nil\n   103\t\t\t}\n   104\t\t\tinfo, err := entry.Info()\n   105\t\t\tif err != nil {\n   106\t\t\t\treturn err\n   107\t\t\t}\n   108\t\t\t// The per-root authority lock is runtime coordination state, not a\n   109\t\t\t// project input. Ignore only the exact regular file: a linked or special\n   110\t\t\t// replacement remains visible to the snapshot and fails closed.\n   111\t\t\tif filepath.ToSlash(rel) == \".pose/transfers/.authority-transfer.lock\" && info.Mode().IsRegular() {\n   112\t\t\t\treturn nil\n   113\t\t\t}\n   114\t\t\tif len(entries) >= 100000 {\n   115\t\t\t\treturn fmt.Errorf(\"disk snapshot exceeds 100000 entries\")\n   116\t\t\t}\n   117\t\t\thash := sha256.New()\n   118\t\t\tfmt.Fprintf(hash, \"%s\\x00\", info.Mode().String())\n   119\t\t\tswitch {\n   120\t\t\tcase info.Mode().IsRegular():\n   121\t\t\t\tfile, err := os.Open(path)\n   122\t\t\t\tif err != nil {\n   123\t\t\t\t\treturn err\n   124\t\t\t\t}\n   125\t\t\t\tn, readErr := io.Copy(hash, io.LimitReader(file, budget-total+1))\n   126\t\t\t\tcloseErr := file.Close()\n   127\t\t\t\ttotal += n\n   128\t\t\t\tif readErr != nil {\n   129\t\t\t\t\treturn readErr\n   130\t\t\t\t}\n   131\t\t\t\tif closeErr != nil {\n   132\t\t\t\t\treturn closeErr\n   133\t\t\t\t}\n   134\t\t\t\tif total > budget {\n   135\t\t\t\t\treturn fmt.Errorf(\"disk snapshot exceeds its budget of %d bytes\", budget)\n   136\t\t\t\t}\n   137\t\t\tcase info.Mode()&os.ModeSymlink != 0:\n   138\t\t\t\ttarget, err := os.Readlink(path)\n   139\t\t\t\tif err != nil {\n   140\t\t\t\t\treturn err\n   141\t\t\t\t}\n   142\t\t\t\thash.Write([]byte(target))\n   143\t\t\tcase info.IsDir():\n   144\t\t\tdefault:\n   145\t\t\t\treturn fmt.Errorf(\"unsupported file type at %q\", rel)\n   146\t\t\t}\n   147\t\t\tentries[filepath.ToSlash(rel)] = hex.EncodeToString(hash.Sum(nil))\n   148\t\t\treturn nil\n   149\t\t})\n   150\t\tif err != nil {\n   151\t\t\treturn nil, &GitSnapshotError{\"disk snapshot\", err}\n   152\t\t}\n   153\t\treturn entries, nil\n   154\t}\n   155\t\n   156\t// GitSnapshotError means a repository observation was unavailable, not clean.\n   157\ttype GitSnapshotError struct {\n   158\t\tOperation string\n   159\t\tCause     error\n   160\t}\n   161\t\n   162\tfunc (e *GitSnapshotError) Error() string {\n   163\t\treturn fmt.Sprintf(\"pose: Git snapshot unavailable (%s): %v\", e.Operation, e.Cause)\n   164\t}\n   165\tfunc (e *GitSnapshotError) Unwrap() error { return e.Cause }\n   166\t\n   167\tfunc snapshotGit(root string, args ...string) ([]byte, error) {\n   168\t\tcmd := gitCommand(append([]string{\"-C\", root}, args...)...)\n   169\t\t// Asking about the worktree writes nothing under .git: without this `git status` refreshes\n   170\t\t// and rewrites the index, which a governed read view that watches .git reads as an input that\n   171\t\t// changed during the operation (spec pose-git-status-leaves-the-git-directory-alone).\n   172\t\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\")\n   173\t\tout, err := cmd.Output()\n   174\t\tif err != nil {\n   175\t\t\treturn nil, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n   176\t\t}\n   177\t\treturn out, nil\n   178\t}\n   179\t\n   180\t// gitChangedPaths uses the NUL protocol; porcelain's quoted display is not a path.\n   181\tfunc gitChangedPaths(root string) ([]string, error) {\n   182\t\tout, err := snapshotGit(root, \"status\", \"--porcelain=v1\", \"-z\", \"--untracked-files=all\", \"--ignore-submodules=none\")\n   183\t\tif err != nil {\n   184\t\t\treturn nil, err\n   185\t\t}\n   186\t\tentries, err := parseGitStatusEntries(out)\n   187\t\tif err != nil {\n   188\t\t\treturn nil, err\n   189\t\t}\n   190\t\tpaths := make([]string, 0, len(entries)*2)\n   191\t\tfor _, entry := range entries {\n   192\t\t\tif untrackedAuthorityTransferLock(entry) {\n   193\t\t\t\tcontinue\n   194\t\t\t}\n   195\t\t\tpaths = append(paths, entry.Path)\n   196\t\t\tif entry.OrigPath != \"\" {\n   197\t\t\t\tpaths = append(paths, entry.OrigPath)\n   198\t\t\t}\n   199\t\t}\n   200\t\tsort.Strings(paths)\n   201\t\treturn paths, nil\n   202\t}\n   203\t\n   204\tfunc untrackedAuthorityTransferLock(entry GitStatusEntry) bool {\n   205\t\treturn entry.XY == \"??\" && entry.Path == \".pose/transfers/.authority-transfer.lock\"\n   206\t}\n   207\t\n   208\tfunc parseGitChangedPaths(out []byte) ([]string, error) {\n   209\t\tentries, err := parseGitStatusEntries(out)\n   210\t\tif err != nil {\n   211\t\t\treturn nil, err\n   212\t\t}\n   213\t\tpaths := []string{}\n   214\t\tfor _, entry := range entries {\n   215\t\t\tpaths = append(paths, entry.Path)\n   216\t\t\tif entry.OrigPath != \"\" {\n   217\t\t\t\tpaths = append(paths, entry.OrigPath)\n   218\t\t\t}\n   219\t\t}\n   220\t\tsort.Strings(paths)\n   221\t\treturn paths, nil\n   222\t}\n   223\t\n   224\t// gitMaterializedChanges checks the committed tree against disk independently\n   225\t// of index flags. No refresh/update-index mutation is needed to see hidden edits.\n   226\tfunc gitMaterializedChanges(root, commit string) ([]string, error) {\n   227\t\treturn gitMaterializedChangesFor(root, commit, nil)\n   228\t}\n   229\tfunc gitMaterializedChangesFor(root, commit string, matters func(string) bool) ([]string, error) {\n   230\t\treturn gitMaterializedChangesForIn(NativeFiles(), root, commit, matters, \"\")\n   231\t}\n   232\t\n   233\tfunc gitMaterializedChangesForIn(files Files, root, commit string, matters func(string) bool, producer string) ([]string, error) {\n   234\t\tfiles = FilesOrNative(files)\n   235\t\tif producer != \"\" {\n   236\t\t\tproducer = governanceProducerFromFiles(files, producer)\n   237\t\t}\n   238\t\trunGit := func(root string, args ...string) ([]byte, error) {\n   239\t\t\tif len(args) == 5 && args[0] == \"ls-tree\" {\n   240\t\t\t\treturn listCommittedTree(root, args[4])\n   241\t\t\t}\n   242\t\t\treturn snapshotGit(root, args...)\n   243\t\t}\n   244\t\tworktreeIdentity := dispatchWorktreeIdentity\n   245\t\tif producer != \"\" {\n   246\t\t\trunGit = func(root string, args ...string) ([]byte, error) {\n   247\t\t\t\treturn captureGovernanceGit(files, root, producer, args...)\n   248\t\t\t}\n   249\t\t\tworktreeIdentity = func(root string) (string, error) {\n   250\t\t\t\treturn dispatchWorktreeIdentityGoverned(files, root, producer)\n   251\t\t\t}\n   252\t\t}\n   253\t\tvar err error\n   254\t\troot, err = filepath.Abs(root)\n   255\t\tif err != nil {\n   256\t\t\treturn nil, &GitSnapshotError{\"root\", err}\n   257\t\t}\n   258\t\tif _, err := worktreeIdentity(root); err != nil {\n   259\t\t\treturn nil, err\n   260\t\t}\n   261\t\tout, err := runGit(root, \"ls-tree\", \"-r\", \"-l\", \"-z\", commit)\n   262\t\tif err != nil {\n   263\t\t\treturn nil, err\n   264\t\t}\n   265\t\tbudget := gitSnapshotBudget(gitCommittedTreeBytes(out))\n   266\t\tvar changed []string\n   267\t\tvar total int64\n   268\t\tcount := 0\n   269\t\tfor _, record := range bytes.Split(out, []byte{0}) {\n   270\t\t\tif len(record) == 0 {\n   271\t\t\t\tcontinue\n   272\t\t\t}\n   273\t\t\tcount++\n   274\t\t\tif count > 100000 {\n   275\t\t\t\treturn nil, &GitSnapshotError{\"tree snapshot\", fmt.Errorf(\"exceeds 100000 entries\")}\n   276\t\t\t}\n   277\t\t\ti := bytes.IndexByte(record, '\\t')\n   278\t\t\tif i < 0 {\n   279\t\t\t\treturn nil, &GitSnapshotError{\"tree protocol\", fmt.Errorf(\"missing path\")}\n   280\t\t\t}\n   281\t\t\tfields := strings.Fields(string(record[:i]))\n   282\t\t\tif len(fields) != 4 {\n   283\t\t\t\treturn nil, &GitSnapshotError{\"tree protocol\", fmt.Errorf(\"invalid entry\")}\n   284\t\t\t}\n   285\t\t\tfields = fields[:3]\n   286\t\t\tpath := string(record[i+1:])\n   287\t\t\tif fields[0] == \"160000\" && matters != nil && !matters(path) {\n   288\t\t\t\tcontinue\n   289\t\t\t}\n   290\t\t\tfull := filepath.Join(root, filepath.FromSlash(path))\n   291\t\t\t// Lstat every parent: a link in a parent must never read outside root.\n   292\t\t\tunsafe := false\n   293\t\t\tfor parent := filepath.Dir(full); parent != root; parent = filepath.Dir(parent) {\n   294\t\t\t\tif parent == filepath.Dir(parent) {\n   295\t\t\t\t\treturn nil, &GitSnapshotError{\"path\", fmt.Errorf(\"path outside worktree: %q\", path)}\n   296\t\t\t\t}\n   297\t\t\t\tvar info os.FileInfo\n   298\t\t\t\tvar e error\n   299\t\t\t\tif producer != \"\" {\n   300\t\t\t\t\tinfo, e = files.Lstat(parent)\n   301\t\t\t\t} else {\n   302\t\t\t\t\tinfo, e = os.Lstat(parent)\n   303\t\t\t\t}\n   304\t\t\t\tif e != nil || !info.IsDir() {\n   305\t\t\t\t\tunsafe = true\n   306\t\t\t\t\tbreak\n   307\t\t\t\t}\n   308\t\t\t}\n   309\t\t\tif unsafe {\n   310\t\t\t\tchanged = append(changed, path)\n   311\t\t\t\tcontinue\n   312\t\t\t}\n   313\t\t\tvar info os.FileInfo\n   314\t\t\tvar e error\n   315\t\t\tif producer != \"\" {\n   316\t\t\t\tinfo, e = files.Lstat(full)\n   317\t\t\t} else {\n   318\t\t\t\tinfo, e = os.Lstat(full)\n   319\t\t\t}\n   320\t\t\tif os.IsNotExist(e) {\n   321\t\t\t\tchanged = append(changed, path)\n   322\t\t\t\tcontinue\n   323\t\t\t}\n   324\t\t\tif e != nil {\n   325\t\t\t\treturn nil, &GitSnapshotError{\"lstat \" + path, e}\n   326\t\t\t}\n   327\t\t\tif fields[0] == \"160000\" {\n   328\t\t\t\tif !info.IsDir() {\n   329\t\t\t\t\tchanged = append(changed, path)\n   330\t\t\t\t\tcontinue\n   331\t\t\t\t}\n   332\t\t\t\tif _, err := worktreeIdentity(full); err != nil {\n   333\t\t\t\t\treturn nil, err\n   334\t\t\t\t}\n   335\t\t\t\thead, e := runGit(full, \"rev-parse\", \"--verify\", \"HEAD\")\n   336\t\t\t\tif e != nil {\n   337\t\t\t\t\treturn nil, e\n   338\t\t\t\t}\n   339\t\t\t\tvar dirty []string\n   340\t\t\t\tif producer != \"\" {\n   341\t\t\t\t\tdirty, e = gitChangedPathsGovernedIn(files, full, producer)\n   342\t\t\t\t} else {\n   343\t\t\t\t\tdirty, e = gitChangedPaths(full)\n   344\t\t\t\t}\n   345\t\t\t\tif e != nil {\n   346\t\t\t\t\treturn nil, e\n   347\t\t\t\t}\n   348\t\t\t\tif strings.TrimSpace(string(head)) != fields[2] || len(dirty) != 0 {\n   349\t\t\t\t\tchanged = append(changed, path)\n   350\t\t\t\t} else {\n   351\t\t\t\t\tvar nested []string\n   352\t\t\t\t\tif producer != \"\" {\n   353\t\t\t\t\t\tnested, err = gitMaterializedChangesForIn(files, full, fields[2], matters, producer)\n   354\t\t\t\t\t} else {\n   355\t\t\t\t\t\tnested, err = gitMaterializedChanges(full, fields[2])\n   356\t\t\t\t\t}\n   357\t\t\t\t\tif err != nil {\n   358\t\t\t\t\t\treturn nil, err\n   359\t\t\t\t\t}\n   360\t\t\t\t\tif len(nested) != 0 {\n   361\t\t\t\t\t\tchanged = append(changed, path)\n   362\t\t\t\t\t}\n   363\t\t\t\t}\n   364\t\t\t\tcontinue\n   365\t\t\t}\n   366\t\t\tvar raw []byte\n   367\t\t\tif fields[0] == \"120000\" {\n   368\t\t\t\tif info.Mode()&os.ModeSymlink == 0 {\n   369\t\t\t\t\tchanged = append(changed, path)\n   370\t\t\t\t\tcontinue\n   371\t\t\t\t}\n   372\t\t\t\tvar target string\n   373\t\t\t\ttarget, e = os.Readlink(full)\n   374\t\t\t\traw = []byte(target)\n   375\t\t\t} else {\n   376\t\t\t\tif !info.Mode().IsRegular() {\n   377\t\t\t\t\tchanged = append(changed, path)\n   378\t\t\t\t\tcontinue\n   379\t\t\t\t}\n   380\t\t\t\t// Verify executable materialization even when index flags hide it.\n   381\t\t\t\t// Windows does not materialize POSIX executable bits.\n   382\t\t\t\tif runtime.GOOS != \"windows\" && (info.Mode().Perm()&0111 != 0) != (fields[0] == \"100755\") {\n   383\t\t\t\t\tchanged = append(changed, path)\n   384\t\t\t\t}\n   385\t\t\t\tif info.Size() > budget-total {\n   386\t\t\t\t\treturn nil, &GitSnapshotError{\"read \" + path, fmt.Errorf(\"snapshot exceeds its budget of %d bytes\", budget)}\n   387\t\t\t\t}\n   388\t\t\t\tvar file *os.File\n   389\t\t\t\tfile, e = os.Open(full)\n   390\t\t\t\tif e == nil {\n   391\t\t\t\t\traw, e = io.ReadAll(io.LimitReader(file, budget-total+1))\n   392\t\t\t\t\tcloseErr := file.Close()\n   393\t\t\t\t\tif e == nil {\n   394\t\t\t\t\t\te = closeErr\n   395\t\t\t\t\t}\n   396\t\t\t\t\ttotal += int64(len(raw))\n   397\t\t\t\t\tif total > budget {\n   398\t\t\t\t\t\treturn nil, &GitSnapshotError{\"read \" + path, fmt.Errorf(\"snapshot exceeds its budget of %d bytes\", budget)}\n   399\t\t\t\t\t}\n   400\t\t\t\t}\n   401\t\t\t}\n   402\t\t\tif e != nil {\n   403\t\t\t\treturn nil, &GitSnapshotError{\"read \" + path, e}\n   404\t\t\t}\n   405\t\t\tcmd := gitCommand(\"-C\", root, \"hash-object\", \"--stdin\", \"--path=\"+path)\n   406\t\t\tif fields[0] == \"120000\" {\n   407\t\t\t\tcmd = gitCommand(\"-C\", root, \"hash-object\", \"--stdin\", \"--no-filters\")\n   408\t\t\t}\n   409\t\t\tcmd.Stdin = bytes.NewReader(raw)\n   410\t\t\thash, e := cmd.Output()\n   411\t\t\tif e != nil {\n   412\t\t\t\treturn nil, &GitSnapshotError{\"hash \" + path, e}\n   413\t\t\t}\n   414\t\t\tif strings.TrimSpace(string(hash)) != fields[2] {\n   415\t\t\t\tchanged = append(changed, path)\n   416\t\t\t}\n   417\t\t}\n   418\t\tsort.Strings(changed)\n   419\t\treturn changed, nil\n   420\t}\n   421\t\n   422\t// These readers are shared by the bundle, obligation and execution snapshots.\n   423\tvar ErrGitUnknown = errors.New(\"pose: git state is unknown\")\n   424\tvar ErrGitUnavailable = errors.New(\"pose: not a git repository\")\n   425\t\n   426\tfunc (e *GitSnapshotError) Is(target error) bool { return target == ErrGitUnknown }\n   427\t\n   428\tfunc hasGitMetadata(root string) bool {\n   429\t\tdir, err := filepath.Abs(root)\n   430\t\tif err != nil {\n","exit_code":0,"status":"completed"}}
