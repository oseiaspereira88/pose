{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/discovery.go | sed -n '350,410p'; nl -ba pose-mcp/internal/pose/assessment_agnostic_test.go | sed -n '90,215p'\"","aggregated_output":"   350\t\t}\n   351\t\tfor _, m := range manifests {\n   352\t\t\tif _, err := os.Stat(filepath.Join(dir, m)); err == nil {\n   353\t\t\t\treturn true\n   354\t\t\t}\n   355\t\t}\n   356\t\tentries, err := os.ReadDir(dir)\n   357\t\tif err == nil {\n   358\t\t\tfor _, e := range entries {\n   359\t\t\t\tif !e.IsDir() {\n   360\t\t\t\t\text := filepath.Ext(e.Name())\n   361\t\t\t\t\tif ext == \".sln\" || ext == \".csproj\" || ext == \".fsproj\" || ext == \".vbproj\" {\n   362\t\t\t\t\t\treturn true\n   363\t\t\t\t\t}\n   364\t\t\t\t}\n   365\t\t\t}\n   366\t\t}\n   367\t\treturn false\n   368\t}\n   369\t\n   370\t// DiscoverAllComponents dynamically finds and discovers all components in the repository.\n   371\tfunc (s Store) DiscoverAllComponents() ([]*ComponentDiscoveryState, error) {\n   372\t\ttargets := s.FindComponentDirectories()\n   373\t\tif len(targets) == 0 {\n   374\t\t\ttargets = []string{\".\"}\n   375\t\t}\n   376\t\n   377\t\tvar results []*ComponentDiscoveryState\n   378\t\tfor _, t := range targets {\n   379\t\t\tstate, err := s.DiscoverComponent(t)\n   380\t\t\tif err != nil {\n   381\t\t\t\treturn nil, err\n   382\t\t\t}\n   383\t\t\tif err := s.SaveComponentState(state); err != nil {\n   384\t\t\t\treturn nil, err\n   385\t\t\t}\n   386\t\t\tresults = append(results, state)\n   387\t\t}\n   388\t\n   389\t\tif err := s.GenerateConsolidatedAssessment(results); err != nil {\n   390\t\t\treturn nil, err\n   391\t\t}\n   392\t\treturn results, nil\n   393\t}\n   394\t\n   395\t// DiscoverComponent scans a directory under root and produces a ComponentDiscoveryState.\n   396\tfunc (s Store) DiscoverComponent(relPath string) (*ComponentDiscoveryState, error) {\n   397\t\tcleanPath, absPath, err := s.resolveComponentDir(relPath)\n   398\t\tif err != nil {\n   399\t\t\treturn nil, fmt.Errorf(\"discover component %q: %w\", relPath, err)\n   400\t\t}\n   401\t\tslug := slugifyAssessmentPath(cleanPath)\n   402\t\tvar binding *AssessmentBinding\n   403\t\tif current, committed := s.CurrentAssessmentBinding(cleanPath); committed {\n   404\t\t\tbinding = &current\n   405\t\t}\n   406\t\n   407\t\tstate := &ComponentDiscoveryState{\n   408\t\t\tBinding:           binding,\n   409\t\t\tSchemaVersion:     1,\n   410\t\t\tComponentSlug:     slug,\n    90\t\twriteAssessmentFixture(t, root, \"mcp-provider/catalog.json\", \"{\\\"name\\\":\\\"POSE_PROJECT_ROOT\\\",\\\"tools\\\":[{\\\"inputSchema\\\":{\\\"type\\\":\\\"object\\\"},\\\"description\\\":\\\"lookup\\\",\\\"name\\\":\\\"widget_lookup\\\"}]}\\n\")\n    91\t\twriteAssessmentFixture(t, root, \".generated-site/bundle.js\", \"bus.subscribe(\\\"generated.noise\\\"); // TODO generated\\n\")\n    92\t\treturn root\n    93\t}\n    94\t\n    95\tfunc findContract(matrix *pose.IntegrationMatrix, protocol, contains string) *pose.IntegrationContract {\n    96\t\tfor index := range matrix.Contracts {\n    97\t\t\tcontract := &matrix.Contracts[index]\n    98\t\t\tif contract.Protocol == protocol && strings.Contains(contract.Name, contains) {\n    99\t\t\t\treturn contract\n   100\t\t\t}\n   101\t\t}\n   102\t\treturn nil\n   103\t}\n   104\t\n   105\tfunc TestProjectAgnosticAssessmentEngines(t *testing.T) {\n   106\t\troot := neutralAssessmentRepo(t)\n   107\t\tstore := pose.Store{Root: root}\n   108\t\n   109\t\tcomponent, err := store.DiscoverComponent(\"service-a\")\n   110\t\tif err != nil {\n   111\t\t\tt.Fatal(err)\n   112\t\t}\n   113\t\tif component.ComponentSlug != \"service-a\" || component.Metadata[\"owner\"] != \"team-a\" {\n   114\t\t\tt.Fatalf(\"discovery identity/metadata = %#v\", component)\n   115\t\t}\n   116\t\tif err := store.SaveComponentState(component); err != nil {\n   117\t\t\tt.Fatal(err)\n   118\t\t}\n   119\t\tif err := store.GenerateConsolidatedAssessment([]*pose.ComponentDiscoveryState{component}); err != nil {\n   120\t\t\tt.Fatal(err)\n   121\t\t}\n   122\t\n   123\t\tmatrix, err := store.AnalyzeIntegrations()\n   124\t\tif err != nil {\n   125\t\t\tt.Fatal(err)\n   126\t\t}\n   127\t\tif contract := findContract(matrix, \"rest\", \"/v1/widgets\"); contract == nil || contract.Status != \"active\" {\n   128\t\t\tt.Fatalf(\"active REST contract not derived: %#v\", contract)\n   129\t\t}\n   130\t\tif contract := findContract(matrix, \"rest\", \"/v1/orphan\"); contract == nil || contract.Status != \"gap\" {\n   131\t\t\tt.Fatalf(\"provider-only REST gap not derived: %#v\", contract)\n   132\t\t}\n   133\t\tif contract := findContract(matrix, \"rest\", \"/tmp/not-an-endpoint\"); contract != nil {\n   134\t\t\tt.Fatalf(\"non-client path misclassified as REST consumer: %#v\", contract)\n   135\t\t}\n   136\t\tif contract := findContract(matrix, \"rest\", \"/v1/documented\"); contract == nil || contract.Status != \"active\" || contract.Provider != \"external-contracts\" {\n   137\t\t\tt.Fatalf(\"OpenAPI REST contract not derived: %#v\", contract)\n   138\t\t}\n   139\t\tif contract := findContract(matrix, \"message\", \"payments.missing\"); contract == nil || contract.Provider != \"unobserved\" {\n   140\t\t\tt.Fatalf(\"consumer-only message gap not derived: %#v\", contract)\n   141\t\t}\n   142\t\tif contract := findContract(matrix, \"message\", \"payload.json\"); contract != nil {\n   143\t\t\tt.Fatalf(\"message payload misclassified as topic: %#v\", contract)\n   144\t\t}\n   145\t\tif contract := findContract(matrix, \"message\", \"not.a.topic\"); contract != nil {\n   146\t\t\tt.Fatalf(\"ordinary consumer field misclassified as message topic: %#v\", contract)\n   147\t\t}\n   148\t\tif contract := findContract(matrix, \"message\", \"generated.noise\"); contract != nil {\n   149\t\t\tt.Fatalf(\"hidden generated directory was assessed: %#v\", contract)\n   150\t\t}\n   151\t\tif contract := findContract(matrix, \"protobuf\", \"widget.proto\"); contract == nil || contract.Status != \"active\" {\n   152\t\t\tt.Fatalf(\"protobuf contract not derived: %#v\", contract)\n   153\t\t}\n   154\t\tif contract := findContract(matrix, \"mcp\", \"widget_lookup\"); contract == nil || contract.Status != \"active\" {\n   155\t\t\tt.Fatalf(\"MCP contract not derived: %#v\", contract)\n   156\t\t}\n   157\t\tif contract := findContract(matrix, \"mcp\", \"POSE_PROJECT_ROOT\"); contract != nil {\n   158\t\t\tt.Fatalf(\"ordinary JSON name misclassified as MCP tool: %#v\", contract)\n   159\t\t}\n   160\t\tif err := store.SaveIntegrationMatrix(matrix); err != nil {\n   161\t\t\tt.Fatal(err)\n   162\t\t}\n   163\t\n   164\t\treport, err := store.AnalyzeTechDebt()\n   165\t\tif err != nil {\n   166\t\t\tt.Fatal(err)\n   167\t\t}\n   168\t\tif report.Summary.TotalMarkers != 4 || report.Summary.CoveredCount != 2 || report.Summary.UncoveredCount != 2 {\n   169\t\t\tt.Fatalf(\"debt reconciliation summary = %#v\", report.Summary)\n   170\t\t}\n   171\t\tfor _, item := range report.Items {\n   172\t\t\tif item.File == \"service-b/prose.go\" {\n   173\t\t\t\tt.Fatalf(\"ordinary lowercase prose misclassified as debt: %#v\", item)\n   174\t\t\t}\n   175\t\t\tswitch item.File {\n   176\t\t\tcase \"service-a/debt.go\":\n   177\t\t\t\tif item.Coverage != \"covered_by_spec\" || item.CoverageRef != \"spec:widget-maintenance\" || item.Recommendation != \"none\" {\n   178\t\t\t\t\tt.Fatalf(\"active spec coverage = %#v\", item)\n   179\t\t\t\t}\n   180\t\t\tcase \"service-b/untracked.go\":\n   181\t\t\t\tif item.Coverage != \"uncovered\" || item.CoverageRef != \"\" {\n   182\t\t\t\t\tt.Fatalf(\"done spec must not cover debt = %#v\", item)\n   183\t\t\t\t}\n   184\t\t\tcase \"service-a/lifetime.rs\":\n   185\t\t\t\tif item.Marker != \"STUB\" || item.Coverage != \"uncovered\" {\n   186\t\t\t\t\tt.Fatalf(\"Rust lifetime/stub classification = %#v\", item)\n   187\t\t\t\t}\n   188\t\t\t}\n   189\t\t}\n   190\t\tif err := store.SaveTechDebtReport(report); err != nil {\n   191\t\t\tt.Fatal(err)\n   192\t\t}\n   193\t\n   194\t\tfor _, rel := range []string{\n   195\t\t\t\".pose/assessments/service-a.md\", \".pose/assessments/consolidated.md\",\n   196\t\t\t\".pose/assessments/integrations.md\", \".pose/assessments/technical-debt.md\",\n   197\t\t} {\n   198\t\t\traw, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(rel)))\n   199\t\t\tif err != nil {\n   200\t\t\t\tt.Fatal(err)\n   201\t\t\t}\n   202\t\t\tlower := strings.ToLower(string(raw))\n   203\t\t\tfor _, forbidden := range []string{\"harne8\", \"graphforge\", \"conductor\", \"harness\", \"portal\", \"pose-dist\"} {\n   204\t\t\t\tif strings.Contains(lower, forbidden) {\n   205\t\t\t\t\tt.Fatalf(\"%s leaked producer identity %q\", rel, forbidden)\n   206\t\t\t\t}\n   207\t\t\t}\n   208\t\t}\n   209\t\n   210\t\tsecond, err := store.AnalyzeIntegrations()\n   211\t\tif err != nil {\n   212\t\t\tt.Fatal(err)\n   213\t\t}\n   214\t\tif !reflect.DeepEqual(matrix.Contracts, second.Contracts) || !reflect.DeepEqual(matrix.Gaps, second.Gaps) {\n   215\t\t\tt.Fatal(\"integration observations are not deterministic\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/assess.go | sed -n '1,390p'\"","aggregated_output":"     1\tpackage cli\n     2\t\n     3\t// pose assess (spec pose-capability-mechanism): capability assessment as a\n     4\t// POSE-native artifact. Bare `assess` validates structure, evidence and\n     5\t// staleness; `init` scaffolds the 16 default mechanisms; `snapshot` appends\n     6\t// to the append-only history; `diff` compares two snapshots. Scores are\n     7\t// human judgment — nothing here computes one.\n     8\t\n     9\timport (\n    10\t\t\"encoding/json\"\n    11\t\t\"errors\"\n    12\t\t\"fmt\"\n    13\t\t\"io\"\n    14\t\t\"os\"\n    15\t\t\"path/filepath\"\n    16\t\t\"regexp\"\n    17\t\t\"sort\"\n    18\t\t\"strconv\"\n    19\t\t\"strings\"\n    20\t\t\"time\"\n    21\t\n    22\t\t\"github.com/harne8/pose-mcp/internal/pose\"\n    23\t)\n    24\t\n    25\ttype capabilityPolicy struct {\n    26\t\tStaleAfterDays    int `json:\"stale_after_days\"`\n    27\t\tStaleAfterCommits int `json:\"stale_after_commits\"`\n    28\t}\n    29\t\n    30\tfunc defaultCapabilityPolicy() capabilityPolicy {\n    31\t\treturn capabilityPolicy{StaleAfterDays: 30, StaleAfterCommits: 200}\n    32\t}\n    33\t\n    34\tfunc loadCapabilityPolicyIn(files pose.Files, root string) capabilityPolicy {\n    35\t\tpolicy := defaultCapabilityPolicy()\n    36\t\traw, err := files.ReadFile(filepath.Join(root, \".pose\", \"policy\", \"capabilities.json\"))\n    37\t\tif err != nil {\n    38\t\t\treturn policy\n    39\t\t}\n    40\t\tvar loaded capabilityPolicy\n    41\t\tif json.Unmarshal(raw, &loaded) == nil {\n    42\t\t\tif loaded.StaleAfterDays > 0 {\n    43\t\t\t\tpolicy.StaleAfterDays = loaded.StaleAfterDays\n    44\t\t\t}\n    45\t\t\tif loaded.StaleAfterCommits > 0 {\n    46\t\t\t\tpolicy.StaleAfterCommits = loaded.StaleAfterCommits\n    47\t\t\t}\n    48\t\t}\n    49\t\treturn policy\n    50\t}\n    51\t\n    52\t// loadCapabilityPolicy reads and writes the filesystem directly; loadCapabilityPolicyIn takes the\n    53\t// operation's files.\n    54\tfunc loadCapabilityPolicy(root string) capabilityPolicy {\n    55\t\treturn loadCapabilityPolicyIn(pose.NativeFiles(), root)\n    56\t}\n    57\t\n    58\t// assessPersists reports whether an assess command may write its records:\n    59\t// not with --no-persist, and never in the sealed checkout of a delegated\n    60\t// review (spec pose-assess-leaves-sealed-checkouts-alone R1, R2).\n    61\tfunc assessPersists(root string, args []string) (bool, string) {\n    62\t\tfor _, a := range args {\n    63\t\t\tif a == \"--no-persist\" {\n    64\t\t\t\treturn false, \"not persisted (--no-persist)\"\n    65\t\t\t}\n    66\t\t}\n    67\t\tif pose.IsSealedCheckout(root) {\n    68\t\t\treturn false, \"not persisted: this is the sealed checkout of a delegated review\"\n    69\t\t}\n    70\t\treturn true, \"\"\n    71\t}\n    72\t\n    73\tfunc cmdAssess(root string, args []string, stdout, stderr io.Writer) int {\n    74\t\tlocale := cliLocaleValue()\n    75\t\tif len(args) > 0 && pose.IsSealedCheckout(root) {\n    76\t\t\tswitch args[0] {\n    77\t\t\tcase \"init\", \"snapshot\", \"request\":\n    78\t\t\t\trender(stdout, stderr).Failure(\"pose assess \" + args[0] + \": writes the capability assessment, which a sealed review checkout does not take\")\n    79\t\t\t\treturn 1\n    80\t\t\t}\n    81\t\t}\n    82\t\tif len(args) > 0 {\n    83\t\t\tswitch args[0] {\n    84\t\t\tcase \"init\":\n    85\t\t\t\treturn assessInit(root, stdout, stderr, locale)\n    86\t\t\tcase \"snapshot\":\n    87\t\t\t\treturn assessSnapshot(root, stdout, stderr, locale)\n    88\t\t\tcase \"diff\":\n    89\t\t\t\treturn assessDiff(root, args[1:], stdout, stderr, locale)\n    90\t\t\tcase \"stale\":\n    91\t\t\t\treturn assessStale(root, args[1:], stdout, stderr, locale)\n    92\t\t\tcase \"request\":\n    93\t\t\t\treturn assessRequest(root, args[1:], stdout, stderr, locale)\n    94\t\t\tcase \"discover\":\n    95\t\t\t\treturn assessDiscover(root, args[1:], stdout, stderr, locale)\n    96\t\t\tcase \"integrate\":\n    97\t\t\t\treturn assessIntegrate(root, args[1:], stdout, stderr, locale)\n    98\t\t\tcase \"tech-debt\":\n    99\t\t\t\treturn assessTechDebt(root, args[1:], stdout, stderr, locale)\n   100\t\t\tcase \"design\":\n   101\t\t\t\treturn assessDesign(root, args[1:], stdout, stderr, locale)\n   102\t\t\tcase \"--json\":\n   103\t\t\t\treturn assessValidate(root, true, stdout, stderr, locale)\n   104\t\t\tdefault:\n   105\t\t\t\tfmt.Fprintln(stderr, cliText(locale,\n   106\t\t\t\t\t\"Usage: pose assess [init|snapshot|diff|stale|request|discover|integrate|tech-debt|design [options]|--json]\",\n   107\t\t\t\t\t\"Uso: pose assess [init|snapshot|diff|stale|request|discover|integrate|tech-debt|design [opções]|--json]\"))\n   108\t\t\t\treturn 2\n   109\t\t\t}\n   110\t\t}\n   111\t\treturn assessValidate(root, false, stdout, stderr, locale)\n   112\t}\n   113\t\n   114\tfunc assessInit(root string, stdout, stderr io.Writer, locale cliLocale) int {\n   115\t\tstore := pose.Store{Root: root}\n   116\t\tpath := store.CapabilityAssessmentPath()\n   117\t\tif _, err := os.Stat(path); err == nil {\n   118\t\t\tfmt.Fprintf(stderr, cliText(locale,\n   119\t\t\t\t\"Error: %s already exists; edit it instead of re-initializing\\n\",\n   120\t\t\t\t\"Erro: %s já existe; edite-o em vez de re-inicializar\\n\"), path)\n   121\t\t\treturn 1\n   122\t\t}\n   123\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n   124\t\t\tfmt.Fprintf(stderr, \"pose assess init: %v\\n\", err)\n   125\t\t\treturn 1\n   126\t\t}\n   127\t\tcontent := capabilityTemplate(assessBaselineCommit(root))\n   128\t\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n   129\t\t\tfmt.Fprintf(stderr, \"pose assess init: %v\\n\", err)\n   130\t\t\treturn 1\n   131\t\t}\n   132\t\tfmt.Fprintf(stdout, cliText(locale,\n   133\t\t\t\"Capability assessment created: %s (16 default mechanisms; edit scores, targets, evidence and prose)\\n\",\n   134\t\t\t\"Capability assessment criado: %s (16 mecanismos default; edite scores, targets, evidência e prosa)\\n\"), path)\n   135\t\treturn 0\n   136\t}\n   137\t\n   138\t// assessBaselineCommit resolves HEAD for the scaffold; \"0000000\" when git is\n   139\t// unavailable so the artifact still parses and the user edits it in.\n   140\tfunc assessBaselineCommit(root string) string {\n   141\t\tout, err := pose.RawHistoryGit(root, \"rev-parse\", \"--short=12\", \"HEAD\").Output()\n   142\t\tif err != nil {\n   143\t\t\treturn \"0000000\"\n   144\t\t}\n   145\t\tcommit := strings.TrimSpace(string(out))\n   146\t\tif commit == \"\" {\n   147\t\t\treturn \"0000000\"\n   148\t\t}\n   149\t\treturn commit\n   150\t}\n   151\t\n   152\ttype assessReport struct {\n   153\t\tPath        string   `json:\"path\"`\n   154\t\tMechanisms  int      `json:\"mechanisms\"`\n   155\t\tErrors      []string `json:\"errors,omitempty\"`\n   156\t\tWarnings    []string `json:\"warnings,omitempty\"`\n   157\t\tAssessedAt  string   `json:\"assessed_at\"`\n   158\t\tAgeDays     int      `json:\"age_days\"`\n   159\t\tCommitsLag  string   `json:\"commits_since_baseline\"` // number or \"unknown\"\n   160\t\tStaleByDays bool     `json:\"stale_by_days\"`\n   161\t\tStaleByLag  bool     `json:\"stale_by_commits\"`\n   162\t}\n   163\t\n   164\t// runAssessValidation is the shared R6 validation: structure, evidence,\n   165\t// stable-id contract, staleness. It never writes.\n   166\tfunc runAssessValidationIn(files pose.Files, root string) (*assessReport, error) {\n   167\t\tstore := pose.Store{Root: root, FS: files}\n   168\t\tassessment, err := store.LoadCapabilityAssessment()\n   169\t\tif err != nil {\n   170\t\t\treturn nil, err\n   171\t\t}\n   172\t\treport := &assessReport{Path: assessment.Path, Mechanisms: len(assessment.Mechanisms), AssessedAt: assessment.AssessedAt}\n   173\t\treport.Errors = append(report.Errors, store.ValidateCapabilityEvidence(assessment)...)\n   174\t\n   175\t\thistory, err := pose.LoadCapabilityHistoryIn(files, store.CapabilityHistoryPath())\n   176\t\tif err != nil {\n   177\t\t\treturn nil, err\n   178\t\t}\n   179\t\tif effective := pose.EffectiveSnapshots(history); len(effective) > 0 {\n   180\t\t\tlatest := effective[len(effective)-1]\n   181\t\t\tfor _, id := range pose.RenumberedMechanisms(latest, assessment) {\n   182\t\t\t\treport.Errors = append(report.Errors,\n   183\t\t\t\t\tfmt.Sprintf(\"mechanism %q was published in the latest snapshot but is gone from the assessment; retire it (`- retired: true`) instead of removing it\", id))\n   184\t\t\t}\n   185\t\t}\n   186\t\n   187\t\tpolicy := loadCapabilityPolicyIn(files, root)\n   188\t\tif assessed, err := time.Parse(\"2006-01-02\", assessment.AssessedAt); err == nil {\n   189\t\t\treport.AgeDays = int(files.Now().Sub(assessed).Hours() / 24)\n   190\t\t\tif report.AgeDays > policy.StaleAfterDays {\n   191\t\t\t\treport.StaleByDays = true\n   192\t\t\t\treport.Warnings = append(report.Warnings,\n   193\t\t\t\t\tfmt.Sprintf(\"assessment is %d days old (policy: %d); consider reassessing\", report.AgeDays, policy.StaleAfterDays))\n   194\t\t\t}\n   195\t\t}\n   196\t\treport.CommitsLag = \"unknown\"\n   197\t\tif out, err := pose.RawHistoryGit(root, \"rev-list\", \"--count\", assessment.BaselineCommit+\"..HEAD\").Output(); err == nil {\n   198\t\t\tlag := strings.TrimSpace(string(out))\n   199\t\t\treport.CommitsLag = lag\n   200\t\t\tif n, err := strconv.Atoi(lag); err == nil && n > policy.StaleAfterCommits {\n   201\t\t\t\treport.StaleByLag = true\n   202\t\t\t\treport.Warnings = append(report.Warnings,\n   203\t\t\t\t\tfmt.Sprintf(\"baseline_commit is %d commits behind HEAD (policy: %d); consider reassessing\", n, policy.StaleAfterCommits))\n   204\t\t\t}\n   205\t\t}\n   206\t\treturn report, nil\n   207\t}\n   208\t\n   209\t// runAssessValidation reads and writes the filesystem directly; runAssessValidationIn takes the\n   210\t// operation's files.\n   211\tfunc runAssessValidation(root string) (*assessReport, error) {\n   212\t\treturn runAssessValidationIn(pose.NativeFiles(), root)\n   213\t}\n   214\t\n   215\tfunc assessValidate(root string, asJSON bool, stdout, stderr io.Writer, locale cliLocale) int {\n   216\t\treport, err := runAssessValidation(root)\n   217\t\tif err != nil {\n   218\t\t\tfmt.Fprintf(stderr, \"pose assess: %v\\n\", err)\n   219\t\t\treturn 1\n   220\t\t}\n   221\t\tif asJSON {\n   222\t\t\tencoded, _ := json.MarshalIndent(report, \"\", \"  \")\n   223\t\t\tfmt.Fprintln(stdout, string(encoded))\n   224\t\t\tif len(report.Errors) > 0 {\n   225\t\t\t\treturn 1\n   226\t\t\t}\n   227\t\t\treturn 0\n   228\t\t}\n   229\t\tfor _, issue := range report.Errors {\n   230\t\t\tfmt.Fprintf(stdout, \"[ERRO] %s\\n\", issue)\n   231\t\t}\n   232\t\tfor _, warning := range report.Warnings {\n   233\t\t\tfmt.Fprintf(stdout, \"[AVISO] %s\\n\", warning)\n   234\t\t}\n   235\t\tif len(report.Errors) > 0 {\n   236\t\t\tfmt.Fprintf(stdout, cliText(locale,\n   237\t\t\t\t\"Result: FAILURE — %d error(s) in %s\\n\",\n   238\t\t\t\t\"Resultado: FALHA — %d erro(s) em %s\\n\"), len(report.Errors), report.Path)\n   239\t\t\treturn 1\n   240\t\t}\n   241\t\tfmt.Fprintf(stdout, cliText(locale,\n   242\t\t\t\"Result: SUCCESS — %d mechanisms, assessed %s (%d days ago, %s commits since baseline)\\n\",\n   243\t\t\t\"Resultado: SUCESSO — %d mecanismos, avaliado em %s (%d dias atrás, %s commits desde a baseline)\\n\"),\n   244\t\t\treport.Mechanisms, report.AssessedAt, report.AgeDays, report.CommitsLag)\n   245\t\treturn 0\n   246\t}\n   247\t\n   248\tfunc assessSnapshot(root string, stdout, stderr io.Writer, locale cliLocale) int {\n   249\t\treport, err := runAssessValidation(root)\n   250\t\tif err != nil {\n   251\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   252\t\t\treturn 1\n   253\t\t}\n   254\t\tif len(report.Errors) > 0 {\n   255\t\t\tfor _, issue := range report.Errors {\n   256\t\t\t\tfmt.Fprintf(stdout, \"[ERRO] %s\\n\", issue)\n   257\t\t\t}\n   258\t\t\tfmt.Fprintln(stderr, cliText(locale,\n   259\t\t\t\t\"Error: fix validation errors before snapshotting\",\n   260\t\t\t\t\"Erro: corrija os erros de validação antes do snapshot\"))\n   261\t\t\treturn 1\n   262\t\t}\n   263\t\tstore := pose.Store{Root: root}\n   264\t\traw, err := os.ReadFile(store.CapabilityAssessmentPath())\n   265\t\tif err != nil {\n   266\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   267\t\t\treturn 1\n   268\t\t}\n   269\t\tassessment, err := pose.ParseCapabilityAssessment(string(raw))\n   270\t\tif err != nil {\n   271\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   272\t\t\treturn 1\n   273\t\t}\n   274\t\n   275\t\t// R4 (spec pose-capability-assessment-triggers): running a snapshot IS\n   276\t\t// the human/agent's act of reassessment, so it closes every currently\n   277\t\t// pending demand — clear every mechanism's stale marks before hashing,\n   278\t\t// so merely accumulating a trigger (no human review yet) never fools\n   279\t\t// the \"no change since last snapshot\" dedup check below.\n   280\t\tcontent := string(raw)\n   281\t\tvar clearedStale []string\n   282\t\tfor _, mechanism := range assessment.Mechanisms {\n   283\t\t\tif len(mechanism.StaleTriggers) == 0 {\n   284\t\t\t\tcontinue\n   285\t\t\t}\n   286\t\t\tupdated, didClear, cerr := clearStaleMarks(content, mechanism.ID)\n   287\t\t\tif cerr != nil {\n   288\t\t\t\tcontinue\n   289\t\t\t}\n   290\t\t\tif didClear {\n   291\t\t\t\tcontent = updated\n   292\t\t\t\tclearedStale = append(clearedStale, mechanism.ID)\n   293\t\t\t}\n   294\t\t}\n   295\t\n   296\t\tevent := pose.CapabilitySnapshot{\n   297\t\t\tSchema:         pose.CapabilitySnapshotSchema,\n   298\t\t\tAt:             time.Now().UTC().Format(time.RFC3339),\n   299\t\t\tBaselineCommit: assessment.BaselineCommit,\n   300\t\t\tContentHash:    pose.ContentHash12(content),\n   301\t\t\tScores:         assessment.ScoresOf(),\n   302\t\t\tClearedStale:   clearedStale,\n   303\t\t}\n   304\t\thistory, err := pose.LoadCapabilityHistory(store.CapabilityHistoryPath())\n   305\t\tif err != nil {\n   306\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   307\t\t\treturn 1\n   308\t\t}\n   309\t\tif len(clearedStale) > 0 {\n   310\t\t\tif err := os.WriteFile(store.CapabilityAssessmentPath(), []byte(content), 0o644); err != nil {\n   311\t\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   312\t\t\t\treturn 1\n   313\t\t\t}\n   314\t\t\tfmt.Fprintf(stdout, cliText(locale,\n   315\t\t\t\t\"Cleared stale marks: %s\\n\", \"Marcas de staleness limpas: %s\\n\"), strings.Join(clearedStale, \", \"))\n   316\t\t}\n   317\t\tif len(clearedStale) == 0 && len(history) > 0 && history[len(history)-1].ContentHash == event.ContentHash {\n   318\t\t\tfmt.Fprintf(stdout, cliText(locale,\n   319\t\t\t\t\"No change since the last snapshot (content hash %s); nothing appended\\n\",\n   320\t\t\t\t\"Sem mudança desde o último snapshot (content hash %s); nada acrescentado\\n\"), event.ContentHash)\n   321\t\t\treturn 0\n   322\t\t}\n   323\t\tencoded, err := json.Marshal(event)\n   324\t\tif err != nil {\n   325\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   326\t\t\treturn 1\n   327\t\t}\n   328\t\tf, err := os.OpenFile(store.CapabilityHistoryPath(), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)\n   329\t\tif err != nil {\n   330\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   331\t\t\treturn 1\n   332\t\t}\n   333\t\tdefer f.Close()\n   334\t\tif _, err := f.Write(append(encoded, '\\n')); err != nil {\n   335\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", err)\n   336\t\t\treturn 1\n   337\t\t}\n   338\t\tif hookErr := EmitHook(root, HookEvent{Kind: \"assessment_snapshot\", Commit: assessment.BaselineCommit, At: time.Now().UTC()}); hookErr != nil {\n   339\t\t\tfmt.Fprintf(stderr, \"pose assess snapshot: %v\\n\", hookErr)\n   340\t\t\treturn 1\n   341\t\t}\n   342\t\tfmt.Fprintf(stdout, cliText(locale,\n   343\t\t\t\"Snapshot appended: %s (%d mechanisms, content hash %s)\\n\",\n   344\t\t\t\"Snapshot acrescentado: %s (%d mecanismos, content hash %s)\\n\"), event.At, len(event.Scores), event.ContentHash)\n   345\t\treturn 0\n   346\t}\n   347\t\n   348\tfunc assessDiff(root string, args []string, stdout, stderr io.Writer, locale cliLocale) int {\n   349\t\tvar fromTS, toTS, against string\n   350\t\tasJSON := false\n   351\t\tfor i := 0; i < len(args); i++ {\n   352\t\t\tswitch args[i] {\n   353\t\t\tcase \"--json\":\n   354\t\t\t\tasJSON = true\n   355\t\t\tcase \"--against\":\n   356\t\t\t\tif i+1 >= len(args) {\n   357\t\t\t\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --against requires a project id\", \"Erro: --against exige um project id\"))\n   358\t\t\t\t\treturn 2\n   359\t\t\t\t}\n   360\t\t\t\ti++\n   361\t\t\t\tagainst = args[i]\n   362\t\t\tcase \"--from\":\n   363\t\t\t\tif i+1 >= len(args) {\n   364\t\t\t\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --from requires a timestamp\", \"Erro: --from exige um timestamp\"))\n   365\t\t\t\t\treturn 2\n   366\t\t\t\t}\n   367\t\t\t\ti++\n   368\t\t\t\tfromTS = args[i]\n   369\t\t\tcase \"--to\":\n   370\t\t\t\tif i+1 >= len(args) {\n   371\t\t\t\t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --to requires a timestamp\", \"Erro: --to exige um timestamp\"))\n   372\t\t\t\t\treturn 2\n   373\t\t\t\t}\n   374\t\t\t\ti++\n   375\t\t\t\ttoTS = args[i]\n   376\t\t\tdefault:\n   377\t\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: invalid argument: %s\\n\", \"Erro: argumento inválido: %s\\n\"), args[i])\n   378\t\t\t\treturn 2\n   379\t\t\t}\n   380\t\t}\n   381\t\tif against != \"\" {\n   382\t\t\treturn assessAgainst(root, against, asJSON, stdout, stderr, locale)\n   383\t\t}\n   384\t\tstore := pose.Store{Root: root}\n   385\t\thistory, err := pose.LoadCapabilityHistory(store.CapabilityHistoryPath())\n   386\t\tif err != nil {\n   387\t\t\tfmt.Fprintf(stderr, \"pose assess diff: %v\\n\", err)\n   388\t\t\treturn 1\n   389\t\t}\n   390\t\teffective := pose.EffectiveSnapshots(history)\n","exit_code":0,"status":"completed"}}
