In takes the\n // operation's files.\n func loadCapabilityPolicy(root string) capabilityPolicy {\n \treturn loadCapabilityPolicyIn(pose.NativeFiles(), root)\n }\n \n+// assessPersists reports whether an assess command may write its records:\n+// not with --no-persist, and never in the sealed checkout of a delegated\n+// review (spec pose-assess-leaves-sealed-checkouts-alone R1, R2).\n+func assessPersists(root string, args []string) (bool, string) {\n+\tfor _, a := range args {\n+\t\tif a == \"--no-persist\" {\n+\t\t\treturn false, \"not persisted (--no-persist)\"\n+\t\t}\n+\t}\n+\tif pose.IsSealedCheckout(root) {\n+\t\treturn false, \"not persisted: this is the sealed checkout of a delegated review\"\n+\t}\n+\treturn true, \"\"\n+}\n+\n func cmdAssess(root string, args []string, stdout, stderr io.Writer) int {\n \tlocale := cliLocaleValue()\n+\tif len(args) > 0 && pose.IsSealedCheckout(root) {\n+\t\tswitch args[0] {\n+\t\tcase \"init\", \"snapshot\", \"request\":\n+\t\t\trender(stdout, stderr).Failure(\"pose assess \" + args[0] + \": writes the capability assessment, which a sealed review checkout does not take\")\n+\t\t\treturn 1\n+\t\t}\n+\t}\n \tif len(args) > 0 {\n \t\tswitch args[0] {\n \t\tcase \"init\":\n \t\t\treturn assessInit(root, stdout, stderr, locale)\n \t\tcase \"snapshot\":\n \t\t\treturn assessSnapshot(root, stdout, stderr, locale)\n \t\tcase \"diff\":\n \t\t\treturn assessDiff(root, args[1:], stdout, stderr, locale)\n \t\tcase \"stale\":\n \t\t\treturn assessStale(root, args[1:], stdout, stderr, locale)\n \t\tcase \"request\":\n \t\t\treturn assessRequest(root, args[1:], stdout, stderr, locale)\n \t\tcase \"discover\":\n \t\t\treturn assessDiscover(root, args[1:], stdout, stderr, locale)\n \t\tcase \"integrate\":\n \t\t\treturn assessIntegrate(root, args[1:], stdout, stderr, locale)\n \t\tcase \"tech-debt\":\n \t\t\treturn assessTechDebt(root, args[1:], stdout, stderr, locale)\n \t\tcase \"design\":\n \t\t\treturn assessDesign(root, args[1:], stdout, stderr, locale)\n \t\tcase \"--json\":\n \t\t\treturn assessValidate(root, true, stdout, stderr, locale)\n \t\tdefault:\n \t\t\tfmt.Fprintln(stderr, cliText(locale,\n \t\t\t\t\"Usage: pose assess [init|snapshot|diff|stale|request|discover|integrate|tech-debt|design [options]|--json]\",\n \t\t\t\t\"Uso: pose assess [init|snapshot|diff|stale|request|discover|integrate|tech-debt|design [opções]|--json]\"))\n \t\t\treturn 2\n \t\t}\n \t}\n \treturn assessValidate(root, false, stdout, stderr, locale)\n }\n \n func assessInit(root string, stdout, stderr io.Writer, locale cliLocale) int {\n \tstore := pose.Store{Root: root}\n \tpath := store.CapabilityAssessmentPath()\n \tif _, err := os.Stat(path); err == nil {\n \t\tfmt.Fprintf(stderr, cliText(locale,\n \t\t\t\"Error: %s already exists; edit it instead of re-initializing\\n\",\n \t\t\t\"Erro: %s já existe; edite-o em vez de re-inicializar\\n\"), path)\n \t\treturn 1\n \t}\n \tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n \t\tfmt.Fprintf(stderr, \"pose assess init: %v\\n\", err)\n \t\treturn 1\n \t}\n \tcontent := capabilityTemplate(assessBaselineCommit(root))\n \tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n \t\tfmt.Fprintf(stderr, \"pose assess init: %v\\n\", err)\n \t\treturn 1\n \t}\n@@ -583,170 +605,178 @@ func unreadableComponentState(slug, path string, cause error) *pose.ComponentDis\n \t\tkind, detail = pose.LossParseError, \"the persisted state is not valid JSON\"\n \tcase errors.Is(cause, pose.ErrComponentStateUnsupported):\n \t\tkind, detail = pose.LossUnsupported, \"the persisted state has a schema_version this engine does not read\"\n \tcase errors.Is(cause, pose.ErrComponentStateInvalid):\n \t\tkind, detail = pose.LossInvalid, \"the persisted state names no component\"\n \tcase cause != nil:\n \t\tdetail = cause.Error()\n \t}\n \treturn &pose.ComponentDiscoveryState{ComponentSlug: slug, Path: slug, Status: \"unreadable\",\n \t\tCoverage: pose.SourceCoverage{Losses: []pose.SourceLoss{{Producer: \"component-state\", Artifact: filepath.ToSlash(path), Kind: kind, Detail: detail}}}}\n }\n \n func sortedComponentStates(bySlug map[string]*pose.ComponentDiscoveryState) []*pose.ComponentDiscoveryState {\n \tslugs := make([]string, 0, len(bySlug))\n \tfor slug := range bySlug {\n \t\tslugs = append(slugs, slug)\n \t}\n \tsort.Strings(slugs)\n \tmerged := make([]*pose.ComponentDiscoveryState, 0, len(slugs))\n \tfor _, slug := range slugs {\n \t\tmerged = append(merged, bySlug[slug])\n \t}\n \treturn merged\n }\n \n func assessDiscover(root string, args []string, stdout, stderr io.Writer, locale cliLocale) int {\n \tvar targetComp string\n \tvar asJSON bool\n \tvar updateState bool\n \t// --if-stale reuses a component's assessment while its committed\n \t// content, the engine and the matrix are unchanged (spec\n \t// pose-adaptive-assessment-freshness).\n \tvar ifStale bool\n \tdecisions := map[string]string{}\n \n \tfor i := 0; i < len(args); i++ {\n \t\tswitch args[i] {\n \t\tcase \"--component\":\n \t\t\tif i+1 < len(args) {\n \t\t\t\ttargetComp = args[i+1]\n \t\t\t\ti++\n \t\t\t}\n \t\tcase \"--json\":\n \t\t\tasJSON = true\n \t\tcase \"--update-state\":\n \t\t\tupdateState = true\n \t\tcase \"--if-stale\":\n \t\t\tifStale = true\n \t\t}\n \t}\n+\tpersist, persistNote := assessPersists(root, args)\n \n \tstore := pose.Store{Root: root}\n \tvar targets []string\n \n \tif targetComp != \"\" {\n \t\ttargets = []string{targetComp}\n \t} else {\n \t\t// Dynamically discover components via POSE module metadata or manifest inspection\n \t\ttargets = store.FindComponentDirectories()\n \t\tif len(targets) == 0 {\n \t\t\ttargets = []string{\".\"}\n \t\t}\n \t}\n \n \tvar results []*pose.ComponentDiscoveryState\n \tfor _, t := range targets {\n \t\tif ifStale {\n \t\t\tfresh := store.ComponentAssessmentFreshness(t)\n \t\t\tif fresh.State == pose.AssessmentFresh {\n \t\t\t\tif reused, err := store.LoadComponentState(fresh.Component); err == nil && reused != nil {\n \t\t\t\t\tdecisions[reused.ComponentSlug] = \"reused (content, engine and matrix unchanged)\"\n \t\t\t\t\tresults = append(results, reused)\n \t\t\t\t\tcontinue\n \t\t\t\t}\n \t\t\t}\n \t\t\tdecisions[fresh.Component] = \"refreshed (\" + fresh.State + \": \" + strings.Join(fresh.Reasons, \"; \") + \")\"\n \t\t}\n \t\tstate, err := store.DiscoverComponent(t)\n \t\tif err != nil {\n \t\t\tfmt.Fprintf(stderr, \"pose assess discover %s: %v\\n\", t, err)\n \t\t\treturn 1\n \t\t}\n-\t\tif err := store.SaveComponentState(state); err != nil {\n-\t\t\tfmt.Fprintf(stderr, \"pose assess discover save %s: %v\\n\", t, err)\n-\t\t\treturn 1\n+\t\tif persist {\n+\t\t\tif err := store.SaveComponentState(state); err != nil {\n+\t\t\t\tfmt.Fprintf(stderr, \"pose assess discover save %s: %v\\n\", t, err)\n+\t\t\t\treturn 1\n+\t\t\t}\n \t\t}\n \t\tresults = append(results, state)\n \t}\n \n \t// The consolidated view is repository-wide even when discovery is scoped to\n \t// one component. Rebuilding it from the scanned subset alone used to drop\n \t// every other component from README.md/consolidated.md while leaving its\n \t// per-component report and state file orphaned on disk.\n \tconsolidated := results\n \tif targetComp != \"\" {\n \t\tconsolidated = mergeWithPersistedComponentStates(store, results)\n \t}\n-\tif err := store.GenerateConsolidatedAssessment(consolidated); err != nil {\n-\t\tfmt.Fprintf(stderr, \"pose assess discover consolidate: %v\\n\", err)\n-\t\treturn 1\n+\tif persist {\n+\t\tif err := store.GenerateConsolidatedAssessment(consolidated); err != nil {\n+\t\t\tfmt.Fprintf(stderr, \"pose assess discover consolidate: %v\\n\", err)\n+\t\t\treturn 1\n+\t\t}\n \t}\n \n-\tif updateState {\n+\tif updateState && persist {\n \t\t// The state is built from what this run observed: a persisted record of a component\n \t\t// that is no longer there is not part of it. What was recorded and cannot be read is\n \t\t// carried as a loss, so the state does not read as a certified total.\n \t\tstateInput := append([]*pose.ComponentDiscoveryState{}, results...)\n \t\tif targetComp != \"\" {\n \t\t\tfor _, c := range consolidated {\n \t\t\t\tif c.Status == \"unreadable\" {\n \t\t\t\t\tstateInput = append(stateInput, c)\n \t\t\t\t}\n \t\t\t}\n \t\t}\n \t\tif err := updateProjectStateArchitecture(root, stateInput); err != nil {\n \t\t\tfmt.Fprintf(stderr, \"pose assess discover update-state: %v\\n\", err)\n \t\t\treturn 1\n \t\t}\n \t}\n \n+\tif !persist {\n+\t\trender(stdout, stderr).Hint(\"pose assess: \" + persistNote)\n+\t}\n \tif asJSON {\n \t\tenc, _ := json.MarshalIndent(results, \"\", \"  \")\n \t\tfmt.Fprintln(stdout, string(enc))\n \t\treturn 0\n \t}\n \n \tfmt.Fprintf(stdout, \"Discovered %d components:\\n\", len(results))\n \tfor _, res := range results {\n \t\tfmt.Fprintf(stdout, \"  - %-30s LOC: %d (prod) / %d (test) | Debt TODOs: %d, FIXMEs: %d\\n\",\n \t\t\tres.ComponentSlug, res.Metrics.LOCProduction, res.Metrics.LOCTests, res.TechnicalDebt.TODOs, res.TechnicalDebt.FIXMEs)\n \t\tif res.ScanIncomplete() {\n \t\t\trender(stdout, stderr).Field(\"assess.scan.\"+res.ComponentSlug, \"incomplete: \"+res.Coverage.Describe(\"\")+\"; the counts above are a floor\")\n \t\t}\n \t\tif decision, ok := decisions[res.ComponentSlug]; ok {\n \t\t\trender(stdout, stderr).Field(\"assess.freshness.\"+res.ComponentSlug, decision)\n \t\t}\n \t}\n \treturn 0\n }\n \n func updateProjectStateArchitecture(root string, current []*pose.ComponentDiscoveryState) error {\n \tstatePath := filepath.Join(root, \".pose\", \"state\", \"project-state.md\")\n \traw, err := os.ReadFile(statePath)\n \tif err != nil {\n \t\treturn err\n \t}\n \n \tcontent := string(raw)\n \tif !strings.Contains(content, \"## Arquitetura\") {\n \t\treturn fmt.Errorf(\"project-state.md has no Arquitetura section\")\n \t}\n \n \tvar totalProd, totalTests, verified int\n \tvar todos, fixmes, panics, stubs int\n \tvar completeness float64\n \tlanguages := make(map[string]bool)\n \tcomponents, partial, unreadable := 0, 0, 0\n \tif current == nil {\n \t\tentries, dirErr := os.ReadDir(filepath.Join(root, \".pose\", \"state\", \"components\"))\n \t\tif dirErr != nil && !os.IsNotExist(dirErr) {\n \t\t\tunreadable++\n \t\t}\n \t\tfor _, entry := range entries {\n \t\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") || entry.Name() == \"..json\" {\n \t\t\t\tcontinue\n \t\t\t}\n \t\t\t// The loader that validates a state is the one that reads it here too: a record\n \t\t\t// of a format this engine does not read, or that names no component, is not a\n \t\t\t// component with zero debt.\n \t\t\tstate, loadErr := (pose.Store{Root: root}).LoadComponentState(strings.TrimSuffix(entry.Name(), \".json\"))\n@@ -808,139 +838,153 @@ func updateProjectStateArchitecture(root string, current []*pose.ComponentDiscov\n \t\t}\n \t}\n \tif debtRaw, readErr := os.ReadFile(filepath.Join(root, \".pose\", \"state\", \"technical-debt.json\")); readErr == nil {\n \t\tvar report pose.TechDebtReportState\n \t\tif json.Unmarshal(debtRaw, &report) == nil {\n \t\t\tdebtLine := fmt.Sprintf(\"- divida_tecnica: total=%d coberta=%d descoberta=%d\", report.Summary.TotalMarkers, report.Summary.CoveredCount, report.Summary.UncoveredCount)\n \t\t\tif !report.Complete && len(report.Coverage.Losses) > 0 {\n \t\t\t\tdebtLine += \" (piso: relatório de dívida incompleto — \" + report.Coverage.Describe(\"\") + \"; não certificado)\"\n \t\t\t}\n \t\t\tlines = append(lines, debtLine)\n \t\t}\n \t}\n \tlines = append(lines, \"- ultimos_assessments: ver artefatos em .pose/assessments/ e .pose/state/\")\n \tbody := strings.Join(lines, \"\\n\")\n \tstatus := \"active\"\n \tif components == 0 {\n \t\tstatus = \"unavailable\"\n \t}\n \tsection := fmt.Sprintf(\"## Arquitetura\\n<!-- state:derived hash:%s status:%s -->\\n\\n%s\", pose.ContentHash12(body), status, body)\n \tarchRegex := regexp.MustCompile(`(?s)## Arquitetura\\n<!-- state:derived [^\\n]+ -->\\n.*?(\\n\\n## |\\z)`)\n \tif !archRegex.MatchString(content) {\n \t\treturn fmt.Errorf(\"project-state.md Arquitetura section is malformed\")\n \t}\n \tupdated := archRegex.ReplaceAllString(content, section+\"$1\")\n \t// Published over the state read above: a curated edit made while the\n \t// section was rendered is a conflict, never lost (spec\n \t// pose-writer-coordination-and-atomic-publication R2/R7).\n \treturn pose.PublishFile(statePath, []byte(updated), 0o644, pose.PublishAuthoritative, pose.ExpectBytes(raw, true))\n }\n \n func assessIntegrate(root string, args []string, stdout, stderr io.Writer, locale cliLocale) int {\n \tvar asJSON bool\n \tvar updateState bool\n \n \tfor _, a := range args {\n \t\tswitch a {\n \t\tcase \"--json\":\n \t\t\tasJSON = true\n \t\tcase \"--update-state\":\n \t\t\tupdateState = true\n \t\t}\n \t}\n \n \tstore := pose.Store{Root: root}\n \tmatrix, err := store.AnalyzeIntegrations()\n \tif err != nil {\n \t\tfmt.Fprintf(stderr, \"pose assess integrate: %v\\n\", err)\n \t\treturn 1\n \t}\n \n-\tif err := store.SaveIntegrationMatrix(matrix); err != nil {\n-\t\tfmt.Fprintf(stderr, \"pose assess integrate save: %v\\n\", err)\n-\t\treturn 1\n+\tpersist, persistNote := assessPersists(root, args)\n+\tif persist {\n+\t\tif err := store.SaveIntegrationMatrix(matrix); err != nil {\n+\t\t\tfmt.Fprintf(stderr, \"pose assess integrate save: %v\\n\", err)\n+\t\t\treturn 1\n+\t\t}\n+\t} else {\n+\t\trender(stdout, stderr).Hint(\"pose assess: \" + persistNote)\n \t}\n \n-\tif updateState {\n+\tif updateState && persist {\n \t\tif err := updateProjectStateArchitecture(root, nil); err != nil {\n \t\t\tfmt.Fprintf(stderr, \"pose assess integrate update-state: %v\\n\", err)\n \t\t\treturn 1\n \t\t}\n \t}\n \n \tif asJSON {\n \t\tenc, _ := json.MarshalIndent(matrix, \"\", \"  \")\n \t\tfmt.Fprintln(stdout, string(enc))\n \t\treturn 0\n \t}\n \n \tfmt.Fprintf(stdout, \"Integration Assessment Results:\\n\")\n \tfmt.Fprintf(stdout, \"  - Contracts Evaluated: %d\\n\", matrix.Summary.TotalIntegrations)\n \tfmt.Fprintf(stdout, \"  - Active Contracts: %d\\n\", matrix.Summary.ActiveContracts)\n \tfmt.Fprintf(stdout, \"  - Integration Gaps Identified: %d\\n\\n\", matrix.Summary.IdentifiedGaps)\n \n \tfor _, g := range matrix.Gaps {\n \t\tfmt.Fprintf(stdout, \"  ⚠️ [%s] %s (%s)\\n     Provider: %s | Consumer: %s\\n     %s\\n\\n\",\n \t\t\tg.GapID, g.Title, g.Severity, g.Provider, g.Consumer, g.Description)\n \t}\n \n-\tfmt.Fprintf(stdout, \"Artifacts written to .pose/assessments/integrations.md and .pose/state/integrations.json\\n\")\n+\tif persist {\n+\t\tfmt.Fprintf(stdout, \"Artifacts written to .pose/assessments/integrations.md and .pose/state/integrations.json\\n\")\n+\t}\n \treturn 0\n }\n \n func assessTechDebt(root string, args []string, stdout, stderr io.Writer, locale cliLocale) int {\n \tvar asJSON bool\n \tvar updateState bool\n \n \tfor _, a := range args {\n \t\tswitch a {\n \t\tcase \"--json\":\n \t\t\tasJSON = true\n \t\tcase \"--update-state\":\n \t\t\tupdateState = true\n \t\t}\n \t}\n \n \tstore := pose.Store{Root: root}\n \treport, err := store.AnalyzeTechDebt()\n \tif err != nil {\n \t\tfmt.Fprintf(stderr, \"pose assess tech-debt: %v\\n\", err)\n \t\treturn 1\n \t}\n \n-\tif err := store.SaveTechDebtReport(report); err != nil {\n-\t\tfmt.Fprintf(stderr, \"pose assess tech-debt save: %v\\n\", err)\n-\t\treturn 1\n+\tpersist, persistNote := assessPersists(root, args)\n+\tif persist {\n+\t\tif err := store.SaveTechDebtReport(report); err != nil {\n+\t\t\tfmt.Fprintf(stderr, \"pose assess tech-debt save: %v\\n\", err)\n+\t\t\treturn 1\n+\t\t}\n+\t} else {\n+\t\trender(stdout, stderr).Hint(\"pose assess: \" + persistNote)\n \t}\n \n-\tif updateState {\n+\tif updateState && persist {\n \t\tif err := updateProjectStateArchitecture(root, nil); err != nil {\n \t\t\tfmt.Fprintf(stderr, \"pose assess tech-debt update-state: %v\\n\", err)\n \t\t\treturn 1\n \t\t}\n \t}\n \n \tif asJSON {\n \t\tenc, _ := json.MarshalIndent(report, \"\", \"  \")\n \t\tfmt.Fprintln(stdout, string(enc))\n \t\treturn 0\n \t}\n \n \tfmt.Fprintf(stdout, \"Technical Debt Assessment Results:\\n\")\n \tfmt.Fprintf(stdout, \"  - Total Debt Markers: %d (TODOs: %d, FIXMEs: %d, Panics: %d, Stubs: %d)\\n\",\n \t\treport.Summary.TotalMarkers, report.Summary.TODOs, report.Summary.FIXMEs, report.Summary.Panics, report.Summary.Stubs)\n \tfmt.Fprintf(stdout, \"  - Uncovered Debt Items: %d\\n\", report.Summary.UncoveredCount)\n \tfmt.Fprintf(stdout, \"  - Recommendations: %d Follow-ups, %d Specs, %d Roadmaps\\n\\n\",\n \t\treport.Summary.RecommendedFollowups, report.Summary.RecommendedSpecs, report.Summary.RecommendedRoadmaps)\n \n \tscope := render(stdout, stderr)\n \tif report.Complete {\n \t\tscope.Field(\"techdebt.scan\", fmt.Sprintf(\"%d source file(s) scanned, none unreadable\", report.ScannedFiles))\n \t} else {\n \t\tscope.Field(\"techdebt.scan\", fmt.Sprintf(\"INCOMPLETE — %d source file(s) scanned; %s; zero markers does not prove the unread files have none\", report.ScannedFiles, report.Coverage.Describe(\"\")))\n \t}\n \tfor _, exclusion := range report.Coverage.Exclusions {\n \t\tscope.Field(\"techdebt.excluded\", fmt.Sprintf(\"%s: %d file(s) — %s\", exclusion.Pattern, exclusion.Count, exclusion.Reason))\n \t}\n-\tfmt.Fprintf(stdout, \"Artifacts written to .pose/assessments/technical-debt.md and .pose/state/technical-debt.json\\n\")\n+\tif persist {\n+\t\tfmt.Fprintf(stdout, \"Artifacts written to .pose/assessments/technical-debt.md and .pose/state/technical-debt.json\\n\")\n+\t}\n \treturn 0\n }\ndiff --git a/pose-mcp/internal/cli/assess_sealed_test.go b/pose-mcp/internal/cli/assess_sealed_test.go\nnew file mode 100644\nindex 00000000..2d789a29\n--- /dev/null\n+++ b/pose-mcp/internal/cli/assess_sealed_test.go\n@@ -0,0 +1,107 @@\n+package cli\n+\n+import (\n+\t\"crypto/sha256\"\n+\t\"encoding/hex\"\n+\t\"io/fs\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"sort\"\n+\t\"strings\"\n+\t\"testing\"\n+\n+\t\"github.com/harne8/pose-mcp/internal/pose\"\n+)\n+\n+// treeDigest names every file under root with its content, so any write,\n+// creation or removal changes it.\n+func treeDigest(t *testing.T, root string) string {\n+\tt.Helper()\n+\tvar lines []string\n+\terr := filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {\n+\t\tif err != nil || d.IsDir() {\n+\t\t\treturn err\n+\t\t}\n+\t\traw, err := os.ReadFile(path)\n+\t\tif err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t\tsum := sha256.Sum256(raw)\n+\t\trel, _ := filepath.Rel(root, path)\n+\t\tlines = append(lines, rel+\" \"+hex.EncodeToString(sum[:]))\n+\t\treturn nil\n+\t})\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tsort.Strings(lines)\n+\treturn strings.Join(lines, \"\\n\")\n+}\n+\n+func assessSealedRoot(t *testing.T) string {\n+\tt.Helper()\n+\troot := assessTestRoot(t)\n+\twriteCloseoutCLIFile(t, root, \"svc/main.go\", \"package main\\n\\n// TODO: a marker\\nfunc main() {}\\n\")\n+\twriteCloseoutCLIFile(t, root, \"svc/go.mod\", \"module example.com/svc\\n\\ngo 1.22\\n\")\n+\twriteCloseoutCLIFile(t, root, \".pose/state/project-state.md\", \"# Project state\\n\")\n+\treturn root\n+}\n+\n+// Spec pose-assess-leaves-sealed-checkouts-alone R2, R4: inside the sealed\n+// checkout of a delegated review every assessment command leaves the tree\n+// as it was, and the ones that only write refuse.\n+func TestAssessLeavesTheSealedCheckoutUnchanged(t *testing.T) {\n+\troot := assessSealedRoot(t)\n+\tt.Setenv(pose.SealedCheckoutEnv, root)\n+\tbefore := treeDigest(t, root)\n+\tfor _, args := range [][]string{\n+\t\t{\"discover\"}, {\"discover\", \"--update-state\"}, {\"discover\", \"--component\", \"svc\", \"--if-stale\"},\n+\t\t{\"integrate\"}, {\"integrate\", \"--update-state\", \"--json\"},\n+\t\t{\"tech-debt\"}, {\"tech-debt\", \"--update-state\"},\n+\t} {\n+\t\tcode, out, errOut := runAssess(t, root, args...)\n+\t\tif code != 0 || !strings.Contains(errOut, \"sealed checkout of a delegated review\") {\n+\t\t\tt.Fatalf(\"assess %v: %d %s %s\", args, code, out, errOut)\n+\t\t}\n+\t\tif strings.Contains(out, \"Artifacts written\") {\n+\t\t\tt.Fatalf(\"assess %v claims it wrote: %s\", args, out)\n+\t\t}\n+\t\tif after := treeDigest(t, root); after != before {\n+\t\t\tt.Fatalf(\"assess %v changed the sealed checkout:\\n%s\\n---\\n%s\", args, before, after)\n+\t\t}\n+\t}\n+\tfor _, sub := range []string{\"init\", \"snapshot\", \"request\"} {\n+\t\tif code, _, errOut := runAssess(t, root, sub); code == 0 || !strings.Contains(errOut, \"sealed review checkout\") {\n+\t\t\tt.Fatalf(\"assess %s ran in the sealed checkout: %d %s\", sub, code, errOut)\n+\t\t}\n+\t}\n+\tif after := treeDigest(t, root); after != before {\n+\t\tt.Fatal(\"a refused assess command changed the sealed checkout\")\n+\t}\n+\t// The writers refuse on their own, for any other caller.\n+\tif err := (pose.Store{Root: root}).SaveTechDebtReport(&pose.TechDebtReportState{}); err != pose.ErrSealedAssessmentWrite {\n+\t\tt.Fatalf(\"the tech-debt writer wrote into the sealed checkout: %v\", err)\n+\t}\n+}\n+\n+// R1: --no-persist prints the result and writes nothing anywhere; without it\n+// and outside a sealed checkout the records are written as before.\n+func TestAssessNoPersistWritesNothing(t *testing.T) {\n+\troot := assessSealedRoot(t)\n+\tbefore := treeDigest(t, root)\n+\tfor _, sub := range []string{\"discover\", \"integrate\", \"tech-debt\"} {\n+\t\tcode, out, errOut := runAssess(t, root, sub, \"--no-persist\", \"--update-state\")\n+\t\tif code != 0 || !strings.Contains(errOut, \"--no-persist\") || out == \"\" {\n+\t\t\tt.Fatalf(\"assess %s --no-persist: %d %s %s\", sub, code, out, errOut)\n+\t\t}\n+\t\tif after := treeDigest(t, root); after != before {\n+\t\t\tt.Fatalf(\"assess %s --no-persist wrote\", sub)\n+\t\t}\n+\t}\n+\tif code, _, errOut := runAssess(t, root, \"tech-debt\"); code != 0 {\n+\t\tt.Fatal(errOut)\n+\t}\n+\tif _, err := os.Stat(filepath.Join(root, \".pose/state/technical-debt.json\")); err != nil {\n+\t\tt.Fatalf(\"a persisting run outside a sealed checkout wrote nothing: %v\", err)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/help_catalog.go b/pose-mcp/internal/cli/help_catalog.go\nindex c6381d05..a172efe8 100644\n--- a/pose-mcp/internal/cli/help_catalog.go\n+++ b/pose-mcp/internal/cli/help_catalog.go\n@@ -336,100 +336,101 @@ var commandHelpCatalog = map[string]CommandHelp{\n \t\t\t{\"--to <agent|auto>\", \"handoff: the agent that continues the stopped run; auto routes, the stopped agent excluded\", \"handoff: o agente que continua o run parado; auto roteia, excluindo o agente parado\"},\n \t\t\t{\"--detach\", \"Start the run in a session of its own and return its attempt at once (review, adjudicate, smoke, task, resume, handoff)\", \"Inicia o run numa sessão própria e devolve a tentativa na hora (review, adjudicate, smoke, task, resume, handoff)\"},\n \t\t\t{\"--cd <dir>\", \"task: the directory the agent runs in (default: the current one)\", \"task: o diretório onde o agente roda (padrão: o atual)\"},\n \t\t\t{\"--add-dir <dir>\", \"task: another directory the agent may reach, through the agent's add_dir_args (repeatable)\", \"task: outro diretório que o agente pode alcançar, via add_dir_args do agente (repetível)\"},\n \t\t\t{\"--effort <level>\", \"task: an effort level the agent declares\", \"task: um nível de esforço que o agente declara\"},\n \t\t\t{\"--no-network\", \"task: run without network through the agent's no_network_args; refused with write and full\", \"task: roda sem rede via no_network_args do agente; recusado com write e full\"},\n \t\t\t{\"--record\", \"task: keep the record under .pose instead of the user's state directory\", \"task: guarda o registro em .pose em vez do diretório de estado do usuário\"},\n \t\t\t{\"--session <id>\", \"task: continue a session POSE never recorded, opened by the agent --agent names, with its resume command (the prompt is optional: without it the default continuation message is sent)\", \"task: continua uma sessão que o POSE nunca registrou, aberta pelo agente que --agent nomeia, com o comando de resume dele (o prompt é opcional: sem ele vai a mensagem padrão de continuação)\"},\n \t\t\t{\"--prompt <file|->\", \"resume of a task: the message to continue with instead of the default one\", \"resume de uma task: a mensagem para continuar no lugar da padrão\"},\n \t\t\t{\"--timeout <d>\", \"How long wait blocks before it exits 50\", \"Quanto tempo o wait bloqueia antes de sair com 50\"},\n \t\t\t{\"-v\", \"watch: add the tail of each tool's output\", \"watch: acrescenta o fim da saída de cada ferramenta\"},\n \t\t\t{\"--lines <n>\", \"watch: lines of tool output with -v (default 12)\", \"watch: linhas da saída de ferramenta com -v (padrão 12)\"},\n \t\t\t{\"--no-follow\", \"watch: print what exists and exit\", \"watch: imprime o que existe e sai\"},\n \t\t\t{\"--refresh <d>\", \"watch picker: preview refresh interval (default 2s, 0 turns it off)\", \"seletor do watch: intervalo de atualização do preview (padrão 2s, 0 desliga)\"},\n \t\t\t{\"--wait-until-reset[=<max>]\", \"resume: wait for the recorded usage-limit reset first (at most 24h)\", \"resume: espera antes o reset do limite de uso registrado (no máximo 24h)\"},\n \t\t\t{\"--active\", \"ls: only runs in progress\", \"ls: só runs em andamento\"},\n \t\t\t{\"--dry-run\", \"Print what would happen; change nothing\", \"Mostra o que aconteceria; não altera nada\"},\n \t\t\t{\"--json\", \"One versioned JSON document\", \"Um documento JSON versionado\"},\n \t\t},\n \t\tSubcommands: []SubcommandHelp{\n \t\t\t{\"review\", \"pose delegate review <scope|bundle-id> [--agent auto|<name>] [--label <name>] [--lead <vendor>[/<model>]] [--reason <text>] [--note-file <path>] [--detach] [--dry-run] [--json]\", \"Run a delegated review of a sealed bundle and record the run\", \"Roda um review delegado de um bundle selado e registra o run\"},\n \t\t\t{\"adjudicate\", \"pose delegate adjudicate <scope|bundle-id> [--agent auto|<name>] [--label <name>] [--dry-run] [--json]\", \"Run a delegated adjudication of a sealed bundle\", \"Roda uma adjudicação delegada de um bundle selado\"},\n \t\t\t{\"smoke\", \"pose delegate smoke <scope|bundle-id> [--agent auto|<name>] [--label <name>] [--dry-run] [--json]\", \"Run a delegated smoke run of a sealed bundle\", \"Roda um smoke run delegado de um bundle selado\"},\n \t\t\t{\"task\", \"pose delegate task <prompt-file|-> [--agent auto|<name>] [--access read|sandboxed|write|full] [--cd <dir>] [--add-dir <dir>]... [--no-network] [--effort <level>] [--record] [--session <id>] [--label <name>] [--lead <vendor>[/<model>]] [--detach] [--dry-run] [--json]\", \"Hand a general task to another agent in a real directory; its final message goes to stdout and its exit code is returned, or --detach returns its attempt at once; never evidence\", \"Entrega uma tarefa geral a outro agente num diretório real; a mensagem final vai para o stdout e o código de saída é devolvido, ou --detach devolve a tentativa na hora; nunca é evidência\"},\n \t\t\t{\"ls\", \"pose delegate ls [<run>|<bundle-id>] [--active] [--agent <name>] [--label <name>] [--lead <vendor>[/<model>]] [--json]\", \"List attempts by their latest run, with state, purpose, agent, label, turns, age, last step and, when interrupted, cause, partial draft, reset and time left\", \"Lista tentativas pelo run mais recente, com estado, propósito, agente, label, turnos, idade, último passo e, se interrompido, causa, draft parcial, reset e tempo restante\"},\n \t\t\t{\"watch\", \"pose delegate watch [<run>|<label>] [-v] [--lines <n>] [--no-follow] [--refresh <d>] [--json]\", \"Follow a run live until it ends, replaying the runs its attempt recorded; with no run, the only running one or a picker\", \"Acompanha um run ao vivo até terminar, reproduzindo os runs que a tentativa registrou; sem run, o único em andamento ou um seletor\"},\n \t\t\t{\"wait\", \"pose delegate wait <run> [--timeout <d>] [--json]\", \"Block until a run ends; exit 0 approved, 10 changes requested or rejected, 20 failed, 30 interrupted, 40 stalled, 50 timed out\", \"Bloqueia até um run terminar; sai com 0 aprovado, 10 mudanças pedidas ou rejeitado, 20 falhou, 30 interrompido, 40 travado, 50 tempo esgotado\"},\n \t\t\t{\"resume\", \"pose delegate resume <run> [--wait-until-reset[=<max>]] [--prompt <file|->] [--detach] [--dry-run] [--json]\", \"Continue an interrupted run with the same agent and session, under its original attempt; repeating it returns the recorded continuation\", \"Retoma um run interrompido com o mesmo agente e sessão, sob a tentativa original; repetir devolve a continuação registrada\"},\n \t\t\t{\"handoff\", \"pose delegate handoff <run> --to <agent|auto> [--detach] [--dry-run] [--json]\", \"Continue a stopped run with another agent under the same attempt and budget, its brief carrying the stopped run's quoted partial and commands\", \"Continua um run parado com outro agente na mesma tentativa e orçamento, com o brief levando o parcial citado e os comandos do run parado\"},\n \t\t\t{\"cancel\", \"pose delegate cancel <run> [--dry-run] [--json]\", \"Stop a running run; it is recorded failed with the cause cancelled and its attempt stays consumed\", \"Para um run em andamento; ele é registrado como failed com a causa cancelled e a tentativa continua consumida\"},\n \t\t\t{\"agents\", \"pose delegate agents [--agent <name>] [--access <level>] [--label <name>] [--lead <vendor>[/<model>]] [--json]\", \"List configured agents with vendor, model, whether their CLI is on the path, their last usage-limit reset and their state: available, limited until <instant>, missing or probe-failed\", \"Lista os agentes configurados com vendor, modelo, se a CLI está no path, o último reset de limite de uso e o estado: available, limited until <instante>, missing ou probe-failed\"},\n \t\t},\n \t\tExamples: []string{\n \t\t\t\"pose delegate review spec:my-feature --label my-feature-r1\",\n \t\t\t\"pose delegate ls --active\",\n \t\t\t\"pose delegate resume my-feature-r1 --wait-until-reset\",\n \t\t\t\"pose delegate agents --json\",\n \t\t},\n \t},\n \t\"review\": {\n \t\tName:            \"review\",\n \t\tSummaryEN:       \"Governed review planning, bundle sealing, and attestation workflow\",\n \t\tSummaryPtBR:     \"Fluxo governado de planejamento de review, selagem de bundle e atestação\",\n \t\tUsage:           \"pose review <bundle|auto-attest|attest|verify|record|attribution-supplement> <scope|xref> [options]\",\n \t\tDescriptionEN:   \"Manages component-aware reviews and immutable bundles. Cross-project scope writes require an explicit project binding and a fresh --expect-context digest.\",\n \t\tDescriptionPtBR: \"Gerencia reviews por componentes e bundles imutáveis. Escritas entre projetos exigem vínculo explícito e digest --expect-context atual.\",\n \t\tSubcommands: []SubcommandHelp{\n \t\t\t{\"bundle\", \"pose review bundle <scope|xref> [--seal] [--explain] [--expect-context <digest>]\", \"Prepare or seal an immutable review subject bundle\", \"Prepara ou sela o bundle imutável de revisão\"},\n \t\t\t{\"brief\", \"pose review brief <bundle-id|scope> [--kind review|adjudication|smoke] [--note-file <path>] [--json]\", \"Render the request a delegated reviewer receives, from the sealed bundle and, from round 2, the previous round's open findings\", \"Gera o pedido que um revisor delegado recebe, a partir do bundle selado e, da rodada 2 em diante, dos findings abertos da rodada anterior\"},\n \t\t\t{\"run-sign\", \"pose review run-sign <run-id> --issuer <name> [--ttl <duration>] [--apply] [--json]\", \"Sign captured run provenance with a pinned native issuer\", \"Assina a proveniência capturada com issuer nativo fixado\"},\n+\t\t\t{\"draft-check\", \"pose review draft-check [<bundle-id|run-id>] --draft <file> [--json]\", \"Report every reason the conclusion step would refuse a review draft, without writing; inside a delegated review the bundle and round come from the run\", \"Relata todo motivo pelo qual a conclusão recusaria um rascunho de review, sem gravar; dentro de uma review delegada o bundle e a rodada vêm do run\"},\n \t\t\t{\"conclude\", \"pose review conclude <run> [--issuer <name>] [--apply] [--json]\", \"Record the typed conclusion of a completed delegated run: a review as its signed attestation, an adjudication on the spec, a smoke run as smoke evidence; or why it records none\", \"Registra a conclusão tipada de um run delegado concluído: uma review como atestação assinada, uma adjudicação na spec, um smoke como evidência smoke; ou por que não registra nenhuma\"},\n \t\t\t{\"request\", \"pose review request <scope|bundle-id> --kind delegated-review [--purpose review|adjudicate|smoke] [--agents <name,...>] [--note-file <path>] [--supersedes <act-id> [--authority <json>] [--role <role>] [--requested-at <time>]] [--apply] [--json]\", \"Open a delegated-review action request that a local run, a CI job or the Conductor fulfils\", \"Abre uma action request de review delegada que um run local, um job de CI ou o Conductor cumpre\"},\n \t\t\t{\"run-proof\", \"pose review run-proof <run-id> <proof-id> [--json]\", \"Verify current run proof and disclose executor assurance\", \"Verifica a prova atual e divulga assurance do executor\"},\n \t\t\t{\"auto-attest\", \"pose review auto-attest <scope|bundle-id> [--apply]\", \"Extract validation results and automatically record attestation\", \"Extrai resultados de validação e registra atestação automaticamente\"},\n \t\t\t{\"attest\", \"pose review attest <bundle-id|scope|xref> --reviewer <id> --decision <decision> --evidence <ref> [--criterion ID|disposition|evidence|rationale] [--mapping CRITERION|DELTA|basis-or-disposition|rationale] [--prepared-by <p>] [--concluded-by <p>] [--confirmed-by <p> --confirmation-mode adopted-conclusions|authorized-operation] [--applied-by <p>] [--apply] [--expect-context <digest>]\", \"Record a manual review decision attestation; attribution roles are explicit, never derived from --reviewer, and a confirmation is bound to the exact content written; cross-project writes may target a qualified xref scope only with a fresh context digest\", \"Registra uma atestação manual; os papéis de atribuição são explícitos, nunca derivados de --reviewer, e uma confirmação fica vinculada ao conteúdo exato gravado; escritas externas podem usar escopo xref qualificado somente com digest de contexto atual\"},\n \t\t\t{\"attribution-supplement\", \"pose review attribution-supplement <attestation-id> --recorded-by <p> --note <text> [--prepared-by <p>] [--concluded-by <p>] [--applied-by <p>] [--evidence <ref>] [--apply]\", \"Clarify who prepared, concluded and applied an existing attestation without altering it; a supplement cannot add a confirmation\", \"Esclarece quem preparou, concluiu e aplicou uma atestação existente sem alterá-la; um suplemento não pode acrescentar confirmação\"},\n \t\t\t{\"verify\", \"pose review verify <scope|bundle-id>\", \"Verify freshness and closeout readiness of review bundles\", \"Verifica atualidade e prontidão do review bundle para fechamento\"},\n \t\t\t{\"record\", \"pose review record <scope|xref> ... [--expect-context <digest>]\", \"Compatibility entrypoint for review recording\", \"Ponto de entrada de compatibilidade para registro de review\"},\n \t\t},\n \t\tExamples: []string{\n \t\t\t\"pose review bundle spec:my-feature --seal\",\n \t\t\t\"pose review auto-attest spec:my-feature --apply\",\n \t\t\t\"pose review verify spec:my-feature\",\n \t\t},\n \t},\n \t\"action\": {\n \t\tName:            \"action\",\n \t\tSummaryEN:       \"Open, read and resolve material requests to a person or an external system\",\n \t\tSummaryPtBR:     \"Abre, lê e resolve solicitações materiais a uma pessoa ou a um sistema externo\",\n \t\tUsage:           \"pose action <open|list|show|statement|resolve|cancel|waive|invalidate> ... | pose action list --present [--actor <id|role>] [--json]\",\n \t\tDescriptionEN:   \"An action request records a decision, approval, input, external operation or acceptance that no other source holds, with its question, options and consequences, recipient, qualified targets and per-phase effects. Open one only when a different answer would materially change execution, scope, authority, risk acceptance, closeout or publication, and no authorization already given covers it. Writes are previews until --apply. A resolution names the request digest it answers and the revision it read, carries an idempotency key, and is accepted only from an actor holding the recipient role in .pose/policy/actions.json; under verified assurance it also needs a signature by a key registered to the actor (pose identity add; resolve --sign or --signature) or a trusted issuer's claim. Answered is not satisfied: a declined approval, a rejected acceptance or a failed operation leaves the request's condition unmet.\",\n \t\tDescriptionPtBR: \"Uma action request registra uma decisão, aprovação, informação, operação externa ou aceite que nenhuma outra fonte guarda, com a pergunta, as opções e consequências, o destinatário, os alvos qualificados e os efeitos por fase. Abra uma somente quando uma resposta diferente mudaria materialmente execução, escopo, autoridade, aceitação de risco, closeout ou publicação, e nenhuma autorização já dada a cobre. Escritas são preview até --apply. Uma resolução nomeia o digest da solicitação que responde e a revisão que leu, traz uma chave de idempotência e só é aceita de um ator que detém o papel destinatário em .pose/policy/actions.json; com garantia verificada também exige a assinatura de uma chave registrada para o ator (pose identity add; resolve --sign ou --signature) ou a claim de um emissor confiável. Respondida não é satisfeita: uma aprovação recusada, um aceite rejeitado ou uma operação falha deixam a condição sem atendimento.\",\n \t\tSubcommands: []SubcommandHelp{\n \t\t\t{\"open\", \"pose action open --origin <ref> --kind <kind> --question <text> --requested-by <p> --target <ref>... --effect <phase>:<mode>... [--option id=consequence]... [--recipient <p>|--recipient-role <r>] [--subject <ref|path:file>] [--supersedes <id>] [--apply]\", \"Preview or record a material request\", \"Visualiza ou registra uma solicitação material\"},\n \t\t\t{\"list\", \"pose action list [--state <state>] [--json]\", \"List requests with their derived state\", \"Lista solicitações com o estado derivado\"},\n \t\t\t{\"show\", \"pose action show <act-id> [--json]\", \"Show exactly the content an answer is bound to\", \"Mostra exatamente o conteúdo ao qual uma resposta fica vinculada\"},\n \t\t\t{\"statement\", \"pose action statement <act-id> --actor <p> --answer <a> --idempotency-key <k>\", \"Print the exact bytes an answer signature covers\", \"Imprime os bytes exatos que a assinatura de uma resposta cobre\"},\n \t\t\t{\"resolve\", \"pose action resolve <act-id> --actor <p> --answer <a> --request-digest <d> --expected-revision <n> --idempotency-key <k> [--sign <ssh key> | --signature <file> | --claim <file>] [--apply]\", \"Record an answer from an authorized actor\", \"Registra a resposta de um ator autorizado\"},\n \t\t\t{\"fulfil\", \"pose action fulfil <act-id> --run <run-id> --runner agent:<id> --idempotency-key <k> --expected-revision <n> [--channel cli|ci|conductor] [--envelope <file>] [--apply]\", \"Fulfil a delegated-review request with a concluded run the engine verifies\", \"Cumpre uma request de review delegada com um run concluído que o motor verifica\"},\n \t\t\t{\"cancel\", \"pose action cancel <act-id> --actor <p> --reason <text> --request-digest <d> --expected-revision <n> --idempotency-key <k> [--apply]\", \"Withdraw a request (requester or authority)\", \"Retira uma solicitação (solicitante ou autoridade)\"},\n \t\t\t{\"waive\", \"pose action waive <act-id> --actor <p> --reason <text> --request-digest <d> --expected-revision <n> --idempotency-key <k> [--apply]\", \"Dispense with the condition (authority only)\", \"Dispensa a condição (somente a autoridade)\"},\n \t\t\t{\"invalidate\", \"pose action invalidate <act-id> --actor <p> --reason <text> --request-digest <d> --expected-revision <n> --idempotency-key <k> [--apply]\", \"Mark an answer as no longer applying\", \"Marca uma resposta como não aplicável\"},\n \t\t},\n \t\tExamples: []string{\n \t\t\t\"pose action open --origin spec:storage --kind decision --question \\\"Keep reading schema v1?\\\" --option preserve-v1=\\\"Keep the v1 reader\\\" --option break-v1=\\\"Consumers migrate\\\" --recipient-role maintainer --requested-by agent:impl --target requirement:R4 --effect execution:block --effect closeout:block --apply\",\n \t\t\t\"pose action resolve act-0123456789abcdef --actor human:maintainer --answer preserve-v1 --request-digest sha256:... --expected-revision 1 --idempotency-key answer-1 --apply\",\n \t\t},\n \t},\n \t\"setup\": {\n \t\tName:            \"setup\",\n \t\tSummaryEN:       \"See what is in force, what is new and what is missing, and set it up step by step\",\n \t\tSummaryPtBR:     \"Mostra o que está em vigor, o que é novo e o que falta, e configura passo a passo\",\n \t\tUsage:           \"pose setup [--json] [--no-input]\",\n \t\tDescriptionEN:   \"One map of the instance's configuration: project identity, principals and keys (with the principal your git identity suggests — a name, not a proof), the pre-commit gate, capabilities in force, capabilities new since the last configuration review (reviewed_version in .pose/policy/adoption-decisions.json), what needs setup, and one next step with its command. At a terminal it offers each open step — installing the hook, registering your key with the maintainer role, deciding each new capability (adopt, decline or defer with a reason) — and performs it only after an explicit yes. Without a terminal, with --no-input or --json, it changes nothing and prints the commands, so an agent can ask the person.\",\n \t\tDescriptionPtBR: \"Um mapa da configuração da instância: identidade do projeto, principals e chaves (com o principal que sua identidade git sugere — um nome, não uma prova), o gate de pre-commit, capacidades em vigor, capacidades novas desde a última revisão de configuração (reviewed_version em .pose/policy/adoption-decisions.json), o que precisa de setup e um próximo passo com seu comando. Num terminal, oferece cada passo aberto — instalar o hook, registrar sua chave com o papel maintainer, decidir cada capacidade nova (adotar, recusar ou adiar com motivo) — e só o executa depois de um sim explícito. Sem terminal, com --no-input ou --json, não muda nada e imprime os comandos, para que um agente pergunte à pessoa.\",\n \t\tFlags: []FlagHelp{\n \t\t\t{\"--json\", \"Print the plan as JSON and change nothing\", \"Mostra o plano em JSON e não muda nada\"},\n \t\t\t{\"--no-input\", \"Report only, even at a terminal\", \"Só relata, mesmo num terminal\"},\n \t\t},\n \t\tExamples: []string{\n@@ -672,103 +673,103 @@ var commandHelpCatalog = map[string]CommandHelp{\n \t\t\t{\"--no-self\", \"Skip the binary self-update and migrate the instance with the running binary\", \"Pula a autoatualização do binário e migra a instância com o binário em execução\"},\n \t\t\t{\"--locale <tag>\", \"Locale for managed manuals and machinery (default: the instance's own)\", \"Locale dos manuais gerenciados e da maquinaria (padrão: o da própria instância)\"},\n \t\t},\n \t\tExamples: []string{\n \t\t\t\"pose update\",\n \t\t\t\"pose update --dry-run\",\n \t\t},\n \t},\n \t\"hooks\": {\n \t\tName:            \"hooks\",\n \t\tSummaryEN:       \"Manage POSE Git hooks (pre-commit gate, post-merge indexer)\",\n \t\tSummaryPtBR:     \"Gerencia git hooks do POSE (pre-commit gate, post-merge indexer)\",\n \t\tUsage:           \"pose hooks <install|uninstall|status>\",\n \t\tDescriptionEN:   \"Installs or removes deterministic git hooks under .git/hooks/ for automatic pre-commit structural validation and post-merge index recomputation.\",\n \t\tDescriptionPtBR: \"Instala ou remove hooks git determinísticos sob .git/hooks/ para validação estrutural automática no pre-commit e reindexação no post-merge.\",\n \t\tSubcommands: []SubcommandHelp{\n \t\t\t{\"install\", \"pose hooks install\", \"Install POSE pre-commit and post-merge git hooks\", \"Instala os git hooks de pre-commit e post-merge do POSE\"},\n \t\t\t{\"uninstall\", \"pose hooks uninstall\", \"Remove installed POSE git hooks\", \"Remove os git hooks instalados do POSE\"},\n \t\t\t{\"status\", \"pose hooks status\", \"Display the current installation status of git hooks\", \"Exibe o status atual de instalação dos git hooks\"},\n \t\t},\n \t\tExamples: []string{\n \t\t\t\"pose hooks install\",\n \t\t\t\"pose hooks status\",\n \t\t},\n \t},\n \t\"suggest\": {\n \t\tName:            \"suggest\",\n \t\tSummaryEN:       \"Suggest relevant skills, workflows, and rules for a task\",\n \t\tSummaryPtBR:     \"Sugere skills, workflows e regras relevantes para uma tarefa\",\n \t\tUsage:           \"pose suggest [<task-type>] [--domain <d>] [--path <dir>] [--json]\",\n \t\tDescriptionEN:   \"Evaluates task intent and affected directories to recommend the exact minimal skill and domain rule extension without cognitive overload.\",\n \t\tDescriptionPtBR: \"Avalia a intenção da tarefa e diretórios afetados para recomendar a skill e extensão de regra exata sem sobrecarga cognitiva.\",\n \t\tFlags: []FlagHelp{\n \t\t\t{\"--domain <name>\", \"Filter suggestions to a specific engineering domain\", \"Filtra sugestões para um domínio específico de engenharia\"},\n \t\t\t{\"--path <dir>\", \"Analyze module stack at the given directory path\", \"Analisa a stack do módulo no caminho de diretório informado\"},\n \t\t\t{\"--json\", \"Output suggestions in structured JSON format\", \"Emite as sugestões em formato JSON estruturado\"},\n \t\t},\n \t\tExamples: []string{\n \t\t\t\"pose suggest feature --path pose-mcp\",\n \t\t\t\"pose suggest bugfix\",\n \t\t},\n \t},\n \t\"assess\": {\n \t\tName:            \"assess\",\n \t\tSummaryEN:       \"Discover module metrics, integration contracts, and technical debt\",\n \t\tSummaryPtBR:     \"Descobre métricas de módulos, contratos de integração e débito técnico\",\n \t\tUsage:           \"pose assess <discover|integrate|tech-debt|design> [options]\",\n \t\tDescriptionEN:   \"Runs bounded local assessments for component LOC, dependencies, technical debt markers, public contracts, and structural deltas on a canonical review subject.\",\n \t\tDescriptionPtBR: \"Executa assessments locais e bounded de LOC, dependências, débito técnico, contratos públicos e deltas estruturais sobre um subject canônico de review.\",\n \t\tSubcommands: []SubcommandHelp{\n-\t\t\t{\"discover\", \"pose assess discover [--component <dir>] [--update-state]\", \"Discover LOC metrics, debts, and module structure\", \"Descobre métricas de LOC, débitos e estrutura de módulos\"},\n-\t\t\t{\"integrate\", \"pose assess integrate\", \"Check inter-module contracts (REST, Protobuf, Kafka, MCP)\", \"Verifica contratos inter-módulos (REST, Protobuf, Kafka, MCP)\"},\n-\t\t\t{\"tech-debt\", \"pose assess tech-debt\", \"Scan codebase for technical debt markers and uncovered stubs\", \"Escaneia a base de código por marcadores de débito e stubs\"},\n+\t\t\t{\"discover\", \"pose assess discover [--component <dir>] [--update-state] [--no-persist]\", \"Discover LOC metrics, debts, and module structure\", \"Descobre métricas de LOC, débitos e estrutura de módulos\"},\n+\t\t\t{\"integrate\", \"pose assess integrate [--update-state] [--no-persist]\", \"Check inter-module contracts (REST, Protobuf, Kafka, MCP)\", \"Verifica contratos inter-módulos (REST, Protobuf, Kafka, MCP)\"},\n+\t\t\t{\"tech-debt\", \"pose assess tech-debt [--update-state] [--no-persist]\", \"Scan codebase for technical debt markers and uncovered stubs\", \"Escaneia a base de código por marcadores de débito e stubs\"},\n \t\t\t{\"design\", \"pose assess design --spec <slug> [--json] [--max-files N] [--max-bytes N]\", \"Observe bounded structural deltas from the sealed review subject\", \"Observa deltas estruturais bounded a partir do subject selado de review\"},\n \t\t},\n \t\tExamples: []string{\n \t\t\t\"pose assess discover --update-state\",\n \t\t\t\"pose assess tech-debt\",\n \t\t\t\"pose assess design --spec customer-cache --json\",\n \t\t},\n \t},\n \t\"serve-mcp\": {\n \t\tName:            \"serve-mcp\",\n \t\tSummaryEN:       \"Start the POSE Model Context Protocol (MCP) server\",\n \t\tSummaryPtBR:     \"Inicia o servidor MCP (Model Context Protocol) do POSE\",\n \t\tUsage:           \"pose serve-mcp [--stdio]\",\n \t\tDescriptionEN:   \"Runs the native POSE MCP server over standard input/output (stdio) or HTTP transport, exposing 20+ specialized tools to AI coding assistants.\",\n \t\tDescriptionPtBR: \"Executa o servidor nativo MCP do POSE via stdio ou HTTP, expondo mais de 20 ferramentas especializadas para assistentes de IA.\",\n \t\tFlags: []FlagHelp{\n \t\t\t{\"--stdio\", \"Run MCP server in stdio mode (default when managed by Claude Code / Cursor / Windsurf)\", \"Executa o servidor MCP via stdio (padrão quando gerenciado pelo cliente)\"},\n \t\t},\n \t\tExamples: []string{\n \t\t\t\"pose serve-mcp --stdio\",\n \t\t},\n \t},\n \t\"telemetry\": {\n \t\tName:            \"telemetry\",\n \t\tSummaryEN:       \"Manage anonymous opt-in telemetry configuration\",\n \t\tSummaryPtBR:     \"Gerencia a configuração de telemetria anônima opt-in\",\n \t\tUsage:           \"pose telemetry <enable|disable|status>\",\n \t\tDescriptionEN:   \"Configures local anonymous telemetry. By default, telemetry is strictly disabled and transmits zero data without explicit opt-in.\",\n \t\tDescriptionPtBR: \"Configura a telemetria anônima local. Por padrão, a telemetria é estritamente desativada e transmite zero dados sem consentimento explícito.\",\n \t\tSubcommands: []SubcommandHelp{\n \t\t\t{\"enable\", \"pose telemetry enable\", \"Enable anonymous opt-in usage telemetry\", \"Ativa a telemetria anônima de uso opt-in\"},\n \t\t\t{\"disable\", \"pose telemetry disable\", \"Disable anonymous telemetry\", \"Desativa a telemetria anônima\"},\n \t\t\t{\"status\", \"pose telemetry status\", \"Display telemetry status and configured endpoint\", \"Exibe o status da telemetria e endpoint configurado\"},\n \t\t},\n \t\tExamples: []string{\n \t\t\t\"pose telemetry status\",\n \t\t\t\"pose telemetry enable\",\n \t\t},\n \t},\n \t\"import\": {\n \t\tName:            \"import\",\n \t\tSummaryEN:       \"Import external SDD specifications into POSE format\",\n \t\tSummaryPtBR:     \"Importa especificações SDD externas para o formato POSE\",\n \t\tUsage:           \"pose import <spec-kit|openspec> <path> [--dry-run]\",\n \t\tDescriptionEN:   \"Converts external spec-kit feature trees or OpenSpec changes/proposals into native POSE specifications with preserved requirements.\",\n \t\tDescriptionPtBR: \"Converte árvores de features do spec-kit ou propostas do OpenSpec para especificações nativas do POSE com requisitos preservados.\",\n \t\tFlags: []FlagHelp{\n \t\t\t{\"--dry-run\", \"Preview imported specs without writing files to disk\", \"Visualiza as specs importadas sem gravar arquivos no disco\"},\n \t\t},\n \t\tExamples: []string{\ndiff --git a/pose-mcp/internal/pose/assessment_sealed.go b/pose-mcp/internal/pose/assessment_sealed.go\nnew file mode 100644\nindex 00000000..e91d9dae\n--- /dev/null\n+++ b/pose-mcp/internal/pose/assessment_sealed.go\n@@ -0,0 +1,20 @@\n+package pose\n+\n+// Assessments in a sealed review checkout (spec\n+// pose-assess-leaves-sealed-checkouts-alone): a reviewer running a planned\n+// assessment tool must not change the checkout it reviews, or its own run\n+// fails. The CLI does not persist there; these writers refuse as the last\n+// line, so no other caller can publish an assessment into it either.\n+\n+import \"errors\"\n+\n+// ErrSealedAssessmentWrite is returned by an assessment writer whose root is\n+// the sealed checkout of a delegated review.\n+var ErrSealedAssessmentWrite = errors.New(\"pose: assessments are not persisted in a sealed review checkout; run the command with --no-persist\")\n+\n+func refuseSealedAssessmentWrite(root string) error {\n+\tif IsSealedCheckout(root) {\n+\t\treturn ErrSealedAssessmentWrite\n+\t}\n+\treturn nil\n+}\ndiff --git a/pose-mcp/internal/pose/assessment_sealed_test.go b/pose-mcp/internal/pose/assessment_sealed_test.go\nnew file mode 100644\nindex 00000000..5e46a2ef\n--- /dev/null\n+++ b/pose-mcp/internal/pose/assessment_sealed_test.go\n@@ -0,0 +1,20 @@\n+package pose\n+\n+import (\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-assess-leaves-sealed-checkouts-alone R3: the review plan runs\n+// every assessment tool in the form that writes nothing.\n+func TestReviewPlanRunsAssessmentsWithoutPersisting(t *testing.T) {\n+\tscope := ScopeRef{Kind: \"spec\", Slug: \"fixed\"}\n+\tfor _, id := range []string{\"assess-discover\", \"assess-integrate\", \"assess-tech-debt\"} {\n+\t\tfor _, component := range []string{\"\", \"core\"} {\n+\t\t\targs := strings.Join(reviewToolArgs(id, scope, component), \" \")\n+\t\t\tif !strings.Contains(args, \"--no-persist\") {\n+\t\t\t\tt.Fatalf(\"%s (%q) plans a persisting run: %s\", id, component, args)\n+\t\t\t}\n+\t\t}\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/discovery.go b/pose-mcp/internal/pose/discovery.go\nindex 7c676226..f30b2777 100644\n--- a/pose-mcp/internal/pose/discovery.go\n+++ b/pose-mcp/internal/pose/discovery.go\n@@ -584,100 +584,103 @@ func (s Store) resolveGitCommit() string {\n \tif res == \"\" {\n \t\treturn \"0000000\"\n \t}\n \treturn res\n }\n \n // inspectCodeFile counts lines and debt markers of one file. It reads the file once and\n // splits it into lines itself: a bufio.Scanner stops at a line longer than its token and\n // reports it only through Err, which the counts then hid. A file that cannot be read is\n // an error, not a file with zero markers.\n func inspectCodeFile(files Files, path string) (loc int, isTest, generated bool, debt TechnicalDebtMetrics, err error) {\n \traw, err := files.ReadFile(path)\n \tif err != nil {\n \t\treturn 0, false, false, debt, err\n \t}\n \tif strings.IndexByte(string(raw), 0) >= 0 || hasGeneratedAssessmentHeader(raw) {\n \t\treturn 0, false, true, debt, nil\n \t}\n \tisTest = isIntegrationTestFile(filepath.ToSlash(path))\n \n \tlex := debtLexState{rust: strings.EqualFold(filepath.Ext(path), \".rs\")}\n \tfor _, rawLine := range strings.Split(string(raw), \"\\n\") {\n \t\tline := strings.TrimSpace(rawLine)\n \t\tif line == \"\" {\n \t\t\tcontinue\n \t\t}\n \t\tloc++\n \t\tif isTest {\n \t\t\tcontinue\n \t\t}\n \n \t\tfor _, marker := range lex.markers(line) {\n \t\t\tswitch marker {\n \t\t\tcase \"TODO\":\n \t\t\t\tdebt.TODOs++\n \t\t\tcase \"FIXME\", \"HACK\":\n \t\t\t\tdebt.FIXMEs++\n \t\t\tcase \"PANIC\":\n \t\t\t\tdebt.Panics++\n \t\t\tcase \"STUB\":\n \t\t\t\tdebt.Stubs++\n \t\t\t}\n \t\t}\n \t}\n \treturn loc, isTest, false, debt, nil\n }\n \n // SaveComponentState writes ComponentDiscoveryState JSON to .pose/state/components/<slug>.json\n // and automatically generates the corresponding .pose/assessments/<slug>.md report.\n func (s Store) SaveComponentState(state *ComponentDiscoveryState) error {\n+\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\n+\t\treturn err\n+\t}\n \tif state == nil {\n \t\treturn fmt.Errorf(\"component state is required\")\n \t}\n \tstate.ComponentSlug = slugifyAssessmentPath(state.ComponentSlug)\n \tdir := s.ComponentStateDir()\n \tif err := os.MkdirAll(dir, 0o755); err != nil {\n \t\treturn err\n \t}\n \tfile := filepath.Join(dir, state.ComponentSlug+\".json\")\n \tdata, err := json.MarshalIndent(state, \"\", \"  \")\n \tif err != nil {\n \t\treturn err\n \t}\n \tif err := os.WriteFile(file, data, 0o644); err != nil {\n \t\treturn err\n \t}\n \n \treturn s.GenerateComponentAssessmentMarkdown(state)\n }\n \n // GenerateComponentAssessmentMarkdown automatically builds .pose/assessments/<slug>.md from discovery data.\n func (s Store) GenerateComponentAssessmentMarkdown(state *ComponentDiscoveryState) error {\n \tdir := s.AssessmentsDir()\n \tif err := os.MkdirAll(dir, 0o755); err != nil {\n \t\treturn err\n \t}\n \n \tfilename := slugifyAssessmentPath(state.ComponentSlug) + \".md\"\n \n \tlangs := strings.Join(state.Metrics.Languages, \", \")\n \tif langs == \"\" {\n \t\tlangs = \"n/a\"\n \t}\n \n \tmd := fmt.Sprintf(`# Component Assessment: %s (`+\"`%s`\"+`)\n \n > **Mapeamento de Módulo POSE**: `+\"`%s`\"+`\n > **Data de Avaliação**: %s | **Baseline Commit**: %s\n > **Métricas**: %d LOC Produção | %d LOC Testes | %d Arquivos Totais\n > **Linguagens**: %s\n > **Saúde de Código**: %d TODOs | %d FIXMEs | %d Panics | %d Stubs\n \n ---\n \n ## 1. Visão Geral e Estrutura do Módulo\n \n O componente **%s** reside no caminho `+\"`%s`\"+` do projeto **%s**.\n \n - **Status de Verificação POSE**: `+\"`%s`\"+`\n - **Pontuação de Completude**: %.0f%%\n@@ -690,100 +693,103 @@ O componente **%s** reside no caminho `+\"`%s`\"+` do projeto **%s**.\n - **FIXMEs**: %d\n - **Panics**: %d\n - **Stubs**: %d\n `, state.ComponentSlug, state.Path, state.Path, state.DiscoveredAt, state.BaselineCommit, state.Metrics.LOCProduction, state.Metrics.LOCTests, state.Metrics.TotalFiles, langs, state.TechnicalDebt.TODOs, state.TechnicalDebt.FIXMEs, state.TechnicalDebt.Panics, state.TechnicalDebt.Stubs, state.ComponentSlug, state.Path, s.projectLabel(), state.Status, state.CompletenessScore*100, state.TechnicalDebt.TODOs, state.TechnicalDebt.FIXMEs, state.TechnicalDebt.Panics, state.TechnicalDebt.Stubs)\n \n \tmd += componentScanScopeMarkdown(state)\n \tfile := filepath.Join(dir, filename)\n \treturn os.WriteFile(file, []byte(md), 0o644)\n }\n \n // ScanIncomplete reports a component whose scan lost files. A state stored before the\n // scan recorded its coverage has no losses and is not reported as incomplete.\n func (c ComponentDiscoveryState) ScanIncomplete() bool { return len(c.Coverage.Losses) > 0 }\n \n // Why a persisted component state could not be used, so a consumer can tell a file it could\n // not open from one that is not JSON, one of a format it does not read and one that names\n // no component.\n var (\n \tErrComponentStateParse       = errors.New(\"pose: the component state is not valid JSON\")\n \tErrComponentStateUnsupported = errors.New(\"pose: the component state has a schema_version this engine does not read\")\n \tErrComponentStateInvalid     = errors.New(\"pose: the component state is not a valid record\")\n )\n \n // LoadComponentState reads ComponentDiscoveryState JSON from .pose/state/components/<slug>.json\n func (s Store) LoadComponentState(slug string) (*ComponentDiscoveryState, error) {\n \tcanonical := slugifyAssessmentPath(slug)\n \tif canonical == \"root\" && slug != \"root\" {\n \t\treturn nil, fmt.Errorf(\"invalid component slug\")\n \t}\n \tfile := filepath.Join(s.ComponentStateDir(), canonical+\".json\")\n \tdata, err := os.ReadFile(file)\n \tif err != nil {\n \t\treturn nil, err\n \t}\n \tvar state ComponentDiscoveryState\n \tif err := json.Unmarshal(data, &state); err != nil {\n \t\treturn nil, fmt.Errorf(\"%w: %v\", ErrComponentStateParse, err)\n \t}\n \tif state.SchemaVersion > 1 {\n \t\treturn nil, fmt.Errorf(\"%w: schema_version %d\", ErrComponentStateUnsupported, state.SchemaVersion)\n \t}\n \tif state.ComponentSlug == \"\" {\n \t\t// \"null\" and a record with no identity decode to a zero state: not a component.\n \t\treturn nil, fmt.Errorf(\"%w: the record names no component\", ErrComponentStateInvalid)\n \t}\n \treturn &state, nil\n }\n \n // GenerateConsolidatedAssessment builds a project-derived consolidated report.\n func (s Store) GenerateConsolidatedAssessment(states []*ComponentDiscoveryState) error {\n+\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\n+\t\treturn err\n+\t}\n \tdir := s.AssessmentsDir()\n \tif err := os.MkdirAll(dir, 0o755); err != nil {\n \t\treturn err\n \t}\n \n \tvar totalProd, totalTests, totalFiles int\n \tvar totalTODOs, totalFIXMEs, totalPanics, totalStubs int\n \tvar sumCompleteness float64\n \tvar incomplete []string\n \n \tfor _, st := range states {\n \t\tif st.ScanIncomplete() {\n \t\t\tincomplete = append(incomplete, st.ComponentSlug)\n \t\t}\n \t\ttotalProd += st.Metrics.LOCProduction\n \t\ttotalTests += st.Metrics.LOCTests\n \t\ttotalFiles += st.Metrics.TotalFiles\n \t\ttotalTODOs += st.TechnicalDebt.TODOs\n \t\ttotalFIXMEs += st.TechnicalDebt.FIXMEs\n \t\ttotalPanics += st.TechnicalDebt.Panics\n \t\ttotalStubs += st.TechnicalDebt.Stubs\n \t\tsumCompleteness += st.CompletenessScore\n \t}\n \n \tavgCompleteness := 1.0\n \tif len(states) > 0 {\n \t\tavgCompleteness = sumCompleteness / float64(len(states))\n \t}\n \n \t// Fetch open specs\n \tvar openSpecsCount int\n \tif openSpecs, err := s.ListSpecs(\"draft,in_progress,in-progress\", \"\"); err == nil {\n \t\topenSpecsCount = len(openSpecs)\n \t}\n \n \t// Fetch integration gaps\n \tvar gapsCount int\n \tif matrix, err := s.AnalyzeIntegrations(); err == nil && matrix != nil {\n \t\tgapsCount = matrix.Summary.IdentifiedGaps\n \t}\n \n \t// Deduct platform macro penalties\n \tplatformCompleteness := avgCompleteness - (float64(openSpecsCount) * 0.02) - (float64(gapsCount) * 0.015)\n \tif platformCompleteness < 0.0 {\n \t\tplatformCompleteness = 0.0\n \t}\n \n \tcommit := s.resolveGitCommit()\n \tnow := time.Now().UTC().Format(time.RFC3339)\n \ndiff --git a/pose-mcp/internal/pose/integration.go b/pose-mcp/internal/pose/integration.go\nindex c0127e22..266ed919 100644\n--- a/pose-mcp/internal/pose/integration.go\n+++ b/pose-mcp/internal/pose/integration.go\n@@ -358,99 +358,102 @@ func (s Store) AnalyzeIntegrations() (*IntegrationMatrix, error) {\n \t\t}\n \t\treturn ordered[i].Token < ordered[j].Token\n \t})\n \n \tmatrix := &IntegrationMatrix{\n \t\tSchemaVersion: 1, EvaluatedAt: time.Now().UTC().Format(time.RFC3339),\n \t\tBaselineCommit: s.resolveGitCommit(), Contracts: []IntegrationContract{}, Gaps: []IntegrationGap{},\n \t}\n \tfor _, observation := range ordered {\n \t\thasProvider, hasConsumer := len(observation.Providers) > 0, len(observation.Consumers) > 0\n \t\tstatus := \"gap\"\n \t\tif hasProvider && hasConsumer {\n \t\t\tstatus = \"active\"\n \t\t\tmatrix.Summary.ActiveContracts++\n \t\t}\n \t\tprovider, consumer := observedPart(observation.Providers), observedPart(observation.Consumers)\n \t\tmatrix.Contracts = append(matrix.Contracts, IntegrationContract{\n \t\t\tName: observation.Name, Protocol: observation.Protocol,\n \t\t\tProvider: provider, Consumer: consumer, Status: status,\n \t\t})\n \t\tif hasProvider == hasConsumer {\n \t\t\tcontinue\n \t\t}\n \t\tgap := IntegrationGap{\n \t\t\tGapID: integrationGapID(observation.Protocol, observation.Name), Provider: provider, Consumer: consumer,\n \t\t}\n \t\tif hasProvider {\n \t\t\tgap.Title = \"No consumer observed for \" + observation.Name\n \t\t\tgap.Severity = \"medium\"\n \t\t\tgap.Description = \"A provider declaration was observed, but no repository consumer reference was found.\"\n \t\t} else {\n \t\t\tgap.Title = \"No provider observed for \" + observation.Name\n \t\t\tgap.Severity = \"high\"\n \t\t\tgap.Description = \"A consumer usage was observed, but no matching repository provider declaration was found.\"\n \t\t}\n \t\tmatrix.Gaps = append(matrix.Gaps, gap)\n \t}\n \tmatrix.Summary.TotalIntegrations = len(matrix.Contracts)\n \tmatrix.Summary.IdentifiedGaps = len(matrix.Gaps)\n \treturn matrix, nil\n }\n \n func markdownCell(value string) string {\n \tvalue = strings.ReplaceAll(value, \"|\", \"\\\\|\")\n \tvalue = strings.ReplaceAll(value, \"\\n\", \" \")\n \treturn value\n }\n \n // SaveIntegrationMatrix writes integrations.json and integrations.md in .pose/.\n func (s Store) SaveIntegrationMatrix(matrix *IntegrationMatrix) error {\n+\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\n+\t\treturn err\n+\t}\n \tif matrix == nil {\n \t\treturn fmt.Errorf(\"integration matrix is required\")\n \t}\n \tif err := os.MkdirAll(filepath.Dir(s.IntegrationStatePath()), 0o755); err != nil {\n \t\treturn err\n \t}\n \tif err := os.MkdirAll(s.AssessmentsDir(), 0o755); err != nil {\n \t\treturn err\n \t}\n \tjsonData, err := json.MarshalIndent(matrix, \"\", \"  \")\n \tif err != nil {\n \t\treturn err\n \t}\n \tif err := os.WriteFile(s.IntegrationStatePath(), append(jsonData, '\\n'), 0o644); err != nil {\n \t\treturn err\n \t}\n \n \tmd := fmt.Sprintf(`# Integration Assessment: %s\n \n > **Gerado por**: POSE Integration Engine (`+\"`pose assess integrate`\"+`)\n > **Data de Avaliação**: %s\n > **Baseline Commit**: %s\n \n ## 1. Resumo Executivo\n \n - **Total de Contratos Observados**: %d\n - **Contratos com Provedor e Consumidor**: %d\n - **Gaps de Integração**: %d\n \n ## 2. Matriz de Contratos\n \n | Nome do Contrato | Protocolo | Provedor | Consumidor | Status |\n |---|---|---|---|---|\n `, s.projectLabel(), matrix.EvaluatedAt, matrix.BaselineCommit, matrix.Summary.TotalIntegrations, matrix.Summary.ActiveContracts, matrix.Summary.IdentifiedGaps)\n \tfor _, contract := range matrix.Contracts {\n \t\tmd += fmt.Sprintf(\"| %s | `%s` | `%s` | `%s` | `%s` |\\n\",\n \t\t\tmarkdownCell(contract.Name), markdownCell(contract.Protocol), markdownCell(contract.Provider),\n \t\t\tmarkdownCell(contract.Consumer), markdownCell(contract.Status))\n \t}\n \tmd += \"\\n## 3. Gaps Observados\\n\\n\"\n \tif len(matrix.Gaps) == 0 {\n \t\tmd += \"Nenhum gap estático foi observado.\\n\"\n \t}\n \tfor _, gap := range matrix.Gaps {\n \t\tmd += fmt.Sprintf(\"### [%s] %s\\n- **Severidade**: %s\\n- **Provedor**: `%s`\\n- **Consumidor**: `%s`\\n- **Evidência**: %s\\n\\n\",\n \t\t\tgap.GapID, gap.Title, gap.Severity, gap.Provider, gap.Consumer, gap.Description)\n \t}\n \treturn os.WriteFile(s.IntegrationReportPath(), []byte(strings.TrimRight(md, \"\\n\")+\"\\n\"), 0o644)\n }\ndiff --git a/pose-mcp/internal/pose/review_plan.go b/pose-mcp/internal/pose/review_plan.go\nindex 7182af75..1495974a 100644\n--- a/pose-mcp/internal/pose/review_plan.go\n+++ b/pose-mcp/internal/pose/review_plan.go\n@@ -1338,111 +1338,111 @@ func buildReviewTools(scope ScopeRef, context reviewPlanContext, profiles []Revi\n \t\t\tadd(tool.ID, requiredness, \"\", tool.EvidenceClasses, tool.Criteria)\n \t\t\tfor i := range tools {\n \t\t\t\tif tools[i].ID == tool.ID && tools[i].Component == \"\" {\n \t\t\t\t\ttools[i].Preconditions = uniqueSorted(append(tools[i].Preconditions, tool.Preconditions...))\n \t\t\t\t}\n \t\t\t}\n \t\t}\n \t}\n \tadd(\"review-check\", \"required\", \"\", nil, nil)\n \tadd(\"closeout-check\", \"required\", \"\", nil, nil)\n \tsort.Slice(tools, func(i, j int) bool {\n \t\tleft, right := reviewToolCatalog[tools[i].ID], reviewToolCatalog[tools[j].ID]\n \t\tif left.Phase != right.Phase {\n \t\t\treturn left.Phase < right.Phase\n \t\t}\n \t\tif tools[i].ID != tools[j].ID {\n \t\t\treturn tools[i].ID < tools[j].ID\n \t\t}\n \t\treturn tools[i].Component < tools[j].Component\n \t})\n \treturn tools, blockers, warnings\n }\n \n func reviewToolPreconditions(id string) []string {\n \tswitch id {\n \tcase \"suggest-review\", \"assess-discover\":\n \t\treturn []string{\"scope-authorized\"}\n \tcase \"validate\", \"surface-check\", \"roadmap-check\":\n \t\treturn []string{\"delivery-target-declared\"}\n \tcase \"assess-integrate\":\n \t\treturn []string{\"scope-authorized\"}\n \tcase \"artifact-check\":\n \t\treturn []string{\"artifacts-attributed\"}\n \tcase \"review-check\", \"closeout-check\":\n \t\treturn []string{\"review-complete\"}\n \tdefault:\n \t\treturn []string{\"scope-authorized\"}\n \t}\n }\n \n func reviewToolArgs(id string, scope ScopeRef, component string) []string {\n \tref := scope.String()\n \tswitch id {\n \tcase \"suggest-review\":\n \t\tpath := component\n \t\tif path == \"\" {\n \t\t\tpath = \".\"\n \t\t}\n \t\treturn []string{\"pose\", \"suggest\", \"review\", \"--path\", path}\n \tcase \"assess-discover\":\n-\t\targs := []string{\"pose\", \"assess\", \"discover\"}\n+\t\targs := []string{\"pose\", \"assess\", \"discover\", \"--no-persist\"}\n \t\tif component != \"\" {\n \t\t\targs = append(args, \"--component\", component)\n \t\t}\n \t\treturn args\n \tcase \"assess-design\":\n \t\treturn []string{\"pose\", \"assess\", \"design\", \"--spec\", scope.Slug, \"--json\"}\n \tcase \"assess-integrate\":\n-\t\treturn []string{\"pose\", \"assess\", \"integrate\"}\n+\t\treturn []string{\"pose\", \"assess\", \"integrate\", \"--no-persist\"}\n \tcase \"assess-tech-debt\":\n-\t\treturn []string{\"pose\", \"assess\", \"tech-debt\"}\n+\t\treturn []string{\"pose\", \"assess\", \"tech-debt\", \"--no-persist\"}\n \tcase \"artifact-check\":\n \t\treturn []string{\"pose\", \"artifact-check\", \"--spec\", scope.Slug, \"--strict\"}\n \tcase \"validate\":\n \t\targs := []string{\"pose\", \"validate\", \"--strict\"}\n \t\tif component != \"\" {\n \t\t\targs = append(args, \"--module\", component)\n \t\t}\n \t\treturn args\n \tcase \"surface-check\":\n \t\treturn []string{\"pose\", \"surface-check\", \"--spec\", scope.Slug, \"--strict\"}\n \tcase \"roadmap-check\":\n \t\treturn []string{\"pose\", \"roadmap-check\", scope.Slug, \"--strict\"}\n \tcase \"history-check\", \"knowledge-check\", \"skills-check\":\n \t\treturn []string{\"pose\", id, \"--strict\"}\n \tcase \"review-check\", \"closeout-check\":\n \t\treturn []string{\"pose\", id, ref}\n \tdefault:\n \t\treturn nil\n \t}\n }\n \n func digestReviewPlan(plan ReviewPlan) (string, error) {\n \ttype digestComponent struct {\n \t\tID, Path, Kind, Language, Domain, Criticality, ValidationProfile, MetadataStatus string\n \t\tSources                                                                          []string\n \t}\n \tcomponents := []digestComponent{}\n \tfor _, component := range plan.Components {\n \t\tcomponents = append(components, digestComponent{component.ID, component.Path, component.Kind, component.Language, component.Domain, component.Criticality, component.ValidationProfile, component.MetadataStatus, component.Sources})\n \t}\n \t// The material structural set is hashed, the coverage report is not. A\n \t// criterion answering for observed structure owes one answer per material\n \t// fact, so gaining a fact must stale a sealed review; a detector that learns\n \t// to report one more unknown must not. Omitted entirely when nothing selected\n \t// on structure, so a plan from before this contract keeps its digest.\n \tvar structure *[]ReviewStructuralFact\n \tif plan.Structure != nil && len(plan.Structure.Material) > 0 {\n \t\tmaterial := append([]ReviewStructuralFact{}, plan.Structure.Material...)\n \t\tstructure = &material\n \t}\n \treturn digestJSON(struct {\n \t\tSchemaVersion                                 int\n \t\tScope, ScopeDigest, BaseProfile, Independence string\n \t\tPolicySchemaVersion                           int\n \t\tComponents                                    []digestComponent\n \t\tProfiles                                      []ReviewPlanProfile\n \t\tCriteria                                      []ReviewPlanCriterion\n \t\tTools                                         []ReviewPlanTool\n \t\tWarnings, Blockers                            []string\n \t\tExplain                                       []string\ndiff --git a/pose-mcp/internal/pose/techdebt.go b/pose-mcp/internal/pose/techdebt.go\nindex 02fe277e..e41044f2 100644\n--- a/pose-mcp/internal/pose/techdebt.go\n+++ b/pose-mcp/internal/pose/techdebt.go\n@@ -380,100 +380,103 @@ func (s Store) AnalyzeTechDebt() (*TechDebtReportState, error) {\n \n \tvar summary TechDebtSummary\n \tfor index := range items {\n \t\titem := &items[index]\n \t\tsummary.TotalMarkers++\n \t\tswitch item.Marker {\n \t\tcase \"TODO\":\n \t\t\tsummary.TODOs++\n \t\tcase \"FIXME\":\n \t\t\tsummary.FIXMEs++\n \t\tcase \"HACK\":\n \t\t\tsummary.Hacks++\n \t\tcase \"PANIC\":\n \t\t\tsummary.Panics++\n \t\tcase \"STUB\":\n \t\t\tsummary.Stubs++\n \t\t}\n \t\tfor _, document := range documents {\n \t\t\tif documentCoversDebt(document.Text, *item) {\n \t\t\t\titem.Coverage, item.CoverageRef, item.Recommendation = document.Coverage, document.Ref, \"none\"\n \t\t\t\tbreak\n \t\t\t}\n \t\t}\n \t\tif item.Coverage != \"uncovered\" {\n \t\t\tsummary.CoveredCount++\n \t\t\tcontinue\n \t\t}\n \t\tsummary.UncoveredCount++\n \t\tswitch {\n \t\tcase componentCounts[item.Component] > 50 && len(componentFiles[item.Component]) > 5:\n \t\t\titem.Recommendation = \"add_to_roadmap\"\n \t\t\tsummary.RecommendedRoadmaps++\n \t\tcase componentCounts[item.Component] > 15:\n \t\t\titem.Recommendation = \"create_spec\"\n \t\t\tsummary.RecommendedSpecs++\n \t\tdefault:\n \t\t\titem.Recommendation = \"create_followup\"\n \t\t\tsummary.RecommendedFollowups++\n \t\t}\n \t}\n \n \treturn &TechDebtReportState{\n \t\tSchemaVersion: 1, EvaluatedAt: time.Now().UTC().Format(time.RFC3339),\n \t\tBaselineCommit: s.resolveGitCommit(), Summary: summary, Items: items,\n \t\tScannedFiles: scanned, Complete: coverage.Complete(), Coverage: coverage,\n \t}, nil\n }\n \n // SaveTechDebtReport writes technical-debt.json and technical-debt.md in .pose/.\n func (s Store) SaveTechDebtReport(report *TechDebtReportState) error {\n+\tif err := refuseSealedAssessmentWrite(s.Root); err != nil {\n+\t\treturn err\n+\t}\n \tif report == nil {\n \t\treturn fmt.Errorf(\"technical-debt report is required\")\n \t}\n \tif err := os.MkdirAll(filepath.Dir(s.TechDebtStatePath()), 0o755); err != nil {\n \t\treturn err\n \t}\n \tif err := os.MkdirAll(s.AssessmentsDir(), 0o755); err != nil {\n \t\treturn err\n \t}\n \tjsonData, err := json.MarshalIndent(report, \"\", \"  \")\n \tif err != nil {\n \t\treturn err\n \t}\n \tif err := os.WriteFile(s.TechDebtStatePath(), append(jsonData, '\\n'), 0o644); err != nil {\n \t\treturn err\n \t}\n \n \tmd := fmt.Sprintf(`# Technical Debt Assessment: %s\n \n > **Gerado por**: POSE Technical Debt Engine (`+\"`pose assess tech-debt`\"+`)\n > **Data de Avaliação**: %s\n > **Baseline Commit**: %s\n \n ## 1. Resumo Executivo\n \n - **Total de Marcadores**: %d\n - **TODOs**: %d | **FIXMEs**: %d | **HACKs**: %d | **Panics**: %d | **Stubs**: %d\n - **Cobertos por Backlog Ativo**: %d\n - **Não Cobertos**: %d\n - **Recomendações**: %d Follow-ups | %d Specs | %d Roadmaps\n %s\n ## 2. Ocorrências\n \n | ID | Marcador | Componente | Arquivo e Linha | Cobertura | Evidência | Recomendação |\n |---|---|---|---|---|---|---|\n `, s.projectLabel(), report.EvaluatedAt, report.BaselineCommit, report.Summary.TotalMarkers,\n \t\treport.Summary.TODOs, report.Summary.FIXMEs, report.Summary.Hacks, report.Summary.Panics,\n \t\treport.Summary.Stubs, report.Summary.CoveredCount, report.Summary.UncoveredCount,\n \t\treport.Summary.RecommendedFollowups, report.Summary.RecommendedSpecs, report.Summary.RecommendedRoadmaps,\n \t\ttechDebtScopeMarkdown(report))\n \tlimit := len(report.Items)\n \tif limit > 100 {\n \t\tlimit = 100\n \t}\n \tfor _, item := range report.Items[:limit] {\n \t\tfileLink := fmt.Sprintf(\"[%s:%d](%s)\", filepath.Base(item.File), item.Line, item.Link)\n \t\tmd += fmt.Sprintf(\"| %s | `%s` | `%s` | %s | `%s` | `%s` | `%s` |\\n\",\n \t\t\titem.ID, item.Marker, markdownCell(item.Component), fileLink,\n \t\t\titem.Coverage, markdownCell(item.CoverageRef), item.Recommendation)\n \t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/bash -lc 'git diff --unified=20 3f63a1bb432801957ddb35354961f1825658531a..04ec840012a842ca47b4e79f1b94669d18b84d13 -- POSE.md locales/pt-BR/POSE.md pose-mcp/internal/scaffold/dist/POSE.md pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/bash -lc 'git diff --unified=20 3f63a1bb432801957ddb35354961f1825658531a..04ec840012a842ca47b4e79f1b94669d18b84d13 -- POSE.md locales/pt-BR/POSE.md pose-mcp/internal/scaffold/dist/POSE.md pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md'","aggregated_output":"diff --git a/POSE.md b/POSE.md\nindex 3f2055de..44c9f1d3 100644\n--- a/POSE.md\n+++ b/POSE.md\n@@ -403,41 +403,41 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - Assessment freshness (spec `pose-adaptive-assessment-freshness`) — a component assessment records its binding: the committed tree of the component, the engine version and the validation-matrix digest. `pose assess discover --if-stale [--component <dir>]` reuses an assessment whose binding is unchanged and refreshes it otherwise, printing `assess.freshness.<component>` with the reason (content changed, engine changed, matrix changed, uncommitted changes, or no binding on an older record). Age alone never stales an assessment. A missing or stale assessment of a component an in-progress spec declares appears as an advisory `evidence` obligation in `state --attention`; it gates nothing.\n - `followups --candidates [--json]` (spec `pose-followup-reconciliation-candidates`) — lists open follow-ups with a reconciliation reason: `target-terminal` (a spec the follow-up names is done, superseded or abandoned), `evidence-present` (a test it names now exists), `overdue` (its review date passed), plus lexical near-duplicate clusters. Each candidate shows its evidence and its limits; nothing is dispositioned, similarity never becomes `duplicate` without judgment, and an open follow-up never leaves Attention without a disposition written in its spec. Attention shows the same reason on the residual-debt item.\n - `action list --present [--actor <id|role>] [--json]` (spec `pose-action-request-presentation`) — groups the requests still waiting for an answer for one conversation: by origin and earliest restricted phase, the ones restricting start or execution first (`interrupt`), release-only ones marked as able to wait. Each request keeps its own id, request digest, revision and answer, and shows exactly the content a resolution binds to; satisfied requests are not asked again. MCP: `pose_action_requests` with `present: true`. Deciding when to interrupt a person is left to the consumer (Harne8).\n - Progressive spec surface (spec `pose-progressive-spec-surface`) — `pose new-spec <slug> --surface minimal|standard|full` records `surface:` in the frontmatter. A `minimal` spec keeps Intent, Requirements, the Technical Plan with its Artifacts, Validation with the requirement trace and the Final Report with its follow-ups; it drops the planner-local Tasks section and the report subsections that `pose specs facts <slug> [--json]` derives from the delivery index (paths of the attributed commits, checks that produced scoped evidence). `lint-spec` stops requiring Tasks for a minimal spec and relaxes nothing else: the trace, follow-up and amendment gates apply as before. The facts never include intent, rationale or accepted risk. Evidence binding (spec `pose-spec-facts-evidence-binding`): `specs facts` separates `checks` (results whose scope provenance names the spec, with their basis and whether they ran against the head of the spec's change sets) from `candidates` (results the index holds that nothing ties to the spec: a declared module or an empty `components` is not provenance); candidates are printed as `CANDIDATE, not evidence of this spec`. `freshness` reports `fresh`, `stale` (an input changed since the index was published), `unknown` (never published as a set) or `unavailable`, and a limitation says to run `pose index` when it cannot be established; reading the facts never rebuilds the index and never concludes that a requirement is satisfied.\n - **Automatic project-state refresh** (spec `pose-project-state-refresh-contract`) — an internal post-event hook registry fires a **partial** `pose state refresh` (only the sections an event affects) at the points POSE already intercepts: a successful `pose lint-spec <slug> --strict` on a `status: done` spec (`spec_closeout` → Specs & Roadmaps, Follow-ups, Validation & Evidence), `pose amend` (`spec_amend` → Specs & Roadmaps, Decisions & Knowledge), `pose reconcile-evidence record` (`evidence_reconciled` → Validation & Evidence) and `pose assess snapshot` (`assessment_snapshot` → Capabilities). When the event carries a commit and `POSE_GRAPHFORGE_MCP_URL` is configured, the consumer calls `components_hit` (spec `graphforge-components-hit-contract`) from the state's baseline to the event's commit and attaches the hit components to the Architecture section (**directed** refresh); without GraphForge configured, refresh stays full/undirected — zero build coupling. No daemon, no filesystem watcher: it is a synchronous call at the exact point each event already happens. **Best-effort by default**: a failed refresh never blocks the command that fired the event — it marks `refresh_pending: <event>` in the state frontmatter instead (cleared by the next successful refresh, regardless of trigger). Strict mode is opt-in via policy (`strict_refresh: true`) — there, a refresh failure fails the triggering command. Every run (triggered or manual) is logged to the artifact's own append-only log (metadata only: trigger, target, result `ok|failed|skipped`, duration, changed-section hashes — never content). Dedup key `hash(event+target+commit)`: the same event processed twice (retry/replay) does not repeat the refresh, result `skipped`; `manual`/`ci` refreshes are never deduped against each other (an explicit call always runs). `release_cut` is registered in the event→sections map but has no producer inside pose-mcp today — cutting a release belongs to Conductor (a separate service); the trigger is ready for when that integration exists.\n - **Capability reassessment triggers** (spec `pose-capability-assessment-triggers`, same hook registry as the automatic project-state refresh above) — the `assessment-staleness` consumer, registered on `spec_closeout`, resolves which components a closeout reached (via `components_hit` when `POSE_GRAPHFORGE_MCP_URL` is configured; fallback: intersecting the event's touched files against each mechanism's manually declared `paths:` globs in the assessment) and marks every affected capability mechanism stale — never mutating a score, only recording `since`/`trigger`/`hits` and projecting a cobrável demand (origin `assessment-trigger`) into `pose followups --open`, with no duplicate storage. `pose assess snapshot` clears the marks on the mechanisms it reassesses and records the mark→snapshot link in the history. On-demand: `pose assess stale [--json]` lists pending marks; `pose assess request --mechanism <id> [--reason <text>]` creates one manually (the same path a UI-driven \"flag for reassessment\" action would call over MCP). MCP tool: `pose_capability_stale`. Without GraphForge and without `paths:` declared, the event logs `capability_mapping_unavailable` to the refresh log — a visible signal, nothing marked silently. Anti-noise threshold (`min_hits`, hit `level` `direct`/`any`, the demand's default owner/SLA) is configurable, sharing the same policy file already used for age/commit-based staleness (optional; absent means these same conservative defaults).\n - **Docs governance** (spec `pose-docs-governance-contract`) — an opt-in, per-project contract for documentation, same mechanic as the capability assessment above: absent, every project stays valid everywhere. `pose docs-init [--profile library|service|cli|monorepo]` scaffolds a manifest declaring governed doc roots and, per doc, `path`/`doc_type` (Diátaxis `tutorial`/`howto`/`reference`/`explanation`, or a custom value)/`topics`/`owns`/`applies_to`/optional `review_after`. `pose docs-check [--json] [--explain <rule>]` runs seven deterministic, offline rules — a declared doc missing from disk, a file present but undeclared, missing minimal frontmatter (`title`/`doc_type`), a broken relative link, a broken typed reference (`spec:`/`adr:`/`knowledge:`/`doc:`/...), staleness (an entry's own review date, or the manifest's default review window counted from its last touching commit) and a security scan reusing the same deterministic unsafe-instruction/secret-shaped pattern check skills already run — each with a configurable severity (`error`/`warning`/`off`). `pose check --strict` incorporates `docs-check` when the manifest exists (opt-in by presence); only errors block, warnings surface without blocking. `pose docs-sync` synchronizes governance metadata. Tool MCP: `pose_docs_state`. Project-state gains an additive Docs section (manifest presence/profile/roots, declared/undeclared/stale/error/warning counts).\n - **Docs review-pending triggers** (spec `pose-docs-assessment-followups`, third consumer of the same hook registry as the two entries above — reused unmodified) — a `docs-review` consumer, registered on `spec_closeout`, resolves which components/files a closeout reached (`components_hit` when configured, matched against `owns:` entries declared as `component:<id>`; otherwise the event's touched files matched against each doc's `owns:` paths/globs, where a directory like `\"site\"` covers every file under it) and marks every doc whose declared area was reached as review-pending — never editing the doc itself, never touching a score. Marks accumulate in an append-only log outside the doc's own file and project a synthetic, owned demand into `pose followups --open` (origin `docs:<doc-path>`), reusing the manifest entry's own `owner` field when declared. `pose docs-review resolve <doc> [--no-change --reason <text>] [--commit <sha>]` closes every mark pending on a doc at once, recording `updated` (default, captures the current commit) or `no_change_needed` (reason required); `pose docs-review request <doc>`/`--all-stale` cover the on-demand path — the latter bridges every currently-stale doc into an active demand in one call. `docs-check`'s own output and `pose_docs_state` additively list what's still pending. Without a component map and without `owns:` declared, the event logs a visible signal instead of marking anything silently — here the path fallback is the mechanism's full-strength path (`owns:` is expressed as paths by default), not a lesser one. Anti-noise threshold (`min_hits`, hit `level`, default owner/SLA) is configurable, sharing the same policy shape as the capability triggers in its own file (optional; absent means these same conservative defaults).\n - `history-check` — verifies every `.jsonl` under `reports/history/` is git-tracked. Without that, `recurrence-check` and `stats` diverge between machines. Strict blocks; tolerant warns.\n - `suggest` — reads [`task-map.json`](.pose/indexes/task-map.json) and prints the canonical trail (workflow + skill + rules + spec/ADR + knowledge) for a task type. With no arguments it lists every type. `--domain <d>` adds domain rules (frontend, backend-go, k8s); `--path <p>` infers the domain heuristically and via [`repo-map.json`](.pose/indexes/repo-map.json) (`language` → frontend/backend-go); `--json` for agents. Domains (spec `pose-distributed-instructions-parity`): `--domain` and the domain inferred from `--path` go through one taxonomy (`go`/`golang`/`backend-go` → `backend-go`; `react`/`frontend-react`/`frontend` → `frontend`; `kubernetes`/`helm`/`k8s` → `k8s`), the JSON discloses `domain_input` and `domain_source: alias`, and a domain the task map has no rules for is reported (`domain_status`) instead of borrowing another's; a `backend` module is the Go domain only when its language is Go. `rules_status` (and the human output) says for each rule whether it is `installed` (with its path), `extension-needed` (with `pose extension install <id>`) or `unavailable`; suggest announces no rule file that is not on disk and installs nothing.\n - `stats` — aggregates history JSONL outcomes by workflow, task or context. Enables objective decisions (promoting a check from optional to required, spotting unstable workflows, comparing ci against manual). `--since-days N` filters the window; `--json` for machine consumption.\n - `stats governance` — schema 2 read-only projection over report history, sealed review bundles, attestations and explicit remediation declarations. It keeps preparation, judgment, intervention, freshness, telemetry, provenance and coverage independent, never emits a quality score, and reports missing/invalid data explicitly. `--report-type` filters validation attempts; `--band` filters reviews and finding links. Replay identity is `(report_type, task_slug, sequence)`; identity-less rows remain visible in coverage. MCP `pose_governance_stats` accepts the same selectors and requires `project_id` when choosing a federated root. Explicit finding links contain only opaque IDs, spec slugs, category and source band, with at most 100 rows and truncation reported.\n - `stats governance --waits --rework` (spec `pose-governance-wait-rework-observability`) — two more dimensions beside the outcomes, never folded into a score. With `--waits` or `--rework` only the requested dimensions are computed; `--outcomes` adds the outcomes, which read the whole history. `--waits` times action requests and keeps three measures apart: the age of each request, the interval attributed to waiting on an actor or an external system, and `known_blocking_seconds`, the union per spec of intervals in which a request restricted the whole spec's execution (simultaneous requests count once). None of them is inactivity; missing timestamps are counted as unknown. `--rework` classifies superseded sealed bundles by what changed (subject, intent or plan, review plan, evidence, or unknown) and extra attestations on one bundle by review disagreement or an earlier attestation invalid against today's policy, leaving other causes unknown. `scripts/bench-governance.sh [runs] [pose-binary]` times `state --attention`, `check --strict` and `index` on the same revision and reports time and the index size separately, with the corpus revision and engine version.\n - Premise validity (spec `pose-assumption-validity-scope`) — a material `Assumption A<N>` may declare `Valid scope:` (the context it holds in) and `Stale trigger:` entries `<kind>:<value>@<pin>`, where kind is `doc`, `report`, `knowledge`, `adr` or `snapshot` and the pin is a prefix (8+ hex) of the sha256 of the content the premise was judged against. `lint-spec --design-check` reports an unpinned trigger with the pin to append, an unreadable one as unknown, and a calendar trigger (`date:`, `ttl:`, …) as not evaluated: validity is by context, not expiry, and trivial premises need neither field. When pinned content changes, the obligation projection (producer `premises`) emits a `premise-stale` judgment obligation for draft and in-progress specs, advisory on review and scoped to the assumption and the decisions based on it. The recorded evidence stays; it is described as judged against the pinned content and not valid for the current one, and nothing is invalidated automatically. Provider or remote contracts are not monitored by the core. Trigger state is projection only and never changes the design digest.\n - Falsifier observation (spec `pose-falsifier-reconsideration`) — a material `Decision D<N>` may add `Expected effect:` and `Falsifier check: check:<module>/<check>`, naming the indexed validation check whose failure contradicts it. When the delivery index holds a `fail` result for that check, the obligation projection (producer `falsifiers`) emits a `falsifier-observed` judgment obligation, advisory on review and scoped to the decision, for any spec that is not superseded or abandoned (decisions stay in force after done). The engine infers no cause and judges no architecture: the failure is an observation, the decision and its rationale are never edited, and a person either records why it still holds or opens a superseding decision. A passing or absent result raises nothing. `lint-spec --design-check` warns on a malformed reference and on a falsifier check without a stated falsifier.\n - `migrate v7 --dry-run [--json]` (spec `pose-v7-legacy-cleanup-plan`) — read-only inventory of what a future major would convert, keep or refuse: spec layouts, `blocked` specs, legacy and unknown review policy keys, sealed bundles, attestations by identity mode and attribution, and incomplete transfers on this project's side, each with its action and removal criterion. It writes nothing. Sealed bundles, attestations and signatures are never rewritten. `--apply` is refused with the current fact: no apply is available in this engine, the only mode is `--dry-run`, which writes nothing; no future apply is promised.\n - `assess design --spec <slug>` — read-only bounded projection over the canonical sealed review subject. It observes dependency, component, delivery-metadata, governance-contract and public-contract deltas, keeps unknown/unsupported coverage explicit, and never computes a complexity or architecture score. The MCP equivalent is `pose_design_delta`.\n - `usage` — aggregates automatic, project-scoped CLI and MCP usage events: calls, execution/semantic outcomes, latency, findings observed and stable finding lifecycle (`unique`, `new`, `resolved`, `reopened`). Agents never maintain counters. Events are best-effort, local-only and stored outside the tracked worktree; raw arguments, output, paths, project/user identity and finding IDs are never persisted. `--since-days 0` includes all history; filter with `--tool` or `--surface`; MCP equivalent: `pose_usage`. This is product-usage evidence, not a DORA delivery outcome or an individual productivity score.\n - `record-deployment` / `record-incident` / `dora-metrics` / `adoption-metrics` — ingest identity-free schema-v2 delivery events and calculate metrics for explicit production environments (`--environment`, default `production`). Deployments require `--deployment-kind planned|rework`; incidents require an environment; recovery includes only resolved `--caused-by-deployment` incidents. `adoption-metrics` aggregates specifications, roadmaps, and validation lifecycle rates.\n - `stacks [--path dir] [--json]` — read-only, offline catalog inspection (spec pose-stack-catalog-expansion). Matches directory entries against the maintained profile catalog (Node.js, Go, Rust, Java, **Python** — poetry/pipenv/pip/setuptools/pep517 — and **.NET**), reporting per profile: manager, marker, `winner`/`shadowed` (multiple managers present resolve by declared priority), `confidence` (`medium` under conflict), and whether the prerequisite native tool is on `PATH` — via `exec.LookPath`, never by executing a project file. Detected markers feed `discoverValidationModules`/`pose init --wizard` the same way Node/Go/Rust/Java already do; the actual checks run through [`validation-matrix.json`](.pose/indexes/validation-matrix.json) `python`/`dotnet` stacks. Python manager priority is expressed with `when.fileNotExistsAny` (skip when any higher-priority lockfile/marker exists) alongside the existing `fileExists`/`fileNotExists` predicates.\n-- `assess discover|integrate|tech-debt|stale|request|snapshot` — native assessment engines for LOC, technical debt markers, component structures, inter-module contract integrity checks, and capability mechanism reassessment lifecycle.\n+- `assess discover|integrate|tech-debt|stale|request|snapshot` — native assessment engines for LOC, technical debt markers, component structures, inter-module contract integrity checks, and capability mechanism reassessment lifecycle. `discover`, `integrate` and `tech-debt` take `--no-persist` to print their result without writing `.pose/assessments/` or `.pose/state/`; in the sealed checkout of a delegated review (`POSE_SEALED_CHECKOUT`) they never persist, `init`, `snapshot` and `request` refuse, and the review plan runs them with `--no-persist`, so a reviewer running a planned assessment does not fail its own run.\n - `doctor [--fix]` — environment, dependency, native runtime, and POSE instance health diagnostics, plus governance that would otherwise fail only downstream: `review.evidence-vocabulary` (a selected profile demands a class no check may emit), `validate.class-producers` (a criterion accepts only classes no registered check produces), `validate.evidence-class-coverage` (checks with no `evidenceClass`), `review.profile-schema`, `review.contract-adoption`, `review.scope-change-set`, and `<policy>.policy-keys` for nine policies (keys the engine does not read, i.e. a misspelled setting that silently does nothing).\n - `knowledge-housekeeping` / `reports-housekeeping` / `events-housekeeping` — idempotent maintenance (list/archive/purge). Mutations require `--apply`. Reports housekeeping **never touches `history/`**: the JSONL is the source of truth for `recurrence-check` and `report`'s temporal comparisons. Defaults: stale = 120d, archive purge = 365d.\n - `amend` — append-only spec amendment history (`amendments.jsonl` beside a folder spec's `spec.md`, or `YYYY-MM-DD-<slug>.amendments.jsonl` beside a flat dated spec; the spec is resolved through the store, so both layouts amend alike). `--baseline` snapshots every R-ID hash; `--ids R2 --change added|withdrawn|semantic|editorial --rationale <text> --author @alias [--reviewer @alias]` acknowledges a material change; `--list` renders history and pending acknowledgments. On `done` specs with a history, `lint-spec` rejects any requirement whose current text is not acknowledged by an event — specs cannot be silently rewritten after evidence. `--nodes [--json]` prints the versioned contract-node projection: requirements, assumptions and decisions with namespace, content hash, state and relations. With `contract_nodes_version: 1` adopted in the review policy, `--baseline` writes a schema-2 R/A/D snapshot, `--ids` accepts A/D, `--change transition` acknowledges an allowed state change, `editorial` is refused when a node changed state or relations, and the gate also rejects an active decision resting on an invalidated or withdrawn assumption. Without the capability the gate stays requirement-only and a schema-2 event is refused; schema-1 logs keep their meaning.\n - `start` — atomic start of a draft spec, journaled in a per-spec start record. Without flags it is a read-only, digest-bound preview: readiness and dependencies, the declared review obligations (no future structural delta needed) and the R/A/D baseline. `--apply --digest <sha256>` records that baseline and moves the spec from `draft` to `in-progress` under a per-spec lock with compare-and-swap; it needs `atomic_start_version: 1` in the review policy, repeats idempotently, resumes an interrupted run and refuses another plan for a started spec. `--cancel` undoes a start that never moved the spec. The per-spec lock records its owner (host, digests of the machine and boot IDs, PID namespace, PID and process start); a lock another call holds is reported, never broken by age, as `owner-active`, `owner-unknown` or `owner-dead` (spec `pose-journal-checkpoint-and-lock-recovery`). Dead is proven only on the same Linux machine — another boot, or a PID that is not running or now belongs to another process — and `--recover-lock <owner digest>`, with the digest `--status` shows, removes that lock only if its bytes and its dead owner are unchanged, leaving the start record to resume; an unknown owner (another host, an older engine's empty lock, another platform) is checked and removed by a person. The same lock is the spec's lifecycle lock: close and transfer take it too, so no two of them interleave on one spec (spec `pose-writer-coordination-and-atomic-publication`). `--status` classifies each node as `recorded-before-managed-execution`, `introduced-during-execution` or `legacy-unbaselined`, recomputes obligations and, under the capability, asks for reconciliation when status or the recorded baseline was edited by hand. `atomic_start_adopted_at: YYYY-MM-DD` (spec `pose-atomic-start-adoption-cutoff`) limits the capability to specs created on or after that date: an older spec in progress without a start is reported as `legacy-unbaselined` with a note and blocks nothing; without the date every such spec needs reconciliation. A start records observable precedence, not when anything was decided; MCP exposes the read-only view as `pose_start_status`.\n - `knowledge-usage` — projects `knowledge:<slug>` citations from specs per artifact (owner, expiry, citing specs). Usage signals inform the owner's review; TTL is never extended automatically. Dangling `knowledge:` refs fail `knowledge-check`.\n - `knowledge-suggest <query>` / `semantic-suggest <query>` / `suggest-feedback` / `portfolio-projection` / `reconcile-evidence` — deterministic lexical ranking and advisory projections for knowledge, feedback clustering, multi-roadmap portfolio milestones, and delivery validation evidence reconciliation. Suggestions never gate or auto-apply without confirmation.\n - `hooks` — links the native binary into `.git/hooks/`; invocation name selects `check --tolerant` for `pre-commit` and `index` for `post-merge`. `install --force` keeps a backup of pre-existing hooks. An instance that runs POSE through its own revision-bound CLI declares a runner in a `hooks.json` file of `.pose/policy/` (`{\"schema_version\":1,\"runner\":\"<project-relative executable>\"}`): the hook then runs the runner with the hook's name and returns its exit code, and `hooks status` names it; a runner outside the project, not executable or under another schema is refused and nothing runs.\n - `version` — displays compiled Go binary version, commit SHA, and compares the repository schema version with engine requirements.\n - `context` — resolves a selected logical project and optional local or `xref:`-qualified task through the shared artifact resolver. The JSON result includes canonical authority, project/artifact revisions, resolution state, supported contracts and a `context_revision`; it never includes filesystem roots. Use this token to detect a changed checkout or revision before a cross-project write.\n - Cross-project CLI writes require the target in `POSE_PROJECT_ROOTS` and the `context_revision` from a fresh `pose context` call. Use `new-spec-qualified` for qualified creation so older engines reject the command itself. A project found only by `HARNE8_PROJECTS_DIR` scan can be read but does not grant write access. Existing canonical specs are reused; redirects and incomplete transfers block shadow creation.\n - `install <dir> [--locale tag] [--skip-mcp] [--force] [--no-backup] [--allow-non-git]` — installs the embedded POSE runtime, rules, workflows, templates, and documentation into a target project directory without cloning, stamps `adopted_at` in the changelog policy with the day the instance received it, and runs the strict gate.\n - `import <spec-kit|openspec> <path> [--dry-run]` — imports foreign specification trees into canonical POSE specifications with standard frontmatter and section structure.\n - `serve-mcp` — starts the POSE Model Context Protocol server over stdio (`--stdio`) or HTTP for native AI agent integration. The stdio server exits on SIGTERM; it resolves the `pose` CLI it runs once, at start, so a server started before `pose update` keeps working with the updated binary.\n - `report-limitation` — records an engine limitation, defect, or enhancement proposal into `.pose/feedback/` with optional submission (`--submit`).\n - `contribute <enable|disable|status|stage|list>` — open-source contributor mode; stages sanitized reports under `.pose/contributions/` without leaking proprietary code; submission remains developer-adjudicated.\n - `telemetry <enable|disable|status>` — manages anonymous, opt-in platform telemetry settings.\n - `release` / `release-notes` — governed release lifecycle (`plan`, `prepare`, `check`, `notes`, `record`, `status`, `open-next`, `backfill`) ensuring immutable release notes, manifest freezing, provider evidence importing, and reproducible release verification. A release that introduces a governance contract carries a **Compatibility** section at the top of its notes, generated from the contract registry. `release-notes` provides a compatibility alias for viewing frozen notes. The version a cut is compared with comes from `version_source` in `.pose/policy/release.json` (`{\"path\": \"VERSION\", \"kind\": \"text\"}`, or `\"kind\": \"json\"` with a `key`): a project file holding `X.Y.Z`, with an optional `v` and `-dev` suffix. Only the engine repository may omit it; every other project must declare one. Manifest and tag integrity (spec `pose-release-manifest-tag-integrity`): a manifest is read through a strict contract (supported `schema_version`, no unknown fields, clean version and paths) that recomposes `specs`, `categories`, `breaking` and `release_input_digest` from the fragments it freezes, so an adulterated projection is refused instead of normalised. `check` and `status` verify a tag from its own tree: the tag (lightweight or annotated) is peeled to its commit, and the manifest, notes, frozen fragments and version source are read as blobs of that commit, never from the working tree. A tag whose tree holds no manifest is refused whatever the working tree holds; a later commit, provider evidence or the next cycle does not make a correct cut stale; a version source that cannot be recomputed from the manifest is reported as a limit.\n \n   **Query cursors:** paginated MCP list tools (`pose_list_specs`, `pose_list_roadmaps`, `pose_list_knowledge`, `pose_list_reports`, `pose_capability_history`) continue a query over the collection it was issued for. A cursor is signed, expires after 15 minutes and is bound to its tool, project, filters and the ordered collection with its index generation; a changed collection, another query, an expired token, a version 1 token or a server restart is refused with a `cursor-*` code and the caller restarts from the first page, never continued over a changed collection. A page is at most 500 items, discloses its `generation`, `collection` and `total`, and a missing `next_cursor` does not certify anything beyond that collection (spec `pose-generation-bound-query-cursors`).\n \n@@ -1054,27 +1054,29 @@ Declare the executor and implementation baseline before dispatch. A bundle that\n \n ```json\n {\n   \"schema_version\": 1,\n   \"provenance\": {\n     \"trust\": \"executor-attested\",\n     \"implementation\": {\"principal\": \"agent:implementer\", \"execution\": \"implementation-run-1\", \"vendor\": \"vendor-a\", \"model\": \"model-a\"}\n   },\n   \"adapters\": {\n     \"reviewer\": {\"executor\": \"agent:reviewer\", \"command\": [\"reviewer\", \"--output\", \"{output}\"], \"vendor\": \"vendor-b\", \"model\": \"model-b\"}\n   }\n }\n ```\n \n Use the existing native issuer and its attestation pin. Set protected `authority_project` and `authority_audience` in review policy; a declared project identity must agree. Keep keys outside the project. Dispatch captures origin/worktree, bundle/commit/scope/kind, configuration/argv/executable, identities, brief template/body/notes, planned stdin and actual pipe-write digests, raw and retained redacted output/transcript digests and completeness. A pipe write does not prove the vendor consumed the prompt. Session references and private keys stay outside the public proof.\n \n Preview `pose review run-sign <run-id> --issuer <name> [--ttl <duration>]`, then add `--apply` to publish an immutable proof under `.pose/review-run-proofs/`. TTL is optional (no expiry when absent), positive when supplied and at most 365 days. Verify it with `pose review run-proof <run-id> <proof-id> [--json]`. The proof signs the captured executor declaration; it is not an independent vendor receipt or human confirmation. Failed or interrupted audit records disclose their state and `complete_review=false`. Unknown or ambiguous draft decisions also keep that flag false. A true flag describes completed delivery with one draft decision, not approval or complete typed-conclusion validation. A completed run with incomplete stdin or truncated output cannot establish a completed review. Legacy runs have no captured provenance and cannot be upgraded by signing today's configuration. `pose review run-proof` and the issuer lookups of the verdict readers ask the question the closeout asks: for a run whose scope is done, the proof as it was given (the record stands, the issuer still holds its pin; routine drift of the repository and the proof's expiry are not asked, because the expiry bounds when a proof may back a new attestation, not whether an attestation already given to a done scope stands); for an open scope, as the repository is now.\n \n Attach `--run <run-id> --run-proof <proof-id> --sign <issuer>` to a complete `pose review attest` request. The native issuer derives authority principal/execution bindings from the run and signs the exact reference. Criteria, tools, evidence and all ordinary preflight checks still apply. A rejecting or ambiguous draft cannot support an approval; a run-backed attestation cannot predate its completed run or signed proof. Adjudication/smoke run proofs bind their kinds but cannot be used as review attestations. Automatic validation/application of complete typed conclusions belongs to the capability, not to run signing.\n \n-**Conclusions of delegated reviews.** `pose review conclude <run> [--issuer <name>] [--apply] [--json]` records the conclusion of a completed review run: the run's final message carries its typed conclusion in the pose-draft block — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` as `<class>:<ref>`, `rationale`, and `mappings` where the plan asks for structural mappings) and `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), the brief of template `review-brief/7` (the text a template version renders is frozen by a golden digest, so a change to it takes a new version) asks for them and states the rules the engine checks before it records one (a judgment criterion passed carries a rationale, its evidence is a ref the bundle sealed, a finding criterion names a finding of the draft, structural facts are answered as `mappings`; a draft that breaks one is refused whole; a round after the first also names the findings it accounts for by the identifiers the brief lists, with their round, never a bare F1) — and the engine signs the run's proof and the attestation with the native issuer, `--issuer` or `conclusions.issuer` in `.pose/policy/delegation.json` (the key stays outside the project), and records it through the same domain writer and preflight as `pose review attest --run --run-proof --sign`. A follow-up finding with `action`, `owner` and `review_by` becomes an accepted risk when its severity is one the sealed review policy accepts (low by default); any other finding stays open. A rejecting conclusion is recorded too and blocks the scope until the bundle changes. A run that is not a completed review, is superseded, captured no provenance, has an incomplete cleanup or record, carries no valid draft for its round, or whose bundle no longer governs, records no attestation: its conclusion record, in the `review-conclusions` directory of `.pose`, keeps the reasons. A run concludes once: a lock the system releases when the process ends is held from the first read to the last write, concluding it again returns its record, and a reservation an interrupted conclusion left is completed from the attestation it recorded only if that attestation verifies as the run's conclusion, otherwise the run is concluded in its place. Whoever signs it, an attestation of a run briefed with `review-brief/3` to `/7` states that run's conclusion: criteria, tools or findings its draft did not declare are refused. With review policy `delegated_review: true` and `conclusions.issuer` set, `pose delegate review` records the conclusion the moment the run completes; otherwise nothing is automatic. An adjudication or a smoke run concludes the same way, under the same checks, lock and refusals, and never as an approval. The brief of template `adjudication-brief/2` lists the questions the scope's spec records — each decision `D<n>` and requirement `R<n>` — and the pose-draft block answers each in `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); the verdict is recorded as an adjudication record of the spec in the `adjudications` directory of `.pose`, and `lint-spec` fails, and `close` refuses, on a question the current bundle's adjudication says does not hold and warns on one it cannot determine or on a record that does not verify. The brief of template `smoke-brief/2` asks for `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), one per delivery target; the observations are recorded as validation results of evidence class `smoke`, one required check per target that passes when it was observed and is evidence of that target of that spec only, its head, time and provenance taken from the run and the current index, in the `results/smoke` directory of `.pose`, which `surface-check` reads beside the results path, so a delivery profile may demand `smoke`. A verdict that does not answer exactly what its brief asked records nothing; every record is verified on read — its run's proof verifies and it is what the run's draft concludes — and one that does not yields nothing. Runs briefed with `adjudication-brief/1` and `smoke-brief/1` keep verifying with their template.\n+**Conclusions of delegated reviews.** `pose review conclude <run> [--issuer <name>] [--apply] [--json]` records the conclusion of a completed review run: the run's final message carries its typed conclusion in the pose-draft block — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` as `<class>:<ref>`, `rationale`, and `mappings` where the plan asks for structural mappings) and `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), the brief of template `review-brief/8` (the text a template version renders is frozen by a golden digest, so a change to it takes a new version) asks for them and states the rules the engine checks before it records one (a judgment criterion passed carries a rationale, its evidence is a ref the bundle sealed, a finding criterion names a finding of the draft, structural facts are answered as `mappings`; a draft that breaks one is refused whole; a round after the first also names the findings it accounts for by the identifiers the brief lists, with their round, never a bare F1) — and the engine signs the run's proof and the attestation with the native issuer, `--issuer` or `conclusions.issuer` in `.pose/policy/delegation.json` (the key stays outside the project), and records it through the same domain writer and preflight as `pose review attest --run --run-proof --sign`. A follow-up finding with `action`, `owner` and `review_by` becomes an accepted risk when its severity is one the sealed review policy accepts (low by default); any other finding stays open. A rejecting conclusion is recorded too and blocks the scope until the bundle changes. A run that is not a completed review, is superseded, captured no provenance, has an incomplete cleanup or record, carries no valid draft for its round, or whose bundle no longer governs, records no attestation: its conclusion record, in the `review-conclusions` directory of `.pose`, keeps the reasons. A run concludes once: a lock the system releases when the process ends is held from the first read to the last write, concluding it again returns its record, and a reservation an interrupted conclusion left is completed from the attestation it recorded only if that attestation verifies as the run's conclusion, otherwise the run is concluded in its place. Whoever signs it, an attestation of a run briefed with `review-brief/3` to `/8` states that run's conclusion: criteria, tools or findings its draft did not declare are refused. With review policy `delegated_review: true` and `conclusions.issuer` set, `pose delegate review` records the conclusion the moment the run completes; otherwise nothing is automatic. An adjudication or a smoke run concludes the same way, under the same checks, lock and refusals, and never as an approval. The brief of template `adjudication-brief/2` lists the questions the scope's spec records — each decision `D<n>` and requirement `R<n>` — and the pose-draft block answers each in `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); the verdict is recorded as an adjudication record of the spec in the `adjudications` directory of `.pose`, and `lint-spec` fails, and `close` refuses, on a question the current bundle's adjudication says does not hold and warns on one it cannot determine or on a record that does not verify. The brief of template `smoke-brief/2` asks for `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), one per delivery target; the observations are recorded as validation results of evidence class `smoke`, one required check per target that passes when it was observed and is evidence of that target of that spec only, its head, time and provenance taken from the run and the current index, in the `results/smoke` directory of `.pose`, which `surface-check` reads beside the results path, so a delivery profile may demand `smoke`. A verdict that does not answer exactly what its brief asked records nothing; every record is verified on read — its run's proof verifies and it is what the run's draft concludes — and one that does not yields nothing. Runs briefed with `adjudication-brief/1` and `smoke-brief/1` keep verifying with their template.\n+\n+**Review readiness before the seal.** A new seal of a spec scope refuses what `pose close` and the conclusion preflight would otherwise refuse only after a full review round: a change to a delivery root with no delivery declaration (`undeclared-delivery`) or to a governed path the artifacts do not declare (`undeclared`), read from the same index `pose close` reads, and, when a required criterion asks for structural mappings, a decision or assumption that reaches no requirement or constraint (give it a `- Basis:` line). A bundle already sealed is returned as it was. `pose review draft-check [<bundle-id|run-id>] --draft <file|-> [--json]` reports every reason the conclusion step would refuse a draft (an unreadable block, a round it does not account for, a criterion, mapping, finding, evidence or tool the attestation preflight refuses) and writes nothing; inside a delegated review the run provides the bundle and the round through `POSE_REVIEW_DRAFT_CONTEXT` and names its own engine in `POSE_REVIEW_CLI`, and `-` reads the draft from standard input, so it works in a read-only sandbox. The brief of template `review-brief/8` asks the reviewer to run it before finishing. `pose delegate` names an oversized note file with its size and the limit, and a completed run that nothing concluded automatically prints the `pose review conclude <run>` command that records it.\n \n **Delegated-review requests.** `pose review request <scope|bundle> --kind delegated-review [--purpose review|adjudicate|smoke] [--agents <name,...>] [--note-file <path>] [--apply]` opens an action request of kind `delegated-review` that binds the project, the worktree, the scope, the sealed bundle, the brief, the notes, the policies, the accepted agents and the destination of the conclusion (an attestation, an adjudication record or smoke evidence). No actor answers it: `pose action fulfil <act-id> --run <run-id> --runner agent:<id> --idempotency-key <key> --expected-revision <n> [--channel cli|ci|conductor] [--envelope <file>] [--apply]`, or the MCP tool `pose_action_fulfil`, submits a completed run, and the engine records the fulfilment only when the run is of the request's brief and bundle, of an accepted agent, completed with its containment, its signed proof verifies, its attempt ledger is intact and the engine recorded its conclusion at the request's destination; the fulfilment is verified again on every read. `pose delegate review <scope> --request <act-id>` runs the request's brief locally and submits the run once concluded. A rejecting run fulfils the request without approving anything; a superseded bundle or changed policy invalidates it, even once fulfilled, and it is asked again with `--supersedes <act-id>`, which retires it under the supersession authority rules (`--authority <json>`, `--role <role>`, `--requested-at` from the preview), or, when the plan now reserves the review for a person, makes the person's escalation its successor; a retry with the same key and run is a no-op. A person is asked by exception, as a decision request to the maintainer role: a plan that reserves the review for a person, a spent attempt budget, reviewers in conflict, and a `business_decision` a reviewer raised in its draft. A run's proof verifies in any checkout of the project: the worktree it ran in is recorded, not required of the reader, so a CI job or the Conductor fulfils the request with the same envelope.\n \n Opt in to the verification bar with `delegated_review: true` in review policy only when preparing adoption. This live bar requires a signed run reference for agent different-actor review and refuses a prefix-only identity; it does not enable or add the future catalog capability. Non-adopting instances keep declared behavior. Under explicit executor-attested trust, normalized vendor OR model difference satisfies different-actor (vendor difference preferred); unknown baselines and the same vendor/model refuse. A machine run never satisfies mandatory-human. Catalog adoption, cutoffs/rollback and automatic conclusion application remain separate capability work.\n \n Read the same current assurance through verify, review-check, MCP and `pose state --attention`: `machine-attested` names the signed executor declaration, its source, run/proof and vendor/model comparisons. Current issuer pins, project/audience/time, sealed inputs, retained artifacts and original/continuation receipts are reverified. Revocation, missing receipts, rewritten data or stale inputs remove machine assurance. Signing does not reset quotas or erase earlier rejecting runs. The origin worktree is recorded with the run, not required of the reader: a proof verifies in any checkout of the project, so a run a CI job or the Conductor performed is verified like a local one; no universal containment is claimed.\ndiff --git a/locales/pt-BR/POSE.md b/locales/pt-BR/POSE.md\nindex 3c20d024..33f7e0df 100644\n--- a/locales/pt-BR/POSE.md\n+++ b/locales/pt-BR/POSE.md\n@@ -407,41 +407,41 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - Frescor de assessment (spec `pose-adaptive-assessment-freshness`) — um assessment de componente registra seu vínculo: a árvore commitada do componente, a versão do motor e o digest da matriz de validação. `pose assess discover --if-stale [--component <dir>]` reaproveita um assessment cujo vínculo não mudou e o refaz caso contrário, mostrando `assess.freshness.<componente>` com o motivo (conteúdo mudou, motor mudou, matriz mudou, mudanças não commitadas, ou registro antigo sem vínculo). Idade sozinha nunca torna um assessment stale. Um assessment ausente ou stale de um componente declarado por uma spec em andamento aparece como obrigação consultiva de `evidence` em `state --attention`; não bloqueia nada.\n - `followups --candidates [--json]` (spec `pose-followup-reconciliation-candidates`) — lista follow-ups abertos com um motivo de reconciliação: `target-terminal` (uma spec citada pelo follow-up está done, superseded ou abandoned), `evidence-present` (um teste citado agora existe), `overdue` (a data de revisão passou), além de clusters lexicais de quase-duplicatas. Cada candidato mostra sua evidência e seus limites; nada recebe disposição, similaridade nunca vira `duplicate` sem julgamento, e um follow-up aberto nunca sai do Attention sem uma disposição escrita na spec. O Attention mostra o mesmo motivo no item de dívida residual.\n - `action list --present [--actor <id|papel>] [--json]` (spec `pose-action-request-presentation`) — agrupa as solicitações que ainda esperam resposta para uma única conversa: por origem e primeira fase restringida, as que restringem start ou execution primeiro (`interrupt`), as que restringem só a release marcadas como capazes de esperar. Cada solicitação mantém seu id, digest, revisão e resposta, e mostra exatamente o conteúdo ao qual a resolução se vincula; solicitações satisfeitas não são perguntadas de novo. MCP: `pose_action_requests` com `present: true`. Decidir quando interromper uma pessoa fica com o consumidor (Harne8).\n - Superfície progressiva de spec (spec `pose-progressive-spec-surface`) — `pose new-spec <slug> --surface minimal|standard|full` registra `surface:` no frontmatter. Uma spec `minimal` mantém Intent, Requirements, o Technical Plan com Artifacts, Validation com o requirement trace e o Final Report com os follow-ups; remove a seção Tasks (local do planner) e as subseções do relatório que `pose specs facts <slug> [--json]` deriva do índice de entrega (paths dos commits atribuídos, checks que produziram evidência no escopo). `lint-spec` deixa de exigir Tasks numa spec mínima e não relaxa mais nada: os gates de trace, follow-ups e amendments continuam iguais. Os fatos nunca incluem intenção, rationale ou risco aceito. Vínculo de evidência (spec `pose-spec-facts-evidence-binding`): `specs facts` separa `checks` (resultados cujo scope provenance nomeia a spec, com a base e se rodaram contra o head dos change sets da spec) de `candidates` (resultados que o índice guarda e que nada liga à spec: módulo declarado ou `components` vazio não é provenance); candidatos são impressos como `CANDIDATE, not evidence of this spec`. `freshness` informa `fresh`, `stale` (um input mudou depois da publicação do índice), `unknown` (nunca publicado como conjunto) ou `unavailable`, e uma limitação manda rodar `pose index` quando não dá para estabelecer; ler os facts nunca reconstrói o índice nem conclui que um requisito está satisfeito.\n - **Refresh automático de project-state** (spec `pose-project-state-refresh-contract`) — um registro interno de hooks pós-evento dispara um `pose state refresh` **parcial** (apenas as seções que o evento afeta) nos pontos que o POSE já intercepta: um `pose lint-spec <slug> --strict` bem-sucedido numa spec `status: done` (`spec_closeout` → Specs & Roadmaps, Follow-ups, Validação & Evidência), `pose amend` (`spec_amend` → Specs & Roadmaps, Decisões & Conhecimento), `pose reconcile-evidence record` (`evidence_reconciled` → Validação & Evidência) e `pose assess snapshot` (`assessment_snapshot` → Capabilities). Quando o evento carrega um commit e `POSE_GRAPHFORGE_MCP_URL` está configurado, o consumidor chama `components_hit` (spec `graphforge-components-hit-contract`) do baseline do estado até o commit do evento e anexa os componentes atingidos à seção Arquitetura (refresh **dirigido**); sem GraphForge configurado, o refresh permanece completo/não dirigido — zero acoplamento de build. Sem daemon e sem watcher de filesystem: é uma chamada síncrona no ponto exato em que cada evento já acontece. **Best-effort por padrão**: um refresh que falha nunca bloqueia o comando que disparou o evento — em vez disso marca `refresh_pending: <event>` no frontmatter do estado (limpo pelo próximo refresh bem-sucedido, qualquer que seja o gatilho). O modo estrito é opt-in por política (`strict_refresh: true`) — ali, uma falha de refresh falha o comando disparador. Toda execução (disparada ou manual) é registrada no log append-only do próprio artefato (apenas metadados: gatilho, alvo, resultado `ok|failed|skipped`, duração, hashes das seções alteradas — nunca conteúdo). Chave de dedup `hash(event+target+commit)`: o mesmo evento processado duas vezes (retry/replay) não repete o refresh, resultado `skipped`; refreshes `manual`/`ci` nunca são deduplicados entre si (uma chamada explícita sempre roda). `release_cut` está registrado no mapa evento→seções mas não tem produtor dentro do pose-mcp hoje — cortar um release pertence ao Conductor (serviço separado); o gatilho está pronto para quando essa integração existir.\n - **Gatilhos de reavaliação de capability** (spec `pose-capability-assessment-triggers`, mesmo registro de hooks do refresh automático acima) — o consumidor `assessment-staleness`, registrado em `spec_closeout`, resolve quais componentes um closeout alcançou (via `components_hit` quando `POSE_GRAPHFORGE_MCP_URL` está configurado; fallback: interseção dos arquivos tocados pelo evento com os globs `paths:` declarados manualmente por mecanismo no assessment) e marca como stale todo mecanismo de capability afetado — nunca mutando um score, apenas registrando `since`/`trigger`/`hits` e projetando uma demanda cobrável (origem `assessment-trigger`) em `pose followups --open`, sem armazenamento duplicado. `pose assess snapshot` limpa as marcas dos mecanismos que reavalia e registra o vínculo marca→snapshot no histórico. Sob demanda: `pose assess stale [--json]` lista marcas pendentes; `pose assess request --mechanism <id> [--reason <text>]` cria uma manualmente (o mesmo caminho que uma ação de UI \"sinalizar para reavaliação\" chamaria via MCP). Ferramenta MCP: `pose_capability_stale`. Sem GraphForge e sem `paths:` declarado, o evento registra `capability_mapping_unavailable` no log de refresh — sinal visível, nada marcado em silêncio. O limiar antirruído (`min_hits`, `level` de hit `direct`/`any`, owner/SLA default da demanda) é configurável, compartilhando o mesmo arquivo de política já usado para staleness por idade/commits (opcional; ausente significa estes mesmos defaults conservadores).\n - **Governança de docs** (spec `pose-docs-governance-contract`) — contrato opt-in por projeto para documentação, mesma mecânica do assessment de capability acima: ausente, todo projeto segue válido em todo lugar. `pose docs-init [--profile library|service|cli|monorepo]` cria um manifesto declarando as raízes governadas de documentação e, por doc, `path`/`doc_type` (Diátaxis `tutorial`/`howto`/`reference`/`explanation`, ou valor customizado)/`topics`/`owns`/`applies_to`/opcionalmente `review_after`. `pose docs-check [--json] [--explain <rule>]` roda sete regras determinísticas e offline — doc declarado ausente do disco, arquivo presente mas não declarado, frontmatter mínimo faltando (`title`/`doc_type`), link relativo quebrado, referência tipada quebrada (`spec:`/`adr:`/`knowledge:`/`doc:`/...), staleness (data de review da própria entrada, ou a janela default do manifesto contada a partir do último commit que a tocou) e uma varredura de segurança reusando a mesma checagem determinística de instrução insegura/forma de segredo que as skills já rodam — cada uma com severidade configurável (`error`/`warning`/`off`). `pose check --strict` incorpora o `docs-check` quando o manifesto existe (opt-in por presença); apenas erros bloqueiam, avisos aparecem sem bloquear. `pose docs-sync` sincroniza metadados de governança. Ferramenta MCP: `pose_docs_state`. O project-state ganha uma seção Docs aditiva (presença/perfil/raízes do manifesto, contagens de declarados/não declarados/stale/erro/aviso).\n - **Gatilhos de review pendente de docs** (spec `pose-docs-assessment-followups`, terceiro consumidor do mesmo registro de hooks das duas entradas acima — reusado sem modificação) — um consumidor `docs-review`, registrado em `spec_closeout`, resolve quais componentes/arquivos um closeout alcançou (`components_hit` quando configurado, casado contra entradas `owns:` declaradas como `component:<id>`; caso contrário, os arquivos tocados pelo evento casados contra os paths/globs `owns:` de cada doc, onde um diretório como `\"site\"` cobre todo arquivo abaixo dele) e marca como review-pending todo doc cuja área declarada foi alcançada — nunca editando o doc, nunca tocando um score. As marcas se acumulam num log append-only fora do arquivo do próprio doc e projetam uma demanda sintética e com dono em `pose followups --open` (origem `docs:<caminho-do-doc>`), reusando o campo `owner` da própria entrada do manifesto quando declarado. `pose docs-review resolve <doc> [--no-change --reason <text>] [--commit <sha>]` fecha de uma vez todas as marcas pendentes num doc, registrando `updated` (default, captura o commit atual) ou `no_change_needed` (motivo obrigatório); `pose docs-review request <doc>`/`--all-stale` cobrem o caminho sob demanda — o segundo transforma todo doc atualmente stale em demanda ativa numa chamada. A saída do próprio `docs-check` e o `pose_docs_state` listam aditivamente o que segue pendente. Sem mapa de componentes e sem `owns:` declarado, o evento registra um sinal visível em vez de marcar algo em silêncio — aqui o fallback por path é o caminho de força total do mecanismo (`owns:` é expresso como paths por padrão), não um caminho menor. O limiar antirruído (`min_hits`, `level` de hit, owner/SLA default) é configurável, compartilhando o mesmo formato de política dos gatilhos de capability em arquivo próprio (opcional; ausente significa estes mesmos defaults conservadores).\n - `history-check` — verifica que todo `.jsonl` em `reports/history/` está sob versionamento git. Sem isso, `recurrence-check` e `stats` divergem entre máquinas. Strict bloqueia; tolerant avisa.\n - `suggest` — lê [`task-map.json`](.pose/indexes/task-map.json) e imprime a trilha canônica (workflow + skill + rules + spec/ADR + knowledge) para um tipo de tarefa. Sem argumentos, lista todos os tipos. `--domain <d>` aplica rules adicionais por domínio (frontend, backend-go, k8s); `--path <p>` infere o domínio por heurísticas e via [`repo-map.json`](.pose/indexes/repo-map.json) (`language` → frontend/backend-go); `--json` para consumo por agentes. Domínios (spec `pose-distributed-instructions-parity`): `--domain` e o domínio inferido de `--path` passam por uma taxonomia (`go`/`golang`/`backend-go` → `backend-go`; `react`/`frontend-react`/`frontend` → `frontend`; `kubernetes`/`helm`/`k8s` → `k8s`), o JSON expõe `domain_input` e `domain_source: alias`, e um domínio sem regras no task-map é reportado (`domain_status`) em vez de tomar emprestado o de outro; um módulo `backend` só é o domínio Go quando sua linguagem é Go. `rules_status` (e a saída humana) diz de cada regra se está `installed` (com o path), `extension-needed` (com `pose extension install <id>`) ou `unavailable`; suggest não anuncia arquivo de regra que não está no disco e não instala nada.\n - `stats` — agrega outcomes do history JSONL por workflow, task ou context. Habilita decisões objetivas (promover check de optional → required, identificar workflows instáveis, comparar ci vs manual). `--since-days N` filtra a janela; `--json` para consumo por máquina.\n - `stats governance` — projeção read-only schema 2 sobre histórico de reports, bundles de review selados, atestações e declarações explícitas de remediação. Mantém preparação, julgamento, intervenção, frescor, telemetria, proveniência e cobertura independentes, nunca emite score de qualidade e explicita dados ausentes ou inválidos. `--report-type` filtra tentativas de validação; `--band` filtra reviews e vínculos de findings. A identidade de replay é `(report_type, task_slug, sequence)`; linhas sem identidade permanecem visíveis na cobertura. MCP `pose_governance_stats` aceita os mesmos seletores e exige `project_id` para escolher uma raiz federada. Vínculos explícitos incluem apenas IDs opacos, slugs, categoria e banda de origem, limitados a 100 linhas com truncamento indicado.\n - `stats governance --waits --rework` (spec `pose-governance-wait-rework-observability`) — duas dimensões a mais ao lado dos resultados, nunca somadas num score. Com `--waits` ou `--rework`, só as dimensões pedidas são calculadas; `--outcomes` acrescenta os resultados, que leem todo o histórico. `--waits` cronometra as action requests e mantém três medidas separadas: a idade de cada solicitação, o intervalo atribuído à espera por um ator ou sistema externo, e `known_blocking_seconds`, a união por spec dos intervalos em que uma solicitação restringiu a execução da spec inteira (solicitações simultâneas contam uma vez). Nenhuma delas é inatividade; timestamps ausentes contam como desconhecidos. `--rework` classifica bundles selados substituídos pelo que mudou (sujeito, intenção ou plano, plano de review, evidência, ou desconhecido) e atestações extras num bundle por divergência de review ou atestação anterior inválida contra a política atual, deixando outras causas como desconhecidas. `scripts/bench-governance.sh [runs] [pose-binary]` cronometra `state --attention`, `check --strict` e `index` na mesma revisão e reporta tempo e tamanho do índice separadamente, com a revisão do corpus e a versão do motor.\n - Validade de premissas (spec `pose-assumption-validity-scope`) — uma `Premissa A<N>` material pode declarar `Escopo de validade:` (o contexto em que vale) e entradas `Gatilho de obsolescência:` `<kind>:<value>@<pin>`, onde kind é `doc`, `report`, `knowledge`, `adr` ou `snapshot` e o pin é um prefixo (8+ hex) do sha256 do conteúdo contra o qual a premissa foi julgada. `lint-spec --design-check` reporta um gatilho sem pin com o pin a acrescentar, um ilegível como desconhecido, e um gatilho de calendário (`date:`, `ttl:`, …) como não avaliado: validade é por contexto, não por expiração, e premissas triviais não precisam de nenhum campo. Quando o conteúdo fixado muda, a projeção de obrigações (produtor `premises`) emite uma obrigação de julgamento `premise-stale` para specs draft e in-progress, advisory no review e com escopo na premissa e nas decisões baseadas nela. A evidência registrada permanece; é descrita como julgada contra o conteúdo fixado e não válida para o atual, e nada é invalidado automaticamente. Contratos de provedores ou remotos não são monitorados pelo core. O estado do gatilho é só projeção e nunca muda o digest do design.\n - Observação de falsificador (spec `pose-falsifier-reconsideration`) — uma `Decisão D<N>` material pode acrescentar `Efeito esperado:` e `Verificação do falsificador: check:<module>/<check>`, nomeando o check de validação indexado cuja falha a contradiz. Quando o índice de entrega contém um resultado `fail` desse check, a projeção de obrigações (produtor `falsifiers`) emite uma obrigação de julgamento `falsifier-observed`, advisory no review e com escopo na decisão, para qualquer spec que não esteja superseded ou abandoned (decisões continuam valendo depois de done). O motor não infere causa nem julga arquitetura: a falha é uma observação, a decisão e seu rationale nunca são editados, e uma pessoa registra por que ela ainda vale ou abre uma decisão substituta. Um resultado aprovado ou ausente não gera nada. `lint-spec --design-check` avisa sobre referência malformada e sobre verificação de falsificador sem falsificador declarado.\n - `migrate v7 --dry-run [--json]` (spec `pose-v7-legacy-cleanup-plan`) — inventário somente leitura do que uma futura major converteria, manteria ou recusaria: layouts de spec, specs `blocked`, chaves legadas e desconhecidas da política de review, bundles selados, atestações por modo de identidade e atribuição, e transferências incompletas do lado deste projeto, cada um com sua ação e critério de remoção. Não escreve nada. Bundles selados, atestações e assinaturas nunca são reescritos. `--apply` é recusado com o fato atual: não há apply neste motor, o único modo é `--dry-run`, que não escreve nada; nenhum apply futuro é prometido.\n - `assess design --spec <slug>` — projeção read-only e bounded sobre o subject canônico selado de review. Observa deltas de dependência, componente, metadata de delivery, contratos de governança e contratos públicos, mantém coverage unknown/unsupported explícita e nunca calcula score de complexidade ou arquitetura. O equivalente MCP é `pose_design_delta`.\n - `usage` — agrega automaticamente eventos locais e por projeto de uso da CLI e do MCP: chamadas, outcomes de execução/semântica, latência, findings observados e ciclo de vida estável (`unique`, `new`, `resolved`, `reopened`). Agentes nunca mantêm contadores. Os eventos são best-effort, somente locais e ficam fora da árvore versionada; argumentos, saída, paths, identidade de projeto/usuário e IDs crus de findings nunca são persistidos. `--since-days 0` inclui todo o histórico; filtre com `--tool` ou `--surface`; equivalente MCP: `pose_usage`. É evidência de uso do produto, não outcome DORA nem score individual de produtividade.\n - `record-deployment` / `record-incident` / `dora-metrics` / `adoption-metrics` — ingerem eventos de entrega schema v2 sem identidade individual e calculam métricas para um ambiente de produção explícito (`--environment`, padrão `production`). Deployments exigem `--deployment-kind planned|rework`; incidentes exigem ambiente; recovery inclui apenas incidentes resolvidos com `--caused-by-deployment`. `adoption-metrics` agrega taxas de especificações, roadmaps e validação de ciclo de vida.\n - `stacks [--path dir] [--json]` — inspeção de catálogo read-only e offline (spec pose-stack-catalog-expansion). Casa entradas de diretório contra o catálogo mantido de perfis (Node.js, Go, Rust, Java, **Python** — poetry/pipenv/pip/setuptools/pep517 — e **.NET**), reportando por perfil: manager, marker, `winner`/`shadowed` (múltiplos managers presentes resolvem por prioridade declarada), `confidence` (`medium` sob conflito) e se a ferramenta nativa pré-requisito está no `PATH` — via `exec.LookPath`, nunca executando um arquivo do projeto. Markers detectados alimentam `discoverValidationModules`/`pose init --wizard` do mesmo jeito que Node/Go/Rust/Java já fazem; os checks propriamente ditos rodam pelas stacks `python`/`dotnet` da [`validation-matrix.json`](.pose/indexes/validation-matrix.json). A prioridade de manager Python é expressa com `when.fileNotExistsAny` (pular quando existir qualquer lockfile/marker de prioridade maior) ao lado dos predicados `fileExists`/`fileNotExists` já existentes.\n-- `assess discover|integrate|tech-debt|stale|request|snapshot` — motores nativos de assessment para LOC, marcadores de débito técnico, estruturas de componentes, checagens de integridade de contrato entre módulos e ciclo de vida de reavaliação de capabilities.\n+- `assess discover|integrate|tech-debt|stale|request|snapshot` — motores nativos de assessment para LOC, marcadores de débito técnico, estruturas de componentes, checagens de integridade de contrato entre módulos e ciclo de vida de reavaliação de capabilities. `discover`, `integrate` e `tech-debt` aceitam `--no-persist` para imprimir o resultado sem gravar `.pose/assessments/` nem `.pose/state/`; no checkout selado de uma review delegada (`POSE_SEALED_CHECKOUT`) eles nunca gravam, `init`, `snapshot` e `request` recusam, e o plano de review os roda com `--no-persist`, para que um revisor que roda um assessment planejado não derrube o próprio run.\n - `doctor [--fix]` — diagnósticos de ambiente, dependências, runtime nativo e saúde da instância POSE, além de governança que só falharia mais adiante: `review.evidence-vocabulary` (um profile selecionado exige uma classe que nenhum check pode emitir), `validate.class-producers` (um critério aceita apenas classes que nenhum check registrado produz), `validate.evidence-class-coverage` (checks sem `evidenceClass`), `review.profile-schema`, `review.contract-adoption`, `review.scope-change-set` e `<policy>.policy-keys` para nove políticas (chaves que o motor não lê, ou seja, uma configuração com erro de digitação que silenciosamente não faz nada).\n - `knowledge-housekeeping` / `reports-housekeeping` / `events-housekeeping` — manutenção idempotente (listar/arquivar/expurgar). Mutações exigem `--apply`. O housekeeping de reports **nunca toca em `history/`**: o JSONL é a fonte de verdade para `recurrence-check` e comparações temporais de `report`. Defaults: stale = 120d, purga de arquivo = 365d.\n - `amend` — histórico append-only de emendas da spec (`amendments.jsonl` ao lado do `spec.md` de uma spec em pasta, ou `YYYY-MM-DD-<slug>.amendments.jsonl` ao lado de uma spec flat datada; a spec é resolvida pelo store, então os dois layouts recebem emendas do mesmo modo). `--baseline` fotografa o hash de cada R-ID; `--ids R2 --change added|withdrawn|semantic|editorial --rationale <text> --author @alias [--reviewer @alias]` reconhece uma mudança material; `--list` renderiza o histórico e os reconhecimentos pendentes. Em specs `done` com histórico, o `lint-spec` rejeita todo requisito cujo texto atual não esteja reconhecido por um evento — specs não podem ser reescritas em silêncio depois da evidência. `--nodes [--json]` mostra a projeção versionada de contract nodes: requisitos, premissas e decisões com namespace, hash de conteúdo, estado e relações. Com `contract_nodes_version: 1` adotado na policy de review, `--baseline` grava um snapshot R/A/D schema 2, `--ids` aceita A/D, `--change transition` reconhece uma mudança de estado permitida, `editorial` é recusado quando o nó mudou estado ou relações, e o gate também rejeita decisão ativa apoiada em premissa invalidada ou retirada. Sem a capability o gate segue só com requisitos e um evento schema 2 é recusado; logs schema 1 mantêm o significado.\n - `start` — início atômico de uma spec draft, registrado num start record por spec. Sem flags é um preview somente leitura vinculado a digest: readiness e dependências, as obrigações de review declaradas (sem exigir structural delta futuro) e a baseline R/A/D. `--apply --digest <sha256>` grava essa baseline e move a spec de `draft` para `in-progress` com lock por spec e compare-and-swap; exige `atomic_start_version: 1` na policy de review, repete de forma idempotente, retoma uma execução interrompida e recusa outro plano para spec já iniciada. `--cancel` desfaz um start que não moveu a spec. A trava por spec registra seu dono (host, digests dos IDs de máquina e de boot, namespace de PID, PID e início do processo); uma trava de outra chamada é informada, nunca quebrada pela idade, como `owner-active`, `owner-unknown` ou `owner-dead` (spec `pose-journal-checkpoint-and-lock-recovery`). Morte só é provada na mesma máquina Linux — outro boot, ou um PID que não roda ou agora é de outro processo — e `--recover-lock <digest do dono>`, com o digest que `--status` mostra, remove essa trava só se os bytes e o dono morto não mudaram, deixando o start record para retomar; um dono desconhecido (outro host, a trava vazia de um motor anterior, outra plataforma) é verificado e removido por uma pessoa. A mesma trava é a trava de ciclo de vida da spec: close e transfer também a tomam, então dois deles nunca se intercalam numa spec (spec `pose-writer-coordination-and-atomic-publication`). `--status` classifica cada nó como `recorded-before-managed-execution`, `introduced-during-execution` ou `legacy-unbaselined`, recalcula as obrigações e, com a capability, pede reconciliação quando status ou baseline registrada foram editados à mão. `atomic_start_adopted_at: YYYY-MM-DD` (spec `pose-atomic-start-adoption-cutoff`) limita a capability às specs criadas a partir dessa data: uma spec mais antiga em andamento sem start aparece como `legacy-unbaselined` com uma nota e não bloqueia nada; sem a data, toda spec assim exige reconciliação. Um start registra precedência observável, não quando algo foi decidido; o MCP expõe a visão somente leitura como `pose_start_status`.\n - `knowledge-usage` — projeta as citações `knowledge:<slug>` das specs por artefato (dono, expiração, specs citantes). Sinais de uso informam a review do dono; o TTL nunca é estendido automaticamente. Refs `knowledge:` órfãs falham no `knowledge-check`.\n - `knowledge-suggest <query>` / `semantic-suggest <query>` / `suggest-feedback` / `portfolio-projection` / `reconcile-evidence` — ranqueamento léxico determinístico e projeções consultivas para conhecimento, agrupamento de feedback, marcos de portfólio multi-roadmap e reconciliação de evidências de validação. Sugestões nunca bloqueiam nem se autoaplicam sem confirmação.\n - `hooks` — gerencia symlinks do binário nativo em `.git/hooks/`. O nome de invocação seleciona `check --tolerant` para `pre-commit` e `index` para `post-merge`; `install --force` preserva backup de hooks preexistentes. Uma instância que roda o POSE pelo próprio CLI vinculado a uma revisão declara um executor num arquivo `hooks.json` de `.pose/policy/` (`{\"schema_version\":1,\"runner\":\"<executável relativo ao projeto>\"}`): o hook passa a rodar o executor com o nome do hook e devolve o código de saída dele, e `hooks status` o nomeia; um executor fora do projeto, não executável ou com outro schema é recusado e nada roda.\n - `version` — exibe versão compilada do binário Go, SHA do commit e compara a versão do schema do repositório com os requisitos do motor.\n - `context` — resolve um projeto lógico selecionado e uma tarefa opcional, local ou qualificada por `xref:`, pelo resolvedor compartilhado de artefatos. O resultado JSON traz a autoridade canônica, as revisões do projeto e do artefato, o estado de resolução, os contratos suportados e um `context_revision`; nunca inclui roots do filesystem. Use esse token para detectar checkout ou revisão alterados antes de uma escrita entre projetos.\n - Escritas CLI entre projetos exigem o destino em `POSE_PROJECT_ROOTS` e o `context_revision` de uma chamada recente de `pose context`. Use `new-spec-qualified` para criação qualificada, de modo que motores antigos recusem o próprio comando. Um projeto encontrado apenas por varredura de `HARNE8_PROJECTS_DIR` pode ser lido, mas não concede acesso de escrita. Specs canônicas existentes são reutilizadas; redirecionamentos e transferências incompletas bloqueiam a criação de uma cópia.\n - `install <dir> [--locale tag] [--skip-mcp] [--force] [--no-backup] [--allow-non-git]` — instala o runtime, regras, workflows, templates e documentação embutidos do POSE em um diretório de destino sem clonar, grava no `adopted_at` da política de changelog o dia em que a instância a recebeu e roda o gate estrito.\n - `import <spec-kit|openspec> <path> [--dry-run]` — importa especificações externas para o formato canônico do POSE com frontmatter e 7 seções padronizadas.\n - `serve-mcp` — inicia o servidor POSE Model Context Protocol via stdio (`--stdio`) ou HTTP para integração com agentes de IA. O servidor stdio encerra com SIGTERM; ele resolve o CLI `pose` que executa uma única vez, ao iniciar, então um servidor iniciado antes de um `pose update` continua funcionando com o binário atualizado.\n - `report-limitation` — registra limitação, defeito ou sugestão de melhoria do motor em `.pose/feedback/` com opção de submissão (`--submit`).\n - `contribute <enable|disable|status|stage|list>` — modo contribuidor open-source; registra relatórios sanitizados sob `.pose/contributions/` sem vazar código privado; a submissão permanece a critério do desenvolvedor.\n - `release` / `release-notes` — ciclo de vida governado de releases (`plan`, `prepare`, `check`, `notes`, `record`, `status`, `open-next`, `backfill`) garantindo notas de release imutáveis, congelamento de manifesto, importação de evidências de provedor e verificação reproduzível. Uma release que introduz um contrato de governança traz uma seção **Compatibility** no topo das notas, gerada a partir do registro de contratos. `release-notes` fornece alias de compatibilidade para visualização de notas congeladas. A versão com que o corte é comparado vem de `version_source` em `.pose/policy/release.json` (`{\"path\": \"VERSION\", \"kind\": \"text\"}`, ou `\"kind\": \"json\"` com `key`): um arquivo do projeto com `X.Y.Z`, com `v` e sufixo `-dev` opcionais. Só o repositório do motor pode omiti-lo; todo outro projeto precisa declarar um. Integridade de manifest e tag (spec `pose-release-manifest-tag-integrity`): o manifest é lido por um contrato estrito (`schema_version` suportado, sem campos desconhecidos, versão e paths limpos) que recompõe `specs`, `categories`, `breaking` e `release_input_digest` a partir dos fragments que congela, de modo que uma projeção adulterada é recusada em vez de normalizada. `check` e `status` verificam uma tag pela sua própria árvore: a tag (leve ou anotada) é resolvida até o commit, e manifest, notas, fragments congelados e fonte de versão são lidos como blobs desse commit, nunca do worktree. Uma tag cuja árvore não tem manifest é recusada qualquer que seja o worktree; um commit posterior, evidência do provider ou o próximo ciclo não tornam obsoleto um cut correto; uma fonte de versão que não pode ser recomputada a partir do manifest é reportada como limite.\n \n   **Cursores de consulta:** as tools MCP de listagem paginadas (`pose_list_specs`, `pose_list_roadmaps`, `pose_list_knowledge`, `pose_list_reports`, `pose_capability_history`) continuam uma consulta sobre a coleção para a qual o cursor foi emitido. O cursor é assinado, expira em 15 minutos e está ligado à tool, ao projeto, aos filtros e à coleção ordenada com a geração do índice; coleção alterada, outra consulta, token expirado, token versão 1 ou reinício do servidor são recusados com um código `cursor-*` e quem chama recomeça da primeira página, sem nunca continuar sobre uma coleção alterada. Uma página tem no máximo 500 itens, divulga `generation`, `collection` e `total`, e a ausência de `next_cursor` não certifica nada além dessa coleção (spec `pose-generation-bound-query-cursors`).\n \n ### Contrato de conexão MCP\n@@ -1051,27 +1051,29 @@ Declare executor e baseline de implementação antes do dispatch. Um bundle que\n \n ```json\n {\n   \"schema_version\": 1,\n   \"provenance\": {\n     \"trust\": \"executor-attested\",\n     \"implementation\": {\"principal\": \"agent:implementer\", \"execution\": \"implementation-run-1\", \"vendor\": \"vendor-a\", \"model\": \"model-a\"}\n   },\n   \"adapters\": {\n     \"reviewer\": {\"executor\": \"agent:reviewer\", \"command\": [\"reviewer\", \"--output\", \"{output}\"], \"vendor\": \"vendor-b\", \"model\": \"model-b\"}\n   }\n }\n ```\n \n Reutilize o issuer nativo e seu pin de atestações. Configure `authority_project` e `authority_audience` protegidos na policy de review; a identidade declarada do projeto deve concordar. Mantenha chaves fora do projeto. O dispatch captura origem/worktree, bundle/commit/scope/kind, configuração/argv/executável, identidades, template/body/notas do brief, stdin planejado e bytes escritos no pipe, digests de saída/transcript brutos e retidos com redação, além de completude. Escrever no pipe não prova que o fornecedor consumiu o prompt. Sessões e chaves privadas ficam fora da prova pública.\n \n Visualize `pose review run-sign <run-id> --issuer <nome> [--ttl <duração>]` e acrescente `--apply` para publicar uma prova imutável em `.pose/review-run-proofs/`. TTL é opcional (sem expiração quando ausente), positivo quando informado e limitado a 365 dias. Verifique com `pose review run-proof <run-id> <proof-id> [--json]`. A prova assina a declaração capturada do executor; não é recibo independente do fornecedor nem confirmação humana. Auditorias failed/interrupted mostram seu estado e `complete_review=false`. Decisão desconhecida ou ambígua também mantém a flag falsa. A flag verdadeira descreve entrega concluída com uma decisão de draft, não aprovação nem validação completa da conclusão tipada. Run completed com stdin incompleto ou saída truncada não estabelece review concluído. Runs legados sem proveniência capturada não são promovidos assinando a configuração atual. `pose review run-proof` e as buscas do emissor dos leitores de veredito fazem a pergunta que o fechamento faz: para uma run cujo escopo está done, a prova como foi dada (o registro se sustenta, o emissor mantém o pin; a deriva rotineira do repositório e a expiração da prova não são perguntadas, porque a expiração limita quando uma prova pode amparar uma nova atestação, não se uma atestação já dada a um escopo done se mantém); para um escopo aberto, como o repositório está agora.\n \n Acrescente `--run <run-id> --run-proof <proof-id> --sign <issuer>` a uma solicitação completa de `pose review attest`. O issuer deriva do run os vínculos de principal/execução e assina a referência exata. Critérios, tools, evidências e preflight continuam obrigatórios. Draft negativo ou ambíguo não apoia aprovação; a atestação não pode anteceder o término do run ou sua prova assinada. Provas de adjudication/smoke vinculam seus kinds e não servem como atestações de review. Validar/aplicar automaticamente conclusões completas e tipadas pertence à capability, não à assinatura do run.\n \n-**Conclusões de reviews delegadas.** `pose review conclude <run> [--issuer <nome>] [--apply] [--json]` registra a conclusão de um run de review concluído: a mensagem final do run traz a conclusão tipada no bloco pose-draft — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` como `<classe>:<ref>`, `rationale` e, quando o plano pede mapeamentos estruturais, `mappings`) e `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), que o brief do template `review-brief/7` (o texto que uma versão de template renderiza é congelado por um digest de referência, então mudá-lo exige uma nova versão) pede e para o qual declara as regras que o motor confere antes de registrar (um critério de julgamento aprovado traz uma justificativa, sua evidência é uma ref que o bundle selou, um critério com finding nomeia um finding do draft, fatos estruturais são respondidos como `mappings`; um draft que quebra uma delas é recusado inteiro; uma rodada depois da primeira também nomeia os findings pelos quais responde com os identificadores que o brief lista, com a rodada, nunca um F1 solto) — e o motor assina a prova do run e a atestação com o issuer nativo, `--issuer` ou `conclusions.issuer` em `.pose/policy/delegation.json` (a chave fica fora do projeto), e a registra pelo mesmo writer de domínio e preflight de `pose review attest --run --run-proof --sign`. Um finding de follow-up com `action`, `owner` e `review_by` vira um risco aceito quando sua severidade é uma que a política de review selada aceita (low por padrão); qualquer outro finding fica aberto. Uma conclusão que rejeita também é registrada e bloqueia o escopo até o bundle mudar. Um run que não é uma review concluída, foi substituído, não capturou proveniência, tem limpeza ou registro incompletos, não traz draft válido para sua rodada, ou cujo bundle não governa mais, não registra atestação: seu registro de conclusão, no diretório `review-conclusions` de `.pose`, guarda os motivos. Um run conclui uma vez: um lock que o sistema libera quando o processo termina é mantido da primeira leitura à última escrita, concluí-lo de novo devolve seu registro, e uma reserva deixada por uma conclusão interrompida só é completada pela atestação que ela registrou se essa atestação verificar como a conclusão do run; caso contrário o run é concluído no lugar dela. Quem quer que a assine, uma atestação de um run com brief `review-brief/3` a `/7` declara a conclusão daquele run: critérios, ferramentas ou findings que o draft não declarou são recusados. Com `delegated_review: true` na policy de review e `conclusions.issuer` definido, `pose delegate review` registra a conclusão no momento em que o run termina; caso contrário nada é automático. Um run de adjudicação ou de smoke conclui do mesmo jeito, sob os mesmos checks, lock e recusas, e nunca como aprovação. O brief do template `adjudication-brief/2` lista as questões que a spec do escopo registra — cada decisão `D<n>` e requisito `R<n>` — e o bloco pose-draft responde cada uma em `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); o veredito é registrado como registro de adjudicação da spec no diretório `adjudications` de `.pose`, e o `lint-spec` reprova, e o `close` recusa, uma questão que a adjudicação do bundle atual diz não se sustentar e avisa sobre uma que ela não pôde determinar ou sobre um registro que não verifica. O brief do template `smoke-brief/2` pede `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), uma por delivery target; as observações são registradas como resultados de validação da classe de evidência `smoke`, um check obrigatório por alvo que passa quando foi observado e é evidência só daquele alvo daquela spec, com head, data e proveniência tirados do run e do índice atual, no diretório `results/smoke` de `.pose`, que o `surface-check` lê ao lado do results path, de modo que um delivery profile pode exigir `smoke`. Um veredito que não responde exatamente o que seu brief pediu não registra nada; todo registro é verificado na leitura — a prova do run verifica e ele é o que o draft do run conclui — e um que não verifica não produz nada. Runs com brief `adjudication-brief/1` e `smoke-brief/1` continuam verificando com o próprio template.\n+**Conclusões de reviews delegadas.** `pose review conclude <run> [--issuer <nome>] [--apply] [--json]` registra a conclusão de um run de review concluído: a mensagem final do run traz a conclusão tipada no bloco pose-draft — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` como `<classe>:<ref>`, `rationale` e, quando o plano pede mapeamentos estruturais, `mappings`) e `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), que o brief do template `review-brief/8` (o texto que uma versão de template renderiza é congelado por um digest de referência, então mudá-lo exige uma nova versão) pede e para o qual declara as regras que o motor confere antes de registrar (um critério de julgamento aprovado traz uma justificativa, sua evidência é uma ref que o bundle selou, um critério com finding nomeia um finding do draft, fatos estruturais são respondidos como `mappings`; um draft que quebra uma delas é recusado inteiro; uma rodada depois da primeira também nomeia os findings pelos quais responde com os identificadores que o brief lista, com a rodada, nunca um F1 solto) — e o motor assina a prova do run e a atestação com o issuer nativo, `--issuer` ou `conclusions.issuer` em `.pose/policy/delegation.json` (a chave fica fora do projeto), e a registra pelo mesmo writer de domínio e preflight de `pose review attest --run --run-proof --sign`. Um finding de follow-up com `action`, `owner` e `review_by` vira um risco aceito quando sua severidade é uma que a política de review selada aceita (low por padrão); qualquer outro finding fica aberto. Uma conclusão que rejeita também é registrada e bloqueia o escopo até o bundle mudar. Um run que não é uma review concluída, foi substituído, não capturou proveniência, tem limpeza ou registro incompletos, não traz draft válido para sua rodada, ou cujo bundle não governa mais, não registra atestação: seu registro de conclusão, no diretório `review-conclusions` de `.pose`, guarda os motivos. Um run conclui uma vez: um lock que o sistema libera quando o processo termina é mantido da primeira leitura à última escrita, concluí-lo de novo devolve seu registro, e uma reserva deixada por uma conclusão interrompida só é completada pela atestação que ela registrou se essa atestação verificar como a conclusão do run; caso contrário o run é concluído no lugar dela. Quem quer que a assine, uma atestação de um run com brief `review-brief/3` a `/8` declara a conclusão daquele run: critérios, ferramentas ou findings que o draft não declarou são recusados. Com `delegated_review: true` na policy de review e `conclusions.issuer` definido, `pose delegate review` registra a conclusão no momento em que o run termina; caso contrário nada é automático. Um run de adjudicação ou de smoke conclui do mesmo jeito, sob os mesmos checks, lock e recusas, e nunca como aprovação. O brief do template `adjudication-brief/2` lista as questões que a spec do escopo registra — cada decisão `D<n>` e requisito `R<n>` — e o bloco pose-draft responde cada uma em `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); o veredito é registrado como registro de adjudicação da spec no diretório `adjudications` de `.pose`, e o `lint-spec` reprova, e o `close` recusa, uma questão que a adjudicação do bundle atual diz não se sustentar e avisa sobre uma que ela não pôde determinar ou sobre um registro que não verifica. O brief do template `smoke-brief/2` pede `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), uma por delivery target; as observações são registradas como resultados de validação da classe de evidência `smoke`, um check obrigatório por alvo que passa quando foi observado e é evidência só daquele alvo daquela spec, com head, data e proveniência tirados do run e do índice atual, no diretório `results/smoke` de `.pose`, que o `surface-check` lê ao lado do results path, de modo que um delivery profile pode exigir `smoke`. Um veredito que não responde exatamente o que seu brief pediu não registra nada; todo registro é verificado na leitura — a prova do run verifica e ele é o que o draft do run conclui — e um que não verifica não produz nada. Runs com brief `adjudication-brief/1` e `smoke-brief/1` continuam verificando com o próprio template.\n+\n+**Prontidão da review antes da selagem.** Uma nova selagem de escopo de spec recusa o que `pose close` e a preflight da conclusão só recusariam depois de uma rodada completa de review: uma mudança em raiz de entrega sem declaração de entrega (`undeclared-delivery`) ou em caminho governado que os artefatos não declaram (`undeclared`), lidas do mesmo índice que `pose close` lê, e, quando um critério obrigatório pede mapeamentos estruturais, uma decisão ou premissa que não alcança requisito nem restrição (dê a ela uma linha `- Basis:`). Um bundle já selado é devolvido como estava. `pose review draft-check [<bundle-id|run-id>] --draft <arquivo|-> [--json]` relata todo motivo pelo qual a conclusão recusaria um rascunho (bloco ilegível, rodada não contabilizada, critério, mapeamento, achado, evidência ou ferramenta que a preflight da atestação recusa) e não grava nada; dentro de uma review delegada o run fornece o bundle e a rodada por `POSE_REVIEW_DRAFT_CONTEXT` e nomeia o próprio motor em `POSE_REVIEW_CLI`, e `-` lê o rascunho da entrada padrão, então funciona num sandbox somente leitura. O brief do template `review-brief/8` pede ao revisor que o rode antes de terminar. `pose delegate` nomeia um arquivo de nota grande demais com seu tamanho e o limite, e um run concluído que nada concluiu automaticamente imprime o comando `pose review conclude <run>` que o registra.\n \n **Requests de review delegada.** `pose review request <escopo|bundle> --kind delegated-review [--purpose review|adjudicate|smoke] [--agents <nome,...>] [--note-file <caminho>] [--apply]` abre uma action request de kind `delegated-review` que vincula o projeto, o worktree, o escopo, o bundle selado, o brief, as notas, as policies, os agentes aceitos e o destino da conclusão (uma atestação, um registro de adjudicação ou evidência de smoke). Nenhum ator a responde: `pose action fulfil <act-id> --run <run-id> --runner agent:<id> --idempotency-key <chave> --expected-revision <n> [--channel cli|ci|conductor] [--envelope <arquivo>] [--apply]`, ou a tool MCP `pose_action_fulfil`, submete um run concluído, e o motor registra o fulfillment só quando o run é do brief e do bundle do request, de um agente aceito, concluído com sua contenção, sua prova assinada verifica, seu ledger de tentativas está íntegro e o motor registrou sua conclusão no destino do request; o fulfillment é verificado de novo a cada leitura. `pose delegate review <escopo> --request <act-id>` roda o brief do request localmente e submete o run depois de concluído. Um run que rejeita cumpre o request sem aprovar nada; um bundle superado ou uma policy alterada o invalida, mesmo já cumprido, e ele é pedido de novo com `--supersedes <act-id>`, que o aposenta sob as regras de autoridade de supersession (`--authority <json>`, `--role <papel>`, `--requested-at` do preview) ou, quando o plano passa a reservar a review a uma pessoa, faz da escalação para a pessoa o seu sucessor; um retry com a mesma chave e o mesmo run não faz nada. Uma pessoa é chamada por exceção, como decision request ao papel maintainer: um plano que reserva a review a uma pessoa, um orçamento de tentativas esgotado, revisores em conflito e uma `business_decision` que um revisor levantou no draft. A prova de um run verifica em qualquer checkout do projeto: o worktree onde rodou fica registrado, não é exigido de quem lê, então um job de CI ou o Conductor cumpre o request com o mesmo envelope.\n \n Ative a barreira de verificação com `delegated_review: true` na policy de review somente ao preparar adoção. Essa barreira viva exige prova de run para review de agente different-actor e recusa prefixo isolado; ela não adiciona nem habilita a capability futura no catálogo. Instâncias não adotantes mantêm o comportamento declared. Com confiança executor-attested explícita, vendor OU modelo normalizado diferente satisfaz different-actor (vendor distinto preferido); baseline desconhecida e mesmo vendor/modelo recusam. Run de máquina nunca satisfaz mandatory-human. Adoção no catálogo, cutoffs/rollback e aplicação automática de conclusões continuam no escopo separado da capability.\n \n Leia a mesma assurance atual por verify, review-check, MCP e `pose state --attention`: `machine-attested` identifica a declaração assinada, sua fonte, run/proof e comparação de vendor/modelo. Pins atuais, projeto/audience/tempo, inputs selados, artefatos retidos e receipts originais/de continuação são revalidados. Revogação, receipt ausente, dados reescritos ou inputs stale retiram a assurance de máquina. Assinar não restaura quota nem apaga runs negativos anteriores. O worktree de origem fica registrado com o run, não é exigido de quem lê: uma prova verifica em qualquer checkout do projeto, então um run feito por um job de CI ou pelo Conductor é verificado como um local; não há alegação de contenção universal.\ndiff --git a/pose-mcp/internal/scaffold/dist/POSE.md b/pose-mcp/internal/scaffold/dist/POSE.md\nindex 115e5e3e..bef5c9d3 100644\n--- a/pose-mcp/internal/scaffold/dist/POSE.md\n+++ b/pose-mcp/internal/scaffold/dist/POSE.md\n@@ -403,41 +403,41 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - Assessment freshness (spec `pose-adaptive-assessment-freshness`) — a component assessment records its binding: the committed tree of the component, the engine version and the validation-matrix digest. `pose assess discover --if-stale [--component <dir>]` reuses an assessment whose binding is unchanged and refreshes it otherwise, printing `assess.freshness.<component>` with the reason (content changed, engine changed, matrix changed, uncommitted changes, or no binding on an older record). Age alone never stales an assessment. A missing or stale assessment of a component an in-progress spec declares appears as an advisory `evidence` obligation in `state --attention`; it gates nothing.\n - `followups --candidates [--json]` (spec `pose-followup-reconciliation-candidates`) — lists open follow-ups with a reconciliation reason: `target-terminal` (a spec the follow-up names is done, superseded or abandoned), `evidence-present` (a test it names now exists), `overdue` (its review date passed), plus lexical near-duplicate clusters. Each candidate shows its evidence and its limits; nothing is dispositioned, similarity never becomes `duplicate` without judgment, and an open follow-up never leaves Attention without a disposition written in its spec. Attention shows the same reason on the residual-debt item.\n - `action list --present [--actor <id|role>] [--json]` (spec `pose-action-request-presentation`) — groups the requests still waiting for an answer for one conversation: by origin and earliest restricted phase, the ones restricting start or execution first (`interrupt`), release-only ones marked as able to wait. Each request keeps its own id, request digest, revision and answer, and shows exactly the content a resolution binds to; satisfied requests are not asked again. MCP: `pose_action_requests` with `present: true`. Deciding when to interrupt a person is left to the consumer (Harne8).\n - Progressive spec surface (spec `pose-progressive-spec-surface`) — `pose new-spec <slug> --surface minimal|standard|full` records `surface:` in the frontmatter. A `minimal` spec keeps Intent, Requirements, the Technical Plan with its Artifacts, Validation with the requirement trace and the Final Report with its follow-ups; it drops the planner-local Tasks section and the report subsections that `pose specs facts <slug> [--json]` derives from the delivery index (paths of the attributed commits, checks that produced scoped evidence). `lint-spec` stops requiring Tasks for a minimal spec and relaxes nothing else: the trace, follow-up and amendment gates apply as before. The facts never include intent, rationale or accepted risk. Evidence binding (spec `pose-spec-facts-evidence-binding`): `specs facts` separates `checks` (results whose scope provenance names the spec, with their basis and whether they ran against the head of the spec's change sets) from `candidates` (results the index holds that nothing ties to the spec: a declared module or an empty `components` is not provenance); candidates are printed as `CANDIDATE, not evidence of this spec`. `freshness` reports `fresh`, `stale` (an input changed since the index was published), `unknown` (never published as a set) or `unavailable`, and a limitation says to run `pose index` when it cannot be established; reading the facts never rebuilds the index and never concludes that a requirement is satisfied.\n - **Automatic project-state refresh** (spec `pose-project-state-refresh-contract`) — an internal post-event hook registry fires a **partial** `pose state refresh` (only the sections an event affects) at the points POSE already intercepts: a successful `pose lint-spec <slug> --strict` on a `status: done` spec (`spec_closeout` → Specs & Roadmaps, Follow-ups, Validation & Evidence), `pose amend` (`spec_amend` → Specs & Roadmaps, Decisions & Knowledge), `pose reconcile-evidence record` (`evidence_reconciled` → Validation & Evidence) and `pose assess snapshot` (`assessment_snapshot` → Capabilities). When the event carries a commit and `POSE_GRAPHFORGE_MCP_URL` is configured, the consumer calls `components_hit` (spec `graphforge-components-hit-contract`) from the state's baseline to the event's commit and attaches the hit components to the Architecture section (**directed** refresh); without GraphForge configured, refresh stays full/undirected — zero build coupling. No daemon, no filesystem watcher: it is a synchronous call at the exact point each event already happens. **Best-effort by default**: a failed refresh never blocks the command that fired the event — it marks `refresh_pending: <event>` in the state frontmatter instead (cleared by the next successful refresh, regardless of trigger). Strict mode is opt-in via policy (`strict_refresh: true`) — there, a refresh failure fails the triggering command. Every run (triggered or manual) is logged to the artifact's own append-only log (metadata only: trigger, target, result `ok|failed|skipped`, duration, changed-section hashes — never content). Dedup key `hash(event+target+commit)`: the same event processed twice (retry/replay) does not repeat the refresh, result `skipped`; `manual`/`ci` refreshes are never deduped against each other (an explicit call always runs). `release_cut` is registered in the event→sections map but has no producer inside pose-mcp today — cutting a release belongs to Conductor (a separate service); the trigger is ready for when that integration exists.\n - **Capability reassessment triggers** (spec `pose-capability-assessment-triggers`, same hook registry as the automatic project-state refresh above) — the `assessment-staleness` consumer, registered on `spec_closeout`, resolves which components a closeout reached (via `components_hit` when `POSE_GRAPHFORGE_MCP_URL` is configured; fallback: intersecting the event's touched files against each mechanism's manually declared `paths:` globs in the assessment) and marks every affected capability mechanism stale — never mutating a score, only recording `since`/`trigger`/`hits` and projecting a cobrável demand (origin `assessment-trigger`) into `pose followups --open`, with no duplicate storage. `pose assess snapshot` clears the marks on the mechanisms it reassesses and records the mark→snapshot link in the history. On-demand: `pose assess stale [--json]` lists pending marks; `pose assess request --mechanism <id> [--reason <text>]` creates one manually (the same path a UI-driven \"flag for reassessment\" action would call over MCP). MCP tool: `pose_capability_stale`. Without GraphForge and without `paths:` declared, the event logs `capability_mapping_unavailable` to the refresh log — a visible signal, nothing marked silently. Anti-noise threshold (`min_hits`, hit `level` `direct`/`any`, the demand's default owner/SLA) is configurable, sharing the same policy file already used for age/commit-based staleness (optional; absent means these same conservative defaults).\n - **Docs governance** (spec `pose-docs-governance-contract`) — an opt-in, per-project contract for documentation, same mechanic as the capability assessment above: absent, every project stays valid everywhere. `pose docs-init [--profile library|service|cli|monorepo]` scaffolds a manifest declaring governed doc roots and, per doc, `path`/`doc_type` (Diátaxis `tutorial`/`howto`/`reference`/`explanation`, or a custom value)/`topics`/`owns`/`applies_to`/optional `review_after`. `pose docs-check [--json] [--explain <rule>]` runs seven deterministic, offline rules — a declared doc missing from disk, a file present but undeclared, missing minimal frontmatter (`title`/`doc_type`), a broken relative link, a broken typed reference (`spec:`/`adr:`/`knowledge:`/`doc:`/...), staleness (an entry's own review date, or the manifest's default review window counted from its last touching commit) and a security scan reusing the same deterministic unsafe-instruction/secret-shaped pattern check skills already run — each with a configurable severity (`error`/`warning`/`off`). `pose check --strict` incorporates `docs-check` when the manifest exists (opt-in by presence); only errors block, warnings surface without blocking. `pose docs-sync` synchronizes governance metadata. Tool MCP: `pose_docs_state`. Project-state gains an additive Docs section (manifest presence/profile/roots, declared/undeclared/stale/error/warning counts).\n - **Docs review-pending triggers** (spec `pose-docs-assessment-followups`, third consumer of the same hook registry as the two entries above — reused unmodified) — a `docs-review` consumer, registered on `spec_closeout`, resolves which components/files a closeout reached (`components_hit` when configured, matched against `owns:` entries declared as `component:<id>`; otherwise the event's touched files matched against each doc's `owns:` paths/globs, where a directory like `\"site\"` covers every file under it) and marks every doc whose declared area was reached as review-pending — never editing the doc itself, never touching a score. Marks accumulate in an append-only log outside the doc's own file and project a synthetic, owned demand into `pose followups --open` (origin `docs:<doc-path>`), reusing the manifest entry's own `owner` field when declared. `pose docs-review resolve <doc> [--no-change --reason <text>] [--commit <sha>]` closes every mark pending on a doc at once, recording `updated` (default, captures the current commit) or `no_change_needed` (reason required); `pose docs-review request <doc>`/`--all-stale` cover the on-demand path — the latter bridges every currently-stale doc into an active demand in one call. `docs-check`'s own output and `pose_docs_state` additively list what's still pending. Without a component map and without `owns:` declared, the event logs a visible signal instead of marking anything silently — here the path fallback is the mechanism's full-strength path (`owns:` is expressed as paths by default), not a lesser one. Anti-noise threshold (`min_hits`, hit `level`, default owner/SLA) is configurable, sharing the same policy shape as the capability triggers in its own file (optional; absent means these same conservative defaults).\n - `history-check` — verifies every `.jsonl` under `reports/history/` is git-tracked. Without that, `recurrence-check` and `stats` diverge between machines. Strict blocks; tolerant warns.\n - `suggest` — reads [`task-map.json`](.pose/indexes/task-map.json) and prints the canonical trail (workflow + skill + rules + spec/ADR + knowledge) for a task type. With no arguments it lists every type. `--domain <d>` adds domain rules (frontend, backend-go, k8s); `--path <p>` infers the domain heuristically and via [`repo-map.json`](.pose/indexes/repo-map.json) (`language` → frontend/backend-go); `--json` for agents. Domains (spec `pose-distributed-instructions-parity`): `--domain` and the domain inferred from `--path` go through one taxonomy (`go`/`golang`/`backend-go` → `backend-go`; `react`/`frontend-react`/`frontend` → `frontend`; `kubernetes`/`helm`/`k8s` → `k8s`), the JSON discloses `domain_input` and `domain_source: alias`, and a domain the task map has no rules for is reported (`domain_status`) instead of borrowing another's; a `backend` module is the Go domain only when its language is Go. `rules_status` (and the human output) says for each rule whether it is `installed` (with its path), `extension-needed` (with `pose extension install <id>`) or `unavailable`; suggest announces no rule file that is not on disk and installs nothing.\n - `stats` — aggregates history JSONL outcomes by workflow, task or context. Enables objective decisions (promoting a check from optional to required, spotting unstable workflows, comparing ci against manual). `--since-days N` filters the window; `--json` for machine consumption.\n - `stats governance` — schema 2 read-only projection over report history, sealed review bundles, attestations and explicit remediation declarations. It keeps preparation, judgment, intervention, freshness, telemetry, provenance and coverage independent, never emits a quality score, and reports missing/invalid data explicitly. `--report-type` filters validation attempts; `--band` filters reviews and finding links. Replay identity is `(report_type, task_slug, sequence)`; identity-less rows remain visible in coverage. MCP `pose_governance_stats` accepts the same selectors and requires `project_id` when choosing a federated root. Explicit finding links contain only opaque IDs, spec slugs, category and source band, with at most 100 rows and truncation reported.\n - `stats governance --waits --rework` (spec `pose-governance-wait-rework-observability`) — two more dimensions beside the outcomes, never folded into a score. With `--waits` or `--rework` only the requested dimensions are computed; `--outcomes` adds the outcomes, which read the whole history. `--waits` times action requests and keeps three measures apart: the age of each request, the interval attributed to waiting on an actor or an external system, and `known_blocking_seconds`, the union per spec of intervals in which a request restricted the whole spec's execution (simultaneous requests count once). None of them is inactivity; missing timestamps are counted as unknown. `--rework` classifies superseded sealed bundles by what changed (subject, intent or plan, review plan, evidence, or unknown) and extra attestations on one bundle by review disagreement or an earlier attestation invalid against today's policy, leaving other causes unknown. `scripts/bench-governance.sh [runs] [pose-binary]` times `state --attention`, `check --strict` and `index` on the same revision and reports time and the index size separately, with the corpus revision and engine version.\n - Premise validity (spec `pose-assumption-validity-scope`) — a material `Assumption A<N>` may declare `Valid scope:` (the context it holds in) and `Stale trigger:` entries `<kind>:<value>@<pin>`, where kind is `doc`, `report`, `knowledge`, `adr` or `snapshot` and the pin is a prefix (8+ hex) of the sha256 of the content the premise was judged against. `lint-spec --design-check` reports an unpinned trigger with the pin to append, an unreadable one as unknown, and a calendar trigger (`date:`, `ttl:`, …) as not evaluated: validity is by context, not expiry, and trivial premises need neither field. When pinned content changes, the obligation projection (producer `premises`) emits a `premise-stale` judgment obligation for draft and in-progress specs, advisory on review and scoped to the assumption and the decisions based on it. The recorded evidence stays; it is described as judged against the pinned content and not valid for the current one, and nothing is invalidated automatically. Provider or remote contracts are not monitored by the core. Trigger state is projection only and never changes the design digest.\n - Falsifier observation (spec `pose-falsifier-reconsideration`) — a material `Decision D<N>` may add `Expected effect:` and `Falsifier check: check:<module>/<check>`, naming the indexed validation check whose failure contradicts it. When the delivery index holds a `fail` result for that check, the obligation projection (producer `falsifiers`) emits a `falsifier-observed` judgment obligation, advisory on review and scoped to the decision, for any spec that is not superseded or abandoned (decisions stay in force after done). The engine infers no cause and judges no architecture: the failure is an observation, the decision and its rationale are never edited, and a person either records why it still holds or opens a superseding decision. A passing or absent result raises nothing. `lint-spec --design-check` warns on a malformed reference and on a falsifier check without a stated falsifier.\n - `migrate v7 --dry-run [--json]` (spec `pose-v7-legacy-cleanup-plan`) — read-only inventory of what a future major would convert, keep or refuse: spec layouts, `blocked` specs, legacy and unknown review policy keys, sealed bundles, attestations by identity mode and attribution, and incomplete transfers on this project's side, each with its action and removal criterion. It writes nothing. Sealed bundles, attestations and signatures are never rewritten. `--apply` is refused with the current fact: no apply is available in this engine, the only mode is `--dry-run`, which writes nothing; no future apply is promised.\n - `assess design --spec <slug>` — read-only bounded projection over the canonical sealed review subject. It observes dependency, component, delivery-metadata, governance-contract and public-contract deltas, keeps unknown/unsupported coverage explicit, and never computes a complexity or architecture score. The MCP equivalent is `pose_design_delta`.\n - `usage` — aggregates automatic, project-scoped CLI and MCP usage events: calls, execution/semantic outcomes, latency, findings observed and stable finding lifecycle (`unique`, `new`, `resolved`, `reopened`). Agents never maintain counters. Events are best-effort, local-only and stored outside the tracked worktree; raw arguments, output, paths, project/user identity and finding IDs are never persisted. `--since-days 0` includes all history; filter with `--tool` or `--surface`; MCP equivalent: `pose_usage`. This is product-usage evidence, not a DORA delivery outcome or an individual productivity score.\n - `record-deployment` / `record-incident` / `dora-metrics` / `adoption-metrics` — ingest identity-free schema-v2 delivery events and calculate metrics for explicit production environments (`--environment`, default `production`). Deployments require `--deployment-kind planned|rework`; incidents require an environment; recovery includes only resolved `--caused-by-deployment` incidents. `adoption-metrics` aggregates specifications, roadmaps, and validation lifecycle rates.\n - `stacks [--path dir] [--json]` — read-only, offline catalog inspection (spec pose-stack-catalog-expansion). Matches directory entries against the maintained profile catalog (Node.js, Go, Rust, Java, **Python** — poetry/pipenv/pip/setuptools/pep517 — and **.NET**), reporting per profile: manager, marker, `winner`/`shadowed` (multiple managers present resolve by declared priority), `confidence` (`medium` under conflict), and whether the prerequisite native tool is on `PATH` — via `exec.LookPath`, never by executing a project file. Detected markers feed `discoverValidationModules`/`pose init --wizard` the same way Node/Go/Rust/Java already do; the actual checks run through [`validation-matrix.json`](.pose/indexes/validation-matrix.json) `python`/`dotnet` stacks. Python manager priority is expressed with `when.fileNotExistsAny` (skip when any higher-priority lockfile/marker exists) alongside the existing `fileExists`/`fileNotExists` predicates.\n-- `assess discover|integrate|tech-debt|stale|request|snapshot` — native assessment engines for LOC, technical debt markers, component structures, inter-module contract integrity checks, and capability mechanism reassessment lifecycle.\n+- `assess discover|integrate|tech-debt|stale|request|snapshot` — native assessment engines for LOC, technical debt markers, component structures, inter-module contract integrity checks, and capability mechanism reassessment lifecycle. `discover`, `integrate` and `tech-debt` take `--no-persist` to print their result without writing `.pose/assessments/` or `.pose/state/`; in the sealed checkout of a delegated review (`POSE_SEALED_CHECKOUT`) they never persist, `init`, `snapshot` and `request` refuse, and the review plan runs them with `--no-persist`, so a reviewer running a planned assessment does not fail its own run.\n - `doctor [--fix]` — environment, dependency, native runtime, and POSE instance health diagnostics, plus governance that would otherwise fail only downstream: `review.evidence-vocabulary` (a selected profile demands a class no check may emit), `validate.class-producers` (a criterion accepts only classes no registered check produces), `validate.evidence-class-coverage` (checks with no `evidenceClass`), `review.profile-schema`, `review.contract-adoption`, `review.scope-change-set`, and `<policy>.policy-keys` for nine policies (keys the engine does not read, i.e. a misspelled setting that silently does nothing).\n - `knowledge-housekeeping` / `reports-housekeeping` / `events-housekeeping` — idempotent maintenance (list/archive/purge). Mutations require `--apply`. Reports housekeeping **never touches `history/`**: the JSONL is the source of truth for `recurrence-check` and `report`'s temporal comparisons. Defaults: stale = 120d, archive purge = 365d.\n - `amend` — append-only spec amendment history (`amendments.jsonl` beside a folder spec's `spec.md`, or `YYYY-MM-DD-<slug>.amendments.jsonl` beside a flat dated spec; the spec is resolved through the store, so both layouts amend alike). `--baseline` snapshots every R-ID hash; `--ids R2 --change added|withdrawn|semantic|editorial --rationale <text> --author @alias [--reviewer @alias]` acknowledges a material change; `--list` renders history and pending acknowledgments. On `done` specs with a history, `lint-spec` rejects any requirement whose current text is not acknowledged by an event — specs cannot be silently rewritten after evidence. `--nodes [--json]` prints the versioned contract-node projection: requirements, assumptions and decisions with namespace, content hash, state and relations. With `contract_nodes_version: 1` adopted in the review policy, `--baseline` writes a schema-2 R/A/D snapshot, `--ids` accepts A/D, `--change transition` acknowledges an allowed state change, `editorial` is refused when a node changed state or relations, and the gate also rejects an active decision resting on an invalidated or withdrawn assumption. Without the capability the gate stays requirement-only and a schema-2 event is refused; schema-1 logs keep their meaning.\n - `start` — atomic start of a draft spec, journaled in a per-spec start record. Without flags it is a read-only, digest-bound preview: readiness and dependencies, the declared review obligations (no future structural delta needed) and the R/A/D baseline. `--apply --digest <sha256>` records that baseline and moves the spec from `draft` to `in-progress` under a per-spec lock with compare-and-swap; it needs `atomic_start_version: 1` in the review policy, repeats idempotently, resumes an interrupted run and refuses another plan for a started spec. `--cancel` undoes a start that never moved the spec. The per-spec lock records its owner (host, digests of the machine and boot IDs, PID namespace, PID and process start); a lock another call holds is reported, never broken by age, as `owner-active`, `owner-unknown` or `owner-dead` (spec `pose-journal-checkpoint-and-lock-recovery`). Dead is proven only on the same Linux machine — another boot, or a PID that is not running or now belongs to another process — and `--recover-lock <owner digest>`, with the digest `--status` shows, removes that lock only if its bytes and its dead owner are unchanged, leaving the start record to resume; an unknown owner (another host, an older engine's empty lock, another platform) is checked and removed by a person. The same lock is the spec's lifecycle lock: close and transfer take it too, so no two of them interleave on one spec (spec `pose-writer-coordination-and-atomic-publication`). `--status` classifies each node as `recorded-before-managed-execution`, `introduced-during-execution` or `legacy-unbaselined`, recomputes obligations and, under the capability, asks for reconciliation when status or the recorded baseline was edited by hand. `atomic_start_adopted_at: YYYY-MM-DD` (spec `pose-atomic-start-adoption-cutoff`) limits the capability to specs created on or after that date: an older spec in progress without a start is reported as `legacy-unbaselined` with a note and blocks nothing; without the date every such spec needs reconciliation. A start records observable precedence, not when anything was decided; MCP exposes the read-only view as `pose_start_status`.\n - `knowledge-usage` — projects `knowledge:<slug>` citations from specs per artifact (owner, expiry, citing specs). Usage signals inform the owner's review; TTL is never extended automatically. Dangling `knowledge:` refs fail `knowledge-check`.\n - `knowledge-suggest <query>` / `semantic-suggest <query>` / `suggest-feedback` / `portfolio-projection` / `reconcile-evidence` — deterministic lexical ranking and advisory projections for knowledge, feedback clustering, multi-roadmap portfolio milestones, and delivery validation evidence reconciliation. Suggestions never gate or auto-apply without confirmation.\n - `hooks` — links the native binary into `.git/hooks/`; invocation name selects `check --tolerant` for `pre-commit` and `index` for `post-merge`. `install --force` keeps a backup of pre-existing hooks. An instance that runs POSE through its own revision-bound CLI declares a runner in a `hooks.json` file of `.pose/policy/` (`{\"schema_version\":1,\"runner\":\"<project-relative executable>\"}`): the hook then runs the runner with the hook's name and returns its exit code, and `hooks status` names it; a runner outside the project, not executable or under another schema is refused and nothing runs.\n - `version` — displays compiled Go binary version, commit SHA, and compares the repository schema version with engine requirements.\n - `context` — resolves a selected logical project and optional local or `xref:`-qualified task through the shared artifact resolver. The JSON result includes canonical authority, project/artifact revisions, resolution state, supported contracts and a `context_revision`; it never includes filesystem roots. Use this token to detect a changed checkout or revision before a cross-project write.\n - Cross-project CLI writes require the target in `POSE_PROJECT_ROOTS` and the `context_revision` from a fresh `pose context` call. Use `new-spec-qualified` for qualified creation so older engines reject the command itself. A project found only by `HARNE8_PROJECTS_DIR` scan can be read but does not grant write access. Existing canonical specs are reused; redirects and incomplete transfers block shadow creation.\n - `install <dir> [--locale tag] [--skip-mcp] [--force] [--no-backup] [--allow-non-git]` — installs the embedded POSE runtime, rules, workflows, templates, and documentation into a target project directory without cloning, stamps `adopted_at` in the changelog policy with the day the instance received it, and runs the strict gate.\n - `import <spec-kit|openspec> <path> [--dry-run]` — imports foreign specification trees into canonical POSE specifications with standard frontmatter and section structure.\n - `serve-mcp` — starts the POSE Model Context Protocol server over stdio (`--stdio`) or HTTP for native AI agent integration. The stdio server exits on SIGTERM; it resolves the `pose` CLI it runs once, at start, so a server started before `pose update` keeps working with the updated binary.\n - `report-limitation` — records an engine limitation, defect, or enhancement proposal into `.pose/feedback/` with optional submission (`--submit`).\n - `contribute <enable|disable|status|stage|list>` — open-source contributor mode; stages sanitized reports under `.pose/contributions/` without leaking proprietary code; submission remains developer-adjudicated.\n - `telemetry <enable|disable|status>` — manages anonymous, opt-in platform telemetry settings.\n - `release` / `release-notes` — governed release lifecycle (`plan`, `prepare`, `check`, `notes`, `record`, `status`, `open-next`, `backfill`) ensuring immutable release notes, manifest freezing, provider evidence importing, and reproducible release verification. A release that introduces a governance contract carries a **Compatibility** section at the top of its notes, generated from the contract registry. `release-notes` provides a compatibility alias for viewing frozen notes. The version a cut is compared with comes from `version_source` in `.pose/policy/release.json` (`{\"path\": \"VERSION\", \"kind\": \"text\"}`, or `\"kind\": \"json\"` with a `key`): a project file holding `X.Y.Z`, with an optional `v` and `-dev` suffix. Only the engine repository may omit it; every other project must declare one. Manifest and tag integrity (spec `pose-release-manifest-tag-integrity`): a manifest is read through a strict contract (supported `schema_version`, no unknown fields, clean version and paths) that recomposes `specs`, `categories`, `breaking` and `release_input_digest` from the fragments it freezes, so an adulterated projection is refused instead of normalised. `check` and `status` verify a tag from its own tree: the tag (lightweight or annotated) is peeled to its commit, and the manifest, notes, frozen fragments and version source are read as blobs of that commit, never from the working tree. A tag whose tree holds no manifest is refused whatever the working tree holds; a later commit, provider evidence or the next cycle does not make a correct cut stale; a version source that cannot be recomputed from the manifest is reported as a limit.\n \n   **Query cursors:** paginated MCP list tools (`pose_list_specs`, `pose_list_roadmaps`, `pose_list_knowledge`, `pose_list_reports`, `pose_capability_history`) continue a query over the collection it was issued for. A cursor is signed, expires after 15 minutes and is bound to its tool, project, filters and the ordered collection with its index generation; a changed collection, another query, an expired token, a version 1 token or a server restart is refused with a `cursor-*` code and the caller restarts from the first page, never continued over a changed collection. A page is at most 500 items, discloses its `generation`, `collection` and `total`, and a missing `next_cursor` does not certify anything beyond that collection (spec `pose-generation-bound-query-cursors`).\n \n@@ -1041,27 +1041,29 @@ Declare the executor and implementation baseline before dispatch. A bundle that\n \n ```json\n {\n   \"schema_version\": 1,\n   \"provenance\": {\n     \"trust\": \"executor-attested\",\n     \"implementation\": {\"principal\": \"agent:implementer\", \"execution\": \"implementation-run-1\", \"vendor\": \"vendor-a\", \"model\": \"model-a\"}\n   },\n   \"adapters\": {\n     \"reviewer\": {\"executor\": \"agent:reviewer\", \"command\": [\"reviewer\", \"--output\", \"{output}\"], \"vendor\": \"vendor-b\", \"model\": \"model-b\"}\n   }\n }\n ```\n \n Use the existing native issuer and its attestation pin. Set protected `authority_project` and `authority_audience` in review policy; a declared project identity must agree. Keep keys outside the project. Dispatch captures origin/worktree, bundle/commit/scope/kind, configuration/argv/executable, identities, brief template/body/notes, planned stdin and actual pipe-write digests, raw and retained redacted output/transcript digests and completeness. A pipe write does not prove the vendor consumed the prompt. Session references and private keys stay outside the public proof.\n \n Preview `pose review run-sign <run-id> --issuer <name> [--ttl <duration>]`, then add `--apply` to publish an immutable proof under `.pose/review-run-proofs/`. TTL is optional (no expiry when absent), positive when supplied and at most 365 days. Verify it with `pose review run-proof <run-id> <proof-id> [--json]`. The proof signs the captured executor declaration; it is not an independent vendor receipt or human confirmation. Failed or interrupted audit records disclose their state and `complete_review=false`. Unknown or ambiguous draft decisions also keep that flag false. A true flag describes completed delivery with one draft decision, not approval or complete typed-conclusion validation. A completed run with incomplete stdin or truncated output cannot establish a completed review. Legacy runs have no captured provenance and cannot be upgraded by signing today's configuration. `pose review run-proof` and the issuer lookups of the verdict readers ask the question the closeout asks: for a run whose scope is done, the proof as it was given (the record stands, the issuer still holds its pin; routine drift of the repository and the proof's expiry are not asked, because the expiry bounds when a proof may back a new attestation, not whether an attestation already given to a done scope stands); for an open scope, as the repository is now.\n \n Attach `--run <run-id> --run-proof <proof-id> --sign <issuer>` to a complete `pose review attest` request. The native issuer derives authority principal/execution bindings from the run and signs the exact reference. Criteria, tools, evidence and all ordinary preflight checks still apply. A rejecting or ambiguous draft cannot support an approval; a run-backed attestation cannot predate its completed run or signed proof. Adjudication/smoke run proofs bind their kinds but cannot be used as review attestations. Automatic validation/application of complete typed conclusions belongs to the capability, not to run signing.\n \n-**Conclusions of delegated reviews.** `pose review conclude <run> [--issuer <name>] [--apply] [--json]` records the conclusion of a completed review run: the run's final message carries its typed conclusion in the pose-draft block — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` as `<class>:<ref>`, `rationale`, and `mappings` where the plan asks for structural mappings) and `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), the brief of template `review-brief/7` (the text a template version renders is frozen by a golden digest, so a change to it takes a new version) asks for them and states the rules the engine checks before it records one (a judgment criterion passed carries a rationale, its evidence is a ref the bundle sealed, a finding criterion names a finding of the draft, structural facts are answered as `mappings`; a draft that breaks one is refused whole; a round after the first also names the findings it accounts for by the identifiers the brief lists, with their round, never a bare F1) — and the engine signs the run's proof and the attestation with the native issuer, `--issuer` or `conclusions.issuer` in `.pose/policy/delegation.json` (the key stays outside the project), and records it through the same domain writer and preflight as `pose review attest --run --run-proof --sign`. A follow-up finding with `action`, `owner` and `review_by` becomes an accepted risk when its severity is one the sealed review policy accepts (low by default); any other finding stays open. A rejecting conclusion is recorded too and blocks the scope until the bundle changes. A run that is not a completed review, is superseded, captured no provenance, has an incomplete cleanup or record, carries no valid draft for its round, or whose bundle no longer governs, records no attestation: its conclusion record, in the `review-conclusions` directory of `.pose`, keeps the reasons. A run concludes once: a lock the system releases when the process ends is held from the first read to the last write, concluding it again returns its record, and a reservation an interrupted conclusion left is completed from the attestation it recorded only if that attestation verifies as the run's conclusion, otherwise the run is concluded in its place. Whoever signs it, an attestation of a run briefed with `review-brief/3` to `/7` states that run's conclusion: criteria, tools or findings its draft did not declare are refused. With review policy `delegated_review: true` and `conclusions.issuer` set, `pose delegate review` records the conclusion the moment the run completes; otherwise nothing is automatic. An adjudication or a smoke run concludes the same way, under the same checks, lock and refusals, and never as an approval. The brief of template `adjudication-brief/2` lists the questions the scope's spec records — each decision `D<n>` and requirement `R<n>` — and the pose-draft block answers each in `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); the verdict is recorded as an adjudication record of the spec in the `adjudications` directory of `.pose`, and `lint-spec` fails, and `close` refuses, on a question the current bundle's adjudication says does not hold and warns on one it cannot determine or on a record that does not verify. The brief of template `smoke-brief/2` asks for `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), one per delivery target; the observations are recorded as validation results of evidence class `smoke`, one required check per target that passes when it was observed and is evidence of that target of that spec only, its head, time and provenance taken from the run and the current index, in the `results/smoke` directory of `.pose`, which `surface-check` reads beside the results path, so a delivery profile may demand `smoke`. A verdict that does not answer exactly what its brief asked records nothing; every record is verified on read — its run's proof verifies and it is what the run's draft concludes — and one that does not yields nothing. Runs briefed with `adjudication-brief/1` and `smoke-brief/1` keep verifying with their template.\n+**Conclusions of delegated reviews.** `pose review conclude <run> [--issuer <name>] [--apply] [--json]` records the conclusion of a completed review run: the run's final message carries its typed conclusion in the pose-draft block — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` as `<class>:<ref>`, `rationale`, and `mappings` where the plan asks for structural mappings) and `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), the brief of template `review-brief/8` (the text a template version renders is frozen by a golden digest, so a change to it takes a new version) asks for them and states the rules the engine checks before it records one (a judgment criterion passed carries a rationale, its evidence is a ref the bundle sealed, a finding criterion names a finding of the draft, structural facts are answered as `mappings`; a draft that breaks one is refused whole; a round after the first also names the findings it accounts for by the identifiers the brief lists, with their round, never a bare F1) — and the engine signs the run's proof and the attestation with the native issuer, `--issuer` or `conclusions.issuer` in `.pose/policy/delegation.json` (the key stays outside the project), and records it through the same domain writer and preflight as `pose review attest --run --run-proof --sign`. A follow-up finding with `action`, `owner` and `review_by` becomes an accepted risk when its severity is one the sealed review policy accepts (low by default); any other finding stays open. A rejecting conclusion is recorded too and blocks the scope until the bundle changes. A run that is not a completed review, is superseded, captured no provenance, has an incomplete cleanup or record, carries no valid draft for its round, or whose bundle no longer governs, records no attestation: its conclusion record, in the `review-conclusions` directory of `.pose`, keeps the reasons. A run concludes once: a lock the system releases when the process ends is held from the first read to the last write, concluding it again returns its record, and a reservation an interrupted conclusion left is completed from the attestation it recorded only if that attestation verifies as the run's conclusion, otherwise the run is concluded in its place. Whoever signs it, an attestation of a run briefed with `review-brief/3` to `/8` states that run's conclusion: criteria, tools or findings its draft did not declare are refused. With review policy `delegated_review: true` and `conclusions.issuer` set, `pose delegate review` records the conclusion the moment the run completes; otherwise nothing is automatic. An adjudication or a smoke run concludes the same way, under the same checks, lock and refusals, and never as an approval. The brief of template `adjudication-brief/2` lists the questions the scope's spec records — each decision `D<n>` and requirement `R<n>` — and the pose-draft block answers each in `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); the verdict is recorded as an adjudication record of the spec in the `adjudications` directory of `.pose`, and `lint-spec` fails, and `close` refuses, on a question the current bundle's adjudication says does not hold and warns on one it cannot determine or on a record that does not verify. The brief of template `smoke-brief/2` asks for `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), one per delivery target; the observations are recorded as validation results of evidence class `smoke`, one required check per target that passes when it was observed and is evidence of that target of that spec only, its head, time and provenance taken from the run and the current index, in the `results/smoke` directory of `.pose`, which `surface-check` reads beside the results path, so a delivery profile may demand `smoke`. A verdict that does not answer exactly what its brief asked records nothing; every record is verified on read — its run's proof verifies and it is what the run's draft concludes — and one that does not yields nothing. Runs briefed with `adjudication-brief/1` and `smoke-brief/1` keep verifying with their template.\n+\n+**Review readiness before the seal.** A new seal of a spec scope refuses what `pose close` and the conclusion preflight would otherwise refuse only after a full review round: a change to a delivery root with no delivery declaration (`undeclared-delivery`) or to a governed path the artifacts do not declare (`undeclared`), read from the same index `pose close` reads, and, when a required criterion asks for structural mappings, a decision or assumption that reaches no requirement or constraint (give it a `- Basis:` line). A bundle already sealed is returned as it was. `pose review draft-check [<bundle-id|run-id>] --draft <file|-> [--json]` reports every reason the conclusion step would refuse a draft (an unreadable block, a round it does not account for, a criterion, mapping, finding, evidence or tool the attestation preflight refuses) and writes nothing; inside a delegated review the run provides the bundle and the round through `POSE_REVIEW_DRAFT_CONTEXT` and names its own engine in `POSE_REVIEW_CLI`, and `-` reads the draft from standard input, so it works in a read-only sandbox. The brief of template `review-brief/8` asks the reviewer to run it before finishing. `pose delegate` names an oversized note file with its size and the limit, and a completed run that nothing concluded automatically prints the `pose review conclude <run>` command that records it.\n \n **Delegated-review requests.** `pose review request <scope|bundle> --kind delegated-review [--purpose review|adjudicate|smoke] [--agents <name,...>] [--note-file <path>] [--apply]` opens an action request of kind `delegated-review` that binds the project, the worktree, the scope, the sealed bundle, the brief, the notes, the policies, the accepted agents and the destination of the conclusion (an attestation, an adjudication record or smoke evidence). No actor answers it: `pose action fulfil <act-id> --run <run-id> --runner agent:<id> --idempotency-key <key> --expected-revision <n> [--channel cli|ci|conductor] [--envelope <file>] [--apply]`, or the MCP tool `pose_action_fulfil`, submits a completed run, and the engine records the fulfilment only when the run is of the request's brief and bundle, of an accepted agent, completed with its containment, its signed proof verifies, its attempt ledger is intact and the engine recorded its conclusion at the request's destination; the fulfilment is verified again on every read. `pose delegate review <scope> --request <act-id>` runs the request's brief locally and submits the run once concluded. A rejecting run fulfils the request without approving anything; a superseded bundle or changed policy invalidates it, even once fulfilled, and it is asked again with `--supersedes <act-id>`, which retires it under the supersession authority rules (`--authority <json>`, `--role <role>`, `--requested-at` from the preview), or, when the plan now reserves the review for a person, makes the person's escalation its successor; a retry with the same key and run is a no-op. A person is asked by exception, as a decision request to the maintainer role: a plan that reserves the review for a person, a spent attempt budget, reviewers in conflict, and a `business_decision` a reviewer raised in its draft. A run's proof verifies in any checkout of the project: the worktree it ran in is recorded, not required of the reader, so a CI job or the Conductor fulfils the request with the same envelope.\n \n Opt in to the verification bar with `delegated_review: true` in review policy only when preparing adoption. This live bar requires a signed run reference for agent different-actor review and refuses a prefix-only identity; it does not enable or add the future catalog capability. Non-adopting instances keep declared behavior. Under explicit executor-attested trust, normalized vendor OR model difference satisfies different-actor (vendor difference preferred); unknown baselines and the same vendor/model refuse. A machine run never satisfies mandatory-human. Catalog adoption, cutoffs/rollback and automatic conclusion application remain separate capability work.\n \n Read the same current assurance through verify, review-check, MCP and `pose state --attention`: `machine-attested` names the signed executor declaration, its source, run/proof and vendor/model comparisons. Current issuer pins, project/audience/time, sealed inputs, retained artifacts and original/continuation receipts are reverified. Revocation, missing receipts, rewritten data or stale inputs remove machine assurance. Signing does not reset quotas or erase earlier rejecting runs. The origin worktree is recorded with the run, not required of the reader: a proof verifies in any checkout of the project, so a run a CI job or the Conductor performed is verified like a local one; no universal containment is claimed.\ndiff --git a/pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md b/pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\nindex 3c20d024..33f7e0df 100644\n--- a/pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\n+++ b/pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\n@@ -407,41 +407,41 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - Frescor de assessment (spec `pose-adaptive-assessment-freshness`) — um assessment de componente registra seu vínculo: a árvore commitada do componente, a versão do motor e o digest da matriz de validação. `pose assess discover --if-stale [--component <dir>]` reaproveita um assessment cujo vínculo não mudou e o refaz caso contrário, mostrando `assess.freshness.<componente>` com o motivo (conteúdo mudou, motor mudou, matriz mudou, mudanças não commitadas, ou registro antigo sem vínculo). Idade sozinha nunca torna um assessment stale. Um assessment ausente ou stale de um componente declarado por uma spec em andamento aparece como obrigação consultiva de `evidence` em `state --attention`; não bloqueia nada.\n - `followups --candidates [--json]` (spec `pose-followup-reconciliation-candidates`) — lista follow-ups abertos com um motivo de reconciliação: `target-terminal` (uma spec citada pelo follow-up está done, superseded ou abandoned), `evidence-present` (um teste citado agora existe), `overdue` (a data de revisão passou), além de clusters lexicais de quase-duplicatas. Cada candidato mostra sua evidência e seus limites; nada recebe disposição, similaridade nunca vira `duplicate` sem julgamento, e um follow-up aberto nunca sai do Attention sem uma disposição escrita na spec. O Attention mostra o mesmo motivo no item de dívida residual.\n - `action list --present [--actor <id|papel>] [--json]` (spec `pose-action-request-presentation`) — agrupa as solicitações que ainda esperam resposta para uma única conversa: por origem e primeira fase restringida, as que restringem start ou execution primeiro (`interrupt`), as que restringem só a release marcadas como capazes de esperar. Cada solicitação mantém seu id, digest, revisão e resposta, e mostra exatamente o conteúdo ao qual a resolução se vincula; solicitações satisfeitas não são perguntadas de novo. MCP: `pose_action_requests` com `present: true`. Decidir quando interromper uma pessoa fica com o consumidor (Harne8).\n - Superfície progressiva de spec (spec `pose-progressive-spec-surface`) — `pose new-spec <slug> --surface minimal|standard|full` registra `surface:` no frontmatter. Uma spec `minimal` mantém Intent, Requirements, o Technical Plan com Artifacts, Validation com o requirement trace e o Final Report com os follow-ups; remove a seção Tasks (local do planner) e as subseções do relatório que `pose specs facts <slug> [--json]` deriva do índice de entrega (paths dos commits atribuídos, checks que produziram evidência no escopo). `lint-spec` deixa de exigir Tasks numa spec mínima e não relaxa mais nada: os gates de trace, follow-ups e amendments continuam iguais. Os fatos nunca incluem intenção, rationale ou risco aceito. Vínculo de evidência (spec `pose-spec-facts-evidence-binding`): `specs facts` separa `checks` (resultados cujo scope provenance nomeia a spec, com a base e se rodaram contra o head dos change sets da spec) de `candidates` (resultados que o índice guarda e que nada liga à spec: módulo declarado ou `components` vazio não é provenance); candidatos são impressos como `CANDIDATE, not evidence of this spec`. `freshness` informa `fresh`, `stale` (um input mudou depois da publicação do índice), `unknown` (nunca publicado como conjunto) ou `unavailable`, e uma limitação manda rodar `pose index` quando não dá para estabelecer; ler os facts nunca reconstrói o índice nem conclui que um requisito está satisfeito.\n - **Refresh automático de project-state** (spec `pose-project-state-refresh-contract`) — um registro interno de hooks pós-evento dispara um `pose state refresh` **parcial** (apenas as seções que o evento afeta) nos pontos que o POSE já intercepta: um `pose lint-spec <slug> --strict` bem-sucedido numa spec `status: done` (`spec_closeout` → Specs & Roadmaps, Follow-ups, Validação & Evidência), `pose amend` (`spec_amend` → Specs & Roadmaps, Decisões & Conhecimento), `pose reconcile-evidence record` (`evidence_reconciled` → Validação & Evidência) e `pose assess snapshot` (`assessment_snapshot` → Capabilities). Quando o evento carrega um commit e `POSE_GRAPHFORGE_MCP_URL` está configurado, o consumidor chama `components_hit` (spec `graphforge-components-hit-contract`) do baseline do estado até o commit do evento e anexa os componentes atingidos à seção Arquitetura (refresh **dirigido**); sem GraphForge configurado, o refresh permanece completo/não dirigido — zero acoplamento de build. Sem daemon e sem watcher de filesystem: é uma chamada síncrona no ponto exato em que cada evento já acontece. **Best-effort por padrão**: um refresh que falha nunca bloqueia o comando que disparou o evento — em vez disso marca `refresh_pending: <event>` no frontmatter do estado (limpo pelo próximo refresh bem-sucedido, qualquer que seja o gatilho). O modo estrito é opt-in por política (`strict_refresh: true`) — ali, uma falha de refresh falha o comando disparador. Toda execução (disparada ou manual) é registrada no log append-only do próprio artefato (apenas metadados: gatilho, alvo, resultado `ok|failed|skipped`, duração, hashes das seções alteradas — nunca conteúdo). Chave de dedup `hash(event+target+commit)`: o mesmo evento processado duas vezes (retry/replay) não repete o refresh, resultado `skipped`; refreshes `manual`/`ci` nunca são deduplicados entre si (uma chamada explícita sempre roda). `release_cut` está registrado no mapa evento→seções mas não tem produtor dentro do pose-mcp hoje — cortar um release pertence ao Conductor (serviço separado); o gatilho está pronto para quando essa integração existir.\n - **Gatilhos de reavaliação de capability** (spec `pose-capability-assessment-triggers`, mesmo registro de hooks do refresh automático acima) — o consumidor `assessment-staleness`, registrado em `spec_closeout`, resolve quais componentes um closeout alcançou (via `components_hit` quando `POSE_GRAPHFORGE_MCP_URL` está configurado; fallback: interseção dos arquivos tocados pelo evento com os globs `paths:` declarados manualmente por mecanismo no assessment) e marca como stale todo mecanismo de capability afetado — nunca mutando um score, apenas registrando `since`/`trigger`/`hits` e projetando uma demanda cobrável (origem `assessment-trigger`) em `pose followups --open`, sem armazenamento duplicado. `pose assess snapshot` limpa as marcas dos mecanismos que reavalia e registra o vínculo marca→snapshot no histórico. Sob demanda: `pose assess stale [--json]` lista marcas pendentes; `pose assess request --mechanism <id> [--reason <text>]` cria uma manualmente (o mesmo caminho que uma ação de UI \"sinalizar para reavaliação\" chamaria via MCP). Ferramenta MCP: `pose_capability_stale`. Sem GraphForge e sem `paths:` declarado, o evento registra `capability_mapping_unavailable` no log de refresh — sinal visível, nada marcado em silêncio. O limiar antirruído (`min_hits`, `level` de hit `direct`/`any`, owner/SLA default da demanda) é configurável, compartilhando o mesmo arquivo de política já usado para staleness por idade/commits (opcional; ausente significa estes mesmos defaults conservadores).\n - **Governança de docs** (spec `pose-docs-governance-contract`) — contrato opt-in por projeto para documentação, mesma mecânica do assessment de capability acima: ausente, todo projeto segue válido em todo lugar. `pose docs-init [--profile library|service|cli|monorepo]` cria um manifesto declarando as raízes governadas de documentação e, por doc, `path`/`doc_type` (Diátaxis `tutorial`/`howto`/`reference`/`explanation`, ou valor customizado)/`topics`/`owns`/`applies_to`/opcionalmente `review_after`. `pose docs-check [--json] [--explain <rule>]` roda sete regras determinísticas e offline — doc declarado ausente do disco, arquivo presente mas não declarado, frontmatter mínimo faltando (`title`/`doc_type`), link relativo quebrado, referência tipada quebrada (`spec:`/`adr:`/`knowledge:`/`doc:`/...), staleness (data de review da própria entrada, ou a janela default do manifesto contada a partir do último commit que a tocou) e uma varredura de segurança reusando a mesma checagem determinística de instrução insegura/forma de segredo que as skills já rodam — cada uma com severidade configurável (`error`/`warning`/`off`). `pose check --strict` incorpora o `docs-check` quando o manifesto existe (opt-in por presença); apenas erros bloqueiam, avisos aparecem sem bloquear. `pose docs-sync` sincroniza metadados de governança. Ferramenta MCP: `pose_docs_state`. O project-state ganha uma seção Docs aditiva (presença/perfil/raízes do manifesto, contagens de declarados/não declarados/stale/erro/aviso).\n - **Gatilhos de review pendente de docs** (spec `pose-docs-assessment-followups`, terceiro consumidor do mesmo registro de hooks das duas entradas acima — reusado sem modificação) — um consumidor `docs-review`, registrado em `spec_closeout`, resolve quais componentes/arquivos um closeout alcançou (`components_hit` quando configurado, casado contra entradas `owns:` declaradas como `component:<id>`; caso contrário, os arquivos tocados pelo evento casados contra os paths/globs `owns:` de cada doc, onde um diretório como `\"site\"` cobre todo arquivo abaixo dele) e marca como review-pending todo doc cuja área declarada foi alcançada — nunca editando o doc, nunca tocando um score. As marcas se acumulam num log append-only fora do arquivo do próprio doc e projetam uma demanda sintética e com dono em `pose followups --open` (origem `docs:<caminho-do-doc>`), reusando o campo `owner` da própria entrada do manifesto quando declarado. `pose docs-review resolve <doc> [--no-change --reason <text>] [--commit <sha>]` fecha de uma vez todas as marcas pendentes num doc, registrando `updated` (default, captura o commit atual) ou `no_change_needed` (motivo obrigatório); `pose docs-review request <doc>`/`--all-stale` cobrem o caminho sob demanda — o segundo transforma todo doc atualmente stale em demanda ativa numa chamada. A saída do próprio `docs-check` e o `pose_docs_state` listam aditivamente o que segue pendente. Sem mapa de componentes e sem `owns:` declarado, o evento registra um sinal visível em vez de marcar algo em silêncio — aqui o fallback por path é o caminho de força total do mecanismo (`owns:` é expresso como paths por padrão), não um caminho menor. O limiar antirruído (`min_hits`, `level` de hit, owner/SLA default) é configurável, compartilhando o mesmo formato de política dos gatilhos de capability em arquivo próprio (opcional; ausente significa estes mesmos defaults conservadores).\n - `history-check` — verifica que todo `.jsonl` em `reports/history/` está sob versionamento git. Sem isso, `recurrence-check` e `stats` divergem entre máquinas. Strict bloqueia; tolerant avisa.\n - `suggest` — lê [`task-map.json`](.pose/indexes/task-map.json) e imprime a trilha canônica (workflow + skill + rules + spec/ADR + knowledge) para um tipo de tarefa. Sem argumentos, lista todos os tipos. `--domain <d>` aplica rules adicionais por domínio (frontend, backend-go, k8s); `--path <p>` infere o domínio por heurísticas e via [`repo-map.json`](.pose/indexes/repo-map.json) (`language` → frontend/backend-go); `--json` para consumo por agentes. Domínios (spec `pose-distributed-instructions-parity`): `--domain` e o domínio inferido de `--path` passam por uma taxonomia (`go`/`golang`/`backend-go` → `backend-go`; `react`/`frontend-react`/`frontend` → `frontend`; `kubernetes`/`helm`/`k8s` → `k8s`), o JSON expõe `domain_input` e `domain_source: alias`, e um domínio sem regras no task-map é reportado (`domain_status`) em vez de tomar emprestado o de outro; um módulo `backend` só é o domínio Go quando sua linguagem é Go. `rules_status` (e a saída humana) diz de cada regra se está `installed` (com o path), `extension-needed` (com `pose extension install <id>`) ou `unavailable`; suggest não anuncia arquivo de regra que não está no disco e não instala nada.\n - `stats` — agrega outcomes do history JSONL por workflow, task ou context. Habilita decisões objetivas (promover check de optional → required, identificar workflows instáveis, comparar ci vs manual). `--since-days N` filtra a janela; `--json` para consumo por máquina.\n - `stats governance` — projeção read-only schema 2 sobre histórico de reports, bundles de review selados, atestações e declarações explícitas de remediação. Mantém preparação, julgamento, intervenção, frescor, telemetria, proveniência e cobertura independentes, nunca emite score de qualidade e explicita dados ausentes ou inválidos. `--report-type` filtra tentativas de validação; `--band` filtra reviews e vínculos de findings. A identidade de replay é `(report_type, task_slug, sequence)`; linhas sem identidade permanecem visíveis na cobertura. MCP `pose_governance_stats` aceita os mesmos seletores e exige `project_id` para escolher uma raiz federada. Vínculos explícitos incluem apenas IDs opacos, slugs, categoria e banda de origem, limitados a 100 linhas com truncamento indicado.\n - `stats governance --waits --rework` (spec `pose-governance-wait-rework-observability`) — duas dimensões a mais ao lado dos resultados, nunca somadas num score. Com `--waits` ou `--rework`, só as dimensões pedidas são calculadas; `--outcomes` acrescenta os resultados, que leem todo o histórico. `--waits` cronometra as action requests e mantém três medidas separadas: a idade de cada solicitação, o intervalo atribuído à espera por um ator ou sistema externo, e `known_blocking_seconds`, a união por spec dos intervalos em que uma solicitação restringiu a execução da spec inteira (solicitações simultâneas contam uma vez). Nenhuma delas é inatividade; timestamps ausentes contam como desconhecidos. `--rework` classifica bundles selados substituídos pelo que mudou (sujeito, intenção ou plano, plano de review, evidência, ou desconhecido) e atestações extras num bundle por divergência de review ou atestação anterior inválida contra a política atual, deixando outras causas como desconhecidas. `scripts/bench-governance.sh [runs] [pose-binary]` cronometra `state --attention`, `check --strict` e `index` na mesma revisão e reporta tempo e tamanho do índice separadamente, com a revisão do corpus e a versão do motor.\n - Validade de premissas (spec `pose-assumption-validity-scope`) — uma `Premissa A<N>` material pode declarar `Escopo de validade:` (o contexto em que vale) e entradas `Gatilho de obsolescência:` `<kind>:<value>@<pin>`, onde kind é `doc`, `report`, `knowledge`, `adr` ou `snapshot` e o pin é um prefixo (8+ hex) do sha256 do conteúdo contra o qual a premissa foi julgada. `lint-spec --design-check` reporta um gatilho sem pin com o pin a acrescentar, um ilegível como desconhecido, e um gatilho de calendário (`date:`, `ttl:`, …) como não avaliado: validade é por contexto, não por expiração, e premissas triviais não precisam de nenhum campo. Quando o conteúdo fixado muda, a projeção de obrigações (produtor `premises`) emite uma obrigação de julgamento `premise-stale` para specs draft e in-progress, advisory no review e com escopo na premissa e nas decisões baseadas nela. A evidência registrada permanece; é descrita como julgada contra o conteúdo fixado e não válida para o atual, e nada é invalidado automaticamente. Contratos de provedores ou remotos não são monitorados pelo core. O estado do gatilho é só projeção e nunca muda o digest do design.\n - Observação de falsificador (spec `pose-falsifier-reconsideration`) — uma `Decisão D<N>` material pode acrescentar `Efeito esperado:` e `Verificação do falsificador: check:<module>/<check>`, nomeando o check de validação indexado cuja falha a contradiz. Quando o índice de entrega contém um resultado `fail` desse check, a projeção de obrigações (produtor `falsifiers`) emite uma obrigação de julgamento `falsifier-observed`, advisory no review e com escopo na decisão, para qualquer spec que não esteja superseded ou abandoned (decisões continuam valendo depois de done). O motor não infere causa nem julga arquitetura: a falha é uma observação, a decisão e seu rationale nunca são editados, e uma pessoa registra por que ela ainda vale ou abre uma decisão substituta. Um resultado aprovado ou ausente não gera nada. `lint-spec --design-check` avisa sobre referência malformada e sobre verificação de falsificador sem falsificador declarado.\n - `migrate v7 --dry-run [--json]` (spec `pose-v7-legacy-cleanup-plan`) — inventário somente leitura do que uma futura major converteria, manteria ou recusaria: layouts de spec, specs `blocked`, chaves legadas e desconhecidas da política de review, bundles selados, atestações por modo de identidade e atribuição, e transferências incompletas do lado deste projeto, cada um com sua ação e critério de remoção. Não escreve nada. Bundles selados, atestações e assinaturas nunca são reescritos. `--apply` é recusado com o fato atual: não há apply neste motor, o único modo é `--dry-run`, que não escreve nada; nenhum apply futuro é prometido.\n - `assess design --spec <slug>` — projeção read-only e bounded sobre o subject canônico selado de review. Observa deltas de dependência, componente, metadata de delivery, contratos de governança e contratos públicos, mantém coverage unknown/unsupported explícita e nunca calcula score de complexidade ou arquitetura. O equivalente MCP é `pose_design_delta`.\n - `usage` — agrega automaticamente eventos locais e por projeto de uso da CLI e do MCP: chamadas, outcomes de execução/semântica, latência, findings observados e ciclo de vida estável (`unique`, `new`, `resolved`, `reopened`). Agentes nunca mantêm contadores. Os eventos são best-effort, somente locais e ficam fora da árvore versionada; argumentos, saída, paths, identidade de projeto/usuário e IDs crus de findings nunca são persistidos. `--since-days 0` inclui todo o histórico; filtre com `--tool` ou `--surface`; equivalente MCP: `pose_usage`. É evidência de uso do produto, não outcome DORA nem score individual de produtividade.\n - `record-deployment` / `record-incident` / `dora-metrics` / `adoption-metrics` — ingerem eventos de entrega schema v2 sem identidade individual e calculam métricas para um ambiente de produção explícito (`--environment`, padrão `production`). Deployments exigem `--deployment-kind planned|rework`; incidentes exigem ambiente; recovery inclui apenas incidentes resolvidos com `--caused-by-deployment`. `adoption-metrics` agrega taxas de especificações, roadmaps e validação de ciclo de vida.\n - `stacks [--path dir] [--json]` — inspeção de catálogo read-only e offline (spec pose-stack-catalog-expansion). Casa entradas de diretório contra o catálogo mantido de perfis (Node.js, Go, Rust, Java, **Python** — poetry/pipenv/pip/setuptools/pep517 — e **.NET**), reportando por perfil: manager, marker, `winner`/`shadowed` (múltiplos managers presentes resolvem por prioridade declarada), `confidence` (`medium` sob conflito) e se a ferramenta nativa pré-requisito está no `PATH` — via `exec.LookPath`, nunca executando um arquivo do projeto. Markers detectados alimentam `discoverValidationModules`/`pose init --wizard` do mesmo jeito que Node/Go/Rust/Java já fazem; os checks propriamente ditos rodam pelas stacks `python`/`dotnet` da [`validation-matrix.json`](.pose/indexes/validation-matrix.json). A prioridade de manager Python é expressa com `when.fileNotExistsAny` (pular quando existir qualquer lockfile/marker de prioridade maior) ao lado dos predicados `fileExists`/`fileNotExists` já existentes.\n-- `assess discover|integrate|tech-debt|stale|request|snapshot` — motores nativos de assessment para LOC, marcadores de débito técnico, estruturas de componentes, checagens de integridade de contrato entre módulos e ciclo de vida de reavaliação de capabilities.\n+- `assess discover|integrate|tech-debt|stale|request|snapshot` — motores nativos de assessment para LOC, marcadores de débito técnico, estruturas de componentes, checagens de integridade de contrato entre módulos e ciclo de vida de reavaliação de capabilities. `discover`, `integrate` e `tech-debt` aceitam `--no-persist` para imprimir o resultado sem gravar `.pose/assessments/` nem `.pose/state/`; no checkout selado de uma review delegada (`POSE_SEALED_CHECKOUT`) eles nunca gravam, `init`, `snapshot` e `request` recusam, e o plano de review os roda com `--no-persist`, para que um revisor que roda um assessment planejado não derrube o próprio run.\n - `doctor [--fix]` — diagnósticos de ambiente, dependências, runtime nativo e saúde da instância POSE, além de governança que só falharia mais adiante: `review.evidence-vocabulary` (um profile selecionado exige uma classe que nenhum check pode emitir), `validate.class-producers` (um critério aceita apenas classes que nenhum check registrado produz), `validate.evidence-class-coverage` (checks sem `evidenceClass`), `review.profile-schema`, `review.contract-adoption`, `review.scope-change-set` e `<policy>.policy-keys` para nove políticas (chaves que o motor não lê, ou seja, uma configuração com erro de digitação que silenciosamente não faz nada).\n - `knowledge-housekeeping` / `reports-housekeeping` / `events-housekeeping` — manutenção idempotente (listar/arquivar/expurgar). Mutações exigem `--apply`. O housekeeping de reports **nunca toca em `history/`**: o JSONL é a fonte de verdade para `recurrence-check` e comparações temporais de `report`. Defaults: stale = 120d, purga de arquivo = 365d.\n - `amend` — histórico append-only de emendas da spec (`amendments.jsonl` ao lado do `spec.md` de uma spec em pasta, ou `YYYY-MM-DD-<slug>.amendments.jsonl` ao lado de uma spec flat datada; a spec é resolvida pelo store, então os dois layouts recebem emendas do mesmo modo). `--baseline` fotografa o hash de cada R-ID; `--ids R2 --change added|withdrawn|semantic|editorial --rationale <text> --author @alias [--reviewer @alias]` reconhece uma mudança material; `--list` renderiza o histórico e os reconhecimentos pendentes. Em specs `done` com histórico, o `lint-spec` rejeita todo requisito cujo texto atual não esteja reconhecido por um evento — specs não podem ser reescritas em silêncio depois da evidência. `--nodes [--json]` mostra a projeção versionada de contract nodes: requisitos, premissas e decisões com namespace, hash de conteúdo, estado e relações. Com `contract_nodes_version: 1` adotado na policy de review, `--baseline` grava um snapshot R/A/D schema 2, `--ids` aceita A/D, `--change transition` reconhece uma mudança de estado permitida, `editorial` é recusado quando o nó mudou estado ou relações, e o gate também rejeita decisão ativa apoiada em premissa invalidada ou retirada. Sem a capability o gate segue só com requisitos e um evento schema 2 é recusado; logs schema 1 mantêm o significado.\n - `start` — início atômico de uma spec draft, registrado num start record por spec. Sem flags é um preview somente leitura vinculado a digest: readiness e dependências, as obrigações de review declaradas (sem exigir structural delta futuro) e a baseline R/A/D. `--apply --digest <sha256>` grava essa baseline e move a spec de `draft` para `in-progress` com lock por spec e compare-and-swap; exige `atomic_start_version: 1` na policy de review, repete de forma idempotente, retoma uma execução interrompida e recusa outro plano para spec já iniciada. `--cancel` desfaz um start que não moveu a spec. A trava por spec registra seu dono (host, digests dos IDs de máquina e de boot, namespace de PID, PID e início do processo); uma trava de outra chamada é informada, nunca quebrada pela idade, como `owner-active`, `owner-unknown` ou `owner-dead` (spec `pose-journal-checkpoint-and-lock-recovery`). Morte só é provada na mesma máquina Linux — outro boot, ou um PID que não roda ou agora é de outro processo — e `--recover-lock <digest do dono>`, com o digest que `--status` mostra, remove essa trava só se os bytes e o dono morto não mudaram, deixando o start record para retomar; um dono desconhecido (outro host, a trava vazia de um motor anterior, outra plataforma) é verificado e removido por uma pessoa. A mesma trava é a trava de ciclo de vida da spec: close e transfer também a tomam, então dois deles nunca se intercalam numa spec (spec `pose-writer-coordination-and-atomic-publication`). `--status` classifica cada nó como `recorded-before-managed-execution`, `introduced-during-execution` ou `legacy-unbaselined`, recalcula as obrigações e, com a capability, pede reconciliação quando status ou baseline registrada foram editados à mão. `atomic_start_adopted_at: YYYY-MM-DD` (spec `pose-atomic-start-adoption-cutoff`) limita a capability às specs criadas a partir dessa data: uma spec mais antiga em andamento sem start aparece como `legacy-unbaselined` com uma nota e não bloqueia nada; sem a data, toda spec assim exige reconciliação. Um start registra precedência observável, não quando algo foi decidido; o MCP expõe a visão somente leitura como `pose_start_status`.\n - `knowledge-usage` — projeta as citações `knowledge:<slug>` das specs por artefato (dono, expiração, specs citantes). Sinais de uso informam a review do dono; o TTL nunca é estendido automaticamente. Refs `knowledge:` órfãs falham no `knowledge-check`.\n - `knowledge-suggest <query>` / `semantic-suggest <query>` / `suggest-feedback` / `portfolio-projection` / `reconcile-evidence` — ranqueamento léxico determinístico e projeções consultivas para conhecimento, agrupamento de feedback, marcos de portfólio multi-roadmap e reconciliação de evidências de validação. Sugestões nunca bloqueiam nem se autoaplicam sem confirmação.\n - `hooks` — gerencia symlinks do binário nativo em `.git/hooks/`. O nome de invocação seleciona `check --tolerant` para `pre-commit` e `index` para `post-merge`; `install --force` preserva backup de hooks preexistentes. Uma instância que roda o POSE pelo próprio CLI vinculado a uma revisão declara um executor num arquivo `hooks.json` de `.pose/policy/` (`{\"schema_version\":1,\"runner\":\"<executável relativo ao projeto>\"}`): o hook passa a rodar o executor com o nome do hook e devolve o código de saída dele, e `hooks status` o nomeia; um executor fora do projeto, não executável ou com outro schema é recusado e nada roda.\n - `version` — exibe versão compilada do binário Go, SHA do commit e compara a versão do schema do repositório com os requisitos do motor.\n - `context` — resolve um projeto lógico selecionado e uma tarefa opcional, local ou qualificada por `xref:`, pelo resolvedor compartilhado de artefatos. O resultado JSON traz a autoridade canônica, as revisões do projeto e do artefato, o estado de resolução, os contratos suportados e um `context_revision`; nunca inclui roots do filesystem. Use esse token para detectar checkout ou revisão alterados antes de uma escrita entre projetos.\n - Escritas CLI entre projetos exigem o destino em `POSE_PROJECT_ROOTS` e o `context_revision` de uma chamada recente de `pose context`. Use `new-spec-qualified` para criação qualificada, de modo que motores antigos recusem o próprio comando. Um projeto encontrado apenas por varredura de `HARNE8_PROJECTS_DIR` pode ser lido, mas não concede acesso de escrita. Specs canônicas existentes são reutilizadas; redirecionamentos e transferências incompletas bloqueiam a criação de uma cópia.\n - `install <dir> [--locale tag] [--skip-mcp] [--force] [--no-backup] [--allow-non-git]` — instala o runtime, regras, workflows, templates e documentação embutidos do POSE em um diretório de destino sem clonar, grava no `adopted_at` da política de changelog o dia em que a instância a recebeu e roda o gate estrito.\n - `import <spec-kit|openspec> <path> [--dry-run]` — importa especificações externas para o formato canônico do POSE com frontmatter e 7 seções padronizadas.\n - `serve-mcp` — inicia o servidor POSE Model Context Protocol via stdio (`--stdio`) ou HTTP para integração com agentes de IA. O servidor stdio encerra com SIGTERM; ele resolve o CLI `pose` que executa uma única vez, ao iniciar, então um servidor iniciado antes de um `pose update` continua funcionando com o binário atualizado.\n - `report-limitation` — registra limitação, defeito ou sugestão de melhoria do motor em `.pose/feedback/` com opção de submissão (`--submit`).\n - `contribute <enable|disable|status|stage|list>` — modo contribuidor open-source; registra relatórios sanitizados sob `.pose/contributions/` sem vazar código privado; a submissão permanece a critério do desenvolvedor.\n - `release` / `release-notes` — ciclo de vida governado de releases (`plan`, `prepare`, `check`, `notes`, `record`, `status`, `open-next`, `backfill`) garantindo notas de release imutáveis, congelamento de manifesto, importação de evidências de provedor e verificação reproduzível. Uma release que introduz um contrato de governança traz uma seção **Compatibility** no topo das notas, gerada a partir do registro de contratos. `release-notes` fornece alias de compatibilidade para visualização de notas congeladas. A versão com que o corte é comparado vem de `version_source` em `.pose/policy/release.json` (`{\"path\": \"VERSION\", \"kind\": \"text\"}`, ou `\"kind\": \"json\"` com `key`): um arquivo do projeto com `X.Y.Z`, com `v` e sufixo `-dev` opcionais. Só o repositório do motor pode omiti-lo; todo outro projeto precisa declarar um. Integridade de manifest e tag (spec `pose-release-manifest-tag-integrity`): o manifest é lido por um contrato estrito (`schema_version` suportado, sem campos desconhecidos, versão e paths limpos) que recompõe `specs`, `categories`, `breaking` e `release_input_digest` a partir dos fragments que congela, de modo que uma projeção adulterada é recusada em vez de normalizada. `check` e `status` verificam uma tag pela sua própria árvore: a tag (leve ou anotada) é resolvida até o commit, e manifest, notas, fragments congelados e fonte de versão são lidos como blobs desse commit, nunca do worktree. Uma tag cuja árvore não tem manifest é recusada qualquer que seja o worktree; um commit posterior, evidência do provider ou o próximo ciclo não tornam obsoleto um cut correto; uma fonte de versão que não pode ser recomputada a partir do manifest é reportada como limite.\n \n   **Cursores de consulta:** as tools MCP de listagem paginadas (`pose_list_specs`, `pose_list_roadmaps`, `pose_list_knowledge`, `pose_list_reports`, `pose_capability_history`) continuam uma consulta sobre a coleção para a qual o cursor foi emitido. O cursor é assinado, expira em 15 minutos e está ligado à tool, ao projeto, aos filtros e à coleção ordenada com a geração do índice; coleção alterada, outra consulta, token expirado, token versão 1 ou reinício do servidor são recusados com um código `cursor-*` e quem chama recomeça da primeira página, sem nunca continuar sobre uma coleção alterada. Uma página tem no máximo 500 itens, divulga `generation`, `collection` e `total`, e a ausência de `next_cursor` não certifica nada além dessa coleção (spec `pose-generation-bound-query-cursors`).\n \n ### Contrato de conexão MCP\n@@ -1051,27 +1051,29 @@ Declare executor e baseline de implementação antes do dispatch. Um bundle que\n \n ```json\n {\n   \"schema_version\": 1,\n   \"provenance\": {\n     \"trust\": \"executor-attested\",\n     \"implementation\": {\"principal\": \"agent:implementer\", \"execution\": \"implementation-run-1\", \"vendor\": \"vendor-a\", \"model\": \"model-a\"}\n   },\n   \"adapters\": {\n     \"reviewer\": {\"executor\": \"agent:reviewer\", \"command\": [\"reviewer\", \"--output\", \"{output}\"], \"vendor\": \"vendor-b\", \"model\": \"model-b\"}\n   }\n }\n ```\n \n Reutilize o issuer nativo e seu pin de atestações. Configure `authority_project` e `authority_audience` protegidos na policy de review; a identidade declarada do projeto deve concordar. Mantenha chaves fora do projeto. O dispatch captura origem/worktree, bundle/commit/scope/kind, configuração/argv/executável, identidades, template/body/notas do brief, stdin planejado e bytes escritos no pipe, digests de saída/transcript brutos e retidos com redação, além de completude. Escrever no pipe não prova que o fornecedor consumiu o prompt. Sessões e chaves privadas ficam fora da prova pública.\n \n Visualize `pose review run-sign <run-id> --issuer <nome> [--ttl <duração>]` e acrescente `--apply` para publicar uma prova imutável em `.pose/review-run-proofs/`. TTL é opcional (sem expiração quando ausente), positivo quando informado e limitado a 365 dias. Verifique com `pose review run-proof <run-id> <proof-id> [--json]`. A prova assina a declaração capturada do executor; não é recibo independente do fornecedor nem confirmação humana. Auditorias failed/interrupted mostram seu estado e `complete_review=false`. Decisão desconhecida ou ambígua também mantém a flag falsa. A flag verdadeira descreve entrega concluída com uma decisão de draft, não aprovação nem validação completa da conclusão tipada. Run completed com stdin incompleto ou saída truncada não estabelece review concluído. Runs legados sem proveniência capturada não são promovidos assinando a configuração atual. `pose review run-proof` e as buscas do emissor dos leitores de veredito fazem a pergunta que o fechamento faz: para uma run cujo escopo está done, a prova como foi dada (o registro se sustenta, o emissor mantém o pin; a deriva rotineira do repositório e a expiração da prova não são perguntadas, porque a expiração limita quando uma prova pode amparar uma nova atestação, não se uma atestação já dada a um escopo done se mantém); para um escopo aberto, como o repositório está agora.\n \n Acrescente `--run <run-id> --run-proof <proof-id> --sign <issuer>` a uma solicitação completa de `pose review attest`. O issuer deriva do run os vínculos de principal/execução e assina a referência exata. Critérios, tools, evidências e preflight continuam obrigatórios. Draft negativo ou ambíguo não apoia aprovação; a atestação não pode anteceder o término do run ou sua prova assinada. Provas de adjudication/smoke vinculam seus kinds e não servem como atestações de review. Validar/aplicar automaticamente conclusões completas e tipadas pertence à capability, não à assinatura do run.\n \n-**Conclusões de reviews delegadas.** `pose review conclude <run> [--issuer <nome>] [--apply] [--json]` registra a conclusão de um run de review concluído: a mensagem final do run traz a conclusão tipada no bloco pose-draft — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` como `<classe>:<ref>`, `rationale` e, quando o plano pede mapeamentos estruturais, `mappings`) e `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), que o brief do template `review-brief/7` (o texto que uma versão de template renderiza é congelado por um digest de referência, então mudá-lo exige uma nova versão) pede e para o qual declara as regras que o motor confere antes de registrar (um critério de julgamento aprovado traz uma justificativa, sua evidência é uma ref que o bundle selou, um critério com finding nomeia um finding do draft, fatos estruturais são respondidos como `mappings`; um draft que quebra uma delas é recusado inteiro; uma rodada depois da primeira também nomeia os findings pelos quais responde com os identificadores que o brief lista, com a rodada, nunca um F1 solto) — e o motor assina a prova do run e a atestação com o issuer nativo, `--issuer` ou `conclusions.issuer` em `.pose/policy/delegation.json` (a chave fica fora do projeto), e a registra pelo mesmo writer de domínio e preflight de `pose review attest --run --run-proof --sign`. Um finding de follow-up com `action`, `owner` e `review_by` vira um risco aceito quando sua severidade é uma que a política de review selada aceita (low por padrão); qualquer outro finding fica aberto. Uma conclusão que rejeita também é registrada e bloqueia o escopo até o bundle mudar. Um run que não é uma review concluída, foi substituído, não capturou proveniência, tem limpeza ou registro incompletos, não traz draft válido para sua rodada, ou cujo bundle não governa mais, não registra atestação: seu registro de conclusão, no diretório `review-conclusions` de `.pose`, guarda os motivos. Um run conclui uma vez: um lock que o sistema libera quando o processo termina é mantido da primeira leitura à última escrita, concluí-lo de novo devolve seu registro, e uma reserva deixada por uma conclusão interrompida só é completada pela atestação que ela registrou se essa atestação verificar como a conclusão do run; caso contrário o run é concluído no lugar dela. Quem quer que a assine, uma atestação de um run com brief `review-brief/3` a `/7` declara a conclusão daquele run: critérios, ferramentas ou findings que o draft não declarou são recusados. Com `delegated_review: true` na policy de review e `conclusions.issuer` definido, `pose delegate review` registra a conclusão no momento em que o run termina; caso contrário nada é automático. Um run de adjudicação ou de smoke conclui do mesmo jeito, sob os mesmos checks, lock e recusas, e nunca como aprovação. O brief do template `adjudication-brief/2` lista as questões que a spec do escopo registra — cada decisão `D<n>` e requisito `R<n>` — e o bloco pose-draft responde cada uma em `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); o veredito é registrado como registro de adjudicação da spec no diretório `adjudications` de `.pose`, e o `lint-spec` reprova, e o `close` recusa, uma questão que a adjudicação do bundle atual diz não se sustentar e avisa sobre uma que ela não pôde determinar ou sobre um registro que não verifica. O brief do template `smoke-brief/2` pede `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), uma por delivery target; as observações são registradas como resultados de validação da classe de evidência `smoke`, um check obrigatório por alvo que passa quando foi observado e é evidência só daquele alvo daquela spec, com head, data e proveniência tirados do run e do índice atual, no diretório `results/smoke` de `.pose`, que o `surface-check` lê ao lado do results path, de modo que um delivery profile pode exigir `smoke`. Um veredito que não responde exatamente o que seu brief pediu não registra nada; todo registro é verificado na leitura — a prova do run verifica e ele é o que o draft do run conclui — e um que não verifica não produz nada. Runs com brief `adjudication-brief/1` e `smoke-brief/1` continuam verificando com o próprio template.\n+**Conclusões de reviews delegadas.** `pose review conclude <run> [--issuer <nome>] [--apply] [--json]` registra a conclusão de um run de review concluído: a mensagem final do run traz a conclusão tipada no bloco pose-draft — `criteria` (`id`, `disposition` passed|finding|not-applicable, `evidence` como `<classe>:<ref>`, `rationale` e, quando o plano pede mapeamentos estruturais, `mappings`) e `tools` (`id`, `component`, `disposition`, `evidence`, `rationale`), que o brief do template `review-brief/8` (o texto que uma versão de template renderiza é congelado por um digest de referência, então mudá-lo exige uma nova versão) pede e para o qual declara as regras que o motor confere antes de registrar (um critério de julgamento aprovado traz uma justificativa, sua evidência é uma ref que o bundle selou, um critério com finding nomeia um finding do draft, fatos estruturais são respondidos como `mappings`; um draft que quebra uma delas é recusado inteiro; uma rodada depois da primeira também nomeia os findings pelos quais responde com os identificadores que o brief lista, com a rodada, nunca um F1 solto) — e o motor assina a prova do run e a atestação com o issuer nativo, `--issuer` ou `conclusions.issuer` em `.pose/policy/delegation.json` (a chave fica fora do projeto), e a registra pelo mesmo writer de domínio e preflight de `pose review attest --run --run-proof --sign`. Um finding de follow-up com `action`, `owner` e `review_by` vira um risco aceito quando sua severidade é uma que a política de review selada aceita (low por padrão); qualquer outro finding fica aberto. Uma conclusão que rejeita também é registrada e bloqueia o escopo até o bundle mudar. Um run que não é uma review concluída, foi substituído, não capturou proveniência, tem limpeza ou registro incompletos, não traz draft válido para sua rodada, ou cujo bundle não governa mais, não registra atestação: seu registro de conclusão, no diretório `review-conclusions` de `.pose`, guarda os motivos. Um run conclui uma vez: um lock que o sistema libera quando o processo termina é mantido da primeira leitura à última escrita, concluí-lo de novo devolve seu registro, e uma reserva deixada por uma conclusão interrompida só é completada pela atestação que ela registrou se essa atestação verificar como a conclusão do run; caso contrário o run é concluído no lugar dela. Quem quer que a assine, uma atestação de um run com brief `review-brief/3` a `/8` declara a conclusão daquele run: critérios, ferramentas ou findings que o draft não declarou são recusados. Com `delegated_review: true` na policy de review e `conclusions.issuer` definido, `pose delegate review` registra a conclusão no momento em que o run termina; caso contrário nada é automático. Um run de adjudicação ou de smoke conclui do mesmo jeito, sob os mesmos checks, lock e recusas, e nunca como aprovação. O brief do template `adjudication-brief/2` lista as questões que a spec do escopo registra — cada decisão `D<n>` e requisito `R<n>` — e o bloco pose-draft responde cada uma em `questions` (`id`, `verdict` holds|does-not-hold|cannot-determine, `evidence`, `rationale`); o veredito é registrado como registro de adjudicação da spec no diretório `adjudications` de `.pose`, e o `lint-spec` reprova, e o `close` recusa, uma questão que a adjudicação do bundle atual diz não se sustentar e avisa sobre uma que ela não pôde determinar ou sobre um registro que não verifica. O brief do template `smoke-brief/2` pede `surfaces` (`ref`, `outcome` observed|not-observed|not-reachable, `commands`, `observed`), uma por delivery target; as observações são registradas como resultados de validação da classe de evidência `smoke`, um check obrigatório por alvo que passa quando foi observado e é evidência só daquele alvo daquela spec, com head, data e proveniência tirados do run e do índice atual, no diretório `results/smoke` de `.pose`, que o `surface-check` lê ao lado do results path, de modo que um delivery profile pode exigir `smoke`. Um veredito que não responde exatamente o que seu brief pediu não registra nada; todo registro é verificado na leitura — a prova do run verifica e ele é o que o draft do run conclui — e um que não verifica não produz nada. Runs com brief `adjudication-brief/1` e `smoke-brief/1` continuam verificando com o próprio template.\n+\n+**Prontidão da review antes da selagem.** Uma nova selagem de escopo de spec recusa o que `pose close` e a preflight da conclusão só recusariam depois de uma rodada completa de review: uma mudança em raiz de entrega sem declaração de entrega (`undeclared-delivery`) ou em caminho governado que os artefatos não declaram (`undeclared`), lidas do mesmo índice que `pose close` lê, e, quando um critério obrigatório pede mapeamentos estruturais, uma decisão ou premissa que não alcança requisito nem restrição (dê a ela uma linha `- Basis:`). Um bundle já selado é devolvido como estava. `pose review draft-check [<bundle-id|run-id>] --draft <arquivo|-> [--json]` relata todo motivo pelo qual a conclusão recusaria um rascunho (bloco ilegível, rodada não contabilizada, critério, mapeamento, achado, evidência ou ferramenta que a preflight da atestação recusa) e não grava nada; dentro de uma review delegada o run fornece o bundle e a rodada por `POSE_REVIEW_DRAFT_CONTEXT` e nomeia o próprio motor em `POSE_REVIEW_CLI`, e `-` lê o rascunho da entrada padrão, então funciona num sandbox somente leitura. O brief do template `review-brief/8` pede ao revisor que o rode antes de terminar. `pose delegate` nomeia um arquivo de nota grande demais com seu tamanho e o limite, e um run concluído que nada concluiu automaticamente imprime o comando `pose review conclude <run>` que o registra.\n \n **Requests de review delegada.** `pose review request <escopo|bundle> --kind delegated-review [--purpose review|adjudicate|smoke] [--agents <nome,...>] [--note-file <caminho>] [--apply]` abre uma action request de kind `delegated-review` que vincula o projeto, o worktree, o escopo, o bundle selado, o brief, as notas, as policies, os agentes aceitos e o destino da conclusão (uma atestação, um registro de adjudicação ou evidência de smoke). Nenhum ator a responde: `pose action fulfil <act-id> --run <run-id> --runner agent:<id> --idempotency-key <chave> --expected-revision <n> [--channel cli|ci|conductor] [--envelope <arquivo>] [--apply]`, ou a tool MCP `pose_action_fulfil`, submete um run concluído, e o motor registra o fulfillment só quando o run é do brief e do bundle do request, de um agente aceito, concluído com sua contenção, sua prova assinada verifica, seu ledger de tentativas está íntegro e o motor registrou sua conclusão no destino do request; o fulfillment é verificado de novo a cada leitura. `pose delegate review <escopo> --request <act-id>` roda o brief do request localmente e submete o run depois de concluído. Um run que rejeita cumpre o request sem aprovar nada; um bundle superado ou uma policy alterada o invalida, mesmo já cumprido, e ele é pedido de novo com `--supersedes <act-id>`, que o aposenta sob as regras de autoridade de supersession (`--authority <json>`, `--role <papel>`, `--requested-at` do preview) ou, quando o plano passa a reservar a review a uma pessoa, faz da escalação para a pessoa o seu sucessor; um retry com a mesma chave e o mesmo run não faz nada. Uma pessoa é chamada por exceção, como decision request ao papel maintainer: um plano que reserva a review a uma pessoa, um orçamento de tentativas esgotado, revisores em conflito e uma `business_decision` que um revisor levantou no draft. A prova de um run verifica em qualquer checkout do projeto: o worktree onde rodou fica registrado, não é exigido de quem lê, então um job de CI ou o Conductor cumpre o request com o mesmo envelope.\n \n Ative a barreira de verificação com `delegated_review: true` na policy de review somente ao preparar adoção. Essa barreira viva exige prova de run para review de agente different-actor e recusa prefixo isolado; ela não adiciona nem habilita a capability futura no catálogo. Instâncias não adotantes mantêm o comportamento declared. Com confiança executor-attested explícita, vendor OU modelo normalizado diferente satisfaz different-actor (vendor distinto preferido); baseline desconhecida e mesmo vendor/modelo recusam. Run de máquina nunca satisfaz mandatory-human. Adoção no catálogo, cutoffs/rollback e aplicação automática de conclusões continuam no escopo separado da capability.\n \n Leia a mesma assurance atual por verify, review-check, MCP e `pose state --attention`: `machine-attested` identifica a declaração assinada, sua fonte, run/proof e comparação de vendor/modelo. Pins atuais, projeto/audience/tempo, inputs selados, artefatos retidos e receipts originais/de continuação são revalidados. Revogação, receipt ausente, dados reescritos ou inputs stale retiram a assurance de máquina. Assinar não restaura quota nem apaga runs negativos anteriores. O worktree de origem fica registrado com o run, não é exigido de quem lê: uma prova verifica em qualquer checkout do projeto, então um run feito por um job de CI ou pelo Conductor é verificado como um local; não há alegação de contenção universal.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/rules/backend-go.md; rg -n -i 'sealed|assess|no-persist' .pose/knowledge\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/rules/backend-go.md; rg -n -i 'sealed|assess|no-persist' .pose/knowledge\"","aggregated_output":"# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n.pose/knowledge/archive/2026-09-24-handoff-multirepo-review-continuation.md:30:has a sealed `changes-requested` review (`rva-b178e83cb461ba31`) because R8\n.pose/knowledge/archive/2026-08-03-decision-log-project-agnostic-assessment-evidence.md:3:slug: project-agnostic-assessment-evidence\n.pose/knowledge/archive/2026-08-03-decision-log-project-agnostic-assessment-evidence.md:10:  spec: \"pose-project-agnostic-assessment-engines\"\n.pose/knowledge/archive/2026-08-03-decision-log-project-agnostic-assessment-evidence.md:12:  commands: [\"go -C pose-mcp test ./...\", \"go -C pose-mcp vet ./...\", \"pose assess discover --update-state\", \"pose assess integrate --update-state\", \"pose assess tech-debt --update-state\"]\n.pose/knowledge/archive/2026-08-03-decision-log-project-agnostic-assessment-evidence.md:16:# decision-log: project-agnostic-assessment-evidence\n.pose/knowledge/archive/2026-08-03-decision-log-project-agnostic-assessment-evidence.md:29:Todo resultado dos assessors deve ser derivado de evidência encontrada sob a\n.pose/knowledge/archive/2026-08-03-decision-log-project-agnostic-assessment-evidence.md:58:de assessment com proveniência explícita, ou se um detector produzir taxa de\n.pose/knowledge/archive/2026-08-03-decision-log-project-agnostic-assessment-evidence.md:66:`pose-project-agnostic-assessment-engines`. O dogfooding eliminou falsos\n.pose/knowledge/archive/2026-08-03-decision-log-project-agnostic-assessment-evidence.md:74:- Executar os três assessors no dogfooding após mudanças em detectores.\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:38:This is the same disease as [[project-agnostic-assessment-evidence]] (2026-08-03,\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:39:`pose-project-agnostic-assessment-engines`): pose-mcp's own identity leaking\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:41:earlier fix scoped the assessment **engines** (discovery/integration/tech-debt\n.pose/knowledge/archive/2026-08-15-decision-log-self-referential-policy-template-contamination.md:125:- Precedent: [[project-agnostic-assessment-evidence]]\n.pose/knowledge/2026-08-13-decision-log-adr-sealed-review-bundles-review.md:3:slug: adr-sealed-review-bundles-review\n.pose/knowledge/2026-08-13-decision-log-adr-sealed-review-bundles-review.md:16:# decision-log: adr-sealed-review-bundles-review\n.pose/knowledge/2026-08-13-decision-log-adr-sealed-review-bundles-review.md:23:separates a canonical sealed bundle from its attestation and makes POSE the\n.pose/knowledge/2026-08-13-decision-log-adr-sealed-review-bundles-review.md:28:ADR `2026-08-13-sealed-review-bundles-and-attestations` is accepted. The core,\n.pose/knowledge/2026-08-13-decision-log-adr-sealed-review-bundles-review.md:37:- Prove lifecycle, state, assessment, report and attestation mutations do not\n.pose/knowledge/2026-08-13-decision-log-adr-sealed-review-bundles-review.md:38:  change the sealed bundle.\n.pose/knowledge/2026-08-13-decision-log-adr-sealed-review-bundles-review.md:65:- `adr:2026-08-13-sealed-review-bundles-and-attestations`\n.pose/knowledge/2026-11-04-handoff-pose-b34-implementation.md:107:- O assessment de dívida lido nesta tarefa foi incompleto: duas specs históricas\n.pose/knowledge/2026-11-02-handoff-roadmap-v7-independent-outcomes-20261102.md:34:f1 is quoted output drift; runtime qualifies key presence assertions and refuses unsigned MCP answers. No physical hardware or human identity guarantee is inferred. f2 leaves automated outcome evidence dependent on explicit independent judgment. Generic integration assessment has 64 unobserved consumers; two pre-existing invalid spec inputs leave technical-debt scan incomplete. Recurrence reports validate-native flapping but zero flagged failure clusters. These broad observations do not invalidate the freshly exercised roadmap paths.\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:33:mutation. All eight milestone exits were assessed together, including the four\n.pose/knowledge/2026-11-02-handoff-agency-readiness-outcome-review.md:56:Historical pilot performance figures are not current measurements. Assessment\n.pose/knowledge/2026-10-28-handoff-delegated-conclusions-round4.md:44:Spec: .pose/specs/2026-10-27-pose-delegated-review-conclusions.md. Review report and independent probes: .review-work/round4/report.md. The spec Final Report records the sealed bundle and attestation after closeout. No upstream contribution draft, issue or PR was created.\n.pose/knowledge/2026-10-14-decision-log-adr-shared-worktree-runtime-review.md:28:the contract review before functional execution; reassess when design/scope changes.\n.pose/knowledge/2026-10-20-handoff-pose-b07-implementation.md:36:4. Finish artifact/surface checks, native sealed review and closeout before done or adoption. Default artifact attribution reconciled 82 claims with no errors. The Harne8 binding still points at 8aa729a7; do not update it merely because local tests pass.\n.pose/knowledge/2026-08-13-decision-log-adr-component-aware-review-plans-review.md:12:  commands: [\"pose assess discover --component pose-mcp/internal/pose\", \"pose lint-spec pose-component-aware-review-plans --ready-check\"]\n","exit_code":0,"status":"completed"}}
