{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/delegation_refusal.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// Refusals of delegated runs carry a reason code, the same on the CLI and\n     4\t// over MCP (spec pose-delegation-mcp R5). The message stays the engine's; the\n     5\t// code names the class a caller acts on.\n     6\t\n     7\timport (\n     8\t\t\"errors\"\n     9\t\t\"os\"\n    10\t\t\"path/filepath\"\n    11\t)\n    12\t\n    13\t// Reason codes of a refused delegated run.\n    14\tconst (\n    15\t\tDelegationReasonRerunWithoutReason = \"rerun-without-reason\"\n    16\t\tDelegationReasonBudgetExhausted    = \"budget-exhausted\"\n    17\t\tDelegationReasonContainment        = \"containment-incompatible\"\n    18\t\tDelegationReasonAgentUnavailable   = \"agent-unavailable\"\n    19\t\tDelegationReasonNoAgent            = \"no-agent\"\n    20\t)\n    21\t\n    22\t// DelegateRootEnv names the project root a `pose delegate` process runs in\n    23\t// when its caller resolved it — the MCP server, for the project it\n    24\t// authorized — so the process never rediscovers another one from the\n    25\t// directory it starts in (spec pose-delegation-mcp R6, review round 1, B01).\n    26\tconst DelegateRootEnv = \"POSE_DELEGATE_ROOT\"\n    27\t\n    28\t// SealedCheckoutEnv marks a process a delegated review launched in its sealed\n    29\t// checkout, as the path of that checkout. Diagnostic commands that would\n    30\t// republish a derived record there (the delivery index) read it and leave the checkout as sealed: a review that\n    31\t// changes its subject is invalid (spec pose-validation-evidence-material-binding R7).\n    32\tconst SealedCheckoutEnv = \"POSE_SEALED_CHECKOUT\"\n    33\t\n    34\t// IsSealedCheckout reports whether root is the sealed checkout the environment\n    35\t// names. The marker carries the checkout's path, so a fixture or another project\n    36\t// a reviewer's process works in is not mistaken for the sealed one.\n    37\tfunc IsSealedCheckout(root string) bool {\n    38\t\tsealed := os.Getenv(SealedCheckoutEnv)\n    39\t\tif sealed == \"\" || root == \"\" {\n    40\t\t\treturn false\n    41\t\t}\n    42\t\tresolve := func(p string) string {\n    43\t\t\tif abs, err := filepath.Abs(p); err == nil {\n    44\t\t\t\tp = abs\n    45\t\t\t}\n    46\t\t\tif real, err := filepath.EvalSymlinks(p); err == nil {\n    47\t\t\t\tp = real\n    48\t\t\t}\n    49\t\t\treturn filepath.Clean(p)\n    50\t\t}\n    51\t\treturn resolve(sealed) == resolve(root)\n    52\t}\n    53\t\n    54\t// DelegationRefusal is a refusal with its reason code.\n    55\ttype DelegationRefusal struct {\n    56\t\tCode string\n    57\t\tErr  error\n    58\t}\n    59\t\n    60\tfunc (r *DelegationRefusal) Error() string { return r.Err.Error() }\n    61\tfunc (r *DelegationRefusal) Unwrap() error { return r.Err }\n    62\t\n    63\tfunc refusal(code string, err error) error {\n    64\t\tif err == nil {\n    65\t\t\treturn nil\n    66\t\t}\n    67\t\treturn &DelegationRefusal{Code: code, Err: err}\n    68\t}\n    69\t\n    70\t// DelegationReasonCode is the reason code of err, or \"\" when it is not a\n    71\t// coded refusal.\n    72\tfunc DelegationReasonCode(err error) string {\n    73\t\tvar r *DelegationRefusal\n    74\t\tif errors.As(err, &r) {\n    75\t\t\treturn r.Code\n    76\t\t}\n    77\t\tvar unavailable *ErrNoDelegationAgentAvailable\n    78\t\tif errors.As(err, &unavailable) {\n    79\t\t\treturn DelegationReasonAgentUnavailable\n    80\t\t}\n    81\t\tif errors.Is(err, ErrNoReviewerAdapter) {\n    82\t\t\treturn DelegationReasonNoAgent\n    83\t\t}\n    84\t\treturn \"\"\n    85\t}\n","exit_code":0,"status":"completed"}}
