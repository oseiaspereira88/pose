0\t\n   671\t\tmd := fmt.Sprintf(`# Component Assessment: %s (`+\"`%s`\"+`)\n   672\t\n   673\t> **Mapeamento de Módulo POSE**: `+\"`%s`\"+`\n   674\t> **Data de Avaliação**: %s | **Baseline Commit**: %s\n   675\t> **Métricas**: %d LOC Produção | %d LOC Testes | %d Arquivos Totais\n   676\t> **Linguagens**: %s\n   677\t> **Saúde de Código**: %d TODOs | %d FIXMEs | %d Panics | %d Stubs\n   678\t\n   679\t---\n   680\t\n   681\t## 1. Visão Geral e Estrutura do Módulo\n   682\t\n   683\tO componente **%s** reside no caminho `+\"`%s`\"+` do projeto **%s**.\n   684\t\n   685\t- **Status de Verificação POSE**: `+\"`%s`\"+`\n   686\t- **Pontuação de Completude**: %.0f%%\n   687\t\n   688\t---\n   689\t\n   690\t## 2. Matriz de Dívida Técnica & Riscos\n   691\t\n   692\t- **TODOs**: %d\n   693\t- **FIXMEs**: %d\n   694\t- **Panics**: %d\n   695\t- **Stubs**: %d\n   696\t`, state.ComponentSlug, state.Path, state.Path, state.DiscoveredAt, state.BaselineCommit, state.Metrics.LOCProduction, state.Metrics.LOCTests, state.Metrics.TotalFiles, langs, state.TechnicalDebt.TODOs, state.TechnicalDebt.FIXMEs, state.TechnicalDebt.Panics, state.TechnicalDebt.Stubs, state.ComponentSlug, state.Path, s.projectLabel(), state.Status, state.CompletenessScore*100, state.TechnicalDebt.TODOs, state.TechnicalDebt.FIXMEs, state.TechnicalDebt.Panics, state.TechnicalDebt.Stubs)\n   697\t\n   698\t\tmd += componentScanScopeMarkdown(state)\n   699\t\tfile := filepath.Join(dir, filename)\n   700\t\treturn os.WriteFile(file, []byte(md), 0o644)\n   701\t}\n   702\t\n   703\t// ScanIncomplete reports a component whose scan lost files. A state stored before the\n   704\t// scan recorded its coverage has no losses and is not reported as incomplete.\n   705\tfunc (c ComponentDiscoveryState) ScanIncomplete() bool { return len(c.Coverage.Losses) > 0 }\n   706\t\n   707\t// Why a persisted component state could not be used, so a consumer can tell a file it could\n   708\t// not open from one that is not JSON, one of a format it does not read and one that names\n   709\t// no component.\n   710\tvar (\n   711\t\tErrComponentStateParse       = errors.New(\"pose: the component state is not valid JSON\")\n   712\t\tErrComponentStateUnsupported = errors.New(\"pose: the component state has a schema_version this engine does not read\")\n   713\t\tErrComponentStateInvalid     = errors.New(\"pose: the component state is not a valid record\")\n   714\t)\n   715\t\n","exit_code":0,"status":"completed"}}
