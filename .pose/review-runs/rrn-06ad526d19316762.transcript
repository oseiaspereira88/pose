t_test.go:29:\treplayed, err := captureGovernanceGit(store.fsys(), root, \"git-test\", \"rev-parse\", \"--verify\", \"HEAD\")\npose-mcp/internal/pose/governance_read_view_git_test.go:106:\t\tout, err := captureGovernanceGit(store.fsys(), root, \"git-budget\", \"status\")\npose-mcp/internal/pose/governance_read_view_git.go:75:// captureGovernanceGit runs a Git command through the read-view generation\npose-mcp/internal/pose/governance_read_view_git.go:78:func captureGovernanceGit(files Files, root, producer string, args ...string) ([]byte, error) {\npose-mcp/internal/pose/governance_read_view_git.go:79:\treturn captureGovernanceGitBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\npose-mcp/internal/pose/governance_read_view_git.go:88:\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\npose-mcp/internal/pose/governance_read_view_git.go:90:\treturn captureGovernanceGitBounded(files, root, producer, maxOutputBytes, args...)\npose-mcp/internal/pose/governance_read_view_git.go:103:\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\npose-mcp/internal/pose/governance_read_view_git.go:105:\treturn captureGovernanceGitBoundedContext(files, ctx, root, producer, maxOutputBytes, args...)\npose-mcp/internal/pose/governance_read_view_git.go:114:func captureGovernanceGitBounded(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\npose-mcp/internal/pose/governance_read_view_git.go:115:\treturn captureGovernanceGitBoundedContext(files, context.Background(), root, producer, maxOutputBytes, args...)\npose-mcp/internal/pose/governance_read_view_git.go:118:func captureGovernanceGitBoundedContext(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\npose-mcp/internal/pose/governance_read_view_git.go:142:\traw, err := captureGovernanceGit(files, root, producer, \"rev-parse\", \"--verify\", \"HEAD\")\npose-mcp/internal/pose/governance_read_view_git.go:163:\tout, err := captureGovernanceGit(files, root, producer, args...)\npose-mcp/internal/pose/governance_read_view_git.go:206:\traw, err := captureGovernanceGitBounded(files, root, producer, commitPathsMaxOutput, \"diff-tree\", \"--root\", \"--no-commit-id\", \"--name-only\", \"--no-renames\", \"-r\", \"-z\", commit)\npose-mcp/internal/pose/governance_read_view_git.go:222:\ttop, err := captureGovernanceGit(files, root, producer, \"rev-parse\", \"--show-toplevel\")\npose-mcp/internal/pose/governance_read_view_git.go:238:\tgitDir, err := captureGovernanceGit(files, root, producer, \"rev-parse\", \"--absolute-git-dir\")\npose-mcp/internal/pose/git_snapshot_budget_test.go:47:\tentries, err := dispatchDiskSnapshot(root)\npose-mcp/internal/pose/git_snapshot_budget_test.go:63:\tif _, err := dispatchDiskSnapshot(root); err == nil || !strings.Contains(err.Error(), \"budget\") {\npose-mcp/internal/pose/git_snapshot_integrity.go:63:func dispatchDiskSnapshot(root string) (map[string]string, error) {\npose-mcp/internal/pose/review_dispatch.go:879:\tdiskBefore, err := dispatchDiskSnapshot(worktree)\npose-mcp/internal/pose/review_dispatch.go:1088:\t\tafter, err := dispatchDiskSnapshot(worktree)\npose-mcp/internal/pose/review_dispatch.go:1103:\tdiskAfter, err := dispatchDiskSnapshot(worktree)\npose-mcp/internal/pose/claude_sandboxed_review_test.go:279:\tbefore, err := dispatchDiskSnapshot(filepath.Join(dir, \"worktree\"))\npose-mcp/internal/pose/claude_sandboxed_review_test.go:292:\tafter, err := dispatchDiskSnapshot(filepath.Join(dir, \"worktree\"))\npose-mcp/internal/pose/git_snapshot_integrity_test.go:425:\tdisk, err := dispatchDiskSnapshot(root)\n\t\t\treturn nil, err\n\t\t}\n\t\tfor _, path := range bytes.Split(out, []byte{0}) {\n\t\t\ttracked[string(path)] = true\n\t\t}\n\t}\n\tseen := map[string]bool{}\n\tresult := []string{}\n\tfor _, path := range changed {\n\t\t_, regularErr := dispatchRegularInputPath(root, path)\n\t\tif seen[path] || (allowed != nil && allowed(path, tracked[path]) && regularErr == nil) {\n\t\t\tcontinue\n\t\t}\n\t\tseen[path] = true\n\t\tresult = append(result, path)\n\t}\n\tsort.Strings(result)\n\treturn result, nil\n}\n\nfunc gitCommand(args ...string) *exec.Cmd {\n\treturn gitCommandContext(context.Background(), args...)\n}\n\n// gitCommandContext is gitCommand under ctx. Both read raw object history: a\n// replace ref or a graft changes what a commit is, and every gate has to judge\n// the same commit (spec pose-history-readers-read-raw R1, D1).\nfunc gitCommandContext(ctx context.Context, args ...string) *exec.Cmd {\n\t// The graft file below is the null device, and Git hints at any graft file on\n\t// stderr, which a caller that reads stderr as uncertainty would take for a failure.\n\tcmd := exec.CommandContext(ctx, \"git\", append([]string{\"-c\", \"advice.graftFileDeprecated=false\"}, args...)...)\n\tenv := make([]string, 0, len(os.Environ())+2)\n\tfor _, kv := range os.Environ() {\n\t\tname, _, _ := strings.Cut(kv, \"=\")\n\t\tif !gitRedirectingEnv[name] {\n\t\t\tenv = append(env, kv)\n\t\t}\n\t}\n\tcmd.Env = append(env, \"GIT_NO_REPLACE_OBJECTS=1\", \"GIT_GRAFT_FILE=\"+os.DevNull)\n\treturn cmd\n}\n\nconst (\n\tgitEmptyTreeSHA1   = \"4b825dc642cb6eb9a060e54bf8d69288fbee4904\"\n\tgitEmptyTreeSHA256 = \"6ef19b41225c5369f1c104d45d8d85efa9b057b53b14b4b9b939dd74decc5321\"\n)\n\n// GitEmptyTree is the empty tree in commit's object format: the base of a change\n// set that starts at a repository's first commit (spec\n// pose-history-readers-read-raw R2, D2).\nfunc GitEmptyTree(commit string) string {\n\tif len(commit) == len(gitEmptyTreeSHA256) {\n\t\treturn gitEmptyTreeSHA256\n\t}\n\treturn gitEmptyTreeSHA1\n}\n\n// IsGitEmptyTree says that revision is the base of such a change set.\nfunc IsGitEmptyTree(revision string) bool {\n\treturn revision == gitEmptyTreeSHA1 || revision == gitEmptyTreeSHA256\n}\n1:artifact.spec=pose-git-snapshot-budget-scales-with-the-tree\n2:artifact.change_set=cs-b1dd2f00e2a4\n3:artifact.change_set.base=ca66b779b3c83932c3273427ad1cd8c3c7a40a98\n4:artifact.change_set.head=8aec6924317827bb51e67aaae0a21365dba46e65\n5:artifact.change_set.commits=7\n6:artifact.diff_digest=sha256:78aa132f8a1311817236029acf4f0d240c81d97c2fea20f2a8e37e03c3dc19b4\n7:artifact.claims=3\n8:artifact.observed=9\n9:artifact.findings=976\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/specs/2026-11-16-pose-git-snapshot-budget-scales-with-the-tree.md .pose/rules/backend-go.md .pose/rules/knowledge-governance.md; sed -n '75,142p' pose-mcp/internal/pose/governance_read_view_git.go; rg -n 'CaptureGit|captureGit|OutputLimit|output limit' pose-mcp/internal/pose/governance_read_view*.go; sed -n '840,920p' pose-mcp/internal/pose/review_dispatch.go; sed -n '1060,1135p' pose-mcp/internal/pose/review_dispatch.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/specs/2026-11-16-pose-git-snapshot-budget-scales-with-the-tree.md .pose/rules/backend-go.md .pose/rules/knowledge-governance.md; sed -n '75,142p' pose-mcp/internal/pose/governance_read_view_git.go; rg -n 'CaptureGit|captureGit|OutputLimit|output limit' pose-mcp/internal/pose/governance_read_view*.go; sed -n '840,920p' pose-mcp/internal/pose/review_dispatch.go; sed -n '1060,1135p' pose-mcp/internal/pose/review_dispatch.go\"","aggregated_output":"---\nslug: pose-git-snapshot-budget-scales-with-the-tree\nstatus: in-progress\ncreated_at: 2026-11-16\ncompleted_at:        # stamped on the transition to status: done\nsupersedes:          # slug of the superseded spec (when applicable)\ndepends_on:          # prerequisites, inline list: other-spec, milestone:<roadmap>/<id>, roadmap:<slug>\nremediates:          # optional explicit links: spec:slug@defect-fix, finding:rva-<16hex>/F1@revert (never inferred from depends_on)\npriority:            # integer >= 0 (lower = higher priority); ordering preference, not a blocker\ncomponents: pose-mcp\ntask_type: bugfix\nsurface:             # optional: minimal | standard | full (default) — minimal drops Tasks and derivable report sections; `pose specs facts <slug>` derives them\ndelivers: capability:git-snapshot-budget-scales-with-the-tree\n---\n\n# Spec: pose-git-snapshot-budget-scales-with-the-tree\n\n## 1. Intent\n\n### Goal\nFazer o orçamento de bytes das capturas de Git que comparam o disco com a árvore commitada crescer com o tamanho dessa árvore, em vez de ficar num teto fixo de 256 MiB.\n\n### Business value\nA árvore commitada do pose-dist passou de 256 MiB (256,8 MiB; 88 MiB de review runs e 102 MiB de review bundles). Desde então, todo `pose close` falha em `gitMaterializedChangesForIn` com \"snapshot exceeds 256 MiB\", e toda revisão delegada falha na limpeza do worktree descartável, que tira um `dispatchDiskSnapshot` do mesmo tamanho. Duas specs aprovadas ou em revisão (`pose-review-ledger-is-read-once-per-operation`, `pose-doctor-recommends-the-commit-graph`) ficaram sem poder fechar. As duas capturas precisam ler a árvore inteira para responder; um teto abaixo dela só pode reprovar.\n\n### Constraints\n- Um repositório pequeno não pode ganhar um teto menor que o de hoje.\n- O disco que cresceu além da árvore commitada continua reprovando de forma fechada.\n- Um teto absoluto continua existindo.\n\n### Non-goals\n- Reduzir o tamanho do repositório (retenção de registros de revisão antigos).\n- Mudar o limite de 100.000 entradas.\n\n---\n\n## 2. Requirements\n\n### Functional\n- R1: `gitMaterializedChangesForIn` and `dispatchDiskSnapshot` shall bound the bytes they read by the committed tree's blob sizes plus a 256 MiB margin, so a clean tree of any size up to the ceiling is compared and snapshotted whole.\n- R2: When the bytes read exceed that budget, both shall fail closed with an error that names the budget.\n- R3: The budget shall never be less than the 256 MiB margin and never more than a 4 GiB ceiling; when the committed tree cannot be listed, the disk snapshot shall use the margin alone.\n\n### Non-functional\n- A listagem da árvore com tamanhos sai do mesmo `ls-tree` que a comparação já fazia; a captura de disco faz um `ls-tree -l` a mais.\n\n### Security\n- O teto absoluto de 4 GiB limita o trabalho de uma captura; o disco que cresceu além da árvore mais a margem continua reprovando.\n\n### Compatibility\n- Para um repositório de até 256 MiB commitados o teto só cresce; nada que passava passa a reprovar.\n\n---\n\n## 3. Technical Plan\n\n### Affected areas\n- `pose/git_snapshot_integrity.go`: o orçamento das duas capturas.\n\n### Artifacts\n- created: pose-mcp/internal/pose/git_snapshot_budget_test.go\n- modified: pose-mcp/internal/pose/git_snapshot_integrity.go\n- modified: .pose/indexes/validation-matrix.json\n\n### Delivery targets\n\n- capability:git-snapshot-budget-scales-with-the-tree module:pose-mcp profile:composed-capability entrypoint:pose-mcp/cmd/pose/main.go\n\nComposto em produção pelo `pose close` (passo do plano de fechamento que procura mudanças escondidas) e pela limpeza de toda revisão delegada. Check permanente `git-snapshot-budget-scales-with-the-tree-integration`, evidenceClass `integration`, required: `go test ./internal/pose -run 'TestGitSnapshotBudget' -count=1`.\n\n### API/contract changes\n- Nenhuma.\n\n### Data/storage changes\n- Nenhuma.\n\n### Technical risks\n- Um repositório acima de 3,75 GiB commitados volta a reprovar no teto; isso fica para uma spec de retenção.\n\n---\n\n## 4. Tasks\n\n### Implementation\n- [x] Orçamento escalonado nas duas capturas (R1, R2, R3).\n\n### Validation\n- [x] Testes com margem reduzida, árvore maior que ela e disco crescido, com prova de reprovação.\n\n---\n\n## 5. Decisions\n\n### Decision D1\n- Date: 2026-11-16\n- Context: o maintainer escolheu, entre escalonar com a árvore, subir a constante para 1 GiB e retenção dos registros de revisão, escalonar com a árvore.\n- Options considered: (a) orçamento proporcional à árvore commitada, com margem e teto; (b) constante fixa de 1 GiB; (c) retenção de registros antigos.\n- Decision: (a), margem de 256 MiB e teto de 4 GiB.\n- Basis: R1, R2, R3\n- Rationale: (b) volta a quebrar quando a árvore passar de 1 GiB; (c) muda dado governado e é mais lenta para destravar; (a) segue o trabalho que a captura precisa fazer e mantém a reprovação para o disco que cresceu.\n- Consequences: o custo de uma captura cresce com o repositório, como já crescia o trabalho necessário.\n\n---\n\n## 6. Validation\n\n### Strategy\nTestes com um repositório real de quatro arquivos de 4 KiB e a margem reduzida a 1 KiB, de modo que a árvore commitada passa da margem, como a do pose-dist passou de 256 MiB.\n\n### Deterministic checks\n\n#### Test\n- Command: `go test ./internal/pose ./internal/cli ./internal/mcpserver ./internal/scaffold -count=1`\n- Scope: pose-mcp\n- Expected: verde\n\n### Execution log\n- Date: 2026-11-16\n- Environment: Linux, Go 1.26, Git 2.56.\n- Notes: com o teto antigo (só a margem), o teste da árvore inteira reprova com \"snapshot exceeds its budget of 1024 bytes\"; com o orçamento escalonado passa, e um arquivo que cresce 60 KiB além da árvore reprova nas duas capturas. Os fechamentos de `pose-review-ledger-is-read-once-per-operation` e `pose-doctor-recommends-the-commit-graph` reprovaram com \"snapshot exceeds 256 MiB\" sobre a árvore de 256,8 MiB do pose-dist.\n\n### Results summary\n- Successes: as duas capturas cobrem uma árvore maior que a margem e continuam reprovando o disco crescido.\n- Failures: nenhuma.\n- Warnings: nenhum.\n\n### Requirement trace\n- R1 [satisfied] test:TestGitSnapshotBudgetCoversTheCommittedTree check:git-snapshot-budget-scales-with-the-tree-integration\n- R2 [satisfied] test:TestGitSnapshotBudgetStillBoundsGrowth\n- R3 [satisfied] test:TestGitSnapshotBudgetIsBounded\n\n### Known gaps\n- O caso de a listagem da árvore falhar na captura de disco usa só a margem, sem teste próprio.\n\n---\n\n## 7. Final Report\n\n### Delivered scope\n\nNão concluída.\n\n### Residual risks\n\n### Follow-ups\n\n- [open] F1: decidir a retenção dos registros de revisão, que somam 190 MiB dos 256,8 MiB da árvore do pose-dist e crescem a cada rodada. (owner:@pose-maintainers crit:medium review:2026-11-30)\n# Rule: Backend Go\n\n## When to consult\n\nConsult this guide for HTTP handlers, domain services, persistence, concurrency, and integrations between Go services.\n\n## Required patterns\n\n- Handle and propagate errors with enough context for diagnosis.\n- Validate handler input and return HTTP status codes consistent with the contract.\n- Keep business rules in service or domain layers, not in transport code.\n- Honor `context.Context` for timeouts and cancellation.\n- Put data access behind clear interfaces that support testing.\n- Use structured logs without exposing sensitive data.\n\n## Blocking anti-patterns\n\n- Ignoring error returns, including `_` for critical errors.\n- Using `panic` in ordinary request flows instead of controlled error handling.\n- Coupling handlers directly to concrete repository implementations without an abstraction.\n- Running unbounded or unpaginated queries in potentially large endpoints.\n- Introducing concurrency without adequate synchronization or race protection.\n\n## Minimum checks\n\n- Run `go test ./...` in the affected scope.\n- Run `go test -race ./...` when concurrency changes.\n- Run `go vet ./...` without blocking findings.\n- Run the applicable Go lint check, such as `golangci-lint`, without critical errors.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Knowledge Governance\n\n## When to consult\n\nConsult this guide when creating, updating, reviewing, or removing artifacts under `.pose/knowledge/`.\n\n## TTL and retention\n\n- Set `expires_at` on every artifact when it is created.\n- Use a default TTL of 30 days for notes, decision logs, and handoffs.\n- Use a TTL of up to 90 days only with a justification recorded in the artifact body.\n- Treat an artifact without `expires_at` as non-compliant and block its creation or merge.\n\n## When this is not the right home\n\n- Use `.pose/knowledge/` only for time-bound operational memory: content\n  tied to a decision moment, a handoff between executions, or something\n  meant to be reviewed and eventually expire.\n- A durable fact or convention that will not become false and carries no\n  review trigger — a third-party tool's parsing quirk, a naming\n  convention, a recurring gotcha — is not a `decision-log` just because no\n  better type exists. Route it to `.pose/rules/` instead: add it to an\n  existing rule file or create one, then wire it into the relevant task\n  type's base `rules` array in `.pose/indexes/task-map.json` so\n  `pose suggest <task>` surfaces it automatically. No path scoping is\n  required — a task type's base `rules` list is returned regardless of\n  `--path`; only language/component-specific rules need the\n  `rules_by_domain` layer.\n- Rule of thumb: if nothing was decided or traded off, and nothing about\n  the fact will change on a predictable timeline, it is not a\n  `decision-log` and not an ADR — it is a rule. See ADR\n  `2026-08-15-durable-non-architectural-knowledge-belongs-in-rules-not-a-new-type`.\n\n## Reusable cross-execution format\n\n- Structure reusable context as a handoff with fixed sections: Context, Current state, Next checks, Risks, and Next owner.\n- Keep `source_refs` linked to the relevant spec, workflow, and executed check commands.\n- Record `last_reviewed_at` in the body to make effective cross-execution updates traceable.\n\n## Archiving and purging\n\n- Run biweekly triage to list expired artifacts.\n- Move expired artifacts to `.pose/knowledge/archive/` when they retain audit value.\n- Purge archived artifacts 180 days after expiration unless documented legal or compliance requirements apply.\n- Record every archive and purge action in the housekeeping log.\n\n## Sensitive content\n\n- Prohibit secrets, tokens, credentials, private keys, and equivalent material.\n- Prohibit personal data and non-anonymized customer data.\n- Do not copy restricted incidents or reports in full; keep only a controlled reference.\n- Classify frontmatter `sensitivity` as `public-internal` or `restricted`.\n- Remove identified sensitive content immediately and open a security follow-up.\n\n## Ownership and review\n\n- Keep `@pose-maintainers` as the primary governance owner.\n- Require an owner in every artifact frontmatter.\n- Review expiration biweekly and quality monthly.\n- Escalate a backlog overdue by more than two cycles to the primary owner.\n- Block backlog growth when `list-expired` exceeds the operational limit: zero in strict mode, two in tolerant mode.\n\n## Minimum operational checks\n\n- Run `pose knowledge-check --strict` biweekly to validate the expired backlog.\n- Run `pose knowledge-housekeeping list-expired` for detailed triage.\n- Run `pose knowledge-housekeeping archive-expired --dry-run` before applying changes.\n- Execute destructive actions only with an explicit `--apply` flag.\n// captureGovernanceGit runs a Git command through the read-view generation\n// when Files belongs to one. Native and preview operations retain their\n// existing behavior when there is no governance view.\nfunc captureGovernanceGit(files Files, root, producer string, args ...string) ([]byte, error) {\n\treturn captureGovernanceGitBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\n}\n\n// CaptureGovernanceGitIn executes one bounded raw-history Git command through\n// the operation's captured read view when Files carries one. maxOutputBytes\n// bounds combined stdout and stderr before bytes are retained. Git commands\n// use gitCommand, which disables replacement refs and grafts.\nfunc CaptureGovernanceGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n\t}\n\treturn captureGovernanceGitBounded(files, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceRawHistoryGitIn names the history semantics explicitly for\n// callers whose result depends on raw commit ancestry or object contents.\nfunc CaptureGovernanceRawHistoryGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn CaptureGovernanceGitIn(files, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceGitContextIn is CaptureGovernanceGitIn under ctx. The same\n// context is retained for the final audit rerun.\nfunc CaptureGovernanceGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n\t}\n\treturn captureGovernanceGitBoundedContext(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceRawHistoryGitContextIn names raw history semantics for\n// context-bound callers that inspect commit ancestry or object contents.\nfunc CaptureGovernanceRawHistoryGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn CaptureGovernanceGitContextIn(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceGitBounded(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn captureGovernanceGitBoundedContext(files, context.Background(), root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceGitBoundedContext(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tfiles = FilesOrNative(files)\n\tview, viewFiles := governanceReadViewFromFiles(files)\n\tif view == nil {\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif view.operation == nil {\n\t\tview.markUnknown(producer, \"Git input has no operation-scoped generation vector\")\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif viewFiles != nil {\n\t\tproject := viewFiles.project\n\t\tif target := view.route(root, producer, project); target == nil {\n\t\t\tview.markUnknown(producer, \"Git input is outside the authorized root generation vector\")\n\t\t\treturn nil, errGovernanceReadViewOutsideRoot\n\t\t} else {\n\t\t\tview = target\n\t\t}\n\t}\n\treturn view.operation.captureFilesBoundedContext(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceSourceRevision(files Files, root, producer string) (string, error) {\n\tproducer = governanceProducerFromFiles(files, producer)\n\traw, err := captureGovernanceGit(files, root, producer, \"rev-parse\", \"--verify\", \"HEAD\")\npose-mcp/internal/pose/governance_read_view_stream.go:58:\t\treturn fmt.Errorf(\"pose: streamed Git output limit must be between 1 and %d bytes\", governanceReadViewMaxStreamedRead)\npose-mcp/internal/pose/governance_read_view_git.go:88:\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\npose-mcp/internal/pose/governance_read_view_git.go:103:\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\npose-mcp/internal/pose/governance_read_view_git.go:565:\t\tOutputLimit  int64    `json:\"output_limit\"`\npose-mcp/internal/pose/governance_read_view_git.go:576:\t\t\tOutputLimit:  item.maxOutputBytes,\npose-mcp/internal/pose/governance_read_view_git.go:585:\t\t\tOutputLimit:  item.maxBytes,\npose-mcp/internal/pose/governance_read_view_git.go:598:\t\treturn items[i].OutputLimit < items[j].OutputLimit\n\t}\n\townership, err = s.captureReviewCleanupOwnership(runtimeRoot, worktree, gitMarker)\n\tif err != nil {\n\t\treturn finish(ReviewRunFailed, \"worktree registration ownership unavailable\")\n\t}\n\tdefer ownership.registry.Close()\n\n\tsubmodules := map[string]bool{}\n\tfor _, entry := range plan.Bundle.Payload.Subject.Entries {\n\t\tif entry.Class == \"submodule\" {\n\t\t\tsubmodules[reviewBundleEntryPath(entry)] =