reenUnitEvidenceForUnreachableSurface(t *testing.T) {\npose-mcp/internal/cli/surface_check_test.go:65:func TestSurfaceCheckAcceptsCurrentReachabilityAndIntegration(t *testing.T) {\npose-mcp/internal/cli/surface_check_test.go:85:func TestSurfaceCheckRejectsStaleEvidenceAndEscapingResultPath(t *testing.T) {\npose-mcp/internal/cli/surface_check_test.go:142:func TestSurfaceCheckReadsSmokeObservationsPerTarget(t *testing.T) {\npose-mcp/internal/cli/review_domain_preflight_test.go:82:\t\tcase \"artifact-check\":\npose-mcp/internal/cli/artifact_integrity_test.go:70:func TestArtifactCheckMatchesExplicitGitChangeSetAndRejectsUnsafeRevision(t *testing.T) {\npose-mcp/internal/cli/artifact_integrity_test.go:95:func TestArtifactCheckPrintsChangeSetProvenanceWithoutJSON(t *testing.T) {\npose-mcp/internal/cli/artifact_integrity_test.go:112:func TestArtifactCheckFindsUndeclaredAndActionMismatch(t *testing.T) {\npose-mcp/internal/cli/artifact_integrity_test.go:129:func TestArtifactCheckMatchesRenameWithEditAndRemoval(t *testing.T) {\npose-mcp/internal/cli/artifact_integrity_test.go:160:func TestArtifactCheckReconcilesRecordedReleaseRename(t *testing.T) {\npose-mcp/internal/cli/artifact_integrity_test.go:358:func TestArtifactCheckNoneActionClaimTolerance(t *testing.T) {\npose-mcp/internal/cli/artifact_integrity_test.go:383:func TestArtifactCheckHonorsRecordedChangeSets(t *testing.T) {\npose-mcp/internal/cli/artifact_integrity.go:783:func cmdArtifactCheck(root string, args []string, stdout, stderr io.Writer) int {\npose-mcp/internal/cli/cli.go:302:\t\tcase \"artifact-check\":\n    35\t---\n    36\t\n    37\t## 2. Requirements\n    38\t\n    39\t### Functional\n    40\t- R1: `gitMaterializedChangesForIn` and `dispatchDiskSnapshot` shall bound the bytes they read by the committed tree's blob sizes plus a 256 MiB margin, so a clean tree of any size up to the ceiling is compared and snapshotted whole.\n    41\t- R2: When the bytes read exceed that budget, both shall fail closed with an error that names the budget.\n    42\t- R3: The budget shall never be less than the 256 MiB margin and never more than a 4 GiB ceiling; when the committed tree cannot be listed, the disk snapshot shall use the margin alone.\n    43\t\n    44\t### Non-functional\n    45\t- A listagem da árvore com tamanhos sai do mesmo `ls-tree` que a comparação já fazia; a captura de disco faz um `ls-tree -l` a mais.\n    46\t\n    47\t### Security\n    48\t- O teto absoluto de 4 GiB limita o trabalho de uma captura; o disco que cresceu além da árvore mais a margem continua reprovando.\n    49\t\n    50\t### Compatibility\n    51\t- Para um repositório de até 256 MiB commitados o teto só cresce; nada que passava passa a reprovar.\n    52\t\n    53\t---\n    54\t\n    55\t## 3. Technical Plan\n    56\t\n    57\t### Affected areas\nentries 8236 blob_bytes 269284846 budget_bytes 537720302\n","exit_code":0,"status":"completed"}}
