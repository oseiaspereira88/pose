nifest\": \"sha256:3ee3f2e0ec2a416c52b30528ee6d0ae1aeb730e0c03637e966fcd2d56ea79492\",\n    \"pose-closeout-names-the-missing-trailer\": \"sha256:a8652bfc85049fcd43d4e9806b424c0c37d20bcaf929ffe06ab38a472ffb1dce\",\n    \"pose-closeout-regenerates-before-sealing\": \"sha256:c8871881c6bac1fd2f6b0fe589ecbe2e35b70e9b4f19a94419b2e3ae0e48b06c\",\n    \"pose-closeout-review-policy-by-cost-benefit\": \"sha256:a7fbdcf9ea4f9433882e42e1a1e23c9e1f1719054c274c8a2ec4a378074dc2f5\",\n    \"pose-closeout-terminal-verification\": \"sha256:c5f7b564d44432bd0e9669e7f1576ca3424ca5d4c6359665b1181b0d7391efcf\",\n    \"pose-code-cites-the-specs-that-delivered-it\": \"sha256:59d17154e679b26df3b9df0a854974a9a0f3beb8c05697333966843d93aecdae\",\n    \"pose-command-reference-parity\": \"sha256:ed09a632389cadaf2754de2ddfc603a4e47725d6cd04143dbbeb2085b7388abe\",\n    \"pose-commit-gate-refuses-index-without-descriptor\": \"sha256:a79c68c5fe89e68ee0c889bb9017cb5972f4dff860faaba58907f34f19c9cb9c\",\n    \"pose-common-domain-and-cli-mcp-handoff\": \"sha256:b3b8f7c10fb37c89c40cd1a51c6bd721b08942edb52f2660645efd8cfa979015\",\n    \"pose-community-claims-hold\": \"sha256:5e473cb0e0a77f747fc939d75e194d5fb276d5801ea4cfb38f2ad4275848e24b\",\n    \"pose-community-contribution-surfaces\": \"sha256:7a4d92187b213a4456d6a380f1d2810a3fdf8fa47a2f06e9d0e9f2851423de76\",\n    \"pose-compat-fixture-delivery-example\": \"sha256:bd923c5905049be17684910e30732fefb3ac0298763f3f91d8665a352c26ce7a\",\n    \"pose-compat-gate-candidate-integrity\": \"sha256:2f92f7cac45691afcc491be6b6ac4647326c246a12939c05b64a228ce6f8cd92\",\n    \"pose-compat-gate-manual-refresh-assertion\": \"sha256:71f3d0fa22896a4cef17ba5de72fced97b5017ad05e02b5517a604208adf1996\",\n    \"pose-compat-gate-pose-md-preservation\": \"sha256:394b256c95906dd1cce1befab62d151d83b8d5bb5f68b920b5f236a723fb2bcb\",\n    \"pose-component-aware-review-plans\": \"sha256:00562a441eb384b458b55a596fd007e5ecc27ec72e930da40910fc5572bc4857\",\n    \"pose-component-evidence-is-not-inherited-upward\": \"sha256:356a1e0c8d59cca187e6d7ddaf623c25f5c498d9f8d103a44541c5d5caa3a025\",\n    \"pose-composition-contract\": \"sha256:c98a8ea45430a46a83d32441b51dd2fad791266c4bb2623d28ac3c383c2e7161\",\n    \"pose-configuration-review-7-1-0\": \"sha256:056e6810ecdc4741b5994cac83bd559b2f2e18b5eac91a829a53b8a9069a847c\",\n    \"pose-consolidation-batch-1-authoring\": \"sha256:07af2f59179897c7955c7a1ff941a0c3052c841e5b62feec100cbfea798e2f46\",\n    \"pose-consolidation-batch-10-authoring\": \"sha256:2d7d35ea70fc0ab2b2c9b192a5c8263f4cd7c8f0a3108aa1fd28856eaa5e8e2d\",\n    \"pose-consolidation-batch-11-authoring\": \"sha256:7a71b89c14fe844aa86842fb4c3de3cbf3d60ad9e69c209482fa98c8c3384518\",\n    \"pose-consolidation-batch-12-authoring\": \"sha256:3193b685327669c6543fd871a00fde307eaa3a7564bea403154989bfe78b39f8\",\n    \"pose-consolidation-batch-13-authoring\": \"sha256:f98bf52bfe37bcfd293b12200bca9431a309cc0c5a30448597d8124937920737\",\n    \"pose-consolidation-batch-14-authoring\": \"sha256:56bb91b72190e61ad08a8ef8f5db679fe9073167dd760bdb7c80791c37e7f908\",\n    \"pose-consolidation-batch-15-authoring\": \"sha256:6029ec868e376241d1c30007140e541fb8444d1523f606d41ae74fc6661f0018\",\n    \"pose-consolidation-batch-2-authoring\": \"sha256:3ee0c1952d05e3eac4a1ba5edd27cafefbf8a222991d90ef963612008f93c319\",\n    \"pose-consolidation-batch-3-authoring\": \"sha256:7853bcb0e53224cf18451e7fa8c8d5f3a09b9bd00852f79d981b8b6aaa0d9768\",\n    \"pose-consolidation-batch-4-authoring\": \"sha256:43b97d9effe5f1a50f1a6ad719f61b667d32fbbbedf684c12579b8899900f515\",\n    \"pose-consolidation-batch-5-authoring\": \"sha256:a5f263b55d1ff84aa04611b5107e2e31ec9bd78542bc94824ea3edbd0f947a2d\",\n    \"pose-consolidation-batch-6-authoring\": \"sha256:19b5006dea710962c83a1c940e956eaf4e0b44befd4a0692db8d2cdd2cc332e8\",\n    \"pose-consolidation-batch-7-authoring\": \"sha256:7040f327e27ab5cf85d1e9ad940407f15a8a6011d0475f9e81d5d7cb7b8b4bb4\",\n    \"pose-consolidation-batch-8-authoring\": \"sha256:fa88376460b83451597b316a5c4a9c0466d4dd03fe8762fe100b92fdfd13398a\",\n    \"pose-consolidation-batch-9-authoring\": \"sha256:6f5982ac35adefc318330fecae460b18b327d00f90b580a474845dd0d29e66a1\",\n    \"pose-consolidation-program-bootstrap\": \"sha256:911d55b25d3844cb3574d58014578f60c0c616455d2e4442c38522c43486de62\",\n    \"pose-container-build-gate\": \"sha256:e73b00446c52d12a03e70a8c583aa52ace9e172f812d7137ef644532e09125bb\",\n    \"pose-contract-adoption-registry\": \"sha256:abd5448857ba00a9760e5fc445e7d9e43168eb113bb0567ba900a9e5d7962bd0\",\n    \"pose-contract-adoption-stamp\": \"sha256:1c19dbd711cb4c22f09d10937ab2722f7e971ed5bd550df6b0c90b8c13c99449\",\npackage pose\n\nimport (\n\t\"errors\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"reflect\"\n\t\"runtime\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc TestGitSnapshotPathsUseNULIncludingRename(t *testing.T) {\n\twant := []string{\"new -> \\\"á\\\"\\n.go\", \"old name.go\", \"tab\\t.go\"}\n\tgot, err := parseGitChangedPaths([]byte(\"R  new -> \\\"á\\\"\\n.go\\x00old name.go\\x00?? tab\\t.go\\x00\"))\n\tif err != nil || !reflect.DeepEqual(got, want) {\n\t\tt.Fatalf(\"paths: %q %v\", got, err)\n\t}\n\tfor _, raw := range []string{\" M file\", \"R  new\\x00\", \"bad\\x00\"} {\n\t\tif _, err := parseGitChangedPaths([]byte(raw)); err == nil {\n\t\t\tt.Fatalf(\"accepted %q\", raw)\n\t\t}\n\t}\n}\n\nfunc TestGitSnapshotUnavailableIsTyped(t *testing.T) {\n\t_, err := gitChangedPaths(t.TempDir())\n\tvar unavailable *GitSnapshotError\n\tif !errors.As(err, &unavailable) {\n\t\tt.Fatalf(\"not typed: %v\", err)\n\t}\n\tif _, err := gitMaterializedChanges(t.TempDir(), \"HEAD\"); !errors.As(err, &unavailable) {\n\t\tt.Fatalf(\"tree not typed: %v\", err)\n\t}\n}\n\nfunc TestGitSnapshotStatusFailurePreservesCause(t *testing.T) {\n\tif runtime.GOOS == \"windows\" {\n\t\tt.Skip(\"POSIX command fixture\")\n\t}\n\tbin := t.TempDir()\n\tif err := os.WriteFile(filepath.Join(bin, \"git\"), []byte(\"#!/bin/sh\\nexit 97\\n\"), 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Setenv(\"PATH\", bin)\n\t_, err := gitChangedPaths(t.TempDir())\n\tvar unavailable *GitSnapshotError\n\tif !errors.As(err, &unavailable) || !strings.Contains(err.Error(), \"exit status 97\") {\n\t\tt.Fatalf(\"cause lost: %v\", err)\n\t}\n}\n\nfunc TestGitSnapshotCloseoutOutputsHaveExactOwners(t *testing.T) {\n\tfor _, path := range []string{\".pose/indexes/validation-matrix.json\", \".pose/results/arbitrary.json\", \".pose/state/arbitrary.json\", \".pose/review-bundles/arbitrary.json\", \".pose/review-bundles/rvb-0123456789abcdef.json\"} {\n\t\tif closeoutProducedPath(path, \"alpha\", \".pose/results/validation.json\", true) {\n\t\t\tt.Fatalf(\"authorized unrelated or immutable output: %s\", path)\n\t\t}\n\t}\n\tfor _, path := range []string{\".pose/indexes/repo-map.json\", \".pose/results/validation.json\", \".pose/closeout-plans/spec-alpha.json\"} {\n\t\tif !closeoutProducedPath(path, \"alpha\", \".pose/results/validation.json\", true) {\n\t\t\tt.Fatalf(\"lost producer output: %s\", path)\n\t\t}\n\t}\n}\n\nfunc TestGitSnapshotAuthorizedGenerationRequiresItsExactBytes(t *testing.T) {\n\troot := t.TempDir()\n\tdesignDeltaGit(t, root, \"init\", \"-q\")\n\tif err := os.WriteFile(filepath.Join(root, \"README.md\"), []byte(\"fixture\\n\"), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdesignDeltaGit(t, root, \"add\", \"-A\")\n\thead := designDeltaGit(t, root, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-qm\", \"fixture\")\n\tstore := Store{Root: root}\n\toutputs := map[string][]byte{}\n\tfor _, name := range IndexGenerationFiles {\n\t\toutputs[name] = []byte(\"{}\\n\")\n\t}\n\tif _, err := store.PublishIndexGeneration(outputs, map[string]string{}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif dirty, err := store.ungeneratedChanges(\"alpha\", head); err != nil || len(dirty) != 0 {\n\t\tt.Fatalf(\"authorized generation: %q %v\", dirty, err)\n\t}\n\tview := store.ReadIndexGeneration()\n\tpath := filepath.ToSlash(filepath.Join(\".pose/indexes/generations\", view.Descriptor.GenerationID, \"repo-map.json\"))\n\tif err := os.WriteFile(filepath.Join(root, filepath.FromSlash(path)), []byte(\"tampered\"), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdirty, err := store.ungeneratedChanges(\"alpha\", head)\n\tif err != nil || !reflect.DeepEqual(dirty, []string{path}) {\n\t\tt.Fatalf(\"tampered generation accepted via legacy fallback: %q %v\", dirty, err)\n\t}\n}\n\nfunc TestGitSnapshotParentLinkIsNotFollowed(t *testing.T) {\n\troot := t.TempDir()\n\tdesignDeltaGit(t, root, \"init\", \"-q\")\n\tif err := os.Mkdir(filepath.Join(root, \"dir\"), 0755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \"dir\", \"file\"), []byte(\"sealed\"), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdesignDeltaGit(t, root, \"add\", \"-A\")\n\tdesignDeltaGit(t, root, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-qm\", \"fixture\")\n\tif err := os.Rename(filepath.Join(root, \"dir\"), filepath.Join(root, \"saved\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Symlink(filepath.Join(root, \"saved\"), filepath.Join(root, \"dir\")); err != nil {\n\t\tt.Skip(err)\n\t}\n\tgot, err := gitMaterializedChanges(root, \"HEAD\")\n\tif err != nil || !reflect.DeepEqual(got, []string{\"dir/file\"}) {\n\t\tt.Fatalf(\"parent link: %q %v\", got, err)\n\t}\n\tif _, err := dispatchInputPath(root, \"dir/file\"); err == nil {\n\t\tt.Fatal(\"dispatch followed a parent link\")\n\t}\n}\n\nfunc TestGitSnapshotSubmoduleHiddenEditIsNotClean(t *testing.T) {\n\tchild, root := t.TempDir(), t.TempDir()\n\tfor _, dir := range []string{child, root} {\n\t\tdesignDeltaGit(t, dir, \"init\", \"-q\")\n\t}\n\tif err := os.WriteFile(filepath.Join(child, \"file\"), []byte(\"sealed\"), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdesignDeltaGit(t, child, \"add\", \"-A\")\n\tdesignDeltaGit(t, child, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-qm\", \"child\")\n\tdesignDeltaGit(t, root, \"-c\", \"protocol.file.allow=always\", \"submodule\", \"add\", \"-q\", child, \"nested\")\n\tdesignDeltaGit(t, root, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"-c\", \"commit.gpgsign=false\", \"commit\", \"-qam\", \"root\")\n\tif got, err := gitMaterializedChanges(root, \"HEAD\"); err != nil || len(got) != 0 {\n\t\tt.Fatalf(\"control: %q %v\", got, err)\n\t}\n\tchildHead := designDeltaGit(t, child, \"rev-parse\", \"HEAD\")\n\tbundle := ReviewBundle{Payload: ReviewBundlePayload{Subject: ReviewBundleSubject{Entries: []ReviewBundleSubjectEntry{{Class: \"submodule\", Path: \"nested\", Digest: digestBytes([]byte(childHead))}}}}}\n.pose/knowledge/2026-10-20-handoff-pose-b07-implementation.md:10:  spec: \"spec:pose-git-and-dispatch-snapshot-integrity\"\n.pose/knowledge/2026-10-20-handoff-pose-b07-implementation.md:20:B07 retomada e reconciliada com a história completa do PR #195. Implementação explicitamente autorizada pelo mantenedor; branch canônica de trabalho `impl/pose-b07-git-snapshot-integrity`.\n.pose/knowledge/2026-10-20-handoff-pose-b07-implementation.md:33:1. Canonical worktree: /tmp/pose-b07-closeout-work, branch impl/pose-b07-git-snapshot-integrity. Merge a4c58e9 preserves the full PR195 history through 23643a2 and the original native start. Do not overwrite concurrent documentation changes in the shared checkout.\n.pose/knowledge/2026-10-20-handoff-pose-b07-implementation.md:52:- [Spec](../specs/2026-10-13-pose-git-and-dispatch-snapshot-integrity.md).\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '610,700p' pose-mcp/internal/pose/governance_read_view_git.go; sed -n '1,100p' .pose/knowledge/2026-10-20-handoff-pose-b07-implementation.md; git diff --stat ca66b779b3c83932c3273427ad1cd8c3c7a40a98..HEAD; rg -n '\\\"git-snapshot-budget-scales-with-the-tree-integration\\\"|\\\"status\\\"|\\\"required_failed\\\"' .pose/results/delivery-validation.json | tail -12; rg -n 'GitSnapshotBudget|submodule|CRLF|[Ff]ilter' pose-mcp/internal/pose/git_snapshot_integrity_test.go; cat POSE.md | head -90\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '610,700p' pose-mcp/internal/pose/governance_read_view_git.go; sed -n '1,100p' .pose/knowledge/2026-10-20-handoff-pose-b07-implementation.md; git diff --stat ca66b779b3c83932c3273427ad1cd8c3c7a40a98..HEAD; rg -n '\\\"git-snapshot-budget-scales-with-the-tree-integration\\\"|\\\"status\\\"|\\\"required_failed\\\"' .pose/results/delivery-validation.json | tail -12; rg -n 'GitSnapshotBudget|submodule|CRLF|[Ff]ilter' pose-mcp/internal/pose/git_snapshot_integrity_test.go; cat POSE.md | head -90\"","aggregated_output":"func runGovernanceGitCommandContext(ctx context.Context, files Files, root string, args []string, limit int64) ([]byte, error) {\n\tstdout, _, err := runGovernanceGitCommandOutputContext(ctx, files, root, args, limit)\n\treturn stdout, err\n}\n\nfunc runGovernanceGitCommandOutput(files Files, root string, args []string, limit int64) ([]byte, []byte, error) {\n\treturn runGovernanceGitCommandOutputAdmitted(files, root, args, limit, nil)\n}\n\nfunc runGovernanceGitCommandOutputContext(ctx context.Context, files Files, root string, args []string, limit int64) ([]byte, []byte, error) {\n\treturn runGovernanceGitCommandOutputAdmittedContext(ctx, files, root, args, limit, nil)\n}\n\n// runGovernanceGitCommandOutputAdmitted admits each stream chunk before the\n// bounded output buffer retains it. The operation callback is shared with\n// Files reads, so concurrent producers cannot spend the same remaining bytes.\nfunc runGovernanceGitCommandOutputAdmitted(files Files, root string, args []string, limit int64, admit func(int64) bool) ([]byte, []byte, error) {\n\treturn runGovernanceGitCommandOutputAdmittedContext(context.Background(), files, root, args, limit, admit)\n}\n\n// runGovernanceGitCommandOutputAdmittedContext admits each stream chunk before\n// the bounded output buffer retains it and executes Git under ctx.\n// governanceGitEnv is added to every Git command the governance read view\n// runs, captured or streamed. Governance classifies Git's failures by what\n// Git writes to stderr, so Git writes it untranslated: a translated \"not a\n// git repository\" left a directory outside any repository unknown under\n// pt_BR (spec pose-governance-git-reads-untranslated).\nvar governanceGitEnv = []string{\"GIT_OPTIONAL_LOCKS=0\", \"LC_ALL=C\", \"LANGUAGE=C\"}\n\nfunc runGovernanceGitCommandOutputAdmittedContext(ctx context.Context, files Files, root string, args []string, limit int64, admit func(int64) bool) ([]byte, []byte, error) {\n\tif limit < 0 {\n\t\treturn nil, nil, errGovernanceReadViewBudget\n\t}\n\tfiles = FilesOrNative(files)\n\tif ctx == nil {\n\t\tctx = context.Background()\n\t}\n\tcmd := gitCommandContext(ctx, append([]string{\"--no-replace-objects\", \"-C\", root}, args...)...)\n\tcmd.WaitDelay = 2 * time.Second\n\tcmd.Env = append(cmd.Env, governanceGitEnv...)\n\toutput := &boundedGovernanceGitOutput{limit: limit, admit: admit}\n\tcmd.Stdout = governanceGitStream{output: output, stderr: false}\n\tcmd.Stderr = governanceGitStream{output: output, stderr: true}\n\terr := cmd.Run()\n\tstdout, stderr, exceeded := output.values()\n\tif exceeded {\n\t\treturn nil, nil, errGovernanceReadViewBudget\n\t}\n\tif err != nil {\n\t\tif exit, ok := err.(*exec.ExitError); ok {\n\t\t\texit.Stderr = append([]byte(nil), stderr...)\n\t\t}\n\t\treturn stdout, stderr, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n\t}\n\tif len(stderr) > 0 {\n\t\tdetail := strings.TrimSpace(string(stderr))\n\t\tif detail == \"\" {\n\t\t\tdetail = \"Git wrote unclassified stderr output\"\n\t\t}\n\t\treturn stdout, stderr, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: errors.New(detail)}\n\t}\n\treturn stdout, stderr, nil\n}\n\ntype boundedGovernanceGitOutput struct {\n\tmu       sync.Mutex\n\tlimit    int64\n\tused     int64\n\tadmit    func(int64) bool\n\tstdout   bytes.Buffer\n\tstderr   bytes.Buffer\n\texceeded bool\n}\n\ntype governanceGitStream struct {\n\toutput *boundedGovernanceGitOutput\n\tstderr bool\n}\n\nfunc (stream governanceGitStream) Write(data []byte) (int, error) {\n\toutput := stream.output\n\toutput.mu.Lock()\n\tdefer output.mu.Unlock()\n\tif output.exceeded || int64(len(data)) > output.limit-output.used {\n\t\toutput.exceeded = true\n\t\treturn 0, errGovernanceReadViewBudget\n\t}\n\tif output.admit != nil && !output.admit(int64(len(data))) {\n\t\toutput.exceeded = true\n\t\treturn 0, errGovernanceReadViewBudget\n\t}\n---\ntype: handoff\nslug: pose-b07-implementation\nowner: @pose-maintainers\nsensitivity: public-internal\ncreated_at: 2026-10-20\nlast_reviewed_at: 2026-10-20\nexpires_at: 2026-11-19\nsource_refs:\n  spec: \"spec:pose-git-and-dispatch-snapshot-integrity\"\n  workflow: \".pose/workflows/feature.md\"\n  commands: [\"pose validate --strict --module pose-mcp\", \"pose check --strict\", \"go test -race ./internal/pose ./internal/cli ./internal/mcpserver\"]\n  external_sources: []  # [{url: \"\", accessed_at: \"YYYY-MM-DD\"}]\n---\n\n# handoff: pose-b07-implementation\n\n## Context\n\nB07 retomada e reconciliada com a história completa do PR #195. Implementação explicitamente autorizada pelo mantenedor; branch canônica de trabalho `impl/pose-b07-git-snapshot-integrity`.\nlast_reviewed_at: 2026-10-20.\n\n## Current state\n\nCódigo, regressões, catálogo MCP e docs implementados. Spec in-progress, start\nnativo preservado; nenhuma atestação ou conclusão de entrega gravada. A CLI e\n`pose_closeout_state(include_plan=true)` compartilham o plano e seus erros Git.\nRelatório e matriz em `../reports/2026-10-20-b07-implementation.md` e\n`../results/b07-validation.json`.\n\n## Next checks\n\n1. Canonical worktree: /tmp/pose-b07-closeout-work, branch impl/pose-b07-git-snapshot-integrity. Merge a4c58e9 preserves the full PR195 history through 23643a2 and the original native start. Do not overwrite concurrent documentation changes in the shared checkout.\n2. The unused expired Actions waiver was removed separately in d957b4f. No pin or enforcement change. Reconciled full suite, 11/11 mutations and native 141/141 validation passed before the latest three review fixes; regenerate final evidence at the configured .pose/results/delivery-validation.json.\n3. Review R1 requested changes, now fixed: persisted runs require Git, closeout exceptions require regular materialization, history sorts instants with validated probes. Review R2 found the remaining persisted-materialization gap; Review R3 accepted its correction with no remaining functional finding. The reports record the actual separate same-vendor execution identity. The cross-vendor attempt hit its weekly limit; no cross-vendor approval is claimed.\n4. Finish artifact/surface checks, native sealed review and closeout before done or adoption. Default artifact attribution reconciled 82 claims with no errors. The Harne8 binding still points at 8aa729a7; do not update it merely because local tests pass.\n\n## Risks\n\nObservações antes/depois não isolam o adapter nem impedem escrita transitória.\nNenhum efeito governado é aplicado pelo dispatch; consumidores futuros precisam\nrevalidar autorização. Adapters não autenticam produtores derivados: outputs devem\nir para stdout ou `{output}`, fora do worktree. Limites: 100000 entradas/256 MiB.\nA revisão R3 é uma execução separada do mesmo fornecedor, com identidade declarada e sem confirmação humana ou prova criptográfica. Não há alegação de eficácia em produção.\n\n## Next owner\n\n@pose-maintainers coordena a verificação dos registros nativos de closeout e eventual adoção; consulte o Final Report da spec para o resultado final.\n\n## References\n\n- [Spec](../specs/2026-10-13-pose-git-and-dispatch-snapshot-integrity.md).\n- [ADR MCP](../adr/2026-10-20-expose-the-closeout-execution-plan-as-an-opt-in-mcp-projection.md).\n- [Relatório](../reports/2026-10-20-b07-implementation.md).\n .pose/indexes/delivery-integrity.json              | 5692 ++++++++++----------\n .pose/indexes/generation.json                      |   18 +-\n .pose/indexes/spec-graph.json                      | 1166 ++--\n .pose/indexes/validation-matrix.json               |    7 +\n .pose/results/delivery-validation.json             | 1697 +++---\n ...ose-git-snapshot-budget-scales-with-the-tree.md |  147 +\n ...e-git-snapshot-budget-scales-with-the-tree.json |   50 +\n pose-mcp/internal/pose/git_snapshot_budget_test.go |   79 +\n pose-mcp/internal/pose/git_snapshot_integrity.go   |   65 +-\n 9 files changed, 4788 insertions(+), 4133 deletions(-)\n4336:      \"name\": \"git-snapshot-budget-scales-with-the-tree-integration\",\n134:\tdesignDeltaGit(t, root, \"-c\", \"protocol.file.allow=always\", \"submodule\", \"add\", \"-q\", child, \"nested\")\n140:\tbundle := ReviewBundle{Payload: ReviewBundlePayload{Subject: ReviewBundleSubject{Entries: []ReviewBundleSubjectEntry{{Class: \"submodule\", Path: \"nested\", Digest: digestBytes([]byte(childHead))}}}}}\n142:\t\tt.Fatalf(\"sealed submodule control: %v\", err)\n149:\t\tt.Fatalf(\"hidden submodule edit: %q %v\", got, err)\n# POSE — Project Operating Standard for Engineering\n\n## 1) What it is\n\nPOSE is the operating standard for agent work in **{{PROJECT_NAME}}**.\n\nPrimary goals:\n\n- reduce ambiguity in tasks\n- improve execution predictability\n- make validation and reporting consistent\n- scale collaboration in a heterogeneous repository\n\nPOSE does **not** replace product architecture or existing security policies;\nit organizes how agents execute technical work.\n\nThe short agent contract lives in [`AGENTS.md`](AGENTS.md); this document is\nthe operating manual (structure, CLI, per-type flows, CI, governance).\n\n---\n\n## 2) Principles\n\n1. **Scope first**: read only the instructions and artifacts needed for the affected directories.\n2. **Plan before implementing**: non-trivial changes go through a spec/plan.\n3. **Incrementalism**: small, cohesive, auditable deliveries.\n4. **Deterministic validation**: prefer reproducible commands (`test`, `lint`, `typecheck`, `build`, contract/security checks).\n5. **Risk transparency**: always surface gaps and human-review points.\n\n---\n\n## 3) Structure\n\n```text\n.pose/\n  workflows/     # procedure per work type\n  templates/     # spec.md, roadmap.md, knowledge.md, changelog-fragment.md, doc-audit-report.md\n  rules/         # domain rules (cumulative)\n  knowledge/     # handoffs and notes with active governance\n  adr/           # architectural decisions\n  roadmaps/      # governed roadmaps (milestone DAGs)\n  changelogs/    # pending fragments plus immutable version archives/notes\n  releases/      # version manifests and append-only lifecycle evidence\n  indexes/       # repo-map, services, packages, validation-matrix, module-metadata, task-map, spec-graph, roadmaps\n  reports/       # versionable reports + history JSONL + archive/\n  specs/         # living specs per feature\n  schema-version # instance contract version (see `pose update`)\n\n.agents/skills/  # skills (source of truth; Codex-native format)\n.claude/skills/  # Claude Code-compatible symlinks\npose             # native Go binary available on PATH\nAGENTS.md        # short operating contract\nPOSE.md          # this manual\n```\n\n---\n\n## 4) Key files\n\n- [`AGENTS.md`](AGENTS.md): short contract, precedence and entry points.\n- Subproject `AGENTS.md` (when present): local guidance, applied only to that directory's scope.\n- [`.pose/workflows/*.md`](.pose/workflows/): procedure per work type (`feature`, `bugfix`, `review`, `refactor`, `documentation-update`, `recurrence-escalation`).\n- [`.pose/rules/*.md`](.pose/rules/): domain rules; recurring content lives in [`.pose/rules/_base-recurrence.md`](.pose/rules/_base-recurrence.md).\n- [`.pose/templates/spec.md`](.pose/templates/spec.md): the single per-feature spec template.\n- `.pose/project.json`: the project's declared identity, `{\"schema_version\":1,\"project_id\":\"proj.<name>\",\"name\":\"…\"}`, written by `pose install` and seeded by `pose update` from the id an older instance declared in `.mcp.json` or `AGENTS.md`. Resolution reads `POSE_DEFAULT_PROJECT_ID`, then a `POSE_PROJECT_ROOTS` binding, then this file, then the directory name; a binding that disagrees with the file is refused as `conflicting-project-binding`, a malformed file as `invalid-project-id`, and `pose doctor` reports both under `project.identity`. Declared once, the id is the same in every checkout, under any directory name, for the CLI and the MCP server.\n- [`.pose/templates/roadmap.md`](.pose/templates/roadmap.md): governed roadmap template.\n- [`.pose/templates/changelog-fragment.md`](.pose/templates/changelog-fragment.md): user-facing fragment per spec (written at closeout).\n- [`.pose/workflows/release.md`](.pose/workflows/release.md): immutable release preparation, publication reconciliation and verification.\n\nRelease cuts use `pose release plan`, `prepare`, `check`, `notes`, `record`,\n`status`, `open-next` and `backfill`. A tag is not publication; terminal release\nconfidence comes only from provider and independent-verification evidence.\n- [`.pose/templates/doc-audit-report.md`](.pose/templates/doc-audit-report.md): template for editorial reviews and documentation audits.\n- `pose` binary: native scaffold/check/validate/report automation and MCP server.\n- [`.pose/specs/*/spec.md`](.pose/specs/): living specs per feature.\n- Native project-state artifact, generated by `pose state init` (`pose state`/`pose_project_state`) — optional, absent on a freshly-installed project; configurable staleness policy (optional, defaults 7 days / 20 commits — see §6).\n- [`.agents/skills/`](.agents/skills/): 11 skills in Codex-native format (`name`/`description` frontmatter, body with Required reading + Steps + Output requirements, optional metadata in `agents/openai.yaml`). Use `description` as the single routing source; Claude Code consumes the symlinks in [`.claude/skills/`](.claude/skills/) without requiring `when_to_use`.\n\n---\n\n## 5) Flows per task type\n\nThe operational step-by-step lives in the workflows. Each workflow also\nincludes the relevant \"Execution — planner/implementer/reviewer mode\" sections.\n\n- Feature: [`.pose/workflows/feature.md`](.pose/workflows/feature.md)\n- Bugfix: [`.pose/workflows/bugfix.md`](.pose/workflows/bugfix.md)\n- Review: [`.pose/workflows/review.md`](.pose/workflows/review.md)\n- Refactor: [`.pose/workflows/refactor.md`](.pose/workflows/refactor.md)\n- Documentation: [`.pose/workflows/documentation-update.md`](.pose/workflows/documentation-update.md)\n","exit_code":0,"status":"completed"}}
