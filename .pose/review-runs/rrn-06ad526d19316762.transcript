{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/git_snapshot_integrity.go | head -430; rg -n 'func runGit|func gitCommand|func runGitIn|dispatchDiskSnapshot|gitSnapshot(Margin|Ceiling)|t.Parallel' pose-mcp/internal/pose/git* pose-mcp/internal/pose/dispatch*; command -v pose; git rev-parse HEAD\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"context\"\n     6\t\t\"crypto/sha1\"\n     7\t\t\"crypto/sha256\"\n     8\t\t\"encoding/hex\"\n     9\t\t\"errors\"\n    10\t\t\"fmt\"\n    11\t\t\"hash\"\n    12\t\t\"io\"\n    13\t\t\"io/fs\"\n    14\t\t\"os\"\n    15\t\t\"os/exec\"\n    16\t\t\"path\"\n    17\t\t\"path/filepath\"\n    18\t\t\"runtime\"\n    19\t\t\"sort\"\n    20\t\t\"strconv\"\n    21\t\t\"strings\"\n    22\t)\n    23\t\n    24\t// The bytes a snapshot reads are bounded by the committed tree it compares\n    25\t// against plus a margin, never less than the margin alone and never more than\n    26\t// the ceiling: a fixed bound stopped every closeout once a repository's\n    27\t// committed tree outgrew it (spec pose-git-snapshot-budget-scales-with-the-tree).\n    28\tvar (\n    29\t\tgitSnapshotMarginBytes  int64 = 256 << 20\n    30\t\tgitSnapshotCeilingBytes int64 = 4 << 30\n    31\t)\n    32\t\n    33\tfunc gitSnapshotBudget(committedBytes int64) int64 {\n    34\t\tif committedBytes < 0 {\n    35\t\t\tcommittedBytes = 0\n    36\t\t}\n    37\t\tif committedBytes > gitSnapshotCeilingBytes-gitSnapshotMarginBytes {\n    38\t\t\treturn gitSnapshotCeilingBytes\n    39\t\t}\n    40\t\treturn committedBytes + gitSnapshotMarginBytes\n    41\t}\n    42\t\n    43\t// gitCommittedTreeBytes sums the blob sizes of an `ls-tree -r -l -z` listing.\n    44\tfunc gitCommittedTreeBytes(listing []byte) int64 {\n    45\t\tvar total int64\n    46\t\tfor _, record := range bytes.Split(listing, []byte{0}) {\n    47\t\t\ti := bytes.IndexByte(record, '\\t')\n    48\t\t\tif i < 0 {\n    49\t\t\t\tcontinue\n    50\t\t\t}\n    51\t\t\tfields := strings.Fields(string(record[:i]))\n    52\t\t\tif len(fields) == 4 {\n    53\t\t\t\tif size, err := strconv.ParseInt(fields[3], 10, 64); err == nil && size > 0 {\n    54\t\t\t\t\ttotal += size\n    55\t\t\t\t}\n    56\t\t\t}\n    57\t\t}\n    58\t\treturn total\n    59\t}\n    60\t\n    61\t// Snapshot disk, including ignored files. Git status alone cannot witness\n    62\t// creation of an ignored output. WalkDir never follows a directory symlink.\n    63\tfunc dispatchDiskSnapshot(root string) (map[string]string, error) {\n    64\t\tentries := map[string]string{}\n    65\t\tvar total int64\n    66\t\tcommitted := int64(0)\n    67\t\tif listing, err := gitCommand(\"-C\", root, \"ls-tree\", \"-r\", \"-l\", \"-z\", \"HEAD\").Output(); err == nil {\n    68\t\t\tcommitted = gitCommittedTreeBytes(listing)\n    69\t\t}\n    70\t\tbudget := gitSnapshotBudget(committed)\n    71\t\terr := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {\n    72\t\t\tif err != nil {\n    73\t\t\t\treturn err\n    74\t\t\t}\n    75\t\t\trel, err := filepath.Rel(root, path)\n    76\t\t\tif err != nil {\n    77\t\t\t\treturn err\n    78\t\t\t}\n    79\t\t\tif rel == \".\" {\n    80\t\t\t\treturn nil\n    81\t\t\t}\n    82\t\t\tif rel == \".git\" {\n    83\t\t\t\tif entry.IsDir() {\n    84\t\t\t\t\treturn filepath.SkipDir\n    85\t\t\t\t}\n    86\t\t\t\treturn nil\n    87\t\t\t}\n    88\t\t\tinfo, err := entry.Info()\n    89\t\t\tif err != nil {\n    90\t\t\t\treturn err\n    91\t\t\t}\n    92\t\t\t// The per-root authority lock is runtime coordination state, not a\n    93\t\t\t// project input. Ignore only the exact regular file: a linked or special\n    94\t\t\t// replacement remains visible to the snapshot and fails closed.\n    95\t\t\tif filepath.ToSlash(rel) == \".pose/transfers/.authority-transfer.lock\" && info.Mode().IsRegular() {\n    96\t\t\t\treturn nil\n    97\t\t\t}\n    98\t\t\tif len(entries) >= 100000 {\n    99\t\t\t\treturn fmt.Errorf(\"disk snapshot exceeds 100000 entries\")\n   100\t\t\t}\n   101\t\t\thash := sha256.New()\n   102\t\t\tfmt.Fprintf(hash, \"%s\\x00\", info.Mode().String())\n   103\t\t\tswitch {\n   104\t\t\tcase info.Mode().IsRegular():\n   105\t\t\t\tfile, err := os.Open(path)\n   106\t\t\t\tif err != nil {\n   107\t\t\t\t\treturn err\n   108\t\t\t\t}\n   109\t\t\t\tn, readErr := io.Copy(hash, io.LimitReader(file, budget-total+1))\n   110\t\t\t\tcloseErr := file.Close()\n   111\t\t\t\ttotal += n\n   112\t\t\t\tif readErr != nil {\n   113\t\t\t\t\treturn readErr\n   114\t\t\t\t}\n   115\t\t\t\tif closeErr != nil {\n   116\t\t\t\t\treturn closeErr\n   117\t\t\t\t}\n   118\t\t\t\tif total > budget {\n   119\t\t\t\t\treturn fmt.Errorf(\"disk snapshot exceeds its budget of %d bytes\", budget)\n   120\t\t\t\t}\n   121\t\t\tcase info.Mode()&os.ModeSymlink != 0:\n   122\t\t\t\ttarget, err := os.Readlink(path)\n   123\t\t\t\tif err != nil {\n   124\t\t\t\t\treturn err\n   125\t\t\t\t}\n   126\t\t\t\thash.Write([]byte(target))\n   127\t\t\tcase info.IsDir():\n   128\t\t\tdefault:\n   129\t\t\t\treturn fmt.Errorf(\"unsupported file type at %q\", rel)\n   130\t\t\t}\n   131\t\t\tentries[filepath.ToSlash(rel)] = hex.EncodeToString(hash.Sum(nil))\n   132\t\t\treturn nil\n   133\t\t})\n   134\t\tif err != nil {\n   135\t\t\treturn nil, &GitSnapshotError{\"disk snapshot\", err}\n   136\t\t}\n   137\t\treturn entries, nil\n   138\t}\n   139\t\n   140\t// GitSnapshotError means a repository observation was unavailable, not clean.\n   141\ttype GitSnapshotError struct {\n   142\t\tOperation string\n   143\t\tCause     error\n   144\t}\n   145\t\n   146\tfunc (e *GitSnapshotError) Error() string {\n   147\t\treturn fmt.Sprintf(\"pose: Git snapshot unavailable (%s): %v\", e.Operation, e.Cause)\n   148\t}\n   149\tfunc (e *GitSnapshotError) Unwrap() error { return e.Cause }\n   150\t\n   151\tfunc snapshotGit(root string, args ...string) ([]byte, error) {\n   152\t\tcmd := gitCommand(append([]string{\"-C\", root}, args...)...)\n   153\t\t// Asking about the worktree writes nothing under .git: without this `git status` refreshes\n   154\t\t// and rewrites the index, which a governed read view that watches .git reads as an input that\n   155\t\t// changed during the operation (spec pose-git-status-leaves-the-git-directory-alone).\n   156\t\tcmd.Env = append(cmd.Env, \"GIT_OPTIONAL_LOCKS=0\")\n   157\t\tout, err := cmd.Output()\n   158\t\tif err != nil {\n   159\t\t\treturn nil, &GitSnapshotError{Operation: strings.Join(args, \" \"), Cause: err}\n   160\t\t}\n   161\t\treturn out, nil\n   162\t}\n   163\t\n   164\t// gitChangedPaths uses the NUL protocol; porcelain's quoted display is not a path.\n   165\tfunc gitChangedPaths(root string) ([]string, error) {\n   166\t\tout, err := snapshotGit(root, \"status\", \"--porcelain=v1\", \"-z\", \"--untracked-files=all\", \"--ignore-submodules=none\")\n   167\t\tif err != nil {\n   168\t\t\treturn nil, err\n   169\t\t}\n   170\t\tentries, err := parseGitStatusEntries(out)\n   171\t\tif err != nil {\n   172\t\t\treturn nil, err\n   173\t\t}\n   174\t\tpaths := make([]string, 0, len(entries)*2)\n   175\t\tfor _, entry := range entries {\n   176\t\t\tif untrackedAuthorityTransferLock(entry) {\n   177\t\t\t\tcontinue\n   178\t\t\t}\n   179\t\t\tpaths = append(paths, entry.Path)\n   180\t\t\tif entry.OrigPath != \"\" {\n   181\t\t\t\tpaths = append(paths, entry.OrigPath)\n   182\t\t\t}\n   183\t\t}\n   184\t\tsort.Strings(paths)\n   185\t\treturn paths, nil\n   186\t}\n   187\t\n   188\tfunc untrackedAuthorityTransferLock(entry GitStatusEntry) bool {\n   189\t\treturn entry.XY == \"??\" && entry.Path == \".pose/transfers/.authority-transfer.lock\"\n   190\t}\n   191\t\n   192\tfunc parseGitChangedPaths(out []byte) ([]string, error) {\n   193\t\tentries, err := parseGitStatusEntries(out)\n   194\t\tif err != nil {\n   195\t\t\treturn nil, err\n   196\t\t}\n   197\t\tpaths := []string{}\n   198\t\tfor _, entry := range entries {\n   199\t\t\tpaths = append(paths, entry.Path)\n   200\t\t\tif entry.OrigPath != \"\" {\n   201\t\t\t\tpaths = append(paths, entry.OrigPath)\n   202\t\t\t}\n   203\t\t}\n   204\t\tsort.Strings(paths)\n   205\t\treturn paths, nil\n   206\t}\n   207\t\n   208\t// gitMaterializedChanges checks the committed tree against disk independently\n   209\t// of index flags. No refresh/update-index mutation is needed to see hidden edits.\n   210\tfunc gitMaterializedChanges(root, commit string) ([]string, error) {\n   211\t\treturn gitMaterializedChangesFor(root, commit, nil)\n   212\t}\n   213\tfunc gitMaterializedChangesFor(root, commit string, matters func(string) bool) ([]string, error) {\n   214\t\treturn gitMaterializedChangesForIn(NativeFiles(), root, commit, matters, \"\")\n   215\t}\n   216\t\n   217\tfunc gitMaterializedChangesForIn(files Files, root, commit string, matters func(string) bool, producer string) ([]string, error) {\n   218\t\tfiles = FilesOrNative(files)\n   219\t\tif producer != \"\" {\n   220\t\t\tproducer = governanceProducerFromFiles(files, producer)\n   221\t\t}\n   222\t\trunGit := snapshotGit\n   223\t\tworktreeIdentity := dispatchWorktreeIdentity\n   224\t\tif producer != \"\" {\n   225\t\t\trunGit = func(root string, args ...string) ([]byte, error) {\n   226\t\t\t\treturn captureGovernanceGit(files, root, producer, args...)\n   227\t\t\t}\n   228\t\t\tworktreeIdentity = func(root string) (string, error) {\n   229\t\t\t\treturn dispatchWorktreeIdentityGoverned(files, root, producer)\n   230\t\t\t}\n   231\t\t}\n   232\t\tvar err error\n   233\t\troot, err = filepath.Abs(root)\n   234\t\tif err != nil {\n   235\t\t\treturn nil, &GitSnapshotError{\"root\", err}\n   236\t\t}\n   237\t\tif _, err := worktreeIdentity(root); err != nil {\n   238\t\t\treturn nil, err\n   239\t\t}\n   240\t\tout, err := runGit(root, \"ls-tree\", \"-r\", \"-l\", \"-z\", commit)\n   241\t\tif err != nil {\n   242\t\t\treturn nil, err\n   243\t\t}\n   244\t\tbudget := gitSnapshotBudget(gitCommittedTreeBytes(out))\n   245\t\tvar changed []string\n   246\t\tvar total int64\n   247\t\tcount := 0\n   248\t\tfor _, record := range bytes.Split(out, []byte{0}) {\n   249\t\t\tif len(record) == 0 {\n   250\t\t\t\tcontinue\n   251\t\t\t}\n   252\t\t\tcount++\n   253\t\t\tif count > 100000 {\n   254\t\t\t\treturn nil, &GitSnapshotError{\"tree snapshot\", fmt.Errorf(\"exceeds 100000 entries\")}\n   255\t\t\t}\n   256\t\t\ti := bytes.IndexByte(record, '\\t')\n   257\t\t\tif i < 0 {\n   258\t\t\t\treturn nil, &GitSnapshotError{\"tree protocol\", fmt.Errorf(\"missing path\")}\n   259\t\t\t}\n   260\t\t\tfields := strings.Fields(string(record[:i]))\n   261\t\t\tif len(fields) != 4 {\n   262\t\t\t\treturn nil, &GitSnapshotError{\"tree protocol\", fmt.Errorf(\"invalid entry\")}\n   263\t\t\t}\n   264\t\t\tfields = fields[:3]\n   265\t\t\tpath := string(record[i+1:])\n   266\t\t\tif fields[0] == \"160000\" && matters != nil && !matters(path) {\n   267\t\t\t\tcontinue\n   268\t\t\t}\n   269\t\t\tfull := filepath.Join(root, filepath.FromSlash(path))\n   270\t\t\t// Lstat every parent: a link in a parent must never read outside root.\n   271\t\t\tunsafe := false\n   272\t\t\tfor parent := filepath.Dir(full); parent != root; parent = filepath.Dir(parent) {\n   273\t\t\t\tif parent == filepath.Dir(parent) {\n   274\t\t\t\t\treturn nil, &GitSnapshotError{\"path\", fmt.Errorf(\"path outside worktree: %q\", path)}\n   275\t\t\t\t}\n   276\t\t\t\tvar info os.FileInfo\n   277\t\t\t\tvar e error\n   278\t\t\t\tif producer != \"\" {\n   279\t\t\t\t\tinfo, e = files.Lstat(parent)\n   280\t\t\t\t} else {\n   281\t\t\t\t\tinfo, e = os.Lstat(parent)\n   282\t\t\t\t}\n   283\t\t\t\tif e != nil || !info.IsDir() {\n   284\t\t\t\t\tunsafe = true\n   285\t\t\t\t\tbreak\n   286\t\t\t\t}\n   287\t\t\t}\n   288\t\t\tif unsafe {\n   289\t\t\t\tchanged = append(changed, path)\n   290\t\t\t\tcontinue\n   291\t\t\t}\n   292\t\t\tvar info os.FileInfo\n   293\t\t\tvar e error\n   294\t\t\tif producer != \"\" {\n   295\t\t\t\tinfo, e = files.Lstat(full)\n   296\t\t\t} else {\n   297\t\t\t\tinfo, e = os.Lstat(full)\n   298\t\t\t}\n   299\t\t\tif os.IsNotExist(e) {\n   300\t\t\t\tchanged = append(changed, path)\n   301\t\t\t\tcontinue\n   302\t\t\t}\n   303\t\t\tif e != nil {\n   304\t\t\t\treturn nil, &GitSnapshotError{\"lstat \" + path, e}\n   305\t\t\t}\n   306\t\t\tif fields[0] == \"160000\" {\n   307\t\t\t\tif !info.IsDir() {\n   308\t\t\t\t\tchanged = append(changed, path)\n   309\t\t\t\t\tcontinue\n   310\t\t\t\t}\n   311\t\t\t\tif _, err := worktreeIdentity(full); err != nil {\n   312\t\t\t\t\treturn nil, err\n   313\t\t\t\t}\n   314\t\t\t\thead, e := runGit(full, \"rev-parse\", \"--verify\", \"HEAD\")\n   315\t\t\t\tif e != nil {\n   316\t\t\t\t\treturn nil, e\n   317\t\t\t\t}\n   318\t\t\t\tvar dirty []string\n   319\t\t\t\tif producer != \"\" {\n   320\t\t\t\t\tdirty, e = gitChangedPathsGovernedIn(files, full, producer)\n   321\t\t\t\t} else {\n   322\t\t\t\t\tdirty, e = gitChangedPaths(full)\n   323\t\t\t\t}\n   324\t\t\t\tif e != nil {\n   325\t\t\t\t\treturn nil, e\n   326\t\t\t\t}\n   327\t\t\t\tif strings.TrimSpace(string(head)) != fields[2] || len(dirty) != 0 {\n   328\t\t\t\t\tchanged = append(changed, path)\n   329\t\t\t\t} else {\n   330\t\t\t\t\tvar nested []string\n   331\t\t\t\t\tif producer != \"\" {\n   332\t\t\t\t\t\tnested, err = gitMaterializedChangesForIn(files, full, fields[2], matters, producer)\n   333\t\t\t\t\t} else {\n   334\t\t\t\t\t\tnested, err = gitMaterializedChanges(full, fields[2])\n   335\t\t\t\t\t}\n   336\t\t\t\t\tif err != nil {\n   337\t\t\t\t\t\treturn nil, err\n   338\t\t\t\t\t}\n   339\t\t\t\t\tif len(nested) != 0 {\n   340\t\t\t\t\t\tchanged = append(changed, path)\n   341\t\t\t\t\t}\n   342\t\t\t\t}\n   343\t\t\t\tcontinue\n   344\t\t\t}\n   345\t\t\tvar raw []byte\n   346\t\t\tif fields[0] == \"120000\" {\n   347\t\t\t\tif info.Mode()&os.ModeSymlink == 0 {\n   348\t\t\t\t\tchanged = append(changed, path)\n   349\t\t\t\t\tcontinue\n   350\t\t\t\t}\n   351\t\t\t\tvar target string\n   352\t\t\t\ttarget, e = os.Readlink(full)\n   353\t\t\t\traw = []byte(target)\n   354\t\t\t} else {\n   355\t\t\t\tif !info.Mode().IsRegular() {\n   356\t\t\t\t\tchanged = append(changed, path)\n   357\t\t\t\t\tcontinue\n   358\t\t\t\t}\n   359\t\t\t\t// Verify executable materialization even when index flags hide it.\n   360\t\t\t\t// Windows does not materialize POSIX executable bits.\n   361\t\t\t\tif runtime.GOOS != \"windows\" && (info.Mode().Perm()&0111 != 0) != (fields[0] == \"100755\") {\n   362\t\t\t\t\tchanged = append(changed, path)\n   363\t\t\t\t}\n   364\t\t\t\tif info.Size() > budget-total {\n   365\t\t\t\t\treturn nil, &GitSnapshotError{\"read \" + path, fmt.Errorf(\"snapshot exceeds its budget of %d bytes\", budget)}\n   366\t\t\t\t}\n   367\t\t\t\tvar file *os.File\n   368\t\t\t\tfile, e = os.Open(full)\n   369\t\t\t\tif e == nil {\n   370\t\t\t\t\traw, e = io.ReadAll(io.LimitReader(file, budget-total+1))\n   371\t\t\t\t\tcloseErr := file.Close()\n   372\t\t\t\t\tif e == nil {\n   373\t\t\t\t\t\te = closeErr\n   374\t\t\t\t\t}\n   375\t\t\t\t\ttotal += int64(len(raw))\n   376\t\t\t\t\tif total > budget {\n   377\t\t\t\t\t\treturn nil, &GitSnapshotError{\"read \" + path, fmt.Errorf(\"snapshot exceeds its budget of %d bytes\", budget)}\n   378\t\t\t\t\t}\n   379\t\t\t\t}\n   380\t\t\t}\n   381\t\t\tif e != nil {\n   382\t\t\t\treturn nil, &GitSnapshotError{\"read \" + path, e}\n   383\t\t\t}\n   384\t\t\tcmd := gitCommand(\"-C\", root, \"hash-object\", \"--stdin\", \"--path=\"+path)\n   385\t\t\tif fields[0] == \"120000\" {\n   386\t\t\t\tcmd = gitCommand(\"-C\", root, \"hash-object\", \"--stdin\", \"--no-filters\")\n   387\t\t\t}\n   388\t\t\tcmd.Stdin = bytes.NewReader(raw)\n   389\t\t\thash, e := cmd.Output()\n   390\t\t\tif e != nil {\n   391\t\t\t\treturn nil, &GitSnapshotError{\"hash \" + path, e}\n   392\t\t\t}\n   393\t\t\tif strings.TrimSpace(string(hash)) != fields[2] {\n   394\t\t\t\tchanged = append(changed, path)\n   395\t\t\t}\n   396\t\t}\n   397\t\tsort.Strings(changed)\n   398\t\treturn changed, nil\n   399\t}\n   400\t\n   401\t// These readers are shared by the bundle, obligation and execution snapshots.\n   402\tvar ErrGitUnknown = errors.New(\"pose: git state is unknown\")\n   403\tvar ErrGitUnavailable = errors.New(\"pose: not a git repository\")\n   404\t\n   405\tfunc (e *GitSnapshotError) Is(target error) bool { return target == ErrGitUnknown }\n   406\t\n   407\tfunc hasGitMetadata(root string) bool {\n   408\t\tdir, err := filepath.Abs(root)\n   409\t\tif err != nil {\n   410\t\t\treturn true\n   411\t\t}\n   412\t\tif gitMetadataAbove(dir) {\n   413\t\t\treturn true\n   414\t\t}\n   415\t\t// git walks the physical path, and a link can lead out of the lexical one.\n   416\t\tphysical, err := filepath.EvalSymlinks(dir)\n   417\t\treturn err == nil && physical != dir && gitMetadataAbove(physical)\n   418\t}\n   419\t\n   420\tfunc gitMetadataAbove(dir string) bool {\n   421\t\tfor {\n   422\t\t\tif gitMetadataAt(dir) {\n   423\t\t\t\treturn true\n   424\t\t\t}\n   425\t\t\tparent := filepath.Dir(dir)\n   426\t\t\tif parent == dir {\n   427\t\t\t\treturn false\n   428\t\t\t}\n   429\t\t\tdir = parent\n   430\t\t}\nnl: write error: Broken pipe\nrg: pose-mcp/internal/pose/dispatch*: No such file or directory (os error 2)\npose-mcp/internal/pose/git_snapshot_integrity_test.go:425:\tdisk, err := dispatchDiskSnapshot(root)\npose-mcp/internal/pose/git_snapshot_integrity.go:29:\tgitSnapshotMarginBytes  int64 = 256 << 20\npose-mcp/internal/pose/git_snapshot_integrity.go:30:\tgitSnapshotCeilingBytes int64 = 4 << 30\npose-mcp/internal/pose/git_snapshot_integrity.go:37:\tif committedBytes > gitSnapshotCeilingBytes-gitSnapshotMarginBytes {\npose-mcp/internal/pose/git_snapshot_integrity.go:38:\t\treturn gitSnapshotCeilingBytes\npose-mcp/internal/pose/git_snapshot_integrity.go:40:\treturn committedBytes + gitSnapshotMarginBytes\npose-mcp/internal/pose/git_snapshot_integrity.go:63:func dispatchDiskSnapshot(root string) (map[string]string, error) {\npose-mcp/internal/pose/git_snapshot_integrity.go:610:func gitCommand(args ...string) *exec.Cmd {\npose-mcp/internal/pose/git_snapshot_integrity.go:617:func gitCommandContext(ctx context.Context, args ...string) *exec.Cmd {\npose-mcp/internal/pose/git_snapshot_budget_test.go:16:\toriginal := gitSnapshotMarginBytes\npose-mcp/internal/pose/git_snapshot_budget_test.go:17:\tt.Cleanup(func() { gitSnapshotMarginBytes = original })\npose-mcp/internal/pose/git_snapshot_budget_test.go:18:\tgitSnapshotMarginBytes = 1 << 10\npose-mcp/internal/pose/git_snapshot_budget_test.go:47:\tentries, err := dispatchDiskSnapshot(root)\npose-mcp/internal/pose/git_snapshot_budget_test.go:63:\tif _, err := dispatchDiskSnapshot(root); err == nil || !strings.Contains(err.Error(), \"budget\") {\npose-mcp/internal/pose/git_snapshot_budget_test.go:70:\tif got := gitSnapshotBudget(0); got != gitSnapshotMarginBytes {\npose-mcp/internal/pose/git_snapshot_budget_test.go:71:\t\tt.Fatalf(\"an empty tree: %d, want the margin %d\", got, gitSnapshotMarginBytes)\npose-mcp/internal/pose/git_snapshot_budget_test.go:73:\tif got := gitSnapshotBudget(1 << 40); got != gitSnapshotCeilingBytes {\npose-mcp/internal/pose/git_snapshot_budget_test.go:74:\t\tt.Fatalf(\"a huge tree: %d, want the ceiling %d\", got, gitSnapshotCeilingBytes)\npose-mcp/internal/pose/git_snapshot_budget_test.go:76:\tif got := gitSnapshotBudget(-5); got != gitSnapshotMarginBytes {\n/home/go/.local/bin/pose\n8aec6924317827bb51e67aaae0a21365dba46e65\n","exit_code":0,"status":"completed"}}
