{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/generation_query_test.go'","aggregated_output":"package pose\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nfunc cursorFixture(n int) ([]string, []string) {\n\titems, keys := make([]string, n), make([]string, n)\n\tfor i := range items {\n\t\titems[i] = fmt.Sprintf(\"item-%02d\", i)\n\t\tkeys[i] = items[i]\n\t}\n\treturn items, keys\n}\n\nfunc mustKey(t *testing.T) []byte {\n\tt.Helper()\n\tkey, err := NewCursorKey()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn key\n}\n\nvar cursorQuery = GenerationQuery{Tool: \"pose_list_specs\", Project: \"proj|abc\", Filters: \"status=draft\"}\n\nfunc TestPageByGenerationWalksTheCollectionExactlyOnce(t *testing.T) {\n\tkey, now := mustKey(t), time.Now()\n\titems, keys := cursorFixture(23)\n\tvar seen []string\n\tcursor := \"\"\n\tfor pages := 0; pages < 20; pages++ {\n\t\tpage, next, meta, err := PageByGeneration(key, cursorQuery, \"gen-1\", items, keys, cursor, 5, now)\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif meta.Total != 23 || meta.Generation != \"gen-1\" || meta.Collection == \"\" || meta.Disclosure == \"\" {\n\t\t\tt.Fatalf(\"a page must disclose what it was read from: %+v\", meta)\n\t\t}\n\t\tseen = append(seen, page...)\n\t\tif next == \"\" {\n\t\t\tbreak\n\t\t}\n\t\tcursor = next\n\t}\n\tif strings.Join(seen, \",\") != strings.Join(items, \",\") {\n\t\tt.Fatalf(\"pages skipped or duplicated items: %v\", seen)\n\t}\n}\n\nfunc TestPageByGenerationWithoutCursorOrLimitIsTheLegacyCall(t *testing.T) {\n\titems, keys := cursorFixture(7)\n\tpage, next, _, err := PageByGeneration(mustKey(t), cursorQuery, \"gen-1\", items, keys, \"\", 0, time.Now())\n\tif err != nil || len(page) != 7 || next != \"\" {\n\t\tt.Fatalf(\"legacy call changed: %d items next=%q err=%v\", len(page), next, err)\n\t}\n}\n\nfunc TestPageByGenerationClampsAndDisclosesTheLimit(t *testing.T) {\n\titems, keys := cursorFixture(GenerationPageMax + 40)\n\tpage, next, meta, err := PageByGeneration(mustKey(t), cursorQuery, \"gen-1\", items, keys, \"\", GenerationPageMax+100, time.Now())\n\tif err != nil || len(page) != GenerationPageMax || next == \"\" || meta.LimitApplied != GenerationPageMax {\n\t\tt.Fatalf(\"limit was not bounded and disclosed: %d next=%q meta=%+v err=%v\", len(page), next, meta, err)\n\t}\n}\n\nfunc firstCursor(t *testing.T, key []byte, items, keys []string, now time.Time) string {\n\tt.Helper()\n\t_, next, _, err := PageByGeneration(key, cursorQuery, \"gen-1\", items, keys, \"\", 5, now)\n\tif err != nil || next == \"\" {\n\t\tt.Fatalf(\"no first cursor: %v\", err)\n\t}\n\treturn next\n}\n\nfunc TestACursorIsRefusedWhenTheCollectionChanged(t *testing.T) {\n\tkey, now := mustKey(t), time.Now()\n\titems, keys := cursorFixture(12)\n\tcursor := firstCursor(t, key, items, keys, now)\n\n\tmutations := map[string]func() ([]string, []string, string){\n\t\t\"insertion\": func() ([]string, []string, string) {\n\t\t\ti2 := append([]string{\"item-aa\"}, items...)\n\t\t\treturn i2, i2, \"gen-1\"\n\t\t},\n\t\t\"removal\": func() ([]string, []string, string) { return items[1:], keys[1:], \"gen-1\" },\n\t\t\"rename\": func() ([]string, []string, string) {\n\t\t\ti2 := append([]string(nil), items...)\n\t\t\ti2[3] = \"item-renamed\"\n\t\t\treturn i2, i2, \"gen-1\"\n\t\t},\n\t\t\"reordering\": func() ([]string, []string, string) {\n\t\t\ti2 := append([]string(nil), items...)\n\t\t\ti2[0], i2[1] = i2[1], i2[0]\n\t\t\treturn i2, i2, \"gen-1\"\n\t\t},\n\t\t\"new generation\": func() ([]string, []string, string) { return items, keys, \"gen-2\" },\n\t}\n\tfor name, mutate := range mutations {\n\t\ti2, k2, gen := mutate()\n\t\t_, _, _, err := PageByGeneration(key, cursorQuery, gen, i2, k2, cursor, 5, now)\n\t\tif CursorErrorCode(err) != CursorStale {\n\t\t\tt.Errorf(\"%s: want %s, got %v\", name, CursorStale, err)\n\t\t}\n\t}\n\tif _, _, _, err := PageByGeneration(key, cursorQuery, \"gen-1\", items, keys, cursor, 5, now); err != nil {\n\t\tt.Fatalf(\"an unchanged collection must continue: %v\", err)\n\t}\n}\n\nfunc TestACursorStaysWithItsQuery(t *testing.T) {\n\tkey, now := mustKey(t), time.Now()\n\titems, keys := cursorFixture(12)\n\tcursor := firstCursor(t, key, items, keys, now)\n\tfor name, q := range map[string]GenerationQuery{\n\t\t\"tool\":    {Tool: \"pose_list_roadmaps\", Project: cursorQuery.Project, Filters: cursorQuery.Filters},\n\t\t\"project\": {Tool: cursorQuery.Tool, Project: \"proj|other\", Filters: cursorQuery.Filters},\n\t\t\"filters\": {Tool: cursorQuery.Tool, Project: cursorQuery.Project, Filters: \"status=done\"},\n\t} {\n\t\t_, _, _, err := PageByGeneration(key, q, \"gen-1\", items, keys, cursor, 5, now)\n\t\tif CursorErrorCode(err) != CursorBinding {\n\t\t\tt.Errorf(\"%s: want %s, got %v\", name, CursorBinding, err)\n\t\t}\n\t}\n}\n\nfunc TestHostileCursorsAreRefusedNotCoerced(t *testing.T) {\n\tkey, now := mustKey(t), time.Now()\n\titems, keys := cursorFixture(12)\n\tcursor := firstCursor(t, key, items, keys, now)\n\tbody, mac, _ := strings.Cut(cursor, \".\")\n\n\tcases := map[string]struct{ token, code string }{\n\t\t\"garbage\":           {\"not-a-cursor!!\", CursorMalformed},\n\t\t\"truncated\":         {cursor[:len(cursor)/2], CursorMalformed},\n\t\t\"oversized\":         {strings.Repeat(\"a\", GenerationCursorMaxBytes+1), CursorMalformed},\n\t\t\"altered payload\":   {body[:len(body)-2] + \"AA.\" + mac, CursorSignature},\n\t\t\"altered signature\": {body + \".\" + mac[:len(mac)-2] + \"AA\", CursorSignature},\n\t\t\"legacy ordinal\":    {\"eyJ2IjoxLCJhZnRlciI6NX0\", CursorUnsupportedVersion},\n\t}\n\tfor name, c := range cases {\n\t\t_, _, _, err := PageByGeneration(key, cursorQuery, \"gen-1\", items, keys, c.token, 5, now)\n\t\tif CursorErrorCode(err) == \"\" {\n\t\t\tt.Errorf(\"%s: accepted\", name)\n\t\t} else if got := CursorErrorCode(err); got != c.code && !(name == \"altered payload\" && got == CursorMalformed) {\n\t\t\tt.Errorf(\"%s: want %s, got %s\", name, c.code, got)\n\t\t}\n\t}\n\t// A cursor from another process (another key) is refused as a signature failure.\n\tif _, _, _, err := PageByGeneration(mustKey(t), cursorQuery, \"gen-1\", items, keys, cursor, 5, now); CursorErrorCode(err) != CursorSignature {\n\t\tt.Fatalf(\"another process's cursor: %v\", err)\n\t}\n}\n\nfunc TestAnExpiredCursorIsRefused(t *testing.T) {\n\tkey, now := mustKey(t), time.Now()\n\titems, keys := cursorFixture(12)\n\tcursor := firstCursor(t, key, items, keys, now)\n\t_, _, _, err := PageByGeneration(key, cursorQuery, \"gen-1\", items, keys, cursor, 5, now.Add(GenerationCursorTTL+time.Minute))\n\tif CursorErrorCode(err) != CursorExpired {\n\t\tt.Fatalf(\"want %s, got %v\", CursorExpired, err)\n\t}\n}\n\nfunc TestAPositionOutsideTheCollectionIsRefused(t *testing.T) {\n\tkey, now := mustKey(t), time.Now()\n\titems, keys := cursorFixture(12)\n\tdigest := CollectionDigest(\"gen-1\", keys)\n\tfor name, p := range map[string]cursorPayload{\n\t\t\"beyond the end\": {V: GenerationCursorVersion, Tool: cursorQuery.Tool, Bind: queryBinding(cursorQuery), Collection: digest, After: 99, AfterKey: \"item-98\", Expires: now.Add(time.Minute).Unix()},\n\t\t\"wrong key\":      {V: GenerationCursorVersion, Tool: cursorQuery.Tool, Bind: queryBinding(cursorQuery), Collection: digest, After: 5, AfterKey: \"item-77\", Expires: now.Add(time.Minute).Unix()},\n\t\t\"zero\":           {V: GenerationCursorVersion, Tool: cursorQuery.Tool, Bind: queryBinding(cursorQuery), Collection: digest, After: 0, AfterKey: \"\", Expires: now.Add(time.Minute).Unix()},\n\t} {\n\t\t_, _, _, err := PageByGeneration(key, cursorQuery, \"gen-1\", items, keys, sealCursor(key, p), 5, now)\n\t\tif CursorErrorCode(err) != CursorPosition {\n\t\t\tt.Errorf(\"%s: want %s, got %v\", name, CursorPosition, err)\n\t\t}\n\t}\n\tbad := cursorPayload{V: 9, Tool: cursorQuery.Tool, Bind: queryBinding(cursorQuery), Collection: digest, After: 5, AfterKey: \"item-04\", Expires: now.Add(time.Minute).Unix()}\n\tif _, _, _, err := PageByGeneration(key, cursorQuery, \"gen-1\", items, keys, sealCursor(key, bad), 5, now); CursorErrorCode(err) != CursorUnsupportedVersion {\n\t\tt.Fatalf(\"an unsupported version was accepted: %v\", err)\n\t}\n}\n\nfunc TestAContinuationWithoutALimitIsStillABoundedPage(t *testing.T) {\n\tkey, now := mustKey(t), time.Now()\n\titems, keys := cursorFixture(GenerationPageMax*2 + 200)\n\t_, next, _, err := PageByGeneration(key, cursorQuery, \"gen-1\", items, keys, \"\", 1, now)\n\tif err != nil || next == \"\" {\n\t\tt.Fatal(err)\n\t}\n\tpage, _, _, err := PageByGeneration(key, cursorQuery, \"gen-1\", items, keys, next, 0, now)\n\tif err != nil || len(page) != GenerationPageMax {\n\t\tt.Fatalf(\"a continuation without limit returned %d items, want %d: %v\", len(page), GenerationPageMax, err)\n\t}\n}\n\nfunc TestAnIssuedCursorStaysWithinTheSizeBoundForHugeFilters(t *testing.T) {\n\tkey, now := mustKey(t), time.Now()\n\titems, keys := cursorFixture(12)\n\tq := GenerationQuery{Tool: \"pose_list_specs\", Project: \"proj|abc\", Filters: strings.Repeat(\"status=draft;\", 400)}\n\t_, next, _, err := PageByGeneration(key, q, \"gen-1\", items, keys, \"\", 5, now)\n\tif err != nil || len(next) == 0 || len(next) > GenerationCursorMaxBytes {\n\t\tt.Fatalf(\"a cursor for a huge filter set is %d bytes: %v\", len(next), err)\n\t}\n\tif _, _, _, err := PageByGeneration(key, q, \"gen-1\", items, keys, next, 5, now); err != nil {\n\t\tt.Fatalf(\"the issued cursor is refused on receipt: %v\", err)\n\t}\n}\n\nfunc TestEveryPageStatesItsCost(t *testing.T) {\n\titems, keys := cursorFixture(3)\n\t_, _, meta, err := PageByGeneration(mustKey(t), cursorQuery, \"gen-1\", items, keys, \"\", 2, time.Now())\n\tif err != nil || !strings.Contains(meta.Cost, \"full-scan\") {\n\t\tt.Fatalf(\"a page must state its cost: %+v %v\", meta, err)\n\t}\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/mcpserver/generation_cursor_linux_test.go pose-mcp/internal/mcpserver/pagination_identity_linux.go pose-mcp/internal/mcpserver/pagination_identity_other.go'","aggregated_output":"//go:build linux\n\npackage mcpserver\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/harne8/pose-mcp/internal/pose\"\n)\n\n// processReadBytes is the bytes this process has read so far (rchar of /proc/self/io),\n// the measure of what a call parses: the list tools read their collection with plain\n// file reads, so it sees them where a Files wrapper does not.\nfunc processReadBytes(t *testing.T) int {\n\tt.Helper()\n\traw, err := os.ReadFile(\"/proc/self/io\")\n\tif err != nil {\n\t\tt.Skipf(\"no /proc/self/io: %v\", err)\n\t}\n\tfor _, line := range strings.Split(string(raw), \"\\n\") {\n\t\tvar n int\n\t\tif _, err := fmt.Sscanf(line, \"rchar: %d\", &n); err == nil {\n\t\t\treturn n\n\t\t}\n\t}\n\tt.Skip(\"no rchar in /proc/self/io\")\n\treturn 0\n}\n\nfunc writePaddedSpec(t *testing.T, root, slug string) {\n\tt.Helper()\n\tpath := filepath.Join(root, \".pose\", \"specs\", slug, \"spec.md\")\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbody := fmt.Sprintf(\"---\\nslug: %s\\nstatus: draft\\ncreated_at: 2026-06-01\\n---\\n\\n# Spec: %s\\n\\n%s\\n\", slug, slug, strings.Repeat(\"filler line to give the file some weight\\n\", 100))\n\tif err := os.WriteFile(path, []byte(body), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\n// R8 measurement for the non-indexed collections: a page costs one recomputation of\n// the collection whatever its size (limit bounds what is returned, not what is read),\n// the bytes read grow linearly with the collection, and the response follows the page.\n// The numbers are logged; the assertions keep the relations.\nfunc TestPageCostIsMeasuredAndBounded(t *testing.T) {\n\ttype sample struct {\n\t\tread, response int\n\t\telapsed        time.Duration\n\t}\n\tmeasure := func(n, limit int) sample {\n\t\troot := t.TempDir()\n\t\tfor i := 0; i < n; i++ {\n\t\t\twritePaddedSpec(t, root, fmt.Sprintf(\"spec-%03d\", i))\n\t\t}\n\t\tts := httptest.NewServer(New(pose.Store{Root: root}).Handler(\"\", \"\"))\n\t\tdefer ts.Close()\n\t\targs := map[string]any{}\n\t\tif limit > 0 {\n\t\t\targs[\"limit\"] = limit\n\t\t}\n\t\traw, _ := json.Marshal(args)\n\t\tbody := fmt.Sprintf(`{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_list_specs\",\"arguments\":%s}}`, raw)\n\t\tpost(t, ts, body) // warm the process (first-use reads are not the collection's)\n\t\tbefore, start := processReadBytes(t), time.Now()\n\t\t_, out := post(t, ts, body)\n\t\telapsed := time.Since(start)\n\t\tafter := processReadBytes(t)\n\t\tresp, _ := json.Marshal(out.Result[\"structuredContent\"])\n\t\treturn sample{read: after - before, response: len(resp), elapsed: elapsed}\n\t}\n\tsmallFull, smallPage := measure(20, 0), measure(20, 5)\n\tlargeFull, largePage := measure(80, 0), measure(80, 5)\n\tfor _, row := range []struct {\n\t\tname string\n\t\ts    sample\n\t}{{\"n=20 full\", smallFull}, {\"n=20 limit=5\", smallPage}, {\"n=80 full\", largeFull}, {\"n=80 limit=5\", largePage}} {\n\t\tt.Logf(\"%-14s read=%7dB response=%6dB latency=%v\", row.name, row.s.read, row.s.response, row.s.elapsed)\n\t}\n\tif smallFull.read < 20*4000 {\n\t\tt.Fatalf(\"the measurement did not see the collection being read: %d bytes\", smallFull.read)\n\t}\n\t// A page reads the whole collection, as the unpaginated call does (within noise).\n\tfor _, p := range [][2]sample{{smallPage, smallFull}, {largePage, largeFull}} {\n\t\tlo, hi := p[1].read*8/10, p[1].read*12/10\n\t\tif p[0].read < lo || p[0].read > hi {\n\t\t\tt.Fatalf(\"a page changed the work done: read %d bytes against %d for the whole call\", p[0].read, p[1].read)\n\t\t}\n\t}\n\t// The bytes read grow linearly with the collection (4x the specs, at most ~5x the bytes).\n\tif largeFull.read > smallFull.read*5 {\n\t\tt.Fatalf(\"the work grew faster than the collection: n=20 %d, n=80 %d\", smallFull.read, largeFull.read)\n\t}\n\t// The response follows the page size, not the collection size.\n\tif largePage.response > smallPage.response*2 || largePage.response*3 > largeFull.response {\n\t\tt.Fatalf(\"the response did not follow the page: %d/%d against %d\", smallPage.response, largePage.response, largeFull.response)\n\t}\n}\n\n// With a published generation, verifying it reads and hashes every index file.\n// A page must not repeat that: the verification is reused while the descriptor and\n// the files it names are unchanged, so the second page reads far less than the\n// first call did (spec pose-generation-bound-query-cursors R5, R8; review finding).\nfunc TestAPageDoesNotReverifyAnUnchangedGeneration(t *testing.T) {\n\troot := t.TempDir()\n\tfor i := 0; i < 6; i++ {\n\t\twritePaddedSpec(t, root, fmt.Sprintf(\"spec-%03d\", i))\n\t}\n\toutputs := map[string][]byte{}\n\tfor _, name := range pose.IndexGenerationFiles {\n\t\toutputs[name] = []byte(\"[\" + strings.Repeat(\" \", 1<<20) + \"]\\n\")\n\t}\n\tif _, err := (pose.Store{Root: root}).PublishIndexGeneration(outputs, map[string]string{\"specs\": \"sha256:a\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tts := httptest.NewServer(New(pose.Store{Root: root}).Handler(\"\", \"\"))\n\tdefer ts.Close()\n\tcall := func() int {\n\t\tbefore := processReadBytes(t)\n\t\tpost(t, ts, `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_list_specs\",\"arguments\":{\"limit\":2}}}`)\n\t\treturn processReadBytes(t) - before\n\t}\n\tfirst, second := call(), call()\n\tt.Logf(\"first call read %d B (verifies the %d-file generation); the next read %d B\", first, len(pose.IndexGenerationFiles), second)\n\tif first < len(pose.IndexGenerationFiles)<<20 {\n\t\tt.Fatalf(\"the first call did not verify the generation: %d B\", first)\n\t}\n\tif second > first/4 {\n\t\tt.Fatalf(\"a page re-verified an unchanged generation: %d B after %d B\", second, first)\n\t}\n\t// A change to a legacy file beside the generation is seen again (status disclosed).\n\tif err := os.WriteFile(filepath.Join(root, \".pose\", \"indexes\", \"packages.json\"), []byte(\"{}\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_, out := post(t, ts, `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_list_specs\",\"arguments\":{\"limit\":2}}}`)\n\tsc, _ := out.Result[\"structuredContent\"].(map[string]any)\n\tpage, _ := sc[\"page\"].(map[string]any)\n\tif diverged, _ := page[\"generation_diverged\"].([]any); len(diverged) != 1 || diverged[0] != \"packages.json\" {\n\t\tt.Fatalf(\"a changed legacy file was not seen after the reuse: %+v\", page)\n\t}\n}\n\nfunc TestAReusedGenerationSeesASymlinkTargetChange(t *testing.T) {\n\troot := t.TempDir()\n\tfor i := 0; i < 3; i++ {\n\t\twritePaddedSpec(t, root, fmt.Sprintf(\"spec-%03d\", i))\n\t}\n\toutputs := map[string][]byte{}\n\tfor _, name := range pose.IndexGenerationFiles {\n\t\toutputs[name] = []byte(\"[]\\n\")\n\t}\n\tif _, err := (pose.Store{Root: root}).PublishIndexGeneration(outputs, map[string]string{\"specs\": \"sha256:a\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tidx := filepath.Join(root, \".pose\", \"indexes\")\n\t// A legacy file that is a link to a copy with the generation's bytes: not diverged.\n\tgood := filepath.Join(idx, \"good-copy.json\")\n\tif err := os.WriteFile(good, outputs[\"packages.json\"], 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tlink := filepath.Join(idx, \"packages.json\")\n\t_ = os.Remove(link)\n\tif err := os.Symlink(\"good-copy.json\", link); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tts := httptest.NewServer(New(pose.Store{Root: root}).Handler(\"\", \"\"))\n\tdefer ts.Close()\n\tdiverged := func() []any {\n\t\t_, out := post(t, ts, `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_list_specs\",\"arguments\":{\"limit\":2}}}`)\n\t\tsc, _ := out.Result[\"structuredContent\"].(map[string]any)\n\t\tpage, _ := sc[\"page\"].(map[string]any)\n\t\td, _ := page[\"generation_diverged\"].([]any)\n\t\treturn d\n\t}\n\tif d := diverged(); len(d) != 0 {\n\t\tt.Fatalf(\"a link to identical bytes diverged: %v\", d)\n\t}\n\t// Retarget the link at different bytes: the cached verification must not hide it.\n\tbad := filepath.Join(idx, \"bad-copy.json\")\n\tif err := os.WriteFile(bad, []byte(\"{\\\"changed\\\":true}\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_ = os.Remove(link)\n\tif err := os.Symlink(\"bad-copy.json\", link); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif d := diverged(); len(d) != 1 || d[0] != \"packages.json\" {\n\t\tt.Fatalf(\"a retargeted link was not seen after the reuse: %v\", d)\n\t}\n}\n\nfunc TestAReusedGenerationSeesAnEditThatPreservesSizeAndModTime(t *testing.T) {\n\troot := t.TempDir()\n\tfor i := 0; i < 3; i++ {\n\t\twritePaddedSpec(t, root, fmt.Sprintf(\"spec-%03d\", i))\n\t}\n\toutputs := map[string][]byte{}\n\tfor _, name := range pose.IndexGenerationFiles {\n\t\toutputs[name] = []byte(\"[]\\n\")\n\t}\n\tif _, err := (pose.Store{Root: root}).PublishIndexGeneration(outputs, map[string]string{\"specs\": \"sha256:a\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tts := httptest.NewServer(New(pose.Store{Root: root}).Handler(\"\", \"\"))\n\tdefer ts.Close()\n\tdiverged := func() []any {\n\t\t_, out := post(t, ts, `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_list_specs\",\"arguments\":{\"limit\":2}}}`)\n\t\tsc, _ := out.Result[\"structuredContent\"].(map[string]any)\n\t\tpage, _ := sc[\"page\"].(map[string]any)\n\t\td, _ := page[\"generation_diverged\"].([]any)\n\t\treturn d\n\t}\n\tif d := diverged(); len(d) != 0 {\n\t\tt.Fatalf(\"a whole generation diverged: %v\", d)\n\t}\n\tlegacy := filepath.Join(root, \".pose\", \"indexes\", \"packages.json\")\n\tinfo, err := os.Stat(legacy)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// Same size, same modification time, different bytes.\n\tif err := os.WriteFile(legacy, []byte(\"{}\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Chtimes(legacy, info.ModTime(), info.ModTime()); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif d := diverged(); len(d) != 1 || d[0] != \"packages.json\" {\n\t\tt.Fatalf(\"an edit that restored size and mtime was hidden by the cache: %v\", d)\n\t}\n}\n//go:build linux\n\npackage mcpserver\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"syscall\"\n)\n\n// fileIdentity adds what a metadata-preserving edit cannot restore: the inode and\n// the status-change time, which any write or utimes call moves even when the\n// modification time is put back.\nfunc fileIdentity(info os.FileInfo) string {\n\tif st, ok := info.Sys().(*syscall.Stat_t); ok {\n\t\treturn fmt.Sprintf(\"#%d.%d:%d\", st.Dev, st.Ino, st.Ctim.Nano())\n\t}\n\treturn \"\"\n}\n//go:build !linux\n\npackage mcpserver\n\nimport \"os\"\n\n// fileIdentity has no portable inode or status-change time off Linux; the\n// size, mode and modification time remain the signature there.\nfunc fileIdentity(info os.FileInfo) string { return \"\" }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/mcpserver/generation_cursor_test.go'","aggregated_output":"package mcpserver\n\n// Generation-bound query cursors over MCP (spec pose-generation-bound-query-cursors).\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http/httptest\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nfunc cursorServer(t *testing.T, n int) (*httptest.Server, string) {\n\tt.Helper()\n\troot := t.TempDir()\n\tfor i := 0; i < n; i++ {\n\t\twriteCursorSpec(t, root, fmt.Sprintf(\"spec-%02d\", i))\n\t}\n\tts := httptest.NewServer(New(pose.Store{Root: root}).Handler(\"\", \"\"))\n\tt.Cleanup(ts.Close)\n\treturn ts, root\n}\n\nfunc writeCursorSpec(t *testing.T, root, slug string) {\n\tt.Helper()\n\tpath := filepath.Join(root, \".pose\", \"specs\", slug, \"spec.md\")\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbody := fmt.Sprintf(\"---\\nslug: %s\\nstatus: draft\\ncreated_at: 2026-06-01\\n---\\n\\n# Spec: %s\\n\", slug, slug)\n\tif err := os.WriteFile(path, []byte(body), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\n// call returns the structured result and whether the tool reported an error and its text.\nfunc cursorCall(t *testing.T, ts *httptest.Server, tool string, args map[string]any) (map[string]any, bool, string) {\n\tt.Helper()\n\traw, _ := json.Marshal(args)\n\t_, out := post(t, ts, fmt.Sprintf(`{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":%q,\"arguments\":%s}}`, tool, raw))\n\tisErr, _ := out.Result[\"isError\"].(bool)\n\tstructured, _ := out.Result[\"structuredContent\"].(map[string]any)\n\ttext := \"\"\n\tif content, ok := out.Result[\"content\"].([]any); ok && len(content) > 0 {\n\t\tif m, ok := content[0].(map[string]any); ok {\n\t\t\ttext, _ = m[\"text\"].(string)\n\t\t}\n\t}\n\treturn structured, isErr, text\n}\n\nfunc TestEveryPageDisclosesItsGenerationAndCollection(t *testing.T) {\n\tts, _ := cursorServer(t, 7)\n\tresult, isErr, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\tif isErr {\n\t\tt.Fatal(\"first page failed\")\n\t}\n\tpage, _ := result[\"page\"].(map[string]any)\n\tif page[\"collection\"] == \"\" || page[\"collection\"] == nil || page[\"disclosure\"] == nil || page[\"total\"] != float64(7) {\n\t\tt.Fatalf(\"the page does not disclose what it was read from: %+v\", page)\n\t}\n\tif result[\"next_cursor\"] == \"\" {\n\t\tt.Fatal(\"no cursor for a collection larger than the page\")\n\t}\n}\n\nfunc TestACursorIsRefusedAfterTheCollectionChangesBetweenPages(t *testing.T) {\n\tts, root := cursorServer(t, 7)\n\tfirst, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\tcursor, _ := first[\"next_cursor\"].(string)\n\n\t// An unchanged collection continues.\n\tif _, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"cursor\": cursor}); isErr {\n\t\tt.Fatalf(\"an unchanged collection must continue: %s\", text)\n\t}\n\t// A new spec arrives: the cursor is stale, not continued over the changed collection.\n\twriteCursorSpec(t, root, \"spec-new\")\n\t_, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"cursor\": cursor})\n\tif !isErr || !strings.Contains(text, pose.CursorStale) || !strings.Contains(text, \"restart\") {\n\t\tt.Fatalf(\"a changed collection was continued or the refusal is not actionable: err=%v %q\", isErr, text)\n\t}\n\t// Restarting from the first page works and sees the new spec.\n\tagain, isErr, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\tif isErr || again[\"total\"] != float64(8) {\n\t\tt.Fatalf(\"restart did not see the changed collection: %+v\", again)\n\t}\n}\n\nfunc TestACursorStaysWithItsToolAndFilters(t *testing.T) {\n\tts, _ := cursorServer(t, 7)\n\tfirst, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\tcursor, _ := first[\"next_cursor\"].(string)\n\tif _, isErr, text := cursorCall(t, ts, \"pose_list_roadmaps\", map[string]any{\"limit\": 3, \"cursor\": cursor}); !isErr || !strings.Contains(text, pose.CursorBinding) {\n\t\tt.Fatalf(\"a cursor crossed to another tool: %v %q\", isErr, text)\n\t}\n\tif _, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"cursor\": cursor, \"status\": \"done\"}); !isErr || !strings.Contains(text, pose.CursorBinding) {\n\t\tt.Fatalf(\"a cursor survived a changed filter: %v %q\", isErr, text)\n\t}\n}\n\nfunc TestACursorDoesNotSurviveAnotherServerProcess(t *testing.T) {\n\tts, root := cursorServer(t, 7)\n\tfirst, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\tcursor, _ := first[\"next_cursor\"].(string)\n\tother := httptest.NewServer(New(pose.Store{Root: root}).Handler(\"\", \"\"))\n\tt.Cleanup(other.Close)\n\t_, isErr, text := cursorCall(t, other, \"pose_list_specs\", map[string]any{\"limit\": 3, \"cursor\": cursor})\n\tif !isErr || !strings.Contains(text, pose.CursorSignature) {\n\t\tt.Fatalf(\"a cursor crossed a process boundary: %v %q\", isErr, text)\n\t}\n}\n\nfunc TestAHostileCursorIsRefusedOverMCP(t *testing.T) {\n\tts, _ := cursorServer(t, 7)\n\tfor _, token := range []string{\"AAAA\", \"eyJ2IjoxLCJhZnRlciI6M30\", strings.Repeat(\"x\", pose.GenerationCursorMaxBytes+1)} {\n\t\tif _, isErr, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"cursor\": token}); !isErr {\n\t\t\tt.Errorf(\"hostile cursor %.12q was accepted\", token)\n\t\t}\n\t}\n}\n\nfunc TestPageLimitIsBoundedAndDisclosed(t *testing.T) {\n\tts, _ := cursorServer(t, 3)\n\tresult, isErr, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 100000})\n\tpage, _ := result[\"page\"].(map[string]any)\n\tif isErr || page[\"limit_applied\"] != float64(pose.GenerationPageMax) {\n\t\tt.Fatalf(\"an oversized limit was not bounded and disclosed: %v %+v\", isErr, page)\n\t}\n}\n\nfunc TestACursorIsRefusedWhenAReturnedFieldChanges(t *testing.T) {\n\tts, root := cursorServer(t, 7)\n\tfirst, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\tcursor, _ := first[\"next_cursor\"].(string)\n\t// A field the listing returns changes while the slug, status and date do not.\n\tpath := filepath.Join(root, \".pose\", \"specs\", \"spec-05\", \"spec.md\")\n\tbody := \"---\\nslug: spec-05\\nstatus: draft\\ncreated_at: 2026-06-01\\npriority: 3\\n---\\n\\n# Spec: spec-05\\n\"\n\tif err := os.WriteFile(path, []byte(body), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"cursor\": cursor})\n\tif !isErr || !strings.Contains(text, pose.CursorStale) {\n\t\tt.Fatalf(\"a cursor continued over changed results: %v %q\", isErr, text)\n\t}\n}\n\nfunc TestEquivalentFiltersShareACursor(t *testing.T) {\n\tts, _ := cursorServer(t, 7)\n\tfirst, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"status\": \"Draft, draft\"})\n\tif isErr {\n\t\tt.Fatal(text)\n\t}\n\tcursor, _ := first[\"next_cursor\"].(string)\n\tif _, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"cursor\": cursor, \"status\": \"draft\"}); isErr {\n\t\tt.Fatalf(\"equivalent filters were treated as another query: %s\", text)\n\t}\n}\n\nfunc TestAPageStatesItsCostAndGenerationStatus(t *testing.T) {\n\tts, _ := cursorServer(t, 3)\n\tresult, isErr, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 2})\n\tpage, _ := result[\"page\"].(map[string]any)\n\tif isErr || page[\"cost\"] == nil || !strings.Contains(page[\"cost\"].(string), \"full-scan\") || page[\"generation_status\"] == nil {\n\t\tt.Fatalf(\"a page must state its cost and the status of its generation: %v %+v\", isErr, page)\n\t}\n}\n\nfunc TestAContinuationWithoutALimitIsBoundedOverMCP(t *testing.T) {\n\tts, _ := cursorServer(t, pose.GenerationPageMax+25)\n\tfirst, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 1})\n\tcursor, _ := first[\"next_cursor\"].(string)\n\tsecond, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"cursor\": cursor})\n\tif isErr {\n\t\tt.Fatal(text)\n\t}\n\tif got := second[\"count\"]; got != float64(pose.GenerationPageMax) {\n\t\tt.Fatalf(\"a continuation without limit returned %v items, want %d\", got, pose.GenerationPageMax)\n\t}\n}\n\nfunc TestAnExplicitNonPositiveLimitIsRefusedOnEveryPaginatedTool(t *testing.T) {\n\tts, _ := cursorServer(t, 3)\n\tfor _, tool := range []string{\"pose_list_specs\", \"pose_list_roadmaps\", \"pose_list_knowledge\", \"pose_list_reports\", \"pose_capability_history\"} {\n\t\tfor _, limit := range []any{0, -1, nil} {\n\t\t\tif _, isErr, _ := cursorCall(t, ts, tool, map[string]any{\"limit\": limit}); !isErr {\n\t\t\t\tt.Errorf(\"%s accepted limit %v\", tool, limit)\n\t\t\t}\n\t\t}\n\t}\n\tif _, isErr, text := cursorCall(t, ts, \"pose_list_roadmaps\", map[string]any{}); isErr {\n\t\tt.Fatalf(\"omitting the limit is the legacy call and must work: %s\", text)\n\t}\n}\n\nfunc TestAPageCarriesTheIndexReadersStatusReasonAndDivergedFiles(t *testing.T) {\n\tts, root := cursorServer(t, 3)\n\toutputs := map[string][]byte{}\n\tfor _, name := range pose.IndexGenerationFiles {\n\t\toutputs[name] = []byte(\"[]\\n\")\n\t}\n\tif _, err := (pose.Store{Root: root}).PublishIndexGeneration(outputs, map[string]string{\"specs\": \"sha256:a\"}); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresult, isErr, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 2})\n\tpage, _ := result[\"page\"].(map[string]any)\n\tif isErr || page[\"generation_status\"] != \"current\" || page[\"generation\"] == \"\" || page[\"generation_diverged\"] != nil {\n\t\tt.Fatalf(\"a whole, untouched generation: %v %+v\", isErr, page)\n\t}\n\t// A legacy file edited by hand beside a whole generation: the generation is still\n\t// current, and the page names the files that diverge from it.\n\tidx := filepath.Join(root, \".pose\", \"indexes\")\n\tif err := os.WriteFile(filepath.Join(idx, \"packages.json\"), []byte(\"{}\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Remove(filepath.Join(idx, \"releases.json\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresult, isErr, _ = cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 2})\n\tpage, _ = result[\"page\"].(map[string]any)\n\tdiverged, _ := page[\"generation_diverged\"].([]any)\n\tif isErr || page[\"generation_status\"] != \"current\" || len(diverged) != 2 || diverged[0] != \"packages.json\" || diverged[1] != \"releases.json\" {\n\t\tt.Fatalf(\"the diverged legacy files were not disclosed: %v %+v\", isErr, page)\n\t}\n\t// A broken generation is not reported as current, and its reason is kept.\n\tif err := os.WriteFile(filepath.Join(idx, \"generation.json\"), []byte(\"not json\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tresult, _, _ = cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 2})\n\tpage, _ = result[\"page\"].(map[string]any)\n\tif page[\"generation_status\"] == \"current\" || page[\"generation_status\"] == nil || page[\"generation_reason\"] == nil {\n\t\tt.Fatalf(\"an unavailable generation lost its status or reason: %+v\", page)\n\t}\n}\n\nfunc TestAnAliasOfLimitOrCursorIsRefused(t *testing.T) {\n\tts, _ := cursorServer(t, 3)\n\tfor _, tool := range []string{\"pose_list_specs\", \"pose_list_roadmaps\", \"pose_list_knowledge\", \"pose_list_reports\", \"pose_capability_history\"} {\n\t\t_, out := post(t, ts, fmt.Sprintf(`{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":%q,\"arguments\":{\"limit\":1,\"Limit\":0}}}`, tool))\n\t\tif isErr, _ := out.Result[\"isError\"].(bool); !isErr {\n\t\t\tt.Errorf(\"%s accepted a case-variant duplicate of limit\", tool)\n\t\t}\n\t}\n}\n\nfunc TestACursorAliasCannotRestartAWalk(t *testing.T) {\n\tts, _ := cursorServer(t, 7)\n\tfirst, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\tcursor, _ := first[\"next_cursor\"].(string)\n\tfor _, alias := range []string{\"Cursor\", \"CURSOR\"} {\n\t\targs, _ := json.Marshal(map[string]any{\"limit\": 3, \"cursor\": cursor, alias: \"\"})\n\t\t_, out := post(t, ts, fmt.Sprintf(`{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"pose_list_specs\",\"arguments\":%s}}`, args))\n\t\tif isErr, _ := out.Result[\"isError\"].(bool); !isErr {\n\t\t\tt.Errorf(\"a %s alias restarted or altered a continuation\", alias)\n\t\t}\n\t}\n}\n\nfunc TestAnOmittedSortAndSlugSortAreTheSameQuery(t *testing.T) {\n\tts, _ := cursorServer(t, 7)\n\tomitted, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3})\n\texplicit, _, _ := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"sort\": \"slug\"})\n\ta, _ := json.Marshal(omitted[\"specs\"])\n\tb, _ := json.Marshal(explicit[\"specs\"])\n\tif string(a) != string(b) {\n\t\tt.Fatalf(\"the default order is not slug order: %s vs %s\", a, b)\n\t}\n\tcursor, _ := omitted[\"next_cursor\"].(string)\n\tif _, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 3, \"cursor\": cursor, \"sort\": \"slug\"}); isErr {\n\t\tt.Fatalf(\"an equivalent sort was treated as another query: %s\", text)\n\t}\n}\n\nfunc TestANullCursorIsRefusedOnEveryPaginatedTool(t *testing.T) {\n\tts, _ := cursorServer(t, 3)\n\tfor _, tool := range []string{\"pose_list_specs\", \"pose_list_roadmaps\", \"pose_list_knowledge\", \"pose_list_reports\", \"pose_capability_history\"} {\n\t\tif _, isErr, _ := cursorCall(t, ts, tool, map[string]any{\"cursor\": nil}); !isErr {\n\t\t\tt.Errorf(\"%s accepted a null cursor\", tool)\n\t\t}\n\t}\n}\n\nfunc TestFiltersThatSerializeAlikeBindDifferentCursors(t *testing.T) {\n\tts, root := cursorServer(t, 0)\n\tfor i := 0; i < 4; i++ {\n\t\tslug := fmt.Sprintf(\"spec-%02d\", i)\n\t\tpath := filepath.Join(root, \".pose\", \"specs\", slug, \"spec.md\")\n\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tbody := fmt.Sprintf(\"---\\nslug: %s\\nstatus: draft\\ncreated_at: 2026-06-01\\ncomponents: x, y\\n---\\n\\n# Spec: %s\\n\", slug, slug)\n\t\tif err := os.WriteFile(path, []byte(body), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tfirst, isErr, text := cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 2, \"status\": \"draft,z;components=x\", \"components\": \"y\"})\n\tif isErr {\n\t\tt.Fatal(text)\n\t}\n\tcursor, _ := first[\"next_cursor\"].(string)\n\tif cursor == \"\" {\n\t\tt.Skip(\"the filters matched too few specs to page\")\n\t}\n\t_, isErr, text = cursorCall(t, ts, \"pose_list_specs\", map[string]any{\"limit\": 2, \"cursor\": cursor, \"status\": \"draft,z\", \"components\": \"x;components=y\"})\n\tif !isErr || !strings.Contains(text, pose.CursorBinding) {\n\t\tt.Fatalf(\"two different filter tuples shared one cursor binding: %v %q\", isErr, text)\n\t}\n}\n","exit_code":0,"status":"completed"}}
