ing\", \"slug\")\n\t\t}\n\t\treturn store.GetRoadmap(a.Slug)\n\tcase \"pose_suggest\":\n\t\tvar a struct {\n\t\t\tTaskType string `json:\"task_type\"`\n\t\t\tDomain   string `json:\"domain\"`\n\t\t\tPath     string `json:\"path\"`\n","exit_code":0,"status":"completed"}}
