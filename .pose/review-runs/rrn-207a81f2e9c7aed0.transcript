"sd-5c6c5a142f80c65b5e096d1fb903f738\",\"display_id\":\"SD-5c6c5a14\",\"kind\":\"governance-contract\",\"action\":\"added\",\"state\":\"observed\",\"subject\":\".pose/adr/2026-11-08-generation-bound-query-cursors.md\",\"path\":\".pose/adr/2026-11-08-generation-bound-query-cursors.md\",\"after_digest\":\"sha256:22102fcf5d4c1a70f05cbc2cc9b01c1476f4240d379743597c64e2a4bb508cc5\"},{\"id\":\"sd-8fba68cc3074fba904171d03d05a839f\",\"display_id\":\"SD-8fba68cc\",\"kind\":\"validation-check\",\"action\":\"added\",\"state\":\"observed\",\"subject\":\"moduleOverrides.pose-mcp:generation-bound-query-cursors-integration\",\"path\":\".pose/indexes/validation-matrix.json\"}]}\n\n\n","exit_code":0,"status":"completed"}}
