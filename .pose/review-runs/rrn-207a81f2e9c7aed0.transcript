t\t\teffectiveSort = \"slug\"\n+\t\t}\n+\t\tif recent > 0 {\n+\t\t\teffectiveSort = \"date\"\n+\t\t}\n+\t\t// An unambiguous encoding of the normalized tuple: a delimiter inside a value\n+\t\t// must not make two different queries read the same.\n+\t\tencoded, _ := json.Marshal([]any{canonicalList(a.Status), canonicalList(a.Components), effectiveSort, recent, sinceFilter})\n+\t\tfilters := string(encoded)\n+\t\tpage, next, meta, err := pageList(s, store, \"pose_list_specs\", filters, genBefore, specs, contentKeys(specs), a.Cursor, limit)\n \t\tif err != nil {\n-\t\t\treturn nil, fmt.Errorf(\"pose_list_specs: %w\", err)\n+\t\t\treturn nil, err\n \t\t}\n-\t\tpage, next := paginatePage(specs, after, limit)\n-\t\tresult := map[string]any{\"specs\": page, \"count\": len(page), \"total\": len(specs), \"next_cursor\": next}\n+\t\tresult := map[string]any{\"specs\": page, \"count\": len(page), \"total\": len(specs), \"next_cursor\": next, \"page\": meta}\n \t\tif notice := listNotice(len(specs), `narrow with \"status\" (comma-separated, e.g. \"draft,in-progress\"), \"components\" (comma-separated, matches any tag), or page with \"limit\"/\"cursor\"`); notice != \"\" {\n \t\t\tresult[\"notice\"] = notice\n \t\t}\n@@ -1641,16 +1668,19 @@ func (s *Server) dispatch(ctx context.Context, name string, args json.RawMessage\n \t\tif err := json.Unmarshal(args, &a); err != nil {\n \t\t\treturn nil, fmt.Errorf(\"pose_list_roadmaps: invalid arguments\")\n \t\t}\n+\t\tif err := requirePositiveLimit(\"pose_list_roadmaps\", args); err != nil {\n+\t\t\treturn nil, err\n+\t\t}\n+\t\tgenBefore := s.pageGeneration(store)\n \t\troadmaps, err := store.ListRoadmaps()\n \t\tif err != nil {\n \t\t\treturn nil, err\n \t\t}\n-\t\tafter, err := decodePageCursor(a.Cursor)\n+\t\tpage, next, meta, err := pageList(s, store, \"pose_list_roadmaps\", \"\", genBefore, roadmaps, contentKeys(roadmaps), a.Cursor, a.Limit)\n \t\tif err != nil {\n-\t\t\treturn nil, fmt.Errorf(\"pose_list_roadmaps: %w\", err)\n+\t