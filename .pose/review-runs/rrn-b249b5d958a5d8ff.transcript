{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UkdJV4DF1iYJSHEevxdtFz","type":"tool_result","content":"40\t\t\tx, y, path := record[0], record[1], record[3:]\n41\t\t\tstatus := \"M\"\n42\t\t\tswitch {\n43\t\t\tcase x == 'A':\n44\t\t\t\tif y == 'D' {\n45\t\t\t\t\tcontinue // added, then removed from the work tree: as in HEAD\n46\t\t\t\t}\n47\t\t\t\tstatus = \"A\"\n48\t\t\tcase x == 'D' || y == 'D':\n49\t\t\t\tstatus = \"D\"\n50\t\t\tcase x == 'T' || y == 'T':\n51\t\t\t\tstatus = \"T\"\n52\t\t\t}\n53\t\t\tchanges = append(changes, WorktreeChange{Status: status, Path: path})\n54\t\t}\n55\t\treturn changes, nil\n56\t}\n57\t\n58\t// WorktreeChangedNames returns the names `git diff --name-only <base>` would\n59\t// give against the work tree, without writing the index: the paths changed\n60\t// between base and HEAD, and the paths the work tree changes from HEAD. A\n61\t// path in both is listed only when the work tree still differs from base, as\n62\t// the diff would (compared by content, as `git hash-object` reads it).\n63\tfunc WorktreeChangedNames(root, base string, diffArgs ...string) ([]string, error) {\n64\t\tcommitted := map[string]bool{}\n65\t\tvar names []string\n66\t\tif base != \"\" && base != \"HEAD\" {\n67\t\t\targs := append([]string{\"-C\", root}, diffArgs...)\n68\t\t\targs = append(args, \"diff\", \"--name-only\", \"-z\", \"--no-renames\", base, \"HEAD\", \"--\")\n69\t\t\tout, err := RawGit(args...).Output()\n70\t\t\tif err != nil {\n71\t\t\t\treturn nil, fmt.Errorf(\"pose: git diff %s HEAD failed: %w\", base, err)\n72\t\t\t}\n73\t\t\tfor _, name := range strings.Split(string(out), \"\\x00\") {\n74\t\t\t\tif name != \"\" {\n75\t\t\t\t\tcommitted[name] = true\n76\t\t\t\t}\n77\t\t\t}\n78\t\t}\n79\t\tchanges, err := WorktreeChanges(root)\n80\t\tif err != nil {\n81\t\t\treturn nil, err\n82\t\t}\n83\t\tinWorktree := map[string]bool{}\n84\t\tfor _, c := range changes {\n85\t\t\tinWorktree[c.Path] = true\n86\t\t\tif !committed[c.Path] {\n87\t\t\t\tnames = append(names, c.Path)\n88\t\t\t\tcontinue\n89\t\t\t}\n90\t\t\tsame, err := worktreeMatchesCommit(root, base, c.Path)\n91\t\t\tif err != nil {\n92\t\t\t\treturn nil, err\n93\t\t\t}\n94\t\t\tif !same {\n95\t\t\t\tnames = append(names, c.Path)\n96\t\t\t}\n97\t\t}\n98\t\tfor name := range committed {\n99\t\t\tif !inWorktree[name] {\n100\t\t\t\tnames = append(names, name)\n101\t\t\t}\n102\t\t}\n103\t\tsort.Strings(names)\n104\t\treturn names, nil\n105\t}\n106\t\n107\t// worktreeMatchesCommit reports whether path in the work tree has the\n108\t// content it has at commit, both absent counting as a match; nothing is\n109\t// written (hash-object without -w).\n110\tfunc worktreeMatchesCommit(root, commit, path string) (bool, error) {\n111\t\twant, werr := RawGit(\"-C\", root, \"rev-parse\", \"--verify\", \"-q\", commit+\":\"+path).Output()\n112\t\tfull := filepath.Join(root, filepath.FromSlash(path))\n113\t\tinfo, err := os.Lstat(full)\n114\t\tif err != nil {\n115\t\t\tif os.IsNotExist(err) {\n116\t\t\t\treturn werr != nil, nil\n117\t\t\t}\n118\t\t\treturn false, err\n119\t\t}\n120\t\tif werr != nil {\n121\t\t\treturn false, nil\n122\t\t}\n123\t\tvar got []byte\n124\t\tif info.IsDir() {\n125\t\t\t// A submodule: its checked-out commit is what the gitlink records.\n126\t\t\tgot, err = RawGit(\"-C\", full, \"rev-parse\", \"HEAD\").Output()\n127\t\t} else {\n128\t\t\tgot, err = RawGit(\"-C\", root, \"hash-object\", \"--path=\"+path, \"--\", path).Output()\n129\t\t}\n130\t\tif err != nil {\n131\t\t\treturn false, fmt.Errorf(\"pose: git hash-object %s failed: %w\", path, err)\n132\t\t}\n133\t\treturn strings.TrimSpace(string(got)) == strings.TrimSpace(string(want)), nil\n134\t}\n135\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"ded29ac0-d284-4633-b309-b11e00443617","timestamp":"2026-11-26T14:33:51.325Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-11b0b7dffb/worktree/pose-mcp/internal/pose/git_worktree_reads.go","content":"\t\tx, y, path := record[0], record[1], record[3:]\n\t\tstatus := \"M\"\n\t\tswitch {\n\t\tcase x == 'A':\n\t\t\tif y == 'D' {\n\t\t\t\tcontinue // added, then removed from the work tree: as in HEAD\n\t\t\t}\n\t\t\tstatus = \"A\"\n\t\tcase x == 'D' || y == 'D':\n\t\t\tstatus = \"D\"\n\t\tcase x == 'T' || y == 'T':\n\t\t\tstatus = \"T\"\n\t\t}\n\t\tchanges = append(changes, WorktreeChange{Status: status, Path: path})\n\t}\n\treturn changes, nil\n}\n\n// WorktreeChangedNames returns the names `git diff --name-only <base>` would\n// give against the work tree, without writing the index: the paths changed\n// between base and HEAD, and the paths the work tree changes from HEAD. A\n// path in both is listed only when the work tree still differs from base, as\n// the diff would (compared by content, as `git hash-object` reads it).\nfunc WorktreeChangedNames(root, base string, diffArgs ...string) ([]string, error) {\n\tcommitted := map[string]bool{}\n\tvar names []string\n\tif base != \"\" && base != \"HEAD\" {\n\t\targs := append([]string{\"-C\", root}, diffArgs...)\n\t\targs = append(args, \"diff\", \"--name-only\", \"-z\", \"--no-renames\", base, \"HEAD\", \"--\")\n\t\tout, err := RawGit(args...).Output()\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"pose: git diff %s HEAD failed: %w\", base, err)\n\t\t}\n\t\tfor _, name := range strings.Split(string(out), \"\\x00\") {\n\t\t\tif name != \"\" {\n\t\t\t\tcommitted[name] = true\n\t\t\t}\n\t\t}\n\t}\n\tchanges, err := WorktreeChanges(root)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tinWorktree := map[string]bool{}\n\tfor _, c := range changes {\n\t\tinWorktree[c.Path] = true\n\t\tif !committed[c.Path] {\n\t\t\tnames = append(names, c.Path)\n\t\t\tcontinue\n\t\t}\n\t\tsame, err := worktreeMatchesCommit(root, base, c.Path)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif !same {\n\t\t\tnames = append(names, c.Path)\n\t\t}\n\t}\n\tfor name := range committed {\n\t\tif !inWorktree[name] {\n\t\t\tnames = append(names, name)\n\t\t}\n\t}\n\tsort.Strings(names)\n\treturn names, nil\n}\n\n// worktreeMatchesCommit reports whether path in the work tree has the\n// content it has at commit, both absent counting as a match; nothing is\n// written (hash-object without -w).\nfunc worktreeMatchesCommit(root, commit, path string) (bool, error) {\n\twant, werr := RawGit(\"-C\", root, \"rev-parse\", \"--verify\", \"-q\", commit+\":\"+path).Output()\n\tfull := filepath.Join(root, filepath.FromSlash(path))\n\tinfo, err := os.Lstat(full)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn werr != nil, nil\n\t\t}\n\t\treturn false, err\n\t}\n\tif werr != nil {\n\t\treturn false, nil\n\t}\n\tvar got []byte\n\tif info.IsDir() {\n\t\t// A submodule: its checked-out commit is what the gitlink records.\n\t\tgot, err = RawGit(\"-C\", full, \"rev-parse\", \"HEAD\").Output()\n\t} else {\n\t\tgot, err = RawGit(\"-C\", root, \"hash-object\", \"--path=\"+path, \"--\", path).Output()\n\t}\n\tif err != nil {\n\t\treturn false, fmt.Errorf(\"pose: git hash-object %s failed: %w\", path, err)\n\t}\n\treturn strings.TrimSpace(string(got)) == strings.TrimSpace(string(want)), nil\n}\n","numLines":96,"startLine":40,"totalLines":135}},"tool_result_meta":[{"id":"toolu_01UkdJV4DF1iYJSHEevxdtFz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
