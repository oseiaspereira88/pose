{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014duzTHF82FFBXGwg5LcBw3","type":"tool_result","content":"590\t\tif err != nil {\n591\t\t\treturn nil, err\n592\t\t}\n593\t\tif !sameOrAbove(strings.TrimSpace(string(top)), root) {\n594\t\t\treturn nil, fmt.Errorf(\"Git selected another worktree\")\n595\t\t}\n596\t\troot = strings.TrimSpace(string(top))\n597\t\tchanged, err := gitMaterializedChangesFor(root, commit, matters)\n598\t\tif err != nil {\n599\t\t\treturn nil, err\n600\t\t}\n601\t\tstatus, err := ReadGitStatus(root)\n602\t\tif err != nil {\n603\t\t\treturn nil, err\n604\t\t}\n605\t\tfor _, entry := range status {\n606\t\t\t// Fixture worktrees need not carry the root .gitignore. Keep an\n607\t\t\t// untracked lock out of material status in that case, while still\n608\t\t\t// treating a staged/modified lock as a real repository change.\n609\t\t\tif untrackedAuthorityTransferLock(entry) {\n610\t\t\t\tcontinue\n611\t\t\t}\n612\t\t\tchanged = append(changed, entry.Path)\n613\t\t\tif entry.OrigPath != \"\" {\n614\t\t\t\tchanged = append(changed, entry.OrigPath)\n615\t\t\t}\n616\t\t}\n617\t\ttracked := map[string]bool{}\n618\t\tif allowed != nil {\n619\t\t\tout, err := snapshotGit(root, \"ls-tree\", \"-r\", \"-z\", \"--name-only\", commit)\n620\t\t\tif err != nil {\n621\t\t\t\treturn nil, err\n622\t\t\t}\n623\t\t\tfor _, path := range bytes.Split(out, []byte{0}) {\n624\t\t\t\ttracked[string(path)] = true\n625\t\t\t}\n626\t\t}\n627\t\tseen := map[string]bool{}\n628\t\tresult := []string{}\n629\t\tfor _, path := range changed {\n630\t\t\t_, regularErr := dispatchRegularInputPath(root, path)\n631\t\t\tif seen[path] || (allowed != nil && allowed(path, tracked[path]) && regularErr == nil) {\n632\t\t\t\tcontinue\n633\t\t\t}\n634\t\t\tseen[path] = true\n635\t\t\tresult = append(result, path)\n636\t\t}\n637\t\tsort.Strings(result)\n638\t\treturn result, nil\n639\t}\n640\t\n641\tfunc gitCommand(args ...string) *exec.Cmd {\n642\t\treturn gitCommandContext(context.Background(), args...)\n643\t}\n644\t\n645\t// gitCommandContext is gitCommand under ctx. Both read raw object history: a\n646\t// replace ref or a graft changes what a commit is, and every gate has to judge\n647\t// the same commit (spec pose-history-readers-read-raw R1, D1).\n648\tfunc gitCommandContext(ctx context.Context, args ...string) *exec.Cmd {\n649\t\t// The graft file below is the null device, and Git hints at any graft file on\n650\t\t// stderr, which a caller that reads stderr as uncertainty would take for a failure.\n651\t\tcmd := exec.CommandContext(ctx, \"git\", append([]string{\"-c\", \"advice.graftFileDeprecated=false\"}, args...)...)\n652\t\tenv := make([]string, 0, len(os.Environ())+2)\n653\t\tfor _, kv := range os.Environ() {\n654\t\t\tname, _, _ := strings.Cut(kv, \"=\")\n655\t\t\tif !gitRedirectingEnv[name] {\n656\t\t\t\tenv = append(env, kv)\n657\t\t\t}\n658\t\t}\n659\t\t// An engine read never takes the optional index lock nor rewrites the\n660\t\t// index's stat cache: a concurrent reader would see .git change under\n661\t\t// it (spec pose-validate-reads-leave-the-index-alone R1).\n662\t\tcmd.Env = append(env, \"GIT_NO_REPLACE_OBJECTS=1\", \"GIT_GRAFT_FILE=\"+os.DevNull, \"GIT_OPTIONAL_LOCKS=0\")\n663\t\treturn cmd\n664\t}\n665\t\n666\tconst (\n667\t\tgitEmptyTreeSHA1   = \"4b825dc642cb6eb9a060e54bf8d69288fbee4904\"\n668\t\tgitEmptyTreeSHA256 = \"6ef19b41225c5369f1c104d45d8d85efa9b057b53b14b4b9b939dd74decc5321\"\n669\t)\n670\t\n671\t// GitEmptyTree is the empty tree in commit's object format: the base of a change\n672\t// set that starts at a repository's first commit (spec\n673\t// pose-history-readers-read-raw R2, D2).\n674\tfunc GitEmptyTree(commit string) string {\n675\t\tif len(commit) == len(gitEmptyTreeSHA256) {\n676\t\t\treturn gitEmptyTreeSHA256\n677\t\t}\n678\t\treturn gitEmptyTreeSHA1\n679\t}\n680\t\n681\t// IsGitEmptyTree says that revision is the base of such a change set.\n682\tfunc IsGitEmptyTree(revision string) bool {\n683\t\treturn revision == gitEmptyTreeSHA1 || revision == gitEmptyTreeSHA256\n684\t}\n685\t\n686\t// ChangeSetRange is the revision range of a change set for rev-list and log.\n687\tfunc ChangeSetRange(base, head string) string {\n688\t\tif IsGitEmptyTree(base) {\n689\t\t\treturn head\n690\t\t}\n691\t\treturn base + \"..\" + head\n692\t}\n693\t\n694\tfunc linkAbove(worktree, name string, checked map[string]bool) bool {\n695\t\tparts := strings.Split(name, \"/\")\n696\t\tdir := \"\"\n697\t\tfor _, part := range parts[:len(parts)-1] {\n698\t\t\tdir = path.Join(dir, part)\n699\t\t\tif bad, seen := checked[dir]; seen {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"9383037c-7c99-4785-a860-367e41f180c5","timestamp":"2026-11-26T13:38:54.671Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-11b0b7dffb/worktree/pose-mcp/internal/pose/git_snapshot_integrity.go","content":"\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif !sameOrAbove(strings.TrimSpace(string(top)), root) {\n\t\treturn nil, fmt.Errorf(\"Git selected another worktree\")\n\t}\n\troot = strings.TrimSpace(string(top))\n\tchanged, err := gitMaterializedChangesFor(root, commit, matters)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tstatus, err := ReadGitStatus(root)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tfor _, entry := range status {\n\t\t// Fixture worktrees need not carry the root .gitignore. Keep an\n\t\t// untracked lock out of material status in that case, while still\n\t\t// treating a staged/modified lock as a real repository change.\n\t\tif untrackedAuthorityTransferLock(entry) {\n\t\t\tcontinue\n\t\t}\n\t\tchanged = append(changed, entry.Path)\n\t\tif entry.OrigPath != \"\" {\n\t\t\tchanged = append(changed, entry.OrigPath)\n\t\t}\n\t}\n\ttracked := map[string]bool{}\n\tif allowed != nil {\n\t\tout, err := snapshotGit(root, \"ls-tree\", \"-r\", \"-z\", \"--name-only\", commit)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfor _, path := range bytes.Split(out, []byte{0}) {\n\t\t\ttracked[string(path)] = true\n\t\t}\n\t}\n\tseen := map[string]bool{}\n\tresult := []string{}\n\tfor _, path := range changed {\n\t\t_, regularErr := dispatchRegularInputPath(root, path)\n\t\tif seen[path] || (allowed != nil && allowed(path, tracked[path]) && regularErr == nil) {\n\t\t\tcontinue\n\t\t}\n\t\tseen[path] = true\n\t\tresult = append(result, path)\n\t}\n\tsort.Strings(result)\n\treturn result, nil\n}\n\nfunc gitCommand(args ...string) *exec.Cmd {\n\treturn gitCommandContext(context.Background(), args...)\n}\n\n// gitCommandContext is gitCommand under ctx. Both read raw object history: a\n// replace ref or a graft changes what a commit is, and every gate has to judge\n// the same commit (spec pose-history-readers-read-raw R1, D1).\nfunc gitCommandContext(ctx context.Context, args ...string) *exec.Cmd {\n\t// The graft file below is the null device, and Git hints at any graft file on\n\t// stderr, which a caller that reads stderr as uncertainty would take for a failure.\n\tcmd := exec.CommandContext(ctx, \"git\", append([]string{\"-c\", \"advice.graftFileDeprecated=false\"}, args...)...)\n\tenv := make([]string, 0, len(os.Environ())+2)\n\tfor _, kv := range os.Environ() {\n\t\tname, _, _ := strings.Cut(kv, \"=\")\n\t\tif !gitRedirectingEnv[name] {\n\t\t\tenv = append(env, kv)\n\t\t}\n\t}\n\t// An engine read never takes the optional index lock nor rewrites the\n\t// index's stat cache: a concurrent reader would see .git change under\n\t// it (spec pose-validate-reads-leave-the-index-alone R1).\n\tcmd.Env = append(env, \"GIT_NO_REPLACE_OBJECTS=1\", \"GIT_GRAFT_FILE=\"+os.DevNull, \"GIT_OPTIONAL_LOCKS=0\")\n\treturn cmd\n}\n\nconst (\n\tgitEmptyTreeSHA1   = \"4b825dc642cb6eb9a060e54bf8d69288fbee4904\"\n\tgitEmptyTreeSHA256 = \"6ef19b41225c5369f1c104d45d8d85efa9b057b53b14b4b9b939dd74decc5321\"\n)\n\n// GitEmptyTree is the empty tree in commit's object format: the base of a change\n// set that starts at a repository's first commit (spec\n// pose-history-readers-read-raw R2, D2).\nfunc GitEmptyTree(commit string) string {\n\tif len(commit) == len(gitEmptyTreeSHA256) {\n\t\treturn gitEmptyTreeSHA256\n\t}\n\treturn gitEmptyTreeSHA1\n}\n\n// IsGitEmptyTree says that revision is the base of such a change set.\nfunc IsGitEmptyTree(revision string) bool {\n\treturn revision == gitEmptyTreeSHA1 || revision == gitEmptyTreeSHA256\n}\n\n// ChangeSetRange is the revision range of a change set for rev-list and log.\nfunc ChangeSetRange(base, head string) string {\n\tif IsGitEmptyTree(base) {\n\t\treturn head\n\t}\n\treturn base + \"..\" + head\n}\n\nfunc linkAbove(worktree, name string, checked map[string]bool) bool {\n\tparts := strings.Split(name, \"/\")\n\tdir := \"\"\n\tfor _, part := range parts[:len(parts)-1] {\n\t\tdir = path.Join(dir, part)\n\t\tif bad, seen := checked[dir]; seen {","numLines":110,"startLine":590,"totalLines":764}},"tool_result_meta":[{"id":"toolu_014duzTHF82FFBXGwg5LcBw3","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
