dUnknownForProject(files, root, \"\", producer, \"commit path inventory could not be read from Git\")\n \t\t}\n \t\treturn nil, false\n \t}\n-\tpaths := map[string]bool{}\n-\tfor _, path := range strings.Split(string(raw), \"\\x00\") {\n-\t\tif path != \"\" {\n-\t\t\tpaths[path] = true\n-\t\t}\n-\t}\n \treturn paths, true\n }\n \ndiff --git a/pose-mcp/internal/pose/test_catalog.go b/pose-mcp/internal/pose/test_catalog.go\nindex 2ed091ba..0278cef5 100644\n--- a/pose-mcp/internal/pose/test_catalog.go\n+++ b/pose-mcp/internal/pose/test_catalog.go\n@@ -3,13 +3,15 @@ package pose\n import (\n \t\"bytes\"\n \t\"context\"\n+\t\"crypto/sha256\"\n \t\"encoding/json\"\n+\t\"errors\"\n+\t\"fmt\"\n \t\"os\"\n \t\"path/filepath\"\n \t\"regexp\"\n \t\"sort\"\n \t\"strings\"\n-\t\"sync\"\n \t\"time\"\n )\n \n@@ -39,36 +41,89 @@ var (\n \trustTestFnRE  = regexp.MustCompile(`#\\[(?:tokio::)?test\\]\\s*(?:#\\[[^\\]]*\\]\\s*)*(?:pub\\s+)?(?:async\\s+)?fn (\\w+)`)\n \tslugSepRE     = regexp.MustCompile(`[^a-z0-9]+`)\n \n-\ttestCatalogCache = struct {\n-\t\tsync.Mutex\n-\t\tbyRoot map[string]*TestCatalog\n-\t}{byRoot: map[string]*TestCatalog{}}\n+\t// testCatalogCache is bounded in bytes and metered per root, and an entry is\n+\t// keyed by the root and the digest of the validation matrix and lives for\n+\t// testCatalogTTL: the catalog reads the working tree, so a long-lived server must\n+\t// not serve one built before the tests changed (spec\n+\t// pose-bounded-isolated-graph-caches R3/R6). A short-lived CLI builds it once.\n+\ttestCatalogCache = newBoundedCache(32<<20, 16<<20, testCatalogTTL, func(c *TestCatalog) *TestCatalog { return c })\n )\n \n+const testCatalogTTL = 30 * time.Second\n+\n const testCatalogMaxFileBytes = 2 << 20\n \n func testRefSlug(value string) string {\n \treturn strings.Trim(slugSepRE.ReplaceAllString(strings.ToLower(value), \"-\"), \"-\")\n }\n \n-// LoadTestCatalog builds the catalog for root once per process. It returns nil\n-// when Git cannot list the tree, so callers skip resolution rather than report\n-// every ref as unresolved.\n-func LoadTestCatalog(root string) *TestCatalog {\n+// LoadTestCatalogChecked builds the catalog for root once per process. It returns\n+// (nil, nil) when Git cannot list the tree, so callers skip resolution rather than\n+// report every ref as unresolved, and a non-nil error when the cache is overloaded\n+// or the build was interrupted: the validation is then incomplete, and a gate must\n+// say so instead of passing every ref. An overloaded cache is retried for a while.\n+func LoadTestCatalogChecked(root string) (*TestCatalog, error) {\n \tabs, err := filepath.Abs(root)\n \tif err != nil {\n-\t\treturn nil\n+\t\treturn nil, nil\n+\t}\n+\tmatrix, _ := os.ReadFile(filepath.Join(abs, \".pose\", \"indexes\", \"validation-matrix.json\"))\n+\tsum := sha256.Sum256(matrix)\n+\tkey := fmt.Sprintf(\"%s|%s|%x\", engineVersion, abs, sum[:8])\n+\tdeadline := time.Now().Add(testCatalogBusyWait)\n+\tvar catalog *TestCatalog\n+\tfor {\n+\t\tcatalog, err = testCatalogCache.Get(context.Background(), abs, key, 4<<20, func() (*TestCatalog, int64, error) {\n+\t\t\tbuilt := buildTestCatalog(abs)\n+\t\t\tif built == nil {\n+\t\t\t\t// Git could not list the tree: that is not an empty catalog, and it is not remembered.\n+\t\t\t\treturn nil, 0, errNoTestCatalog\n+\t\t\t}\n+\t\t\treturn built, built.retainedBytes(), nil\n+\t\t})\n+\t\tif errors.Is(err, ErrCacheBusy) && time.Now().Before(deadline) {\n+\t\t\ttime.Sleep(50 * time.Millisecond)\n+\t\t\tcontinue\n+\t\t}\n+\t\tbreak\n \t}\n-\ttestCatalogCache.Lock()\n-\tdefer testCatalogCache.Unlock()\n-\tif catalog, ok := testCatalogCache.byRoot[abs]; ok {\n-\t\treturn catalog\n+\tif errors.Is(err, errNoTestCatalog) {\n+\t\treturn nil, nil\n \t}\n-\tcatalog := buildTestCatalog(abs)\n-\ttestCatalogCache.byRoot[abs] = catalog\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"pose: the test catalog is unavailable, so test references were not verified: %w\", err)\n+\t}\n+\treturn catalog, nil\n+}\n+\n+// LoadTestCatalog is LoadTestCatalogChecked for callers that skip resolution when no\n+// catalog exists. An overloaded cache is not \"no catalog\": use the checked form\n+// wherever a missing catalog would let a ref pass unverified.\n+func LoadTestCatalog(root string) *TestCatalog {\n+\tcatalog, _ := LoadTestCatalogChecked(root)\n \treturn catalog\n }\n \n+// testCatalogBusyWait is how long a caller waits for room in an overloaded catalog cache.\n+var testCatalogBusyWait = 30 * time.Second\n+\n+var errNoTestCatalog = errors.New(\"pose: the test catalog could not be built\")\n+\n+// retainedBytes estimates the heap the catalog holds. The catalog is immutable once\n+// built, so the cache hands the same value to every caller.\n+func (c *TestCatalog) retainedBytes() int64 {\n+\tn := int64(64)\n+\tfor _, t := range c.goTests {\n+\t\tn += int64(len(t)) + 16\n+\t}\n+\tfor _, m := range []map[string]bool{c.names, c.slugs, c.files} {\n+\t\tfor k := range m {\n+\t\t\tn += int64(len(k)) + 64\n+\t\t}\n+\t}\n+\treturn n\n+}\n+\n func gitTrackedFiles(dir string) ([]string, bool) {\n \tctx, cancel := context.WithTimeout(context.Background(), time.Minute)\n \tdefer cancel()\n@@ -152,11 +207,15 @@ func buildTestCatalog(root string) *TestCatalog {\n \t\tif err != nil {\n \t\t\tcontinue\n \t\t}\n+\t\ttext := string(raw)\n \t\tfor _, re := range pattern {\n-\t\t\tfor _, match := range re.FindAllStringSubmatch(string(raw), -1) {\n-\t\t\t\tcatalog.add(match[1])\n+\t\t\tfor _, match := range re.FindAllStringSubmatch(text, -1) {\n+\t\t\t\t// A name is a substring of the file text: cloned, it does not keep\n+\t\t\t\t// the whole file alive in the cache.\n+\t\t\t\tname := strings.Clone(match[1])\n+\t\t\t\tcatalog.add(name)\n \t\t\t\tif re == goTestFuncRE {\n-\t\t\t\t\tcatalog.goTests = append(catalog.goTests, match[1])\n+\t\t\t\t\tcatalog.goTests = append(catalog.goTests, name)\n \t\t\t\t}\n \t\t\t}\n \t\t}\n@@ -189,7 +248,8 @@ func testFilePattern(rel string) []*regexp.Regexp {\n }\n \n func (c *TestCatalog) add(name string) {\n-\tname = strings.TrimSpace(name)\n+\t// Cloned after trimming: a trimmed title is a substring of its padded original.\n+\tname = strings.Clone(strings.TrimSpace(name))\n \tif name == \"\" {\n \t\treturn\n \t}\n","exit_code":0,"status":"completed"}}
