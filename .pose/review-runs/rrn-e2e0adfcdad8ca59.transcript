pose: design delta root is unavailable\")\n\t}\n\n\tsummary := DesignDeltaSubjectSummary{\n\t\tBase: subject.Base, Head: subject.Head, PatchDigest: subject.PatchDigest,\n\t\tTreeDigest: subject.TreeDigest, ImplementationDigest: subject.ImplementationDigest,\n\t\tEntries: len(subject.Entries),\n\t}\n\tinput, err := digestJSON(struct {\n\t\tParser  string\n\t\tScope   string\n\t\tSubject ReviewBundleSubject\n\t\tOptions DesignDeltaOptions\n\t}{DesignDeltaParserVersion, scope, canonicalDesignDeltaSubject(subject), options})\n\tif err != nil {\n\t\treturn DesignDeltaReport{}, err\n\t}\n\t// The report is a pure function of this digest: it covers the parser version,\n\t// the scope, the canonical subject with its per-entry digests, and the read\n\t// bounds. Identical inputs read the same Git blobs and produce the same\n\t// report, which is why the existing CacheKey field was already this value —\n\t// it named a cache nothing had implemented.\n\t//\n\t// One `pose check --strict` on this repository made 152 of these calls for 116\n\t// distinct digests: 36 repeats at about 62 ms each. Measured before caching,\n\t// because a cache for a ratio nobody counted is a guess.\n\t// The report is read from the root's Git objects and files, so the key carries the\n\t// root: another clone with the same subject digest may hold other objects. The\n\t// production is coordinated per key: simultaneous callers assess once.\n\tcacheKey := rootAbs + \"\\x00\" + input\n\tassess := func() (DesignDeltaReport, int64, error) {\n\t\treport := DesignDeltaReport{\n\t\t\tSchemaVersion: DesignDeltaSchemaVersion,\n\t\t\tParserVersion: DesignDeltaParserVersion,\n\t\t\tScope:         scope,\n\t\t\tStatus:        \"unknown\",\n\t\t\tInputDigest:   input,\n\t\t\tCacheKey:      input,\n\t\t\tSubject:       summary,\n\t\t\tCoverage: DesignDeltaCoverage{\n\t\t\t\tFilesInSubject: len(subject.Entries), MaxFiles: options.MaxFiles, MaxBytes: options.MaxBytes,\n\t\t\t\tDetectors: []DesignDeltaDetector{},\n\t\t\t},\n\t\t\tDeltas: []StructuralDelta{},\n\t\t}\n\n---\nspec: pose-bounded-isolated-graph-caches\ncategory: changed\nbreaking: false\n---\n\nThe caches of rebuildable data are bounded in bytes and isolated. The parsed\ndelivery graph, the design-delta report and the test catalog share one cache that evicts by retained bytes under a global budget and a\nbudget per worktree, produces a missed key once however many callers ask, lets a\nwaiter leave without disturbing the others, and never remembers a failure. A\nreturned graph shares no map or slice with the cache: the attribute maps of the\nnodes and the refs of the roadmap criteria were shared before. Read-only\nconsumers can view the graph without a copy. The test catalog is keyed by the\nvalidation matrix and expires after 30 seconds.\ndiff --git a/pose-mcp/internal/cli/lintspec.go b/pose-mcp/internal/cli/lintspec.go\nindex cdb38e5f..6b9ce779 100644\n--- a/pose-mcp/internal/cli/lintspec.go\n+++ b/pose-mcp/internal/cli/lintspec.go\n@@ -753,7 +753,12 @@ func lintOneSpecWith(r *cliout.Renderer, fields bool, specPath string, requiredO\n \t// rewritten and the --all gate must not turn red on it. The root is the\n \t// spec's own repository, whatever the working directory.\n \tif root, err := projectRootAt(filepath.Dir(specPath)); err == nil {\n-\t\tfor _, ref := range posepkg.UnresolvedTestRefs(trace, posepkg.LoadTestCatalog(root)) {\n+\t\tcatalog, catalogErr := posepkg.LoadTestCatalogChecked(root)\n+\t\tif catalogErr != nil {\n+\t\t\tlint.finding(cliout.StateError, \"requirement-trace\", fmt.Sprintf(cliText(locale, \"requirement trace: test references could not be verified (%v)\", \"requirement trace: as referências a testes não puderam ser verificadas (%v)\"), catalogErr))\n+\t\t\ttraceFailures++\n+\t\t}\n+\t\tfor _, ref := range posepkg.UnresolvedTestRefs(trace, catalog) {\n \t\t\tswitch specStatus {\n \t\t\tcase \"done\", \"superseded\", \"abandoned\":\n \t\t\t\tlint.finding(cliout.StateWarning, \"requirement-trace\", fmt.Sprintf(cliText(locale, \"requirement trace: %s names no test in this repository or its submodules\", \"requirement trace: %s não nomeia nenhum teste deste repositório ou de seus submódulos\"), ref))\ndiff --git a/pose-mcp/internal/cli/review_closeout.go b/pose-mcp/internal/cli/review_closeout.go\nindex cb34376b..5339f00a 100644\n--- a/pose-mcp/internal/cli/review_closeout.go\n+++ b/pose-mcp/internal/cli/review_closeout.go\n@@ -2019,7 +2019,12 @@ func cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref strin\n \t\t\t}\n \t\t\t// A test: ref must name a test that exists, or the trace points a\n \t\t\t// promise at nothing (spec pose-trace-test-refs-resolve).\n-\t\t\tif unresolved := posemodel.UnresolvedTestRefs(posemodel.ParseRequirementTrace(string(raw)), posemodel.LoadTestCatalog(root)); len(unresolved) > 0 {\n+\t\t\tcatalog, catalogErr := posemodel.LoadTestCatalogChecked(root)\n+\t\t\tif catalogErr != nil {\n+\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate incomplete: \" + catalogErr.Error())\n+\t\t\t\treturn 1\n+\t\t\t}\n+\t\t\tif unresolved := posemodel.UnresolvedTestRefs(posemodel.ParseRequirementTrace(string(raw)), catalog); len(unresolved) > 0 {\n \t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate failed: \" + strings.Join(unresolved, \"; \") + \" names no test in this repository or its submodules — cite the test function, subtest, test title or test file\")\n \t\t\t\treturn 1\n \t\t\t}\ndiff --git a/pose-mcp/internal/pose/delegated_verdicts.go b/pose-mcp/internal/pose/delegated_verdicts.go\nindex 92b7d9e0..92db118f 100644\n--- a/pose-mcp/internal/pose/delegated_verdicts.go\n+++ b/pose-mcp/internal/pose/delegated_verdicts.go\n@@ -297,9 +297,10 @@ func (s Store) recordDelegatedVerdict(run ReviewRun, bundle ReviewBundle, draft\n \t\t\treturn \"\", \"\", err\n \t\t}\n \t\tscoped := \"\"\n-\t\tif graph, err := s.GetDeliveryIntegrity(\"\"); err == nil {\n+\t\t// Read-only: only the scoped digest is taken, so the graph is viewed, not copied.\n+\t\t_ = s.ViewDeliveryIntegrity(func(graph DeliveryIntegrityGraph) {\n \t\t\tscoped = ScopedDeliveryProvenanceDigest(graph, bundle.Payload.Scope.Slug)\n-\t\t}\n+\t\t})\n \t\trel = SmokeResultsDir + \"/\" + run.RunID + \".json\"\n \t\traw, _ = json.MarshalIndent(smokeDocumentFor(run, bundle, draft, targets, proofID, issuer, scoped, now), \"\", \"  \")\n \tdefault:\n@@ -617,11 +618,11 @@ func loadSmokeResultsIn(s Store, root string, includeCurrentScopeProvenance bool\n func (s Store) smokeResultsOf(doc smokeResultDocument, run ReviewRun, bundle ReviewBundle, rel string) []DeliveryValidationResult {\n \tvar scoped map[string]string\n \tif current, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref); err == nil && current != nil && current.BundleID == bundle.BundleID {\n-\t\tif graph, err := s.GetDeliveryIntegrity(\"\"); err == nil {\n+\t\t_ = s.ViewDeliveryIntegrity(func(graph DeliveryIntegrityGraph) {\n \t\t\tif digest := ScopedDeliveryProvenanceDigest(graph, bundle.Payload.Scope.Slug); digest != \"\" {\n \t\t\t\tscoped = map[string]string{bundle.Payload.Scope.Slug: digest}\n \t\t\t}\n-\t\t}\n+\t\t})\n \t}\n \treturn smokeResultsWithProvenance(doc, run, bundle, rel, scoped)\n }\ndiff --git a/pose-mcp/internal/pose/delivery_integrity.go b/pose-mcp/internal/pose/delivery_integrity.go\nindex 9459fc18..5d4fccfe 100644\n--- a/pose-mcp/internal/pose/delivery_integrity.go\n+++ b/pose-mcp/internal/pose/delivery_integrity.go\n@@ -52,6 +52,11 @@ type ChangeSet struct {\n \tCommits      []string       `json:\"commits,omitempty\"`\n \tPaths        []ObservedPath `json:\"paths\"`\n \tDiffDigest   string         `json:\"diff_digest\"`\n+\t// MaterialDigest digests the diffs of the commits that are not purely\n+\t// administrative records (material_binding.go); empty when not computed.\n+\tMaterialDigest string `json:\"material_digest,omitempty\"`\n+\t// MaterialInputs are the names and rename destinations the digest was computed from.\n+\tMaterialInputs *MaterialInputs `json:\"material_inputs,omitempty\"`\n }\n \n type DeliveryIntegrityFinding struct {\n@@ -526,7 +531,7 @@ func BuildDeliveryIntegrityWithHistoryIn(files Files, specs []Spec, claims []Art\n \tprovenanceRaw, _ := json.Marshal(struct {\n \t\tClaims     []ArtifactClaim `json:\"claims\"`\n \t\tChangeSets []ChangeSet     `json:\"change_sets\"`\n-\t}{graph.Claims, graph.ChangeSets})\n+\t}{graph.Claims, withoutMaterialDigest(graph.ChangeSets)})\n \tprovenanceSum := sha256.Sum256(provenanceRaw)\n \tgraph.ProvenanceDigest = \"sha256:\" + hex.EncodeToString(provenanceSum[:])\n \treturn graph\n@@ -546,9 +551,9 @@ func (s Store) GetDeliveryIntegrity(path string) (DeliveryIntegrityGraph, error)\n \tif err != nil {\n \t\treturn DeliveryIntegrityGraph{}, fmt.Errorf(\"pose: delivery-integrity index not found; run `pose index`\")\n \t}\n-\tgraph, ok := parseDeliveryIntegrityGraph(raw)\n-\tif !ok {\n-\t\treturn DeliveryIntegrityGraph{}, fmt.Errorf(\"pose: invalid delivery-integrity index\")\n+\tgraph, perr := parseDeliveryIntegrityGraphErr(s.Root, raw)\n+\tif perr != nil {\n+\t\treturn DeliveryIntegrityGraph{}, deliveryIndexError(perr)\n \t}\n \tif path != \"\" {\n \t\tif err := ValidateArtifactPathIn(s.fsys(), s.Root, path, false); err != nil {\n2586:          \"name\": \"bounded-isolated-graph-caches-integration\",\n","exit_code":0,"status":"completed"}}
