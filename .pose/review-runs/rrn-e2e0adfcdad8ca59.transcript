{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/bounded_cache.go'","aggregated_output":"package pose\n\nimport (\n\t\"container/list\"\n\t\"context\"\n\t\"errors\"\n\t\"runtime\"\n\t\"sync\"\n\t\"time\"\n)\n\n// boundedCache is the one cache the rebuildable derived data of this package goes\n// through (spec pose-bounded-isolated-graph-caches).\n//\n// What it bounds, and what it does not:\n//\n//   - Retained bytes: each value reports its size; the cache evicts least recently\n//     used entries under a global budget and a budget per owner (a worktree root). A\n//     value over its budget is served and neither retained nor cloned for retention.\n//   - In-flight work: a production reserves bytes before it runs, globally and per\n//     owner, and waits (or leaves with its context) until they fit; the number of\n//     productions and of waiters per key is capped too. A caller that is refused for\n//     lack of capacity receives ErrCacheBusy, which it retries or reports.\n//   - Copies in flight: cloning runs outside the lock and takes one of a few copy\n//     slots, so independent keys are never delayed by a copy and the copies being\n//     made at one moment are few.\n//   - Not bounded: the clone a caller keeps after it returns. That memory belongs to\n//     the caller; a reader that only looks up fields uses View and keeps nothing.\n//\n// A missed key is produced once however many callers ask at the same time. Failures\n// are not remembered. A waiter whose context ends leaves without disturbing the\n// producer or the other waiters. The cache holds rebuildable data only: never a\n// verdict, a satisfaction or an authority.\ntype boundedCache[V any] struct {\n\tmu            sync.Mutex\n\tmaxBytes      int64\n\tmaxOwnerBytes int64\n\tttl           time.Duration\n\tnow           func() time.Time\n\tclone         func(V) V\n\n\tmaxInflightBytes      int64\n\tmaxOwnerInflightBytes int64\n\tmaxProducers          int\n\tmaxWaiters            int\n\tmaxInflightKeys       int\n\tentryOverhead         int64\n\tmaxOwnerInflightKeys  int\n\tcopySlots             chan struct{}\n\n\tentries  map[string]*cacheEntry[V]\n\tlru      *list.List\n\tused     int64\n\towners   map[string]int64\n\tinflight map[string]*cacheFlight[V]\n\n\tproducers     int\n\tinflightBytes int64\n\townerFlights  map[string]int\n\townerInflight map[string]int64\n\tadmissionWake chan struct{}\n\tpeakProducers int\n\tpeakInflight  int64\n\tstats         CacheStats\n}\n\ntype cacheEntry[V any] struct {\n\tkey, owner string\n\tvalue      V\n\tsize       int64\n\tat         time.Time\n\tel         *list.Element\n\t// pins counts readers (views, clones in progress) holding the value; an evicted\n\t// entry stays charged until the last pin goes, so what the cache keeps alive is\n\t// what it accounts for.\n\tpins    int\n\tevicted bool\n}\n\ntype cacheFlight[V any] struct {\n\tdone    chan struct{}\n\tvalue   V\n\tok      bool // value is set; false with err == nil means \"ask again\"\n\terr     error\n\twaiters int\n\towner   string\n\t// finished, holders and held keep a shared result charged while waiters still\n\t// copy it: the reservation is released by the last waiter, not by the producer.\n\tfinished bool\n\tholders  int\n\theld     int64\n}\n\n// CacheStats counts what a cache did, for measurement (spec R7).\ntype CacheStats struct {\n\tHits      int64 // served from a retained entry\n\tCoalesced int64 // served by a production another caller was already running\n\tMisses    int64 // productions run\n\tEvictions int64\n\tOversize  int64 // produced values not retained: over a budget, or declared unretainable\n\tExpired   int64\n\tFailures  int64 // productions that failed (never retained)\n\tBusy      int64 // callers refused for lack of waiter capacity\n\tEntries   int\n\tRetained  int64 // bytes retained now\n\t// PeakProducers and PeakInflightBytes are the most productions and reserved bytes\n\t// that were in flight at once.\n\tPeakProducers     int\n\tPeakInflightBytes int64\n}\n\n// ErrCacheBusy is returned to a caller refused because the cache has no room for\n// another production, queued key or waiter. It is an overload the caller sees: it\n// retries or reports it, and never produces outside the cache's budgets.\nvar ErrCacheBusy = errors.New(\"pose: the cache has no waiter capacity for this key\")\n\n// Unretainable is the size a producer returns for a value that must be served and\n// not remembered (a partial or unknown result a later call should recompute).\nconst Unretainable = int64(-1)\n\nfunc newBoundedCache[V any](maxBytes, maxOwnerBytes int64, ttl time.Duration, clone func(V) V) *boundedCache[V] {\n\tslots := runtime.GOMAXPROCS(0)\n\tif slots < 2 {\n\t\tslots = 2\n\t}\n\treturn &boundedCache[V]{\n\t\tmaxBytes: maxBytes, maxOwnerBytes: maxOwnerBytes, ttl: ttl, now: time.Now, clone: clone,\n\t\tmaxInflightBytes: maxBytes, maxOwnerInflightBytes: maxOwnerBytes, maxProducers: 8, maxWaiters: 128, entryOverhead: defaultEntryOverhead, maxInflightKeys: 64, maxOwnerInflightKeys: 16,\n\t\tcopySlots: make(chan struct{}, slots),\n\t\tentries:   map[string]*cacheEntry[V]{}, lru: list.New(), owners: map[string]int64{},\n\t\tinflight: map[string]*cacheFlight[V]{}, ownerFlights: map[string]int{}, ownerInflight: map[string]int64{}, admissionWake: make(chan struct{}),\n\t}\n}\n\nfunc (c *boundedCache[V]) doClone(v V) V {\n\tc.copySlots <- struct{}{}\n\tdefer func() { <-c.copySlots }()\n\treturn c.clone(v)\n}\n\n// Get returns the value for key, producing it with produce when none is retained.\n// reserve is the caller's estimate of the bytes the production will hold while it\n// runs. produce returns the value and its retained size (Unretainable to serve it\n// without keeping it). Every value handed out is a clone.\nfunc (c *boundedCache[V]) Get(ctx context.Context, owner, key string, reserve int64, produce func() (V, int64, error)) (V, error) {\n\treturn c.get(ctx, owner, key, reserve, produce, nil)\n}\n\n// View is Get for a reader that promises neither to modify nor to keep the value:\n// for a retained entry it receives the value itself, without the clone, pinned for\n// as long as fn runs (an entry evicted meanwhile stays charged until the pin goes).\n// A value produced or shared during the call is cloned like Get's: the in-flight\n// result is not an entry to pin. This is what makes a small read of a large graph\n// cheap (spec pose-bounded-isolated-graph-caches R1).\nfunc (c *boundedCache[V]) View(ctx context.Context, owner, key string, reserve int64, produce func() (V, int64, error), fn func(V)) error {\n\t_, err := c.get(ctx, owner, key, reserve, produce, fn)\n\treturn err\n}\n\n// get serves a retained entry (passing it to view, pinned, when view is set, else as\n// a clone), shares an in-flight production, or becomes the producer.\nfunc (c *boundedCache[V]) get(ctx context.Context, owner, key string, reserve int64, produce func() (V, int64, error), view func(V)) (V, error) {\n\tvar zero V\n\tfor {\n\t\tc.mu.Lock()\n\t\tif entry, ok := c.entries[key]; ok {\n\t\t\tif c.ttl > 0 && c.now().Sub(entry.at) > c.ttl {\n\t\t\t\tc.removeLocked(entry)\n\t\t\t\tc.stats.Expired++\n\t\t\t} else {\n\t\t\t\tc.lru.MoveToFront(entry.el)\n\t\t\t\tc.stats.Hits++\n\t\t\t\tentry.pins++\n\t\t\t\tv := entry.value\n\t\t\t\tc.mu.Unlock()\n\t\t\t\tif view != nil {\n\t\t\t\t\tview(v)\n\t\t\t\t\tc.unpin(entry)\n\t\t\t\t\treturn v, nil\n\t\t\t\t}\n\t\t\t\tout := c.doClone(v)\n\t\t\t\tc.unpin(entry)\n\t\t\t\treturn out, nil\n\t\t\t}\n\t\t}\n\t\tif flight, ok := c.inflight[key]; ok {\n\t\t\tif flight.waiters >= c.maxWaiters {\n\t\t\t\tc.stats.Busy++\n\t\t\t\tc.mu.Unlock()\n\t\t\t\treturn zero, ErrCacheBusy\n\t\t\t}\n\t\t\tflight.waiters++\n\t\t\tc.mu.Unlock()\n\t\t\tselect {\n\t\t\tcase <-flight.done:\n\t\t\tcase <-ctx.Done():\n\t\t\t\t// The waiter leaves: its place goes back to the key, or its hold on\n\t\t\t\t// the shared result goes back to the flight if it had finished.\n\t\t\t\tc.mu.Lock()\n\t\t\t\tif flight.finished {\n\t\t\t\t\tc.dropHolderLocked(flight)\n\t\t\t\t} else {\n\t\t\t\t\tflight.waiters--\n\t\t\t\t}\n\t\t\t\tc.mu.Unlock()\n\t\t\t\treturn zero, ctx.Err()\n\t\t\t}\n\t\t\tif flight.err != nil {\n\t\t\t\treturn zero, flight.err\n\t\t\t}\n\t\t\tif !flight.ok {\n\t\t\t\tcontinue // the producer kept nothing to share: ask again\n\t\t\t}\n\t\t\tc.mu.Lock()\n\t\t\tc.stats.Coalesced++\n\t\t\tv := flight.value\n\t\t\tc.mu.Unlock()\n\t\t\tout := c.doClone(v)\n\t\t\tc.mu.Lock()\n\t\t\tc.dropHolderLocked(flight)\n\t\t\tc.mu.Unlock()\n\t\t\tif view != nil {\n\t\t\t\tview(out)\n\t\t\t}\n\t\t\treturn out, nil\n\t\t}\n\t\t// A new production: bounded in keys, globally and per owner, before it exists.\n\t\tif len(c.inflight) >= c.maxInflightKeys || (c.maxOwnerInflightKeys > 0 && c.ownerFlights[owner] >= c.maxOwnerInflightKeys) {\n\t\t\tc.stats.Busy++\n\t\t\tc.mu.Unlock()\n\t\t\treturn zero, ErrCacheBusy\n\t\t}\n\t\tflight := &cacheFlight[V]{done: make(chan struct{}), owner: owner}\n\t\tc.inflight[key] = flight\n\t\tc.ownerFlights[owner]++\n\t\tc.mu.Unlock()\n\n\t\t// Admission: the production waits until its reservation fits.\n\t\tif err := c.admit(ctx, owner, reserve); err != nil {\n\t\t\tc.finishFlight(key, flight, err)\n\t\t\treturn zero, err\n\t\t}\n\t\tout, err := c.produce(owner, key, reserve, produce, flight)\n\t\tif err == nil && view != nil {\n\t\t\tview(out)\n\t\t}\n\t\treturn out, err\n\t}\n}\n\n// finishFlight ends a flight that produced nothing: it frees the key and its slot\n// and releases the waiters with err.\nfunc (c *boundedCache[V]) finishFlight(key string, flight *cacheFlight[V], err error) {\n\tc.mu.Lock()\n\tc.removeFlightLocked(key, flight)\n\tflight.err = err\n\tc.mu.Unlock()\n\tclose(flight.done)\n}\n\n// admit reserves reserve bytes for a production, waiting until they fit under the\n// global and the per-owner in-flight budgets and a production slot is free. A\n// reservation larger than a budget is admitted alone, so nothing starves.\nfunc (c *boundedCache[V]) admit(ctx context.Context, owner string, reserve int64) error {\n\tif reserve < 0 {\n\t\treserve = 0\n\t}\n\tfor {\n\t\tc.mu.Lock()\n\t\tfits := c.producers < c.maxProducers &&\n\t\t\t(c.inflightBytes == 0 || c.inflightBytes+reserve <= c.maxInflightBytes) &&\n\t\t\t(c.ownerInflight[owner] == 0 || c.maxOwnerInflightBytes <= 0 || c.ownerInflight[owner]+reserve <= c.maxOwnerInflightBytes)\n\t\tif fits {\n\t\t\tc.producers++\n\t\t\tc.inflightBytes += reserve\n\t\t\tc.ownerInflight[owner] += reserve\n\t\t\tif c.producers > c.peakProducers {\n\t\t\t\tc.peakProducers = c.producers\n\t\t\t}\n\t\t\tif c.inflightBytes > c.peakInflight {\n\t\t\t\tc.peakInflight = c.inflightBytes\n\t\t\t}\n\t\t\tc.mu.Unlock()\n\t\t\treturn nil\n\t\t}\n\t\twake := c.admissionWake\n\t\tc.mu.Unlock()\n\t\tselect {\n\t\tcase <-wake:\n\t\tcase <-ctx.Done():\n\t\t\treturn ctx.Err()\n\t\t}\n\t}\n}\n\nfunc (c *boundedCache[V]) release(owner string, reserve int64) {\n\tif reserve < 0 {\n\t\treserve = 0\n\t}\n\tc.mu.Lock()\n\tc.producers--\n\tc.inflightBytes -= reserve\n\tc.ownerInflight[owner] -= reserve\n\tif c.ownerInflight[owner] <= 0 {\n\t\tdelete(c.ownerInflight, owner)\n\t}\n\tclose(c.admissionWake)\n\tc.admissionWake = make(chan struct{})\n\tc.mu.Unlock()\n}\n\n// produce runs the production the caller was admitted for. The reservation is held\n// until the result is published (cloned, stored and handed to the waiters): the\n// values being copied are charged to the cache for as long as they are alive in it.\nfunc (c *boundedCache[V]) produce(owner, key string, reserve int64, produce func() (V, int64, error), flight *cacheFlight[V]) (V, error) {\n\tvar zero V\n\tc.mu.Lock()\n\tc.stats.Misses++\n\tc.mu.Unlock()\n\tvar (\n\t\tvalue V\n\t\tsize  int64\n\t\terr   error\n\t)\n\tfunc() {\n\t\t// A panicking producer must still release its waiters, its reservation and the key.\n\t\tdefer func() {\n\t\t\tif r := recover(); r != nil {\n\t\t\t\tc.release(owner, reserve)\n\t\t\t\tc.mu.Lock()\n\t\t\t\tc.stats.Failures++\n\t\t\t\tc.mu.Unlock()\n\t\t\t\tc.finishFlight(key, flight, errCacheProducerPanicked)\n\t\t\t\tpanic(r)\n\t\t\t}\n\t\t}()\n\t\tvalue, size, err = produce()\n\t}()\n\tif err != nil {\n\t\tc.release(owner, reserve)\n\t\tc.mu.Lock()\n\t\tc.stats.Failures++\n\t\tc.mu.Unlock()\n\t\tc.finishFlight(key, flight, err)\n\t\treturn zero, err\n\t}\n\tc.mu.Lock()\n\tretain := size >= 0 && size <= c.maxBytes && (c.maxOwnerBytes <= 0 || size <= c.maxOwnerBytes)\n\tif !retain {\n\t\tc.stats.Oversize++\n\t}\n\tc.mu.Unlock()\n\t// Publication is one critical section: the shared result, the waiters it has,\n\t// the removal of the flight (so none joins later) and the release of the\n\t// reservation are decided together. A value that is not retained is cloned only\n\t// when someone waits for it; a waiter that joins while the copy is being made\n\t// (outside the lock, so that independent keys are never delayed by it) is seen\n\t// when the lock is taken again, and the copy is made for it too.\n\tvar shared V\n\thave := false\n\tfor {\n\t\tif !have && retain {\n\t\t\tshared, have = c.doClone(value), true\n\t\t}\n\t\tc.mu.Lock()\n\t\tif !have && flight.waiters > 0 {\n\t\t\tc.mu.Unlock()\n\t\t\tshared, have = c.doClone(value), true\n\t\t\tcontinue\n\t\t}\n\t\tbreak\n\t}\n\tif retain {\n\t\tc.storeLocked(owner, key, shared, size)\n\t}\n\tif flight.waiters > 0 {\n\t\tflight.value, flight.ok = shared, true\n\t\tflight.held = reserve // charged until the last waiter has copied the result\n\t}\n\tflight.finished = true\n\tflight.holders = flight.waiters\n\tc.removeFlightLocked(key, flight)\n\tif flight.holders == 0 {\n\t\tc.releaseLocked(owner, reserve)\n\t}\n\tc.mu.Unlock()\n\tclose(flight.done)\n\treturn value, nil\n}\n\n// releaseLocked gives a production's slot and reservation back. The caller holds mu.\nfunc (c *boundedCache[V]) releaseLocked(owner string, reserve int64) {\n\tif reserve < 0 {\n\t\treserve = 0\n\t}\n\tc.producers--\n\tc.inflightBytes -= reserve\n\tc.ownerInflight[owner] -= reserve\n\tif c.ownerInflight[owner] <= 0 {\n\t\tdelete(c.ownerInflight, owner)\n\t}\n\tclose(c.admissionWake)\n\tc.admissionWake = make(chan struct{})\n}\n\n// removeFlightLocked takes a flight out of the key table. The caller holds mu.\nfunc (c *boundedCache[V]) removeFlightLocked(key string, flight *cacheFlight[V]) {\n\tif c.inflight[key] == flight {\n\t\tdelete(c.inflight, key)\n\t\tc.ownerFlights[flight.owner]--\n\t\tif c.ownerFlights[flight.owner] <= 0 {\n\t\t\tdelete(c.ownerFlights, flight.owner)\n\t\t}\n\t}\n}\n\n// dropHolderLocked is a waiter letting go of a finished flight's shared result; the\n// last one releases the reservation the producer left charged. The caller holds mu.\nfunc (c *boundedCache[V]) dropHolderLocked(flight *cacheFlight[V]) {\n\tif flight.holders <= 0 {\n\t\treturn\n\t}\n\tflight.holders--\n\tif flight.holders == 0 {\n\t\tc.releaseLocked(flight.owner, flight.held)\n\t}\n}\n\n// unpin drops one pin; the last pin of an evicted entry frees what it was charged.\nfunc (c *boundedCache[V]) unpin(entry *cacheEntry[V]) {\n\tc.mu.Lock()\n\tentry.pins--\n\tif entry.pins == 0 && entry.evicted {\n\t\tc.used -= entry.size\n\t\tc.owners[entry.owner] -= entry.size\n\t\tif c.owners[entry.owner] <= 0 {\n\t\t\tdelete(c.owners, entry.owner)\n\t\t}\n\t}\n\tc.mu.Unlock()\n}\n\n// Lookup returns a clone of the retained value for key, if any.\nfunc (c *boundedCache[V]) Lookup(key string) (V, bool) {\n\tvar zero V\n\tc.mu.Lock()\n\tentry, ok := c.entries[key]\n\tif !ok {\n\t\tc.stats.Misses++\n\t\tc.mu.Unlock()\n\t\treturn zero, false\n\t}\n\tif c.ttl > 0 && c.now().Sub(entry.at) > c.ttl {\n\t\tc.removeLocked(entry)\n\t\tc.stats.Expired++\n\t\tc.stats.Misses++\n\t\tc.mu.Unlock()\n\t\treturn zero, false\n\t}\n\tc.lru.MoveToFront(entry.el)\n\tc.stats.Hits++\n\tentry.pins++\n\tv := entry.value\n\tc.mu.Unlock()\n\tout := c.doClone(v)\n\tc.unpin(entry)\n\treturn out, true\n}\n\n// Store retains a clone of value for key under the same budgets as Get.\nfunc (c *boundedCache[V]) Store(owner, key string, value V, size int64) {\n\tif size < 0 || size > c.maxBytes || (c.maxOwnerBytes > 0 && size > c.maxOwnerBytes) {\n\t\tc.mu.Lock()\n\t\tc.stats.Oversize++\n\t\tc.mu.Unlock()\n\t\treturn\n\t}\n\tcl := c.doClone(value)\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tc.storeLocked(owner, key, cl, size)\n}\n\n// entryOverhead is what an entry costs beyond its payload: the entry, its list node,\n// the lookup slots and the owner accounting, measured on 64-bit platforms at about\n// 136 bytes for the first two and rounded up for the rest; the key is charged by length.\nconst defaultEntryOverhead = 256\n\nfunc (c *boundedCache[V]) storeLocked(owner, key string, value V, size int64) {\n\tif size < 0 {\n\t\tsize = 0\n\t}\n\tsize += c.entryOverhead + int64(len(key)) + int64(len(owner))\n\tif size > c.maxBytes || (c.maxOwnerBytes > 0 && size > c.maxOwnerBytes) {\n\t\tc.stats.Oversize++\n\t\treturn\n\t}\n\tif old, ok := c.entries[key]; ok {\n\t\tc.removeLocked(old)\n\t}\n\tfor c.maxOwnerBytes > 0 && c.owners[owner]+size > c.maxOwnerBytes {\n\t\tif !c.evictLocked(owner) {\n\t\t\tbreak\n\t\t}\n\t}\n\tfor c.used+size > c.maxBytes {\n\t\tif !c.evictLocked(\"\") {\n\t\t\tbreak\n\t\t}\n\t}\n\t// What readers still pin counts against the budgets: when evicting everything\n\t// else is not enough, the value is not retained instead of exceeding them.\n\tif c.used+size > c.maxBytes || (c.maxOwnerBytes > 0 && c.owners[owner]+size > c.maxOwnerBytes) {\n\t\tc.stats.Oversize++\n\t\treturn\n\t}\n\tentry := &cacheEntry[V]{key: key, owner: owner, value: value, size: size, at: c.now()}\n\tentry.el = c.lru.PushFront(entry)\n\tc.entries[key] = entry\n\tc.used += size\n\tc.owners[owner] += size\n}\n\n// evictLocked removes the least recently used entry, of one owner when owner is\n// set. It reports whether it removed one.\nfunc (c *boundedCache[V]) evictLocked(owner string) bool {\n\tfor el := c.lru.Back(); el != nil; el = el.Prev() {\n\t\tentry := el.Value.(*cacheEntry[V])\n\t\tif owner == \"\" || entry.owner == owner {\n\t\t\tc.removeLocked(entry)\n\t\t\tc.stats.Evictions++\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// removeLocked takes an entry out of the cache. A pinned entry stays charged until\n// its last reader lets go.\nfunc (c *boundedCache[V]) removeLocked(entry *cacheEntry[V]) {\n\tc.lru.Remove(entry.el)\n\tdelete(c.entries, entry.key)\n\tif entry.pins > 0 {\n\t\tentry.evicted = true\n\t\treturn\n\t}\n\tc.used -= entry.size\n\tc.owners[entry.owner] -= entry.size\n\tif c.owners[entry.owner] <= 0 {\n\t\tdelete(c.owners, entry.owner)\n\t}\n}\n\n// Stats returns the counters and what is retained now.\nfunc (c *boundedCache[V]) Stats() CacheStats {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\ts := c.stats\n\ts.Entries, s.Retained = len(c.entries), c.used\n\ts.PeakProducers, s.PeakInflightBytes = c.peakProducers, c.peakInflight\n\treturn s\n}\n\n// Reset drops every retained entry (tests, and callers that know the world changed).\nfunc (c *boundedCache[V]) Reset() {\n\tc.mu.Lock()\n\tdefer c.mu.Unlock()\n\tc.entries, c.lru, c.used, c.owners = map[string]*cacheEntry[V]{}, list.New(), 0, map[string]int64{}\n}\n\nvar errCacheProducerPanicked = &cacheError{\"the cache producer panicked\"}\n\ntype cacheError struct{ msg string }\n\nfunc (e *cacheError) Error() string { return e.msg }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/delivery_integrity_cache.go pose-mcp/internal/pose/cache_size.go; git diff 7e40761..eacc007 -- pose-mcp/internal/pose/test_catalog.go pose-mcp/internal/pose/design_delta.go pose-mcp/internal/pose/git_spawn_cache.go pose-mcp/internal/pose/governance_read_view_git.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/delivery_integrity_cache.go pose-mcp/internal/pose/cache_size.go; git diff 7e40761..eacc007 -- pose-mcp/internal/pose/test_catalog.go pose-mcp/internal/pose/design_delta.go pose-mcp/internal/pose/git_spawn_cache.go pose-mcp/internal/pose/governance_read_view_git.go'","aggregated_output":"package pose\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n)\n\n// The delivery-integrity index is parsed once per distinct content, not once per\n// caller.\n//\n// In this repository the file is 4.5 MB and a single `pose check --strict` read and\n// unmarshalled it 528 times: 2.4 GB of JSON for one gate. Measured, the read costs\n// 0.44 ms and the parse 10.7 ms, so the parse is 96% of it and the file is the only\n// input — identical bytes cannot produce a different graph.\n//\n// The cache key is the raw bytes themselves rather than a modification time. An\n// mtime has second or nanosecond granularity depending on the filesystem, and two\n// writes inside one tick would serve a stale graph; comparing the bytes cannot be\n// wrong. Reading still happens on every call, which is the 4% this deliberately\n// keeps.\n//\n// Every hit returns a defensive copy. Callers filter this graph in place — one of\n// them, `GetDeliveryIntegrity`'s own path filter, wrote through `Findings[:0]` — so\n// handing out the cached value would let the first caller truncate the graph for\n// every caller after it. That is the same aliasing defect `focusSurfaceGraph` had,\n// and a cache is exactly what turns it from a local surprise into a shared one.\nconst (\n\t// deliveryGraphCacheBytes and deliveryGraphOwnerBytes bound what the parsed graphs\n\t// retain, in estimated heap bytes (see estimateGraphBytes), globally and per\n\t// worktree. Alternating between projects or generations evicts the least recently\n\t// used graph instead of growing, and a graph larger than a budget is served\n\t// without being retained.\n\tdeliveryGraphCacheBytes = 192 << 20\n\tdeliveryGraphOwnerBytes = 96 << 20\n)\n\n// deliveryGraphCache holds parsed graphs keyed by the engine, the schema and the\n// digest of the bytes: identical bytes cannot produce a different graph, so two\n// worktrees that hold the same index share one entry and no worktree can be served\n// another's graph. The owner is the worktree root and only meters the budget.\nvar deliveryGraphCache = newBoundedCache(deliveryGraphCacheBytes, deliveryGraphOwnerBytes, 0, copyDeliveryIntegrityGraph)\n\n// DeliveryGraphCacheStats reports hits, coalesced waits, misses, evictions and the\n// bytes retained by the parsed-graph cache (spec pose-bounded-isolated-graph-caches R7).\nfunc DeliveryGraphCacheStats() CacheStats { return deliveryGraphCache.Stats() }\n\n// parseDeliveryIntegrityGraph is parseDeliveryIntegrityGraphErr for callers that\n// treat any failure as \"no graph\".\nfunc parseDeliveryIntegrityGraph(owner string, raw []byte) (DeliveryIntegrityGraph, bool) {\n\tgraph, err := parseDeliveryIntegrityGraphErr(owner, raw)\n\treturn graph, err == nil\n}\n\n// parseDeliveryIntegrityGraphErr returns the graph for these bytes, parsing only\n// when no graph for them is retained and, when several callers miss together, once.\n// owner is the worktree root the bytes were read from. When the cache has no room\n// for another production or waiter the error wraps ErrCacheBusy: overload is an\n// error the caller sees, never an unaccounted production outside the cache.\nfunc parseDeliveryIntegrityGraphErr(owner string, raw []byte) (DeliveryIntegrityGraph, error) {\n\tsum := sha256.Sum256(raw)\n\tkey := fmt.Sprintf(\"%s|%d|%x\", engineVersion, len(raw), sum)\n\treturn deliveryGraphCache.Get(context.Background(), owner, key, graphParseReserve(raw), func() (DeliveryIntegrityGraph, int64, error) {\n\t\tparsed, ok := decodeDeliveryIntegrityIndex(raw)\n\t\tif !ok {\n\t\t\treturn DeliveryIntegrityGraph{}, 0, errInvalidDeliveryIndex\n\t\t}\n\t\treturn parsed, estimateGraphBytes(parsed), nil\n\t})\n}\n\n// viewDeliveryIntegrityGraph hands fn the retained graph without copying it. fn\n// must neither modify nor keep the graph or anything it reaches; the callers that\n// only read a few fields of a large graph (a digest, a lookup) use it, the others\n// get a deep copy from parseDeliveryIntegrityGraph.\nfunc viewDeliveryIntegrityGraph(owner string, raw []byte, fn func(DeliveryIntegrityGraph)) bool {\n\treturn viewDeliveryIntegrityGraphErr(owner, raw, fn) == nil\n}\n\nfunc viewDeliveryIntegrityGraphErr(owner string, raw []byte, fn func(DeliveryIntegrityGraph)) error {\n\tsum := sha256.Sum256(raw)\n\tkey := fmt.Sprintf(\"%s|%d|%x\", engineVersion, len(raw), sum)\n\treturn deliveryGraphCache.View(context.Background(), owner, key, graphParseReserve(raw), func() (DeliveryIntegrityGraph, int64, error) {\n\t\tparsed, ok := decodeDeliveryIntegrityIndex(raw)\n\t\tif !ok {\n\t\t\treturn DeliveryIntegrityGraph{}, 0, errInvalidDeliveryIndex\n\t\t}\n\t\treturn parsed, estimateGraphBytes(parsed), nil\n\t}, fn)\n}\n\n// ViewDeliveryIntegrity gives fn the delivery graph of the current index without a\n// copy (spec pose-bounded-isolated-graph-caches R1). fn is read-only: it must not\n// modify or retain the graph. The error is that of GetDeliveryIntegrity.\nfunc (s Store) ViewDeliveryIntegrity(fn func(DeliveryIntegrityGraph)) error {\n\traw, _, err := s.ReadIndex(\"delivery-integrity.json\")\n\tif errors.Is(err, ErrIndexGenerationUnavailable) {\n\t\treturn err\n\t}\n\tif err != nil {\n\t\treturn fmt.Errorf(\"pose: delivery-integrity index not found; run `pose index`\")\n\t}\n\tif err := viewDeliveryIntegrityGraphErr(s.Root, raw, fn); err != nil {\n\t\treturn deliveryIndexError(err)\n\t}\n\treturn nil\n}\n\nvar errInvalidDeliveryIndex = errors.New(\"pose: invalid delivery-integrity index\")\n\n// deliveryIndexError names an overload as such and anything else as an invalid index.\nfunc deliveryIndexError(err error) error {\n\tif errors.Is(err, ErrCacheBusy) {\n\t\treturn fmt.Errorf(\"pose: the delivery-integrity graph cache is busy: %w\", err)\n\t}\n\treturn errInvalidDeliveryIndex\n}\n\n// estimateGraphBytes estimates the heap a parsed graph retains by walking every\n// field of it (see estimateRetainedBytes), so no variable-sized field is charged a\n// constant. TestGraphByteEstimateTracksTheMeasuredHeap calibrates it on the real index.\nfunc estimateGraphBytes(g DeliveryIntegrityGraph) int64 { return estimateRetainedBytes(g) }\n\n// graphParseReserve is what a parse is expected to hold while it runs: the bytes\n// being decoded and the graph being built.\nfunc graphParseReserve(raw []byte) int64 { return int64(len(raw)) * 4 }\n\n// decodeDeliveryIntegrityIndex reads schema 1, written as the expanded graph, and\n// schema 2, which stores validation runs and sets once. Any other schema is not\n// read as either.\nfunc decodeDeliveryIntegrityIndex(raw []byte) (DeliveryIntegrityGraph, bool) {\n\tvar head struct {\n\t\tSchemaVersion int `json:\"schema_version\"`\n\t}\n\tif err := json.Unmarshal(raw, &head); err != nil {\n\t\treturn DeliveryIntegrityGraph{}, false\n\t}\n\tswitch head.SchemaVersion {\n\tcase DeliveryIntegritySchemaVersion:\n\t\tvar graph DeliveryIntegrityGraph\n\t\tif err := json.Unmarshal(raw, &graph); err != nil {\n\t\t\treturn DeliveryIntegrityGraph{}, false\n\t\t}\n\t\treturn graph, true\n\tcase DeliveryIntegrityIndexSchemaVersion:\n\t\tvar compact compactDeliveryGraph\n\t\tif err := json.Unmarshal(raw, &compact); err != nil {\n\t\t\treturn DeliveryIntegrityGraph{}, false\n\t\t}\n\t\tgraph, err := expandDeliveryIndex(compact)\n\t\tif err != nil {\n\t\t\treturn DeliveryIntegrityGraph{}, false\n\t\t}\n\t\treturn graph, true\n\t}\n\treturn DeliveryIntegrityGraph{}, false\n}\n\nfunc copyStringMap(in map[string]string) map[string]string {\n\tif in == nil {\n\t\treturn nil\n\t}\n\tout := make(map[string]string, len(in))\n\tfor k, v := range in {\n\t\tout[k] = v\n\t}\n\treturn out\n}\n\n// copyDeliveryIntegrityGraph copies every field that a caller could write through.\n// TestDeliveryGraphCopyCoversEveryField fails when a field is added to the struct\n// without being handled here, so an omission cannot become a silently shared slice.\nfunc copyDeliveryIntegrityGraph(in DeliveryIntegrityGraph) DeliveryIntegrityGraph {\n\tout := in\n\tout.Nodes = make([]DeliveryIntegrityNode, len(in.Nodes))\n\tfor i, node := range in.Nodes {\n\t\tnode.Attributes = copyStringMap(node.Attributes)\n\t\tout.Nodes[i] = node\n\t}\n\tout.Edges = append([]DeliveryIntegrityEdge{}, in.Edges...)\n\tout.Claims = append([]ArtifactClaim{}, in.Claims...)\n\tout.Findings = append([]DeliveryIntegrityFinding{}, in.Findings...)\n\tout.Deliveries = append([]DeliveryTarget{}, in.Deliveries...)\n\tout.ValidationResults = make([]DeliveryValidationResult, len(in.ValidationResults))\n\tfor i, result := range in.ValidationResults {\n\t\tresult.ScopeProvenance = copyStringMap(result.ScopeProvenance)\n\t\tresult.MaterialProvenance = copyStringMap(result.MaterialProvenance)\n\t\tout.ValidationResults[i] = result\n\t}\n\tout.RoadmapCriteria = make([]RoadmapCriterion, len(in.RoadmapCriteria))\n\tfor i, criterion := range in.RoadmapCriteria {\n\t\tcriterion.Refs = append([]string(nil), criterion.Refs...)\n\t\tcriterion.Reasons = append([]string(nil), criterion.Reasons...)\n\t\tout.RoadmapCriteria[i] = criterion\n\t}\n\tout.Archivals = append([]ArchivedFragment{}, in.Archivals...)\n\tout.Removals = make([]ArtifactRemoval, len(in.Removals))\n\tfor i, r := range in.Removals {\n\t\tif r.Supersedes != nil {\n\t\t\tsupersedes := make(map[string]string, len(r.Supersedes))\n\t\t\tfor k, v := range r.Supersedes {\n\t\t\t\tsupersedes[k] = v\n\t\t\t}\n\t\t\tr.Supersedes = supersedes\n\t\t}\n\t\tif r.Refusals != nil {\n\t\t\trefusals := make(map[string]string, len(r.Refusals))\n\t\t\tfor k, v := range r.Refusals {\n\t\t\t\trefusals[k] = v\n\t\t\t}\n\t\t\tr.Refusals = refusals\n\t\t}\n\t\tout.Removals[i] = r\n\t}\n\tif in.Removals == nil {\n\t\tout.Removals = nil\n\t}\n\n\t// ChangeSet carries slices of its own, so copying the outer slice is not enough.\n\tout.ChangeSets = make([]ChangeSet, len(in.ChangeSets))\n\tfor i, set := range in.ChangeSets {\n\t\tset.Commits = append([]string{}, set.Commits...)\n\t\tset.Paths = append([]ObservedPath{}, set.Paths...)\n\t\tif set.MaterialInputs != nil {\n\t\t\tinputs := MaterialInputs{Names: append([]string(nil), set.MaterialInputs.Names...), Moved: append([]string(nil), set.MaterialInputs.Moved...)}\n\t\t\tset.MaterialInputs = &inputs\n\t\t}\n\t\tout.ChangeSets[i] = set\n\t}\n\tout.Reverse = copyStringSliceMap(in.Reverse)\n\tout.Paths = copyStringSliceMap(in.Paths)\n\treturn out\n}\n\nfunc copyStringSliceMap(in map[string][]string) map[string][]string {\n\tif in == nil {\n\t\treturn nil\n\t}\n\tout := make(map[string][]string, len(in))\n\tfor key, values := range in {\n\t\tout[key] = append([]string{}, values...)\n\t}\n\treturn out\n}\npackage pose\n\nimport \"reflect\"\n\n// estimateRetainedBytes estimates the heap a value retains by walking it: the bytes\n// of every string, the backing arrays of slices, the entries of maps and what a\n// pointer reaches, with a fixed cost per header, element and entry. It accounts for\n// every field of the type, present and future, instead of charging a constant for\n// the ones someone remembered (spec pose-bounded-isolated-graph-caches R4). It is an\n// estimate: TestGraphByteEstimateTracksTheMeasuredHeap calibrates it on the real\n// index, and it errs high.\nfunc estimateRetainedBytes(v any) int64 {\n\treturn estimateValue(reflect.ValueOf(v), 0)\n}\n\nconst (\n\testimateHeader   = 16 // a string header, or the share of a slice or map header beyond its elements\n\testimateEntry    = 16 // the bookkeeping a map entry costs beyond its key and value\n\testimateMaxDepth = 32\n)\n\n// estimateValue counts a value once, with its own slot: a string is its header and\n// bytes, a struct is the sum of its fields (so a flat field counts its size), a\n// slice is its header and its elements, a map its header, entries, keys and values.\nfunc estimateValue(v reflect.Value, depth int) int64 {\n\tif !v.IsValid() || depth > estimateMaxDepth {\n\t\treturn 0\n\t}\n\tswitch v.Kind() {\n\tcase reflect.String:\n\t\treturn int64(v.Len()) + estimateHeader\n\tcase reflect.Slice:\n\t\tif v.IsNil() {\n\t\t\treturn 8\n\t\t}\n\t\telem := v.Type().Elem()\n\t\tif isFlat(elem) {\n\t\t\treturn estimateHeader + int64(v.Len())*int64(elem.Size())\n\t\t}\n\t\tn := int64(estimateHeader)\n\t\tfor i := 0; i < v.Len(); i++ {\n\t\t\tn += estimateValue(v.Index(i), depth+1)\n\t\t}\n\t\treturn n\n\tcase reflect.Map:\n\t\tif v.IsNil() {\n\t\t\treturn 8\n\t\t}\n\t\tn := int64(estimateHeader) + 32\n\t\titer := v.MapRange()\n\t\tfor iter.Next() {\n\t\t\tn += estimateEntry + estimateValue(iter.Key(), depth+1) + estimateValue(iter.Value(), depth+1)\n\t\t}\n\t\treturn n\n\tcase reflect.Ptr:\n\t\tif v.IsNil() {\n\t\t\treturn 8\n\t\t}\n\t\treturn 8 + estimateValue(v.Elem(), depth+1)\n\tcase reflect.Interface:\n\t\tif v.IsNil() {\n\t\t\treturn 16\n\t\t}\n\t\treturn 16 + estimateValue(v.Elem(), depth+1)\n\tcase reflect.Struct:\n\t\tvar n int64\n\t\tfor i := 0; i < v.NumField(); i++ {\n\t\t\tn += estimateValue(v.Field(i), depth+1)\n\t\t}\n\t\treturn n\n\tdefault:\n\t\treturn int64(v.Type().Size())\n\t}\n}\n\n// isFlat reports whether a type holds no pointers, strings, slices or maps, so a\n// slice of it is its length times the element size.\nfunc isFlat(t reflect.Type) bool {\n\tswitch t.Kind() {\n\tcase reflect.Bool, reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,\n\t\treflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Float32, reflect.Float64:\n\t\treturn true\n\tcase reflect.Array:\n\t\treturn isFlat(t.Elem())\n\tcase reflect.Struct:\n\t\tfor i := 0