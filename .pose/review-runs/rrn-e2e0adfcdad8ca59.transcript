tion\": \"The implementation matches the approved spec scope.\",\n      \"required\": true,\n      \"kind\": \"judgment\",\n      \"rules\": [\n        \"documentation-style\"\n      ],\n      \"profiles\": [\n        \"spec-closeout@1\"\n      ]\n    },\n    {\n      \"id\": \"security\",\n      \"description\": \"Inputs, paths, evidence and authority boundaries are safe.\",\n      \"required\": true,\n      \"kind\": \"judgment\",\n      \"rules\": [\n        \"security\"\n      ],\n      \"profiles\": [\n        \"spec-closeout@1\"\n      ]\n    },\n    {\n      \"id\": \"solution-proportionality\",\n      \"description\": \"Compare the solution with the smallest sufficient alternative, including negative space, speculative extensibility and the condition that would invalidate the choice.\",\n      \"required\": true,\n      \"kind\": \"judgment\",\n      \"profiles\": [\n        \"engineering-judgment@1\",\n        \"high-criticality-review@1\",\n        \"structural-materiality@1\"\n      ]\n    }\n  ],\n  \"tools\": [\n    {\n      \"id\": \"suggest-review\",\n      \"requiredness\": \"recommended\",\n      \"args\": [\n        \"pose\",\n        \"suggest\",\n        \"review\",\n        \"--path\",\n        \"pose-mcp\"\n      ],\n      \"rationale\": \"resolve the component-specific workflow, skill, rules and validation trail\",\n      \"component\": \"pose-mcp\",\n      \"preconditions\": [\n        \"scope-authorized\"\n      ]\n    },\n    {\n      \"id\": \"assess-design\",\n      \"requiredness\": \"recommended\",\n      \"args\": [\n        \"pose\",\n        \"assess\",\n        \"design\",\n        \"--spec\",\n        \"pose-bounded-isolated-graph-caches\",\n        \"--json\"\n      ],\n      \"rationale\": \"observe bounded structural deltas on the canonical review subject\",\n      \"evidence_classes\": [\n        \"structure\"\n      ],\n      \"preconditions\": [\n        \"scope-authorized\"\n      ]\n    },\n    {\n      \"id\": \"assess-dis