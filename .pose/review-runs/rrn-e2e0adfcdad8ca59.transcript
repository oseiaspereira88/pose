ernal/pose\",\n            \"./internal/mcpserver\",\n            \"-run\",\n            \"PageByGeneration|ACursor|HostileCursor|ExpiredCursor|APositionOutside|AContinuation|AnIssuedCursor|EveryPage|PageLimitIsBounded|EquivalentFilters|APageStates|APageCarries|PageCost|DoesNotReverify|SymlinkTarget|PreservesSizeAndModTime|NullCursor|FiltersThatSerialize|ACursorAlias|OmittedSort|AnAlias|AnExplicit|Pagination|ListToolsShareThePaginationSchema\",\n            \"-count=1\"\n          ],\n          \"severity\": \"required\",\n          \"evidenceClass\": \"integration\"\n        }\n      ]\n    },\n    \"docs-site\": {\n53:\treturn captureGovernanceGitBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\n64:\treturn captureGovernanceGitBounded(files, root, producer, maxOutputBytes, args...)\n79:\treturn captureGovernanceGitBoundedContext(files, ctx, root, producer, maxOutputBytes, args...)\n88:func captureGovernanceGitBounded(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n89:\treturn captureGovernanceGitBoundedContext(files, context.Background(), root, producer, maxOutputBytes, args...)\n92:func captureGovernanceGitBoundedContext(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n180:\traw, err := captureGovernanceGitBounded(files, root, producer, commitPathsMaxOutput, \"diff-tree\", \"--root\", \"--no-commit-id\", \"--name-only\", \"--no-renames\", \"-r\", \"-z\", commit)\npackage pose\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n)\n\nconst governanceReadViewGitParserVersion = \"pose-governance-git-inputs-v1\"\n\ntype governanceReadViewGitObservation struct {\n\troot           string\n\targs           []string\n\tfiles          Files\n\tctx            context.Context\n\tdeadline       time.Time\n\thasDeadline    bool\n\tmaxOutputBytes int64\n\tstdout         []byte\n\tstderr         []byte\n\terr            error\n\terrText        string\n\tproducers      map[string]bool\n}\n\n// governanceReadViewGitState captures exact, bounded Git command results for\n// one read-view operation. Repeated commands replay the first result; audit\n// reruns each exact command and reports any changed or unprovable result.\ntype governanceReadViewGitState struct {\n\top           *governanceReadViewOperation\n\tmu           sync.Mutex\n\tobservations map[string]*governanceReadViewGitObservation\n}\n\nfunc newGovernanceReadViewGitState(op *governanceReadViewOperation) *governanceReadViewGitState {\n\treturn &governanceReadViewGitState{op: op, observations: map[string]*governanceReadViewGitObservation{}}\n}\n\n// captureGovernanceGit runs a Git command through the read-view generation\n// when Files belongs to one. Native and preview operations retain their\n// existing behavior when there is no governance view.\nfunc captureGovernanceGit(files Files, root, producer string, args ...string) ([]byte, error) {\n\treturn captureGovernanceGitBounded(files, root, producer, governanceReadViewMaxInputBytes, args...)\n}\n\n// CaptureGovernanceGitIn executes one bounded raw-history Git command through\n// the operation's captured read view when Files carries one. maxOutputBytes\n// bounds combined stdout and stderr before bytes are retained. Git commands\n// use gitCommand, which disables replacement refs and grafts.\nfunc CaptureGovernanceGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n\t}\n\treturn captureGovernanceGitBounded(files, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceRawHistoryGitIn names the history semantics explicitly for\n// callers whose result depends on raw commit ancestry or object contents.\nfunc CaptureGovernanceRawHistoryGitIn(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn CaptureGovernanceGitIn(files, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceGitContextIn is CaptureGovernanceGitIn under ctx. The same\n// context is retained for the final audit rerun.\nfunc CaptureGovernanceGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tif maxOutputBytes <= 0 || maxOutputBytes > governanceReadViewMaxInputBytes {\n\t\treturn nil, fmt.Errorf(\"pose: captured Git output limit must be between 1 and %d bytes\", governanceReadViewMaxInputBytes)\n\t}\n\treturn captureGovernanceGitBoundedContext(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\n// CaptureGovernanceRawHistoryGitContextIn names raw history semantics for\n// context-bound callers that inspect commit ancestry or object contents.\nfunc CaptureGovernanceRawHistoryGitContextIn(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn CaptureGovernanceGitContextIn(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceGitBounded(files Files, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\treturn captureGovernanceGitBoundedContext(files, context.Background(), root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceGitBoundedContext(files Files, ctx context.Context, root, producer string, maxOutputBytes int64, args ...string) ([]byte, error) {\n\tfiles = FilesOrNative(files)\n\tview, viewFiles := governanceReadViewFromFiles(files)\n\tif view == nil {\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif view.operation == nil {\n\t\tview.markUnknown(producer, \"Git input has no operation-scoped generation vector\")\n\t\treturn runGovernanceGitCommandContext(ctx, files, root, args, maxOutputBytes)\n\t}\n\tif viewFiles != nil {\n\t\tproject := viewFiles.project\n\t\tif target := view.route(root, producer, project); target == nil {\n\t\t\tview.markUnknown(producer, \"Git input is outside the authorized root generation vector\")\n\t\t\treturn nil, errGovernanceReadViewOutsideRoot\n\t\t} else {\n\t\t\tview = target\n\t\t}\n\t}\n\treturn view.operation.captureFilesBoundedContext(files, ctx, root, producer, maxOutputBytes, args...)\n}\n\nfunc captureGovernanceSourceRevision(files Files, root, producer string) (string, error) {\n\tproducer = governanceProducerFromFiles(files, producer)\n\traw, err := captureGovernanceGit(files, root, producer, \"rev-parse\", \"--verify\", \"HEAD\")\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\trevision := strings.TrimSpace(string(raw))\n---\ntype: decision-log\nslug: adr-shared-worktree-runtime-review\nowner: @pose-maintainers\nsensitivity: public-internal\ncreated_at: 2026-10-14\nlast_reviewed_at: 2026-10-14\nexpires_at: 2027-01-12\nsource_refs:\n  spec: \"pose-consolidation-batch-14-authoring\"\n  workflow: \"documentation-update\"\n  commands: [\"pose lint-spec pose-consolidation-batch-14-authoring --strict\"]\n  external_sources: []  # [{url: \"\", accessed_at: \"YYYY-MM-DD\"}]\n---\n\n# decision-log: adr-shared-worktree-runtime-review\n\n## Context\n\nReview the [domain/runtime proposal](../adr/2026-10-14-shared-domain-and-optional-worktree-runtime.md)\nfor B31/B33/B35 before functional start, preserving the accepted trust, disclosure\nand scoped-reader boundaries.\n\n## Current state\n\nLast reviewed: 2026-10-14. Proposal is Proposed; specs draft, no IPC/cache/runtime\nor adoption implemented. TTL of 90 days covers staged documentary authoring and\nthe contract review before functional execution; reassess when design/scope changes.\nThe durable rationale stays in the ADR, not in this expiring operational note.\n\n## Next checks\n\nResolve interface/envelope/version compatibility, route/producer inventory, local\nIPC identity/permissions/platforms, cache accounting/view ownership and measured\nQoS thresholds. Execute planned mutation/race/parity/attach/fallback cases only\nwhen the implementation scope is authorized. Lint/merge do not qualify runtime.\n\n## Risks\n\nShared mutable fields can contaminate reads; entry counts do not bound RAM. MCP\nstdio/UID/cache hits are not authority; watch hints are not current generation.\nAmbiguous effects cannot be retried in fallback without receipt/reconciliation.\n\n## Next owner\n\n@pose-maintainers under the existing contract authority, without a new universal\nhuman confirmation or default runtime adoption.\n\n## References\n\n- [Authoring spec](../specs/2026-10-14-pose-consolidation-batch-14-authoring.md)\n- [B31](../specs/2026-10-14-pose-common-domain-and-cli-mcp-handoff.md)\n- [B33](../specs/2026-10-14-pose-bounded-isolated-graph-caches.md)\n- [B35](../specs/2026-10-14-pose-optional-worktree-runtime.md)\n.pose/review-profiles/structural-materiality.json:3:  \"id\": \"structural-materiality\",\n.pose/review-profiles/structural-materiality.json:8:    {\"id\": \"assumption-integrity\", \"kind\": \"judgment\", \"description\": \"Identify material assumptions and their applicable evidence; distinguish verified facts, unresolved assumptions and accepted risks.\"},\n.pose/review-profiles/structural-materiality.json:9:    {\"id\": \"design-causality\", \"kind\": \"judgment\", \"requires_structural_mapping\": true, \"description\": \"Explain how the selected design addresses the stated requirement and material cause, citing the relevant decision basis and structural observations where available.\"},\n.pose/review-profiles/structural-materiality.json:10:    {\"id\": \"solution-proportionality\", \"kind\": \"judgment\", \"description\": \"Compare the solution with the smallest sufficient alternative, including negative space, speculative extensibility and the condition that would invalidate the choice.\"}\n.pose/review-profiles/high-criticality-review.json:3:  \"id\": \"high-criticality-review\",\n.pose/review-profiles/high-criticality-review.json:9:    {\"id\": \"assumption-integrity\", \"kind\": \"judgment\", \"description\": \"Identify material assumptions and their applicable evidence; distinguish verified facts, unresolved assumptions and accepted risks.\"},\n.pose/review-profiles/high-criticality-review.json:10:    {\"id\": \"design-causality\", \"kind\": \"judgment\", \"description\": \"Explain how the selected design addresses the stated requirement and material cause, citing the relevant decision basis and structural observations where available.\"},\n.pose/review-profiles/high-criticality-review.json:11:    {\"id\": \"solution-proportionality\", \"kind\": \"judgment\", \"description\": \"Compare the solution with the smallest sufficient alternative, including negative space, speculative extensibility and the condition that would invalidate the choice.\"}\n.pose/review-profiles/engineering-judgment.json:3:  \"id\": \"engineering-judgment\",\n.pose/review-profiles/engineering-judgment.json:8:    {\"id\": \"assumption-integrity\", \"kind\": \"judgment\", \"description\": \"Identify material assumptions and their applicable evidence; distinguish verified facts, unresolved assumptions and accepted risks.\"},\n.pose/review-profiles/engineering-judgment.json:9:    {\"id\": \"design-causality\", \"kind\": \"judgment\", \"description\": \"Explain how the selected design addresses the stated requirement and material cause, citing the relevant decision basis and structural observations where available.\"},\n.pose/review-profiles/engineering-judgment.json:10:    {\"id\": \"solution-proportionality\", \"kind\": \"judgment\", \"description\": \"Compare the solution with the smallest sufficient alternative, including negative space, speculative extensibility and the condition that would invalidate the choice.\"}\n.pose/review-profiles/backend-review.json:3:  \"id\": \"backend-review\",\n.pose/review-profiles/backend-review.json:8:    {\"id\": \"backend-contracts\", \"description\": \"Public API, event, file and tool contracts remain compatible or explicitly migrated.\", \"rules\": [\"backend-go\"], \"evidence_classes\": [\"integration\", \"e2e\"]},\n.pose/review-profiles/backend-review.json:9:    {\"id\": \"backend-input-errors\", \"description\": \"Inputs, validation failures and error paths are bounded, typed and actionable.\", \"rules\": [\"backend-go\", \"security\"], \"evidence_classes\": [\"unit\", \"integration\", \"e2e\"]},\n.pose/review-profiles/backend-review.json:10:    {\"id\": \"backend-concurrency\", \"description\": \"Concurrent access, cancellation and lifecycle behavior are safe where applicable.\", \"rules\": [\"backend-go\"], \"evidence_classes\": [\"unit\", \"integration\", \"e2e\"]},\n.pose/review-profiles/backend-review.json:11:    {\"id\": \"backend-observability\", \"description\": \"Failures are diagnosable through bounded, non-sensitive logs, metrics or returned context.\", \"rules\": [\"backend-go\", \"security\"], \"evidence_classes\": [\"unit\", \"integration\"]},\n.pose/review-profiles/backend-review.json:12:    {\"id\": \"backend-integration-impact\", \"description\": \"Providers, consumers and inter-component boundaries remain integrated.\", \"evidence_classes\": [\"integration\"]}\n.pose/review-profiles/backend-review.json:15:    {\"id\": \"assess-integrate\", \"requiredness\": \"recommended\", \"evidence_classes\": [\"integration\"], \"criteria\": [\"backend-contracts\", \"backend-integration-impact\"]},\n.pose/review-profiles/backend-review.json:16:    {\"id\": \"validate\", \"requiredness\": \"required\", \"evidence_classes\": [\"build\", \"unit\", \"integration\", \"e2e\"], \"criteria\": [\"backend-input-errors\", \"backend-concurrency\", \"backend-observability\"]}\n.pose/review-profiles/spec-closeout.json:3:  \"id\": \"spec-closeout\",\n.pose/review-profiles/spec-closeout.json:7:    {\"id\": \"scope\", \"description\": \"The implementation matches the approved spec scope.\", \"rules\": [\"documentation-style\"]},\n.pose/review-profiles/spec-closeout.json:8:    {\"id\": \"requirements\", \"description\": \"Every requirement has current, relevant evidence.\", \"evidence_classes\": [\"unit\", \"integration\", \"e2e\"]},\n.pose/review-profiles/spec-closeout.json:9:    {\"id\": \"correctness\", \"description\": \"Functional and negative behavior is correct.\", \"evidence_classes\": [\"build\", \"unit\", \"integration\", \"e2e\"]},\n.pose/review-profiles/spec-closeout.json:10:    {\"id\": \"security\", \"description\": \"Inputs, paths, evidence and authority boundaries are safe.\", \"rules\": [\"security\"]},\n.pose/review-profiles/spec-closeout.json:11:    {\"id\": \"compatibility\", \"description\": \"Public CLI, file and MCP contracts are compatible or explicitly migrated.\"},\n.pose/review-profiles/spec-closeout.json:12:    {\"id\": \"operability\", \"description\": \"Errors, explanations and remediation are actionable.\"},\n.pose/review-profiles/spec-closeout.json:13:    {\"id\": \"documentation\", \"description\": \"Operational docs, templates and scaffold match runtime behavior.\", \"rules\": [\"documentation-style\"]}\n.pose/review-profiles/spec-closeout.json:16:    {\"id\": \"artifact-check\", \"requiredness\": \"required\", \"criteria\": [\"scope\", \"requirements\"], \"preconditions\": [\"artifacts-attributed\"]},\n.pose/review-profiles/spec-closeout.json:17:    {\"id\": \"assess-tech-debt\", \"requiredness\": \"recommended\", \"criteria\": [\"correctness\"]},\n.pose/review-profiles/spec-closeout.json:18:    {\"id\": \"validate\", \"requiredness\": \"required\", \"evidence_classes\": [\"build\", \"unit\", \"integration\", \"e2e\"], \"criteria\": [\"requirements\", \"correctness\"], \"preconditions\": [\"delivery-target-declared\"]}\n","exit_code":0,"status":"completed"}}
