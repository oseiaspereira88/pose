{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'root|chdir' pose-mcp/cmd/pose/main.go | head -20; sed -n '1,100p' pose-mcp/cmd/pose/main.go; sed -n '1,110p' pose-mcp/internal/pose/graph_cache_measure_test.go; sed -n '1,140p' pose-mcp/internal/pose/graph_view_isolation_test.go\"","aggregated_output":"// pose is the native-only unified POSE CLI and MCP server.\npackage main\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\n\t\"github.com/harne8/pose-mcp/internal/cli\"\n)\n\nfunc main() {\n\tif base := filepath.Base(os.Args[0]); base == \"pre-commit\" || base == \"post-merge\" {\n\t\tos.Exit(cli.HookMain(base, os.Stdout, os.Stderr))\n\t}\n\tos.Exit(cli.Main(os.Args[1:], os.Stdout, os.Stderr))\n}\npackage pose\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"runtime\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n)\n\n// R7 (spec pose-bounded-isolated-graph-caches): measured, in the same corpus and\n// environment, with the operation identified. The numbers are logged; the assertions\n// keep the relations the design promises.\n\nfunc realIndex(t *testing.T) []byte {\n\tt.Helper()\n\traw, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"..\", \".pose\", \"indexes\", \"delivery-integrity.json\"))\n\tif err != nil || len(raw) < 1<<20 {\n\t\tt.Skipf(\"no real delivery index to measure (%d bytes, %v)\", len(raw), err)\n\t}\n\treturn raw\n}\n\nfunc heapInUse() uint64 {\n\truntime.GC()\n\tvar m runtime.MemStats\n\truntime.ReadMemStats(&m)\n\treturn m.HeapAlloc\n}\n\nfunc TestGraphByteEstimateTracksTheMeasuredHeap(t *testing.T) {\n\traw := realIndex(t)\n\tgraph, ok := decodeDeliveryIntegrityIndex(raw)\n\tif !ok {\n\t\tt.Fatal(\"the real index does not parse\")\n\t}\n\testimate := estimateGraphBytes(graph)\n\truntime.KeepAlive(graph)\n\tgraph = DeliveryIntegrityGraph{}\n\tbefore := heapInUse()\n\tretained := make([]DeliveryIntegrityGraph, 3)\n\tfor i := range retained {\n\t\tretained[i], _ = decodeDeliveryIntegrityIndex(raw)\n\t}\n\tafter := heapInUse()\n\tmeasured := int64(after-before) / 3\n\tt.Logf(\"operation=parse delivery-integrity.json (%d B raw): estimate=%d B, measured heap per graph=%d B (ratio %.2f)\", len(raw), estimate, measured, float64(estimate)/float64(measured))\n\truntime.KeepAlive(retained)\n\t// The estimate must neither hide most of the heap nor claim many times more than is held.\n\tif estimate < measured/3 || estimate > measured*3 {\n\t\tt.Fatalf(\"the byte estimate is not within a factor of 3 of the measured heap: %d vs %d\", estimate, measured)\n\t}\n}\n\nfunc TestRepeatedReadsAreHitsAndAlternationStaysUnderTheBudget(t *testing.T) {\n\traw := realIndex(t)\n\tdeliveryGraphCache.Reset()\n\tbase := DeliveryGraphCacheStats()\n\n\tstart := time.Now()\n\tif _, ok := parseDeliveryIntegrityGraph(\"/work/a\", raw); !ok {\n\t\tt.Fatal(\"parse\")\n\t}\n\tmiss := time.Since(start)\n\tconst reads = 50\n\tstart = time.Now()\n\tfor i := 0; i < reads; i++ {\n\t\tif _, ok := parseDeliveryIntegrityGraph(\"/work/a\", raw); !ok {\n\t\t\tt.Fatal(\"parse\")\n\t\t}\n\t}\n\thit := time.Since(start) / reads\n\ts := DeliveryGraphCacheStats()\n\tt.Logf(\"operation=read delivery-integrity.json: miss=%v, hit (defensive deep copy)=%v, hits=%d misses=%d retained=%d B\", miss, hit, s.Hits-base.Hits, s.Misses-base.Misses, s.Retained)\n\tif s.Misses-base.Misses != 1 || s.Hits-base.Hits != reads {\n\t\tt.Fatalf(\"repeated reads must hit: %+v\", s)\n\t}\n\n\t// Alternating between many worktrees holding different generations of the index\n\t// must stay under the budgets, evicting rather than growing.\n\tfor i := 0; i < 12; i++ {\n\t\tvariant := append([]byte(nil), raw...)\n\t\tvariant = append(variant[:len(variant)-1:len(variant)-1], []byte(\" \")...) // distinct bytes\n\t\tvariant = append(variant, byte('0'+i%10), '\\n')\n\t\t_ = variant // the parse of a mutated tail fails; use whole distinct documents below\n\t}\n\tvar wg sync.WaitGroup\n\tfor g := 0; g < 4; g++ {\n\t\twg.Add(1)\n\t\tgo func(g int) {\n\t\t\tdefer wg.Done()\n\t\t\tfor i := 0; i < 6; i++ {\n\t\t\t\tdoc := []byte(`{\"schema_version\":1,\"input_digest\":\"` + string(rune('a'+g)) + string(rune('0'+i)) + `\",\"nodes\":[],\"edges\":[],\"claims\":[],\"change_sets\":[],\"reverse\":{},\"findings\":[]}`)\n\t\t\t\tif _, ok := parseDeliveryIntegrityGraph(\"/work/\"+string(rune('a'+g)), doc); !ok {\n\t\t\t\t\tt.Error(\"parse\")\n\t\t\t\t}\n\t\t\t}\n\t\t}(g)\n\t}\n\twg.Wait()\n\ts = DeliveryGraphCacheStats()\n\tif s.Retained > deliveryGraphCacheBytes {\n\t\tt.Fatalf(\"the global budget was exceeded: %+v\", s)\n\t}\n\tt.Logf(\"after alternating 4 worktrees x 6 generations: entries=%d retained=%d B (budget %d B) evictions=%d\", s.Entries, s.Retained, deliveryGraphCacheBytes, s.Evictions)\n}\n\npackage pose\n\nimport (\n\t\"fmt\"\n\t\"reflect\"\n\t\"sort\"\n\t\"testing\"\n)\n\n// Deep isolation of the delivery graph a cache hands out (spec\n// pose-bounded-isolated-graph-caches R2). The check is structural, not a list of\n// the fields someone remembered: it fills every slice, map and pointer of the graph\n// with a value, copies it, and finds every reference the copy shares with the\n// original.\n\nfunc populate(v reflect.Value, depth int) {\n\tif depth > 6 {\n\t\treturn\n\t}\n\tswitch v.Kind() {\n\tcase reflect.Struct:\n\t\tfor i := 0; i < v.NumField(); i++ {\n\t\t\tif v.Field(i).CanSet() {\n\t\t\t\tpopulate(v.Field(i), depth+1)\n\t\t\t}\n\t\t}\n\tcase reflect.Slice:\n\t\ts := reflect.MakeSlice(v.Type(), 2, 2)\n\t\tfor i := 0; i < s.Len(); i++ {\n\t\t\tpopulate(s.Index(i), depth+1)\n\t\t}\n\t\tv.Set(s)\n\tcase reflect.Map:\n\t\tm := reflect.MakeMap(v.Type())\n\t\tkey := reflect.New(v.Type().Key()).Elem()\n\t\tpopulate(key, depth+1)\n\t\tval := reflect.New(v.Type().Elem()).Elem()\n\t\tpopulate(val, depth+1)\n\t\tm.SetMapIndex(key, val)\n\t\tv.Set(m)\n\tcase reflect.Ptr:\n\t\tp := reflect.New(v.Type().Elem())\n\t\tpopulate(p.Elem(), depth+1)\n\t\tv.Set(p)\n\tcase reflect.String:\n\t\tv.SetString(fmt.Sprintf(\"s%d\", depth))\n\tcase reflect.Int, reflect.Int64:\n\t\tv.SetInt(int64(depth) + 1)\n\tcase reflect.Bool:\n\t\tv.SetBool(true)\n\t}\n}\n\n// references records the address of every slice backing array, map and pointer\n// reachable from v.\nfunc references(v reflect.Value, path string, out map[uintptr]string) {\n\tswitch v.Kind() {\n\tcase reflect.Struct:\n\t\tfor i := 0; i < v.NumField(); i++ {\n\t\t\treferences(v.Field(i), path+\".\"+v.Type().Field(i).Name, out)\n\t\t}\n\tcase reflect.Slice:\n\t\tif v.Len() > 0 {\n\t\t\tout[v.Pointer()] = path\n\t\t}\n\t\tfor i := 0; i < v.Len(); i++ {\n\t\t\treferences(v.Index(i), fmt.Sprintf(\"%s[%d]\", path, i), out)\n\t\t}\n\tcase reflect.Map:\n\t\tif !v.IsNil() {\n\t\t\tout[v.Pointer()] = path\n\t\t}\n\t\titer := v.MapRange()\n\t\tfor iter.Next() {\n\t\t\treferences(iter.Value(), path+\"{}\", out)\n\t\t}\n\tcase reflect.Ptr:\n\t\tif !v.IsNil() {\n\t\t\tout[v.Pointer()] = path\n\t\t\treferences(v.Elem(), path+\"*\", out)\n\t\t}\n\t}\n}\n\nfunc sharedReferences(a, b any) []string {\n\tra, rb := map[uintptr]string{}, map[uintptr]string{}\n\treferences(reflect.ValueOf(a), \"graph\", ra)\n\treferences(reflect.ValueOf(b), \"graph\", rb)\n\tvar shared []string\n\tfor addr, path := range ra {\n\t\tif _, ok := rb[addr]; ok {\n\t\t\tshared = append(shared, path)\n\t\t}\n\t}\n\tsort.Strings(shared)\n\treturn shared\n}\n\nfunc TestACachedGraphSharesNoReferenceWithItsCopies(t *testing.T) {\n\tvar graph DeliveryIntegrityGraph\n\tpopulate(reflect.ValueOf(&graph).Elem(), 0)\n\tcopied := copyDeliveryIntegrityGraph(graph)\n\tif !reflect.DeepEqual(graph, copied) {\n\t\tt.Fatal(\"the copy does not equal the original\")\n\t}\n\tif shared := sharedReferences(graph, copied); len(shared) != 0 {\n\t\tt.Fatalf(\"the copy shares %d references with the original:\\n%v\", len(shared), shared)\n\t}\n}\n\nfunc TestMutatingAReadNeverReachesTheNextRead(t *testing.T) {\n\tdeliveryGraphCache.Reset()\n\traw := []byte(`{\"schema_version\":1,\"input_digest\":\"d\",\"nodes\":[{\"id\":\"n\",\"type\":\"t\",\"attributes\":{\"k\":\"v\"}}],\"edges\":[],\"claims\":[],\"change_sets\":[],\"reverse\":{\"p\":[\"a\"]},\"findings\":[{\"id\":\"f\",\"path\":\"p\"}]}`)\n\tfirst, ok := parseDeliveryIntegrityGraph(\"root\", raw)\n\tif !ok {\n\t\tt.Fatal(\"parse failed\")\n\t}\n\tfirst.Nodes[0].Attributes[\"k\"] = \"mutated\"\n\tfirst.Nodes[0].Attributes[\"new\"] = \"x\"\n\tfirst.Reverse[\"p\"][0] = \"mutated\"\n\tfirst.Findings[0].Path = \"mutated\"\n\tfirst.Nodes = first.Nodes[:0]\n\tsecond, ok := parseDeliveryIntegrityGraph(\"root\", raw)\n\tif !ok || len(second.Nodes) != 1 || second.Nodes[0].Attributes[\"k\"] != \"v\" || len(second.Nodes[0].Attributes) != 1 ||\n\t\tsecond.Reverse[\"p\"][0] != \"a\" || second.Findings[0].Path != \"p\" {\n\t\tt.Fatalf(\"a caller's write reached the next read: %+v\", second)\n\t}\n}\n","exit_code":0,"status":"completed"}}
