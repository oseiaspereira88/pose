T_46}\" ]; then   if [ -z \"${npm_config_proxy+x}\" ] || [ \"${npm_config_proxy-}\" != \"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_46}\" ]; then export npm_config_proxy=\"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_46}\"; else export npm_config_proxy; fi else builtin unset npm_config_proxy 2>/dev/null || command unset npm_config_proxy; fi builtin unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_46 __CODEX_SNAPSHOT_PROXY_OVERRIDE_46 2>/dev/null || command unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_46 __CODEX_SNAPSHOT_PROXY_OVERRIDE_46 if [ -n \"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_47}\" ]; then   if [ -z \"${ws_proxy+x}\" ] || [ \"${ws_proxy-}\" != \"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_47}\" ]; then export ws_proxy=\"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_47}\"; else export ws_proxy; fi else builtin unset ws_proxy 2>/dev/null || command unset ws_proxy; fi builtin unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_47 __CODEX_SNAPSHOT_PROXY_OVERRIDE_47 2>/dev/null || command unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_47 __CODEX_SNAPSHOT_PROXY_OVERRIDE_47 if [ -n \"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_48}\" ]; then   if [ -z \"${wss_proxy+x}\" ] || [ \"${wss_proxy-}\" != \"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_48}\" ]; then export wss_proxy=\"${__CODEX_SNAPSHOT_PROXY_OVERRIDE_48}\"; else export wss_proxy; fi else builtin unset wss_proxy 2>/dev/null || command unset wss_proxy; fi builtin unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_48 __CODEX_SNAPSHOT_PROXY_OVERRIDE_48 2>/dev/null || command unset __CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_48 __CODEX_SNAPSHOT_PROXY_OVERRIDE_48 fi if [ -n \"${PATH:-}\" ]; then export PATH='/usr/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/codex-path':\"$PATH\"; else export PATH='/usr/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/codex-path'; fi  exec '/usr/bin/bash' -c 'ps -eo pid,ppid,etime,args | rg '\"'\"'pose (artifact|surface|closeout|review-check)|python3 -|go test'\"'\"' | head -20; sed -n '\"'\"'1940,1988p'\"'\"' pose-mcp/internal/pose/review_closeout.go; rg -n '\"'\"'func copyDeliveryIntegrityGraph'\"'\"' pose-mcp/internal/pose/delivery_integrity_cache.go; sed -n '\"'\"'170,330p'\"'\"' pose-mcp/internal/pose/delivery_integrity_cache.go'\n      2       1       00:00 /usr/bin/bash -c ps -eo pid,ppid,etime,args | rg 'pose (artifact|surface|closeout|review-check)|python3 -|go test' | head -20; sed -n '1940,1988p' pose-mcp/internal/pose/review_closeout.go; rg -n 'func copyDeliveryIntegrityGraph' pose-mcp/internal/pose/delivery_integrity_cache.go; sed -n '170,330p' pose-mcp/internal/pose/delivery_integrity_cache.go\n      4       2       00:00 rg pose (artifact|surface|closeout|review-check)|python3 -|go test\n//\n// The class was already checked; presence was not, so a disposition could name\n// a class the tool asks for and an id that appears nowhere. Only a tool that\n// declares evidence classes is held to the sealed set: tools that declare none\n// cite other kinds of reference — a check id, a report path — which the bundle\n// does not carry and is not meant to.\nfunc reviewToolEvidenceBlocker(tool ReviewPlanTool, disposition ReviewToolDisposition, sealed map[string]ReviewBundleEvidence) string {\n\tlabel := reviewToolLabel(tool.ID, tool.Component)\n\tif disposition.Evidence == \"\" {\n\t\treturn \"review tool \" + label + \" has no evidence\"\n\t}\n\tif len(tool.EvidenceClasses) == 0 {\n\t\treturn \"\"\n\t}\n\tclass := strings.SplitN(disposition.Evidence, \":\", 2)[0]\n\tif !containsFold(tool.EvidenceClasses, class) {\n\t\treturn \"review tool \" + label + \" lacks a required evidence class\"\n\t}\n\tif sealed == nil {\n\t\treturn \"\"\n\t}\n\tevidence, present := sealed[disposition.Evidence]\n\tif !present {\n\t\treturn \"review tool \" + label + \" cites evidence absent from the sealed bundle: \" + disposition.Evidence\n\t}\n\t// A tool scoped to a component answers for that component. Evidence from a\n\t// sibling is real, of a demanded class, and says nothing about the thing the\n\t// tool was planned to check.\n\tif tool.Component != \"\" && !moduleMatchesTarget(evidence.Module, tool.Component) {\n\t\treturn \"review tool \" + label + \" cites evidence from \" + evidenceModuleLabel(evidence) + \": \" + disposition.Evidence\n\t}\n\treturn \"\"\n}\n\nfunc reviewToolKey(id, component string) string {\n\treturn id + \"\\x00\" + component\n}\n\nfunc reviewToolLabel(id, component string) string {\n\tif component == \"\" {\n\t\treturn id\n\t}\n\treturn id + \" (component \" + component + \")\"\n}\n\n// ReviewContract names a governance contract whose rules judge work that was\n// completed before the contract existed.\n//\n// Every one of these has arrived the same way: a rule tightens, and every\n175:func copyDeliveryIntegrityGraph(in DeliveryIntegrityGraph) DeliveryIntegrityGraph {\n}\n\n// copyDeliveryIntegrityGraph copies every field that a caller could write through.\n// TestDeliveryGraphCopyCoversEveryField fails when a field is added to the struct\n// without being handled here, so an omission cannot become a silently shared slice.\nfunc copyDeliveryIntegrityGraph(in DeliveryIntegrityGraph) DeliveryIntegrityGraph {\n\tout := in\n\tout.Nodes = make([]DeliveryIntegrityNode, len(in.Nodes))\n\tfor i, node := range in.Nodes {\n\t\tnode.Attributes = copyStringMap(node.Attributes)\n\t\tout.Nodes[i] = node\n\t}\n\tout.Edges = append([]DeliveryIntegrityEdge{}, in.Edges...)\n\tout.Claims = append([]ArtifactClaim{}, in.Claims...)\n\tout.Findings = append([]DeliveryIntegrityFinding{}, in.Findings...)\n\tout.Deliveries = append([]DeliveryTarget{}, in.Deliveries...)\n\tout.ValidationResults = make([]DeliveryValidationResult, len(in.ValidationResults))\n\tfor i, result := range in.ValidationResults {\n\t\tresult.ScopeProvenance = copyStringMap(result.ScopeProvenance)\n\t\tresult.MaterialProvenance = copyStringMap(result.MaterialProvenance)\n\t\tout.ValidationResults[i] = result\n\t}\n\tout.RoadmapCriteria = make([]RoadmapCriterion, len(in.RoadmapCriteria))\n\tfor i, criterion := range in.RoadmapCriteria {\n\t\tcriterion.Refs = append([]string(nil), criterion.Refs...)\n\t\tcriterion.Reasons = append([]string(nil), criterion.Reasons...)\n\t\tout.RoadmapCriteria[i] = criterion\n\t}\n\tout.Archivals = append([]ArchivedFragment{}, in.Archivals...)\n\tout.Removals = make([]ArtifactRemoval, len(in.Removals))\n\tfor i, r := range in.Removals {\n\t\tif r.Supersedes != nil {\n\t\t\tsupersedes := make(map[string]string, len(r.Supersedes))\n\t\t\tfor k, v := range r.Supersedes {\n\t\t\t\tsupersedes[k] = v\n\t\t\t}\n\t\t\tr.Supersedes = supersedes\n\t\t}\n\t\tif r.Refusals != nil {\n\t\t\trefusals := make(map[string]string, len(r.Refusals))\n\t\t\tfor k, v := range r.Refusals {\n\t\t\t\trefusals[k] = v\n\t\t\t}\n\t\t\tr.Refusals = refusals\n\t\t}\n\t\tout.Removals[i] = r\n\t}\n\tif in.Removals == nil {\n\t\tout.Removals = nil\n\t}\n\n\t// ChangeSet carries slices of its own, so copying the outer slice is not enough.\n\tout.ChangeSets = make([]ChangeSet, len(in.ChangeSets))\n\tfor i, set := range in.ChangeSets {\n\t\tset.Commits = append([]string{}, set.Commits...)\n\t\tset.Paths = append([]ObservedPath{}, set.Paths...)\n\t\tif set.MaterialInputs != nil {\n\t\t\tinputs := MaterialInputs{Names: append([]string(nil), set.MaterialInputs.Names...), Moved: append([]string(nil), set.MaterialInputs.Moved...)}\n\t\t\tset.MaterialInputs = &inputs\n\t\t}\n\t\tout.ChangeSets[i] = set\n\t}\n\tout.Reverse = copyStringSliceMap(in.Reverse)\n\tout.Paths = copyStringSliceMap(in.Paths)\n\treturn out\n}\n\nfunc copyStringSliceMap(in map[string][]string) map[string][]string {\n\tif in == nil {\n\t\treturn nil\n\t}\n\tout := make(map[string][]string, len(in))\n\tfor key, values := range in {\n\t\tout[key] = append([]string{}, values...)\n\t}\n\treturn out\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/usr/bin/bash -lc \"python3 - <<'PY'\nimport subprocess\nfor args in [['pose','review-check','spec:pose-bounded-isolated-graph-caches'],['pose','closeout-check','spec:pose-bounded-isolated-graph-caches']]:\n try:\n  p=subprocess.run(args,text=True,capture_output=True,timeout=20)\n  print('COMMAND', ' '.join(args), 'EXIT',p.returncode);print(p.stdout[-2400:]);print(p.stderr[-700:])\n except subprocess.TimeoutExpired:\n  print('COMMAND', ' '.join(args), 'TIMEOUT after 20s')\nPY\"","aggregated_output":"COMMAND pose review-check spec:pose-bounded-isolated-graph-caches TIMEOUT after 20s\nCOMMAND pose closeout-check spec:pose-bounded-isolated-graph-caches TIMEOUT after 20s\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'case \\\"design\\\"|assessDesign|cmdAssessDesign' pose-mcp/internal/cli/assess.go; sed -n '140,195p' pose-mcp/internal/cli/assess.go; git diff 7e40761..eacc007 -- POSE.md | tail -65; sed -n '1,70p' .pose/review-attestations/rva-7c57f9a45545e148.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'case \\\"design\\\"|assessDesign|cmdAssessDesign' pose-mcp/internal/cli/assess.go; sed -n '140,195p' pose-mcp/internal/cli/assess.go; git diff 7e40761..eacc007 -- POSE.md | tail -65; sed -n '1,70p' .pose/review-attestations/rva-7c57f9a45545e148.json\"","aggregated_output":"78:\t\tcase \"design\":\n79:\t\t\treturn assessDesign(root, args[1:], stdout, stderr, locale)\n}\n\n// runAssessValidation is the shared R6 validation: structure, evidence,\n// stable-id contract, staleness. It never writes.\nfunc runAssessValidationIn(files pose.Files, root string) (*assessReport, error) {\n\tstore := pose.Store{Root: root, FS: files}\n\tassessment, err := store.LoadCapabilityAssessment()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treport := &assessReport{Path: assessment.Path, Mechanisms: len(assessment.Mechanisms), AssessedAt: assessment.AssessedAt}\n\treport.Errors = append(report.Errors, store.ValidateCapabilityEvidence(assessment)...)\n\n\thistory, err := pose.LoadCapabilityHistoryIn(files, store.CapabilityHistoryPath())\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif effective := pose.EffectiveSnapshots(history); len(effective) > 0 {\n\t\tlatest := effective[len(effective)-1]\n\t\tfor _, id := range pose.RenumberedMechanisms(latest, assessment) {\n\t\t\treport.Errors = append(report.Errors,\n\t\t\t\tfmt.Sprintf(\"mechanism %q was published in the latest snapshot but is gone from the assessment; retire it (`- retired: true`) instead of removing it\", id))\n\t\t}\n\t}\n\n\tpolicy := loadCapabilityPolicyIn(files, root)\n\tif assessed, err := time.Parse(\"2006-01-02\", assessment.AssessedAt); err == nil {\n\t\treport.AgeDays = int(files.Now().Sub(assessed).Hours() / 24)\n\t\tif report.AgeDays > policy.StaleAfterDays {\n\t\t\treport.StaleByDays = true\n\t\t\treport.Warnings = append(report.Warnings,\n\t\t\t\tfmt.Sprintf(\"assessment is %d days old (policy: %d); consider reassessing\", report.AgeDays, policy.StaleAfterDays))\n\t\t}\n\t}\n\treport.CommitsLag = \"unknown\"\n\tif out, err := pose.RawHistoryGit(root, \"rev-list\", \"--count\", assessment.BaselineCommit+\"..HEAD\").Output(); err == nil {\n\t\tlag := strings.TrimSpace(string(out))\n\t\treport.CommitsLag = lag\n\t\tif n, err := strconv.Atoi(lag); err == nil && n > policy.StaleAfterCommits {\n\t\t\treport.StaleByLag = true\n\t\t\treport.Warnings = append(report.Warnings,\n\t\t\t\tfmt.Sprintf(\"baseline_commit is %d commits behind HEAD (policy: %d); consider reassessing\", n, policy.StaleAfterCommits))\n\t\t}\n\t}\n\treturn report, nil\n}\n\n// runAssessValidation reads and writes the filesystem directly; runAssessValidationIn takes the\n// operation's files.\nfunc runAssessValidation(root string) (*assessReport, error) {\n\treturn runAssessValidationIn(pose.NativeFiles(), root)\n}\n\nfunc assessValidate(root string, asJSON bool, stdout, stderr io.Writer, locale cliLocale) int {\n\treport, err := runAssessValidation(root)\n\tif err != nil {\n \n@@ -370,7 +374,7 @@ pose release-notes --version vX.Y.Z  # compatibility alias for the immutable not\n - `state --governance [--scope <ref>] [--json]` (spec `pose-effective-governance-projection`) — live, read-only projection of what governance is in force here: for each registry contract, optional capability (atomic start, contract nodes, causality closeout, qualified references, spec transfer, criterion reuse, signed attestations, verified identity) and gate (Definition of Ready, delivery integrity), whether it is `supported`, `configured`, `applicable` and `effective`, with reason codes such as `not-adopted`, `no-readiness-cutoff`, `legacy-cutoff:<date>` or `identity-assurance-declared`. `--scope` compares the scope's newest sealed bundle — the contracts it stamped — with what the policy seals today. It reads the same functions the gates call and writes nothing. `pose_project_state` carries the same projection as `effective_governance` (optional `governance_scope`).\n - `state --attention` (specs `pose-obligation-projection`, `pose-state-attention`) — live, read-only answer to \"what is still owed, by whom, restricting which phase?\". Obligations are projected from the subsystems that own them — readiness (unmet `depends_on`, Definition of Ready, unexplained `blocked`), closeout and review of in-progress specs (an unapproved review, each judgment criterion a sealed bundle still owes, text blockers carried as `legacy-opaque`), start reconciliation when atomic start is adopted, and open follow-ups as advisory residual debt — never stored a second time. Project-level sources are projected too (spec `pose-attention-projects-every-source`), originating on `xref:<project>/project:<project>`: an open docs review mark (owed by the doc's owner until `pose docs-review resolve`), a capability mechanism with a stale trigger, a release newer than the newest verified one that is not yet verified, and an accepted-risk or follow-up finding past its review date in the latest legacy review record. Free-form investigation notes carry no state and are not a source. The render shows coverage first: a producer that failed, or action requests until adopted, makes the answer `INCOMPLETE`, so an empty group never reads as nothing owed, and a fresh install, once committed, reads `complete`. Then what needs `--actor` (or any person or role), then what restricts each phase (`start`, `execution`, `review`, `closeout`, `release`), then residual debt. `--json` returns the report — stable `obl-` ids, qualified refs, reason codes, conditions, recipients, effects, satisfaction, knowledge, waiting, a snapshot of revision/dirty tree/policy/contract/index digests, per-producer coverage — plus the `attention` grouping. MCP: `pose_obligations` returns the same ids from the same function. Attention is not a gate.\n - Governance read views (spec `pose-governance-read-view-generation`) — inspect `snapshot.read_view` in `state --attention --json` and `pose_obligations`: its own `schema_version: 1`, observed-input ID, engine/parser versions and root bindings describe one operation. The enclosing report stays at schema version 1. Review and closeout JSON expose the same contract in `read_view`. The ID binds consumed bytes, directory observations, errors and absences; revision, dirty state, size and mtime alone do not prove equivalence. `current` describes the final audit instant only. Coherence, producer coverage and freshness are separate: `unknown` or incomplete coverage must never be read as nothing owed or as write authorization. A historical report without this binding remains readable and proves no current authorization.\n-  Reads retain at most 25,000 observations including retained directory entries, 512 MiB of input bytes and 8 MiB of metadata. A detected interleaving discards that attempt and retries the whole read once; another change leaves the affected coverage incomplete and freshness `unknown`. Unsupported readers and unbound federated inputs remain unknown. Participating writers acquire authorized root guards before reevaluation and hold them through publication; destination CAS and index descriptor checks remain in force. Writers outside that protocol, including an external change restored before audit, are outside this exclusion guarantee. No watcher, daemon or cross-operation cache is introduced.\n+  Reads retain at most 40,000 observations including retained directory entries, 512 MiB of input bytes and 16 MiB of metadata. A detected interleaving discards that attempt and retries the whole read once; another change leaves the affected coverage incomplete and freshness `unknown`. Unsupported readers and unbound federated inputs remain unknown. Participating writers acquire authorized root guards before reevaluation and hold them through publication; destination CAS and index descriptor checks remain in force. Writers outside that protocol, including an external change restored before audit, are outside this exclusion guarantee. No watcher, daemon or cross-operation cache is introduced.\n   The global review-closeout check composes an audited selection/catalogue coordinator with independently bounded scope operations. A scope and its recursive children use one closure; workers share only the explicitly bound immutable catalogue. At most 16 scope closures are live, further limited by `POSE_CHECK_WORKERS` or the core count. Scope findings are buffered until their audits and the coordinator audit finish. This proves coherent selection and individually audited results, not a simultaneous snapshot across every completed scope; one exhausted scope cannot consume its sibling's capture budget, and any unresolved loss still fails the global gate.\n - `action <open|list|show|resolve|cancel|waive|invalidate>` (specs `pose-action-requests`, `pose-action-request-resolution`) — material requests to a person or an external system that no other source records: a decision, an approval, an input, an external operation or an acceptance, with its question, options and consequences, recommendation, recipient (principal, role or `unassigned`), qualified targets (`requirement:R4` inside the origin spec, or `xref:…`), per-phase effects (`--effect closeout:block` lets implementation continue) and an optional subject (`--subject requirement:R4` or `path:<file>`) whose change invalidates an answer recorded for the old content. Open one only when a different answer would materially change execution, scope, authority, risk acceptance, closeout or publication and no authorization already given covers it. Each request is an append-only journal under `.pose/actions/`, read whole: a line with a second value, a duplicate field (keys differing only in case included), an unknown event type, another schema, a sequence gap, an empty line or no terminator is never part of a view; `action show|list` and MCP locate it (line, byte offset, length, SHA-256) as an `interrupted-tail`, with a truncation proposal for a person to review, or as `corrupt`, to restore from version control — the engine repairs nothing (spec `pose-journal-checkpoint-and-lock-recovery`); `open` is a preview until `--apply`. Targets are qualified with the current project id; when it is derived from the directory name (no `.pose/project.json`, `POSE_DEFAULT_PROJECT_ID` or `POSE_PROJECT_ROOTS` binding), `open --apply` says so (on stderr with `--json`), because a checkout under another name would record another project, and the obligation snapshot lists the same limitation. A resolution names the `--request-digest` it answers and the `--expected-revision` it read, carries an `--idempotency-key` (a retry is a no-op, the same key with other content is refused, a second answer against the same revision is refused) and comes from an actor holding the recipient role in `.pose/policy/actions.json` (`{\"schema_version\":1,\"roles\":{\"maintainer\":[\"human:<name>\"]},\"identity_assurance\":\"declared|verified\"}`); under `verified` it needs `--claim <file>` with an Ed25519 claim from an issuer pinned in the review policy, bound to project, audience, request digest, principal and answer (a human principal also needs `human_authority_issuers`). Answered is not satisfied: a declined approval, a rejected acceptance or a failed external operation leaves the condition unmet. The requester may cancel its own question; a waiver needs the recipient authority and a reason. Open requests are projected as `actor-action` obligations in `state --attention` and `pose_obligations`; MCP opens requests with `pose_action_open` (risk class `governance-write`, a preview unless `apply` is true) and reads them with `pose_action_requests`; `pose_action_resolve` (spec `pose-mcp-action-resolve-signed-only`, `governance-write`) records an answer only with the principal's proof — a signature by a key registered to it, or a trusted issuer's claim — and refuses a declared answer under any assurance; its preview returns the statement to sign and the `ssh-keygen` command.\n - Action destination scoping (spec `pose-action-target-and-node-scoping`) — origin is provenance, targets select relevance, and effects select restrictions. An empty effect scope still means the whole source artifact; a roadmap or milestone expands its current members. Explicit scopes replace that default, so a request from alpha can restrict beta without blocking alpha. A named whole artifact is a whole restriction, not partial merely because it is qualified. Pending requests remain visible when their origin becomes terminal. Unknown membership or unreadable material is reported as limited coverage and never expands into every spec. CLI accepts `--effect-json '{\"phase\":\"start\",\"mode\":\"block\",\"scope\":[\"xref:project/spec:beta\"]}'`; MCP `effects` accepts the same object alongside legacy `\"start:block\"` strings. Targets and subjects resolve by project/artifact/kind/ID, and a subject is re-read in its recorded artifact. Under adopted agency readiness, new approvals and acceptances require an explicit `--subject` / `subject`; legacy unbound requests retain their journal and report that answers have no content-change detection. Policy-off creation and transition defaults remain unchanged. This compatibility tightening requires release review; no policy adoption happens here.\n@@ -425,6 +429,8 @@ pose release-notes --version vX.Y.Z  # compatibility alias for the immutable not\n - `telemetry <enable|disable|status>` — manages anonymous, opt-in platform telemetry settings.\n - `release` / `release-notes` — governed release lifecycle (`plan`, `prepare`, `check`, `notes`, `record`, `status`, `open-next`, `backfill`) ensuring immutable release notes, manifest freezing, provider evidence importing, and reproducible release verification. A release that introduces a governance contract carries a **Compatibility** section at the top of its notes, generated from the contract registry. `release-notes` provides a compatibility alias for viewing frozen notes. The version a cut is compared with comes from `version_source` in `.pose/policy/release.json` (`{\"path\": \"VERSION\", \"kind\": \"text\"}`, or `\"kind\": \"json\"` with a `key`): a project file holding `X.Y.Z`, with an optional `v` and `-dev` suffix. Only the engine repository may omit it; every other project must declare one. Manifest and tag integrity (spec `pose-release-manifest-tag-integrity`): a manifest is read through a strict contract (supported `schema_version`, no unknown fields, clean version and paths) that recomposes `specs`, `categories`, `breaking` and `release_input_digest` from the fragments it freezes, so an adulterated projection is refused instead of normalised. `check` and `status` verify a tag from its own tree: the tag (lightweight or annotated) is peeled to its commit, and the manifest, notes, frozen fragments and version source are read as blobs of that commit, never from the working tree. A tag whose tree holds no manifest is refused whatever the working tree holds; a later commit, provider evidence or the next cycle does not make a correct cut stale; a version source that cannot be recomputed from the manifest is reported as a limit.\n \n+  **Query cursors:** paginated MCP list tools (`pose_list_specs`, `pose_list_roadmaps`, `pose_list_knowledge`, `pose_list_reports`, `pose_capability_history`) continue a query over the collection it was issued for. A cursor is signed, expires after 15 minutes and is bound to its tool, project, filters and the ordered collection with its index generation; a changed collection, another query, an expired token, a version 1 token or a server restart is refused with a `cursor-*` code and the caller restarts from the first page, never continued over a changed collection. A page is at most 500 items, discloses its `generation`, `collection` and `total`, and a missing `next_cursor` does not certify anything beyond that collection (spec `pose-generation-bound-query-cursors`).\n+\n ### MCP connection contract\n \n - Treat `.mcp.json`, the connected server process and the selected project as\n@@ -918,6 +924,45 @@ Reservations live in `.pose/review-attempts/`, final receipts link the run, and\n \n **Delegated runs over MCP.** `pose_delegate_start` (review, adjudicate or smoke), `pose_delegate_status`, `pose_delegate_wait`, `pose_delegate_resume` and `pose_delegate_handoff` run `pose delegate … --json` in the project the server resolved for the call, so every plan, refusal and run is the CLI's: a start, resume or handoff is always detached and returns once the run has reserved its attempt (without `apply` it previews), a status never blocks, and a wait blocks at most its `timeout_seconds` (300 at most), returning `still-running` when the bound passes. Refusals carry the same `reason_code` as the CLI's error document (`rerun-without-reason`, `budget-exhausted`, `containment-incompatible`, `agent-unavailable`, `no-agent`), and results carry the normalized summary only: no transcript, prompt, session reference or environment value. `pose delegate resume` and `handoff` take `--detach` as the purposes do. A task is not started over MCP.\n \n+### Keep delegated work proportional\n+\n+Delegate a bounded question or change with named paths, acceptance criteria,\n+allowed access and a stopping condition. Give the worker relevant references\n+and excerpts; keep full transcripts and command output in files. Use the native\n+`task` purpose for implementation or investigation and the generated sealed brief\n+for governed review, adjudication or smoke conclusions.\n+\n+- Keep coordination and mechanical CLI steps with the primary execution. Do not\n+  add a secondary coordinator merely to watch another worker or fill CLI forms.\n+- Inspect `agents` and preview the route once before starting. Record the chosen\n+  model, vendor, effort, access and attempt; preserve the independence required\n+  by the sealed plan.\n+- Use native `watch` or `wait` to follow a run. Report stage changes and findings;\n+  do not spend agent turns repeatedly reading unchanged logs.\n+- Resume or hand off the existing attempt when its state permits. Preserve failed\n+  and quota-limited records and respect their budgets. Do not start a fresh run\n+  to bypass a limit or invent a reset time the provider did not report.\n+- Before a detached review of a new scope, ensure the sealed checkout contains\n+  matching indexed attribution and structured validation for its source. Persist\n+  missing derived inputs before final validation; uncommitted results and indexes\n+  are unavailable in that checkout.\n+- Check provider authentication and output/capture framing when configuring an\n+  agent or after a setup failure. Availability and a routing preview do not prove\n+  a successful model request or a verifiable conclusion.\n+- Run focused regressions while changing code. Reuse current canonical evidence\n+  when native coverage and provenance support it, and repeat checks invalidated\n+  by a material change. Preserve required checks, controls and independent\n+  judgments; a task's success is not review approval.\n+- Reuse applicable corpus and fixtures. Add an extra experiment only for an\n+  identified risk, contract or finding, with a bounded scope. Qualification of a\n+  separate engine-wide pilot is not an automatic checklist for every spec.\n+- Track machine time and CPU/RAM separately from model input/output and cached\n+  tokens. Do not infer billed cost or unique context from cumulative token counts.\n+\n+Use these practices within the existing review plan and task workflow. They do\n+not create another mandatory rehearsal, report or approval layer. Keep the\n+technical details of execution routing in the sections below.\n+\n ### Bound delegated adapter execution\n \n Declare an optional `containment` object on each agent in `.pose/policy/delegation.json`. Use containment schema 1 and `trusted-process`. This backend runs a trusted local executable; a disposable worktree shares Git metadata and does not isolate filesystem, original repository, network, credential files, CPU or memory. Required guarantees that the host cannot enforce are refused before reserving an attempt or spawning a process. Linux process-group termination requires an observable process inventory and is checked after kill; descendants that escape the group remain outside its coverage. Windows/other ports do not qualify group containment from a cross-build.\n{\n  \"run\": {\n    \"run_id\": \"rrn-c61a2d4907486035\",\n    \"proof_id\": \"rrp-82e5866a00bf0daaa25db6fd4c544abe2bb44d170fd8eb4237b87f516579b691\"\n  },\n  \"schema_version\": 1,\n  \"attestation_id\": \"rva-7c57f9a45545e148\",\n  \"bundle_id\": \"rvb-2527547805f75b6b\",\n  \"bundle_digest\": \"sha256:2527547805f75b6b73d01c871e4162fbe2e21609039deb5b4d7469a932264904\",\n  \"reviewer\": \"agent:openai/gpt-6.1-sol\",\n  \"decision\": \"approved\",\n  \"criteria\": [\n    {\n      \"id\": \"assumption-integrity\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"structure:design-484c6eb6d942f499\",\n      \"rationale\": \"Verified the shared five-tool implementation, process-local signing and full-scan disclosure. Restart invalidation and platform-specific metadata limitations are explicit design limits. Cross-platform execution was not independently verified.\"\n    },\n    {\n      \"id\": \"backend-concurrency\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/generation-bound-query-cursors-integration\",\n      \"rationale\": \"Focused tests passed with -race in internal/pose and internal/mcpserver. Signing-key initialization and generation-cache access are synchronized; no retained query lifecycle is introduced.\"\n    },\n    {\n      \"id\": \"backend-contracts\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/generation-bound-query-cursors-integration\",\n      \"rationale\": \"All five MCP tools use the shared cursor contract. Version-1 tokens are explicitly refused, legacy unpaginated calls remain supported, and pagination metadata is additive.\"\n    },\n    {\n      \"id\": \"backend-input-errors\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/generation-bound-query-cursors-integration\",\n      \"rationale\": \"Hostile tokens, altered bindings, expiry, positions, null cursors, argument aliases and invalid explicit limits have negative coverage. Focused tests passed independently.\"\n    },\n    {\n      \"id\": \"backend-integration-impact\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/generation-bound-query-cursors-integration\",\n      \"rationale\": \"Handlers integrate the domain cursor helper, generation-reader status and shared schema. The strict surface check passed with one delivery target and zero findings.\"\n    },\n    {\n      \"id\": \"backend-observability\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/generation-bound-query-cursors-integration\",\n      \"rationale\": \"Pages disclose generation status, reason, diverged files, collection, position, total and full-scan cost. Cursor refusals provide bounded codes and restart guidance without exposing signing material.\"\n    },\n    {\n      \"id\": \"compatibility\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/generation-bound-query-cursors-integration\",\n      \"rationale\": \"The token migration is explicit. Calls omitting pagination remain unpaginated; continuations are bounded. The CLI has no cursor-paginated surface requiring migration.\"\n    },\n    {\n      \"id\": \"correctness\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"integration:pose-mcp/go/generation-bound-query-cursors-integration\",\n      \"rationale\": \"Independent focused and race-enabled tests passed, as did go vet. Collection mutation, query binding, generation metadata, limits and token failures have relevant coverage; sealed build and unit evidence also pass.\"\n    },\n    {\n      \"id\": \"design-causality\",\n      \"disposition\": \"passed\",\n      \"evidence\": \"structure:design-484c6eb6d942f499\",\n      \"rationale\": \"Binding the signed cursor to the ordered collection and query removes the cause of silent offset drift. Recomputing and refusing changed collections implements the selected restart strategy without snapshot retention.\",\n      \"mappings\": [\n        {\n          \"delta\": \"SD-5c6c5a14\",\n          \"basis\": \"D1\",\n          \"disposition\": \"mapped\",\n","exit_code":0,"status":"completed"}}
