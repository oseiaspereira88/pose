{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'func Test.*Canonical|func Test.*(Validation.*Publish|Publish.*Validation)|ExpectAny|canonical.*(concurr|atomic)' pose-mcp/internal/cli/*test.go | head -40; sed -n '1438,1500p' pose-mcp/internal/cli/validate.go; sed -n '1554,1600p' pose-mcp/internal/cli/validate.go; cat pose-mcp/internal/pose/delivery_validation_run.go; cat pose-mcp/internal/pose/delivery_validation_run_test.go; sed -n '615,675p' pose-mcp/internal/pose/delivery_surface.go; sed -n '1,125p' pose-mcp/internal/pose/material_binding.go\"","aggregated_output":"pose-mcp/internal/cli/suggest_review_regression_test.go:347:func TestSuggestAndTheCheckerRefuseANonCanonicalSpellingOfAnOperationalField(t *testing.T) {\npose-mcp/internal/cli/publicclaims_test.go:113:func TestPublicClaimsFailsOnSchemaOrgVersionAndNonCanonicalDocs(t *testing.T) {\npose-mcp/internal/cli/validate_results_test.go:252:func TestGovernanceWriteGuardValidateCanonicalResultRefusesBeforePublish(t *testing.T) {\npose-mcp/internal/cli/validate_results_test.go:283:func TestValidateCanonicalResultReportsPublishedWhenDurabilityIsUnconfirmed(t *testing.T) {\npose-mcp/internal/cli/multirepo_agent_flow_test.go:262:func TestMultiRepoAgentNegativeTransferBlocksUntilCanonicalAuthorityIsActive(t *testing.T) {\n\tsteps.Summary()\n\tif executed == 0 && run.Counts.Carried == 0 {\n\t\tfmt.Fprintln(stdout, \"No modules/checks matched the matrix and filters.\")\n\t}\n\tresult := \"pass\"\n\tif cancelled {\n\t\tfailures++\n\t\tresult = \"fail\"\n\t\tr.Verdict(cliout.Verdict{State: cliout.StateFail, Text: cliText(locale, \"validation cancelled\", \"validação cancelada\")})\n\t} else if failures > 0 {\n\t\tresult = \"fail\"\n\t\tr.Verdict(cliout.Verdict{State: cliout.StateFail, Text: cliText(locale, \"required check failed\", \"check obrigatório falhou\")})\n\t} else {\n\t\tif optionalFailures > 0 {\n\t\t\tresult = \"partial\"\n\t\t\tr.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"optional-check\",\n\t\t\t\tMessage: fmt.Sprintf(cliText(locale, \"%d optional check(s) failed\", \"%d check(s) opcional(is) falharam\"), optionalFailures)})\n\t\t}\n\t\tr.Verdict(cliout.Verdict{State: cliout.StatePass})\n\t}\n\trun.Outcome = result\n\tusageFindings := make([]usageFinding, 0, run.Counts.Failed+run.Counts.OptionalFailed+run.Counts.Errored)\n\tfor _, check := range run.Checks {\n\t\tif check.Outcome != \"fail\" && check.Outcome != \"error\" {\n\t\t\tcontinue\n\t\t}\n\t\tseverity := check.Severity\n\t\tif check.Outcome == \"error\" {\n\t\t\tseverity = \"error\"\n\t\t}\n\t\tusageFindings = append(usageFindings, usageFinding{ID: check.ID, Severity: severity})\n\t}\n\tnoteUsageFindings(stdout, result, usageFindings, true)\n\tfor name, writer := range map[string]struct {\n\t\tpath  string\n\t\twrite func(string, validationRunResult) error\n\t}{\n\t\t\"json\":  {jsonOut, writeValidationJSON},\n\t\t\"junit\": {junitOut, writeValidationJUnit},\n\t\t\"sarif\": {sarifOut, writeValidationSARIF},\n\t} {\n\t\tif writer.path == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\ttarget := filepath.Join(root, filepath.FromSlash(writer.path))\n\t\tif name == \"json\" && canonicalResultsPath != \"\" && normalizeValidationOutputPath(writer.path) == canonicalResultsPath {\n\t\t\terr := publishCanonicalValidationJSONIn(store, writer.path, canonicalResultsPath, run)\n\t\t\tif err != nil {\n\t\t\t\tif errors.Is(err, posemodel.ErrPublishUnsynced) {\n\t\t\t\t\tout := render(stdout, stderr)\n\t\t\t\t\tout.ContractLine(fmt.Sprintf(\"%s: %s\", name, target))\n\t\t\t\t\tout.Finding(cliout.Finding{State: cliout.StateWarning, Code: \"validation-result-durability\",\n\t\t\t\t\t\tMessage: fmt.Sprintf(\"%s result was published but durability is unconfirmed: %v\", name, err)})\n\t\t\t\t\treturn 1\n\t\t\t\t}\n\t\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(cliText(locale, \"writing %s result: %v\", \"escrevendo resultado %s: %v\"), name, err))\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\trender(stdout, stderr).ContractLine(fmt.Sprintf(\"%s: %s\", name, target))\n\t\t\tcontinue\n\t\t}\n\t\tif err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {\n\t\t\tfmt.Fprintf(stderr, cliText(locale, \"Error: creating %s result directory: %v\\n\", \"Erro: criando diretório do resultado %s: %v\\n\"), name, err)\n// moduleValidationChecks resolves the stack and checks one module runs after\n// overrides, and whether the stack/module filters select it at all. The counting\n// pass and the executing pass share it so a filter can never mean two things\n// (spec pose-cli-output-rendering-system R6).\nfunc moduleValidationChecks(module validationModule, matrix validationMatrix, stackFilter, moduleFilter string) (string, []validationCheck, bool) {\n\toverride := matrix.ModuleOverrides[module.Rel]\n\tstack := module.Stack\n\tif override.Stack != \"\" {\n\t\tstack = override.Stack\n\t}\n\tif stackFilter != \"\" && stack != stackFilter || moduleFilter != \"\" && module.Rel != moduleFilter {\n\t\treturn stack, nil, false\n\t}\n\tchecks := append([]validationCheck(nil), matrix.Stacks[stack].Checks...)\n\tif override.ReplaceDefaultChecks {\n\t\tchecks = nil\n\t}\n\treturn stack, append(checks, override.Checks...), true\n}\n\n// tailLines keeps the last n lines of a check's captured output: enough to see\n// why it failed, with the full output one path away.\nfunc tailLines(text string, n int) string {\n\tlines := strings.Split(strings.TrimRight(text, \"\\n\"), \"\\n\")\n\tif len(lines) <= n {\n\t\treturn strings.Join(lines, \"\\n\")\n\t}\n\treturn strings.Join(lines[len(lines)-n:], \"\\n\")\n}\n\nfunc validationSummaryOf(run validationRunResult) *validationSummary {\n\tsummary := &validationSummary{Outcome: run.Outcome}\n\tfor _, check := range run.Checks {\n\t\tcommand := strings.TrimSpace(check.Program + \" \" + strings.Join(check.Args, \" \"))\n\t\tif check.Outcome != \"skipped\" && command != \"\" {\n\t\t\tsummary.Commands = append(summary.Commands, command)\n\t\t}\n\t\tline := \"- [\" + check.Outcome + \"] \" + check.ID\n\t\tswitch {\n\t\tcase check.SkipReason != \"\":\n\t\t\tline += \" (\" + check.SkipReason + \")\"\n\t\tcase check.DurationSeconds > 0:\n\t\t\tline += fmt.Sprintf(\" (%.1fs)\", check.DurationSeconds)\n\t\t}\n\t\tif check.ExitCode != nil {\n\t\t\tline += fmt.Sprintf(\" exit=%d\", *check.ExitCode)\n\t\t}\npackage pose\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"sort\"\n)\n\n// DeliveryValidationResultSchema is the schema of the structured result of `pose validate`.\nconst DeliveryValidationResultSchema = 1\n\n// ParseDeliveryValidationRun reads the structured result of a validation run into the results\n// the delivery index holds: one per check that declares an evidence class, with the run's head,\n// time, provenance and scope provenance. relative is the path the results were read from. It is\n// the one reading of that file: the index is built with it and checked against it.\nfunc ParseDeliveryValidationRun(raw []byte, relative string) ([]DeliveryValidationResult, error) {\n\tvar run struct {\n\t\tSchemaVersion      int               `json:\"schema_version\"`\n\t\tGeneratedAt        string            `json:\"generated_at\"`\n\t\tGitHead            string            `json:\"git_head,omitempty\"`\n\t\tProvenanceDigest   string            `json:\"provenance_digest,omitempty\"`\n\t\tScopeProvenance    map[string]string `json:\"scope_provenance,omitempty\"`\n\t\tMaterialProvenance map[string]string `json:\"material_provenance,omitempty\"`\n\t\tChecks             []struct {\n\t\t\tID            string `json:\"id\"`\n\t\t\tModule        string `json:\"module\"`\n\t\t\tName          string `json:\"name\"`\n\t\t\tSeverity      string `json:\"severity\"`\n\t\t\tEvidenceClass string `json:\"evidence_class,omitempty\"`\n\t\t\tOutcome       string `json:\"outcome\"`\n\t\t\t// A carried check ran at its own head (spec\n\t\t\t// pose-validate-carries-unchanged-checks R7).\n\t\t\tCarriedFrom        string `json:\"carried_from,omitempty\"`\n\t\t\tCarriedGeneratedAt string `json:\"carried_generated_at,omitempty\"`\n\t\t} `json:\"checks\"`\n\t}\n\tif err := json.Unmarshal(raw, &run); err != nil || run.SchemaVersion != DeliveryValidationResultSchema {\n\t\treturn nil, fmt.Errorf(\"invalid structured validation result\")\n\t}\n\tresults := make([]DeliveryValidationResult, 0, len(run.Checks))\n\tfor _, check := range run.Checks {\n\t\tif check.EvidenceClass == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\thead, generated := run.GitHead, run.GeneratedAt\n\t\tif check.CarriedFrom != \"\" {\n\t\t\thead, generated = check.CarriedFrom, check.CarriedGeneratedAt\n\t\t}\n\t\tresults = append(results, DeliveryValidationResult{ID: check.ID, Module: check.Module, Check: check.Name, EvidenceClass: check.EvidenceClass, Severity: check.Severity, Outcome: check.Outcome, GitHead: head, GeneratedAt: generated, ProvenanceDigest: run.ProvenanceDigest, ScopeProvenance: run.ScopeProvenance, MaterialProvenance: run.MaterialProvenance, Report: relative})\n\t}\n\tsort.Slice(results, func(i, j int) bool { return results[i].ID < results[j].ID })\n\treturn results, nil\n}\npackage pose\n\nimport \"testing\"\n\n// A carried check is read as an observation of the head it ran at (spec\n// pose-validate-carries-unchanged-checks R7); an executed one keeps the run's.\nfunc TestDeliveryValidationRunReadsTheCarriedHead(t *testing.T) {\n\traw := []byte(`{\"schema_version\":1,\"generated_at\":\"2026-11-22T10:00:00Z\",\"git_head\":\"bbbb\",\"checks\":[` +\n\t\t`{\"id\":\"a/go/ok\",\"module\":\"a\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\"},` +\n\t\t`{\"id\":\"b/go/ok\",\"module\":\"b\",\"name\":\"ok\",\"severity\":\"required\",\"evidence_class\":\"unit\",\"outcome\":\"pass\",\"carried_from\":\"aaaa\",\"carried_generated_at\":\"2026-11-21T09:00:00Z\"}]}`)\n\tresults, err := ParseDeliveryValidationRun(raw, \".pose/results/delivery-validation.json\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(results) != 2 {\n\t\tt.Fatalf(\"results = %+v\", results)\n\t}\n\tfor _, r := range results {\n\t\tswitch r.ID {\n\t\tcase \"a/go/ok\":\n\t\t\tif r.GitHead != \"bbbb\" || r.GeneratedAt != \"2026-11-22T10:00:00Z\" {\n\t\t\t\tt.Fatalf(\"executed check read as %s at %s\", r.GitHead, r.GeneratedAt)\n\t\t\t}\n\t\tcase \"b/go/ok\":\n\t\t\tif r.GitHead != \"aaaa\" || r.GeneratedAt != \"2026-11-21T09:00:00Z\" {\n\t\t\t\tt.Fatalf(\"carried check read as %s at %s, want the head it ran at\", r.GitHead, r.GeneratedAt)\n\t\t\t}\n\t\t}\n\t}\n}\n\tsort.Slice(sets, func(i, j int) bool { return sets[i].ID < sets[j].ID })\n\traw, _ := json.Marshal(struct {\n\t\tClaims []ArtifactClaim `json:\"claims\"`\n\t\tSets   []ChangeSet     `json:\"change_sets\"`\n\t}{claims, withoutMaterialDigest(sets)})\n\tsum := sha256.Sum256(raw)\n\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n}\n\nfunc deliveryEvidenceCurrent(result DeliveryValidationResult, spec, status string, graph DeliveryIntegrityGraph, sets []ChangeSet) bool {\n\tif bound := result.MaterialProvenance[spec]; bound != \"\" {\n\t\t// A material binding governs: a mismatch is stale, never a fall-through\n\t\t// to the commit-bound rules below. Only a closed spec keeps its exemption.\n\t\tif bound == ScopedMaterialDigest(graph, spec) {\n\t\t\treturn true\n\t\t}\n\t\treturn status == \"done\" && result.GeneratedAt != \"\"\n\t}\n\tif scoped := result.ScopeProvenance[spec]; scoped != \"\" {\n\t\tif scoped == ScopedDeliveryProvenanceDigest(graph, spec) {\n\t\t\treturn true\n\t\t}\n\t\tif status == \"done\" && result.GeneratedAt != \"\" {\n\t\t\treturn true\n\t\t}\n\t\treturn false\n\t}\n\tif result.ProvenanceDigest != \"\" && result.ProvenanceDigest == graph.ProvenanceDigest {\n\t\treturn true\n\t}\n\t// Results emitted before scope_provenance existed were module-wide. Preserve\n\t// them only for already-closed historical specs: their immutable closeout\n\t// cannot retroactively acquire the new field, and unrelated later targets\n\t// must not invalidate them. Open/current scopes never receive this bridge.\n\tif status == \"done\" && result.ProvenanceDigest != \"\" && result.GeneratedAt != \"\" {\n\t\treturn true\n\t}\n\tif result.GitHead == \"\" {\n\t\treturn false\n\t}\n\tfor _, set := range sets {\n\t\tif result.GitHead == set.Head || result.GitHead == set.ResolvedHead {\n\t\t\treturn true\n\t\t}\n\t\tfor _, commit := range set.Commits {\n\t\t\tif result.GitHead == commit {\n\t\t\t\treturn true\n\t\t\t}\n\t\t}\n\t}\n\treturn false\n}\n\nfunc finalizeExtendedDeliveryGraph(graph *DeliveryIntegrityGraph) {\n\tsort.Slice(graph.Nodes, func(i, j int) bool { return graph.Nodes[i].ID < graph.Nodes[j].ID })\n\tsort.Slice(graph.Edges, func(i, j int) bool { return edgeLess(graph.Edges[i], graph.Edges[j]) })\n\tgraph.Edges = dedupeSortedEdges(graph.Edges)\n\tsort.Slice(graph.Findings, func(i, j int) bool { return graph.Findings[i].ID < graph.Findings[j].ID })\n\tsort.Slice(graph.Deliveries, func(i, j int) bool { return graph.Deliveries[i].Ref < graph.Deliveries[j].Ref })\n\tsort.Slice(graph.ValidationResults, func(i, j int) bool { return graph.ValidationResults[i].ID < graph.ValidationResults[j].ID })\n\tsort.Slice(graph.RoadmapCriteria, func(i, j int) bool {\npackage pose\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// Validation evidence binds to the material it validated (spec\n// pose-validation-evidence-material-binding, ADR\n// validation-evidence-binds-to-validated-material). A commit whose every\n// changed path is a derived administrative record does not change what the\n// checks exercised, so it does not move the material digest.\n\n// engineVersion is the running engine, registered by the binaries (internal/pose\n// stays importable on its own). It is part of every material digest, so a new\n// engine never inherits evidence the previous one produced.\nvar engineVersion = \"unregistered\"\n\n// SetEngineVersion registers the running engine for material digests.\nfunc SetEngineVersion(v string) { engineVersion = v }\n\n// administrativeDirs is the closed list of derived-record directories. It is\n// owned by the engine; adding a class is a contract change that needs an ADR.\nvar administrativeDirs = []string{\".pose/indexes/\", \".pose/results/\", \".pose/state/\", \".pose/assessments/\"}\n\n// materialIndexes are files inside an administrative directory that still\n// change what the checks demand.\nvar materialIndexes = map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\n// IsAdministrativePath reports whether p is a derived administrative record.\nfunc IsAdministrativePath(p string) bool {\n\tif p == \"\" || p != path.Clean(p) || strings.HasPrefix(p, \"/\") || strings.HasPrefix(p, \"../\") {\n\t\treturn false\n\t}\n\tif materialIndexes[p] {\n\t\treturn false\n\t}\n\tif !recordExtensions[strings.ToLower(path.Ext(p))] {\n\t\treturn false\n\t}\n\tfor _, dir := range administrativeDirs {\n\t\tif strings.HasPrefix(p, dir) {\n\t\t\treturn true\n\t\t}\n\t}\n\tif rest, ok := strings.CutPrefix(p, \".pose/\"); ok {\n\t\tif i := strings.Index(rest, \"/\"); i > 0 && strings.HasPrefix(rest[:i], \"review-\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// recordExtensions are the data formats a derived record is written in. Code or\n// a script stored in a class is material: that keeps a source file moved or\n// copied into a class from hiding its later edits. A copied data file stays\n// indistinguishable from a record; a check that reads data out of a derived-record\n// directory is outside this contract (ADR validation-evidence-binds-to-validated-material).\nvar recordExtensions = map[string]bool{\".json\": true, \".jsonl\": true, \".ndjson\": true, \".md\": true, \".txt\": true, \".log\": true, \".transcript\": true}\n\n// TreeEntry is one entry of the validated head's tree.\ntype TreeEntry struct{ Mode, Blob string }\n\nfunc regularMode(mode string) bool { return mode == \"100644\" || mode == \"100755\" }\n\n// MaterialInputs are what a material digest is computed from: the paths a change\n// set names (both sides of a rename, and the validation matrix) and the\n// destinations of renames. They are stored with the set so the digest can be\n// recomputed against the current tree without the commits' own records.\ntype MaterialInputs struct {\n\tNames []string `json:\"names\"`\n\tMoved []string `json:\"moved,omitempty\"`\n}\n\n// MaterialInputsOf derives the inputs from per-commit path records. They must\n// be unmerged: folding a create and a later rename into one creation would hide\n// that the file moved into a class.\nfunc MaterialInputsOf(paths []ObservedPath) MaterialInputs {\n\tnames := map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n\tmoved := map[string]bool{}\n\tfor _, p := range paths {\n\t\tfor _, name := range []string{p.Path, p.OldPath, p.NewPath} {\n\t\t\tif name != \"\" {\n\t\t\t\tnames[name] = true\n\t\t\t}\n\t\t}\n\t\t// A rename destination is material whatever directory it lands in:\n\t\t// otherwise moving a source file into a class would hide its later edits.\n\t\tif p.OldPath != \"\" && p.NewPath != \"\" {\n\t\t\tmoved[p.NewPath] = true\n\t\t}\n\t}\n\tin := MaterialInputs{}\n\tfor name := range names {\n\t\tin.Names = append(in.Names, name)\n\t}\n\tfor name := range moved {\n\t\tin.Moved = append(in.Moved, name)\n\t}\n\tsort.Strings(in.Names)\n\tsort.Strings(in.Moved)\n\treturn in\n}\n\n// MaterialSetDigest digests the head state of the material a change set\n// touched: every path it names (both sides of a rename) with its mode and blob\n// at the validated head, minus the paths that are administrative records and\n// still regular files there, plus the validation matrix. A symlink, submodule\n// or directory in an administrative class is material; so is a path that left\n// a class. tree maps each named path (and the matrix) to its entry; a path\n// absent from the head tree is \"absent\".\nfunc MaterialSetDigest(in MaterialInputs, tree map[string]TreeEntry) string {\n\tmoved := map[string]bool{}\n\tfor _, name := range in.Moved {\n\t\tmoved[name] = true\n\t}\n\tsorted := in.Names\n\th := sha256.New()\n\tfor _, name := range sorted {\n\t\tentry, present := tree[name]\n","exit_code":0,"status":"completed"}}
