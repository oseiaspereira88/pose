{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1,55p' pose-mcp/internal/cli/review_closeout.go; cat pose-mcp/internal/pose/governance_scoped_write.go | head -95; sed -n '125,215p' pose-mcp/internal/pose/governance_write_guard.go; git status --short\"","aggregated_output":"package cli\n\nimport (\n\t\"bytes\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net/url\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"sort\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/harne8/pose-mcp/internal/cli/cliout\"\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nfunc cliGovernedStore(root string) posemodel.Store {\n\tstore := posemodel.Store{Root: root}\n\tresolver, project, err := posemodel.EnvironmentArtifactResolver(root, \"\")\n\tif err != nil {\n\t\tstore.FederatedResolver = &posemodel.ArtifactResolver{}\n\t\treturn store\n\t}\n\tstore.FederatedProjectID = project\n\tstore.FederatedResolver = &resolver\n\treturn store\n}\n\n// cliReviewStore keeps the authority resolver selected from the caller's root.\n// Reconstructing it at a foreign root would apply the caller's default project\n// identity to that root and lose the authorized federation context.\nfunc cliReviewStore(root, ref string) (posemodel.Store, string, error) {\n\tcontext, resolver, _, err := cliAgentContext(root, ref)\n\tqualified := strings.HasPrefix(ref, \"xref:\")\n\tif err != nil {\n\t\tif qualified {\n\t\t\treturn posemodel.Store{}, \"\", err\n\t\t}\n\t\treturn cliGovernedStore(root), ref, nil\n\t}\n\tif context.TaskResolution != nil && context.TaskResolution.State == \"transfer-in-progress\" {\n\t\treturn posemodel.Store{}, \"\", fmt.Errorf(\"transfer-in-progress\")\n\t}\n\tif context.TaskResolution == nil || !context.TaskResolution.Resolved || context.Authority == nil {\n\t\tif qualified {\n\t\t\tstate := \"unknown-artifact\"\n\t\t\tif context.TaskResolution != nil {\n\t\t\t\tstate = context.TaskResolution.State\n\t\t\t}\npackage pose\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"sort\"\n)\n\n// WithGovernanceWriteGuardForProjects runs a domain writer under the exact\n// previously discovered project set. The callback receives a fresh Store with\n// an operation-local resolver bound to those guarded roots; callers must\n// recompute their material set under the guard and refuse any expansion.\n// Foreign projects must have explicit RootsConfig bindings. Resolver read\n// authorization and directory discovery do not grant write coordination.\nfunc (s Store) WithGovernanceWriteGuardForProjects(operation string, projectIDs []string, callback func(Store) error) error {\n\treturn s.withExplicitGovernanceWriteGuard(operation, projectIDs, callback)\n}\n\n// withExplicitGovernanceWriteGuard locks the local project and the exact set\n// of foreign projects already discovered from the operation's material. A\n// foreign root is eligible only when RootsConfig binds it explicitly; read\n// discovery and ArtifactResolver.Authorize are not write coordination grants.\n// The callback receives a fresh Store whose resolver is rebound to the guarded\n// Stores and cannot resolve a project outside this set.\nfunc (s Store) withExplicitGovernanceWriteGuard(operation string, projects []string, callback func(Store) error) error {\n\tif callback == nil {\n\t\treturn governanceGuardError(ErrGovernanceWriteGuardInvalid, operation, \"\", errors.New(\"callback is required\"))\n\t}\n\tlocalID := s.FederatedProjectID\n\tif localID == \"\" {\n\t\tvar err error\n\t\tlocalID, err = s.WriteProjectID()\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif ValidateSlug(localID) != nil {\n\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, \"\", errors.New(\"local project identity is unavailable\"))\n\t}\n\n\tselected := map[string]bool{localID: true}\n\tfor _, id := range projects {\n\t\tif ValidateSlug(id) != nil {\n\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, \"\", errors.New(\"invalid project identity in material set\"))\n\t\t}\n\t\tselected[id] = true\n\t}\n\tids := make([]string, 0, len(selected))\n\tfor id := range selected {\n\t\tids = append(ids, id)\n\t}\n\tsort.Strings(ids)\n\n\tresolver := ArtifactResolver{}\n\tif s.FederatedResolver != nil {\n\t\tresolver = *s.FederatedResolver\n\t} else if len(ids) > 1 {\n\t\tvar err error\n\t\tresolver, _, err = EnvironmentArtifactResolverIn(s.fsys(), s.Root, \"\")\n\t\tif err != nil {\n\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, \"\", err)\n\t\t}\n\t}\n\tif len(ids) > 1 && resolver.Roots == nil {\n\t\treturn governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, \"\", errors.New(\"federated roots are unavailable\"))\n\t}\n\n\tstores := make([]Store, 0, len(ids))\n\tcanonical := make(map[string]string, len(ids))\n\tfor _, id := range ids {\n\t\tstore := s\n\t\tif id != localID {\n\t\t\tconfigured := resolver.Roots.cfg.Explicit[id]\n\t\t\tif configured == \"\" {\n\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, id, errors.New(\"foreign writes require an explicit project root\"))\n\t\t\t}\n\t\t\tvar err error\n\t\t\tstore, err = resolver.Roots.StoreFor(id)\n\t\t\tif err != nil {\n\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, id, err)\n\t\t\t}\n\t\t\twant, err := canonicalGovernanceRoot(configured)\n\t\t\tif err != nil {\n\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, id, err)\n\t\t\t}\n\t\t\tgot, err := canonicalGovernanceRoot(store.Root)\n\t\t\tif err != nil || governanceRootKey(got) != governanceRootKey(want) {\n\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, id, err)\n\t\t\t}\n\t\t}\n\t\tstore.FederatedProjectID = id\n\t\troot, err := canonicalGovernanceRoot(store.Root)\n\t\tif err != nil {\n\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardUnavailable, operation, id, err)\n\t\t}\n\n// WithGovernanceWriteGuard acquires one non-waiting root guard for every\n// already-authorized Store, in canonical root order, then invokes callback\n// with copies that carry the lease through Files. It never discovers or\n// authorizes roots. The guard uses the stable B14 transfer lock path and must\n// be acquired before resource locks. A preview stages through PreviewFiles\n// without creating lock directories or files.\nfunc WithGovernanceWriteGuard(operation string, roots []Store, callback func([]Store) error) error {\n\tif callback == nil || strings.TrimSpace(operation) == \"\" || len(operation) > 96 || strings.ContainsAny(operation, \"\\r\\n\\x00\") {\n\t\treturn governanceGuardError(ErrGovernanceWriteGuardInvalid, operation, \"\", errors.New(\"operation and callback are required\"))\n\t}\n\tif len(roots) == 0 {\n\t\treturn governanceGuardError(ErrGovernanceWriteGuardInvalid, operation, \"\", errors.New(\"no authorized roots were supplied\"))\n\t}\n\tfreshRoots := make([]Store, len(roots))\n\tfor i, store := range roots {\n\t\tif lease, present := store.governanceWriteGuardInFiles(); present {\n\t\t\tif lease == nil || !lease.Active() {\n\t\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardReleased, operation, \"\", nil)\n\t\t\t}\n\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardReentrant, operation, \"\", errors.New(\"pass the existing lease through Store/Files instead of reacquiring it\"))\n\t\t}\n\t\tfreshRoots[i] = store.withoutGovernanceReadView()\n\t}\n\troots = freshRoots\n\n\tbindings, storeKeys, preview, err := prepareGovernanceGuardRoots(roots, operation)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif len(bindings) > MaxGovernanceWriteRoots {\n\t\treturn governanceGuardError(ErrGovernanceWriteGuardTooManyRoots, operation, \"\", fmt.Errorf(\"got %d unique roots; maximum is %d\", len(bindings), MaxGovernanceWriteRoots))\n\t}\n\n\tlease := &GovernanceWriteLease{operation: operation, roots: bindings, byKey: make(map[string]governanceGuardRoot, len(bindings)), preview: preview}\n\tfor _, binding := range bindings {\n\t\tlease.byKey[binding.key] = binding\n\t}\n\tif !preview {\n\t\trelease, lockErr := acquireGovernanceRootLocks(bindings, operation)\n\t\tif lockErr != nil {\n\t\t\treturn lockErr\n\t\t}\n\t\tlease.release = release\n\t}\n\tlease.active.Store(true)\n\tdefer lease.Release()\n\n\tguarded := make([]Store, len(roots))\n\tfor i, store := range roots {\n\t\tbinding, ok := lease.byKey[storeKeys[i]]\n\t\tif !ok || binding.projectID != store.FederatedProjectID {\n\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, \"\", errors.New(\"root binding changed during guard preparation\"))\n\t\t}\n\t\t// Bind both Files path checks and Store path construction to the same\n\t\t// physical root. Keeping a symlink spelling in Store.Root would make\n\t\t// legitimate writes appear outside the canonical root.\n\t\tstore.Root = binding.path\n\t\tstore.FS = &governanceGuardFiles{Files: store.fsys(), lease: lease, root: binding.path, projectID: binding.projectID}\n\t\tguarded[i] = store\n\t}\n\treturn callback(guarded)\n}\n\n// GovernanceWriteLease retrieves the explicit lease from a Store's Files\n// chain. Optional UnderlyingFiles wrappers are followed with a depth and\n// cycle bound, so a read-only view can carry but cannot manufacture a lease.\nfunc (s Store) GovernanceWriteLease() (*GovernanceWriteLease, bool) {\n\tlease, present := s.governanceWriteGuardInFiles()\n\tif !present || !lease.Active() || !lease.Covers(s) {\n\t\treturn nil, false\n\t}\n\treturn lease, true\n}\n\n// withGovernanceWriteGuard runs an effectful operation under the explicit\n// per-root lease. Callers may compose guarded operations by carrying the Store\n// received in their callback; a released or misbound lease is a refusal.\nfunc (s Store) withGovernanceWriteGuard(operation string, callback func(Store) error) error {\n\tif callback == nil {\n\t\treturn governanceGuardError(ErrGovernanceWriteGuardInvalid, operation, \"\", errors.New(\"callback is required\"))\n\t}\n\tif lease, present := s.governanceWriteGuardInFiles(); present {\n\t\tif lease == nil || !lease.Active() {\n\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardReleased, operation, \"\", nil)\n\t\t}\n\t\tif !lease.Covers(s) {\n\t\t\treturn governanceGuardError(ErrGovernanceWriteGuardRootBinding, operation, \"\", nil)\n\t\t}\n\t\t// Reuse the explicit lease, but never let an earlier read-only\n\t\t// operation view authorize a fresh effect evaluation. Unwrap that\n","exit_code":0,"status":"completed"}}
