bers(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:226:func TestCloseoutReviewPolicyAssociations(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:295:func TestCloseoutReviewPolicyProtection(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:366:func TestCloseoutReviewPolicyVeto(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:387:func TestCloseoutReviewPolicyReceipt(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:447:func TestCloseoutReviewPolicyHistory(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:475:func TestCloseoutReviewPolicyUnavailable(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:508:func TestCloseoutReviewPolicyFederation(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:535:func TestCloseoutReviewPolicyReceiptIntegrity(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:575:func TestCloseoutReviewPolicyInterruptedRoadmapClose(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:605:func TestCloseoutReviewPolicyFederatedReceiptProof(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:647:func TestCloseoutReviewPolicyStatusAloneIsNotHistory(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:661:func TestCloseoutReviewPolicyRoundTwo(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:746:func TestCloseoutReviewPolicyRoundThree(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:834:func TestCloseoutReviewPolicyRoundFour(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:880:func TestCloseoutReviewPolicyRoundFive(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:1000:func TestCloseoutReviewPolicyRoundSix(t *testing.T) {\npose-mcp/internal/pose/closeout_review_policy_test.go:1058:\t\t// Historical by its own recorded approval, not by the legacy\npose-mcp/internal/pose/closeout_review_policy_test.go:1070:\t\tif !s.closeoutScopeHistorical(ScopeRef{Kind: \"roadmap\", Slug: \"program\"}) {\n","exit_code":0,"status":"completed"}}
