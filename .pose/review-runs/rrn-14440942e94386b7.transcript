{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '1900,2150p' pose-mcp/internal/cli/review_closeout.go\"","aggregated_output":"}\n\nfunc cmdCloseLocalWithGuardedStore(root string, store posemodel.Store, ref string, guard func() error, stdout, stderr io.Writer, transitioned func(unsynced error)) int {\n\t// The gates below judge the artifact as it is now; the transition is\n\t// published only over those same bytes (spec\n\t// pose-writer-coordination-and-atomic-publication R4).\n\tjudged := closeTargetDigest(root, store, ref)\n\tstate, err := cliCloseoutStateForStore(store, ref)\n\tif err != nil {\n\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\treturn 1\n\t}\n\t// Repeating close on an already-done spec is a readonly terminal check,\n\t// bounded by the same historical contract as closeout-check and the plan.\n\tif scope, parseErr := posemodel.ParseScopeRef(ref); parseErr == nil && scope.Kind == \"spec\" && state.LifecycleDone {\n\t\tif !state.Terminal {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n\t\t\treturn 1\n\t\t}\n\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; applicable terminal verifier passed; no transition executed\")\n\t\treturn 0\n\t}\n\t// Governed effects (spec pose-governed-effect-enforcement): this is the\n\t// write point of the closeout transition, so an adopted, unsatisfied\n\t// action request restricting closeout refuses here with its typed cause,\n\t// whatever else the scope's review says.\n\tgoverned := []string{}\n\tfor _, d := range state.Diagnostics {\n\t\tif d.Code == \"action-request-pending\" {\n\t\t\tgoverned = append(governed, d.Message)\n\t\t}\n\t}\n\t// A current adjudication that says a question does not hold refuses the\n\t// closeout (spec pose-delegated-verdict-destinations R1).\n\tadjudicated := []string{}\n\tfor _, d := range state.Diagnostics {\n\t\tif d.Code == posemodel.AdjudicationDoesNotHoldCode {\n\t\t\tadjudicated = append(adjudicated, d.Message)\n\t\t}\n\t}\n\tif len(adjudicated) > 0 {\n\t\tout := render(stdout, stderr)\n\t\tfor _, message := range adjudicated {\n\t\t\tout.Field(\"close.refused.adjudication\", message)\n\t\t}\n\t\tout.Failure(fmt.Sprintf(\"pose close: %d adjudicated question(s) of %s do not hold\", len(adjudicated), ref))\n\t\treturn 1\n\t}\n\tif len(governed) > 0 {\n\t\tout := render(stdout, stderr)\n\t\tfor _, message := range governed {\n\t\t\tout.Field(\"close.refused.action-request-pending\", message)\n\t\t}\n\t\tout.Failure(fmt.Sprintf(\"pose close: %d action request(s) restrict closeout of %s\", len(governed), ref))\n\t\treturn 1\n\t}\n\tscope, _ := posemodel.ParseScopeRef(ref)\n\t// Under an adopted closeout review policy (spec\n\t// pose-closeout-review-policy-by-cost-benefit) the close of a milestone or a\n\t// roadmap publishes a receipt. A receipt already there makes the close a\n\t// read-only verification; a scope the evaluator cannot decide is refused.\n\treceiptClose, code := closeoutReceiptPreflight(store, ref, scope, &state, stdout, stderr)\n\tif code >= 0 {\n\t\treturn code\n\t}\n\tif !closeReviewSatisfied(state) || len(state.Children) > 0 && hasOpenChild(state.Children) {\n\t\tfmt.Fprintf(stderr, \"pose close: scope is not eligible; next action: %s\\n\", state.NextAction)\n\t\treturn 1\n\t}\n\tif scope.Kind == \"milestone\" {\n\t\tgate, err := roadmapGate(root, scope.Roadmap, scope.Milestone)\n\t\tif err != nil {\n\t\t\trender(stdout, stderr).Failure(\"pose close: milestone gate failed: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tif blockers := uniqueCLIStrings(gate.blockers); len(blockers) > 0 {\n\t\t\trender(stdout, stderr).Failure(\"pose close: milestone gate failed: \" + strings.Join(blockers, \"; \"))\n\t\t\treturn 1\n\t\t}\n\t\tlabel := \"Milestone closeout verified\"\n\t\tif receiptClose != nil {\n\t\t\tjudgedState, code := verifyCloseoutPublication(store, ref, *receiptClose, guard, stderr)\n\t\t\tif code != 0 {\n\t\t\t\treturn code\n\t\t\t}\n\t\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, judgedState, stdout, stderr); code != 0 {\n\t\t\t\treturn code\n\t\t\t}\n\t\t\tlabel = \"Closed\"\n\t\t}\n\t\tfmt.Fprintf(stdout, \"%s: %s\\n\", label, ref)\n\t\trenderCloseNext(render(stdout, stderr), nextCloses(store, ref))\n\t\treturn 0\n\t}\n\tvar path string\n\tif scope.Kind == \"spec\" {\n\t\tsp, err := store.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tif policy, err := posemodel.LoadArtifactPolicyIn(store.FS, root); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\t\treturn 1\n\t\t} else if policy.Enabled && sp.CreatedAt >= policy.AdoptedAt {\n\t\t\tclaims, found, err := posemodel.ParseArtifactClaims(*sp, policy)\n\t\t\tif err != nil || !found || len(claims) == 0 {\n\t\t\t\tfmt.Fprintf(stderr, \"pose close: artifact declaration gate failed: %v\\n\", err)\n\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n\t\t\t\treturn 1\n\t\t\t}\n\t\t}\n\t\tif policy, err := posemodel.LoadDeliveryPolicyIn(store.FS, root); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\t\treturn 1\n\t\t} else if policy.Enabled && sp.CreatedAt >= policy.AdoptedAt {\n\t\t\tif graph, graphErr := buildCurrentDeliveryGraphIn(store.FS, root); graphErr != nil {\n\t\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(\"pose close: delivery assurance gate failed: %s\", graphErr))\n\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n\t\t\t\treturn 1\n\t\t\t} else if blockers := deliverySpecBlockersFromGraph(graph, sp.Slug); len(blockers) > 0 {\n\t\t\t\tfmt.Fprintf(stderr, \"pose close: delivery assurance gate failed: %s\\n\", strings.Join(blockers, \"; \"))\n\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n\t\t\t\treturn 1\n\t\t\t}\n\t\t}\n\t\tif _, findings, err := store.InspectAmendmentHistory(*sp); err != nil || len(findings) > 0 {\n\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(\"pose close: amendment history gate failed: %v %s\", err, strings.Join(findings, \"; \")))\n\t\t\treturn 1\n\t\t}\n\t\t// The exit gate of a spec is its requirement trace: closing marks it\n\t\t// done, and a done spec whose promises point at no evidence fails\n\t\t// lint. Refusing here keeps `pose close` from producing what the\n\t\t// next lint rejects (spec pose-quickstart-real-lifecycle).\n\t\tif raw, err := store.FS.ReadFile(sp.Path); err == nil {\n\t\t\tif blockers := posemodel.RequirementTraceCloseoutBlockers(string(raw)); len(blockers) > 0 {\n\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate failed: \" + strings.Join(blockers, \"; \") + \" — declare each under `### Requirement trace`, e.g. `- R1 [satisfied] test:<TestName>`, or [waived: <reason>] / [withdrawn: <reason>]\")\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\t// A test: ref must name a test that exists, or the trace points a\n\t\t\t// promise at nothing (spec pose-trace-test-refs-resolve).\n\t\t\tcatalog, catalogErr := posemodel.LoadTestCatalogChecked(root)\n\t\t\tif catalogErr != nil {\n\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate incomplete: \" + catalogErr.Error())\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\tif unresolved := posemodel.UnresolvedTestRefs(posemodel.ParseRequirementTrace(string(raw)), catalog); len(unresolved) > 0 {\n\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate failed: \" + strings.Join(unresolved, \"; \") + \" names no test in this repository or its submodules — cite the test function, subtest, test title or test file\")\n\t\t\t\treturn 1\n\t\t\t}\n\t\t}\n\t\tpath = sp.Path\n\t} else {\n\t\tvar gateOut, gateErr bytes.Buffer\n\t\tif code := cmdRoadmapCheck(root, []string{scope.Slug, \"--strict\"}, &gateOut, &gateErr); code != 0 {\n\t\t\tfmt.Fprintf(stderr, \"pose close: roadmap gate failed: %s%s\", gateErr.String(), gateOut.String())\n\t\t\treturn 1\n\t\t}\n\t\tpath = filepath.Join(root, \".pose\", \"roadmaps\", scope.Slug+\".md\")\n\t}\n\tif closeGatesJudged != nil {\n\t\tcloseGatesJudged()\n\t}\n\t// Start, close and transfer of a spec share its lifecycle lock (R3).\n\tif scope.Kind == \"spec\" {\n\t\tunlock, err := posemodel.LockSpecLifecycle(root, scope.Slug, \"close.transition\")\n\t\tif err != nil {\n\t\t\tvar held *posemodel.StartLockError\n\t\t\tif errors.As(err, &held) {\n\t\t\t\trenderStartLock(render(stdout, stderr), scope.Slug, held)\n\t\t\t}\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tdefer unlock()\n\t}\n\t// The authorization is judged again inside the protected region: a\n\t// review that stopped being approved, or an action request that now\n\t// restricts closeout, while the gates ran does not govern this\n\t// publication (spec pose-writer-coordination-and-atomic-publication R4).\n\tif current, err := cliCloseoutStateForStore(store, ref); err != nil {\n\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\treturn 1\n\t} else if !(closeReviewSatisfied(current) || receiptClose != nil && !receiptClose.Required) || hasActionRequestPending(current.Diagnostics) || hasDiagnostic(current.Diagnostics, posemodel.AdjudicationDoesNotHoldCode) {\n\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout authorization changed while its gates ran; next action: \" + current.NextAction)\n\t\treturn 1\n\t}\n\tif guard != nil {\n\t\tif err := guard(); err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t}\n\tif scope.Kind == \"spec\" {\n\t\tsp, err := store.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tif _, findings, err := store.InspectAmendmentHistory(*sp); err != nil || len(findings) > 0 {\n\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(\"pose close: amendment history gate failed: %v %s\", err, strings.Join(findings, \"; \")))\n\t\t\treturn 1\n\t\t}\n\t}\n\tvar receiptState posemodel.CloseoutState\n\tif receiptClose != nil {\n\t\t// Judged before the status is published: afterwards the index no\n\t\t// longer matches the tree until it is regenerated.\n\t\tjudgedState, code := verifyCloseoutPublication(store, ref, *receiptClose, nil, stderr)\n\t\tif code != 0 {\n\t\t\treturn code\n\t\t}\n\t\treceiptState = judgedState\n\t\t// The intent stands from before the status until the receipt: an\n\t\t// interruption between them reads as an incomplete close, never as\n\t\t// a roadmap closed before adoption.\n\t\tif err := store.PublishCloseoutIntent(ref, *receiptClose, time.Now()); err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: closeout intent not recorded: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t}\n\tvar unsynced error\n\tif err := applyLifecycleDoneIn(store.FS, path, scope.Kind == \"spec\", judged); err != nil {\n\t\tif errors.Is(err, posemodel.ErrPublishConflict) {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error() + \"; the gates judged other bytes, so run `pose close \" + ref + \"` again to judge the current ones\")\n\t\t\treturn 1\n\t\t}\n\t\t// The transition took effect and only its durability is unconfirmed: the\n\t\t// scope is closed, and refusing here would say otherwise.\n\t\tif !errors.Is(err, posemodel.ErrPublishUnsynced) {\n\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tunsynced = err\n\t\trender(stdout, stderr).Field(\"close.unsynced\", err.Error())\n\t}\n\tif receiptClose != nil {\n\t\t// The status is published; the receipt is the terminal marker and\n\t\t// comes after it. A failure here leaves the roadmap explicitly\n\t\t// incomplete, and the next `pose close` verifies again and publishes.\n\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, receiptState, stdout, stderr); code != 0 {\n\t\t\treturn code\n\t\t}\n\t}\n\tif transitioned != nil {\n\t\ttransitioned(unsynced)\n\t}\n\tfmt.Fprintf(stdout, \"Closed: %s\\n\", ref)\n\trenderCloseNext(render(stdout, stderr), nextCloses(store, ref))\n\treturn 0\n}\n","exit_code":0,"status":"completed"}}
