{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '2590,2940p' pose-mcp/internal/pose/review_closeout.go\"","aggregated_output":"\t\treturn true, nil\n\t}\n\tadoptedAt, err := time.Parse(time.DateOnly, policy.AdoptedAt)\n\tif err != nil {\n\t\treturn true, nil\n\t}\n\n\tvar createdAt, status string\n\tswitch scope.Kind {\n\tcase \"spec\":\n\t\tsp, err := s.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn false, err\n\t\t}\n\t\tcreatedAt, status = sp.CreatedAt, sp.Status\n\tcase \"milestone\":\n\t\trm, err := s.GetRoadmap(scope.Roadmap)\n\t\tif err != nil {\n\t\t\treturn false, err\n\t\t}\n\t\tcreatedAt, status = rm.CreatedAt, rm.Status\n\tcase \"roadmap\":\n\t\trm, err := s.GetRoadmap(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn false, err\n\t\t}\n\t\tcreatedAt, status = rm.CreatedAt, rm.Status\n\t}\n\tif status != \"done\" {\n\t\treturn true, nil\n\t}\n\tcreated, err := time.Parse(time.DateOnly, createdAt)\n\tif err != nil {\n\t\treturn true, nil\n\t}\n\treturn !created.Before(adoptedAt), nil\n}\n\nfunc validateReviewEvidenceRef(files Files, root, ref string) error {\n\tparts := strings.SplitN(strings.TrimSpace(ref), \":\", 2)\n\tif len(parts) != 2 || !slugPattern.MatchString(parts[0]) || strings.TrimSpace(parts[1]) == \"\" {\n\t\treturn fmt.Errorf(\"invalid review evidence ref %q\", ref)\n\t}\n\tif parts[0] != \"report\" {\n\t\treturn nil\n\t}\n\trel := filepath.Clean(filepath.FromSlash(parts[1]))\n\tif !filepath.IsLocal(rel) {\n\t\treturn fmt.Errorf(\"review evidence path escapes project root: %q\", ref)\n\t}\n\tif !strings.HasPrefix(filepath.ToSlash(rel), \".pose/reports/\") {\n\t\trel = filepath.Join(\".pose\", \"reports\", rel)\n\t}\n\tpath := filepath.Join(root, rel)\n\tif err := validateProjectPathIn(files, root, rel); err != nil {\n\t\treturn fmt.Errorf(\"review evidence path escapes project root: %q: %w\", ref, err)\n\t}\n\tif _, err := files.Stat(path); err != nil {\n\t\treturn fmt.Errorf(\"review evidence does not resolve: %q\", ref)\n\t}\n\treturn nil\n}\n\nfunc (s Store) GetCloseoutState(ref string) (CloseoutState, error) {\n\treturn withGovernanceReviewReadView(s, \"closeout\", func(store Store) (CloseoutState, error) {\n\t\treturn store.getCloseoutState(ref, true)\n\t}, func(state *CloseoutState, metadata *ReadViewMetadata, audit governanceReadViewAudit) {\n\t\tapplyCloseoutReadView(state, metadata, ref, audit)\n\t})\n}\n\nfunc (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutState, error) {\n\ts = s.reviewOperation()\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn CloseoutState{}, err\n\t}\n\treview, err := s.ReviewCheck(ref)\n\tif err != nil {\n\t\treturn CloseoutState{}, err\n\t}\n\tstate := CloseoutState{SchemaVersion: ReviewSchemaVersion, Scope: ref, ScopeDigest: review.ScopeDigest, Review: review, LifecycleDone: true, Blockers: append([]string{}, review.Blockers...)}\n\tstate.VerificationBasis = \"applicable-review-contract\"\n\tif review.BundleID != \"\" {\n\t\tstate.VerificationBasis = \"sealed-review-contract\"\n\t}\n\tif !review.Required {\n\t\tstate.VerificationBasis = \"review-not-required-under-applicable-policy\"\n\t\tstate.Limitations = []string{\"Review is not required under the applicable policy/cutoff; this does not establish a historical execution receipt.\"}\n\t}\n\tvar diagnostics []Diagnostic\n\tfor _, blocker := range review.Blockers {\n\t\tdiagnostics = append(diagnostics, OpaqueDiagnostic(\"review-blocker\", DiagnosticCloseout, blocker))\n\t}\n\tblock := func(d Diagnostic) {\n\t\tdiagnostics = append(diagnostics, d)\n\t\tstate.Blockers = append(state.Blockers, d.Message)\n\t}\n\tchildStore := s\n\t// includeFederated=false already suppresses recursive acceptance. Keep the\n\t// authorized binding: clearing it makes a child borrow its parent's active\n\t// read view under a different Store context.\n\tswitch scope.Kind {\n\tcase \"spec\":\n\t\tsp, err := s.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tstate.LifecycleDone = sp.Status == \"done\"\n\t\t// A question the current bundle's adjudication says does not hold\n\t\t// blocks the closeout as it fails the lint (spec\n\t\t// pose-delegated-verdict-destinations R1; review round 1, B05).\n\t\tfor _, message := range s.adjudicationBlockers(scope.Slug) {\n\t\t\tblock(OpaqueDiagnostic(AdjudicationDoesNotHoldCode, DiagnosticCloseout, message))\n\t\t}\n\t\tif _, findings, historyErr := s.InspectAmendmentHistory(*sp); historyErr != nil {\n\t\t\tblock(OpaqueDiagnostic(\"amendment-history-invalid\", DiagnosticCloseout, \"amendment history: \"+historyErr.Error()))\n\t\t\tstate.Limitations = append(state.Limitations, \"Amendment history could not be verified; inspect and repair it explicitly.\")\n\t\t} else {\n\t\t\tfor _, finding := range findings {\n\t\t\t\tblock(OpaqueDiagnostic(\"amendment-history-invalid\", DiagnosticCloseout, \"amendment history: \"+finding))\n\t\t\t}\n\t\t}\n\tcase \"milestone\":\n\t\trm, err := s.GetRoadmap(scope.Roadmap)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tvar found bool\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\tif milestone.ID != scope.Milestone {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfound = true\n\t\t\tfor _, raw := range milestone.Specs {\n\t\t\t\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\n\t\t\t\tif unresolved != \"\" {\n\t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", unresolved, raw))\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif external {\n\t\t\t\t\tif s.FederatedResolver == nil {\n\t\t\t\t\t\tblock(NewDiagnostic(\"external-member-unaccepted\", \"external member \"+raw+\" needs federated acceptance\", raw))\n\t\t\t\t\t}\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tchild, err := childStore.getCloseoutState(\"spec:\"+slug, false)\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn state, err\n\t\t\t\t}\n\t\t\t\tstate.Children = append(state.Children, child)\n\t\t\t\t// A roadmap may declare why a terminal member owes this milestone nothing.\n\t\t\t\tif !child.Terminal && !(review.Approved && s.declaredUnreviewed(scope) != \"\") {\n\t\t\t\t\tblock(NewDiagnostic(\"child-scope-open\", \"child \"+child.Scope+\" is not closed\", child.Scope))\n\t\t\t\t}\n\t\t\t}\n\t\t\t// An exempt milestone has no review of its own to judge its exit\n\t\t\t// gate: an approved member review must have judged it as it reads\n\t\t\t// now, or the close is blocked; the review stays dispensed. This\n\t\t\t// holds for one member too: a done spec sealed before the gate\n\t\t\t// existed never gains it (review round 6, N21).\n\t\t\tif decision := review.CloseoutReview; decision != nil && !decision.Required && strings.TrimSpace(milestone.ExitGate) != \"\" && !review.Approved && !s.exitGateJudgedByMember(rm.Slug, milestone, state.Children) {\n\t\t\t\tblock(NewDiagnostic(\"milestone-exit-gate-unjudged\", \"the exit gate of \"+ref+\" is judged by no approved review: seal and review the member that carries it (the only member, or the last one once every other member is closed), or review the milestone itself (`pose review bundle \"+ref+\" --seal`)\", ref))\n\t\t\t}\n\t\t\tbreak\n\t\t}\n\t\tif !found {\n\t\t\treturn state, fmt.Errorf(\"pose: milestone %s/%s not found\", scope.Roadmap, scope.Milestone)\n\t\t}\n\tcase \"roadmap\":\n\t\trm, err := s.GetRoadmap(scope.Slug)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tstate.LifecycleDone = rm.Status == \"done\"\n\t\tfor _, milestone := range rm.Milestones {\n\t\t\tchild, err := childStore.getCloseoutState(\"milestone:\"+rm.Slug+\"/\"+milestone.ID, false)\n\t\t\tif err != nil {\n\t\t\t\treturn state, err\n\t\t\t}\n\t\t\tstate.Children = append(state.Children, child)\n\t\t\tif !child.Terminal {\n\t\t\t\tblock(NewDiagnostic(\"child-scope-open\", \"child \"+child.Scope+\" is not closed\", child.Scope))\n\t\t\t}\n\t\t}\n\t}\n\tif includeFederated && s.FederatedResolver != nil && (scope.Kind == \"roadmap\" || scope.Kind == \"milestone\") {\n\t\tvar acceptance FederatedRoadmapAcceptanceReport\n\t\tvar err error\n\t\tif scope.Kind == \"milestone\" {\n\t\t\tacceptance, err = s.FederatedMilestoneAcceptance(s.FederatedProjectID, scope.Roadmap, scope.Milestone, *s.FederatedResolver)\n\t\t} else {\n\t\t\tacceptance, err = s.FederatedRoadmapAcceptance(s.FederatedProjectID, scope.Slug, *s.FederatedResolver)\n\t\t}\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tstate.FederatedAcceptance = &acceptance\n\t\tif !acceptance.Ready {\n\t\t\tfor _, blocker := range acceptance.Blockers {\n\t\t\t\tblock(OpaqueDiagnostic(\"federated-acceptance-blocker\", DiagnosticCloseout, blocker))\n\t\t\t}\n\t\t}\n\t}\n\tif includeFederated && s.FederatedResolver != nil && scope.Kind == \"spec\" {\n\t\tacceptance, applies, err := s.FederatedSpecAcceptance(s.FederatedProjectID, scope.Slug, *s.FederatedResolver)\n\t\tif err != nil {\n\t\t\treturn state, err\n\t\t}\n\t\tif applies {\n\t\t\tstate.FederatedAcceptance = &acceptance\n\t\t\tif !acceptance.Ready {\n\t\t\t\tfor _, blocker := range acceptance.Blockers {\n\t\t\t\t\tblock(OpaqueDiagnostic(\"federated-acceptance-blocker\", DiagnosticCloseout, blocker))\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tcloseOwed := false\n\tif scope.Kind == \"milestone\" || scope.Kind == \"roadmap\" {\n\t\tif policy, policyErr := s.GetReviewPolicy(); policyErr == nil && policy.CloseoutReviewAdopted() {\n\t\t\treceipt, receiptErr := s.ReadCloseoutReceipt(ref)\n\t\t\tif receiptErr != nil {\n\t\t\t\tblock(OpaqueDiagnostic(\"closeout-receipt-invalid\", DiagnosticCloseout, receiptErr.Error()))\n\t\t\t}\n\t\t\tstate.CloseoutReceipt = receipt\n\t\t\tif decision := review.CloseoutReview; decision != nil && receipt == nil && receiptErr == nil {\n\t\t\t\t// Terminal members make the scope eligible, never closed: the\n\t\t\t\t// explicit close publishes the receipt that makes it terminal.\n\t\t\t\tcloseOwed = true\n\t\t\t\tfor _, diagnostic := range decision.Diagnostics {\n\t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", diagnostic, ref))\n\t\t\t\t}\n\t\t\t}\n\t\t\tif review.CloseoutReview == nil && receipt == nil && scope.Kind == \"roadmap\" && state.LifecycleDone && review.Required && !review.Approved {\n\t\t\t\tdiagnostics = append(diagnostics, NewDiagnostic(\"closeout-receipt-incomplete\", \"roadmap \"+scope.Slug+\" is done with neither an approved review nor a closeout receipt; `pose close \"+ref+\"` verifies its inputs again and publishes the receipt\", ref))\n\t\t\t}\n\t\t}\n\t}\n\tstate.CloseRequired = closeOwed\n\tif scope.Kind == \"roadmap\" && state.CloseoutReceipt != nil {\n\t\t// A receipt stands for its cut criteria only while they still hold:\n\t\t// the shared terminal path checks them, as the roadmap gate does.\n\t\tfor _, blocker := range s.roadmapCriteriaBlockers(scope.Slug) {\n\t\t\tblock(NewDiagnostic(\"closeout-receipt-gate-failed\", blocker, ref))\n\t\t}\n\t}\n\t// An exemption under the adopted policy leaves the review no blockers to\n\t// remove; only the legacy path strips review-only messages, by text.\n\tif !review.Required && review.CloseoutReview == nil {\n\t\tstate.Blockers = removeReviewOnlyBlockers(state.Blockers)\n\t\tkept := diagnostics[:0]\n\t\tfor _, d := range diagnostics {\n\t\t\tif len(removeReviewOnlyBlockers([]string{d.Message})) == 1 {\n\t\t\t\tkept = append(kept, d)\n\t\t\t}\n\t\t}\n\t\tdiagnostics = kept\n\t}\n\tif review.Required && !review.Approved {\n\t\tdiagnostics = append(diagnostics, NewDiagnostic(\"review-not-approved\", \"review of \"+ref+\" is not approved\", ref))\n\t}\n\tif !state.LifecycleDone && scope.Kind != \"milestone\" {\n\t\tblock(NewDiagnostic(\"lifecycle-not-done\", \"lifecycle status is not done\", ref))\n\t}\n\t// Governed effects (spec pose-governed-effect-enforcement): under the\n\t// adopted capability, an unsatisfied action request restricting closeout\n\t// keeps the scope from being terminal, so close refuses through every\n\t// surface that asks this function.\n\tif scope.Kind == \"spec\" {\n\t\tif adopted, adoptErr := s.AgencyReadinessAdopted(); adoptErr == nil && adopted {\n\t\t\trestrictions, restrictErr := s.GovernedEffectRestrictions(PhaseCloseout, []string{scope.Slug})\n\t\t\tif restrictErr != nil {\n\t\t\t\treturn state, restrictErr\n\t\t\t}\n\t\t\tfor _, o := range restrictions {\n\t\t\t\tblock(governedEffectDiagnostic(o, PhaseCloseout, ref))\n\t\t\t}\n\t\t}\n\t}\n\tstate.Blockers = uniqueSorted(state.Blockers)\n\tstate.Terminal = len(state.Blockers) == 0 && (review.Approved || !review.Required) && state.LifecycleDone && !closeOwed\n\tif state.Terminal {\n\t\tstate.NextAction = \"none\"\n\t} else if len(state.Children) > 0 {\n\t\tfor _, child := range state.Children {\n\t\t\tif !child.Terminal {\n\t\t\t\tstate.NextAction = \"continue \" + child.Scope + \": \" + child.NextAction\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif state.NextAction == \"\" && state.FederatedAcceptance != nil && !state.FederatedAcceptance.Ready {\n\t\t\tstate.NextAction = \"resolve federated roadmap blockers for roadmap:\" + scope.Slug\n\t\t\tif scope.Kind == \"milestone\" {\n\t\t\t\tstate.NextAction = \"resolve federated roadmap blockers for roadmap:\" + scope.Roadmap\n\t\t\t}\n\t\t}\n\t} else if !review.Approved && review.Required {\n\t\tstate.NextAction = \"record or remediate a fresh review for \" + ref\n\t} else if !state.LifecycleDone {\n\t\tstate.NextAction = \"apply the guarded lifecycle transition for \" + ref\n\t}\n\tif state.NextAction == \"\" && scope.Kind == \"spec\" && state.FederatedAcceptance != nil && !state.FederatedAcceptance.Ready {\n\t\tstate.NextAction = \"resolve federated dependency blockers for \" + ref\n\t}\n\tif state.NextAction == \"\" && closeOwed && len(state.Blockers) == 0 {\n\t\tstate.NextAction = \"close \" + ref + \" with `pose close \" + ref + \"`, which publishes its closeout receipt\"\n\t}\n\tif state.NextAction == \"\" {\n\t\tstate.NextAction = \"resolve closeout blockers for \" + ref\n\t}\n\tfor _, d := range diagnostics {\n\t\tif d.Code == \"action-request-pending\" && len(d.Refs) > 1 {\n\t\t\tstate.NextAction = \"obtain a satisfying answer to action request \" + d.Refs[1] + \" (pose action show \" + d.Refs[1] + \")\"\n\t\t\tbreak\n\t\t}\n\t}\n\tSortDiagnostics(diagnostics)\n\tstate.Diagnostics = dedupeDiagnostics(diagnostics)\n\tstate.NextStep = closeoutNextStep(state, review, ref)\n\treturn state, nil\n}\n\n// closeoutNextStep types NextAction: the same decision, as a code and refs.\nfunc closeoutNextStep(state CloseoutState, review ReviewEvaluation, ref string) *Diagnostic {\n\tstep := func(code string, refs ...string) *Diagnostic {\n\t\treturn &Diagnostic{Code: code, Domain: DiagnosticCloseout, Refs: refs, Message: state.NextAction}\n\t}\n\tfor _, d := range state.Diagnostics {\n\t\tif d.Code == \"action-request-pending\" && len(d.Refs) > 1 {\n\t\t\treturn step(\"answer-action-request\", d.Refs[1])\n\t\t}\n\t}\n\tswitch {\n\tcase state.Terminal:\n\t\treturn step(\"none\")\n\tcase len(state.Children) > 0:\n\t\tfor _, child := range state.Children {\n\t\t\tif !child.Terminal {\n\t\t\t\treturn step(\"continue-child\", child.Scope)\n\t\t\t}\n\t\t}\n\t\tif state.CloseRequired && len(state.Blockers) == 0 {\n\t\t\treturn step(\"close-scope\", ref)\n\t\t}\n\t\treturn step(\"resolve-federated-blockers\", ref)\n\tcase !review.Approved && review.Required:\n\t\treturn step(\"record-fresh-review\", ref)\n\tcase !state.LifecycleDone:\n\t\treturn step(\"apply-lifecycle-transition\", ref)\n\tcase state.FederatedAcceptance != nil && !state.FederatedAcceptance.Ready:\n","exit_code":0,"status":"completed"}}
