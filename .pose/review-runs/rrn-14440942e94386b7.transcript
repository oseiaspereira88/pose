{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/federated_acceptance.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"crypto/sha256\"\n     6\t\t\"encoding/hex\"\n     7\t\t\"encoding/json\"\n     8\t\t\"errors\"\n     9\t\t\"fmt\"\n    10\t\t\"io\"\n    11\t\t\"os\"\n    12\t\t\"os/exec\"\n    13\t\t\"path/filepath\"\n    14\t\t\"sort\"\n    15\t\t\"strings\"\n    16\t\t\"time\"\n    17\t)\n    18\t\n    19\tconst FederatedRoadmapPolicySchemaVersion = 1\n    20\t\n    21\tconst (\n    22\t\tmaxFederatedPolicyBytes          = 256 << 10\n    23\t\tmaxFederatedGovernanceInputBytes = 2 << 20\n    24\t)\n    25\t\n    26\ttype FederatedProjectTrust struct {\n    27\t\tContractDigest string `json:\"contract_digest\"`\n    28\t\tPolicyDigest   string `json:\"policy_digest\"`\n    29\t\tRevision       string `json:\"revision\"`\n    30\t}\n    31\t\n    32\ttype FederatedRoadmapPolicy struct {\n    33\t\tSchemaVersion   int                              `json:\"schema_version\"`\n    34\t\tEnabled         bool                             `json:\"enabled\"`\n    35\t\tAdoptedAt       string                           `json:\"adopted_at,omitempty\"`\n    36\t\tTrustedProjects map[string]FederatedProjectTrust `json:\"trusted_projects,omitempty\"`\n    37\t}\n    38\t\n    39\ttype FederatedDependencyEvidence struct {\n    40\t\tID                 string `json:\"id\"`\n    41\t\tCheck              string `json:\"check\"`\n    42\t\tEvidenceClass      string `json:\"evidence_class\"`\n    43\t\tSubjectObservation string `json:\"subject_observation\"`\n    44\t}\n    45\t\n    46\ttype FederatedDependency struct {\n    47\t\tRef                  string                        `json:\"ref\"`\n    48\t\tRelationship         string                        `json:\"relationship\"`\n    49\t\tRelationships        []string                      `json:\"relationships,omitempty\"`\n    50\t\tIdentity             ArtifactRef                   `json:\"identity\"`\n    51\t\tResolutionState      string                        `json:\"resolution_state\"`\n    52\t\tStatus               string                        `json:\"status,omitempty\"`\n    53\t\tSourceRevision       string                        `json:\"source_revision,omitempty\"`\n    54\t\tSourceDigest         string                        `json:\"source_digest,omitempty\"`\n    55\t\tSourceContractDigest string                        `json:\"source_contract_digest,omitempty\"`\n    56\t\tSourcePolicyDigest   string                        `json:\"source_policy_digest,omitempty\"`\n    57\t\tReviewBundleID       string                        `json:\"review_bundle_id,omitempty\"`\n    58\t\tReviewBundleDigest   string                        `json:\"review_bundle_digest,omitempty\"`\n    59\t\tImplementationDigest string                        `json:\"implementation_digest,omitempty\"`\n    60\t\tPlanDigest           string                        `json:\"plan_digest,omitempty\"`\n    61\t\tGoverningContracts   []string                      `json:\"governing_contracts,omitempty\"`\n    62\t\tEvidence             []FederatedDependencyEvidence `json:\"evidence,omitempty\"`\n    63\t}\n    64\t\n    65\ttype FederatedRoadmapManifest struct {\n    66\t\tSchemaVersion       int                   `json:\"schema_version\"`\n    67\t\tCoordinator         ArtifactRef           `json:\"coordinator\"`\n    68\t\tCoordinatorRevision string                `json:\"coordinator_revision,omitempty\"`\n    69\t\tTrustPolicyDigest   string                `json:\"trust_policy_digest,omitempty\"`\n    70\t\tDependencies        []FederatedDependency `json:\"dependencies\"`\n    71\t\tReady               bool                  `json:\"ready\"`\n    72\t\tBlockers            []string              `json:\"blockers\"`\n    73\t\tDigest              string                `json:\"digest\"`\n    74\t}\n    75\t\n    76\ttype FederatedRoadmapAcceptanceReport struct {\n    77\t\tManifest FederatedRoadmapManifest `json:\"manifest\"`\n    78\t\tReady    bool                     `json:\"ready\"`\n    79\t\tBlockers []string                 `json:\"blockers\"`\n    80\t}\n    81\t\n    82\ttype federatedRoadmapEdge struct {\n    83\t\tproject      string\n    84\t\traw          string\n    85\t\trelationship string\n    86\t}\n    87\t\n    88\ttype federatedQueuedRef struct {\n    89\t\tproject      string\n    90\t\tparent       string\n    91\t\traw          string\n    92\t\trelationship string\n    93\t}\n    94\t\n    95\t// FederatedProjectTrustFor computes the exact governance inputs a consumer\n    96\t// must accept for one source project. It is read-only: callers still have to\n    97\t// record the returned digests in their own policy.\n    98\tfunc FederatedProjectTrustForIn(files Files, root, projectID string) (FederatedProjectTrust, error) {\n    99\t\tif ValidateSlug(projectID) != nil {\n   100\t\t\treturn FederatedProjectTrust{}, fmt.Errorf(\"pose: invalid federated project id\")\n   101\t\t}\n   102\t\trevision := gitHeadAtRootIn(files, root, federatedAcceptanceProducer)\n   103\t\tif !isGitRevision(revision) {\n   104\t\t\treturn FederatedProjectTrust{}, fmt.Errorf(\"pose: federated-project-revision-unavailable\")\n   105\t\t}\n   106\t\tcontractFiles := []string{\".pose/schema-version\", \".pose/indexes/validation-matrix.json\"}\n   107\t\tpolicyFiles := []string{\".pose/policy/artifacts.json\", \".pose/policy/delivery.json\", \".pose/policy/review.json\"}\n   108\t\tcontracts, err := committedFederatedInputs(files, root, contractFiles)\n   109\t\tif err != nil {\n   110\t\t\treturn FederatedProjectTrust{}, err\n   111\t\t}\n   112\t\tpolicies, err := committedFederatedInputs(files, root, policyFiles)\n   113\t\tif err != nil {\n   114\t\t\treturn FederatedProjectTrust{}, err\n   115\t\t}\n   116\t\treturn FederatedProjectTrust{ContractDigest: canonicalFederatedDigest(contracts), PolicyDigest: canonicalFederatedDigest(policies), Revision: revision}, nil\n   117\t}\n   118\t\n   119\t// FederatedProjectTrustFor reads and writes the filesystem directly; FederatedProjectTrustForIn takes the\n   120\t// operation's files.\n   121\tfunc FederatedProjectTrustFor(root, projectID string) (FederatedProjectTrust, error) {\n   122\t\treturn FederatedProjectTrustForIn(NativeFiles(), root, projectID)\n   123\t}\n   124\t\n   125\tfunc LoadFederatedRoadmapPolicyIn(files Files, root string) (FederatedRoadmapPolicy, string, error) {\n   126\t\trel := \".pose/policy/federation.json\"\n   127\t\tif err := ValidateArtifactPathIn(files, root, rel, false); err != nil {\n   128\t\t\treturn FederatedRoadmapPolicy{}, \"\", fmt.Errorf(\"pose: invalid-federation-policy-path\")\n   129\t\t}\n   130\t\tpath := filepath.Join(root, filepath.FromSlash(rel))\n   131\t\tinfo, err := files.Stat(path)\n   132\t\tif os.IsNotExist(err) {\n   133\t\t\treturn FederatedRoadmapPolicy{}, \"\", nil\n   134\t\t}\n   135\t\tif err != nil {\n   136\t\t\treturn FederatedRoadmapPolicy{}, \"\", fmt.Errorf(\"pose: federation-policy-unavailable\")\n   137\t\t}\n   138\t\tif !info.Mode().IsRegular() {\n   139\t\t\treturn FederatedRoadmapPolicy{}, \"\", fmt.Errorf(\"pose: federation-policy-unavailable\")\n   140\t\t}\n   141\t\tfile, err := files.Open(path)\n   142\t\tif err != nil {\n   143\t\t\treturn FederatedRoadmapPolicy{}, \"\", fmt.Errorf(\"pose: federation-policy-unavailable\")\n   144\t\t}\n   145\t\traw, readErr := io.ReadAll(io.LimitReader(file, maxFederatedPolicyBytes+1))\n   146\t\tcloseErr := file.Close()\n   147\t\tif readErr != nil || closeErr != nil {\n   148\t\t\treturn FederatedRoadmapPolicy{}, \"\", fmt.Errorf(\"pose: federation-policy-unavailable\")\n   149\t\t}\n   150\t\tif len(raw) > maxFederatedPolicyBytes {\n   151\t\t\treturn FederatedRoadmapPolicy{}, \"\", fmt.Errorf(\"pose: federation-policy-too-large\")\n   152\t\t}\n   153\t\tvar policy FederatedRoadmapPolicy\n   154\t\tif rejectDuplicateJSONKeysAndControls(raw) != nil || strictJSONBytes(raw, &policy) != nil || policy.SchemaVersion != FederatedRoadmapPolicySchemaVersion {\n   155\t\t\treturn FederatedRoadmapPolicy{}, \"\", fmt.Errorf(\"pose: unsupported-federation-contract\")\n   156\t\t}\n   157\t\tif policy.Enabled {\n   158\t\t\tif _, err := time.Parse(time.DateOnly, policy.AdoptedAt); err != nil {\n   159\t\t\t\treturn FederatedRoadmapPolicy{}, \"\", fmt.Errorf(\"pose: invalid-federation-adoption-date\")\n   160\t\t\t}\n   161\t\t}\n   162\t\tfor projectID, pin := range policy.TrustedProjects {\n   163\t\t\tif ValidateSlug(projectID) != nil || !isSHA256(pin.ContractDigest) || !isSHA256(pin.PolicyDigest) || !isGitRevision(pin.Revision) {\n   164\t\t\t\treturn FederatedRoadmapPolicy{}, \"\", fmt.Errorf(\"pose: invalid-federated-project-trust\")\n   165\t\t\t}\n   166\t\t}\n   167\t\treturn policy, digestBytes(raw), nil\n   168\t}\n   169\t\n   170\t// LoadFederatedRoadmapPolicy reads and writes the filesystem directly; LoadFederatedRoadmapPolicyIn takes the\n   171\t// operation's files.\n   172\tfunc LoadFederatedRoadmapPolicy(root string) (FederatedRoadmapPolicy, string, error) {\n   173\t\treturn LoadFederatedRoadmapPolicyIn(NativeFiles(), root)\n   174\t}\n   175\t\n   176\tfunc strictJSONBytes(raw []byte, target any) error {\n   177\t\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n   178\t\tdecoder.DisallowUnknownFields()\n   179\t\tif err := decoder.Decode(target); err != nil {\n   180\t\t\treturn err\n   181\t\t}\n   182\t\tvar extra any\n   183\t\tif err := decoder.Decode(&extra); err != io.EOF {\n   184\t\t\tif err == nil {\n   185\t\t\t\treturn fmt.Errorf(\"trailing JSON content\")\n   186\t\t\t}\n   187\t\t\treturn err\n   188\t\t}\n   189\t\treturn nil\n   190\t}\n   191\t\n   192\tfunc isSHA256(value string) bool {\n   193\t\tif !strings.HasPrefix(value, \"sha256:\") || len(value) != len(\"sha256:\")+64 {\n   194\t\t\treturn false\n   195\t\t}\n   196\t\t_, err := hex.DecodeString(strings.TrimPrefix(value, \"sha256:\"))\n   197\t\treturn err == nil\n   198\t}\n   199\t\n   200\tfunc isGitRevision(value string) bool {\n   201\t\tif len(value) != 40 && len(value) != 64 {\n   202\t\t\treturn false\n   203\t\t}\n   204\t\t_, err := hex.DecodeString(value)\n   205\t\treturn err == nil\n   206\t}\n   207\t\n   208\tfunc committedFederatedInputs(files Files, root string, paths []string) (map[string]string, error) {\n   209\t\tinputs := make(map[string]string, len(paths))\n   210\t\tfor _, rel := range paths {\n   211\t\t\tif err := ValidateArtifactPathIn(files, root, rel, false); err != nil {\n   212\t\t\t\treturn nil, fmt.Errorf(\"pose: invalid-federated-governance-input\")\n   213\t\t\t}\n   214\t\t\tabsolute := filepath.Join(root, filepath.FromSlash(rel))\n   215\t\t\tinfo, err := files.Stat(absolute)\n   216\t\t\tif err != nil {\n   217\t\t\t\treturn nil, fmt.Errorf(\"pose: missing-federated-governance-input\")\n   218\t\t\t}\n   219\t\t\tif !info.Mode().IsRegular() || info.Size() > maxFederatedGovernanceInputBytes {\n   220\t\t\t\treturn nil, fmt.Errorf(\"pose: invalid-federated-governance-input\")\n   221\t\t\t}\n   222\t\t\tif !artifactPathWithin(files, root, absolute) {\n   223\t\t\t\treturn nil, fmt.Errorf(\"pose: invalid-federated-governance-input\")\n   224\t\t\t}\n   225\t\t\tfile, err := files.Open(absolute)\n   226\t\t\tif err != nil {\n   227\t\t\t\treturn nil, fmt.Errorf(\"pose: missing-federated-governance-input\")\n   228\t\t\t}\n   229\t\t\tworking, readErr := io.ReadAll(io.LimitReader(file, maxFederatedGovernanceInputBytes+1))\n   230\t\t\tcloseErr := file.Close()\n   231\t\t\tif readErr != nil || closeErr != nil || len(working) > maxFederatedGovernanceInputBytes {\n   232\t\t\t\treturn nil, fmt.Errorf(\"pose: invalid-federated-governance-input\")\n   233\t\t\t}\n   234\t\t\ttop, err := captureFederatedGit(files, root, \"rev-parse\", \"--show-toplevel\")\n   235\t\t\tif err != nil || !sameProjectRoot(files, root, strings.TrimSpace(string(top))) {\n   236\t\t\t\treturn nil, fmt.Errorf(\"pose: federated-project-revision-unavailable\")\n   237\t\t\t}\n   238\t\t\trevision, err := captureFederatedGit(files, root, \"rev-parse\", \"--verify\", \"HEAD\")\n   239\t\t\tif err != nil {\n   240\t\t\t\treturn nil, fmt.Errorf(\"pose: federated-project-revision-unavailable\")\n   241\t\t\t}\n   242\t\t\tobject := strings.TrimSpace(string(revision)) + \":\" + filepath.ToSlash(rel)\n   243\t\t\tblobSize, err := captureFederatedGit(files, root, \"cat-file\", \"-s\", object)\n   244\t\t\tif err != nil {\n   245\t\t\t\treturn nil, fmt.Errorf(\"pose: federated-project-revision-unavailable\")\n   246\t\t\t}\n   247\t\t\tvar committedSize int64\n   248\t\t\tif _, err := fmt.Sscan(strings.TrimSpace(string(blobSize)), &committedSize); err != nil || committedSize < 0 || committedSize > maxFederatedGovernanceInputBytes {\n   249\t\t\t\treturn nil, fmt.Errorf(\"pose: invalid-federated-governance-input\")\n   250\t\t\t}\n   251\t\t\thead, err := captureFederatedGit(files, root, \"show\", object)\n   252\t\t\tif err != nil || !bytes.Equal(working, head) {\n   253\t\t\t\treturn nil, fmt.Errorf(\"pose: federated-governance-input-not-committed\")\n   254\t\t\t}\n   255\t\t\tinputs[rel] = digestBytes(working)\n   256\t\t}\n   257\t\treturn inputs, nil\n   258\t}\n   259\t\n   260\tfunc canonicalFederatedDigest(value any) string {\n   261\t\traw, _ := json.Marshal(value)\n   262\t\tsum := sha256.Sum256(raw)\n   263\t\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n   264\t}\n   265\t\n   266\tfunc (s Store) FederatedRoadmapAcceptance(projectID, slug string, resolver ArtifactResolver) (FederatedRoadmapAcceptanceReport, error) {\n   267\t\trm, err := s.GetRoadmap(slug)\n   268\t\tif err != nil {\n   269\t\t\treturn FederatedRoadmapAcceptanceReport{}, err\n   270\t\t}\n   271\t\tif resolver.Roots == nil {\n   272\t\t\treturn FederatedRoadmapAcceptanceReport{}, fmt.Errorf(\"pose: project roots are unavailable\")\n   273\t\t}\n   274\t\treturn s.federatedAcceptance(projectID, ArtifactRef{Project: projectID, Kind: \"roadmap\", Slug: slug}, collectFederatedRoadmapEdges(projectID, rm), resolver)\n   275\t}\n   276\t\n   277\t// FederatedMilestoneAcceptance restricts roadmap acceptance to one milestone:\n   278\t// the roadmap's consumed outcomes, plus that milestone's predecessors, member\n   279\t// specs and consumed outcomes. Members of a later milestone do not gate an\n   280\t// earlier one, matching local milestone closeout, and the depends_on of the\n   281\t// roadmap binds the close of the roadmap alone (ADR\n   282\t// a-milestone-answers-to-its-own-edges).\n   283\tfunc (s Store) FederatedMilestoneAcceptance(projectID, slug, milestone string, resolver ArtifactResolver) (FederatedRoadmapAcceptanceReport, error) {\n   284\t\treturn s.milestoneAcceptance(projectID, slug, milestone, resolver, false)\n   285\t}\n   286\t\n   287\t// milestoneAcceptance builds the acceptance of one milestone. roadmapDependencies\n   288\t// keeps the depends_on of the roadmap, which is how a bundle sealed before that\n   289\t// edge moved to the roadmap reads.\n   290\tfunc (s Store) milestoneAcceptance(projectID, slug, milestone string, resolver ArtifactResolver, roadmapDependencies bool) (FederatedRoadmapAcceptanceReport, error) {\n   291\t\trm, err := s.GetRoadmap(slug)\n   292\t\tif err != nil {\n   293\t\t\treturn FederatedRoadmapAcceptanceReport{}, err\n   294\t\t}\n   295\t\tif resolver.Roots == nil {\n   296\t\t\treturn FederatedRoadmapAcceptanceReport{}, fmt.Errorf(\"pose: project roots are unavailable\")\n   297\t\t}\n   298\t\tselected := *rm\n   299\t\tselected.Milestones = nil\n   300\t\tif !roadmapDependencies {\n   301\t\t\tselected.DependsOn = nil\n   302\t\t}\n   303\t\tfor _, candidate := range rm.Milestones {\n   304\t\t\tif candidate.ID == milestone {\n   305\t\t\t\tselected.Milestones = append(selected.Milestones, candidate)\n   306\t\t\t}\n   307\t\t}\n   308\t\tif len(selected.Milestones) == 0 {\n   309\t\t\treturn FederatedRoadmapAcceptanceReport{}, fmt.Errorf(\"pose: milestone %s not found in roadmap %s\", milestone, slug)\n   310\t\t}\n   311\t\tcoordinator := ArtifactRef{Project: projectID, Kind: \"milestone\", Slug: slug, Milestone: milestone}\n   312\t\treturn s.federatedAcceptance(projectID, coordinator, collectFederatedRoadmapEdges(projectID, &selected), resolver)\n   313\t}\n   314\t\n   315\t// FederatedSpecAcceptance applies roadmap acceptance to the external\n   316\t// dependencies of one spec. It reports applies=false for a spec whose\n   317\t// depends_on names no other project, so its review and closeout keep their\n   318\t// previous contract. Local dependencies stay governed by lifecycle checks.\n   319\tfunc (s Store) FederatedSpecAcceptance(projectID, slug string, resolver ArtifactResolver) (FederatedRoadmapAcceptanceReport, bool, error) {\n   320\t\tsp, err := s.GetSpec(slug)\n   321\t\tif err != nil {\n   322\t\t\treturn FederatedRoadmapAcceptanceReport{}, false, err\n   323\t\t}\n   324\t\tedges := []federatedRoadmapEdge{}\n   325\t\tfor _, raw := range sp.DependsOn {\n   326\t\t\tref, err := ParseArtifactRef(raw)\n   327\t\t\tif err != nil || ref.Project == \"\" || ref.Project == projectID {\n   328\t\t\t\tcontinue\n   329\t\t\t}\n   330\t\t\tedges = append(edges, federatedRoadmapEdge{project: projectID, raw: raw, relationship: \"prerequisite\"})\n   331\t\t}\n   332\t\tif len(edges) == 0 {\n   333\t\t\treturn FederatedRoadmapAcceptanceReport{}, false, nil\n   334\t\t}\n   335\t\tcoordinator := ArtifactRef{Project: projectID, Kind: \"spec\", Slug: slug}\n   336\t\tif resolver.Roots == nil {\n   337\t\t\t// Fail closed without failing the command: a checkout with no roots\n   338\t\t\t// can still read the spec but can never close it.\n   339\t\t\treturn federatedBlockedReport(s.fsys(), s, coordinator, \"project-roots-unavailable\"), true, nil\n   340\t\t}\n   341\t\treport, err := s.federatedAcceptance(projectID, coordinator, edges, resolver)\n   342\t\treturn report, true, err\n   343\t}\n   344\t\n   345\tfunc federatedBlockedReport(files Files, s Store, coordinator ArtifactRef, blocker string) FederatedRoadmapAcceptanceReport {\n   346\t\tmanifest := FederatedRoadmapManifest{SchemaVersion: 1, Coordinator: coordinator, CoordinatorRevision: federatedArtifactLastChange(files, s, coordinator), Dependencies: []FederatedDependency{}, Blockers: []string{blocker}}\n   347\t\tmanifest.Digest = canonicalFederatedDigest(manifest)\n   348\t\treturn FederatedRoadmapAcceptanceReport{Manifest: manifest, Blockers: []string{blocker}}\n   349\t}\n   350\t\n   351\tfunc (s Store) federatedAcceptance(projectID string, coordinator ArtifactRef, edges []federatedRoadmapEdge, resolver ArtifactResolver) (FederatedRoadmapAcceptanceReport, error) {\n   352\t\tpolicy, policyDigest, err := LoadFederatedRoadmapPolicyIn(s.fsys(), s.Root)\n   353\t\tif err != nil {\n   354\t\t\treturn FederatedRoadmapAcceptanceReport{}, err\n   355\t\t}\n   356\t\trevision := gitHeadAtRootIn(s.fsys(), s.Root, federatedAcceptanceProducer)\n   357\t\tcoordinatorRevision := revision\n   358\t\tif stable := federatedArtifactLastChange(s.fsys(), s, coordinator); stable != \"\" {\n   359\t\t\tcoordinatorRevision = stable\n   360\t\t}\n   361\t\treport := FederatedRoadmapAcceptanceReport{Manifest: FederatedRoadmapManifest{\n   362\t\t\tSchemaVersion: 1, Coordinator: coordinator, CoordinatorRevision: coordinatorRevision,\n   363\t\t\tTrustPolicyDigest: policyDigest, Dependencies: []FederatedDependency{},\n   364\t\t}, Blockers: []string{}}\n   365\t\tqueue := []federatedQueuedRef{}\n   366\t\tfor _, edge := range edges {\n   367\t\t\tqueue = append(queue, federatedQueuedRef{project: edge.project, parent: edge.project, raw: edge.raw, relationship: edge.relationship})\n   368\t\t}\n   369\t\tvisited := map[string]bool{}\n   370\t\tdependencyIndexes := map[string]int{}\n   371\t\tprojectRoots := map[string]Store{projectID: s}\n   372\t\tsnapshotRevisions := map[string]string{}\n   373\t\tif revision != \"\" {\n   374\t\t\tsnapshotRevisions[projectID] = revision\n   375\t\t}\n   376\t\tfor len(queue) > 0 {\n   377\t\t\titem := queue[0]\n   378\t\t\tqueue = queue[1:]\n   379\t\t\tresolved := resolver.Resolve(item.project, item.raw)\n   380\t\t\tidentity := resolved.Identity\n   381\t\t\tif identity.Project == \"\" {\n   382\t\t\t\tidentity.Project = item.project\n   383\t\t\t}\n   384\t\t\tkey := identity.String()\n   385\t\t\tif visited[key] {\n   386\t\t\t\tif index, ok := dependencyIndexes[key]; ok {\n   387\t\t\t\t\tentry := &report.Manifest.Dependencies[index]\n   388\t\t\t\t\tfound := item.relationship == entry.Relationship\n   389\t\t\t\t\tfor _, relationship := range entry.Relationships {\n   390\t\t\t\t\t\tfound = found || relationship == item.relationship\n   391\t\t\t\t\t}\n   392\t\t\t\t\tif !found {\n   393\t\t\t\t\t\tentry.Relationships = append(entry.Relationships, item.relationship)\n   394\t\t\t\t\t\tsort.Strings(entry.Relationships)\n   395\t\t\t\t\t\tentry.Relationship = entry.Relationships[0]\n   396\t\t\t\t\t}\n   397\t\t\t\t}\n   398\t\t\t\tcontinue\n   399\t\t\t}\n   400\t\t\tif len(visited) >= 256 {\n   401\t\t\t\treport.Blockers = append(report.Blockers, \"resolution-limit\")\n   402\t\t\t\tbreak\n   403\t\t\t}\n   404\t\t\tvisited[key] = true\n   405\t\t\tentry := FederatedDependency{Ref: key, Relationship: item.relationship, Relationships: []string{item.relationship}, Identity: identity, ResolutionState: resolved.State, Status: resolved.Status, SourceRevision: resolved.Revision, SourceDigest: resolved.Digest}\n   406\t\t\tdependencyIndexes[key] = len(report.Manifest.Dependencies)\n   407\t\t\tif !resolved.Resolved {\n   408\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+resolved.State)\n   409\t\t\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n   410\t\t\t\tcontinue\n   411\t\t\t}\n   412\t\t\tif selected, exists := snapshotRevisions[identity.Project]; exists && selected != \"\" && resolved.Revision != selected {\n   413\t\t\t\treport.Blockers = append(report.Blockers, key+\":source-revision-changed-during-resolution\")\n   414\t\t\t} else if _, exists := snapshotRevisions[identity.Project]; !exists && resolved.Revision != \"\" {\n   415\t\t\t\tsnapshotRevisions[identity.Project] = resolved.Revision\n   416\t\t\t}\n   417\t\t\tgraphValid := true\n   418\t\t\tif reason := resolver.ValidateGraph(item.project, item.raw); reason != \"\" {\n   419\t\t\t\tgraphValid = false\n   420\t\t\t\tentry.ResolutionState = reason\n   421\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+reason)\n   422\t\t\t}\n   423\t\t\tstatusDone := resolved.Status == \"done\"\n   424\t\t\tif !statusDone {\n   425\t\t\t\treport.Blockers = append(report.Blockers, key+\":not-done\")\n   426\t\t\t}\n   427\t\t\tsource, sourceErr := resolver.Roots.StoreFor(identity.Project)\n   428\t\t\tif sourceErr != nil {\n   429\t\t\t\tentry.ResolutionState = projectResolutionState(sourceErr)\n   430\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n   431\t\t\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n   432\t\t\t\tcontinue\n   433\t\t\t}\n   434\t\t\tsource = resolver.withSpecSnapshot(identity.Project, source)\n   435\t\t\tprojectRoots[identity.Project] = source\n   436\t\t\tsource.FederatedProjectID = identity.Project\n   437\t\t\tsource.FederatedResolver = &resolver\n   438\t\t\tartifactValid := true\n   439\t\t\tif err := verifyFederatedArtifactAtRevision(s.fsys(), source, identity, resolved); err != nil {\n   440\t\t\t\tartifactValid = false\n   441\t\t\t\tentry.ResolutionState = err.Error()\n   442\t\t\t\tblocker := key + \":\" + err.Error()\n   443\t\t\t\tif err.Error() == federatedSourceUncommitted {\n   444\t\t\t\t\tblocker += \": commit the artifact, its working file differs from its revision\"\n   445\t\t\t\t}\n   446\t\t\t\treport.Blockers = append(report.Blockers, blocker)\n   447\t\t\t}\n   448\t\t\t// Same-project dependencies need the revision of their own artifact.\n   449\t\t\t// Using repository HEAD makes every unrelated evidence commit stale a\n   450\t\t\t// sealed milestone or roadmap. External dependencies retain the explicit\n   451\t\t\t// whole-repository pin checked below.\n   452\t\t\tif identity.Project == projectID {\n   453\t\t\t\tif stable := federatedArtifactLastChange(s.fsys(), source, identity); stable != \"\" {\n   454\t\t\t\t\tentry.SourceRevision = stable\n   455\t\t\t\t}\n   456\t\t\t\t// Under an adopted closeout review policy a local milestone or\n   457\t\t\t\t// roadmap is closed by its explicit close, never by the status\n   458\t\t\t\t// its members give it: the edge asks the terminal projection,\n   459\t\t\t\t// along a chain that stops at a cycle (review round 6, N22).\n   460\t\t\t\tif statusDone && graphValid && (identity.Kind == \"milestone\" || identity.Kind == \"roadmap\") {\n   461\t\t\t\t\tif adopted, err := s.closeoutReviewPolicyAdopted(); err != nil || adopted && !s.localScopeClosed(localFederatedScope(identity)) {\n   462\t\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":closeout-not-terminal\")\n   463\t\t\t\t\t}\n   464\t\t\t\t}\n   465\t\t\t}\n   466\t\t\tif identity.Project != projectID {\n   467\t\t\t\t// Do not recurse into source closeout when graph traversal has already\n   468\t\t\t\t// found a cycle or stale artifact. The blocker is conclusive, and\n   469\t\t\t\t// recursively asking each side of a cycle for its review would never\n   470\t\t\t\t// converge.\n   471\t\t\t\tgitlinkValid := true\n   472\t\t\t\tpin, pinErr := FederatedProjectTrustForIn(s.fsys(), source.Root, identity.Project)\n   473\t\t\t\tif pinErr != nil {\n   474\t\t\t\t\tentry.ResolutionState = pinErr.Error()\n   475\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n   476\t\t\t\t} else {\n   477\t\t\t\t\tentry.SourceContractDigest, entry.SourcePolicyDigest = pin.ContractDigest, pin.PolicyDigest\n   478\t\t\t\t}\n   479\t\t\t\tif !policy.Enabled {\n   480\t\t\t\t\tentry.ResolutionState = \"consumer-trust-not-adopted\"\n   481\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n   482\t\t\t\t} else {\n   483\t\t\t\t\taccepted, exists := policy.TrustedProjects[identity.Project]\n   484\t\t\t\t\tif pinErr != nil {\n   485\t\t\t\t\t\t// The pin error was recorded above; retain the stable state.\n   486\t\t\t\t\t} else if !exists {\n   487\t\t\t\t\t\tentry.ResolutionState = \"consumer-trust-not-adopted\"\n   488\t\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n   489\t\t\t\t\t} else if accepted != pin {\n   490\t\t\t\t\t\tentry.ResolutionState = \"consumer-trust-stale\"\n   491\t\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n   492\t\t\t\t\t} else {\n   493\t\t\t\t\t\tif identity.Project == item.parent {\n   494\t\t\t\t\t\t\t// This edge remains inside the selected source repository;\n   495\t\t\t\t\t\t\t// its local artifacts inherit that repository's pin.\n   496\t\t\t\t\t\t} else if parentStore, parentErr := resolver.Roots.StoreFor(item.parent); parentErr != nil || !federatedGitlinkMatchesIn(s.fsys(), parentStore, source, resolved.Revision) {\n   497\t\t\t\t\t\t\tgitlinkValid = false\n   498\t\t\t\t\t\t\tif parentErr != nil {\n   499\t\t\t\t\t\t\t\tentry.ResolutionState = projectResolutionState(parentErr)\n   500\t\t\t\t\t\t\t} else {\n   501\t\t\t\t\t\t\t\tentry.ResolutionState = \"gitlink-revision-mismatch\"\n   502\t\t\t\t\t\t\t}\n   503\t\t\t\t\t\t\treport.Blockers = append(report.Blockers, key+\":\"+entry.ResolutionState)\n   504\t\t\t\t\t\t}\n   505\t\t\t\t\t}\n   506\t\t\t\t}\n   507\t\t\t\taccepted, trusted := policy.TrustedProjects[identity.Project]\n   508\t\t\t\tproofInputsReady := graphValid && statusDone && artifactValid && pinErr == nil && policy.Enabled && trusted && accepted == pin && gitlinkValid\n   509\t\t\t\tif proofInputsReady {\n   510\t\t\t\t\tbundleID, bundleDigest, subjectDigest, planDigest, contracts, evidence, proofBlockers := federatedSourceProof(s.fsys(), source, identity, resolved.Revision)\n   511\t\t\t\t\tentry.ReviewBundleID, entry.ReviewBundleDigest = bundleID, bundleDigest\n   512\t\t\t\t\tentry.ImplementationDigest, entry.PlanDigest = subjectDigest, planDigest\n   513\t\t\t\t\tentry.GoverningContracts, entry.Evidence = contracts, evidence\n   514\t\t\t\t\treport.Blockers = append(report.Blockers, proofBlockers...)\n   515\t\t\t\t\tif len(proofBlockers) > 0 {\n   516\t\t\t\t\t\tentry.ResolutionState = \"source-evidence-incomplete\"\n   517\t\t\t\t\t}\n   518\t\t\t\t}\n   519\t\t\t}\n   520\t\t\treport.Manifest.Dependencies = append(report.Manifest.Dependencies, entry)\n   521\t\t\tfor _, dep := range resolved.Dependencies {\n   522\t\t\t\tqueue = append(queue, federatedQueuedRef{project: dep.Project, parent: identity.Project, raw: dep.String(), relationship: \"prerequisite\"})\n   523\t\t\t}\n   524\t\t}\n   525\t\tfor project, selected := range snapshotRevisions {\n   526\t\t\tif selected == \"\" {\n   527\t\t\t\tcontinue\n   528\t\t\t}\n   529\t\t\troot, ok := projectRoots[project]\n   530\t\t\tif ok && gitHeadAtRootIn(s.fsys(), root.Root, federatedAcceptanceProducer) != selected {\n   531\t\t\t\treport.Blockers = append(report.Blockers, \"source-snapshot-changed-during-resolution:\"+project)\n   532\t\t\t}\n   533\t\t}\n   534\t\treport.Blockers = append(report.Blockers, federatedOwnershipConflicts(s.fsys(), projectRoots, resolver)...)\n   535\t\tsort.Slice(report.Manifest.Dependencies, func(i, j int) bool {\n   536\t\t\tleft, right := report.Manifest.Dependencies[i], report.Manifest.Dependencies[j]\n   537\t\t\tif left.Identity.String() != right.Identity.String() {\n   538\t\t\t\treturn left.Identity.String() < right.Identity.String()\n   539\t\t\t}\n   540\t\t\treturn left.Relationship < right.Relationship\n   541\t\t})\n   542\t\treport.Blockers = uniqueSorted(report.Blockers)\n   543\t\treport.Manifest.Ready = len(report.Blockers) == 0\n   544\t\treport.Manifest.Blockers = append([]string{}, report.Blockers...)\n   545\t\treport.Manifest.Digest = \"\"\n   546\t\treport.Manifest.Digest = canonicalFederatedDigest(report.Manifest)\n   547\t\treport.Ready = report.Manifest.Ready\n   548\t\treturn report, nil\n   549\t}\n   550\t\n   551\tfunc federatedArtifactLastChange(files Files, source Store, identity ArtifactRef) string {\n   552\t\tvar path string\n   553\t\tif identity.Kind == \"spec\" {\n   554\t\t\tsp, err := source.GetSpec(identity.Slug)\n   555\t\t\tif err != nil {\n   556\t\t\t\treturn \"\"\n   557\t\t\t}\n   558\t\t\tpath = sp.Path\n   559\t\t} else {\n   560\t\t\trm, err := source.GetRoadmap(identity.Slug)\n   561\t\t\tif err != nil {\n   562\t\t\t\treturn \"\"\n   563\t\t\t}\n   564\t\t\tpath = rm.Path\n   565\t\t}\n   566\t\trel, err := filepath.Rel(source.Root, path)\n   567\t\tif err != nil || rel == \"..\" || strings.HasPrefix(rel, \"..\"+string(filepath.Separator)) {\n   568\t\t\treturn \"\"\n   569\t\t}\n   570\t\trel = filepath.ToSlash(rel)\n   571\t\tif err := ValidateArtifactPathIn(files, source.Root, rel, false); err != nil {\n   572\t\t\treturn \"\"\n   573\t\t}\n   574\t\tout, err := captureFederatedGit(files, source.Root, \"log\", \"-1\", \"--format=%H\", \"--\", rel)\n   575\t\tif err != nil {\n   576\t\t\tmarkFederatedGitReadUnknown(files, source.Root, \"federated artifact history could not be read\")\n   577\t\t\treturn \"\"\n   578\t\t}\n   579\t\treturn strings.TrimSpace(string(out))\n   580\t}\n   581\t\n   582\tfunc collectFederatedRoadmapEdges(project string, rm *Roadmap) []federatedRoadmapEdge {\n   583\t\tedges := []federatedRoadmapEdge{}\n   584\t\tadd := func(raw, kind, relationship string) {\n   585\t\t\tif raw == \"\" {\n   586\t\t\t\treturn\n   587\t\t\t}\n   588\t\t\tif !strings.Contains(raw, \":\") {\n   589\t\t\t\tif kind == \"milestone\" {\n   590\t\t\t\t\traw = \"milestone:\" + rm.Slug + \"/\" + raw\n   591\t\t\t\t} else {\n   592\t\t\t\t\traw = kind + \":\" + raw\n   593\t\t\t\t}\n   594\t\t\t}\n   595\t\t\tedges = append(edges, federatedRoadmapEdge{project: project, raw: raw, relationship: relationship})\n   596\t\t}\n   597\t\tfor _, ref := range rm.DependsOn {\n   598\t\t\tadd(ref, \"roadmap\", \"prerequisite\")\n   599\t\t}\n   600\t\tfor _, ref := range rm.Consumes {\n   601\t\t\tadd(ref, \"roadmap\", \"outcome-consumption\")\n   602\t\t}\n   603\t\tfor _, milestone := range rm.Milestones {\n   604\t\t\tfor _, ref := range milestone.After {\n   605\t\t\t\tadd(ref, \"milestone\", \"prerequisite\")\n   606\t\t\t}\n   607\t\t\tfor _, ref := range milestone.Specs {\n   608\t\t\t\tadd(ref, \"spec\", \"ownership\")\n   609\t\t\t}\n   610\t\t\tfor _, ref := range milestone.Consumes {\n   611\t\t\t\tadd(ref, \"roadmap\", \"outcome-consumption\")\n   612\t\t\t}\n   613\t\t}\n   614\t\treturn edges\n   615\t}\n   616\t\n   617\tconst federatedSourceUncommitted = \"source-artifact-uncommitted\"\n   618\t\n   619\tfunc verifyFederatedArtifactAtRevision(files Files, source Store, identity ArtifactRef, resolved ArtifactResolution) error {\n   620\t\tif resolved.Revision == \"\" {\n   621\t\t\treturn fmt.Errorf(\"source-revision-unavailable\")\n   622\t\t}\n   623\t\tvar path string\n   624\t\tif identity.Kind == \"spec\" {\n   625\t\t\tsp, err := source.GetSpec(identity.Slug)\n   626\t\t\tif err != nil {\n   627\t\t\t\treturn fmt.Errorf(\"unavailable-artifact\")\n   628\t\t\t}\n   629\t\t\tpath = sp.Path\n   630\t\t} else {\n   631\t\t\trm, err := source.GetRoadmap(identity.Slug)\n   632\t\t\tif err != nil {\n   633\t\t\t\treturn fmt.Errorf(\"unavailable-artifact\")\n   634\t\t\t}\n   635\t\t\tpath = rm.Path\n   636\t\t}\n   637\t\trel, err := filepath.Rel(source.Root, path)\n   638\t\tif err != nil || rel == \"..\" || strings.HasPrefix(rel, \"..\"+string(filepath.Separator)) {\n   639\t\t\treturn fmt.Errorf(\"unavailable-artifact\")\n   640\t\t}\n   641\t\trel = filepath.ToSlash(rel)\n   642\t\tif err := ValidateArtifactPathIn(files, source.Root, rel, false); err != nil {\n   643\t\t\treturn fmt.Errorf(\"unavailable-artifact\")\n   644\t\t}\n   645\t\tcommitted, err := captureFederatedGit(files, source.Root, \"show\", resolved.Revision+\":\"+rel)\n   646\t\tif err != nil {\n   647\t\t\treturn fmt.Errorf(\"source-revision-unavailable\")\n   648\t\t}\n   649\t\tsum := sha256.Sum256(committed)\n   650\t\tif hex.EncodeToString(sum[:]) != resolved.Digest {\n   651\t\t\treturn errors.New(federatedSourceUncommitted)\n   652\t\t}\n   653\t\treturn nil\n   654\t}\n   655\t\n   656\tfunc federatedGitlinkMatchesIn(files Files, parent, child Store, revision string) bool {\n   657\t\ttop, err := captureFederatedGit(files, child.Root, \"rev-parse\", \"--show-toplevel\")\n   658\t\tif err != nil {\n   659\t\t\tmarkFederatedGitReadUnknown(files, child.Root, \"federated child Git root could not be identified\")\n   660\t\t\treturn true // sibling checkouts have no consumer gitlink to compare.\n   661\t\t}\n   662\t\tif !sameProjectRoot(files, child.Root, strings.TrimSpace(string(top))) {\n   663\t\t\treturn true // sibling checkouts have no consumer gitlink to compare.\n   664\t\t}\n   665\t\tparentTop, err := captureFederatedGit(files, parent.Root, \"rev-parse\", \"--show-toplevel\")\n   666\t\tif err != nil {\n   667\t\t\tmarkFederatedGitReadUnknown(files, parent.Root, \"federated parent Git root could not be identified\")\n   668\t\t\treturn true\n   669\t\t}\n   670\t\tif !sameProjectRoot(files, parent.Root, strings.TrimSpace(string(parentTop))) {\n   671\t\t\treturn true\n   672\t\t}\n   673\t\tparentReal, err1 := files.EvalSymlinks(parent.Root)\n   674\t\tchildReal, err2 := files.EvalSymlinks(child.Root)\n   675\t\tif err1 != nil || err2 != nil {\n   676\t\t\treturn false\n   677\t\t}\n   678\t\trel, err := filepath.Rel(parentReal, childReal)\n   679\t\tif err != nil || rel == \"..\" || strings.HasPrefix(rel, \"..\"+string(filepath.Separator)) {\n   680\t\t\treturn true // sibling project, explicitly selected in Roots.\n   681\t\t}\n   682\t\tlisting, err := captureFederatedGit(files, parent.Root, \"ls-tree\", \"HEAD\", \"--\", filepath.ToSlash(rel))\n   683\t\tif err != nil {\n   684\t\t\treturn false\n   685\t\t}\n   686\t\tfields := strings.Fields(string(listing))\n   687\t\tif len(fields) < 3 || fields[0] != \"160000\" || fields[1] != \"commit\" {\n   688\t\t\treturn false\n   689\t\t}\n   690\t\treturn fields[2] == revision\n   691\t}\n   692\t\n   693\t// federatedGitlinkMatches reads the filesystem directly; federatedGitlinkMatchesIn reads the operation's files.\n   694\tfunc federatedGitlinkMatches(parent, child Store, revision string) bool {\n   695\t\treturn federatedGitlinkMatchesIn(NativeFiles(), parent, child, revision)\n   696\t}\n   697\t\n   698\tfunc federatedSourceProof(files Files, source Store, identity ArtifactRef, pinnedRevision string) (string, string, string, string, []string, []FederatedDependencyEvidence, []string) {\n   699\t\tscope := localFederatedScope(identity)\n   700\t\tstate, err := source.GetCloseoutState(scope)\n   701\t\tif err != nil || !state.Terminal {\n   702\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-not-terminal\"}\n   703\t\t}\n   704\t\t// A milestone or roadmap the source closed without its own review, under\n   705\t\t// its adopted closeout review policy, is proven by the receipt of that\n   706\t\t// close: the source's policy decides, never the consumer's. Its members\n   707\t\t// are federated with their own reviews (spec\n   708\t\t// pose-closeout-review-policy-by-cost-benefit).\n   709\t\tif receipt := state.CloseoutReceipt; receipt != nil && !receipt.Decision.Required && (identity.Kind == \"milestone\" || identity.Kind == \"roadmap\") {\n   710\t\t\traw, err := json.Marshal(receipt)\n   711\t\t\tif err != nil {\n   712\t\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-receipt-unreadable\"}\n   713\t\t\t}\n   714\t\t\treturn \"closeout-receipt:\" + scope, \"sha256:\" + digestHex(raw), receipt.SubjectDigest, receipt.PolicyDigest, nil, nil, nil\n   715\t\t}\n   716\t\tverification, err := source.VerifyReviewBundle(scope)\n   717\t\t// A milestone its roadmap declares has no review of its own: what a consumer can\n   718\t\t// hold is the review of that roadmap, which sealed the declaration.\n   719\t\tif err == nil && identity.Kind == \"milestone\" && strings.HasPrefix(verification.ApprovalOrigin, \"declared:\") {\n   720\t\t\tverification, err = source.VerifyReviewBundle(\"roadmap:\" + identity.Slug)\n   721\t\t}\n   722\t\tif err != nil || !verification.Fresh || !verification.Approved || verification.Bundle == nil || verification.Attestation == nil || !source.sealedDeclarationHolds(verification.Bundle) {\n   723\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-review-not-approved\"}\n   724\t\t}\n   725\t\tbundle := verification.Bundle\n   726\t\teligible := federatedSourceEvidenceEligibilityIn(files, source.Root, pinnedRevision, bundle.Payload.Subject.Head)\n   727\t\tif identity.Kind == \"spec\" {\n   728\t\t\tspec, err := source.GetSpec(identity.Slug)\n   729\t\t\tif err != nil {\n   730\t\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":unavailable-artifact\"}\n   731\t\t\t}\n   732\t\t\ttargets, _, err := ParseDeliveryTargets(*spec)\n   733\t\t\tif err != nil || len(targets) == 0 {\n   734\t\t\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, nil, []string{scope + \":source-delivery-target-missing\"}\n   735\t\t\t}\n   736\t\t\tprofiles, err := loadFederatedDeliveryProfiles(files, source.Root)\n   737\t\t\tif err != nil {\n   738\t\t\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, nil, []string{scope + \":source-delivery-profile-unavailable\"}\n   739\t\t\t}\n   740\t\t\tblockers := []string{}\n   741\t\t\tfor _, target := range targets {\n   742\t\t\t\tprofile, ok := profiles[target.Profile]\n   743\t\t\t\tif !ok || profile.Kind != target.Kind {\n   744\t\t\t\t\tblockers = append(blockers, scope+\":source-delivery-profile-unsupported\")\n   745\t\t\t\t\tcontinue\n   746\t\t\t\t}\n   747\t\t\t\tseen := map[string]bool{}\n   748\t\t\t\tfor _, evidence := range bundle.Payload.Evidence {\n   749\t\t\t\t\tif eligible(evidence) && moduleMatchesTarget(evidence.Module, target.Module) {\n   750\t\t\t\t\t\tseen[evidence.EvidenceClass] = true\n   751\t\t\t\t\t}\n   752\t\t\t\t}\n   753\t\t\t\tfor _, required := range profile.RequiredEvidenceClasses {\n   754\t\t\t\t\tif !seen[required] {\n   755\t\t\t\t\t\tblockers = append(blockers, scope+\":source-delivery-evidence-missing:\"+target.Ref+\":\"+required)\n   756\t\t\t\t\t}\n   757\t\t\t\t}\n   758\t\t\t\tif len(profile.AnyEvidenceClasses) > 0 {\n   759\t\t\t\t\tfound := false\n   760\t\t\t\t\tfor _, class := range profile.AnyEvidenceClasses {\n   761\t\t\t\t\t\tfound = found || seen[class]\n   762\t\t\t\t\t}\n   763\t\t\t\t\tif !found {\n   764\t\t\t\t\t\tblockers = append(blockers, scope+\":source-delivery-evidence-missing:\"+target.Ref+\":one-of\")\n   765\t\t\t\t\t}\n   766\t\t\t\t}\n   767\t\t\t}\n   768\t\t\tproof := federatedBundleEvidence(files, bundle, eligible)\n   769\t\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, proof, uniqueSorted(blockers)\n   770\t\t}\n   771\t\treturn bundle.BundleID, bundle.BundleDigest, bundle.Payload.Subject.ImplementationDigest, bundle.Payload.Plan.PlanDigest, bundle.Payload.GoverningContracts, federatedBundleEvidence(files, bundle, eligible), nil\n   772\t}\n   773\t\n   774\t// A fresh approved source bundle already checked provenance. A carried result\n   775\t// can additionally prove delivery only if it ran after the reviewed subject\n   776\t// and belongs to the pinned source history. An earlier or unknown result never\n   777\t// observed the implementation being federated.\n   778\tfunc federatedSourceEvidenceEligibility(root, pinnedHead, subjectHead string) func(ReviewBundleEvidence) bool {\n   779\t\treturn federatedSourceEvidenceEligibilityIn(NativeFiles(), root, pinnedHead, subjectHead)\n   780\t}\n   781\t\n   782\tfunc federatedSourceEvidenceEligibilityIn(files Files, root, pinnedHead, subjectHead string) func(ReviewBundleEvidence) bool {\n   783\t\tancestry := map[string]bool{}\n   784\t\treturn func(evidence ReviewBundleEvidence) bool {\n   785\t\t\tif evidence.Outcome != \"pass\" {\n   786\t\t\t\treturn false\n   787\t\t\t}\n   788\t\t\tif evidence.SubjectObservation == \"observed\" {\n   789\t\t\t\treturn true\n   790\t\t\t}\n   791\t\t\tif evidence.SubjectObservation != \"carried-forward\" || evidence.SubjectDigest != \"\" || evidence.ProvenanceDigest == \"\" ||\n   792\t\t\t\t!isGitRevision(subjectHead) || !isGitRevision(evidence.GitHead) || !isGitRevision(pinnedHead) {\n   793\t\t\t\treturn false\n   794\t\t\t}\n   795\t\t\tif allowed, ok := ancestry[evidence.GitHead]; ok {\n   796\t\t\t\treturn allowed\n   797\t\t\t}\n   798\t\t\tallowed := federatedGitAncestorIn(files, root, subjectHead, evidence.GitHead) &&\n   799\t\t\t\tfederatedGitAncestorIn(files, root, evidence.GitHead, pinnedHead)\n   800\t\t\tancestry[evidence.GitHead] = allowed\n   801\t\t\treturn allowed\n   802\t\t}\n   803\t}\n   804\t\n   805\tfunc localFederatedScope(identity ArtifactRef) string {\n   806\t\tif identity.Kind == \"milestone\" {\n   807\t\t\treturn \"milestone:\" + identity.Slug + \"/\" + identity.Milestone\n   808\t\t}\n   809\t\treturn identity.Kind + \":\" + identity.Slug\n   810\t}\n   811\t\n   812\tfunc federatedBundleEvidence(files Files, bundle *ReviewBundle, eligible func(ReviewBundleEvidence) bool) []FederatedDependencyEvidence {\n   813\t\tevidence := []FederatedDependencyEvidence{}\n   814\t\tfor _, item := range bundle.Payload.Evidence {\n   815\t\t\tif eligible(item) {\n   816\t\t\t\tevidence = append(evidence, FederatedDependencyEvidence{ID: item.ID, Check: item.Check, EvidenceClass: item.EvidenceClass, SubjectObservation: item.SubjectObservation})\n   817\t\t\t}\n   818\t\t}\n   819\t\tsort.Slice(evidence, func(i, j int) bool {\n   820\t\t\tif evidence[i].EvidenceClass != evidence[j].EvidenceClass {\n   821\t\t\t\treturn evidence[i].EvidenceClass < evidence[j].EvidenceClass\n   822\t\t\t}\n   823\t\t\treturn evidence[i].ID < evidence[j].ID\n   824\t\t})\n   825\t\treturn evidence\n   826\t}\n   827\t\n   828\tfunc loadFederatedDeliveryProfiles(files Files, root string) (map[string]DeliveryProfile, error) {\n   829\t\traw, err := files.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\"))\n   830\t\tif err != nil {\n   831\t\t\treturn nil, err\n   832\t\t}\n   833\t\tvar matrix struct {\n   834\t\t\tDeliveryProfiles map[string]DeliveryProfile `json:\"deliveryProfiles\"`\n   835\t\t}\n   836\t\tif err := json.Unmarshal(raw, &matrix); err != nil || len(matrix.DeliveryProfiles) == 0 {\n   837\t\t\treturn nil, fmt.Errorf(\"unsupported delivery profile contract\")\n   838\t\t}\n   839\t\treturn matrix.DeliveryProfiles, nil\n   840\t}\n   841\t\n   842\tfunc federatedOwnershipConflicts(files Files, projectRoots map[string]Store, resolver ArtifactResolver) []string {\n   843\t\towners := map[string]string{}\n   844\t\tblockers := []string{}\n   845\t\tfor project, store := range projectRoots {\n   846\t\t\troadmaps, err := store.ListRoadmaps()\n   847\t\t\tif err != nil {\n   848\t\t\t\tblockers = append(blockers, \"federated-ownership-unavailable:\"+project)\n   849\t\t\t\tcontinue\n   850\t\t\t}\n   851\t\t\tfor _, roadmap := range roadmaps {\n   852\t\t\t\tif roadmap.Status != \"active\" {\n   853\t\t\t\t\tcontinue\n   854\t\t\t\t}\n   855\t\t\t\tfor _, milestone := range roadmap.Milestones {\n   856\t\t\t\t\tfor _, raw := range milestone.Specs {\n   857\t\t\t\t\t\tif !strings.Contains(raw, \":\") {\n   858\t\t\t\t\t\t\traw = \"spec:\" + raw\n   859\t\t\t\t\t\t}\n   860\t\t\t\t\t\tresolved := resolver.Resolve(project, raw)\n   861\t\t\t\t\t\tif !resolved.Resolved || resolved.Identity.Kind != \"spec\" {\n   862\t\t\t\t\t\t\tcontinue\n   863\t\t\t\t\t\t}\n   864\t\t\t\t\t\tkey := resolved.Identity.String()\n   865\t\t\t\t\t\towner := (ArtifactRef{Project: project, Kind: \"roadmap\", Slug: roadmap.Slug}).String()\n   866\t\t\t\t\t\tif previous := owners[key]; previous != \"\" && previous != owner {\n   867\t\t\t\t\t\t\tblockers = append(blockers, \"conflicting-roadmap-ownership:\"+key)\n   868\t\t\t\t\t\t} else {\n   869\t\t\t\t\t\t\towners[key] = owner\n   870\t\t\t\t\t\t}\n   871\t\t\t\t\t}\n   872\t\t\t\t}\n   873\t\t\t}\n   874\t\t}\n   875\t\treturn uniqueSorted(blockers)\n   876\t}\n   877\t\n   878\tfunc gitHeadAtRoot(root string) string {\n   879\t\treturn gitHeadAtRootIn(NativeFiles(), root, federatedAcceptanceProducer)\n   880\t}\n   881\t\n   882\tfunc gitHeadAtRootIn(files Files, root, producer string) string {\n   883\t\ttop, err := captureFederatedGitAs(files, root, producer, \"rev-parse\", \"--show-toplevel\")\n   884\t\tif err != nil || !sameProjectRoot(files, root, strings.TrimSpace(string(top))) {\n   885\t\t\tmarkFederatedGitReadUnknown(files, root, \"federated Git root could not be identified\")\n   886\t\t\treturn \"\"\n   887\t\t}\n   888\t\tif head, err := captureFederatedGitAs(files, root, producer, \"rev-parse\", \"--verify\", \"HEAD\"); err == nil {\n   889\t\t\treturn strings.TrimSpace(string(head))\n   890\t\t} else {\n   891\t\t\tmarkFederatedGitReadUnknown(files, root, \"federated source revision could not be read\")\n   892\t\t}\n   893\t\treturn \"\"\n   894\t}\n   895\t\n   896\tconst federatedAcceptanceProducer = \"federated-acceptance\"\n   897\t\n   898\tfunc captureFederatedGit(files Files, root string, args ...string) ([]byte, error) {\n   899\t\treturn captureFederatedGitAs(files, root, federatedAcceptanceProducer, args...)\n   900\t}\n   901\t\n   902\tfunc captureFederatedGitAs(files Files, root, fallbackProducer string, args ...string) ([]byte, error) {\n   903\t\tproducer := governanceProducerFromFiles(files, fallbackProducer)\n   904\t\treturn CaptureGovernanceRawHistoryGitIn(files, root, producer, maxFederatedGovernanceInputBytes, args...)\n   905\t}\n   906\t\n   907\tfunc markFederatedGitReadUnknown(files Files, root, reason string) {\n   908\t\tview, _ := governanceReadViewFromFiles(files)\n   909\t\tif view == nil || !hasGitMetadataIn(FilesOrNative(files), root) {\n   910\t\t\treturn\n   911\t\t}\n   912\t\tif view.operation != nil && view.operation.mayOmitPrimaryRevision(root) {\n   913\t\t\treturn\n   914\t\t}\n   915\t\tproducer := governanceProducerFromFiles(files, federatedAcceptanceProducer)\n   916\t\tmarkGovernanceReadUnknownForProject(files, root, \"\", producer, reason)\n   917\t}\n   918\t\n   919\tfunc federatedGitAncestorIn(files Files, root, older, newer string) bool {\n   920\t\tproducer := governanceProducerFromFiles(files, federatedAcceptanceProducer)\n   921\t\t_, err := CaptureGovernanceRawHistoryGitIn(files, root, producer, maxFederatedGovernanceInputBytes, \"merge-base\", \"--is-ancestor\", older, newer)\n   922\t\tif err == nil {\n   923\t\t\treturn true\n   924\t\t}\n   925\t\tvar exit *exec.ExitError\n   926\t\tif errors.As(err, &exit) && exit.ExitCode() == 1 {\n   927\t\t\treturn false\n   928\t\t}\n   929\t\tmarkFederatedGitReadUnknown(files, root, \"federated evidence ancestry could not be verified\")\n   930\t\treturn false\n   931\t}\n   932\t\n   933\tfunc projectResolutionState(err error) string {\n   934\t\tvar conflict ProjectBindingConflictError\n   935\t\tvar ambiguous ProjectAmbiguousError\n   936\t\tif strings.Contains(err.Error(), \"unknown project\") {\n   937\t\t\treturn \"unknown-project\"\n   938\t\t}\n   939\t\tif strings.Contains(err.Error(), \"unavailable\") {\n   940\t\t\treturn \"unavailable-project\"\n   941\t\t}\n   942\t\tif errors.As(err, &conflict) || errors.As(err, &ambiguous) {\n   943\t\t\treturn \"conflicting-project-binding\"\n   944\t\t}\n   945\t\treturn \"unavailable-project\"\n   946\t}\n","exit_code":0,"status":"completed"}}
