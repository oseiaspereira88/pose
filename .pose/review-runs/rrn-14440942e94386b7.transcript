{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '170,390p' pose-mcp/internal/pose/artifact_ref.go\"","aggregated_output":"\t\treturn out\n\t}\n\tvar pending bool\n\tvar operationID string\n\tif s.specs != nil {\n\t\t// One read of the project's transfer plans for the whole operation.\n\t\ts.specs.transfersOnce.Do(func() { s.specs.transfers = listTransfers(r.fsys(), s.Root) })\n\t\toperationID, pending = incompleteTransferIn(r.fsys(), s.Root, ref, s.specs.transfers)\n\t} else {\n\t\toperationID, pending = incompleteTransferFor(r.fsys(), s.Root, ref)\n\t}\n\tif pending {\n\t\tout.State = \"transfer-in-progress\"\n\t\tout.OperationID = operationID\n\t\treturn out\n\t}\n\tpolicyPath := filepath.Join(s.Root, \".pose\", \"policy\", \"review.json\")\n\tif _, err := r.fsys().Lstat(policyPath); err == nil && !artifactPathWithin(r.fsys(), s.Root, policyPath) {\n\t\tout.State = \"unsupported-artifact-contract\"\n\t\treturn out\n\t}\n\tif raw, err := r.fsys().ReadFile(policyPath); err == nil {\n\t\tvar policy struct {\n\t\t\tSchemaVersion   int `json:\"schema_version\"`\n\t\t\tRefsVersion     int `json:\"qualified_artifact_refs_version\"`\n\t\t\tTransferVersion int `json:\"spec_authority_transfer_version\"`\n\t\t}\n\t\tif json.Unmarshal(raw, &policy) != nil {\n\t\t\tout.State = \"unsupported-artifact-contract\"\n\t\t\treturn out\n\t\t}\n\t\trefsRequired := policy.SchemaVersion == QualifiedArtifactPolicySchemaVersion || policy.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion\n\t\ttransferValid := policy.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion && policy.TransferVersion == 1 || policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && policy.TransferVersion == 0\n\t\trefsCompatible := policy.RefsVersion == 0 || policy.RefsVersion == 1 && refsRequired\n\t\tif policy.SchemaVersion == CloseoutReviewPolicySchemaVersion {\n\t\t\t// Schema 5 (closeout review pair) keeps references and transfer\n\t\t\t// optional: 0, or 1 as schemas 3 and 4 define them.\n\t\t\trefsCompatible = policy.RefsVersion == 0 || policy.RefsVersion == 1\n\t\t\ttransferValid = policy.TransferVersion == 0 || policy.TransferVersion == 1 && policy.RefsVersion == 1\n\t\t}\n\t\tif !refsCompatible || refsRequired && policy.RefsVersion != 1 || policy.SchemaVersion > CloseoutReviewPolicySchemaVersion || !transferValid {\n\t\t\tout.State = \"unsupported-artifact-contract\"\n\t\t\treturn out\n\t\t}\n\t} else if !os.IsNotExist(err) {\n\t\tout.State = \"unavailable-project\"\n\t\treturn out\n\t}\n\tvar body string\n\tvar deps []string\n\tswitch ref.Kind {\n\tcase \"spec\":\n\t\tredirect, found, err := readSpecTransferRedirect(r.fsys(), s, ref)\n\t\tif err != nil {\n\t\t\tout.State = \"invalid-spec-redirect\"\n\t\t\treturn out\n\t\t}\n\t\tif found {\n\t\t\tkey := ref.String()\n\t\t\tmaxDepth := 16\n\t\t\tif r.governanceDepthLimit > 0 {\n\t\t\t\tmaxDepth = r.governanceDepthLimit\n\t\t\t}\n\t\t\tif redirectPath[key] {\n\t\t\t\tout.State = \"redirect-cycle\"\n\t\t\t\treturn out\n\t\t\t}\n\t\t\tif redirectDepth >= maxDepth {\n\t\t\t\tr.markResolutionBudgetUnknown(ref.Project, \"artifact redirect chain exceeded its depth budget\")\n\t\t\t\tout.State = \"resolution-limit\"\n\t\t\t\treturn out\n\t\t\t}\n\t\t\tredirectPath[key] = true\n\t\t\ttarget := r.resolve(redirect.Destination.Project, redirect.Destination.String(), redirectPath, redirectDepth+1)\n\t\t\tdelete(redirectPath, key)\n\t\t\tif !target.Resolved {\n\t\t\t\tout.State = \"redirect-target-\" + target.State\n\t\t\t\treturn out\n\t\t\t}\n\t\t\tcanonical := target.Identity\n\t\t\tif target.CanonicalIdentity != nil {\n\t\t\t\tcanonical = *target.CanonicalIdentity\n\t\t\t}\n\t\t\tout.Resolved, out.State, out.Redirected = true, \"redirected\", true\n\t\t\tout.CanonicalIdentity = &canonical\n\t\t\tout.Status, out.Revision, out.Digest = target.Status, target.Revision, target.Digest\n\t\t\tout.Dependencies = append([]ArtifactRef{}, target.Dependencies...)\n\t\t\tout.redirectCrossings = 1 + target.redirectCrossings\n\t\t\treturn out\n\t\t}\n\t\tsp, err := s.GetSpec(ref.Slug)\n\t\tif err != nil {\n\t\t\tout.State = \"unknown-spec\"\n\t\t\tvar duplicate SpecIdentityConflictError\n\t\t\tif errors.As(err, &duplicate) {\n\t\t\t\tout.State = \"conflicting-artifact-identity\"\n\t\t\t}\n\t\t\treturn out\n\t\t}\n\t\tout.Status, body, deps = sp.Status, sp.Body, sp.DependsOn\n\t\tif info, err := r.fsys().Stat(sp.Path); err == nil && !info.IsDir() {\n\t\t\traw, err := r.fsys().ReadFile(sp.Path)\n\t\t\tif err != nil {\n\t\t\t\tout.State = \"unavailable-artifact\"\n\t\t\t\treturn out\n\t\t\t}\n\t\t\tbody = string(raw)\n\t\t}\n\tcase \"roadmap\", \"milestone\":\n\t\tif err := validateProjectPathIn(r.fsys(), s.Root, filepath.Join(\".pose\", \"roadmaps\", ref.Slug+\".md\")); err != nil {\n\t\t\tout.State = \"unavailable-artifact\"\n\t\t\treturn out\n\t\t}\n\t\tpath := filepath.Join(s.roadmapsDir(), ref.Slug+\".md\")\n\t\tif _, err := r.fsys().Lstat(path); os.IsNotExist(err) {\n\t\t\tout.State = \"unknown-roadmap\"\n\t\t\treturn out\n\t\t}\n\t\tif !artifactPathWithin(r.fsys(), s.Root, path) {\n\t\t\tout.State = \"unavailable-artifact\"\n\t\t\treturn out\n\t\t}\n\t\trm, err := s.GetRoadmap(ref.Slug)\n\t\tif err != nil {\n\t\t\tout.State = \"unknown-roadmap\"\n\t\t\treturn out\n\t\t}\n\t\tout.Status, body = rm.Status, rm.Body\n\t\tif raw, err := r.fsys().ReadFile(path); err == nil {\n\t\t\tbody = string(raw)\n\t\t} else {\n\t\t\tout.State = \"unavailable-artifact\"\n\t\t\treturn out\n\t\t}\n\t\tfor _, dep := range rm.DependsOn {\n\t\t\tif !strings.Contains(dep, \":\") {\n\t\t\t\tdep = \"roadmap:\" + dep\n\t\t\t}\n\t\t\tdeps = append(deps, dep)\n\t\t}\n\t\tfor _, consumed := range rm.Consumes {\n\t\t\tif !strings.Contains(consumed, \":\") {\n\t\t\t\tconsumed = \"roadmap:\" + consumed\n\t\t\t}\n\t\t\tdeps = append(deps, consumed)\n\t\t}\n\t\tif ref.Kind == \"roadmap\" {\n\t\t\tfor _, ms := range rm.Milestones {\n\t\t\t\tdeps = append(deps, \"milestone:\"+rm.Slug+\"/\"+ms.ID)\n\t\t\t}\n\t\t}\n\t\tif ref.Kind == \"milestone\" {\n\t\t\tfound := false\n\t\t\tfor _, ms := range rm.Milestones {\n\t\t\t\tif ms.ID != ref.Milestone {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif found {\n\t\t\t\t\tout.State = \"conflicting-artifact-identity\"\n\t\t\t\t\treturn out\n\t\t\t\t}\n\t\t\t\tfound = true\n\t\t\t\tdeps = append([]string{}, ms.Specs...)\n\t\t\t\tfor _, consumed := range ms.Consumes {\n\t\t\t\t\tif !strings.Contains(consumed, \":\") {\n\t\t\t\t\t\tconsumed = \"roadmap:\" + consumed\n\t\t\t\t\t}\n\t\t\t\t\tdeps = append(deps, consumed)\n\t\t\t\t}\n\t\t\t\tfor _, after := range ms.After {\n\t\t\t\t\tif !strings.Contains(after, \":\") {\n\t\t\t\t\t\tafter = \"milestone:\" + rm.Slug + \"/\" + after\n\t\t\t\t\t}\n\t\t\t\t\tdeps = append(deps, after)\n\t\t\t\t}\n\t\t\t\tout.Status = \"done\"\n\t\t\t\tfor _, rawSpec := range ms.Specs {\n\t\t\t\t\tif !strings.Contains(rawSpec, \":\") {\n\t\t\t\t\t\trawSpec = \"spec:\" + rawSpec\n\t\t\t\t\t}\n\t\t\t\t\tsp := r.resolve(ref.Project, rawSpec, redirectPath, redirectDepth)\n\t\t\t\t\tif !sp.Resolved || sp.Status != \"done\" {\n\t\t\t\t\t\tout.Status = \"pending\"\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !found {\n\t\t\t\tout.State = \"unknown-milestone\"\n\t\t\t\treturn out\n\t\t\t}\n\t\t}\n\t}\n\tif len(deps) > 256 {\n\t\tr.markResolutionBudgetUnknown(ref.Project, \"artifact dependency list exceeded its 256-edge budget\")\n\t\tout.State = \"resolution-limit\"\n\t\treturn out\n\t}\n\tfor _, dep := range deps {\n\t\tparsed, err := ParseArtifactRef(dep)\n\t\tif err != nil {\n\t\t\tout.State = \"invalid-artifact-reference\"\n\t\t\treturn out\n\t\t}\n\t\tif parsed.Project == \"\" {\n\t\t\tparsed.Project = ref.Project\n\t\t}\n\t\tout.Dependencies = append(out.Dependencies, parsed)\n\t}\n\tout.Resolved, out.State = true, \"resolved\"\n\tdigest := sha256.Sum256([]byte(body))\n\tout.Digest = hex.EncodeToString(digest[:])\n\t// rev-parse can walk to an ancestor repository: require this root to be its\n\t// own Git top level before reporting a revision for a registered project.\n\tproducer := governanceProducerFromFiles(r.fsys(), \"artifact-resolver\")\n\ttop, gitErr := CaptureGovernanceRawHistoryGitIn(r.fsys(), s.Root, producer, 1024, \"rev-parse\", \"--show-toplevel\")\n\tif gitErr != nil {\n\t\tmarkArtifactResolverRevisionUnknown(r.fsys(), s.Root, ref.Project, localProject, \"artifact source Git root could not be identified\")\n\t} else if sameProjectRoot(r.fsys(), s.Root, strings.TrimSpace(string(top))) {\n\t\trevision, revisionErr := CaptureGovernanceRawHistoryGitIn(r.fsys(), s.Root, producer, 1024, \"rev-parse\", \"--verify\", \"HEAD\")\n\t\tif revisionErr == nil && strings.TrimSpace(string(revision)) != \"\" {\n\t\t\tout.Revision = strings.TrimSpace(string(revision))\n","exit_code":0,"status":"completed"}}
