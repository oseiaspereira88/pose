rVersion != 0) {\n+\tif p.SchemaVersion == CloseoutReviewPolicySchemaVersion {\n+\t\tif p.SpecAuthorityTransferVersion != 0 && p.SpecAuthorityTransferVersion != 1 {\n+\t\t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: unsupported spec_authority_transfer_version %d\", p.SpecAuthorityTransferVersion)\n+\t\t}\n+\t\tif p.SpecAuthorityTransferVersion == 1 && p.QualifiedArtifactRefsVersion != 1 {\n+\t\t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: spec authority transfer requires qualified_artifact_refs_version 1\")\n+\t\t}\n+\t} else if (p.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion && p.SpecAuthorityTransferVersion != 1) || (p.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && p.SpecAuthorityTransferVersion != 0) {\n \t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: spec authority transfer requires review policy schema 4 and spec_authority_transfer_version 1\")\n \t}\n \tif p.SchemaVersion >= ReviewPolicySchemaVersion {\n@@ -719,7 +762,7 @@ func (s Store) parseReviewPolicy(raw []byte) (ReviewPolicy, error) {\n \t\t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: invalid schema-v2 review policy: %w\", err)\n \t\t}\n \t}\n-\tif p.SchemaVersion != ReviewSchemaVersion && p.SchemaVersion != ReviewPolicySchemaVersion && p.SchemaVersion != QualifiedArtifactPolicySchemaVersion && p.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion {\n+\tif p.SchemaVersion != ReviewSchemaVersion && p.SchemaVersion != ReviewPolicySchemaVersion && p.SchemaVersion != QualifiedArtifactPolicySchemaVersion && p.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && p.SchemaVersion != CloseoutReviewPolicySchemaVersion {\n \t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: unsupported review policy schema %d\", p.SchemaVersion)\n \t}\n \tif err := validateReviewPolicyScopes(\"identity_assurance\", p.IdentityAssurance); err != nil {\n@@ -1477,15 +1520,40 @@ func (s Store) reviewCheck(ref string) (ReviewEvaluation, error) {\n \t\treturn ReviewEvaluation{}, err\n \t}\n \teval := ReviewEvaluation{Scope: ref, ScopeDigest: digest, PolicyEnabled: policy.Enabled, Required: policy.Enabled, Fresh: false, Approved: false, Blockers: []string{}}\n-\tif !policy.Enabled {\n+\t// An adopted closeout review policy decides an aggregate scope before the\n+\t// legacy shortcuts: neither enabled=false nor an adoption cutoff weakens\n+\t// what it requires (spec pose-closeout-review-policy-by-cost-benefit).\n+\tdecision, exempt, err := s.closeoutReviewGate(ref, policy)\n+\tif err != nil {\n+\t\treturn eval, err\n+\t}\n+\teval.CloseoutReview = decision\n+\tif decision != nil {\n+\t\tif exempt {\n+\t\t\teval.Required = false\n+\t\t\teval.Fresh = true\n+\t\t\teval.ApprovalOrigin = closeoutApprovalOrigin(*decision)\n+\t\t\teval.Warnings = append(eval.Warnings, closeoutExemptionWarning(ref, *decision))\n+\t\t\treturn eval, nil\n+\t\t}\n+\t\teval.Required = true\n+\t\tif !decision.Known {\n+\t\t\teval.Blockers = append(eval.Blockers, decision.Diagnostics...)\n+\t\t\treturn eval, nil\n+\t\t}\n+\t}\n+\tif !policy.Enabled && decision == nil {\n \t\teval.Warnings = append(eval.Warnings, \"review policy is absent or disabled; closeout review is not enforced\")\n \t\treturn eval, nil\n \t}\n \tprofileRef := policy.Profiles[scope.Kind]\n \teval.Profile = profileRef\n-\trequired, err := s.reviewRequiredForScope(scope, policy)\n-\tif err != nil {\n-\t\treturn eval, err\n+\trequired := true\n+\tif decision == nil {\n+\t\trequired, err = s.reviewRequiredForScope(scope, policy)\n+\t\tif err != nil {\n+\t\t\treturn eval, err\n+\t\t}\n \t}\n \teval.Required = required\n \tif !required {\n@@ -2654,7 +2722,11 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t\t}\n \t\t\tfound = true\n \t\t\tfor _, raw := range milestone.Specs {\n-\t\t\t\tslug, external := s.milestoneMember(raw)\n+\t\t\t\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\n+\t\t\t\tif unresolved != \"\" {\n+\t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", unresolved, raw))\n+\t\t\t\t\tcontinue\n+\t\t\t\t}\n \t\t\t\tif external {\n \t\t\t\t\tif s.FederatedResolver == nil {\n \t\t\t\t\t\tblock(NewDiagnostic(\"external-member-unaccepted\", \"external member \"+raw+\" needs federated acceptance\", raw))\n@@ -2671,6 +2743,14 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t\t\t\tblock(NewDiagnostic(\"child-scope-open\", \"child \"+child.Scope+\" is not closed\", child.Scope))\n \t\t\t\t}\n \t\t\t}\n+\t\t\t// An exempt milestone has no review of its own to judge its exit\n+\t\t\t// gate: an approved member review must have judged it as it reads\n+\t\t\t// now, or the close is blocked; the review stays dispensed. This\n+\t\t\t// holds for one member too: a done spec sealed before the gate\n+\t\t\t// existed never gains it (review round 6, N21).\n+\t\t\tif decision := review.CloseoutReview; decision != nil && !decision.Required && strings.TrimSpace(milestone.ExitGate) != \"\" && !review.Approved && !s.exitGateJudgedByMember(rm.Slug, milestone, state.Children) {\n+\t\t\t\tblock(NewDiagnostic(\"milestone-exit-gate-unjudged\", \"the exit gate of \"+ref+\" is judged by no approved review: seal and review the member that carries it (the only member, or the last one once every other member is closed), or review the milestone itself (`pose review bundle \"+ref+\" --seal`)\", ref))\n+\t\t\t}\n \t\t\tbreak\n \t\t}\n \t\tif !found {\n@@ -2725,7 +2805,38 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t\t}\n \t\t}\n \t}\n-\tif !review.Required {\n+\tcloseOwed := false\n+\tif scope.Kind == \"milestone\" || scope.Kind == \"roadmap\" {\n+\t\tif policy, policyErr := s.GetReviewPolicy(); policyErr == nil && policy.CloseoutReviewAdopted() {\n+\t\t\treceipt, receiptErr := s.ReadCloseoutReceipt(ref)\n+\t\t\tif receiptErr != nil {\n+\t\t\t\tblock(OpaqueDiagnostic(\"closeout-receipt-invalid\", DiagnosticCloseout, receiptErr.Error()))\n+\t\t\t}\n+\t\t\tstate.CloseoutReceipt = receipt\n+\t\t\tif decision := review.CloseoutReview; decision != nil && receipt == nil && receiptErr == nil {\n+\t\t\t\t// Terminal members make the scope eligible, never closed: the\n+\t\t\t\t// explicit close publishes the receipt that makes it terminal.\n+\t\t\t\tcloseOwed = true\n+\t\t\t\tfor _, diagnostic := range decision.Diagnostics {\n+\t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", diagnostic, ref))\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif review.CloseoutReview == nil && receipt == nil && scope.Kind == \"roadmap\" && state.LifecycleDone && review.Required && !review.Approved {\n+\t\t\t\tdiagnostics = append(diagnostics, NewDiagnostic(\"closeout-receipt-incomplete\", \"roadmap \"+scope.Slug+\" is done with neither an approved review nor a closeout receipt; `pose close \"+ref+\"` verifies its inputs again and publishes the receipt\", ref))\n+\t\t\t}\n+\t\t}\n+\t}\n+\tstate.CloseRequired = closeOwed\n+\tif scope.Kind == \"roadmap\" && state.CloseoutReceipt != nil {\n+\t\t// A receipt stands for its cut criteria only while they still hold:\n+\t\t// the shared terminal path checks them, as the roadmap gate does.\n+\t\tfor _, blocker := range s.roadmapCriteriaBlockers(scope.Slug) {\n+\t\t\tblock(NewDiagnostic(\"closeout-receipt-gate-failed\", blocker, ref))\n+\t\t}\n+\t}\n+\t// An exemption under the adopted policy leaves the review no blockers to\n+\t// remove; only the legacy path strips review-only messages, by text.\n+\tif !review.Required && review.CloseoutReview == nil {\n \t\tstate.Blockers = removeReviewOnlyBlockers(state.Blockers)\n \t\tkept := diagnostics[:0]\n \t\tfor _, d := range diagnostics {\n@@ -2757,7 +2868,7 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \t\t}\n \t}\n \tstate.Blockers = uniqueSorted(state.Blockers)\n-\tstate.Terminal = len(state.Blockers) == 0 && (review.Approved || !review.Required) && state.LifecycleDone\n+\tstate.Terminal = len(state.Blockers) == 0 && (review.Approved || !review.Required) && state.LifecycleDone && !closeOwed\n \tif state.Terminal {\n \t\tstate.NextAction = \"none\"\n \t} else if len(state.Children) > 0 {\n@@ -2781,6 +2892,9 @@ func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutStat\n \tif state.NextAction == \"\" && scope.Kind == \"spec\" && state.FederatedAcceptance != nil && !state.FederatedAcceptance.Ready {\n \t\tstate.NextAction = \"resolve federated dependency blockers for \" + ref\n \t}\n+\tif state.NextAction == \"\" && closeOwed && len(state.Blockers) == 0 {\n+\t\tstate.NextAction = \"close \" + ref + \" with `pose close \" + ref + \"`, which publishes its closeout receipt\"\n+\t}\n \tif state.NextAction == \"\" {\n \t\tstate.NextAction = \"resolve closeout blockers for \" + ref\n \t}\n@@ -2815,6 +2929,9 @@ func closeoutNextStep(state CloseoutState, review ReviewEvaluation, ref string)\n \t\t\t\treturn step(\"continue-child\", child.Scope)\n \t\t\t}\n \t\t}\n+\t\tif state.CloseRequired && len(state.Blockers) == 0 {\n+\t\t\treturn step(\"close-scope\", ref)\n+\t\t}\n \t\treturn step(\"resolve-federated-blockers\", ref)\n \tcase !review.Approved && review.Required:\n \t\treturn step(\"record-fresh-review\", ref)\n@@ -2822,6 +2939,8 @@ func closeoutNextStep(state CloseoutState, review ReviewEvaluation, ref string)\n \t\treturn step(\"apply-lifecycle-transition\", ref)\n \tcase state.FederatedAcceptance != nil && !state.FederatedAcceptance.Ready:\n \t\treturn step(\"resolve-federated-blockers\", ref)\n+\tcase state.CloseRequired && len(state.Blockers) == 0:\n+\t\treturn step(\"close-scope\", ref)\n \t}\n \treturn step(\"resolve-closeout-blockers\", ref)\n }\n@@ -2856,6 +2975,10 @@ func (s Store) GetCloseoutStateWithFederatedAcceptance(ref, projectID string, re\n // a federated resolver must fail closed on an external member.\n func (s Store) milestoneMember(raw string) (string, bool) {\n \tref, err := ParseArtifactRef(raw)\n+\tif err == nil && ref.Project == \"\" && ref.Kind == \"spec\" && ref.Milestone == \"\" {\n+\t\t// `spec:<slug>` and `<slug>` name the same local member.\n+\t\treturn ref.Slug, false\n+\t}\n \tif err != nil || ref.Project == \"\" {\n \t\treturn raw, false\n \t}\ndiff --git a/pose-mcp/internal/pose/review_plan.go b/pose-mcp/internal/pose/review_plan.go\nindex 0782e239..5d03f40d 100644\n--- a/pose-mcp/internal/pose/review_plan.go\n+++ b/pose-mcp/internal/pose/review_plan.go\n@@ -131,6 +131,10 @@ type ReviewPlan struct {\n \tWarnings                  []string `json:\"warnings,omitempty\"`\n \tBlockers                  []string `json:\"blockers,omitempty\"`\n \tExplain                   []string `json:\"explain\"`\n+\t// CloseoutReview is the closeout-review@1 decision for a milestone or a\n+\t// roadmap under an adopted policy. Like Band it is a projection: it stays\n+\t// out of the plan digest (spec pose-closeout-review-policy-by-cost-benefit).\n+\tCloseoutReview *CloseoutReviewDecision `json:\"closeout_review,omitempty\"`\n }\n \n type reviewRepoEntry struct {\n@@ -397,6 +401,16 @@ func (s Store) ReviewPlan(ref string) (ReviewPlan, error) {\n \tif err != nil {\n \t\treturn ReviewPlan{}, err\n \t}\n+\t// Warnings and Explain enter the digest; the decision does not, so it is\n+\t// attached only as its own field. A gate that cannot answer (a corrupt or\n+\t// drifted receipt) fails the plan as it fails closeout-check.\n+\tif !s.planWithoutCloseoutGate {\n+\t\tdecision, _, gateErr := s.closeoutReviewGate(ref, policy)\n+\t\tif gateErr != nil {\n+\t\t\treturn ReviewPlan{}, gateErr\n+\t\t}\n+\t\tplan.CloseoutReview = decision\n+\t}\n \treturn plan, nil\n }\n \n@@ -1085,6 +1099,7 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \tif err != nil {\n \t\treturn criteria, blockers\n \t}\n+\tadopted, _ := s.closeoutReviewPolicyAdopted()\n \tfor _, rm := range roadmaps {\n \t\tif terminalStatuses[rm.Status] {\n \t\t\tcontinue\n@@ -1094,10 +1109,19 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \t\t\t\tcontinue\n \t\t\t}\n \t\t\tref := ScopeRef{Kind: \"milestone\", Roadmap: rm.Slug, Milestone: milestone.ID}\n-\t\t\tif member, ok := s.soleMemberOf(ref); !ok || member != scope.Slug {\n+\t\t\tmember, ok := s.soleMemberOf(ref)\n+\t\t\tcarries := ok && member == scope.Slug\n+\t\t\t// Under an adopted closeout review policy a milestone of more\n+\t\t\t// members may close without its own review; its gate is then\n+\t\t\t// judged in the review of its last member (spec\n+\t\t\t// pose-closeout-review-policy-by-cost-benefit, review round 5 N19).\n+\t\t\tif !carries && adopted {\n+\t\t\t\tcarries = s.lastOpenMemberOf(rm.Slug, milestone, scope.Slug)\n+\t\t\t}\n+\t\t\tif !carries {\n \t\t\t\tcontinue\n \t\t\t}\n-\t\t\tif done && !sealedCarries(\"milestone-exit-gate-\"+rm.Slug+\"-\"+milestone.ID) {\n+\t\t\tif done && !sealedCarries(milestoneExitGateCriterionID(rm.Slug, milestone.ID)) {\n \t\t\t\tif historyUnknown != \"\" {\n \t\t\t\t\t// Absent history is not unreadable history: the plan says it cannot\n \t\t\t\t\t// tell whether the gate was sealed, instead of silently dropping it.\n@@ -1106,8 +1130,8 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \t\t\t\tcontinue\n \t\t\t}\n \t\t\tcriteria, blockers = addReviewCriterion(criteria, ReviewPlanCriterion{\n-\t\t\t\tID:          \"milestone-exit-gate-\" + rm.Slug + \"-\" + milestone.ID,\n-\t\t\t\tDescription: \"The exit gate of milestone:\" + rm.Slug + \"/\" + milestone.ID + \" holds: \" + milestone.ExitGate,\n+\t\t\t\tID:          milestoneExitGateCriterionID(rm.Slug, milestone.ID),\n+\t\t\t\tDescription: milestoneExitGateCriterionDescription(rm.Slug, milestone.ID, milestone.ExitGate),\n \t\t\t\tRequired:    true,\n \t\t\t\tKind:        ReviewCriterionKindJudgment,\n \t\t\t\tProfiles:    []string{\"milestone-exit-gate\"},\n","exit_code":0,"status":"completed"}}
