{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/pose/closeout_receipt.go'","aggregated_output":"package pose\n\n// Closeout receipts (spec pose-closeout-review-policy-by-cost-benefit R4, R7).\n// Under an adopted closeout review policy, the explicit `pose close` of a\n// milestone or a roadmap publishes a receipt: the terminal marker of that\n// close, with the evaluator's decision and the policy it was made under. A\n// receipt is written once and never reinterpreted: a later policy change does\n// not re-evaluate it, and a different or corrupt receipt is never overwritten.\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"time\"\n)\n\nconst CloseoutReceiptSchemaVersion = 1\n\ntype CloseoutReceipt struct {\n\tSchemaVersion int    `json:\"schema_version\"`\n\tScope         string `json:\"scope\"`\n\tClosedAt      string `json:\"closed_at\"`\n\t// Review is the literal `required` or `not-required`.\n\tReview        string                 `json:\"review\"`\n\tDecision      CloseoutReviewDecision `json:\"decision\"`\n\tPolicyDigest  string                 `json:\"policy_digest\"`\n\tSubjectDigest string                 `json:\"subject_digest\"`\n\t// ExitGateDigest binds a milestone's exit gate as it was closed.\n\tExitGateDigest string `json:\"exit_gate_digest,omitempty\"`\n\t// ReviewBundle and ReviewAttestation name the verified review the close\n\t// stood on: required, or made by choice when not required.\n\tReviewBundle      string `json:\"review_bundle,omitempty\"`\n\tReviewAttestation string `json:\"review_attestation,omitempty\"`\n\tApprovalOrigin    string `json:\"approval_origin,omitempty\"`\n}\n\n// CloseoutReceiptPath is where the receipt of an aggregate scope lives.\nfunc (s Store) CloseoutReceiptPath(ref string) (string, error) {\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tbase := filepath.Join(s.Root, \".pose\", \"review-closeouts\")\n\tswitch scope.Kind {\n\tcase \"milestone\":\n\t\tif ValidateSlug(scope.Roadmap) != nil || !filepath.IsLocal(scope.Milestone) || filepath.Base(scope.Milestone) != scope.Milestone {\n\t\t\treturn \"\", fmt.Errorf(\"pose: invalid milestone scope %s\", ref)\n\t\t}\n\t\treturn filepath.Join(base, \"milestone\", scope.Roadmap, scope.Milestone+\".json\"), nil\n\tcase \"roadmap\":\n\t\tif ValidateSlug(scope.Slug) != nil {\n\t\t\treturn \"\", fmt.Errorf(\"pose: invalid roadmap scope %s\", ref)\n\t\t}\n\t\treturn filepath.Join(base, \"roadmap\", scope.Slug+\".json\"), nil\n\t}\n\treturn \"\", fmt.Errorf(\"pose: %s has no closeout receipt; only milestones and roadmaps do\", ref)\n}\n\n// ReadCloseoutReceipt returns the receipt of a scope, nil when there is none.\n// A receipt that cannot be read or does not validate is an error, never an\n// absence: it would otherwise reopen a closed scope or hide a corruption.\nfunc (s Store) ReadCloseoutReceipt(ref string) (*CloseoutReceipt, error) {\n\tpath, err := s.CloseoutReceiptPath(ref)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tinfo, err := s.fsys().Lstat(path)\n\tif os.IsNotExist(err) {\n\t\treturn nil, nil\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\tif !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, path) {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s is not a regular file of this project\", ref)\n\t}\n\traw, err := s.fsys().ReadFile(path)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\treceipt, err := parseCloseoutReceipt(raw)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt of %s: %w\", ref, err)\n\t}\n\tif receipt.Scope != ref || receipt.Decision.Scope != ref {\n\t\treturn nil, fmt.Errorf(\"pose: closeout receipt at %s names %s, not %s\", path, receipt.Scope, ref)\n\t}\n\treturn &receipt, nil\n}\n\nfunc parseCloseoutReceipt(raw []byte) (CloseoutReceipt, error) {\n\tvar receipt CloseoutReceipt\n\tif err := rejectDuplicateJSONKeysAndControls(raw); err != nil {\n\t\treturn receipt, err\n\t}\n\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n\tdecoder.DisallowUnknownFields()\n\tif err := decoder.Decode(&receipt); err != nil {\n\t\treturn receipt, err\n\t}\n\tif err := decoder.Decode(new(any)); err != io.EOF {\n\t\treturn receipt, errors.New(\"trailing content\")\n\t}\n\tif receipt.SchemaVersion != CloseoutReceiptSchemaVersion {\n\t\treturn receipt, fmt.Errorf(\"unsupported schema_version %d\", receipt.SchemaVersion)\n\t}\n\tif _, valid := reviewInstant(receipt.ClosedAt); !valid {\n\t\treturn receipt, fmt.Errorf(\"closed_at %q is not an instant\", receipt.ClosedAt)\n\t}\n\td := receipt.Decision\n\tif !d.Adopted || d.EvaluatorVersion != CloseoutReviewEvaluatorVersion || !validCloseoutReviewValue(d.PolicyValue) || d.Reason == \"\" {\n\t\treturn receipt, errors.New(\"decision is not one of \" + CloseoutReviewEvaluatorVersion)\n\t}\n\tif d.PolicyValue == CloseoutReviewNever && d.Required && d.Reason == \"\" || d.PolicyValue == CloseoutReviewAlways && !d.Required {\n\t\treturn receipt, fmt.Errorf(\"a %s decision cannot be required=%v\", d.PolicyValue, d.Required)\n\t}\n\tif receipt.Review != d.Review() {\n\t\treturn receipt, fmt.Errorf(\"review %q contradicts the recorded decision (%s)\", receipt.Review, d.Review())\n\t}\n\tif d.Required && receipt.ReviewBundle == \"\" && receipt.ApprovalOrigin == \"\" {\n\t\treturn receipt, errors.New(\"a required review names no verified review\")\n\t}\n\tif !d.Known {\n\t\treturn receipt, errors.New(\"a close cannot stand on unknown members or associations\")\n\t}\n\tif receipt.PolicyDigest == \"\" || receipt.SubjectDigest == \"\" {\n\t\treturn receipt, errors.New(\"policy_digest and subject_digest are required\")\n\t}\n\treturn receipt, nil\n}\n\n// NewCloseoutReceipt builds the receipt of a close from the evaluator's\n// decision and the verification it stood on. It writes nothing.\nfunc (s Store) NewCloseoutReceipt(ref string, decision CloseoutReviewDecision, verification ReviewEvaluation, subjectDigest string, now time.Time) (CloseoutReceipt, error) {\n\t_, raw, err := s.loadReviewPolicy()\n\tif err != nil {\n\t\treturn CloseoutReceipt{}, err\n\t}\n\t_, gate, _, err := s.closeoutSubject(ref)\n\tif err != nil {\n\t\treturn CloseoutReceipt{}, err\n\t}\n\treceipt := CloseoutReceipt{\n\t\tExitGateDigest: gate,\n\t\tSchemaVersion:  CloseoutReceiptSchemaVersion, Scope: ref, ClosedAt: now.UTC().Format(time.RFC3339),\n\t\tReview: decision.Review(), Decision: decision, PolicyDigest: \"sha256:\" + digestHex(raw), SubjectDigest: subjectDigest,\n\t\tReviewBundle: verification.BundleID, ReviewAttestation: verification.AttestationID,\n\t}\n\tif receipt.ReviewBundle == \"\" && verification.Current != nil {\n\t\treceipt.ApprovalOrigin = \"review:\" + verification.Current.ReviewID\n\t}\n\tif receipt.ReviewBundle == \"\" && receipt.ApprovalOrigin == \"\" {\n\t\treceipt.ApprovalOrigin = verification.ApprovalOrigin\n\t}\n\tif _, err := parseCloseoutReceipt(CanonicalJSON(receipt)); err != nil {\n\t\treturn CloseoutReceipt{}, fmt.Errorf(\"pose: the closeout receipt of %s would be refused: %w\", ref, err)\n\t}\n\treturn receipt, nil\n}\n\n// ErrCloseoutReceiptExists reports a receipt already published for the scope.\nvar ErrCloseoutReceiptExists = errors.New(\"pose: a closeout receipt already exists\")\n\n// PublishCloseoutReceipt publishes a receipt where none exists. It never\n// replaces one: an equal receipt is the caller's to verify, a different one\n// stays as it is.\nfunc (s Store) PublishCloseoutReceipt(receipt CloseoutReceipt) error {\n\tpath, err := s.CloseoutReceiptPath(receipt.Scope)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif existing, err := s.ReadCloseoutReceipt(receipt.Scope); err != nil {\n\t\treturn err\n\t} else if existing != nil {\n\t\treturn ErrCloseoutReceiptExists\n\t}\n\traw, err := json.MarshalIndent(receipt, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn err\n\t}\n\terr = s.fsys().Publish(path, append(raw, '\\n'), 0o644, PublishDerived, PublishExpectation{Mode: ExpectAbsent})\n\tif errors.Is(err, ErrPublishConflict) {\n\t\treturn ErrCloseoutReceiptExists\n\t}\n\treturn err\n}\n\n// A roadmap's close publishes its status and then its receipt. Between the\n// two an intent stands, so a close interrupted there reads as incomplete,\n// never as a roadmap closed before adoption (spec\n// pose-closeout-review-policy-by-cost-benefit R4, R7).\nfunc (s Store) closeoutIntentPath(ref string) (string, error) {\n\tpath, err := s.CloseoutReceiptPath(ref)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\treturn strings.TrimSuffix(path, \".json\") + \".intent.json\", nil\n}\n\n// closeoutIntentPending reports an intent on file. What cannot be read is an\n// error, which the caller treats as pending: it never proves history.\nfunc (s Store) closeoutIntentPending(ref string) (bool, error) {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tif _, err := s.fsys().Lstat(path); err == nil {\n\t\treturn true, nil\n\t} else if os.IsNotExist(err) {\n\t\treturn false, nil\n\t} else {\n\t\treturn false, err\n\t}\n}\n\n// PublishCloseoutIntent records that this engine is closing ref under the\n// adopted policy, before the roadmap's status is published.\nfunc (s Store) PublishCloseoutIntent(ref string, decision CloseoutReviewDecision, now time.Time) error {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn err\n\t}\n\traw, err := json.MarshalIndent(map[string]any{\"schema_version\": 1, \"scope\": ref, \"started_at\": now.UTC().Format(time.RFC3339), \"review\": decision.Review()}, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn err\n\t}\n\treturn s.fsys().Publish(path, append(raw, '\\n'), 0o644, PublishDerived, PublishExpectation{Mode: ExpectAny})\n}\n\n// ClearCloseoutIntent removes the intent once the receipt stands.\nfunc (s Store) ClearCloseoutIntent(ref string) error {\n\tpath, err := s.closeoutIntentPath(ref)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := s.fsys().Remove(path); err != nil && !os.IsNotExist(err) {\n\t\treturn err\n\t}\n\treturn nil\n}\n\n// roadmapCriteriaBlockers evaluates a roadmap's cut criteria from the indexed\n// delivery graph, as the roadmap gate does: a criterion that does not pass,\n// or a manual review that does not resolve inside the project. A graph that\n// cannot be read is a blocker, never a pass.\nfunc (s Store) roadmapCriteriaBlockers(slug string) []string {\n\tgraph, err := s.GetDeliveryIntegrity(\"\")\n\tif err != nil {\n\t\treturn []string{\"the cut criteria of roadmap \" + slug + \" cannot be evaluated: \" + err.Error()}\n\t}\n\tblockers := []string{}\n\tfor _, criterion := range graph.RoadmapCriteria {\n\t\tif criterion.Roadmap != slug {\n\t\t\tcontinue\n\t\t}\n\t\tif !criterion.Passed {\n\t\t\tblockers = append(blockers, criterion.ID+\": \"+strings.Join(criterion.Reasons, \"; \"))\n\t\t}\n\t\tfor _, ref := range criterion.Refs {\n\t\t\trelative, manual := strings.CutPrefix(ref, \"manual-review:\")\n\t\t\tif !manual {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tpath := filepath.Join(s.Root, filepath.FromSlash(relative))\n\t\t\tif !filepath.IsLocal(filepath.FromSlash(relative)) || !artifactPathWithin(s.fsys(), s.Root, path) {\n\t\t\t\tblockers = append(blockers, criterion.ID+\": manual review escapes project\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif info, err := s.fsys().Stat(path); err != nil || info.IsDir() {\n\t\t\t\tblockers = append(blockers, criterion.ID+\": manual review does not resolve: \"+relative)\n\t\t\t}\n\t\t}\n\t}\n\treturn blockers\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"agent_message","text":"The spec and ADR require explicit close receipts, preserve legacy closures, and keep recorded rejections and mandatory-human reviews binding. I’m tracing those rules through the aggregate readers, with particular attention to local dependencies, transferred members, and exit gates.\n"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '480,650p' pose-mcp/internal/pose/closeout_review_policy.go\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '480,650p' pose-mcp/internal/pose/closeout_review_policy.go\"","aggregated_output":"\t}\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil || (scope.Kind != \"milestone\" && scope.Kind != \"roadmap\") {\n\t\treturn nil, false, err\n\t}\n\treceipt, err := s.ReadCloseoutReceipt(ref)\n\tif err != nil {\n\t\treturn nil, false, err\n\t}\n\tif receipt != nil {\n\t\tif err := s.closeoutReceiptStands(*receipt, policy); err != nil {\n\t\t\treturn nil, false, err\n\t\t}\n\t\tdecision := receipt.Decision\n\t\treturn &decision, !decision.Required && !s.scopeReviewRecorded(ref), nil\n\t}\n\tif s.closeoutScopeHistorical(scope) || s.milestoneClosedBeforeAdoption(scope) {\n\t\treturn nil, false, nil\n\t}\n\tdecision, err := s.currentCloseoutDecision(ref, policy)\n\tif err != nil {\n\t\treturn nil, false, err\n\t}\n\treturn &decision, !decision.Required && decision.Known && !s.scopeReviewRecorded(ref), nil\n}\n\n// closeoutReceiptStands checks a receipt against the scope it closed: the\n// same canonical members. A receipt is never re-decided under a later policy,\n// but it does not carry over to a scope whose composition changed.\nfunc (s Store) closeoutReceiptStands(receipt CloseoutReceipt, policy ReviewPolicy) error {\n\t// The closed contract, read without the current policy: a later policy\n\t// never re-decides a receipt, but a scope whose composition or exit gate\n\t// changed is no longer the scope it closed.\n\tmembers, gate, diagnostics, err := s.closeoutSubject(receipt.Scope)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"pose: closeout receipt of %s cannot be checked against its scope: %w\", receipt.Scope, err)\n\t}\n\tif len(diagnostics) > 0 {\n\t\treturn fmt.Errorf(\"pose: closeout receipt of %s cannot be checked against its scope: %s\", receipt.Scope, strings.Join(diagnostics, \"; \"))\n\t}\n\tdrift := func(what string) error {\n\t\treturn fmt.Errorf(\"pose: closeout receipt of %s no longer matches its scope: its %s changed since the close; a receipt is never rewritten, so restore it or record the change in a new scope\", receipt.Scope, what)\n\t}\n\tif strings.Join(members, \",\") != strings.Join(receipt.Decision.Members, \",\") {\n\t\treturn drift(fmt.Sprintf(\"members (closed with %v, now %v)\", receipt.Decision.Members, members))\n\t}\n\tif receipt.ExitGateDigest != gate {\n\t\treturn drift(\"exit gate\")\n\t}\n\treturn nil\n}\n\n// protectCloseoutDecision restores the review when the scope itself changes\n// the review contract: an exemption the diff introduced cannot exempt the diff.\n// The decision is made a second time under the policy at the change set's base\n// revision, and a stronger answer there wins. Protection that cannot be\n// established keeps the review required.\nfunc (s Store) protectCloseoutDecision(scope ScopeRef, decision *CloseoutReviewDecision) {\n\tguard := s.resolveReviewGovernanceGuard(scope)\n\tif len(guard.Paths) == 0 {\n\t\treturn\n\t}\n\trestore := func(reason string) {\n\t\tdecision.Required = true\n\t\tdecision.Reason += \"; \" + reason\n\t}\n\tif guard.Revision == \"\" {\n\t\trestore(\"the scope changes the review contract and no protected baseline resolves: \" + guard.Reason)\n\t\treturn\n\t}\n\tbase, err := s.parseReviewPolicyAt(guard.Revision)\n\tif err != nil {\n\t\trestore(\"the protected baseline policy cannot be read: \" + err.Error())\n\t\treturn\n\t}\n\tif !base.Enabled && !base.CloseoutReviewAdopted() {\n\t\treturn\n\t}\n\tif base.ReviewerIndependence[scope.Kind] == \"mandatory-human\" {\n\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires a mandatory-human review\")\n\t\treturn\n\t}\n\t// The baseline's base profile and every overlay it adopted for this kind,\n\t// selected or not: protection is the conservative reading.\n\trefs := append([]string{}, base.OverlayProfiles...)\n\tif ref := base.Profiles[scope.Kind]; ref != \"\" {\n\t\trefs = append(refs, ref)\n\t}\n\tfor _, ref := range refs {\n\t\tprofile, err := s.parseReviewProfileAt(guard.Revision, ref)\n\t\tif err != nil || (profile.Scope == scope.Kind || ref == base.Profiles[scope.Kind]) && profile.Independence == \"mandatory-human\" {\n\t\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires a mandatory-human review or a profile of it cannot be read\")\n\t\t\treturn\n\t\t}\n\t}\n\tif !base.CloseoutReviewAdopted() {\n\t\trestore(\"the protected baseline at \" + guard.Revision + \" keeps the legacy rule, under which this scope owes its review\")\n\t\treturn\n\t}\n\tprotected, err := s.evaluateCloseoutReview(decision.Scope, base)\n\tif err != nil || protected.Required {\n\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires the review (\" + protected.PolicyKey + \"=\" + protected.PolicyValue + \")\")\n\t}\n}\n\n// closeoutSubject is what a closeout receipt binds: the canonical members of\n// the scope and, for a milestone, the digest of its exit gate (a roadmap's is\n// the gates of its milestones, which their own receipts bind).\nfunc (s Store) closeoutSubject(ref string) ([]string, string, []string, error) {\n\tscope, err := ParseScopeRef(ref)\n\tif err != nil {\n\t\treturn nil, \"\", nil, err\n\t}\n\tslug := scope.Roadmap\n\tif scope.Kind == \"roadmap\" {\n\t\tslug = scope.Slug\n\t}\n\trm, err := s.GetRoadmap(slug)\n\tif err != nil {\n\t\treturn nil, \"\", nil, err\n\t}\n\tproject, err := s.WriteProjectID()\n\tif err != nil {\n\t\treturn nil, \"\", []string{\"the project identity is unknown: \" + err.Error()}, nil\n\t}\n\tvar raws []string\n\tgate := \"\"\n\tfor _, milestone := range rm.Milestones {\n\t\tif scope.Kind == \"milestone\" && milestone.ID != scope.Milestone {\n\t\t\tcontinue\n\t\t}\n\t\traws = append(raws, milestone.Specs...)\n\t\tif scope.Kind == \"milestone\" {\n\t\t\tgate = digestText(milestone.ExitGate)\n\t\t}\n\t}\n\tif scope.Kind == \"roadmap\" {\n\t\t// A roadmap's gate is its cut criteria; its milestones' gates are\n\t\t// bound by their own receipts.\n\t\tcriteria, problems := ParseRoadmapCriteria(*rm)\n\t\traw, _ := json.Marshal(struct {\n\t\t\tCriteria []RoadmapCriterion\n\t\t\tProblems []string\n\t\t}{criteria, problems})\n\t\tgate = \"sha256:\" + digestHex(raw)\n\t}\n\tmembers, diagnostics := s.closeoutCanonicalMembers(raws, project)\n\treturn members, gate, diagnostics, nil\n}\n\n// closeoutScopeHistorical reports a scope whose roadmap was closed before\n// adoption: done, with no receipt and no close of this engine in progress,\n// and with positive evidence of its legacy closure: an approval recorded on\n// the roadmap, or the legacy rule exempting it as done before review\n// adoption. Status alone proves nothing.\n// Its milestones and itself are verified by the contract they were sealed\n// under, never re-evaluated, and no receipt is backfilled for them. A close\n// interrupted between its status and its receipt left an intent, so it stays\n// incomplete instead of reading as history.\nfunc (s Store) closeoutScopeHistorical(scope ScopeRef) bool {\n\tslug := scope.Slug\n\tif scope.Kind == \"milestone\" {\n\t\tslug = scope.Roadmap\n\t}\n\trm, err := s.GetRoadmap(slug)\n\tif err != nil || rm.Status != \"done\" {\n\t\treturn false\n\t}\n\tref := \"roadmap:\" + slug\n\tif receipt, err := s.ReadCloseoutReceipt(ref); err != nil || receipt != nil {\n\t\treturn false\n","exit_code":0,"status":"completed"}}
