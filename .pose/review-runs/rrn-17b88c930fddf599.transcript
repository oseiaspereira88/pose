heck\",\"disposition\":\"passed\",\"evidence\":\"integration:pose-mcp/go/delegated-run-continuity-integration\",\"rationale\":\"Exit 0, 0 findings.\"},\n{\"id\":\"validate\",\"disposition\":\"failed\",\"evidence\":\"unit:pose-mcp/go/test\",\"rationale\":\"Sandbox rerun: 236 steps, 225 pass, 10 fail, 1 error. Some failures report sandbox ownership of /var/tmp or a file mode change; runtime socket, journey, capability and removal-ordering failures and the 600s timeout were not fully diagnosed; they are inferred environmental. The sealed evidence records a pass.\"},\n{\"id\":\"validate\",\"component\":\"pose-mcp\",\"disposition\":\"failed\",\"evidence\":\"unit:pose-mcp/go/test\",\"rationale\":\"Sandbox rerun: 233 steps, 223 pass, 9 fail, 1 error, with the same kinds of failure; not all diagnosed. The sealed evidence records a pass.\"}\n]}\n```","ttft_ms":1694,"type":"result","duration_ms":64353,"uuid":"47ad88f9-fd80-4e19-b5f8-9aef026d5e5a","ttft_stream_ms":840,"time_to_request_ms":31,"first_content_frame_ms":840,"queued_turn_count":0,"result_index":2,"model_usage_since_last_result":{"claude-sonnet-5-5":{"inputTokens":10,"outputTokens":10820,"cacheReadInputTokens":555381,"cacheCreationInputTokens":8662,"webSearchRequests":0,"costUSD":0.19840610000000003,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":1394,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":8662,"canonicalModel":"claude-sonnet-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-24T05:32:18.381Z"}
