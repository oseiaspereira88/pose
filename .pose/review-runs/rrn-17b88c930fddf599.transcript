orktree identity changed\")\n\t\t\t}\n\t\t}\n\t\tif o == nil || o.registry == nil {\n\t\t\treturn fmt.Errorf(\"cleanup registration ownership unavailable; resources retained\")\n\t\t}\n\t\tinfo, e := o.registry.Lstat(o.registration)\n\t\tif e != nil || !info.IsDir() || !os.SameFile(info, o.registrationInfo) {\n\t\t\treturn fmt.Errorf(\"cleanup registration identity changed\")\n\t\t}\n\t\tregistration, e := o.registry.OpenRoot(o.registration)\n\t\tif e != nil {\n\t\t\treturn fmt.Errorf(\"cleanup registration unavailable\")\n\t\t}\n\t\tdefer registration.Close()\n\t\tinfo, e = registration.Stat(\".\")\n\t\tif e != nil || !os.SameFile(info, o.registrationInfo) {\n\t\t\treturn fmt.Errorf(\"cleanup registration identity changed\")\n\t\t}\n\t\tbacklink, e := readReviewRootFile(registration, \"gitdir\", 4096)\n\t\tif e != nil || strings.TrimSpace(string(backlink)) != o.backlink {\n\t\t\treturn fmt.Errorf(\"cleanup registration backlink changed\")\n\t\t}\n\t\tfor _, lock := range []string{\"locked\", \"index.lock\", \"HEAD.lock\"} {\n\t\t\tif _, e := registration.Lstat(lock); !errors.Is(e, os.ErrNotExist) {\n\t\t\t\treturn fmt.Errorf(\"worktree registration has a live or unknown lock; resources retained\")\n\t\t\t}\n\t\t}\n\t\tif err == nil {\n\t\t\ttree, e := root.OpenRoot(\"worktree\")\n\t\t\tif e != nil {\n\t\t\t\treturn fmt.Errorf(\"worktree cleanup root unavailable\")\n\t\t\t}\n\t\t\tinfo, e := tree.Stat(\".\")\n\t\t\tif e != nil || !os.SameFile(info, worktreeOwned) {\n\t\t\t\ttree.Close()\n\t\t\t\treturn fmt.Errorf(\"worktree cleanup identity changed\")\n\t\t\t}\n\t\t\tlimit := gitSnapshotMarginBytes\n\t\t\tif o.inventoryBytes > limit {\n\t\t\t\tlimit = o.inventoryBytes\n\t\t\t}\n\t\t\te = removeReviewOwnedContents(tree, 100000, limit)\n\t\t\ttree.Close()\n\t\t\tif e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tif e := root.Remove(\"worktree\"); e != nil && !errors.Is(e, os.ErrNotExist) {\n\t\t\t\treturn fmt.Errorf(\"worktree cleanup incomplete\")\n\t\t\t}\n\t\t}\n\t\tif e := removeReviewOwnedContents(registration, 1024, 256<<20); e != nil {\n\t\t\treturn e\n\t\t}\n\t\tregistration.Close()\n\t\tif e := o.registry.Remove(o.registration); e != nil && !errors.Is(e, os.ErrNotExist) {\n\t\t\treturn fmt.Errorf(\"worktree registration cleanup incomplete\")\n\t\t}\n\t} else if _, e := root.Lstat(\"worktree\"); !errors.Is(e, os.ErrNotExist) {\n\t\treturn fmt.Errorf(\"partial worktree setup has no verified ownership; resources retained\")\n\t}\n\tif o != nil && o.gitlinkMetadata != nil {\n\t\tif err := removeReviewGitlinkMetadata(root, o.gitlinkMetadata, o.gitlinkMetadataBytes); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif err := removeReviewGoBuildLeftovers(root); err != nil {\n\t\treturn err\n\t}\n\tif err := removeReviewOwnedContents(root, reviewRuntimeMaxEntries, 128<<20); err != nil {\n\t\treturn err\n\t}\n\tcurrent, err = os.Lstat(tmp)\n\tif err != nil || !os.SameFile(owned, current) {\n\t\treturn fmt.Errorf(\"runtime path changed during cleanup; replacement retained\")\n\t}\n\tif err := os.Remove(tmp); err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\treturn fmt.Errorf(\"runtime directory cleanup incomplete\")\n\t}\n\tif o != nil {\n\t\to.removed = true\n\t}\n\treturn nil\n}\n\n// Private gitlink stores are charged separately from the adapter's runtime\n// output. Both the opened directory and the removal target must be the\n// directory setup created inside the operation root.\nfunc removeReviewGitlinkMetadata(root *os.Root, owned os.FileInfo, limit int64) error {\n\tdir, err := root.OpenRoot(reviewGitlinkMetadataDir)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"private gitlink metadata cleanup unavailable\")\n\t}\n\tdefer dir.Close()\n\tinfo, err := dir.Stat(\".\")\n\tif err != nil || !os.SameFile(owned, info) {\n\t\treturn fmt.Errorf(\"private gitlink metadata identity changed\")\n\t}\n\tif err := removeReviewOwnedContents(dir, 100000, limit); err != nil {\n\t\treturn err\n\t}\n\tinfo, err = root.Lstat(reviewGitlinkMetadataDir)\n\tif err != nil || !os.SameFile(owned, info) {\n\t\treturn fmt.Errorf(\"private gitlink metadata identity changed\")\n\t}\n\tdir.Close()\n\tif err := root.Remove(reviewGitlinkMetadataDir); err != nil {\n\t\treturn fmt.Errorf(\"private gitlink metadata cleanup incomplete\")\n\t}\n\treturn nil\n}\n\n// reviewGoBuildDir names the temporary build directory the Go toolchain\n// creates under the TMPDIR the engine gives a review run.\nvar reviewGoBuildDir = regexp.MustCompile(`^go-build[0-9]+$`)\n\n// reviewGoBuildBeforeOpen runs after a go-build name is listed and before it\n// is opened, reviewGoBuildAfterContents after the directory is emptied and\n// before its name is checked again, and reviewGoBuildBeforeRemove between that\n// check and the removal; tests use them to change the name there.\nvar (\n\treviewGoBuildBeforeOpen    = func(string) {}\n\treviewGoBuildAfterContents = func(string) {}\n\treviewGoBuildBeforeRemove  = func(string) {}\n)\n\n// removeReviewGoBuildLeftovers removes the Go build directories a reviewer's\n// interrupted `go test` or `go build` left at the top of the run's runtime\n// directory, each under its own bounded inventory, before the runtime's own\n// inventory, which a single test binary can exceed (spec\n// pose-review-cleanup-removes-go-build-leftovers). Only a real directory is\n// removed; the platform implementation opens it without blocking and only as\n// a directory, so a link, a FIFO or any other entry stays for the runtime\n// inventory to judge.\nfunc removeReviewGoBuildLeftovers(root *os.Root) error {\n\t// The top level is read in bounded batches and each go-build directory\n\t// is removed as it is read, so nothing accumulates; only the other\n\t// entries, which the runtime inventory will judge, count against its\n\t// bound (review rounds 5 and 6, N6 and N10).\n\tdir, err := root.Open(\".\")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n\t}\n\tdefer dir.Close()\n\tothers := 0\n\tfor {\n\t\tbatch, err := dir.Readdirnames(256)\n\t\tfor _, name := range batch {\n\t\t\tif !reviewGoBuildDir.MatchString(name) {\n\t\t\t\tothers++\n\t\t\t\tif others > reviewRuntimeMaxEntries {\n\t\t\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif err := removeReviewGoBuildDir(root, name); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\tif len(batch) == 0 {\n\t\t\tif err == nil || errors.Is(err, io.EOF) {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n\t\t}\n\t}\n}\n\n// reviewRuntimeMaxEntries is the runtime inventory's own entry bound.\nconst reviewRuntimeMaxEntries = 4096\n\nfunc removeReviewOwnedContents(root *os.Root, maxFiles int, maxBytes int64) error {\n\tpaths := []string{}\n\tvar total int64\n\terr := fs.WalkDir(root.FS(), \".\", func(path string, d fs.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif path == \".\" {\n\t\t\treturn nil\n\t\t}\n\t\tif len(paths) >= maxFiles || strings.Count(path, \"/\") > 128 {\n\t\t\treturn fmt.Errorf(\"cleanup inventory exceeds coverage\")\n\t\t}\n\t\tinfo, err := d.Info()\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif info.Mode().IsRegular() {\n\t\t\ttotal += info.Size()\n\t\t\tif total > maxBytes {\n\t\t\t\treturn fmt.Errorf(\"cleanup inventory exceeds bytes\")\n\t\t\t}\n\t\t}\n\t\tpaths = append(paths, path)\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn fmt.Errorf(\"runtime cleanup inventory incomplete; resources retained\")\n\t}\n\tfor i := len(paths) - 1; i >= 0; i-- {\n\t\tif err := root.Remove(paths[i]); err != nil && !errors.Is(err, os.ErrNotExist) {\n\t\t\treturn fmt.Errorf(\"runtime cleanup incomplete; resources retained\")\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc reviewSafetyConflict(run ReviewRun) string {\n\tif run.Safety == nil {\n\t\treturn \"\"\n\t} // Historical runs have no invented observations.\n\tif run.Safety.SchemaVersion != 1 || (run.Status == ReviewRunCompleted && !run.Safety.CaptureComplete) {\n\t\treturn \"adapter capture incomplete\"\n\t}\n\tif run.Safety.Operation.Outcome != OutcomeCompleted {\n\t\treturn \"adapter cleanup incomplete\"\n\t}\n\treturn \"\"\n}\n\nfunc existingReviewDispatchResult(run ReviewRun) (ReviewRun, error) {\n\tif run.Safety != nil && run.Safety.Operation.Outcome != OutcomeCompleted {\n\t\treturn run, fmt.Errorf(\"existing dispatch has incomplete cleanup; no new adapter was started\")\n\t}\n\treturn run, nil\n}\n","numLines":276,"startLine":500,"totalLines":775}},"tool_result_meta":[{"id":"toolu_013GWdhnvNCBmQvkH22AofWr","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChRMcMRXri3iMeCwTaDDn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GFAtdL5cuBuaAgLqu9j5gE","name":"Read","input":{"file_path":"/var/tmp/pose-work-go/pose-review-run-c037f4c5c6/worktree/pose-mcp/internal/pose/review_run_continuity.go","offset":270,"limit":320},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9061,"cache_read_input_tokens":44701,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9061},"output_tokens":17,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"092780df-867b-4d01-9476-fd2f532c05d0","timestamp":"2026-11-26T10:08:54.879Z","request_id":"req_011ChRMcMEsJxzGFLfzex7Km","wire_tool_inputs":{"toolu_01GFAtdL5cuBuaAgLqu9j5gE":{"file_path":"/var/tmp/pose-work-go/pose-review-run-c037f4c5c6/worktree/pose-mcp/internal/pose/review_run_continuity.go","offset":270,"limit":320}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GFAtdL5cuBuaAgLqu9j5gE","type":"tool_result","content":"270\t\t\t\tinterruption.ResetAt = t.UTC().Format(time.RFC3339Nano)\n271\t\t\t}\n272\t\t}\n273\t\trun.Interruption = interruption\n274\t\treturn ReviewRunInterrupted, \"review interrupted: \" + cause + \" (supervisor: \" + supervisorCause + \")\", nil\n275\t}\n276\tfunc validateContinuityRun(r ReviewRun) error {\n277\t\tif r.Status == ReviewRunInterrupted {\n278\t\t\tif r.Interruption == nil {\n279\t\t\t\treturn fmt.Errorf(\"interrupted run has no cause\")\n280\t\t\t}\n281\t\t\tswitch r.Interruption.Cause {\n282\t\t\tcase \"usage-limit\", \"timeout\", \"process-lost\", \"cancelled\", \"unknown\":\n283\t\t\tdefault:\n284\t\t\t\treturn fmt.Errorf(\"invalid interruption cause\")\n285\t\t\t}\n286\t\t\tif r.Interruption.ResetAt != \"\" {\n287\t\t\t\tif _, e := time.Parse(time.RFC3339Nano, r.Interruption.ResetAt); e != nil {\n288\t\t\t\t\treturn e\n289\t\t\t\t}\n290\t\t\t}\n291\t\t\tif r.Interruption.Resumable && (r.SessionDigest == \"\" || r.TreeDigest == \"\" || r.AttemptID == \"\") {\n292\t\t\t\treturn fmt.Errorf(\"resumable run lacks bound evidence\")\n293\t\t\t}\n294\t\t\tif r.PartialDigest != digestBytes([]byte(r.Output)) {\n295\t\t\t\treturn fmt.Errorf(\"partial draft digest differs\")\n296\t\t\t}\n297\t\t} else if r.Interruption != nil {\n298\t\t\treturn fmt.Errorf(\"terminal run contains interruption metadata\")\n299\t\t}\n300\t\treturn nil\n301\t}\n302\tfunc continuationPath(run string, result bool) string {\n303\t\tsuffix := \".json\"\n304\t\tif result {\n305\t\t\tsuffix = \".result.json\"\n306\t\t}\n307\t\treturn filepath.ToSlash(filepath.Join(reviewContinuationsDir, run+suffix))\n308\t}\n309\tfunc (s Store) claimReviewContinuation(r ReviewRun, at time.Time) error {\n310\t\traw, _ := json.Marshal(r)\n311\t\t// Clear reader-only fields before deriving the predecessor digest.\n312\t\tr.Path, r.SupersededBy = \"\", \"\"\n313\t\traw, _ = json.Marshal(r)\n314\t\tnonce := make([]byte, 16)\n315\t\tif _, err := rand.Read(nonce); err != nil {\n316\t\t\treturn err\n317\t\t}\n318\t\treturn publishLedgerJSON(s.Root, continuationPath(r.RunID, false), reviewContinuation{1, r.RunID, r.AttemptID, digestBytes(raw), at.UTC().Format(time.RFC3339Nano), hex.EncodeToString(nonce)})\n319\t}\n320\tfunc (s Store) finishReviewContinuation(r ReviewRun) error {\n321\t\traw, _ := json.Marshal(r)\n322\t\treceipt := reviewAttemptReceipt{1, r.AttemptID, r.RunID, digestBytes(raw)}\n323\t\treturn publishLedgerJSON(s.Root, continuationPath(r.continues(), true), receipt)\n324\t}\n325\tfunc (s Store) existingReviewContinuation(r ReviewRun, runs []ReviewRun) (*ReviewRun, error) {\n326\t\tvar claim reviewContinuation\n327\t\te := readLedgerJSON(filepath.Join(s.Root, continuationPath(r.RunID, false)), &claim)\n328\t\tif errors.Is(e, os.ErrNotExist) {\n329\t\t\treturn nil, nil\n330\t\t}\n331\t\tif e != nil {\n332\t\t\treturn nil, e\n333\t\t}\n334\t\tcopy := r\n335\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n336\t\traw, _ := json.Marshal(copy)\n337\t\tif claim.SchemaVersion != 1 || claim.Predecessor != r.RunID || claim.AttemptID != r.AttemptID || claim.PredecessorDigest != digestBytes(raw) {\n338\t\t\treturn nil, fmt.Errorf(\"continuation predecessor changed\")\n339\t\t}\n340\t\tvar receipt reviewAttemptReceipt\n341\t\tif e = readLedgerJSON(filepath.Join(s.Root, continuationPath(r.RunID, true)), &receipt); e != nil {\n342\t\t\treturn nil, &PendingReviewContinuation{ID: \"resume-of:\" + r.RunID, Predecessor: r.RunID, AttemptID: r.AttemptID}\n343\t\t}\n344\t\tfor _, next := range runs {\n345\t\t\tif next.RunID == receipt.RunID {\n346\t\t\t\tcopy := next\n347\t\t\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n348\t\t\t\traw, _ := json.Marshal(copy)\n349\t\t\t\tif receipt.SchemaVersion != 1 || receipt.AttemptID != r.AttemptID || next.AttemptID != r.AttemptID || next.continues() != r.RunID || receipt.RunDigest != digestBytes(raw) {\n350\t\t\t\t\treturn nil, fmt.Errorf(\"invalid continuation receipt\")\n351\t\t\t\t}\n352\t\t\t\treturn &next, nil\n353\t\t\t}\n354\t\t}\n355\t\treturn nil, fmt.Errorf(\"continuation result is missing\")\n356\t}\n357\t\n358\t// PlanReviewResume validates original evidence, policy and all accumulated budgets.\n359\tfunc (s Store) PlanReviewResume(id string) (DispatchPlan, error) {\n360\t\truns, lost, e := s.ReadReviewRuns(\"\")\n361\t\tif e != nil {\n362\t\t\treturn DispatchPlan{}, e\n363\t\t}\n364\t\tif len(lost) > 0 {\n365\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume history incomplete: %v\", lost)\n366\t\t}\n367\t\tvar prior *ReviewRun\n368\t\tfor i := range runs {\n369\t\t\tif runs[i].RunID == id {\n370\t\t\t\tprior = &runs[i]\n371\t\t\t}\n372\t\t}\n373\t\tif prior == nil {\n374\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume predecessor not found\")\n375\t\t}\n376\t\tif prior.Status != ReviewRunInterrupted || prior.Interruption == nil || !prior.Interruption.Resumable {\n377\t\t\treturn DispatchPlan{}, fmt.Errorf(\"run is %s or not resumable\", prior.Status)\n378\t\t}\n379\t\tif why := s.reviewRunTranscriptIntact(*prior); why != \"\" {\n380\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume: %s\", why)\n381\t\t}\n382\t\tpolicy, _, e := s.LoadReviewersPolicyFor(prior.Kind)\n383\t\tif e != nil {\n384\t\t\treturn DispatchPlan{}, e\n385\t\t}\n386\t\tconfig, ok := policy.Adapters[prior.Adapter]\n387\t\tif !ok || config.Resume == nil || len(config.Resume.Command) == 0 {\n388\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume adapter declaration missing\")\n389\t\t}\n390\t\tbrief, e := s.RenderReviewBriefMatching(prior.BundleID, prior.Kind, prior.BriefNotes, prior.BriefDigest)\n391\t\tif e != nil {\n392\t\t\treturn DispatchPlan{}, e\n393\t\t}\n394\t\tbundle, e := s.LoadReviewBundle(prior.BundleID)\n395\t\tif e != nil {\n396\t\t\treturn DispatchPlan{}, e\n397\t\t}\n398\t\tif brief.Digest != prior.BriefDigest || bundle.BundleDigest != prior.BundleDigest || bundle.Payload.Subject.Head != prior.SealedCommit {\n399\t\t\treturn DispatchPlan{}, fmt.Errorf(\"resume bundle or brief digest changed\")\n400\t\t}\n401\t\torigin, e := dispatchWorktreeIdentity(s.Root)\n402\t\tif e != nil {\n403\t\t\treturn DispatchPlan{}, e\n404\t\t}\n405\t\tif prior.Safety != nil && prior.Safety.Operation.Outcome != OutcomeCompleted {\n406\t\t\treturn DispatchPlan{}, fmt.Errorf(\"predecessor cleanup incomplete; refusing continuation beside possible orphan\")\n407\t\t}\n408\t\tplan := DispatchPlan{predecessor: prior, notes: prior.BriefNotes, Reason: prior.Reason, PolicyDigest: prior.PolicyDigest, OriginWorktree: origin, Adapter: prior.Adapter, Config: config, Brief: brief, Bundle: bundle, SealedCommit: prior.SealedCommit}\n409\t\tcontinuationRound(&plan, *prior, false)\n410\t\tif e = s.checkDispatchOrigin(plan); e != nil {\n411\t\t\treturn DispatchPlan{}, e\n412\t\t}\n413\t\texisting, e := s.existingReviewContinuation(*prior, runs)\n414\t\tif e != nil {\n415\t\t\tvar pending *PendingReviewContinuation\n416\t\t\tif errors.As(e, &pending) {\n417\t\t\t\tplan.PendingContinuation = pending\n418\t\t\t\treturn plan, nil\n419\t\t\t}\n420\t\t\treturn DispatchPlan{}, e\n421\t\t}\n422\t\tif existing != nil {\n423\t\t\tif existing.HandsOffFrom == prior.RunID {\n424\t\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was handed off to run %s; it is not resumed\", prior.RunID, existing.RunID)\n425\t\t\t}\n426\t\t\tplan.Existing = existing\n427\t\t\treturn plan, nil\n428\t\t}\n429\t\t// Only a continuation still to start needs the attempt's runtime\n430\t\t// directory free; a repeated resume returns the recorded one.\n431\t\tif e = reviewRunRuntimeDirFree(prior.AttemptID); e != nil {\n432\t\t\treturn DispatchPlan{}, e\n433\t\t}\n434\t\t// The attempt's budget, not this agent's: after a handoff the resumed\n435\t\t// agent may declare another (spec pose-delegation-handoff R2).\n436\t\tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\n437\t\tif e != nil {\n438\t\t\treturn DispatchPlan{}, e\n439\t\t}\n440\t\tif count >= limit || spent >= total {\n441\t\t\treturn DispatchPlan{}, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"resume budget exhausted: %d resumes, %s wall-clock\", count, spent))\n442\t\t}\n443\t\ttimeout := 60 * time.Minute\n444\t\tif config.Timeout != \"\" {\n445\t\t\ttimeout, _ = time.ParseDuration(config.Timeout)\n446\t\t}\n447\t\tif total-spent < timeout {\n448\t\t\ttimeout = total - spent\n449\t\t}\n450\t\tplan.processTimeout = timeout\n451\t\t// A continuation runs the same agent the attempt was routed to.\n452\t\tplan.Routing = prior.Routing\n453\t\ts.planImplementation(&plan, prior.Lead)\n454\t\tplan.provenance, e = s.prepareRunProvenance(plan, policy)\n455\t\tif e != nil {\n456\t\t\treturn DispatchPlan{}, e\n457\t\t}\n458\t\tplan.session, e = s.readReviewSession(prior.SessionDigest)\n459\t\tif e != nil {\n460\t\t\treturn DispatchPlan{}, e\n461\t\t}\n462\t\treturn plan, nil\n463\t}\n464\t\n465\t// ReviewResumeDelay computes a bounded, non-polling wait; callers revalidate afterwards.\n466\tfunc ReviewResumeDelay(r ReviewRun, now time.Time, max time.Duration, jitter time.Duration) (time.Duration, error) {\n467\t\tif r.Interruption == nil || r.Interruption.ResetAt == \"\" {\n468\t\t\treturn 0, fmt.Errorf(\"no recorded reset instant\")\n469\t\t}\n470\t\tif max <= 0 || max > 24*time.Hour || jitter < 0 || jitter > time.Second {\n471\t\t\treturn 0, fmt.Errorf(\"wait bound must be positive and at most 24h; jitter at most 1s\")\n472\t\t}\n473\t\treset, e := time.Parse(time.RFC3339Nano, r.Interruption.ResetAt)\n474\t\tif e != nil {\n475\t\t\treturn 0, e\n476\t\t}\n477\t\tdelay := reset.Sub(now)\n478\t\tif delay < 0 {\n479\t\t\tdelay = 0\n480\t\t}\n481\t\tdelay += jitter\n482\t\tif delay > max {\n483\t\t\treturn 0, fmt.Errorf(\"recorded reset exceeds maximum wait\")\n484\t\t}\n485\t\treturn delay, nil\n486\t}\n487\t\n488\t// Continuation inventories use the same bounds as the attempt ledger. Pending\n489\t// claims are observable operations, not proof of a completed review.\n490\tfunc (s Store) reviewContinuationFindings(runs []ReviewRun) []string {\n491\t\tfiles := s.fsys()\n492\t\tentries, e := ledgerEntriesIn(files, s.Root, reviewContinuationsDir)\n493\t\tif e != nil {\n494\t\t\treturn []string{e.Error()}\n495\t\t}\n496\t\tbyID := map[string]ReviewRun{}\n497\t\tfor _, r := range runs {\n498\t\t\tbyID[r.RunID] = r\n499\t\t}\n500\t\tclaims := map[string]reviewContinuation{}\n501\t\treceipts := map[string]reviewAttemptReceipt{}\n502\t\tlosses := []string{}\n503\t\tbudget := int64(32 << 20)\n504\t\tfor _, entry := range entries {\n505\t\t\tif IsPublisherStaging(entry.Name()) {\n506\t\t\t\tcontinue\n507\t\t\t}\n508\t\t\tfull := filepath.Join(s.Root, reviewContinuationsDir, entry.Name())\n509\t\t\tif strings.HasSuffix(entry.Name(), \".result.json\") {\n510\t\t\t\tvar receipt reviewAttemptReceipt\n511\t\t\t\tif e := readLedgerJSONBudgetIn(files, full, &receipt, &budget); e != nil {\n512\t\t\t\t\tlosses = append(losses, e.Error())\n513\t\t\t\t\tcontinue\n514\t\t\t\t}\n515\t\t\t\treceipts[strings.TrimSuffix(entry.Name(), \".result.json\")] = receipt\n516\t\t\t} else if strings.HasSuffix(entry.Name(), \".json\") {\n517\t\t\t\tvar claim reviewContinuation\n518\t\t\t\tif e := readLedgerJSONBudgetIn(files, full, &claim, &budget); e != nil {\n519\t\t\t\t\tlosses = append(losses, e.Error())\n520\t\t\t\t\tcontinue\n521\t\t\t\t}\n522\t\t\t\tid := strings.TrimSuffix(entry.Name(), \".json\")\n523\t\t\t\tprior, ok := byID[id]\n524\t\t\t\tprior.Path, prior.SupersededBy = \"\", \"\"\n525\t\t\t\traw, _ := json.Marshal(prior)\n526\t\t\t\tif !ok || claim.SchemaVersion != 1 || claim.Predecessor != id || claim.AttemptID != prior.AttemptID || claim.PredecessorDigest != digestBytes(raw) {\n527\t\t\t\t\tlosses = append(losses, \"missing or rewritten continuation predecessor \"+id)\n528\t\t\t\t\tcontinue\n529\t\t\t\t}\n530\t\t\t\tif nonce, e := hex.DecodeString(claim.Nonce); e != nil || len(nonce) != 16 {\n531\t\t\t\t\tlosses = append(losses, \"invalid continuation nonce\")\n532\t\t\t\t\tcontinue\n533\t\t\t\t}\n534\t\t\t\tif _, e := time.Parse(time.RFC3339Nano, claim.ClaimedAt); e != nil {\n535\t\t\t\t\tlosses = append(losses, \"invalid continuation claim time\")\n536\t\t\t\t\tcontinue\n537\t\t\t\t}\n538\t\t\t\tclaims[id] = claim\n539\t\t\t} else {\n540\t\t\t\tlosses = append(losses, \"unknown continuation artifact \"+entry.Name())\n541\t\t\t}\n542\t\t\tif budget <= 0 {\n543\t\t\t\tlosses = append(losses, \"continuation inventory read budget exhausted\")\n544\t\t\t\tbreak\n545\t\t\t}\n546\t\t}\n547\t\tfor id, receipt := range receipts {\n548\t\t\tclaim, ok := claims[id]\n549\t\t\tnext, exists := byID[receipt.RunID]\n550\t\t\tcopy := next\n551\t\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n552\t\t\traw, _ := json.Marshal(copy)\n553\t\t\tif !ok || !exists || receipt.SchemaVersion != 1 || receipt.AttemptID != claim.AttemptID || next.AttemptID != claim.AttemptID || next.continues() != id || receipt.RunDigest != digestBytes(raw) {\n554\t\t\t\tlosses = append(losses, \"missing or conflicting continuation result \"+id)\n555\t\t\t}\n556\t\t}\n557\t\tchildren := map[string][]ReviewRun{}\n558\t\tfor _, r := range runs {\n559\t\t\tif r.Resumes != \"\" && r.HandsOffFrom != \"\" {\n560\t\t\t\tlosses = append(losses, \"invalid continuation chain \"+r.RunID+\": both a resume and a handoff\")\n561\t\t\t}\n562\t\t\tif parentID := r.continues(); parentID != \"\" {\n563\t\t\t\tprior, ok := byID[parentID]\n564\t\t\t\t_, claimed := claims[parentID]\n565\t\t\t\tsame := ok && claimed && r.AttemptID == prior.AttemptID && r.BundleDigest == prior.BundleDigest && r.BriefDigest == prior.BriefDigest && r.SealedCommit == prior.SealedCommit\n566\t\t\t\tif r.Resumes != \"\" {\n567\t\t\t\t\t// A resume continues the same agent and session, of a resumable stop.\n568\t\t\t\t\tsame = same && prior.Status == ReviewRunInterrupted && prior.Interruption != nil && prior.Interruption.Resumable && r.Adapter == prior.Adapter && r.TreeDigest == prior.TreeDigest\n569\t\t\t\t} else {\n570\t\t\t\t\t// A handoff continues another agent, of any stop short of a conclusion.\n571\t\t\t\t\tsame = same && handoffable(prior) == \"\" && r.Adapter != prior.Adapter && r.HandoffDigest != \"\" && handoffRenderers[r.HandoffRenderer] != nil && (prior.TreeDigest == \"\" || r.TreeDigest == prior.TreeDigest)\n572\t\t\t\t}\n573\t\t\t\tif !same {\n574\t\t\t\t\tlosses = append(losses, \"invalid continuation chain \"+r.RunID)\n575\t\t\t\t}\n576\t\t\t\tif _, ok := receipts[parentID]; !ok {\n577\t\t\t\t\tlosses = append(losses, \"missing continuation result receipt \"+parentID)\n578\t\t\t\t}\n579\t\t\t\tchildren[parentID] = append(children[parentID], r)\n580\t\t\t}\n581\t\t}\n582\t\tfor id, group := range children {\n583\t\t\tendpoints := 0\n584\t\t\tfor _, child := range group {\n585\t\t\t\tif child.SupersededBy == \"\" {\n586\t\t\t\t\tendpoints++\n587\t\t\t\t\tcontinue\n588\t\t\t\t}\n589\t\t\t\tnext, ok := byID[child.SupersededBy]"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"fd3341ed-2d11-4839-8020-c9229a3659ba","timestamp":"2026-11-26T10:08:54.887Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-c037f4c5c6/worktree/pose-mcp/internal/pose/review_run_continuity.go","content":"\t\t\tinterruption.ResetAt = t.UTC().Format(time.RFC3339Nano)\n\t\t}\n\t}\n\trun.Interruption = interruption\n\treturn ReviewRunInterrupted, \"review interrupted: \" + cause + \" (supervisor: \" + supervisorCause + \")\", nil\n}\nfunc validateContinuityRun(r ReviewRun) error {\n\tif r.Status == ReviewRunInterrupted {\n\t\tif r.Interruption == nil {\n\t\t\treturn fmt.Errorf(\"interrupted run has no cause\")\n\t\t}\n\t\tswitch r.Interruption.Cause {\n\t\tcase \"usage-limit\", \"timeout\", \"process-lost\", \"cancelled\", \"unknown\":\n\t\tdefault:\n\t\t\treturn fmt.Errorf(\"invalid interruption cause\")\n\t\t}\n\t\tif r.Interruption.ResetAt != \"\" {\n\t\t\tif _, e := time.Parse(time.RFC3339Nano, r.Interruption.ResetAt); e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t}\n\t\tif r.Interruption.Resumable && (r.SessionDigest == \"\" || r.TreeDigest == \"\" || r.AttemptID == \"\") {\n\t\t\treturn fmt.Errorf(\"resumable run lacks bound evidence\")\n\t\t}\n\t\tif r.PartialDigest != digestBytes([]byte(r.Output)) {\n\t\t\treturn fmt.Errorf(\"partial draft digest differs\")\n\t\t}\n\t} else if r.Interruption != nil {\n\t\treturn fmt.Errorf(\"terminal run contains interruption metadata\")\n\t}\n\treturn nil\n}\nfunc continuationPath(run string, result bool) string {\n\tsuffix := \".json\"\n\tif result {\n\t\tsuffix = \".result.json\"\n\t}\n\treturn filepath.ToSlash(filepath.Join(reviewContinuationsDir, run+suffix))\n}\nfunc (s Store) claimReviewContinuation(r ReviewRun, at time.Time) error {\n\traw, _ := json.Marshal(r)\n\t// Clear reader-only fields before deriving the predecessor digest.\n\tr.Path, r.SupersededBy = \"\", \"\"\n\traw, _ = json.Marshal(r)\n\tnonce := make([]byte, 16)\n\tif _, err := rand.Read(nonce); err != nil {\n\t\treturn err\n\t}\n\treturn publishLedgerJSON(s.Root, continuationPath(r.RunID, false), reviewContinuation{1, r.RunID, r.AttemptID, digestBytes(raw), at.UTC().Format(time.RFC3339Nano), hex.EncodeToString(nonce)})\n}\nfunc (s Store) finishReviewContinuation(r ReviewRun) error {\n\traw, _ := json.Marshal(r)\n\treceipt := reviewAttemptReceipt{1, r.AttemptID, r.RunID, digestBytes(raw)}\n\treturn publishLedgerJSON(s.Root, continuationPath(r.continues(), true), receipt)\n}\nfunc (s Store) existingReviewContinuation(r ReviewRun, runs []ReviewRun) (*ReviewRun, error) {\n\tvar claim reviewContinuation\n\te := readLedgerJSON(filepath.Join(s.Root, continuationPath(r.RunID, false)), &claim)\n\tif errors.Is(e, os.ErrNotExist) {\n\t\treturn nil, nil\n\t}\n\tif e != nil {\n\t\treturn nil, e\n\t}\n\tcopy := r\n\tcopy.Path, copy.SupersededBy = \"\", \"\"\n\traw, _ := json.Marshal(copy)\n\tif claim.SchemaVersion != 1 || claim.Predecessor != r.RunID || claim.AttemptID != r.AttemptID || claim.PredecessorDigest != digestBytes(raw) {\n\t\treturn nil, fmt.Errorf(\"continuation predecessor changed\")\n\t}\n\tvar receipt reviewAttemptReceipt\n\tif e = readLedgerJSON(filepath.Join(s.Root, continuationPath(r.RunID, true)), &receipt); e != nil {\n\t\treturn nil, &PendingReviewContinuation{ID: \"resume-of:\" + r.RunID, Predecessor: r.RunID, AttemptID: r.AttemptID}\n\t}\n\tfor _, next := range runs {\n\t\tif next.RunID == receipt.RunID {\n\t\t\tcopy := next\n\t\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n\t\t\traw, _ := json.Marshal(copy)\n\t\t\tif receipt.SchemaVersion != 1 || receipt.AttemptID != r.AttemptID || next.AttemptID != r.AttemptID || next.continues() != r.RunID || receipt.RunDigest != digestBytes(raw) {\n\t\t\t\treturn nil, fmt.Errorf(\"invalid continuation receipt\")\n\t\t\t}\n\t\t\treturn &next, nil\n\t\t}\n\t}\n\treturn nil, fmt.Errorf(\"continuation result is missing\")\n}\n\n// PlanReviewResume validates original evidence, policy and all accumulated budgets.\nfunc (s Store) PlanReviewResume(id string) (DispatchPlan, error) {\n\truns, lost, e := s.ReadReviewRuns(\"\")\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tif len(lost) > 0 {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"resume history incomplete: %v\", lost)\n\t}\n\tvar prior *ReviewRun\n\tfor i := range runs {\n\t\tif runs[i].RunID == id {\n\t\t\tprior = &runs[i]\n\t\t}\n\t}\n\tif prior == nil {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"resume predecessor not found\")\n\t}\n\tif prior.Status != ReviewRunInterrupted || prior.Interruption == nil || !prior.Interruption.Resumable {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"run is %s or not resumable\", prior.Status)\n\t}\n\tif why := s.reviewRunTranscriptIntact(*prior); why != \"\" {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"resume: %s\", why)\n\t}\n\tpolicy, _, e := s.LoadReviewersPolicyFor(prior.Kind)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tconfig, ok := policy.Adapters[prior.Adapter]\n\tif !ok || config.Resume == nil || len(config.Resume.Command) == 0 {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"resume adapter declaration missing\")\n\t}\n\tbrief, e := s.RenderReviewBriefMatching(prior.BundleID, prior.Kind, prior.BriefNotes, prior.BriefDigest)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tbundle, e := s.LoadReviewBundle(prior.BundleID)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tif brief.Digest != prior.BriefDigest || bundle.BundleDigest != prior.BundleDigest || bundle.Payload.Subject.Head != prior.SealedCommit {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"resume bundle or brief digest changed\")\n\t}\n\torigin, e := dispatchWorktreeIdentity(s.Root)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tif prior.Safety != nil && prior.Safety.Operation.Outcome != OutcomeCompleted {\n\t\treturn DispatchPlan{}, fmt.Errorf(\"predecessor cleanup incomplete; refusing continuation beside possible orphan\")\n\t}\n\tplan := DispatchPlan{predecessor: prior, notes: prior.BriefNotes, Reason: prior.Reason, PolicyDigest: prior.PolicyDigest, OriginWorktree: origin, Adapter: prior.Adapter, Config: config, Brief: brief, Bundle: bundle, SealedCommit: prior.SealedCommit}\n\tcontinuationRound(&plan, *prior, false)\n\tif e = s.checkDispatchOrigin(plan); e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\texisting, e := s.existingReviewContinuation(*prior, runs)\n\tif e != nil {\n\t\tvar pending *PendingReviewContinuation\n\t\tif errors.As(e, &pending) {\n\t\t\tplan.PendingContinuation = pending\n\t\t\treturn plan, nil\n\t\t}\n\t\treturn DispatchPlan{}, e\n\t}\n\tif existing != nil {\n\t\tif existing.HandsOffFrom == prior.RunID {\n\t\t\treturn DispatchPlan{}, fmt.Errorf(\"pose: run %s was handed off to run %s; it is not resumed\", prior.RunID, existing.RunID)\n\t\t}\n\t\tplan.Existing = existing\n\t\treturn plan, nil\n\t}\n\t// Only a continuation still to start needs the attempt's runtime\n\t// directory free; a repeated resume returns the recorded one.\n\tif e = reviewRunRuntimeDirFree(prior.AttemptID); e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\t// The attempt's budget, not this agent's: after a handoff the resumed\n\t// agent may declare another (spec pose-delegation-handoff R2).\n\tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tif count >= limit || spent >= total {\n\t\treturn DispatchPlan{}, refusal(DelegationReasonBudgetExhausted, fmt.Errorf(\"resume budget exhausted: %d resumes, %s wall-clock\", count, spent))\n\t}\n\ttimeout := 60 * time.Minute\n\tif config.Timeout != \"\" {\n\t\ttimeout, _ = time.ParseDuration(config.Timeout)\n\t}\n\tif total-spent < timeout {\n\t\ttimeout = total - spent\n\t}\n\tplan.processTimeout = timeout\n\t// A continuation runs the same agent the attempt was routed to.\n\tplan.Routing = prior.Routing\n\ts.planImplementation(&plan, prior.Lead)\n\tplan.provenance, e = s.prepareRunProvenance(plan, policy)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\tplan.session, e = s.readReviewSession(prior.SessionDigest)\n\tif e != nil {\n\t\treturn DispatchPlan{}, e\n\t}\n\treturn plan, nil\n}\n\n// ReviewResumeDelay computes a bounded, non-polling wait; callers revalidate afterwards.\nfunc ReviewResumeDelay(r ReviewRun, now time.Time, max time.Duration, jitter time.Duration) (time.Duration, error) {\n\tif r.Interruption == nil || r.Interruption.ResetAt == \"\" {\n\t\treturn 0, fmt.Errorf(\"no recorded reset instant\")\n\t}\n\tif max <= 0 || max > 24*time.Hour || jitter < 0 || jitter > time.Second {\n\t\treturn 0, fmt.Errorf(\"wait bound must be positive and at most 24h; jitter at most 1s\")\n\t}\n\treset, e := time.Parse(time.RFC3339Nano, r.Interruption.ResetAt)\n\tif e != nil {\n\t\treturn 0, e\n\t}\n\tdelay := reset.Sub(now)\n\tif delay < 0 {\n\t\tdelay = 0\n\t}\n\tdelay += jitter\n\tif delay > max {\n\t\treturn 0, fmt.Errorf(\"recorded reset exceeds maximum wait\")\n\t}\n\treturn delay, nil\n}\n\n// Continuation inventories use the same bounds as the attempt ledger. Pending\n// claims are observable operations, not proof of a completed review.\nfunc (s Store) reviewContinuationFindings(runs []ReviewRun) []string {\n\tfiles := s.fsys()\n\tentries, e := ledgerEntriesIn(files, s.Root, reviewContinuationsDir)\n\tif e != nil {\n\t\treturn []string{e.Error()}\n\t}\n\tbyID := map[string]ReviewRun{}\n\tfor _, r := range runs {\n\t\tbyID[r.RunID] = r\n\t}\n\tclaims := map[string]reviewContinuation{}\n\treceipts := map[string]reviewAttemptReceipt{}\n\tlosses := []string{}\n\tbudget := int64(32 << 20)\n\tfor _, entry := range entries {\n\t\tif IsPublisherStaging(entry.Name()) {\n\t\t\tcontinue\n\t\t}\n\t\tfull := filepath.Join(s.Root, reviewContinuationsDir, entry.Name())\n\t\tif strings.HasSuffix(entry.Name(), \".result.json\") {\n\t\t\tvar receipt reviewAttemptReceipt\n\t\t\tif e := readLedgerJSONBudgetIn(files, full, &receipt, &budget); e != nil {\n\t\t\t\tlosses = append(losses, e.Error())\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\treceipts[strings.TrimSuffix(entry.Name(), \".result.json\")] = receipt\n\t\t} else if strings.HasSuffix(entry.Name(), \".json\") {\n\t\t\tvar claim reviewContinuation\n\t\t\tif e := readLedgerJSONBudgetIn(files, full, &claim, &budget); e != nil {\n\t\t\t\tlosses = append(losses, e.Error())\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tid := strings.TrimSuffix(entry.Name(), \".json\")\n\t\t\tprior, ok := byID[id]\n\t\t\tprior.Path, prior.SupersededBy = \"\", \"\"\n\t\t\traw, _ := json.Marshal(prior)\n\t\t\tif !ok || claim.SchemaVersion != 1 || claim.Predecessor != id || claim.AttemptID != prior.AttemptID || claim.PredecessorDigest != digestBytes(raw) {\n\t\t\t\tlosses = append(losses, \"missing or rewritten continuation predecessor \"+id)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif nonce, e := hex.DecodeString(claim.Nonce); e != nil || len(nonce) != 16 {\n\t\t\t\tlosses = append(losses, \"invalid continuation nonce\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif _, e := time.Parse(time.RFC3339Nano, claim.ClaimedAt); e != nil {\n\t\t\t\tlosses = append(losses, \"invalid continuation claim time\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tclaims[id] = claim\n\t\t} else {\n\t\t\tlosses = append(losses, \"unknown continuation artifact \"+entry.Name())\n\t\t}\n\t\tif budget <= 0 {\n\t\t\tlosses = append(losses, \"continuation inventory read budget exhausted\")\n\t\t\tbreak\n\t\t}\n\t}\n\tfor id, receipt := range receipts {\n\t\tclaim, ok := claims[id]\n\t\tnext, exists := byID[receipt.RunID]\n\t\tcopy := next\n\t\tcopy.Path, copy.SupersededBy = \"\", \"\"\n\t\traw, _ := json.Marshal(copy)\n\t\tif !ok || !exists || receipt.SchemaVersion != 1 || receipt.AttemptID != claim.AttemptID || next.AttemptID != claim.AttemptID || next.continues() != id || receipt.RunDigest != digestBytes(raw) {\n\t\t\tlosses = append(losses, \"missing or conflicting continuation result \"+id)\n\t\t}\n\t}\n\tchildren := map[string][]ReviewRun{}\n\tfor _, r := range runs {\n\t\tif r.Resumes != \"\" && r.HandsOffFrom != \"\" {\n\t\t\tlosses = append(losses, \"invalid continuation chain \"+r.RunID+\": both a resume and a handoff\")\n\t\t}\n\t\tif parentID := r.continues(); parentID != \"\" {\n\t\t\tprior, ok := byID[parentID]\n\t\t\t_, claimed := claims[parentID]\n\t\t\tsame := ok && claimed && r.AttemptID == prior.AttemptID && r.BundleDigest == prior.BundleDigest && r.BriefDigest == prior.BriefDigest && r.SealedCommit == prior.SealedCommit\n\t\t\tif r.Resumes != \"\" {\n\t\t\t\t// A resume continues the same agent and session, of a resumable stop.\n\t\t\t\tsame = same && prior.Status == ReviewRunInterrupted && prior.Interruption != nil && prior.Interruption.Resumable && r.Adapter == prior.Adapter && r.TreeDigest == prior.TreeDigest\n\t\t\t} else {\n\t\t\t\t// A handoff continues another agent, of any stop short of a conclusion.\n\t\t\t\tsame = same && handoffable(prior) == \"\" && r.Adapter != prior.Adapter && r.HandoffDigest != \"\" && handoffRenderers[r.HandoffRenderer] != nil && (prior.TreeDigest == \"\" || r.TreeDigest == prior.TreeDigest)\n\t\t\t}\n\t\t\tif !same {\n\t\t\t\tlosses = append(losses, \"invalid continuation chain \"+r.RunID)\n\t\t\t}\n\t\t\tif _, ok := receipts[parentID]; !ok {\n\t\t\t\tlosses = append(losses, \"missing continuation result receipt \"+parentID)\n\t\t\t}\n\t\t\tchildren[parentID] = append(children[parentID], r)\n\t\t}\n\t}\n\tfor id, group := range children {\n\t\tendpoints := 0\n\t\tfor _, child := range group {\n\t\t\tif child.SupersededBy == \"\" {\n\t\t\t\tendpoints++\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tnext, ok := byID[child.SupersededBy]","numLines":320,"startLine":270,"totalLines":663}},"tool_result_meta":[{"id":"toolu_01GFAtdL5cuBuaAgLqu9j5gE","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
