ness drops the loss of the release's own run, a witness whose\n173\t// record an interrupted release did not publish yet: recording it again\n174\t// completes it.\n175\tfunc withoutOwnWitness(lost []string, runID string) []string {\n176\t\tvar out []string\n177\t\tfor _, l := range lost {\n178\t\t\tif runID != \"\" && strings.HasPrefix(l, \"witnessed run \"+runID+\":\") {\n179\t\t\t\tcontinue\n180\t\t\t}\n181\t\t\tout = append(out, l)\n182\t\t}\n183\t\treturn out\n184\t}\n185\t\n186\t// recordedAttemptRun finds the latest run recorded for attempt a. own is the\n187\t// run the release would record, whose own missing record is not an unknown.\n188\tfunc (s Store) recordedAttemptRun(a DelegatedReviewAttempt, own string) (ReviewRun, bool, error) {\n189\t\truns, lost, err := s.ReadReviewRuns(a.BundleID)\n190\t\tif err != nil {\n191\t\t\treturn ReviewRun{}, false, err\n192\t\t}\n193\t\tif lost = withoutOwnWitness(lost, own); len(lost) > 0 {\n194\t\t\t// An unreadable run may be this release's: the history is unknown,\n195\t\t\t// and the release does not write another (review round 4, N3).\n196\t\t\treturn ReviewRun{}, false, fmt.Errorf(\"the run history of %s is incomplete, so an earlier release cannot be ruled out: %s\", a.BundleID, strings.Join(lost, \"; \"))\n197\t\t}\n198\t\tvar latest *ReviewRun\n199\t\tfor i := range runs {\n200\t\t\tif runs[i].AttemptID == a.AttemptID && (latest == nil || runs[i].EndedAt > latest.EndedAt) {\n201\t\t\t\tlatest = &runs[i]\n202\t\t\t}\n203\t\t}\n204\t\tif latest == nil {\n205\t\t\treturn ReviewRun{}, false, nil\n206\t\t}\n207\t\treturn *latest, true, nil\n208\t}\n209\t\n210\t// orphanReservations lists the reservations left without a receipt or a\n211\t// marker, older than reviewOrphanReservationAge, and\n212\t// says which reservations or receipts it could not read (review round 3, N3).\n213\tfunc (s Store) orphanReservations(now time.Time) ([]DelegatedReviewAttempt, []string, error) {\n214\t\tbase := filepath.Join(s.Root, reviewAttemptDir)\n215\t\tdirs, dirsTruncated, err := readDirBounded(base, reviewOrphanScanMaxEntries)\n216\t\tif errors.Is(err, os.ErrNotExist) {\n217\t\t\treturn nil, nil, nil\n218\t\t}\n219\t\tif err != nil {\n220\t\t\treturn nil, nil, err\n221\t\t}\n222\t\tmarkers, markerLost, err := s.ListDelegationActive()\n223\t\tif err != nil {\n224\t\t\treturn nil, nil, err\n225\t\t}\n226\t\tif len(markerLost) > 0 {\n227\t\t\t// An unreadable marker may be a live attempt's: nothing is known to\n228\t\t\t// have no marker (review round 6, N1).\n229\t\t\treturn nil, append([]string{\"abandoned reservations cannot be determined while an active marker is unreadable\"}, markerLost...), nil"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"945e5038-bbf2-49d3-af02-f55736576e6c","timestamp":"2026-11-26T10:16:43.670Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-c037f4c5c6/worktree/pose-mcp/internal/pose/delegation_release.go","content":"\t}\n\tif !found {\n\t\tif recorded, err = s.recordReviewRun(run, nil); err != nil {\n\t\t\treturn ReviewRun{}, err\n\t\t}\n\t}\n\tif err := s.finishDelegatedReviewAttempt(*reserved, recorded); err != nil {\n\t\treturn recorded, err\n\t}\n\tif marker != nil {\n\t\treturn recorded, s.removeDelegationMarker(*marker)\n\t}\n\treturn recorded, nil\n}\n\n// abandonmentRun is the failed run a release records for reserved. Its\n// content is deterministic (no reading of the clock), so a release\n// interrupted between the run's witness and its record records the same run\n// again and completes it (review round 14, N5).\nfunc abandonmentRun(reserved DelegatedReviewAttempt, marker *DelegationActiveRun) ReviewRun {\n\trun := ReviewRun{SchemaVersion: 1, Scope: reserved.Scope, BundleID: reserved.BundleID, BundleDigest: reserved.BundleDigest,\n\t\tKind: ReviewBriefKindReview, Adapter: reserved.Adapter, Reason: reserved.Reason, AttemptID: reserved.AttemptID,\n\t\tStartedAt: reserved.ReservedAt, EndedAt: