{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GjNsQ2awkH1852b3VVPuYq","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"context\"\n6\t\t\"encoding/json\"\n7\t\t\"os\"\n8\t\t\"os/exec\"\n9\t\t\"strings\"\n10\t\t\"testing\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/harne8/pose-mcp/internal/worktreeruntime\"\n14\t)\n15\t\n16\t// Spec pose-optional-worktree-runtime R3/R4: the lifecycle commands and the standalone\n17\t// behaviour, through the command itself.\n18\tfunc TestRuntimeCommandsRunTheLifecycleAndFallBackToStandalone(t *testing.T) {\n19\t\tif !worktreeruntime.Supported() {\n20\t\t\tt.Skip(\"no protected local endpoint on this platform\")\n21\t\t}\n22\t\troot := t.TempDir()\n23\t\tif out, err := exec.Command(\"git\", \"-C\", root, \"init\", \"-q\").CombinedOutput(); err != nil {\n24\t\t\tt.Skipf(\"no git: %v %s\", err, out)\n25\t\t}\n26\t\tdir, err := os.MkdirTemp(os.Getenv(\"TMPDIR\"), \"rtc\")\n27\t\tif err != nil {\n28\t\t\tt.Fatal(err)\n29\t\t}\n30\t\tdefer os.RemoveAll(dir)\n31\t\tt.Setenv(worktreeruntime.EnvDir, dir+\"/r\")\n32\t\trun := func(args ...string) (string, int) {\n33\t\t\tvar out, errb bytes.Buffer\n34\t\t\tcode := cmdRuntime(root, args, &out, &errb)\n35\t\t\treturn out.String() + errb.String(), code\n36\t\t}\n37\t\tstate := func(args ...string) (string, int) {\n38\t\t\tout, code := run(append(args, \"--json\")...)\n39\t\t\tvar doc struct {\n40\t\t\t\tState string `json:\"state\"`\n41\t\t\t\tEpoch string `json:\"epoch\"`\n42\t\t\t}\n43\t\t\tif err := json.Unmarshal([]byte(strings.TrimSpace(out)), &doc); err != nil {\n44\t\t\t\tt.Fatalf(\"not JSON: %q\", out)\n45\t\t\t}\n46\t\t\treturn doc.State + \"|\" + doc.Epoch, code\n47\t\t}\n48\t\t// No runtime: standalone is a state, not a fault; attach asked for it and cannot have it.\n49\t\tif s, code := state(\"status\"); !strings.HasPrefix(s, \"standalone|\") || code != 0 {\n50\t\t\tt.Fatalf(\"status with no runtime: %s %d\", s, code)\n51\t\t}\n52\t\tif s, code := state(\"attach\"); !strings.HasPrefix(s, \"standalone|\") || code != 1 {\n53\t\t\tt.Fatalf(\"attach with no runtime: %s %d\", s, code)\n54\t\t}\n55\t\tif _, err := os.Stat(dir + \"/r\"); err == nil {\n56\t\t\tt.Fatal(\"asking about a runtime prepared its directory\")\n57\t\t}\n58\t\t// start: the spawn is replaced by the same runtime in-process.\n59\t\tvar stops []context.CancelFunc\n60\t\tdefer func() {\n61\t\t\tfor _, stop := range stops {\n62\t\t\t\tstop()\n63\t\t\t}\n64\t\t}()\n65\t\toriginal := runtimeSpawn\n66\t\truntimeSpawn = func(r string, idle time.Duration) error {\n67\t\t\tctx, cancel := context.WithCancel(context.Background())\n68\t\t\tstops = append(stops, cancel)\n69\t\t\tgo cmdRuntime(r, []string{\"serve\", \"--idle\", idle.String()}, new(bytes.Buffer), new(bytes.Buffer))\n70\t\t\t_ = ctx\n71\t\t\treturn nil\n72\t\t}\n73\t\tdefer func() { runtimeSpawn = original }()\n74\t\tout, code := state(\"start\")\n75\t\tif !strings.HasPrefix(out, \"started|\") || code != 0 {\n76\t\t\tt.Fatalf(\"start: %s %d\", out, code)\n77\t\t}\n78\t\tfirst := strings.SplitN(out, \"|\", 2)[1]\n79\t\tif s, code := state(\"start\"); !strings.HasPrefix(s, \"already-running|\") || code != 0 {\n80\t\t\tt.Fatalf(\"a second start: %s %d\", s, code)\n81\t\t}\n82\t\tif s, code := state(\"attach\"); !strings.HasPrefix(s, \"attach|\") || code != 0 {\n83\t\t\tt.Fatalf(\"attach: %s %d\", s, code)\n84\t\t}\n85\t\tif s, code := state(\"restart\"); !strings.HasPrefix(s, \"started|\") || code != 0 || strings.SplitN(s, \"|\", 2)[1] == first {\n86\t\t\tt.Fatalf(\"restart did not give a new epoch: %s %d (was %s)\", s, code, first)\n87\t\t}\n88\t\tif s, code := state(\"stop\"); !strings.HasPrefix(s, \"stopped|\") || code != 0 {\n89\t\t\tt.Fatalf(\"stop: %s %d\", s, code)\n90\t\t}\n91\t\tif s, code := state(\"status\"); !strings.HasPrefix(s, \"standalone|\") || code != 0 {\n92\t\t\tt.Fatalf(\"status after stop: %s %d\", s, code)\n93\t\t}\n94\t\tif _, code := run(\"nosuch\"); code != 2 {\n95\t\t\tt.Fatalf(\"an unknown subcommand exits %d\", code)\n96\t\t}\n97\t}\n98\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"9f24133e-18e5-40a2-b2de-bf2888ef6786","timestamp":"2026-11-09T23:37:49.270Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-1986613151/worktree/pose-mcp/internal/cli/runtime_cmd_test.go","content":"package cli\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/harne8/pose-mcp/internal/worktreeruntime\"\n)\n\n// Spec pose-optional-worktree-runtime R3/R4: the lifecycle commands and the standalone\n// behaviour, through the command itself.\nfunc TestRuntimeCommandsRunTheLifecycleAndFallBackToStandalone(t *testing.T) {\n\tif !worktreeruntime.Supported() {\n\t\tt.Skip(\"no protected local endpoint on this platform\")\n\t}\n\troot := t.TempDir()\n\tif out, err := exec.Command(\"git\", \"-C\", root, \"init\", \"-q\").CombinedOutput(); err != nil {\n\t\tt.Skipf(\"no git: %v %s\", err, out)\n\t}\n\tdir, err := os.MkdirTemp(os.Getenv(\"TMPDIR\"), \"rtc\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer os.RemoveAll(dir)\n\tt.Setenv(worktreeruntime.EnvDir, dir+\"/r\")\n\trun := func(args ...string) (string, int) {\n\t\tvar out, errb bytes.Buffer\n\t\tcode := cmdRuntime(root, args, &out, &errb)\n\t\treturn out.String() + errb.String(), code\n\t}\n\tstate := func(args ...string) (string, int) {\n\t\tout, code := run(append(args, \"--json\")...)\n\t\tvar doc struct {\n\t\t\tState string `json:\"state\"`\n\t\t\tEpoch string `json:\"epoch\"`\n\t\t}\n\t\tif err := json.Unmarshal([]byte(strings.TrimSpace(out)), &doc); err != nil {\n\t\t\tt.Fatalf(\"not JSON: %q\", out)\n\t\t}\n\t\treturn doc.State + \"|\" + doc.Epoch, code\n\t}\n\t// No runtime: standalone is a state, not a fault; attach asked for it and cannot have it.\n\tif s, code := state(\"status\"); !strings.HasPrefix(s, \"standalone|\") || code != 0 {\n\t\tt.Fatalf(\"status with no runtime: %s %d\", s, code)\n\t}\n\tif s, code := state(\"attach\"); !strings.HasPrefix(s, \"standalone|\") || code != 1 {\n\t\tt.Fatalf(\"attach with no runtime: %s %d\", s, code)\n\t}\n\tif _, err := os.Stat(dir + \"/r\"); err == nil {\n\t\tt.Fatal(\"asking about a runtime prepared its directory\")\n\t}\n\t// start: the spawn is replaced by the same runtime in-process.\n\tvar stops []context.CancelFunc\n\tdefer func() {\n\t\tfor _, stop := range stops {\n\t\t\tstop()\n\t\t}\n\t}()\n\toriginal := runtimeSpawn\n\truntimeSpawn = func(r string, idle time.Duration) error {\n\t\tctx, cancel := context.WithCancel(context.Background())\n\t\tstops = append(stops, cancel)\n\t\tgo cmdRuntime(r, []string{\"serve\", \"--idle\", idle.String()}, new(bytes.Buffer), new(bytes.Buffer))\n\t\t_ = ctx\n\t\treturn nil\n\t}\n\tdefer func() { runtimeSpawn = original }()\n\tout, code := state(\"start\")\n\tif !strings.HasPrefix(out, \"started|\") || code != 0 {\n\t\tt.Fatalf(\"start: %s %d\", out, code)\n\t}\n\tfirst := strings.SplitN(out, \"|\", 2)[1]\n\tif s, code := state(\"start\"); !strings.HasPrefix(s, \"already-running|\") || code != 0 {\n\t\tt.Fatalf(\"a second start: %s %d\", s, code)\n\t}\n\tif s, code := state(\"attach\"); !strings.HasPrefix(s, \"attach|\") || code != 0 {\n\t\tt.Fatalf(\"attach: %s %d\", s, code)\n\t}\n\tif s, code := state(\"restart\"); !strings.HasPrefix(s, \"started|\") || code != 0 || strings.SplitN(s, \"|\", 2)[1] == first {\n\t\tt.Fatalf(\"restart did not give a new epoch: %s %d (was %s)\", s, code, first)\n\t}\n\tif s, code := state(\"stop\"); !strings.HasPrefix(s, \"stopped|\") || code != 0 {\n\t\tt.Fatalf(\"stop: %s %d\", s, code)\n\t}\n\tif s, code := state(\"status\"); !strings.HasPrefix(s, \"standalone|\") || code != 0 {\n\t\tt.Fatalf(\"status after stop: %s %d\", s, code)\n\t}\n\tif _, code := run(\"nosuch\"); code != 2 {\n\t\tt.Fatalf(\"an unknown subcommand exits %d\", code)\n\t}\n}\n","numLines":98,"startLine":1,"totalLines":98}},"tool_result_meta":[{"id":"toolu_01GjNsQ2awkH1852b3VVPuYq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
