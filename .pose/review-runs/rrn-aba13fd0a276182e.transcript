{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FwE1ro6f8JzouhyawLbb1E","type":"tool_result","content":"1\tpackage worktreeruntime\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\t\"net\"\n7\t\t\"os\"\n8\t\t\"os/exec\"\n9\t\t\"path/filepath\"\n10\t\t\"runtime\"\n11\t\t\"strings\"\n12\t\t\"testing\"\n13\t\t\"time\"\n14\t)\n15\t\n16\t// Spec pose-optional-worktree-runtime.\n17\t\n18\tfunc repo(t *testing.T) string {\n19\t\tt.Helper()\n20\t\tdir := t.TempDir()\n21\t\tif out, err := exec.Command(\"git\", \"-C\", dir, \"init\", \"-q\").CombinedOutput(); err != nil {\n22\t\t\tt.Skipf(\"no git: %v %s\", err, out)\n23\t\t}\n24\t\treturn dir\n25\t}\n26\t\n27\tfunc skipUnsupported(t *testing.T) {\n28\t\tt.Helper()\n29\t\tif !Supported() {\n30\t\t\tt.Skip(\"no protected local endpoint on this platform\")\n31\t\t}\n32\t}\n33\t\n34\tfunc shortDir(t *testing.T) string {\n35\t\tt.Helper()\n36\t\tdir, err := os.MkdirTemp(os.Getenv(\"TMPDIR\"), \"rt\")\n37\t\tif err != nil {\n38\t\t\tt.Fatal(err)\n39\t\t}\n40\t\tt.Cleanup(func() { os.RemoveAll(dir) })\n41\t\tdir = filepath.Join(dir, \"r\")\n42\t\treturn dir\n43\t}\n44\t\n45\tfunc start(t *testing.T, id Identity, dir string, idle time.Duration) (context.CancelFunc, chan error) {\n46\t\tt.Helper()\n47\t\tctx, cancel := context.WithCancel(context.Background())\n48\t\tdone := make(chan error, 1)\n49\t\tgo func() { done <- Serve(ctx, Options{Identity: id, Dir: dir, Idle: idle}) }()\n50\t\tclient := Client{Identity: id, Dir: dir}\n51\t\tfor i := 0; i < 200; i++ {\n52\t\t\tif _, err := client.Status(context.Background()); err == nil {\n53\t\t\t\treturn cancel, done\n54\t\t\t}\n55\t\t\ttime.Sleep(10 * time.Millisecond)\n56\t\t}\n57\t\tcancel()\n58\t\tt.Fatal(\"the runtime did not come up\")\n59\t\treturn nil, nil\n60\t}\n61\t\n62\tfunc identity(t *testing.T, root, engine string) Identity {\n63\t\tt.Helper()\n64\t\tid, err := ResolveIdentity(root, engine, \"b1\")\n65\t\tif err != nil {\n66\t\t\tt.Skip(err)\n67\t\t}\n68\t\treturn id\n69\t}\n70\t\n71\t// R1: the identity names user, worktree and Git common directory; two worktrees of one\n72\t// repository do not share an endpoint, and the handshake refuses another engine by field.\n73\tfunc TestTheIdentityNamesTheWorktreeAndTheHandshakeRefusesAnotherEngine(t *testing.T) {\n74\t\tskipUnsupported(t)\n75\t\ta, b := repo(t), repo(t)\n76\t\tia, ib := identity(t, a, \"7.4.1\"), identity(t, b, \"7.4.1\")\n77\t\tif ia.location() == ib.location() {\n78\t\t\tt.Fatal(\"two worktrees share an endpoint name\")\n79\t\t}\n80\t\tlink := filepath.Join(t.TempDir(), \"alias\")\n81\t\tif err := os.Symlink(a, link); err != nil {\n82\t\t\tt.Skip(err)\n83\t\t}\n84\t\tif got := identity(t, link, \"7.4.1\"); got.Worktree != ia.Worktree || got.location() != ia.location() {\n85\t\t\tt.Fatalf(\"a symlink to the worktree is another identity: %v vs %v\", got.Worktree, ia.Worktree)\n86\t\t}\n87\t\tdir := shortDir(t)\n88\t\tcancel, done := start(t, ia, dir, 0)\n89\t\tdefer func() { cancel(); <-done }()\n90\t\tif _, err := (Client{Identity: ia, Dir: dir}).Handshake(context.Background()); err != nil {\n91\t\t\tt.Fatalf(\"a compatible attach was refused: %v\", err)\n92\t\t}\n93\t\tnewer := ia\n94\t\tnewer.Engine = \"7.5.0\"\n95\t\t_, err := Client{Identity: newer, Dir: dir}.Handshake(context.Background())\n96\t\tvar inc *IncompatibleError\n97\t\tif !errors.As(err, &inc) || len(inc.Mismatch) != 1 || !strings.HasPrefix(inc.Mismatch[0], \"engine:\") {\n98\t\t\tt.Fatalf(\"a newer CLI against the old process: %v\", err)\n99\t\t}\n100\t\tother := ia\n101\t\tother.Protocol = 2\n102\t\tif _, err := (Client{Identity: other, Dir: dir}).Handshake(context.Background()); err == nil {\n103\t\t\tt.Fatal(\"another protocol attached\")\n104\t\t}\n105\t}\n106\t\n107\t// R2: the directory and the endpoint are the user's alone; a link, a loose mode or a file\n108\t// that is not a socket is refused, and a stale socket is replaced.\n109\tfunc TestTheEndpointIsProtectedAndAStaleOneIsReplaced(t *testing.T) {\n110\t\tskipUnsupported(t)\n111\t\tid := identity(t, repo(t), \"7.4.1\")\n112\t\tdir := shortDir(t)\n113\t\tif err := EnsureDir(dir); err != nil {\n114\t\t\tt.Fatal(err)\n115\t\t}\n116\t\tif info, _ := os.Stat(dir); info.Mode().Perm() != 0o700 {\n117\t\t\tt.Fatalf(\"the directory mode is %o\", info.Mode().Perm())\n118\t\t}\n119\t\tif err := os.Chmod(dir, 0o755); err != nil {\n120\t\t\tt.Fatal(err)\n121\t\t}\n122\t\tvar unsafe *UnsafeError\n123\t\tif err := EnsureDir(dir); !errors.As(err, &unsafe) {\n124\t\t\tt.Fatalf(\"a directory open to others was accepted: %v\", err)\n125\t\t}\n126\t\t_ = os.Chmod(dir, 0o700)\n127\t\tlink := dir + \"-link\"\n128\t\tif err := os.Symlink(dir, link); err == nil {\n129\t\t\tif err := EnsureDir(link); !errors.As(err, &unsafe) {\n130\t\t\t\tt.Fatalf(\"a symlinked directory was accepted: %v\", err)\n131\t\t\t}\n132\t\t}\n133\t\tpath := SocketPath(dir, id)\n134\t\tif err := os.WriteFile(path, []byte(\"x\"), 0o600); err != nil {\n135\t\t\tt.Fatal(err)\n136\t\t}\n137\t\tif err := Serve(context.Background(), Options{Identity: id, Dir: dir}); !errors.As(err, &unsafe) {\n138\t\t\tt.Fatalf(\"a regular file where the socket goes was replaced: %v\", err)\n139\t\t}\n140\t\tos.Remove(path)\n141\t\t// A socket nobody answers on is stale: Serve takes the name over.\n142\t\tl, err := net.Listen(\"unix\", path)\n143\t\tif err != nil {\n144\t\t\tt.Fatal(err)\n145\t\t}\n146\t\tl.(*net.UnixListener).SetUnlinkOnClose(false)\n147\t\tl.Close()\n148\t\tif _, err := (Client{Identity: id, Dir: dir}).Status(context.Background()); !errors.Is(err, ErrNoRuntime) {\n149\t\t\tt.Fatalf(\"a stale endpoint is not 'no runtime': %v\", err)\n150\t\t}\n151\t\tcancel, done := start(t, id, dir, 0)\n152\t\tif info, err := os.Stat(path); err != nil || info.Mode().Perm() != 0o600 {\n153\t\t\tt.Fatalf(\"the socket mode: %v %v\", info, err)\n154\t\t}\n155\t\tif err := Serve(context.Background(), Options{Identity: id, Dir: dir}); !errors.Is(err, ErrAlreadyServed) {\n156\t\t\tt.Fatalf(\"a second runtime for the same worktree started: %v\", err)\n157\t\t}\n158\t\tcancel()\n159\t\t<-done\n160\t\tif _, err := os.Lstat(path); err == nil {\n161\t\t\tt.Fatal(\"the endpoint was left behind\")\n162\t\t}\n163\t}\n164\t\n165\t// R3: stop drains and says what finished; a restart has a new epoch; the idle timeout ends\n166\t// an idle runtime and removes its endpoint.\n167\tfunc TestTheLifecycleDrainsRestartsWithANewEpochAndIdlesOut(t *testing.T) {\n168\t\tskipUnsupported(t)\n169\t\tid := identity(t, repo(t), \"7.4.1\")\n170\t\tdir := shortDir(t)\n171\t\tcancel, done := start(t, id, dir, 0)\n172\t\tc := Client{Identity: id, Dir: dir}\n173\t\tfirst, err := c.Status(context.Background())\n174\t\tif err != nil || first.Epoch == \"\" || first.PID != os.Getpid() {\n175\t\t\tt.Fatalf(\"status: %+v %v\", first, err)\n176\t\t}\n177\t\tstopped, err := c.Stop(context.Background(), time.Second)\n178\t\tif err != nil || !stopped.OK || stopped.Abandoned != 0 {\n179\t\t\tt.Fatalf(\"stop: %+v %v\", stopped, err)\n180\t\t}\n181\t\tif err := <-done; err != nil {\n182\t\t\tt.Fatalf(\"serve after stop: %v\", err)\n183\t\t}\n184\t\tcancel()\n185\t\tif _, err := c.Status(context.Background()); !errors.Is(err, ErrNoRuntime) {\n186\t\t\tt.Fatalf(\"the runtime answers after stop: %v\", err)\n187\t\t}\n188\t\tcancel2, done2 := start(t, id, dir, 0)\n189\t\tsecond, _ := c.Status(context.Background())\n190\t\tif second.Epoch == first.Epoch {\n191\t\t\tt.Fatal(\"a restart inherited the epoch of the previous process\")\n192\t\t}\n193\t\tcancel2()\n194\t\t<-done2\n195\t\tcancel3, done3 := start(t, id, dir, 120*time.Millisecond)\n196\t\tdefer cancel3()\n197\t\tselect {\n198\t\tcase err := <-done3:\n199\t\t\tif err != nil {\n200\t\t\t\tt.Fatal(err)\n201\t\t\t}\n202\t\tcase <-time.After(5 * time.Second):\n203\t\t\tt.Fatal(\"an idle runtime did not stop\")\n204\t\t}\n205\t}\n206\t\n207\t// R4: with no runtime, a client gets ErrNoRuntime (the caller runs standalone) and nothing\n208\t// is started; an unsupported platform says so.\n209\tfunc TestWithNoRuntimeTheClientSaysSoAndStartsNothing(t *testing.T) {\n210\t\tid := identity(t, repo(t), \"7.4.1\")\n211\t\tdir := shortDir(t)\n212\t\t_, err := Client{Identity: id, Dir: dir}.Handshake(context.Background())\n213\t\tif Supported() {\n214\t\t\tif !errors.Is(err, ErrNoRuntime) {\n215\t\t\t\tt.Fatalf(\"handshake with no runtime: %v\", err)\n216\t\t\t}\n217\t\t\tif _, statErr := os.Stat(dir); statErr == nil {\n218\t\t\t\tt.Fatal(\"the client created the endpoint directory: attach must not autostart or prepare one\")\n219\t\t\t}\n220\t\t} else if !errors.Is(err, ErrUnsupported) {\n221\t\t\tt.Fatalf(\"unsupported platform: %v\", err)\n222\t\t}\n223\t\t_ = runtime.GOOS\n224\t}\n225\t\n226\t// R9 (race): of many concurrent starts for one worktree exactly one serves, none removes the\n227\t// socket of the one that does, and a runtime that exits removes only the endpoint it made.\n228\tfunc TestConcurrentStartsLeaveOneRuntimeAndNoOneRemovesItsSocket(t *testing.T) {\n229\t\tskipUnsupported(t)\n230\t\tid := identity(t, repo(t), \"7.4.1\")\n231\t\tdir := shortDir(t)\n232\t\tctx, cancel := context.WithCancel(context.Background())\n233\t\tconst n = 8\n234\t\tresults := make(chan error, n)\n235\t\tfor i := 0; i < n; i++ {\n236\t\t\tgo func() { results <- Serve(ctx, Options{Identity: id, Dir: dir}) }()\n237\t\t}\n238\t\tvar refused int\n239\t\tfor i := 0; i < n-1; i++ {\n240\t\t\tselect {\n241\t\t\tcase err := <-results:\n242\t\t\t\tif !errors.Is(err, ErrAlreadyServed) {\n243\t\t\t\t\tt.Fatalf(\"a losing start returned %v\", err)\n244\t\t\t\t}\n245\t\t\t\trefused++\n246\t\t\tcase <-time.After(10 * time.Second):\n247\t\t\t\tt.Fatal(\"a losing start did not return\")\n248\t\t\t}\n249\t\t}\n250\t\tc := Client{Identity: id, Dir: dir}\n251\t\tif _, err := c.Handshake(context.Background()); err != nil {\n252\t\t\tt.Fatalf(\"the winner does not answer after the losers returned: %v\", err)\n253\t\t}\n254\t\tcancel()\n255\t\tif err := <-results; err != nil {\n256\t\t\tt.Fatalf(\"the winner: %v\", err)\n257\t\t}\n258\t\t// An orphan that exits after a successor took the name must not remove the successor's socket.\n259\t\tpath := SocketPath(dir, id)\n260\t\tours, err := os.Lstat(path)\n261\t\tif err == nil {\n262\t\t\tt.Fatalf(\"the endpoint outlived its runtime: %v\", ours)\n263\t\t}\n264\t\t_ = refused\n265\t}\n266\t\n267\t// F4: a stop does not accept new connections while it drains, so what it reports is what was\n268\t// in flight when it began.\n269\tfunc TestAStopAcceptsNothingWhileItDrains(t *testing.T) {\n270\t\tskipUnsupported(t)\n271\t\tid := identity(t, repo(t), \"7.4.1\")\n272\t\tdir := shortDir(t)\n273\t\tcancel, done := start(t, id, dir, 0)\n274\t\tdefer cancel()\n275\t\tc := Client{Identity: id, Dir: dir}\n276\t\treply, err := c.Stop(context.Background(), time.Second)\n277\t\tif err != nil || reply.Drained < 0 || reply.Abandoned != 0 {\n278\t\t\tt.Fatalf(\"stop: %+v %v\", reply, err)\n279\t\t}\n280\t\t<-done\n281\t\tif _, err := c.Status(context.Background()); !errors.Is(err, ErrNoRuntime) {\n282\t\t\tt.Fatalf(\"a connection was accepted after the stop: %v\", err)\n283\t\t}\n284\t}\n285\t\n286\t// G6: a runtime that exits after a successor took its name removes nothing: the endpoint it\n287\t// finds is not the inode it created.\n288\tfunc TestARuntimeThatOutlivesItsEndpointRemovesOnlyItsOwn(t *testing.T) {\n289\t\tskipUnsupported(t)\n290\t\tid := identity(t, repo(t), \"7.4.1\")\n291\t\tdir := shortDir(t)\n292\t\tcancel, done := start(t, id, dir, 0)\n293\t\tpath := SocketPath(dir, id)\n294\t\tif err := os.Remove(path); err != nil {\n295\t\t\tt.Fatal(err)\n296\t\t}\n297\t\tsuccessor, err := net.Listen(\"unix\", path)\n298\t\tif err != nil {\n299\t\t\tt.Fatal(err)\n300\t\t}\n301\t\tdefer successor.Close()\n302\t\tcancel()\n303\t\t<-done\n304\t\tif _, err := os.Lstat(path); err != nil {\n305\t\t\tt.Fatalf(\"the exiting runtime removed the endpoint of its successor: %v\", err)\n306\t\t}\n307\t}\n308\t\n309\t// R3: a stop with a request in flight reports it drained when it finishes inside the deadline\n310\t// and abandoned when it does not, and accepts nothing new while it waits.\n311\tfunc TestAStopReportsWhatItDrainedAndWhatItAbandoned(t *testing.T) {\n312\t\tskipUnsupported(t)\n313\t\tfor _, tc := range []struct {\n314\t\t\tname                string\n315\t\t\thold, drain         time.Duration\n316\t\t\twantDrained, wantAb int64\n317\t\t}{\n318\t\t\t{\"drained\", 150 * time.Millisecond, 3 * time.Second, 1, 0},\n319\t\t\t{\"abandoned\", 2 * time.Second, 100 * time.Millisecond, 0, 1},\n320\t\t} {\n321\t\t\tt.Run(tc.name, func(t *testing.T) {\n322\t\t\t\tid := identity(t, repo(t), \"7.4.1\")\n323\t\t\t\tdir := shortDir(t)\n324\t\t\t\tentered := make(chan struct{}, 1)\n325\t\t\t\tctx, cancel := context.WithCancel(context.Background())\n326\t\t\t\tdefer cancel()\n327\t\t\t\tdone := make(chan error, 1)\n328\t\t\t\tgo func() {\n329\t\t\t\t\tdone <- Serve(ctx, Options{Identity: id, Dir: dir, Handler: func(_ context.Context, op string) (Reply, bool) {\n330\t\t\t\t\t\tif op != \"hold\" {\n331\t\t\t\t\t\t\treturn Reply{}, false\n332\t\t\t\t\t\t}\n333\t\t\t\t\t\tentered <- struct{}{}\n334\t\t\t\t\t\ttime.Sleep(tc.hold)\n335\t\t\t\t\t\treturn Reply{OK: true}, true\n336\t\t\t\t\t}})\n337\t\t\t\t}()\n338\t\t\t\tc := Client{Identity: id, Dir: dir}\n339\t\t\t\tfor i := 0; i < 200; i++ {\n340\t\t\t\t\tif _, err := c.Status(context.Background()); err == nil {\n341\t\t\t\t\t\tbreak\n342\t\t\t\t\t}\n343\t\t\t\t\ttime.Sleep(10 * time.Millisecond)\n344\t\t\t\t}\n345\t\t\t\tgo c.Do(context.Background(), \"hold\")\n346\t\t\t\t<-entered\n347\t\t\t\tstopped := make(chan Reply, 1)\n348\t\t\t\tgo func() { r, _ := c.Stop(context.Background(), tc.drain); stopped <- r }()\n349\t\t\t\ttime.Sleep(50 * time.Millisecond)\n350\t\t\t\tif _, err := c.Status(context.Background()); !errors.Is(err, ErrNoRuntime) {\n351\t\t\t\t\tt.Fatalf(\"a connection was accepted while the stop drained: %v\", err)\n352\t\t\t\t}\n353\t\t\t\treply := <-stopped\n354\t\t\t\tif reply.Drained != tc.wantDrained || reply.Abandoned != tc.wantAb {\n355\t\t\t\t\tt.Fatalf(\"drained %d abandoned %d, want %d and %d\", reply.Drained, reply.Abandoned, tc.wantDrained, tc.wantAb)\n356\t\t\t\t}\n357\t\t\t\t<-done\n358\t\t\t\tif !c.WaitReleased(context.Background(), 5*time.Second) {\n359\t\t\t\t\tt.Fatal(\"the endpoint was not released after the runtime exited\")\n360\t\t\t\t}\n361\t\t\t})\n362\t\t}\n363\t}\n364\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"397fd438-48b6-4592-85cd-802870a478d2","timestamp":"2026-11-09T23:37:40.901Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-1986613151/worktree/pose-mcp/internal/worktreeruntime/runtime_test.go","content":"package worktreeruntime\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"net\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"runtime\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\n// Spec pose-optional-worktree-runtime.\n\nfunc repo(t *testing.T) string {\n\tt.Helper()\n\tdir := t.TempDir()\n\tif out, err := exec.Command(\"git\", \"-C\", dir, \"init\", \"-q\").CombinedOutput(); err != nil {\n\t\tt.Skipf(\"no git: %v %s\", err, out)\n\t}\n\treturn dir\n}\n\nfunc skipUnsupported(t *testing.T) {\n\tt.Helper()\n\tif !Supported() {\n\t\tt.Skip(\"no protected local endpoint on this platform\")\n\t}\n}\n\nfunc shortDir(t *testing.T) string {\n\tt.Helper()\n\tdir, err := os.MkdirTemp(os.Getenv(\"TMPDIR\"), \"rt\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Cleanup(func() { os.RemoveAll(dir) })\n\tdir = filepath.Join(dir, \"r\")\n\treturn dir\n}\n\nfunc start(t *testing.T, id Identity, dir string, idle time.Duration) (context.CancelFunc, chan error) {\n\tt.Helper()\n\tctx, cancel := context.WithCancel(context.Background())\n\tdone := make(chan error, 1)\n\tgo func() { done <- Serve(ctx, Options{Identity: id, Dir: dir, Idle: idle}) }()\n\tclient := Client{Identity: id, Dir: dir}\n\tfor i := 0; i < 200; i++ {\n\t\tif _, err := client.Status(context.Background()); err == nil {\n\t\t\treturn cancel, done\n\t\t}\n\t\ttime.Sleep(10 * time.Millisecond)\n\t}\n\tcancel()\n\tt.Fatal(\"the runtime did not come up\")\n\treturn nil, nil\n}\n\nfunc identity(t *testing.T, root, engine string) Identity {\n\tt.Helper()\n\tid, err := ResolveIdentity(root, engine, \"b1\")\n\tif err != nil {\n\t\tt.Skip(err)\n\t}\n\treturn id\n}\n\n// R1: the identity names user, worktree and Git common directory; two worktrees of one\n// repository do not share an endpoint, and the handshake refuses another engine by field.\nfunc TestTheIdentityNamesTheWorktreeAndTheHandshakeRefusesAnotherEngine(t *testing.T) {\n\tskipUnsupported(t)\n\ta, b := repo(t), repo(t)\n\tia, ib := identity(t, a, \"7.4.1\"), identity(t, b, \"7.4.1\")\n\tif ia.location() == ib.location() {\n\t\tt.Fatal(\"two worktrees share an endpoint name\")\n\t}\n\tlink := filepath.Join(t.TempDir(), \"alias\")\n\tif err := os.Symlink(a, link); err != nil {\n\t\tt.Skip(err)\n\t}\n\tif got := identity(t, link, \"7.4.1\"); got.Worktree != ia.Worktree || got.location() != ia.location() {\n\t\tt.Fatalf(\"a symlink to the worktree is another identity: %v vs %v\", got.Worktree, ia.Worktree)\n\t}\n\tdir := shortDir(t)\n\tcancel, done := start(t, ia, dir, 0)\n\tdefer func() { cancel(); <-done }()\n\tif _, err := (Client{Identity: ia, Dir: dir}).Handshake(context.Background()); err != nil {\n\t\tt.Fatalf(\"a compatible attach was refused: %v\", err)\n\t}\n\tnewer := ia\n\tnewer.Engine = \"7.5.0\"\n\t_, err := Client{Identity: newer, Dir: dir}.Handshake(context.Background())\n\tvar inc *IncompatibleError\n\tif !errors.As(err, &inc) || len(inc.Mismatch) != 1 || !strings.HasPrefix(inc.Mismatch[0], \"engine:\") {\n\t\tt.Fatalf(\"a newer CLI against the old process: %v\", err)\n\t}\n\tother := ia\n\tother.Protocol = 2\n\tif _, err := (Client{Identity: other, Dir: dir}).Handshake(context.Background()); err == nil {\n\t\tt.Fatal(\"another protocol attached\")\n\t}\n}\n\n// R2: the directory and the endpoint are the user's alone; a link, a loose mode or a file\n// that is not a socket is refused, and a stale socket is replaced.\nfunc TestTheEndpointIsProtectedAndAStaleOneIsReplaced(t *testing.T) {\n\tskipUnsupported(t)\n\tid := identity(t, repo(t), \"7.4.1\")\n\tdir := shortDir(t)\n\tif err := EnsureDir(dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif info, _ := os.Stat(dir); info.Mode().Perm() != 0o700 {\n\t\tt.Fatalf(\"the directory mode is %o\", info.Mode().Perm())\n\t}\n\tif err := os.Chmod(dir, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvar unsafe *UnsafeError\n\tif err := EnsureDir(dir); !errors.As(err, &unsafe) {\n\t\tt.Fatalf(\"a directory open to others was accepted: %v\", err)\n\t}\n\t_ = os.Chmod(dir, 0o700)\n\tlink := dir + \"-link\"\n\tif err := os.Symlink(dir, link); err == nil {\n\t\tif err := EnsureDir(link); !errors.As(err, &unsafe) {\n\t\t\tt.Fatalf(\"a symlinked directory was accepted: %v\", err)\n\t\t}\n\t}\n\tpath := SocketPath(dir, id)\n\tif err := os.WriteFile(path, []byte(\"x\"), 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := Serve(context.Background(), Options{Identity: id, Dir: dir}); !errors.As(err, &unsafe) {\n\t\tt.Fatalf(\"a regular file where the socket goes was replaced: %v\", err)\n\t}\n\tos.Remove(path)\n\t// A socket nobody answers on is stale: Serve takes the name over.\n\tl, err := net.Listen(\"unix\", path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tl.(*net.UnixListener).SetUnlinkOnClose(false)\n\tl.Close()\n\tif _, err := (Client{Identity: id, Dir: dir}).Status(context.Background()); !errors.Is(err, ErrNoRuntime) {\n\t\tt.Fatalf(\"a stale endpoint is not 'no runtime': %v\", err)\n\t}\n\tcancel, done := start(t, id, dir, 0)\n\tif info, err := os.Stat(path); err != nil || info.Mode().Perm() != 0o600 {\n\t\tt.Fatalf(\"the socket mode: %v %v\", info, err)\n\t}\n\tif err := Serve(context.Background(), Options{Identity: id, Dir: dir}); !errors.Is(err, ErrAlreadyServed) {\n\t\tt.Fatalf(\"a second runtime for the same worktree started: %v\", err)\n\t}\n\tcancel()\n\t<-done\n\tif _, err := os.Lstat(path); err == nil {\n\t\tt.Fatal(\"the endpoint was left behind\")\n\t}\n}\n\n// R3: stop drains and says what finished; a restart has a new epoch; the idle timeout ends\n// an idle runtime and removes its endpoint.\nfunc TestTheLifecycleDrainsRestartsWithANewEpochAndIdlesOut(t *testing.T) {\n\tskipUnsupported(t)\n\tid := identity(t, repo(t), \"7.4.1\")\n\tdir := shortDir(t)\n\tcancel, done := start(t, id, dir, 0)\n\tc := Client{Identity: id, Dir: dir}\n\tfirst, err := c.Status(context.Background())\n\tif err != nil || first.Epoch == \"\" || first.PID != os.Getpid() {\n\t\tt.Fatalf(\"status: %+v %v\", first, err)\n\t}\n\tstopped, err := c.Stop(context.Background(), time.Second)\n\tif err != nil || !stopped.OK || stopped.Abandoned != 0 {\n\t\tt.Fatalf(\"stop: %+v %v\", stopped, err)\n\t}\n\tif err := <-done; err != nil {\n\t\tt.Fatalf(\"serve after stop: %v\", err)\n\t}\n\tcancel()\n\tif _, err := c.Status(context.Background()); !errors.Is(err, ErrNoRuntime) {\n\t\tt.Fatalf(\"the runtime answers after stop: %v\", err)\n\t}\n\tcancel2, done2 := start(t, id, dir, 0)\n\tsecond, _ := c.Status(context.Background())\n\tif second.Epoch == first.Epoch {\n\t\tt.Fatal(\"a restart inherited the epoch of the previous process\")\n\t}\n\tcancel2()\n\t<-done2\n\tcancel3, done3 := start(t, id, dir, 120*time.Millisecond)\n\tdefer cancel3()\n\tselect {\n\tcase err := <-done3:\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\tcase <-time.After(5 * time.Second):\n\t\tt.Fatal(\"an idle runtime did not stop\")\n\t}\n}\n\n// R4: with no runtime, a client gets ErrNoRuntime (the caller runs standalone) and nothing\n// is started; an unsupported platform says so.\nfunc TestWithNoRuntimeTheClientSaysSoAndStartsNothing(t *testing.T) {\n\tid := identity(t, repo(t), \"7.4.1\")\n\tdir := shortDir(t)\n\t_, err := Client{Identity: id, Dir: dir}.Handshake(context.Background())\n\tif Supported() {\n\t\tif !errors.Is(err, ErrNoRuntime) {\n\t\t\tt.Fatalf(\"handshake with no runtime: %v\", err)\n\t\t}\n\t\tif _, statErr := os.Stat(dir); statErr == nil {\n\t\t\tt.Fatal(\"the client created the endpoint directory: attach must not autostart or prepare one\")\n\t\t}\n\t} else if !errors.Is(err, ErrUnsupported) {\n\t\tt.Fatalf(\"unsupported platform: %v\", err)\n\t}\n\t_ = runtime.GOOS\n}\n\n// R9 (race): of many concurrent starts for one worktree exactly one serves, none removes the\n// socket of the one that does, and a runtime that exits removes only the endpoint it made.\nfunc TestConcurrentStartsLeaveOneRuntimeAndNoOneRemovesItsSocket(t *testing.T) {\n\tskipUnsupported(t)\n\tid := identity(t, repo(t), \"7.4.1\")\n\tdir := shortDir(t)\n\tctx, cancel := context.WithCancel(context.Background())\n\tconst n = 8\n\tresults := make(chan error, n)\n\tfor i := 0; i < n; i++ {\n\t\tgo func() { results <- Serve(ctx, Options{Identity: id, Dir: dir}) }()\n\t}\n\tvar refused int\n\tfor i := 0; i < n-1; i++ {\n\t\tselect {\n\t\tcase err := <-results:\n\t\t\tif !errors.Is(err, ErrAlreadyServed) {\n\t\t\t\tt.Fatalf(\"a losing start returned %v\", err)\n\t\t\t}\n\t\t\trefused++\n\t\tcase <-time.After(10 * time.Second):\n\t\t\tt.Fatal(\"a losing start did not return\")\n\t\t}\n\t}\n\tc := Client{Identity: id, Dir: dir}\n\tif _, err := c.Handshake(context.Background()); err != nil {\n\t\tt.Fatalf(\"the winner does not answer after the losers returned: %v\", err)\n\t}\n\tcancel()\n\tif err := <-results; err != nil {\n\t\tt.Fatalf(\"the winner: %v\", err)\n\t}\n\t// An orphan that exits after a successor took the name must not remove the successor's socket.\n\tpath := SocketPath(dir, id)\n\tours, err := os.Lstat(path)\n\tif err == nil {\n\t\tt.Fatalf(\"the endpoint outlived its runtime: %v\", ours)\n\t}\n\t_ = refused\n}\n\n// F4: a stop does not accept new connections while it drains, so what it reports is what was\n// in flight when it began.\nfunc TestAStopAcceptsNothingWhileItDrains(t *testing.T) {\n\tskipUnsupported(t)\n\tid := identity(t, repo(t), \"7.4.1\")\n\tdir := shortDir(t)\n\tcancel, done := start(t, id, dir, 0)\n\tdefer cancel()\n\tc := Client{Identity: id, Dir: dir}\n\treply, err := c.Stop(context.Background(), time.Second)\n\tif err != nil || reply.Drained < 0 || reply.Abandoned != 0 {\n\t\tt.Fatalf(\"stop: %+v %v\", reply, err)\n\t}\n\t<-done\n\tif _, err := c.Status(context.Background()); !errors.Is(err, ErrNoRuntime) {\n\t\tt.Fatalf(\"a connection was accepted after the stop: %v\", err)\n\t}\n}\n\n// G6: a runtime that exits after a successor took its name removes nothing: the endpoint it\n// finds is not the inode it created.\nfunc TestARuntimeThatOutlivesItsEndpointRemovesOnlyItsOwn(t *testing.T) {\n\tskipUnsupported(t)\n\tid := identity(t, repo(t), \"7.4.1\")\n\tdir := shortDir(t)\n\tcancel, done := start(t, id, dir, 0)\n\tpath := SocketPath(dir, id)\n\tif err := os.Remove(path); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsuccessor, err := net.Listen(\"unix\", path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer successor.Close()\n\tcancel()\n\t<-done\n\tif _, err := os.Lstat(path); err != nil {\n\t\tt.Fatalf(\"the exiting runtime removed the endpoint of its successor: %v\", err)\n\t}\n}\n\n// R3: a stop with a request in flight reports it drained when it finishes inside the deadline\n// and abandoned when it does not, and accepts nothing new while it waits.\nfunc TestAStopReportsWhatItDrainedAndWhatItAbandoned(t *testing.T) {\n\tskipUnsupported(t)\n\tfor _, tc := range []struct {\n\t\tname                string\n\t\thold, drain         time.Duration\n\t\twantDrained, wantAb int64\n\t}{\n\t\t{\"drained\", 150 * time.Millisecond, 3 * time.Second, 1, 0},\n\t\t{\"abandoned\", 2 * time.Second, 100 * time.Millisecond, 0, 1},\n\t} {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tid := identity(t, repo(t), \"7.4.1\")\n\t\t\tdir := shortDir(t)\n\t\t\tentered := make(chan struct{}, 1)\n\t\t\tctx, cancel := context.WithCancel(context.Background())\n\t\t\tdefer cancel()\n\t\t\tdone := make(chan error, 1)\n\t\t\tgo func() {\n\t\t\t\tdone <- Serve(ctx, Options{Identity: id, Dir: dir, Handler: func(_ context.Context, op string) (Reply, bool) {\n\t\t\t\t\tif op != \"hold\" {\n\t\t\t\t\t\treturn Reply{}, false\n\t\t\t\t\t}\n\t\t\t\t\tentered <- struct{}{}\n\t\t\t\t\ttime.Sleep(tc.hold)\n\t\t\t\t\treturn Reply{OK: true}, true\n\t\t\t\t}})\n\t\t\t}()\n\t\t\tc := Client{Identity: id, Dir: dir}\n\t\t\tfor i := 0; i < 200; i++ {\n\t\t\t\tif _, err := c.Status(context.Background()); err == nil {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t\ttime.Sleep(10 * time.Millisecond)\n\t\t\t}\n\t\t\tgo c.Do(context.Background(), \"hold\")\n\t\t\t<-entered\n\t\t\tstopped := make(chan Reply, 1)\n\t\t\tgo func() { r, _ := c.Stop(context.Background(), tc.drain); stopped <- r }()\n\t\t\ttime.Sleep(50 * time.Millisecond)\n\t\t\tif _, err := c.Status(context.Background()); !errors.Is(err, ErrNoRuntime) {\n\t\t\t\tt.Fatalf(\"a connection was accepted while the stop drained: %v\", err)\n\t\t\t}\n\t\t\treply := <-stopped\n\t\t\tif reply.Drained != tc.wantDrained || reply.Abandoned != tc.wantAb {\n\t\t\t\tt.Fatalf(\"drained %d abandoned %d, want %d and %d\", reply.Drained, reply.Abandoned, tc.wantDrained, tc.wantAb)\n\t\t\t}\n\t\t\t<-done\n\t\t\tif !c.WaitReleased(context.Background(), 5*time.Second) {\n\t\t\t\tt.Fatal(\"the endpoint was not released after the runtime exited\")\n\t\t\t}\n\t\t})\n\t}\n}\n","numLines":364,"startLine":1,"totalLines":364}},"tool_result_meta":[{"id":"toolu_01FwE1ro6f8JzouhyawLbb1E","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
