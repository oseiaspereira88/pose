{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CGeYjwwKapFcqMN5GghR9A","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"os\"\n10\t\t\"os/exec\"\n11\t\t\"os/signal\"\n12\t\t\"runtime/debug\"\n13\t\t\"strings\"\n14\t\t\"syscall\"\n15\t\t\"time\"\n16\t\n17\t\t\"github.com/harne8/pose-mcp/internal/version\"\n18\t\t\"github.com/harne8/pose-mcp/internal/worktreeruntime\"\n19\t)\n20\t\n21\t// Spec pose-optional-worktree-runtime. The runtime is opt-in: nothing here starts it unless\n22\t// asked, and every other command runs standalone whether it runs or not.\n23\t\n24\tconst runtimeStatusSchema = \"pose.runtime.status/1\"\n25\t\n26\t// runtimeSpawn starts the runtime of root detached; tests replace it.\n27\tvar runtimeSpawn = func(root string, idle time.Duration) error {\n28\t\tself, err := os.Executable()\n29\t\tif err != nil {\n30\t\t\treturn err\n31\t\t}\n32\t\tcmd := exec.Command(self, \"runtime\", \"serve\", \"--idle\", idle.String())\n33\t\tcmd.Dir = root\n34\t\tcmd.Env = os.Environ()\n35\t\tcmd.Stdin, cmd.Stdout, cmd.Stderr = nil, nil, nil\n36\t\tdetachProcess(cmd)\n37\t\tif err := cmd.Start(); err != nil {\n38\t\t\treturn err\n39\t\t}\n40\t\treturn cmd.Process.Release()\n41\t}\n42\t\n43\tfunc runtimeBuild() string {\n44\t\tif info, ok := debug.ReadBuildInfo(); ok {\n45\t\t\tfor _, s := range info.Settings {\n46\t\t\t\tif s.Key == \"vcs.revision\" && s.Value != \"\" {\n47\t\t\t\t\treturn s.Value\n48\t\t\t\t}\n49\t\t\t}\n50\t\t}\n51\t\treturn \"unknown\"\n52\t}\n53\t\n54\ttype runtimeFlags struct {\n55\t\tjsonOut bool\n56\t\tidle    time.Duration\n57\t\tdrain   time.Duration\n58\t}\n59\t\n60\tfunc parseRuntimeFlags(args []string) (runtimeFlags, string) {\n61\t\tf := runtimeFlags{idle: 30 * time.Minute, drain: 5 * time.Second}\n62\t\tfor i := 0; i < len(args); i++ {\n63\t\t\tswitch args[i] {\n64\t\t\tcase \"--json\":\n65\t\t\t\tf.jsonOut = true\n66\t\t\tcase \"--idle\", \"--drain\":\n67\t\t\t\tif i+1 >= len(args) {\n68\t\t\t\t\treturn f, args[i] + \" needs a duration\"\n69\t\t\t\t}\n70\t\t\t\td, err := time.ParseDuration(args[i+1])\n71\t\t\t\tif err != nil || d < 0 || args[i] == \"--drain\" && d < time.Millisecond {\n72\t\t\t\t\treturn f, args[i] + \": \" + args[i+1] + \" is not a duration\"\n73\t\t\t\t}\n74\t\t\t\tif args[i] == \"--idle\" {\n75\t\t\t\t\tf.idle = d\n76\t\t\t\t} else {\n77\t\t\t\t\tf.drain = d\n78\t\t\t\t}\n79\t\t\t\ti++\n80\t\t\tdefault:\n81\t\t\t\treturn f, \"unknown argument \" + args[i]\n82\t\t\t}\n83\t\t}\n84\t\treturn f, \"\"\n85\t}\n86\t\n87\t// cmdRuntime is `pose runtime serve|start|attach|status|stop|restart`.\n88\tfunc cmdRuntime(root string, args []string, stdout, stderr io.Writer) int {\n89\t\tout := render(stdout, stderr)\n90\t\tif len(args) == 0 {\n91\t\t\tout.Usage(tr(\"usage: pose runtime <serve|start|attach|status|stop|restart> [--idle <d>] [--drain <d>] [--json]\", \"uso: pose runtime <serve|start|attach|status|stop|restart> [--idle <d>] [--drain <d>] [--json]\"))\n92\t\t\treturn 2\n93\t\t}\n94\t\tsub := args[0]\n95\t\tf, problem := parseRuntimeFlags(args[1:])\n96\t\tif problem != \"\" {\n97\t\t\tout.Failure(\"pose runtime: \" + problem)\n98\t\t\treturn 2\n99\t\t}\n100\t\tid, err := worktreeruntime.ResolveIdentity(root, version.Version, runtimeBuild())\n101\t\tif err != nil {\n102\t\t\tout.Failure(\"pose runtime: \" + err.Error())\n103\t\t\treturn 2\n104\t\t}\n105\t\tclient := worktreeruntime.Client{Identity: id, Dir: worktreeruntime.DefaultDir()}\n106\t\tctx := context.Background()\n107\t\tswitch sub {\n108\t\tcase \"serve\":\n109\t\t\tsigs := make(chan os.Signal, 1)\n110\t\t\tsignal.Notify(sigs, os.Interrupt, syscall.SIGTERM)\n111\t\t\tserveCtx, cancel := context.WithCancel(ctx)\n112\t\t\tdefer cancel()\n113\t\t\tgo func() { <-sigs; cancel() }()\n114\t\t\tif err := worktreeruntime.Serve(serveCtx, worktreeruntime.Options{Identity: id, Dir: client.Dir, Idle: f.idle}); err != nil {\n115\t\t\t\treturn runtimeFailure(out, stdout, f, \"serve\", err)\n116\t\t\t}\n117\t\t\treturn 0\n118\t\tcase \"status\", \"attach\":\n119\t\t\treply, err := client.Handshake(ctx)\n120\t\t\treturn runtimeReport(out, stdout, f, sub, reply, err)\n121\t\tcase \"stop\":\n122\t\t\treply, err := client.Stop(ctx, f.drain)\n123\t\t\tif errors.Is(err, worktreeruntime.ErrNoRuntime) || errors.Is(err, worktreeruntime.ErrUnsupported) {\n124\t\t\t\treturn runtimeReport(out, stdout, f, sub, reply, err)\n125\t\t\t}\n126\t\t\tif err != nil {\n127\t\t\t\treturn runtimeFailure(out, stdout, f, sub, err)\n128\t\t\t}\n129\t\t\treturn runtimeReport(out, stdout, f, \"stopped\", reply, nil)\n130\t\tcase \"start\", \"restart\":\n131\t\t\tif sub == \"restart\" {\n132\t\t\t\tstopped, err := client.Stop(ctx, f.drain)\n133\t\t\t\tif err != nil && !errors.Is(err, worktreeruntime.ErrNoRuntime) {\n134\t\t\t\t\treturn runtimeReport(out, stdout, f, sub, stopped, err)\n135\t\t\t\t}\n136\t\t\t\tif stopped.Abandoned > 0 {\n137\t\t\t\t\t// The process is still ending what it abandoned and holds the endpoint: a new\n138\t\t\t\t\t// one would be refused, so the restart says so instead of starting it.\n139\t\t\t\t\treturn runtimeFailure(out, stdout, f, sub, fmt.Errorf(\"the runtime abandoned %d request(s) in flight and is still ending them (pid %d); start again when it has exited\", stopped.Abandoned, stopped.PID))\n140\t\t\t\t}\n141\t\t\t\twaitRuntimeGone(ctx, client)\n142\t\t\t}\n143\t\t\tif reply, err := client.Handshake(ctx); err == nil {\n144\t\t\t\treturn runtimeReport(out, stdout, f, \"already-running\", reply, nil)\n145\t\t\t} else if !errors.Is(err, worktreeruntime.ErrNoRuntime) {\n146\t\t\t\treturn runtimeReport(out, stdout, f, sub, worktreeruntime.Reply{}, err)\n147\t\t\t}\n148\t\t\tif !worktreeruntime.Supported() {\n149\t\t\t\treturn runtimeFailure(out, stdout, f, sub, worktreeruntime.ErrUnsupported)\n150\t\t\t}\n151\t\t\tif err := runtimeSpawn(root, f.idle); err != nil {\n152\t\t\t\treturn runtimeFailure(out, stdout, f, sub, err)\n153\t\t\t}\n154\t\t\tvar reply worktreeruntime.Reply\n155\t\t\tfor i := 0; i < 100; i++ {\n156\t\t\t\tif reply, err = client.Handshake(ctx); err == nil {\n157\t\t\t\t\treturn runtimeReport(out, stdout, f, \"started\", reply, nil)\n158\t\t\t\t}\n159\t\t\t\ttime.Sleep(50 * time.Millisecond)\n160\t\t\t}\n161\t\t\treturn runtimeFailure(out, stdout, f, sub, fmt.Errorf(\"the runtime did not answer after it was started: %w\", err))\n162\t\t}\n163\t\tout.Failure(\"pose runtime: \" + tr(\"unknown subcommand \", \"subcomando desconhecido \") + sub)\n164\t\treturn 2\n165\t}\n166\t\n167\t// waitRuntimeGone waits until the endpoint can be taken: nothing answers and the old process\n168\t// has released its lock, which happens after the socket is gone.\n169\tfunc waitRuntimeGone(ctx context.Context, client worktreeruntime.Client) {\n170\t\tclient.WaitReleased(ctx, 10*time.Second)\n171\t}\n172\t\n173\t// runtimeReport writes the state a subcommand ends in. Not running is a state, not a fault:\n174\t// every command runs standalone then; only a runtime that refuses the attach, or an attach\n175\t// that was asked for and cannot be had, is a failure.\n176\tfunc runtimeReport(out interface{ Field(string, string) }, stdout io.Writer, f runtimeFlags, sub string, reply worktreeruntime.Reply, err error) int {\n177\t\tstate, code, detail := \"running\", 0, \"\"\n178\t\tswitch {\n179\t\tcase errors.Is(err, worktreeruntime.ErrUnsupported):\n180\t\t\tstate, detail = \"unsupported\", err.Error()\n181\t\tcase errors.Is(err, worktreeruntime.ErrNoRuntime):\n182\t\t\tstate, detail = \"standalone\", tr(\"no runtime is running for this worktree: commands run standalone\", \"nenhum runtime está rodando para este worktree: os comandos rodam standalone\")\n183\t\tcase err != nil:\n184\t\t\tvar inc *worktreeruntime.IncompatibleError\n185\t\t\tif errors.As(err, &inc) {\n186\t\t\t\tstate, code, detail = \"incompatible\", 1, err.Error()+tr(\"; stop it with `pose runtime stop` (this engine can, whatever its version) or end process \", \"; pare-o com `pose runtime stop` (este engine consegue, qualquer que seja a versão) ou encerre o processo \")+fmt.Sprint(reply.PID)\n187\t\t\t} else {\n188\t\t\t\treturn runtimeFailureFields(out, stdout, f, sub, err)\n189\t\t\t}\n190\t\tdefault:\n191\t\t\tstate = sub\n192\t\t\tif sub == \"status\" {\n193\t\t\t\tstate = \"running\"\n194\t\t\t}\n195\t\t}\n196\t\tif sub == \"attach\" && (state == \"standalone\" || state == \"unsupported\") {\n197\t\t\tcode = 1\n198\t\t}\n199\t\tif f.jsonOut {\n200\t\t\tdoc := map[string]any{\"schema\": runtimeStatusSchema, \"state\": state, \"detail\": detail, \"supported\": worktreeruntime.Supported()}\n201\t\t\tif reply.Epoch != \"\" {\n202\t\t\t\tdoc[\"epoch\"], doc[\"pid\"], doc[\"started_at\"], doc[\"in_flight\"], doc[\"served\"] = reply.Epoch, reply.PID, reply.StartedAt, reply.InFlight, reply.Served\n203\t\t\t\tdoc[\"drained\"], doc[\"abandoned\"] = reply.Drained, reply.Abandoned\n204\t\t\t}\n205\t\t\tenc := json.NewEncoder(stdout)\n206\t\t\t_ = enc.Encode(doc)\n207\t\t\treturn code\n208\t\t}\n209\t\tout.Field(\"runtime.state\", state)\n210\t\tif detail != \"\" {\n211\t\t\tout.Field(\"runtime.detail\", detail)\n212\t\t}\n213\t\tif reply.Epoch != \"\" {\n214\t\t\tout.Field(\"runtime.epoch\", reply.Epoch)\n215\t\t\tout.Field(\"runtime.pid\", fmt.Sprint(reply.PID))\n216\t\t\tout.Field(\"runtime.started_at\", reply.StartedAt)\n217\t\t\tout.Field(\"runtime.in_flight\", fmt.Sprint(reply.InFlight))\n218\t\t\tif state == \"stopped\" {\n219\t\t\t\tout.Field(\"runtime.drained\", fmt.Sprint(reply.Drained))\n220\t\t\t\tout.Field(\"runtime.abandoned\", fmt.Sprint(reply.Abandoned))\n221\t\t\t}\n222\t\t}\n223\t\treturn code\n224\t}\n225\t\n226\tfunc runtimeFailure(out interface {\n227\t\tField(string, string)\n228\t\tFailure(string)\n229\t}, stdout io.Writer, f runtimeFlags, sub string, err error) int {\n230\t\tif f.jsonOut {\n231\t\t\t_ = json.NewEncoder(stdout).Encode(map[string]any{\"schema\": runtimeStatusSchema, \"state\": \"error\", \"detail\": err.Error(), \"supported\": worktreeruntime.Supported()})\n232\t\t\treturn 1\n233\t\t}\n234\t\tout.Failure(\"pose runtime \" + sub + \": \" + err.Error())\n235\t\treturn 1\n236\t}\n237\t\n238\tfunc runtimeFailureFields(out interface{ Field(string, string) }, stdout io.Writer, f runtimeFlags, sub string, err error) int {\n239\t\tif f.jsonOut {\n240\t\t\t_ = json.NewEncoder(stdout).Encode(map[string]any{\"schema\": runtimeStatusSchema, \"state\": \"error\", \"detail\": strings.TrimSpace(err.Error()), \"supported\": worktreeruntime.Supported()})\n241\t\t\treturn 1\n242\t\t}\n243\t\tout.Field(\"runtime.error\", strings.TrimSpace(err.Error()))\n244\t\treturn 1\n245\t}\n246\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"dd4d6516-c212-49bd-b877-d3ca8dc60fa6","timestamp":"2026-11-09T23:37:26.339Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-1986613151/worktree/pose-mcp/internal/cli/runtime_cmd.go","content":"package cli\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"os/signal\"\n\t\"runtime/debug\"\n\t\"strings\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/harne8/pose-mcp/internal/version\"\n\t\"github.com/harne8/pose-mcp/internal/worktreeruntime\"\n)\n\n// Spec pose-optional-worktree-runtime. The runtime is opt-in: nothing here starts it unless\n// asked, and every other command runs standalone whether it runs or not.\n\nconst runtimeStatusSchema = \"pose.runtime.status/1\"\n\n// runtimeSpawn starts the runtime of root detached; tests replace it.\nvar runtimeSpawn = func(root string, idle time.Duration) error {\n\tself, err := os.Executable()\n\tif err != nil {\n\t\treturn err\n\t}\n\tcmd := exec.Command(self, \"runtime\", \"serve\", \"--idle\", idle.String())\n\tcmd.Dir = root\n\tcmd.Env = os.Environ()\n\tcmd.Stdin, cmd.Stdout, cmd.Stderr = nil, nil, nil\n\tdetachProcess(cmd)\n\tif err := cmd.Start(); err != nil {\n\t\treturn err\n\t}\n\treturn cmd.Process.Release()\n}\n\nfunc runtimeBuild() string {\n\tif info, ok := debug.ReadBuildInfo(); ok {\n\t\tfor _, s := range info.Settings {\n\t\t\tif s.Key == \"vcs.revision\" && s.Value != \"\" {\n\t\t\t\treturn s.Value\n\t\t\t}\n\t\t}\n\t}\n\treturn \"unknown\"\n}\n\ntype runtimeFlags struct {\n\tjsonOut bool\n\tidle    time.Duration\n\tdrain   time.Duration\n}\n\nfunc parseRuntimeFlags(args []string) (runtimeFlags, string) {\n\tf := runtimeFlags{idle: 30 * time.Minute, drain: 5 * time.Second}\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--json\":\n\t\t\tf.jsonOut = true\n\t\tcase \"--idle\", \"--drain\":\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn f, args[i] + \" needs a duration\"\n\t\t\t}\n\t\t\td, err := time.ParseDuration(args[i+1])\n\t\t\tif err != nil || d < 0 || args[i] == \"--drain\" && d < time.Millisecond {\n\t\t\t\treturn f, args[i] + \": \" + args[i+1] + \" is not a duration\"\n\t\t\t}\n\t\t\tif args[i] == \"--idle\" {\n\t\t\t\tf.idle = d\n\t\t\t} else {\n\t\t\t\tf.drain = d\n\t\t\t}\n\t\t\ti++\n\t\tdefault:\n\t\t\treturn f, \"unknown argument \" + args[i]\n\t\t}\n\t}\n\treturn f, \"\"\n}\n\n// cmdRuntime is `pose runtime serve|start|attach|status|stop|restart`.\nfunc cmdRuntime(root string, args []string, stdout, stderr io.Writer) int {\n\tout := render(stdout, stderr)\n\tif len(args) == 0 {\n\t\tout.Usage(tr(\"usage: pose runtime <serve|start|attach|status|stop|restart> [--idle <d>] [--drain <d>] [--json]\", \"uso: pose runtime <serve|start|attach|status|stop|restart> [--idle <d>] [--drain <d>] [--json]\"))\n\t\treturn 2\n\t}\n\tsub := args[0]\n\tf, problem := parseRuntimeFlags(args[1:])\n\tif problem != \"\" {\n\t\tout.Failure(\"pose runtime: \" + problem)\n\t\treturn 2\n\t}\n\tid, err := worktreeruntime.ResolveIdentity(root, version.Version, runtimeBuild())\n\tif err != nil {\n\t\tout.Failure(\"pose runtime: \" + err.Error())\n\t\treturn 2\n\t}\n\tclient := worktreeruntime.Client{Identity: id, Dir: worktreeruntime.DefaultDir()}\n\tctx := context.Background()\n\tswitch sub {\n\tcase \"serve\":\n\t\tsigs := make(chan os.Signal, 1)\n\t\tsignal.Notify(sigs, os.Interrupt, syscall.SIGTERM)\n\t\tserveCtx, cancel := context.WithCancel(ctx)\n\t\tdefer cancel()\n\t\tgo func() { <-sigs; cancel() }()\n\t\tif err := worktreeruntime.Serve(serveCtx, worktreeruntime.Options{Identity: id, Dir: client.Dir, Idle: f.idle}); err != nil {\n\t\t\treturn runtimeFailure(out, stdout, f, \"serve\", err)\n\t\t}\n\t\treturn 0\n\tcase \"status\", \"attach\":\n\t\treply, err := client.Handshake(ctx)\n\t\treturn runtimeReport(out, stdout, f, sub, reply, err)\n\tcase \"stop\":\n\t\treply, err := client.Stop(ctx, f.drain)\n\t\tif errors.Is(err, worktreeruntime.ErrNoRuntime) || errors.Is(err, worktreeruntime.ErrUnsupported) {\n\t\t\treturn runtimeReport(out, stdout, f, sub, reply, err)\n\t\t}\n\t\tif err != nil {\n\t\t\treturn runtimeFailure(out, stdout, f, sub, err)\n\t\t}\n\t\treturn runtimeReport(out, stdout, f, \"stopped\", reply, nil)\n\tcase \"start\", \"restart\":\n\t\tif sub == \"restart\" {\n\t\t\tstopped, err := client.Stop(ctx, f.drain)\n\t\t\tif err != nil && !errors.Is(err, worktreeruntime.ErrNoRuntime) {\n\t\t\t\treturn runtimeReport(out, stdout, f, sub, stopped, err)\n\t\t\t}\n\t\t\tif stopped.Abandoned > 0 {\n\t\t\t\t// The process is still ending what it abandoned and holds the endpoint: a new\n\t\t\t\t// one would be refused, so the restart says so instead of starting it.\n\t\t\t\treturn runtimeFailure(out, stdout, f, sub, fmt.Errorf(\"the runtime abandoned %d request(s) in flight and is still ending them (pid %d); start again when it has exited\", stopped.Abandoned, stopped.PID))\n\t\t\t}\n\t\t\twaitRuntimeGone(ctx, client)\n\t\t}\n\t\tif reply, err := client.Handshake(ctx); err == nil {\n\t\t\treturn runtimeReport(out, stdout, f, \"already-running\", reply, nil)\n\t\t} else if !errors.Is(err, worktreeruntime.ErrNoRuntime) {\n\t\t\treturn runtimeReport(out, stdout, f, sub, worktreeruntime.Reply{}, err)\n\t\t}\n\t\tif !worktreeruntime.Supported() {\n\t\t\treturn runtimeFailure(out, stdout, f, sub, worktreeruntime.ErrUnsupported)\n\t\t}\n\t\tif err := runtimeSpawn(root, f.idle); err != nil {\n\t\t\treturn runtimeFailure(out, stdout, f, sub, err)\n\t\t}\n\t\tvar reply worktreeruntime.Reply\n\t\tfor i := 0; i < 100; i++ {\n\t\t\tif reply, err = client.Handshake(ctx); err == nil {\n\t\t\t\treturn runtimeReport(out, stdout, f, \"started\", reply, nil)\n\t\t\t}\n\t\t\ttime.Sleep(50 * time.Millisecond)\n\t\t}\n\t\treturn runtimeFailure(out, stdout, f, sub, fmt.Errorf(\"the runtime did not answer after it was started: %w\", err))\n\t}\n\tout.Failure(\"pose runtime: \" + tr(\"unknown subcommand \", \"subcomando desconhecido \") + sub)\n\treturn 2\n}\n\n// waitRuntimeGone waits until the endpoint can be taken: nothing answers and the old process\n// has released its lock, which happens after the socket is gone.\nfunc waitRuntimeGone(ctx context.Context, client worktreeruntime.Client) {\n\tclient.WaitReleased(ctx, 10*time.Second)\n}\n\n// runtimeReport writes the state a subcommand ends in. Not running is a state, not a fault:\n// every command runs standalone then; only a runtime that refuses the attach, or an attach\n// that was asked for and cannot be had, is a failure.\nfunc runtimeReport(out interface{ Field(string, string) }, stdout io.Writer, f runtimeFlags, sub string, reply worktreeruntime.Reply, err error) int {\n\tstate, code, detail := \"running\", 0, \"\"\n\tswitch {\n\tcase errors.Is(err, worktreeruntime.ErrUnsupported):\n\t\tstate, detail = \"unsupported\", err.Error()\n\tcase errors.Is(err, worktreeruntime.ErrNoRuntime):\n\t\tstate, detail = \"standalone\", tr(\"no runtime is running for this worktree: commands run standalone\", \"nenhum runtime está rodando para este worktree: os comandos rodam standalone\")\n\tcase err != nil:\n\t\tvar inc *worktreeruntime.IncompatibleError\n\t\tif errors.As(err, &inc) {\n\t\t\tstate, code, detail = \"incompatible\", 1, err.Error()+tr(\"; stop it with `pose runtime stop` (this engine can, whatever its version) or end process \", \"; pare-o com `pose runtime stop` (este engine consegue, qualquer que seja a versão) ou encerre o processo \")+fmt.Sprint(reply.PID)\n\t\t} else {\n\t\t\treturn runtimeFailureFields(out, stdout, f, sub, err)\n\t\t}\n\tdefault:\n\t\tstate = sub\n\t\tif sub == \"status\" {\n\t\t\tstate = \"running\"\n\t\t}\n\t}\n\tif sub == \"attach\" && (state == \"standalone\" || state == \"unsupported\") {\n\t\tcode = 1\n\t}\n\tif f.jsonOut {\n\t\tdoc := map[string]any{\"schema\": runtimeStatusSchema, \"state\": state, \"detail\": detail, \"supported\": worktreeruntime.Supported()}\n\t\tif reply.Epoch != \"\" {\n\t\t\tdoc[\"epoch\"], doc[\"pid\"], doc[\"started_at\"], doc[\"in_flight\"], doc[\"served\"] = reply.Epoch, reply.PID, reply.StartedAt, reply.InFlight, reply.Served\n\t\t\tdoc[\"drained\"], doc[\"abandoned\"] = reply.Drained, reply.Abandoned\n\t\t}\n\t\tenc := json.NewEncoder(stdout)\n\t\t_ = enc.Encode(doc)\n\t\treturn code\n\t}\n\tout.Field(\"runtime.state\", state)\n\tif detail != \"\" {\n\t\tout.Field(\"runtime.detail\", detail)\n\t}\n\tif reply.Epoch != \"\" {\n\t\tout.Field(\"runtime.epoch\", reply.Epoch)\n\t\tout.Field(\"runtime.pid\", fmt.Sprint(reply.PID))\n\t\tout.Field(\"runtime.started_at\", reply.StartedAt)\n\t\tout.Field(\"runtime.in_flight\", fmt.Sprint(reply.InFlight))\n\t\tif state == \"stopped\" {\n\t\t\tout.Field(\"runtime.drained\", fmt.Sprint(reply.Drained))\n\t\t\tout.Field(\"runtime.abandoned\", fmt.Sprint(reply.Abandoned))\n\t\t}\n\t}\n\treturn code\n}\n\nfunc runtimeFailure(out interface {\n\tField(string, string)\n\tFailure(string)\n}, stdout io.Writer, f runtimeFlags, sub string, err error) int {\n\tif f.jsonOut {\n\t\t_ = json.NewEncoder(stdout).Encode(map[string]any{\"schema\": runtimeStatusSchema, \"state\": \"error\", \"detail\": err.Error(), \"supported\": worktreeruntime.Supported()})\n\t\treturn 1\n\t}\n\tout.Failure(\"pose runtime \" + sub + \": \" + err.Error())\n\treturn 1\n}\n\nfunc runtimeFailureFields(out interface{ Field(string, string) }, stdout io.Writer, f runtimeFlags, sub string, err error) int {\n\tif f.jsonOut {\n\t\t_ = json.NewEncoder(stdout).Encode(map[string]any{\"schema\": runtimeStatusSchema, \"state\": \"error\", \"detail\": strings.TrimSpace(err.Error()), \"supported\": worktreeruntime.Supported()})\n\t\treturn 1\n\t}\n\tout.Field(\"runtime.error\", strings.TrimSpace(err.Error()))\n\treturn 1\n}\n","numLines":246,"startLine":1,"totalLines":246}},"tool_result_meta":[{"id":"toolu_01CGeYjwwKapFcqMN5GghR9A","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
