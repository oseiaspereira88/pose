{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V8nvYjAhZqSy145KQdczud","type":"tool_result","content":"1\t// Package worktreeruntime is the optional runtime of one worktree: a process that\n2\t// answers handshake, status and stop on a protected local socket (spec\n3\t// pose-optional-worktree-runtime). It hosts no domain operation and confers no\n4\t// authority: a client that attaches gains nothing it did not have standalone.\n5\tpackage worktreeruntime\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"context\"\n10\t\t\"crypto/rand\"\n11\t\t\"crypto/sha256\"\n12\t\t\"encoding/hex\"\n13\t\t\"encoding/json\"\n14\t\t\"errors\"\n15\t\t\"fmt\"\n16\t\t\"io\"\n17\t\t\"net\"\n18\t\t\"os\"\n19\t\t\"path/filepath\"\n20\t\t\"sort\"\n21\t\t\"strings\"\n22\t\t\"sync\"\n23\t\t\"sync/atomic\"\n24\t\t\"time\"\n25\t\n26\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n27\t)\n28\t\n29\tconst (\n30\t\t// Protocol is the wire protocol; Schema names the message shapes.\n31\t\tProtocol = 1\n32\t\tSchema   = \"pose.runtime.v1\"\n33\t\t// EnvDir overrides the directory of the endpoints (tests, unusual layouts).\n34\t\tEnvDir = \"POSE_RUNTIME_DIR\"\n35\t\n36\t\tmaxRequest       = 64 << 10\n37\t\trequestDeadline  = 5 * time.Second\n38\t\tdefaultDrain     = 5 * time.Second\n39\t\tsocketNameDigits = 12\n40\t)\n41\t\n42\t// Identity is what must be the same on both ends of an attach. The location part (user,\n43\t// worktree, Git common directory) names the endpoint; the engine part (engine, build,\n44\t// protocol, schema) is compared at the handshake, so a new CLI that finds an old\n45\t// process after an update is refused by name instead of being given a different endpoint.\n46\ttype Identity struct {\n47\t\tUID          int    `json:\"uid\"`\n48\t\tWorktree     string `json:\"worktree\"`\n49\t\tGitCommonDir string `json:\"git_common_dir\"`\n50\t\tEngine       string `json:\"engine\"`\n51\t\tBuild        string `json:\"build\"`\n52\t\tProtocol     int    `json:\"protocol\"`\n53\t\tSchema       string `json:\"schema\"`\n54\t}\n55\t\n56\t// ResolveIdentity reads the identity of the worktree at root for this engine. The root's\n57\t// symlinks are resolved and the Git common directory is read, so neither project_id nor\n58\t// the common directory alone names a mutable tree.\n59\tfunc ResolveIdentity(root, engine, build string) (Identity, error) {\n60\t\tworktree, err := filepath.EvalSymlinks(root)\n61\t\tif err == nil {\n62\t\t\tworktree, err = filepath.Abs(worktree)\n63\t\t}\n64\t\tif err != nil {\n65\t\t\treturn Identity{}, fmt.Errorf(\"the worktree %s cannot be resolved: %w\", root, err)\n66\t\t}\n67\t\tout, err := posemodel.RawHistoryGit(worktree, \"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\").Output()\n68\t\tif err != nil {\n69\t\t\treturn Identity{}, fmt.Errorf(\"%s is not a Git worktree, or git failed (%v): the runtime is identified by it\", worktree, err)\n70\t\t}\n71\t\tcommon := strings.TrimSpace(string(out))\n72\t\tif resolved, err := filepath.EvalSymlinks(common); err == nil {\n73\t\t\tcommon = resolved\n74\t\t}\n75\t\treturn Identity{UID: os.Getuid(), Worktree: worktree, GitCommonDir: common, Engine: engine, Build: build, Protocol: Protocol, Schema: Schema}, nil\n76\t}\n77\t\n78\t// location is the digest of the part that names the endpoint.\n79\tfunc (i Identity) location() string {\n80\t\tsum := sha256.Sum256([]byte(fmt.Sprintf(\"%d\\x00%s\\x00%s\", i.UID, i.Worktree, i.GitCommonDir)))\n81\t\treturn hex.EncodeToString(sum[:])[:socketNameDigits]\n82\t}\n83\t\n84\t// Mismatches names each field of the engine part where other differs from i.\n85\tfunc (i Identity) Mismatches(other Identity) []string {\n86\t\tvar out []string\n87\t\tadd := func(name string, mine, theirs any) {\n88\t\t\tif fmt.Sprint(mine) != fmt.Sprint(theirs) {\n89\t\t\t\tout = append(out, fmt.Sprintf(\"%s: this side %v, the other %v\", name, mine, theirs))\n90\t\t\t}\n91\t\t}\n92\t\tadd(\"uid\", i.UID, other.UID)\n93\t\tadd(\"worktree\", i.Worktree, other.Worktree)\n94\t\tadd(\"git_common_dir\", i.GitCommonDir, other.GitCommonDir)\n95\t\tadd(\"engine\", i.Engine, other.Engine)\n96\t\tadd(\"build\", i.Build, other.Build)\n97\t\tadd(\"protocol\", i.Protocol, other.Protocol)\n98\t\tadd(\"schema\", i.Schema, other.Schema)\n99\t\treturn out\n100\t}\n101\t\n102\t// DefaultDir is the directory of the endpoints of the current user.\n103\tfunc DefaultDir() string {\n104\t\tif dir := os.Getenv(EnvDir); dir != \"\" {\n105\t\t\treturn dir\n106\t\t}\n107\t\tif run := os.Getenv(\"XDG_RUNTIME_DIR\"); filepath.IsAbs(run) {\n108\t\t\treturn filepath.Join(run, \"pose\")\n109\t\t}\n110\t\treturn filepath.Join(os.TempDir(), fmt.Sprintf(\"pose-runtime-%d\", os.Getuid()))\n111\t}\n112\t\n113\t// SocketPath is where the endpoint of the identity lives in dir.\n114\tfunc SocketPath(dir string, id Identity) string {\n115\t\treturn filepath.Join(dir, id.location()+\".sock\")\n116\t}\n117\t\n118\t// Errors a client can tell apart.\n119\tvar (\n120\t\tErrUnsupported   = errors.New(\"the worktree runtime is not supported on this platform: every command runs standalone\")\n121\t\tErrNoRuntime     = errors.New(\"no runtime is running for this worktree\")\n122\t\tErrAlreadyServed = errors.New(\"a runtime is already serving this worktree\")\n123\t)\n124\t\n125\t// IncompatibleError is an attach refused at the handshake.\n126\ttype IncompatibleError struct{ Mismatch []string }\n127\t\n128\tfunc (e *IncompatibleError) Error() string {\n129\t\treturn \"the running runtime is not compatible: \" + strings.Join(e.Mismatch, \"; \")\n130\t}\n131\t\n132\t// UnsafeError is an endpoint or directory that fails the ownership, mode or type checks.\n133\ttype UnsafeError struct{ Path, Reason string }\n134\t\n135\tfunc (e *UnsafeError) Error() string { return \"unsafe runtime endpoint \" + e.Path + \": \" + e.Reason }\n136\t\n137\t// EnsureDir creates dir (one level, mode 0700) when it is absent and checks it is a real\n138\t// directory, owned by the user and closed to group and others.\n139\tfunc EnsureDir(dir string) error {\n140\t\tif !Supported() {\n141\t\t\treturn ErrUnsupported\n142\t\t}\n143\t\tinfo, err := os.Lstat(dir)\n144\t\tif errors.Is(err, os.ErrNotExist) {\n145\t\t\tif err := os.Mkdir(dir, 0o700); err != nil && !errors.Is(err, os.ErrExist) {\n146\t\t\t\treturn err\n147\t\t\t}\n148\t\t\tinfo, err = os.Lstat(dir)\n149\t\t}\n150\t\tif err != nil {\n151\t\t\treturn err\n152\t\t}\n153\t\treturn checkDir(dir, info)\n154\t}\n155\t\n156\tfunc checkDir(dir string, info os.FileInfo) error {\n157\t\tswitch {\n158\t\tcase info.Mode()&os.ModeSymlink != 0:\n159\t\t\treturn &UnsafeError{dir, \"it is a symbolic link\"}\n160\t\tcase !info.IsDir():\n161\t\t\treturn &UnsafeError{dir, \"it is not a directory\"}\n162\t\tcase info.Mode().Perm()&0o077 != 0:\n163\t\t\treturn &UnsafeError{dir, fmt.Sprintf(\"its mode %o lets group or others in\", info.Mode().Perm())}\n164\t\t}\n165\t\tif uid, ok := fileOwnerUID(info); ok && int(uid) != os.Getuid() {\n166\t\t\treturn &UnsafeError{dir, fmt.Sprintf(\"it is owned by uid %d, not %d\", uid, os.Getuid())}\n167\t\t}\n168\t\treturn nil\n169\t}\n170\t\n171\t// checkSocket is the check of an endpoint before it is dialled or replaced: a socket owned\n172\t// by the user, not a link or a file someone put there.\n173\tfunc checkSocket(path string) (os.FileInfo, error) {\n174\t\tinfo, err := os.Lstat(path)\n175\t\tif err != nil {\n176\t\t\treturn nil, err\n177\t\t}\n178\t\tif info.Mode()&os.ModeSocket == 0 {\n179\t\t\treturn nil, &UnsafeError{path, \"it is not a socket\"}\n180\t\t}\n181\t\tif uid, ok := fileOwnerUID(info); ok && int(uid) != os.Getuid() {\n182\t\t\treturn nil, &UnsafeError{path, fmt.Sprintf(\"it is owned by uid %d, not %d\", uid, os.Getuid())}\n183\t\t}\n184\t\treturn info, nil\n185\t}\n186\t\n187\ttype request struct {\n188\t\tOp       string    `json:\"op\"`\n189\t\tIdentity *Identity `json:\"identity,omitempty\"`\n190\t\tDrainMS  int       `json:\"drain_ms,omitempty\"`\n191\t}\n192\t\n193\t// Reply is the answer of a runtime.\n194\ttype Reply struct {\n195\t\tOK        bool      `json:\"ok\"`\n196\t\tMismatch  []string  `json:\"mismatch,omitempty\"`\n197\t\tError     string    `json:\"error,omitempty\"`\n198\t\tIdentity  *Identity `json:\"identity,omitempty\"`\n199\t\tEpoch     string    `json:\"epoch,omitempty\"`\n200\t\tPID       int       `json:\"pid,omitempty\"`\n201\t\tStartedAt string    `json:\"started_at,omitempty\"`\n202\t\tUptimeMS  int64     `json:\"uptime_ms,omitempty\"`\n203\t\tIdleMS    int64     `json:\"idle_timeout_ms,omitempty\"`\n204\t\tInFlight  int64     `json:\"in_flight\"`\n205\t\tServed    int64     `json:\"served\"`\n206\t\t// Drained and Abandoned answer a stop: the requests in flight that finished within the\n207\t\t// drain deadline and the ones that did not.\n208\t\tDrained   int64 `json:\"drained,omitempty\"`\n209\t\tAbandoned int64 `json:\"abandoned,omitempty\"`\n210\t}\n211\t\n212\t// Options start a runtime.\n213\ttype Options struct {\n214\t\tIdentity Identity\n215\t\tDir      string\n216\t\t// Idle stops the runtime after this long without a request; zero never does.\n217\t\tIdle time.Duration\n218\t\t// Handler, when set, is called for each admitted request before the reply of an unknown\n219\t\t// op; slice 1 hosts none, and the field exists so the in-flight count is the one a later\n220\t\t// slice's operations will be counted by.\n221\t\tHandler func(ctx context.Context, op string) (Reply, bool)\n222\t}\n223\t\n224\t// Serve runs the runtime until ctx ends, a client stops it or it idles out. The epoch of\n225\t// each run is new: nothing a previous process knew is inherited.\n226\tfunc Serve(ctx context.Context, opts Options) error {\n227\t\tif !Supported() {\n228\t\t\treturn ErrUnsupported\n229\t\t}\n230\t\tif err := EnsureDir(opts.Dir); err != nil {\n231\t\t\treturn err\n232\t\t}\n233\t\tpath := SocketPath(opts.Dir, opts.Identity)\n234\t\t// One lock per endpoint, held for the life of the runtime: of two concurrent starts only\n235\t\t// one holds it, so only the holder checks for, replaces or removes the socket.\n236\t\tunlock, err := lockEndpoint(path + \".lock\")\n237\t\tif err != nil {\n238\t\t\treturn err\n239\t\t}\n240\t\tdefer unlock()\n241\t\tif err := clearStale(path); err != nil {\n242\t\t\treturn err\n243\t\t}\n244\t\tlistener, err := net.Listen(\"unix\", path)\n245\t\tif err != nil {\n246\t\t\treturn err\n247\t\t}\n248\t\t// The listener would unlink the path on close whatever is there by then; the guard below\n249\t\t// removes it only if it is still ours.\n250\t\tif ul, ok := listener.(*net.UnixListener); ok {\n251\t\t\tul.SetUnlinkOnClose(false)\n252\t\t}\n253\t\tif err := os.Chmod(path, 0o600); err != nil {\n254\t\t\tlistener.Close()\n255\t\t\treturn err\n256\t\t}\n257\t\tours, _ := os.Lstat(path)\n258\t\t// The endpoint is removed only if it is still the one this process created.\n259\t\tdefer func() {\n260\t\t\tif now, err := os.Lstat(path); err == nil && ours != nil && os.SameFile(ours, now) {\n261\t\t\t\tos.Remove(path)\n262\t\t\t}\n263\t\t}()\n264\t\tvar token [8]byte\n265\t\t_, _ = rand.Read(token[:])\n266\t\ts := &server{opts: opts, listener: listener, epoch: hex.EncodeToString(token[:]), started: time.Now(), last: time.Now().UnixNano(), done: make(chan struct{})}\n267\t\treturn s.run(ctx)\n268\t}\n269\t\n270\t// clearStale removes an endpoint nobody answers on, and refuses one somebody does or one\n271\t// that is not a socket of the user.\n272\tfunc clearStale(path string) error {\n273\t\tif _, err := checkSocket(path); err != nil {\n274\t\t\tif errors.Is(err, os.ErrNotExist) {\n275\t\t\t\treturn nil\n276\t\t\t}\n277\t\t\treturn err\n278\t\t}\n279\t\tconn, err := net.DialTimeout(\"unix\", path, time.Second)\n280\t\tif err == nil {\n281\t\t\tconn.Close()\n282\t\t\treturn ErrAlreadyServed\n283\t\t}\n284\t\treturn os.Remove(path)\n285\t}\n286\t\n287\ttype server struct {\n288\t\topts     Options\n289\t\tlistener net.Listener\n290\t\tepoch    string\n291\t\tstarted  time.Time\n292\t\tlast     int64 // unix nanos of the last request, atomic\n293\t\tinflight atomic.Int64\n294\t\tserved   atomic.Int64\n295\t\twg       sync.WaitGroup\n296\t\tdone     chan struct{}\n297\t\tonce     sync.Once\n298\t}\n299\t\n300\tfunc (s *server) run(ctx context.Context) error {\n301\t\tgo func() {\n302\t\t\tselect {\n303\t\t\tcase <-ctx.Done():\n304\t\t\t\ts.shutdown()\n305\t\t\tcase <-s.done:\n306\t\t\t}\n307\t\t}()\n308\t\tif s.opts.Idle > 0 {\n309\t\t\tgo s.watchIdle()\n310\t\t}\n311\t\tfor {\n312\t\t\tconn, err := s.listener.Accept()\n313\t\t\tif err != nil {\n314\t\t\t\tselect {\n315\t\t\t\tcase <-s.done:\n316\t\t\t\t\ts.wg.Wait()\n317\t\t\t\t\treturn nil\n318\t\t\t\tdefault:\n319\t\t\t\t\treturn err\n320\t\t\t\t}\n321\t\t\t}\n322\t\t\ts.inflight.Add(1)\n323\t\t\ts.wg.Add(1)\n324\t\t\tgo func() {\n325\t\t\t\tdefer s.wg.Done()\n326\t\t\t\tdefer s.inflight.Add(-1)\n327\t\t\t\ts.handle(ctx, conn)\n328\t\t\t}()\n329\t\t}\n330\t}\n331\t\n332\tfunc (s *server) shutdown() { s.once.Do(func() { close(s.done); s.listener.Close() }) }\n333\t\n334\tfunc (s *server) watchIdle() {\n335\t\ttick := time.NewTicker(minDuration(s.opts.Idle/4, time.Second))\n336\t\tdefer tick.Stop()\n337\t\tfor {\n338\t\t\tselect {\n339\t\t\tcase <-s.done:\n340\t\t\t\treturn\n341\t\t\tcase <-tick.C:\n342\t\t\t\tif s.inflight.Load() == 0 && time.Since(time.Unix(0, atomic.LoadInt64(&s.last))) >= s.opts.Idle {\n343\t\t\t\t\ts.shutdown()\n344\t\t\t\t\treturn\n345\t\t\t\t}\n346\t\t\t}\n347\t\t}\n348\t}\n349\t\n350\tfunc minDuration(a, b time.Duration) time.Duration {\n351\t\tif a < b && a > 0 {\n352\t\t\treturn a\n353\t\t}\n354\t\treturn b\n355\t}\n356\t\n357\tfunc (s *server) handle(ctx context.Context, conn net.Conn) {\n358\t\tdefer conn.Close()\n359\t\tatomic.StoreInt64(&s.last, time.Now().UnixNano())\n360\t\t// The operating system says who is on the other end before a byte of it is read.\n361\t\tif uc, ok := conn.(*net.UnixConn); !ok {\n362\t\t\treturn\n363\t\t} else if uid, err := peerUID(uc); err != nil || int(uid) != os.Getuid() {\n364\t\t\treturn\n365\t\t}\n366\t\t_ = conn.SetDeadline(time.Now().Add(requestDeadline))\n367\t\tline, err := bufio.NewReaderSize(io.LimitReader(conn, maxRequest), 4096).ReadBytes('\\n')\n368\t\tif err != nil && len(line) == 0 {\n369\t\t\treturn\n370\t\t}\n371\t\tvar req request\n372\t\tif err := json.Unmarshal(line, &req); err != nil {\n373\t\t\twriteReply(conn, Reply{Error: \"the request is not valid JSON\"})\n374\t\t\treturn\n375\t\t}\n376\t\ts.served.Add(1)\n377\t\tswitch req.Op {\n378\t\tcase \"handshake\":\n379\t\t\tif req.Identity == nil {\n380\t\t\t\twriteReply(conn, Reply{Error: \"a handshake carries the client's identity\"})\n381\t\t\t\treturn\n382\t\t\t}\n383\t\t\tif mism := s.opts.Identity.Mismatches(*req.Identity); len(mism) > 0 {\n384\t\t\t\twriteReply(conn, Reply{Mismatch: mism, Error: \"incompatible\", PID: os.Getpid()})\n385\t\t\t\treturn\n386\t\t\t}\n387\t\t\twriteReply(conn, s.state(true))\n388\t\tcase \"status\":\n389\t\t\twriteReply(conn, s.state(true))\n390\t\tcase \"stop\":\n391\t\t\tdrain := defaultDrain\n392\t\t\tif req.DrainMS > 0 {\n393\t\t\t\tdrain = time.Duration(req.DrainMS) * time.Millisecond\n394\t\t\t}\n395\t\t\t// No new connection is accepted while the requests in flight drain.\n396\t\t\ts.shutdown()\n397\t\t\t// The reply of a long drain must still be writable.\n398\t\t\t_ = conn.SetDeadline(time.Now().Add(drain + requestDeadline))\n399\t\t\treply := s.drain(drain)\n400\t\t\twriteReply(conn, reply)\n401\t\tdefault:\n402\t\t\tif s.opts.Handler != nil {\n403\t\t\t\tif reply, ok := s.opts.Handler(ctx, req.Op); ok {\n404\t\t\t\t\twriteReply(conn, reply)\n405\t\t\t\t\treturn\n406\t\t\t\t}\n407\t\t\t}\n408\t\t\twriteReply(conn, Reply{Error: fmt.Sprintf(\"the runtime does not host the operation %q\", req.Op)})\n409\t\t}\n410\t}\n411\t\n412\t// drain waits, up to the deadline, for the requests in flight besides this one.\n413\tfunc (s *server) drain(deadline time.Duration) Reply {\n414\t\tbefore := s.inflight.Load() - 1\n415\t\tend := time.Now().Add(deadline)\n416\t\tfor s.inflight.Load() > 1 && time.Now().Before(end) {\n417\t\t\ttime.Sleep(5 * time.Millisecond)\n418\t\t}\n419\t\tleft := s.inflight.Load() - 1\n420\t\tif left < 0 {\n421\t\t\tleft = 0\n422\t\t}\n423\t\tif before < 0 {\n424\t\t\tbefore = 0\n425\t\t}\n426\t\tr := s.state(true)\n427\t\tr.Drained, r.Abandoned = before-left, left\n428\t\treturn r\n429\t}\n430\t\n431\tfunc (s *server) state(ok bool) Reply {\n432\t\tid := s.opts.Identity\n433\t\treturn Reply{OK: ok, Identity: &id, Epoch: s.epoch, PID: os.Getpid(), StartedAt: s.started.UTC().Format(time.RFC3339),\n434\t\t\tUptimeMS: time.Since(s.started).Milliseconds(), IdleMS: s.opts.Idle.Milliseconds(), InFlight: s.inflight.Load() - 1, Served: s.served.Load()}\n435\t}\n436\t\n437\tfunc writeReply(conn net.Conn, r Reply) {\n438\t\traw, _ := json.Marshal(r)\n439\t\t_, _ = conn.Write(append(raw, '\\n'))\n440\t}\n441\t\n442\t// Client talks to the runtime of one identity.\n443\ttype Client struct {\n444\t\tIdentity Identity\n445\t\tDir      string\n446\t}\n447\t\n448\tfunc (c Client) roundTrip(ctx context.Context, req request) (Reply, error) {\n449\t\tif !Supported() {\n450\t\t\treturn Reply{}, ErrUnsupported\n451\t\t}\n452\t\tif info, err := os.Lstat(c.Dir); err == nil {\n453\t\t\tif err := checkDir(c.Dir, info); err != nil {\n454\t\t\t\treturn Reply{}, err\n455\t\t\t}\n456\t\t} else if errors.Is(err, os.ErrNotExist) {\n457\t\t\treturn Reply{}, ErrNoRuntime\n458\t\t} else {\n459\t\t\treturn Reply{}, err\n460\t\t}\n461\t\tpath := SocketPath(c.Dir, c.Identity)\n462\t\tif _, err := checkSocket(path); err != nil {\n463\t\t\tif errors.Is(err, os.ErrNotExist) {\n464\t\t\t\treturn Reply{}, ErrNoRuntime\n465\t\t\t}\n466\t\t\treturn Reply{}, err\n467\t\t}\n468\t\tdialer := net.Dialer{Timeout: 2 * time.Second}\n469\t\tconn, err := dialer.DialContext(ctx, \"unix\", path)\n470\t\tif err != nil {\n471\t\t\t// Nobody answers: a stale endpoint is no runtime.\n472\t\t\treturn Reply{}, ErrNoRuntime\n473\t\t}\n474\t\tdefer conn.Close()\n475\t\tif uc, ok := conn.(*net.UnixConn); ok {\n476\t\t\tif uid, err := peerUID(uc); err != nil || int(uid) != os.Getuid() {\n477\t\t\t\treturn Reply{}, &UnsafeError{path, \"the process that answers is not the user's\"}\n478\t\t\t}\n479\t\t}\n480\t\t_ = conn.SetDeadline(time.Now().Add(requestDeadline + time.Duration(req.DrainMS)*time.Millisecond))\n481\t\traw, _ := json.Marshal(req)\n482\t\tif _, err := conn.Write(append(raw, '\\n')); err != nil {\n483\t\t\treturn Reply{}, err\n484\t\t}\n485\t\tline, err := bufio.NewReader(io.LimitReader(conn, maxRequest)).ReadBytes('\\n')\n486\t\tif err != nil && len(line) == 0 {\n487\t\t\treturn Reply{}, err\n488\t\t}\n489\t\tvar reply Reply\n490\t\tif err := json.Unmarshal(line, &reply); err != nil {\n491\t\t\treturn Reply{}, fmt.Errorf(\"the runtime answered something that is not a reply: %w\", err)\n492\t\t}\n493\t\treturn reply, nil\n494\t}\n495\t\n496\t// Handshake attaches: it sends the identity and gets the state of the runtime back, or an\n497\t// IncompatibleError naming each field that differs.\n498\tfunc (c Client) Handshake(ctx context.Context) (Reply, error) {\n499\t\tid := c.Identity\n500\t\treply, err := c.roundTrip(ctx, request{Op: \"handshake\", Identity: &id})\n501\t\tif err != nil {\n502\t\t\treturn Reply{}, err\n503\t\t}\n504\t\tif len(reply.Mismatch) > 0 {\n505\t\t\tsort.Strings(reply.Mismatch)\n506\t\t\treturn reply, &IncompatibleError{Mismatch: reply.Mismatch}\n507\t\t}\n508\t\tif !reply.OK {\n509\t\t\treturn reply, errors.New(reply.Error)\n510\t\t}\n511\t\treturn reply, nil\n512\t}\n513\t\n514\t// Status is the state of the runtime without comparing identities; the caller reads the\n515\t// identity it carries.\n516\tfunc (c Client) Status(ctx context.Context) (Reply, error) {\n517\t\treturn c.roundTrip(ctx, request{Op: \"status\"})\n518\t}\n519\t\n520\t// Do sends an operation the runtime hosts and returns its reply.\n521\tfunc (c Client) Do(ctx context.Context, op string) (Reply, error) {\n522\t\treturn c.roundTrip(ctx, request{Op: op})\n523\t}\n524\t\n525\t// WaitReleased returns when the endpoint of the identity can be taken: nothing answers and the\n526\t// previous holder has released its lock, or the timeout passed.\n527\tfunc (c Client) WaitReleased(ctx context.Context, timeout time.Duration) bool {\n528\t\tif !Supported() {\n529\t\t\treturn true\n530\t\t}\n531\t\tend := time.Now().Add(timeout)\n532\t\tfor time.Now().Before(end) && ctx.Err() == nil {\n533\t\t\tif _, err := c.Status(ctx); errors.Is(err, ErrNoRuntime) {\n534\t\t\t\tif unlock, err := lockEndpoint(SocketPath(c.Dir, c.Identity) + \".lock\"); err == nil {\n535\t\t\t\t\tunlock()\n536\t\t\t\t\treturn true\n537\t\t\t\t}\n538\t\t\t}\n539\t\t\ttime.Sleep(20 * time.Millisecond)\n540\t\t}\n541\t\treturn false\n542\t}\n543\t\n544\t// Stop asks the runtime to drain within the deadline and exit.\n545\tfunc (c Client) Stop(ctx context.Context, drain time.Duration) (Reply, error) {\n546\t\treturn c.roundTrip(ctx, request{Op: \"stop\", DrainMS: int(drain.Milliseconds())})\n547\t}\n548\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"dba0179e-3cc2-47a1-864d-c231a28b9ece","timestamp":"2026-11-09T23:37:07.863Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-1986613151/worktree/pose-mcp/internal/worktreeruntime/runtime.go","content":"// Package worktreeruntime is the optional runtime of one worktree: a process that\n// answers handshake, status and stop on a protected local socket (spec\n// pose-optional-worktree-runtime). It hosts no domain operation and confers no\n// authority: a client that attaches gains nothing it did not have standalone.\npackage worktreeruntime\n\nimport (\n\t\"bufio\"\n\t\"context\"\n\t\"crypto/rand\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"net\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"time\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nconst (\n\t// Protocol is the wire protocol; Schema names the message shapes.\n\tProtocol = 1\n\tSchema   = \"pose.runtime.v1\"\n\t// EnvDir overrides the directory of the endpoints (tests, unusual layouts).\n\tEnvDir = \"POSE_RUNTIME_DIR\"\n\n\tmaxRequest       = 64 << 10\n\trequestDeadline  = 5 * time.Second\n\tdefaultDrain     = 5 * time.Second\n\tsocketNameDigits = 12\n)\n\n// Identity is what must be the same on both ends of an attach. The location part (user,\n// worktree, Git common directory) names the endpoint; the engine part (engine, build,\n// protocol, schema) is compared at the handshake, so a new CLI that finds an old\n// process after an update is refused by name instead of being given a different endpoint.\ntype Identity struct {\n\tUID          int    `json:\"uid\"`\n\tWorktree     string `json:\"worktree\"`\n\tGitCommonDir string `json:\"git_common_dir\"`\n\tEngine       string `json:\"engine\"`\n\tBuild        string `json:\"build\"`\n\tProtocol     int    `json:\"protocol\"`\n\tSchema       string `json:\"schema\"`\n}\n\n// ResolveIdentity reads the identity of the worktree at root for this engine. The root's\n// symlinks are resolved and the Git common directory is read, so neither project_id nor\n// the common directory alone names a mutable tree.\nfunc ResolveIdentity(root, engine, build string) (Identity, error) {\n\tworktree, err := filepath.EvalSymlinks(root)\n\tif err == nil {\n\t\tworktree, err = filepath.Abs(worktree)\n\t}\n\tif err != nil {\n\t\treturn Identity{}, fmt.Errorf(\"the worktree %s cannot be resolved: %w\", root, err)\n\t}\n\tout, err := posemodel.RawHistoryGit(worktree, \"rev-parse\", \"--path-format=absolute\", \"--git-common-dir\").Output()\n\tif err != nil {\n\t\treturn Identity{}, fmt.Errorf(\"%s is not a Git worktree, or git failed (%v): the runtime is identified by it\", worktree, err)\n\t}\n\tcommon := strings.TrimSpace(string(out))\n\tif resolved, err := filepath.EvalSymlinks(common); err == nil {\n\t\tcommon = resolved\n\t}\n\treturn Identity{UID: os.Getuid(), Worktree: worktree, GitCommonDir: common, Engine: engine, Build: build, Protocol: Protocol, Schema: Schema}, nil\n}\n\n// location is the digest of the part that names the endpoint.\nfunc (i Identity) location() string {\n\tsum := sha256.Sum256([]byte(fmt.Sprintf(\"%d\\x00%s\\x00%s\", i.UID, i.Worktree, i.GitCommonDir)))\n\treturn hex.EncodeToString(sum[:])[:socketNameDigits]\n}\n\n// Mismatches names each field of the engine part where other differs from i.\nfunc (i Identity) Mismatches(other Identity) []string {\n\tvar out []string\n\tadd := func(name string, mine, theirs any) {\n\t\tif fmt.Sprint(mine) != fmt.Sprint(theirs) {\n\t\t\tout = append(out, fmt.Sprintf(\"%s: this side %v, the other %v\", name, mine, theirs))\n\t\t}\n\t}\n\tadd(\"uid\", i.UID, other.UID)\n\tadd(\"worktree\", i.Worktree, other.Worktree)\n\tadd(\"git_common_dir\", i.GitCommonDir, other.GitCommonDir)\n\tadd(\"engine\", i.Engine, other.Engine)\n\tadd(\"build\", i.Build, other.Build)\n\tadd(\"protocol\", i.Protocol, other.Protocol)\n\tadd(\"schema\", i.Schema, other.Schema)\n\treturn out\n}\n\n// DefaultDir is the directory of the endpoints of the current user.\nfunc DefaultDir() string {\n\tif dir := os.Getenv(EnvDir); dir != \"\" {\n\t\treturn dir\n\t}\n\tif run := os.Getenv(\"XDG_RUNTIME_DIR\"); filepath.IsAbs(run) {\n\t\treturn filepath.Join(run, \"pose\")\n\t}\n\treturn filepath.Join(os.TempDir(), fmt.Sprintf(\"pose-runtime-%d\", os.Getuid()))\n}\n\n// SocketPath is where the endpoint of the identity lives in dir.\nfunc SocketPath(dir string, id Identity) string {\n\treturn filepath.Join(dir, id.location()+\".sock\")\n}\n\n// Errors a client can tell apart.\nvar (\n\tErrUnsupported   = errors.New(\"the worktree runtime is not supported on this platform: every command runs standalone\")\n\tErrNoRuntime     = errors.New(\"no runtime is running for this worktree\")\n\tErrAlreadyServed = errors.New(\"a runtime is already serving this worktree\")\n)\n\n// IncompatibleError is an attach refused at the handshake.\ntype IncompatibleError struct{ Mismatch []string }\n\nfunc (e *IncompatibleError) Error() string {\n\treturn \"the running runtime is not compatible: \" + strings.Join(e.Mismatch, \"; \")\n}\n\n// UnsafeError is an endpoint or directory that fails the ownership, mode or type checks.\ntype UnsafeError struct{ Path, Reason string }\n\nfunc (e *UnsafeError) Error() string { return \"unsafe runtime endpoint \" + e.Path + \": \" + e.Reason }\n\n// EnsureDir creates dir (one level, mode 0700) when it is absent and checks it is a real\n// directory, owned by the user and closed to group and others.\nfunc EnsureDir(dir string) error {\n\tif !Supported() {\n\t\treturn ErrUnsupported\n\t}\n\tinfo, err := os.Lstat(dir)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\tif err := os.Mkdir(dir, 0o700); err != nil && !errors.Is(err, os.ErrExist) {\n\t\t\treturn err\n\t\t}\n\t\tinfo, err = os.Lstat(dir)\n\t}\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn checkDir(dir, info)\n}\n\nfunc checkDir(dir string, info os.FileInfo) error {\n\tswitch {\n\tcase info.Mode()&os.ModeSymlink != 0:\n\t\treturn &UnsafeError{dir, \"it is a symbolic link\"}\n\tcase !info.IsDir():\n\t\treturn &UnsafeError{dir, \"it is not a directory\"}\n\tcase info.Mode().Perm()&0o077 != 0:\n\t\treturn &UnsafeError{dir, fmt.Sprintf(\"its mode %o lets group or others in\", info.Mode().Perm())}\n\t}\n\tif uid, ok := fileOwnerUID(info); ok && int(uid) != os.Getuid() {\n\t\treturn &UnsafeError{dir, fmt.Sprintf(\"it is owned by uid %d, not %d\", uid, os.Getuid())}\n\t}\n\treturn nil\n}\n\n// checkSocket is the check of an endpoint before it is dialled or replaced: a socket owned\n// by the user, not a link or a file someone put there.\nfunc checkSocket(path string) (os.FileInfo, error) {\n\tinfo, err := os.Lstat(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif info.Mode()&os.ModeSocket == 0 {\n\t\treturn nil, &UnsafeError{path, \"it is not a socket\"}\n\t}\n\tif uid, ok := fileOwnerUID(info); ok && int(uid) != os.Getuid() {\n\t\treturn nil, &UnsafeError{path, fmt.Sprintf(\"it is owned by uid %d, not %d\", uid, os.Getuid())}\n\t}\n\treturn info, nil\n}\n\ntype request struct {\n\tOp       string    `json:\"op\"`\n\tIdentity *Identity `json:\"identity,omitempty\"`\n\tDrainMS  int       `json:\"drain_ms,omitempty\"`\n}\n\n// Reply is the answer of a runtime.\ntype Reply struct {\n\tOK        bool      `json:\"ok\"`\n\tMismatch  []string  `json:\"mismatch,omitempty\"`\n\tError     string    `json:\"error,omitempty\"`\n\tIdentity  *Identity `json:\"identity,omitempty\"`\n\tEpoch     string    `json:\"epoch,omitempty\"`\n\tPID       int       `json:\"pid,omitempty\"`\n\tStartedAt string    `json:\"started_at,omitempty\"`\n\tUptimeMS  int64     `json:\"uptime_ms,omitempty\"`\n\tIdleMS    int64     `json:\"idle_timeout_ms,omitempty\"`\n\tInFlight  int64     `json:\"in_flight\"`\n\tServed    int64     `json:\"served\"`\n\t// Drained and Abandoned answer a stop: the requests in flight that finished within the\n\t// drain deadline and the ones that did not.\n\tDrained   int64 `json:\"drained,omitempty\"`\n\tAbandoned int64 `json:\"abandoned,omitempty\"`\n}\n\n// Options start a runtime.\ntype Options struct {\n\tIdentity Identity\n\tDir      string\n\t// Idle stops the runtime after this long without a request; zero never does.\n\tIdle time.Duration\n\t// Handler, when set, is called for each admitted request before the reply of an unknown\n\t// op; slice 1 hosts none, and the field exists so the in-flight count is the one a later\n\t// slice's operations will be counted by.\n\tHandler func(ctx context.Context, op string) (Reply, bool)\n}\n\n// Serve runs the runtime until ctx ends, a client stops it or it idles out. The epoch of\n// each run is new: nothing a previous process knew is inherited.\nfunc Serve(ctx context.Context, opts Options) error {\n\tif !Supported() {\n\t\treturn ErrUnsupported\n\t}\n\tif err := EnsureDir(opts.Dir); err != nil {\n\t\treturn err\n\t}\n\tpath := SocketPath(opts.Dir, opts.Identity)\n\t// One lock per endpoint, held for the life of the runtime: of two concurrent starts only\n\t// one holds it, so only the holder checks for, replaces or removes the socket.\n\tunlock, err := lockEndpoint(path + \".lock\")\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer unlock()\n\tif err := clearStale(path); err != nil {\n\t\treturn err\n\t}\n\tlistener, err := net.Listen(\"unix\", path)\n\tif err != nil {\n\t\treturn err\n\t}\n\t// The listener would unlink the path on close whatever is there by then; the guard below\n\t// removes it only if it is still ours.\n\tif ul, ok := listener.(*net.UnixListener); ok {\n\t\tul.SetUnlinkOnClose(false)\n\t}\n\tif err := os.Chmod(path, 0o600); err != nil {\n\t\tlistener.Close()\n\t\treturn err\n\t}\n\tours, _ := os.Lstat(path)\n\t// The endpoint is removed only if it is still the one this process created.\n\tdefer func() {\n\t\tif now, err := os.Lstat(path); err == nil && ours != nil && os.SameFile(ours, now) {\n\t\t\tos.Remove(path)\n\t\t}\n\t}()\n\tvar token [8]byte\n\t_, _ = rand.Read(token[:])\n\ts := &server{opts: opts, listener: listener, epoch: hex.EncodeToString(token[:]), started: time.Now(), last: time.Now().UnixNano(), done: make(chan struct{})}\n\treturn s.run(ctx)\n}\n\n// clearStale removes an endpoint nobody answers on, and refuses one somebody does or one\n// that is not a socket of the user.\nfunc clearStale(path string) error {\n\tif _, err := checkSocket(path); err != nil {\n\t\tif errors.Is(err, os.ErrNotExist) {\n\t\t\treturn nil\n\t\t}\n\t\treturn err\n\t}\n\tconn, err := net.DialTimeout(\"unix\", path, time.Second)\n\tif err == nil {\n\t\tconn.Close()\n\t\treturn ErrAlreadyServed\n\t}\n\treturn os.Remove(path)\n}\n\ntype server struct {\n\topts     Options\n\tlistener net.Listener\n\tepoch    string\n\tstarted  time.Time\n\tlast     int64 // unix nanos of the last request, atomic\n\tinflight atomic.Int64\n\tserved   atomic.Int64\n\twg       sync.WaitGroup\n\tdone     chan struct{}\n\tonce     sync.Once\n}\n\nfunc (s *server) run(ctx context.Context) error {\n\tgo func() {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\ts.shutdown()\n\t\tcase <-s.done:\n\t\t}\n\t}()\n\tif s.opts.Idle > 0 {\n\t\tgo s.watchIdle()\n\t}\n\tfor {\n\t\tconn, err := s.listener.Accept()\n\t\tif err != nil {\n\t\t\tselect {\n\t\t\tcase <-s.done:\n\t\t\t\ts.wg.Wait()\n\t\t\t\treturn nil\n\t\t\tdefault:\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\ts.inflight.Add(1)\n\t\ts.wg.Add(1)\n\t\tgo func() {\n\t\t\tdefer s.wg.Done()\n\t\t\tdefer s.inflight.Add(-1)\n\t\t\ts.handle(ctx, conn)\n\t\t}()\n\t}\n}\n\nfunc (s *server) shutdown() { s.once.Do(func() { close(s.done); s.listener.Close() }) }\n\nfunc (s *server) watchIdle() {\n\ttick := time.NewTicker(minDuration(s.opts.Idle/4, time.Second))\n\tdefer tick.Stop()\n\tfor {\n\t\tselect {\n\t\tcase <-s.done:\n\t\t\treturn\n\t\tcase <-tick.C:\n\t\t\tif s.inflight.Load() == 0 && time.Since(time.Unix(0, atomic.LoadInt64(&s.last))) >= s.opts.Idle {\n\t\t\t\ts.shutdown()\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunc minDuration(a, b time.Duration) time.Duration {\n\tif a < b && a > 0 {\n\t\treturn a\n\t}\n\treturn b\n}\n\nfunc (s *server) handle(ctx context.Context, conn net.Conn) {\n\tdefer conn.Close()\n\tatomic.StoreInt64(&s.last, time.Now().UnixNano())\n\t// The operating system says who is on the other end before a byte of it is read.\n\tif uc, ok := conn.(*net.UnixConn); !ok {\n\t\treturn\n\t} else if uid, err := peerUID(uc); err != nil || int(uid) != os.Getuid() {\n\t\treturn\n\t}\n\t_ = conn.SetDeadline(time.Now().Add(requestDeadline))\n\tline, err := bufio.NewReaderSize(io.LimitReader(conn, maxRequest), 4096).ReadBytes('\\n')\n\tif err != nil && len(line) == 0 {\n\t\treturn\n\t}\n\tvar req request\n\tif err := json.Unmarshal(line, &req); err != nil {\n\t\twriteReply(conn, Reply{Error: \"the request is not valid JSON\"})\n\t\treturn\n\t}\n\ts.served.Add(1)\n\tswitch req.Op {\n\tcase \"handshake\":\n\t\tif req.Identity == nil {\n\t\t\twriteReply(conn, Reply{Error: \"a handshake carries the client's identity\"})\n\t\t\treturn\n\t\t}\n\t\tif mism := s.opts.Identity.Mismatches(*req.Identity); len(mism) > 0 {\n\t\t\twriteReply(conn, Reply{Mismatch: mism, Error: \"incompatible\", PID: os.Getpid()})\n\t\t\treturn\n\t\t}\n\t\twriteReply(conn, s.state(true))\n\tcase \"status\":\n\t\twriteReply(conn, s.state(true))\n\tcase \"stop\":\n\t\tdrain := defaultDrain\n\t\tif req.DrainMS > 0 {\n\t\t\tdrain = time.Duration(req.DrainMS) * time.Millisecond\n\t\t}\n\t\t// No new connection is accepted while the requests in flight drain.\n\t\ts.shutdown()\n\t\t// The reply of a long drain must still be writable.\n\t\t_ = conn.SetDeadline(time.Now().Add(drain + requestDeadline))\n\t\treply := s.drain(drain)\n\t\twriteReply(conn, reply)\n\tdefault:\n\t\tif s.opts.Handler != nil {\n\t\t\tif reply, ok := s.opts.Handler(ctx, req.Op); ok {\n\t\t\t\twriteReply(conn, reply)\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t\twriteReply(conn, Reply{Error: fmt.Sprintf(\"the runtime does not host the operation %q\", req.Op)})\n\t}\n}\n\n// drain waits, up to the deadline, for the requests in flight besides this one.\nfunc (s *server) drain(deadline time.Duration) Reply {\n\tbefore := s.inflight.Load() - 1\n\tend := time.Now().Add(deadline)\n\tfor s.inflight.Load() > 1 && time.Now().Before(end) {\n\t\ttime.Sleep(5 * time.Millisecond)\n\t}\n\tleft := s.inflight.Load() - 1\n\tif left < 0 {\n\t\tleft = 0\n\t}\n\tif before < 0 {\n\t\tbefore = 0\n\t}\n\tr := s.state(true)\n\tr.Drained, r.Abandoned = before-left, left\n\treturn r\n}\n\nfunc (s *server) state(ok bool) Reply {\n\tid := s.opts.Identity\n\treturn Reply{OK: ok, Identity: &id, Epoch: s.epoch, PID: os.Getpid(), StartedAt: s.started.UTC().Format(time.RFC3339),\n\t\tUptimeMS: time.Since(s.started).Milliseconds(), IdleMS: s.opts.Idle.Milliseconds(), InFlight: s.inflight.Load() - 1, Served: s.served.Load()}\n}\n\nfunc writeReply(conn net.Conn, r Reply) {\n\traw, _ := json.Marshal(r)\n\t_, _ = conn.Write(append(raw, '\\n'))\n}\n\n// Client talks to the runtime of one identity.\ntype Client struct {\n\tIdentity Identity\n\tDir      string\n}\n\nfunc (c Client) roundTrip(ctx context.Context, req request) (Reply, error) {\n\tif !Supported() {\n\t\treturn Reply{}, ErrUnsupported\n\t}\n\tif info, err := os.Lstat(c.Dir); err == nil {\n\t\tif err := checkDir(c.Dir, info); err != nil {\n\t\t\treturn Reply{}, err\n\t\t}\n\t} else if errors.Is(err, os.ErrNotExist) {\n\t\treturn Reply{}, ErrNoRuntime\n\t} else {\n\t\treturn Reply{}, err\n\t}\n\tpath := SocketPath(c.Dir, c.Identity)\n\tif _, err := checkSocket(path); err != nil {\n\t\tif errors.Is(err, os.ErrNotExist) {\n\t\t\treturn Reply{}, ErrNoRuntime\n\t\t}\n\t\treturn Reply{}, err\n\t}\n\tdialer := net.Dialer{Timeout: 2 * time.Second}\n\tconn, err := dialer.DialContext(ctx, \"unix\", path)\n\tif err != nil {\n\t\t// Nobody answers: a stale endpoint is no runtime.\n\t\treturn Reply{}, ErrNoRuntime\n\t}\n\tdefer conn.Close()\n\tif uc, ok := conn.(*net.UnixConn); ok {\n\t\tif uid, err := peerUID(uc); err != nil || int(uid) != os.Getuid() {\n\t\t\treturn Reply{}, &UnsafeError{path, \"the process that answers is not the user's\"}\n\t\t}\n\t}\n\t_ = conn.SetDeadline(time.Now().Add(requestDeadline + time.Duration(req.DrainMS)*time.Millisecond))\n\traw, _ := json.Marshal(req)\n\tif _, err := conn.Write(append(raw, '\\n')); err != nil {\n\t\treturn Reply{}, err\n\t}\n\tline, err := bufio.NewReader(io.LimitReader(conn, maxRequest)).ReadBytes('\\n')\n\tif err != nil && len(line) == 0 {\n\t\treturn Reply{}, err\n\t}\n\tvar reply Reply\n\tif err := json.Unmarshal(line, &reply); err != nil {\n\t\treturn Reply{}, fmt.Errorf(\"the runtime answered something that is not a reply: %w\", err)\n\t}\n\treturn reply, nil\n}\n\n// Handshake attaches: it sends the identity and gets the state of the runtime back, or an\n// IncompatibleError naming each field that differs.\nfunc (c Client) Handshake(ctx context.Context) (Reply, error) {\n\tid := c.Identity\n\treply, err := c.roundTrip(ctx, request{Op: \"handshake\", Identity: &id})\n\tif err != nil {\n\t\treturn Reply{}, err\n\t}\n\tif len(reply.Mismatch) > 0 {\n\t\tsort.Strings(reply.Mismatch)\n\t\treturn reply, &IncompatibleError{Mismatch: reply.Mismatch}\n\t}\n\tif !reply.OK {\n\t\treturn reply, errors.New(reply.Error)\n\t}\n\treturn reply, nil\n}\n\n// Status is the state of the runtime without comparing identities; the caller reads the\n// identity it carries.\nfunc (c Client) Status(ctx context.Context) (Reply, error) {\n\treturn c.roundTrip(ctx, request{Op: \"status\"})\n}\n\n// Do sends an operation the runtime hosts and returns its reply.\nfunc (c Client) Do(ctx context.Context, op string) (Reply, error) {\n\treturn c.roundTrip(ctx, request{Op: op})\n}\n\n// WaitReleased returns when the endpoint of the identity can be taken: nothing answers and the\n// previous holder has released its lock, or the timeout passed.\nfunc (c Client) WaitReleased(ctx context.Context, timeout time.Duration) bool {\n\tif !Supported() {\n\t\treturn true\n\t}\n\tend := time.Now().Add(timeout)\n\tfor time.Now().Before(end) && ctx.Err() == nil {\n\t\tif _, err := c.Status(ctx); errors.Is(err, ErrNoRuntime) {\n\t\t\tif unlock, err := lockEndpoint(SocketPath(c.Dir, c.Identity) + \".lock\"); err == nil {\n\t\t\t\tunlock()\n\t\t\t\treturn true\n\t\t\t}\n\t\t}\n\t\ttime.Sleep(20 * time.Millisecond)\n\t}\n\treturn false\n}\n\n// Stop asks the runtime to drain within the deadline and exit.\nfunc (c Client) Stop(ctx context.Context, drain time.Duration) (Reply, error) {\n\treturn c.roundTrip(ctx, request{Op: \"stop\", DrainMS: int(drain.Milliseconds())})\n}\n","numLines":548,"startLine":1,"totalLines":548}},"tool_re