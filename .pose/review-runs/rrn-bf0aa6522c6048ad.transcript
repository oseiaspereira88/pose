range roots {\n\t\tzcmp(t, \"racy default\", r, \"diff\", \"--name-only\")\n\t}\n}\n\nfunc TestProbeNoIndex(t *testing.T) {\n\tr := zr(t)\n\tzw(t, r, \"a\", \"1\\n\")\n\tzc(t, r)\n\tos.Remove(filepath.Join(r, \".git\", \"index\"))\n\tzcmp(t, \"no index\", r, \"diff\", \"--name-status\", \"HEAD\")\n\t_, err := os.Lstat(filepath.Join(r, \".git\", \"index\"))\n\tt.Logf(\"index absent after: %v\", os.IsNotExist(err))\n}\n\nfunc TestProbeSymlinkIndex(t *testing.T) {\n\tr := zr(t)\n\tzw(t, r, \"a\", \"1\\n\")\n\tzc(t, r)\n\tzw(t, r, \"a\", \"2\\n\")\n\tzc(t, r)\n\tidx := filepath.Join(r, \".git\", \"index\")\n\tos.Rename(idx, idx+\".real\")\n\tos.Symlink(\"index.real\", idx)\n\tzcmp(t, \"symlinked index worktree\", r, \"diff\", \"--name-only\", \"HEAD~1\")\n\tzcmp(t, \"symlinked index commit range\", r, \"diff\", \"--name-only\", \"HEAD~1\", \"HEAD\")\n}\n\nfunc TestProbeConcurrentWriter(t *testing.T) {\n\tr := zr(t)\n\tfor _, f := range []string{\"a\", \"b\", \"c\"} {\n\t\tzw(t, r, f, \"1\\n\")\n\t}\n\tzc(t, r)\n\tstop := make(chan struct{})\n\tvar wg sync.WaitGroup\n\twg.Add(1)\n\tgo func() {\n\t\tdefer wg.Done()\n\t\tfor i := 0; ; i++ {\n\t\t\tselect {\n\t\t\tcase <-stop:\n\t\t\t\treturn\n\t\t\tdefault:\n\t\t\t}\n\t\t\tos.WriteFile(filepath.Join(r, \"b\"), []byte{byte('0' + i%10), '\\n'}, 0o644)\n\t\t\texec.Command(\"git\", \"-C\", r, \"add\", \"b\").Run()\n\t\t}\n\t}()\n\tos.WriteFile(filepath.Join(r, \"a\"), []byte(\"2\\n\"), 0o644)\n\tbad := 0\n\tfor i := 0; i < 200; i++ {\n\t\tgot, err := RawGitDiffReadOnly(r, \"-C\", r, \"diff\", \"--name-only\", \"HEAD\", \"--\", \"a\", \"c\")\n\t\tif err != nil || string(got) != \"a\\n\" {\n\t\t\tbad++\n\t\t}\n\t}\n\tclose(stop)\n\twg.Wait()\n\tt.Logf(\"concurrent writer: unexpected answers=%d of 200\", bad)\n}\n\nfunc TestProbeRound1(t *testing.T) {\n\ts := zr(t)\n\tzw(t, s, \"f\", \"1\\n\")\n\tzc(t, s)\n\tr := zr(t)\n\tzg(t, r, true, \"submodule\", \"add\", \"-q\", s, \"mod\")\n\tzw(t, r, \"proj/a\", \"1\\n\")\n\tzw(t, r, \"d/