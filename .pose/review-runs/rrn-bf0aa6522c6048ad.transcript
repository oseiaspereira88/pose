ult\", r, \"diff\", \"--name-only\")\n\t}\n}\n\nfunc TestProbeNoIndex(t *testing.T) {\n\tr := zr(t)\n\tzw(t, r, \"a\", \"1\\n\")\n\tzc(t, r)\n\tos.Remove(filepath.Join(r, \".git\", \"index\"))\n\tzcmp(t, \"no index\", r, \"diff\", \"--name-status\", \"HEAD\")\n\t_, err := os.Lstat(filepath.Join(r, \".git\", \"index\"))\n\tt.Logf(\"index absent after: %v\", os.IsNotExist(err))\n}\n\nfunc TestProbeSymlinkIndex(t *testing.T) {\n\tr := zr(t)\n\tzw(t, r, \"a\", \"1\\n\")\n\tzc(t, r)\n\tzw(t, r, \"a\", \"2\\n\")\n\tzc(t, r)\n\tidx := filepath.Join(r, \".git\", \"index\")\n\tos.Rename(idx, idx+\".real\")\n\tos.Symlink(\"index.real\", idx)\n\tzcmp(t, \"symlinked index worktree\", r, \"diff\", \"--name-only\", \"HEAD~1\")\n\tzcmp(t, \"symlinked index commit range\", r, \"diff\", \"--name-only\", \"HEAD~1\", \"HEAD\")\n}\n\nfunc TestProbeConcurrentWriter(t *testing.T) {\n\tr := zr(t)\n\tfor _, f := range []string{\"a\", \"b\", \"c\"} {\n\t\tzw(t, r, f, \"1\\n\")\n\t}\n\tzc(t, r)\n\tstop := make(chan struct{})\n\tvar wg sync.WaitGroup\n\twg.Add(1)\n\tgo func() {\n\t\tdefer wg.Done()\n\t\tfor i := 0; ; i++ {\n\t\t\tselect {\n\t\t\tcase <-stop:\n\t\t\t\treturn\n\t\t\tdefault:\n\t\t\t}\n\t\t\tos.WriteFile(filepath.Join(r, \"b\"), []byte{byte('0' + i%10), '\\n'}, 0o644)\n\t\t\texec.Command(\"git\", \"-C\", r, \"add\", \"b\").Run()\n\t\t}\n\t}()\n\tos.WriteFile(filepath.Join(r, \"a\"), []byte(\"2\\n\"), 0o644)\n\tbad := 0\n\tfor i := 0; i < 200; i++ {\n\t\tgot, err := RawGitDiffReadOnly(r, \"-C\", r, \"diff\", \"--name-only\", \"HEAD\", \"--\", \"a\", \"c\")\n\t\tif err != nil || string(got) != \"a\\n\" {\n\t\t\tbad++\n\t\t}\n\t}\n\tclose(stop)\n\twg.Wait()\n\tt.Logf(\"concurrent writer: unexpected answers=%d of 200\", bad)\n}\n\nfunc TestProbeRound1(t *testing.T) {\n\ts := zr(t)\n\tzw(t, s, \"f\", \"1\\n\")\n\tzc(t, s)\n\tr := zr(t)\n\tzg(t, r, true, \"submodule\", \"add\", \"-q\", s, \"mod\")\n\tzw(t, r, \"proj/a\", \"1\\n\")\n\tzw(t, r, \"d/x\", \"1\\n\")\n\tzw(t, r, \"gone\", \"1\\n\")\n\tos.Symlink(\"one\", filepath.Join(r, \"l\"))\n\tzc(t, r)\n\tm := filepath.Join(r, \"mod\")\n\tzw(t, m, \"f\", \"2\\n\")\n\tzc(t, m)\n\tzw(t, r, \"proj/new\", \"1\\n\")\n\tzw(t, r, \"d/x\", \"2\\n\")\n\tzw(t, r, \"gone\", \"2\\n\")\n\tos.Remove(filepath.Join(r, \"l\"))\n\tos.Symlink(\"two\", filepath.Join(r, \"l\"))\n\tzc(t, r)\n\tzg(t, m, true, \"checkout\", \"-q\", \"HEAD~1\")\n\tzw(t, m, \"f\", \"dirty\\n\")\n\tzw(t, r, \"proj/new\", \"2\\n\")\n\tos.RemoveAll(filepath.Join(r, \"d\"))\n\tzw(t, r, \"d\", \"file\\n\")\n\tzw(t, r, \"gone\", \"1\\n\")\n\tzg(t, r, true, \"rm\", \"-q\", \"--cached\", \"gone\")\n\tos.Remove(filepath.Join(r, \"l\"))\n\tos.Symlink(\"one\", filepath.Join(r, \"l\"))\n\tzcmp(t, \"since base\", r, \"-c\", \"diff.ignoreSubmodules=none\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"--no-renames\", \"HEAD~1\", \"--\")\n\tzcmp(t, \"range\", r, \"diff\", \"--name-only\", \"HEAD~1..HEAD\", \"--\")\n\tzcmp(t, \"subdir root\", filepath.Join(r, \"proj\"), \"diff\", \"--name-only\", \"HEAD~1\", \"--\")\n}\n\nfunc TestProbeConflict(t *testing.T) {\n\tr := zr(t)\n\tzw(t, r, \"a\", \"1\\n\")\n\tzc(t, r)\n\tzg(t, r, true, \"checkout\", \"-q\", \"-b\", \"o\")\n\trec := \".pose/review-attempts/k/000001.json\"\n\tzw(t, r, rec, \"theirs\\n\")\n\tzc(t, r)\n\tzg(t, r, true, \"checkout\", \"-q\", \"main\")\n\tzw(t, r, rec, \"ours\\n\")\n\tzc(t, r)\n\tzg(t, r, false, \"merge\", \"o\")\n\tf, err := (Store{Root: r}).ReviewRunHistoryFindings()\n\tt.Logf(\"ledger conflict: %v %v\", f, err)\n\tzcmp(t, \"conflict\", r, \"diff\", \"HEAD\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\")\n}\n\nfunc TestProbeSplit(t *testing.T) {\n\tr := zr(t)\n\tzg(t, r, true, \"config\", \"core.splitIndex\", \"true\")\n\tzw(t, r, \"f\", \"1\\n\")\n\tzc(t, r)\n\tzg(t, r, true, \"update-index\", \"--split-index\")\n\tm, _ := filepath.Glob(filepath.Join(r, \".git\", \"sharedindex.*\"))\n\ta, _ := os.Stat(m[0])\n\ttime.Sleep(1100 * time.Millisecond)\n\tzw(t, r, \"f\", \"2\\n\")\n\tgot, err := RawGitDiffReadOnly(r, \"-C\", r, \"diff\", \"--name-only\", \"HEAD\")\n\tb, _ := os.Stat(m[0])\n\tt.Logf(\"split: %q %v shared mtime moved=%v\", got, err, !a.ModTime().Equal(b.ModTime()))\n}\nEOF\nprintf '{\"Replace\":{\"%s/pose-mcp/internal/pose/zz_probe_test.go\":\"%s/zz_probe_test.go\"}}' \"$PWD\" \"$TMPDIR\" > \"$TMPDIR/overlay.json\"\ngo -C pose-mcp test -overlay \"$TMPDIR/overlay.json\" ./internal/pose -run '^TestProbe(RacyDefault|NoIndex|SymlinkIndex|ConcurrentWriter|Round1|Conflict|Split)$' -v -count=1; echo \"probe $?\"\ncat > \"$TMPDIR/mutant_linux.go\" <<'EOF'\n//go:build linux\n\npackage pose\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"time\"\n\n\t\"golang.org/x/sys/unix\"\n)\n\nfunc readOnlyIndexFor(cmd *exec.Cmd, raw []byte, modTime time.Time) (func(), error) {\n\tfd, err := unix.MemfdCreate(\"pose-index/none\", unix.MFD_CLOEXEC)\n\tif err != nil {\n\t\treturn func() {}, err\n\t}\n\tf := os.NewFile(uintptr(fd), \"pose-index\")\n\tif _, err := f.Write(raw); err != nil {\n\t\tf.Close()\n\t\treturn func() {}, err\n\t}\n\tcmd.ExtraFiles = append(cmd.ExtraFiles, f)\n\tcmd.Env = append(cmd.Env, fmt.Sprintf(\"GIT_INDEX_FILE=/proc/self/fd/%d\", 2+len(cmd.ExtraFiles)))\n\treturn func() { f.Close() }, nil\n}\nEOF\nprintf '{\"Replace\":{\"%s/pose-mcp/internal/pose/git_worktree_reads_linux.go\":\"%s/mutant_linux.go\"}}' \"$PWD\" \"$TMPDIR\" > \"$TMPDIR/overlay-mut.json\"\ngo -C pose-mcp test -overlay \"$TMPDIR/overlay-mut.json\" ./internal/pose -run 'RacilyCleanEntry' -count=1; echo \"mutant $? (non-zero expected)\"\ngo -C pose-mcp vet ./internal/cli ./internal/pose; echo \"vet $?\"\ngo -C pose-mcp test ./internal/cli ./internal/pose -run 'LeaveTheIndexAlone|NeverChangeTheIndex|AnswersAsThePlainDiff|RacilyClean|WithoutAnIndex|ReadyTransition|ChangedScope|ChangedFiles|ReviewRunHistory|HistoryFindings|MaterialWorktree|RawHistory|UpdatePreviewHasNoPhysicalMutation' -count=1 -v 2>&1 | git -C \"$TMPDIR\" stripspac