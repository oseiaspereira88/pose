{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M9zk45e4YoeoPG45ATXYhE","type":"tool_result","content":"170\t\t\treturn nil\n171\t\t})\n172\t\tif err != nil || count != 2 {\n173\t\t\tt.Fatalf(\"fitting scope reads inherited coordinator exhaustion: count=%d err=%v\", count, err)\n174\t\t}\n175\t}\n176\t\n177\tfunc TestGovernanceReadViewD7ProbeScopeLossDoesNotPoisonHealthySibling(t *testing.T) {\n178\t\troot, path := d7ProbeCoordinatorRoot(t)\n179\t\tvar scopeLoss error\n180\t\thealthy := false\n181\t\terr := (Store{Root: root}).WithReviewCoordinator(func(coordinator Store) error {\n182\t\t\tscopeLoss = coordinator.WithReviewScopeOperationView(func(scope Store) error {\n183\t\t\t\trv, _ := governanceReadViewFromFiles(scope.fsys())\n184\t\t\t\trv.operation.budgetMu.Lock()\n185\t\t\t\trv.operation.records = governanceReadViewMaxRecords\n186\t\t\t\trv.operation.budgetMu.Unlock()\n187\t\t\t\t_, err := scope.fsys().ReadFile(path)\n188\t\t\t\treturn err\n189\t\t\t})\n190\t\t\tsiblingErr := coordinator.WithReviewScopeOperationView(func(scope Store) error {\n191\t\t\t\t_, err := scope.fsys().ReadFile(path)\n192\t\t\t\thealthy = err == nil\n193\t\t\t\treturn err\n194\t\t\t})\n195\t\t\treturn errors.Join(scopeLoss, siblingErr)\n196\t\t})\n197\t\tif scopeLoss == nil || !healthy || !errors.Is(err, ErrGovernanceReadViewUnknown) {\n198\t\t\tt.Fatalf(\"loss was suppressed or poisoned sibling: scope=%v healthy=%t coordinator=%v\", scopeLoss, healthy, err)\n199\t\t}\n200\t}\n201\t\n202\t// The registry is an operation input, not a file in any one root. Inject its\n203\t// final observation at the same boundary used by the production wrappers.\n204\tfunc injectGovernanceRegistryAudit(store Store, mode string) {\n205\t\tview, _ := governanceReadViewFromFiles(store.fsys())\n206\t\top := view.operation\n207\t\top.mu.Lock()\n208\t\troots := map[string]string{}\n209\t\tfor project, root := range op.initialRoots {\n210\t\t\troots[project] = root\n211\t\t}\n212\t\tconflicts := cloneBoolMap(op.initialConflicts)\n213\t\top.currentRoots = func() (map[string]string, map[string]bool, bool) {\n214\t\t\tif mode == \"changed\" {\n215\t\t\t\troots[\"proj.added\"] = filepath.Join(store.Root, \"added-root\")\n216\t\t\t}\n217\t\t\tif mode == \"conflict\" {\n218\t\t\t\tconflicts[op.mainProject] = true\n219\t\t\t}\n220\t\t\treturn roots, conflicts, mode == \"budget\"\n221\t\t}\n222\t\top.mu.Unlock()\n223\t}\n224\t\n225\tfunc TestGovernanceReadViewRegistryFinalAuditReachesReviewAndCloseout(t *testing.T) {\n226\t\tfor _, gate := range []string{\"review\", \"closeout\"} {\n227\t\t\tfor _, mode := range []string{\"stable\", \"once\", \"changed\", \"conflict\", \"budget\"} {\n228\t\t\t\tt.Run(gate+\"/\"+mode, func(t *testing.T) {\n229\t\t\t\t\tstore, _, _ := retentionFixture(t)\n230\t\t\t\t\tcloseBackendSpec(t, store)\n231\t\t\t\t\tbindCurrentReviewFixture(t, store)\n232\t\t\t\t\tcalls := 0\n233\t\t\t\t\tinject := func(s Store) {\n234\t\t\t\t\t\tcalls++\n235\t\t\t\t\t\tif mode == \"stable\" || mode == \"once\" && calls > 1 {\n236\t\t\t\t\t\t\treturn\n237\t\t\t\t\t\t}\n238\t\t\t\t\t\tselected := mode\n239\t\t\t\t\t\tif selected == \"once\" {\n240\t\t\t\t\t\t\tselected = \"changed\"\n241\t\t\t\t\t\t}\n242\t\t\t\t\t\tinjectGovernanceRegistryAudit(s, selected)\n243\t\t\t\t\t}\n244\t\t\t\t\tvar metadata *ReadViewMetadata\n245\t\t\t\t\tvar approved, fresh, terminal bool\n246\t\t\t\t\tif gate == \"review\" {\n247\t\t\t\t\t\tvalue, err := withGovernanceReviewReadView(store, \"review\", func(s Store) (ReviewEvaluation, error) {\n248\t\t\t\t\t\t\tresult, err := s.ReviewCheck(\"spec:backend\")\n249\t\t\t\t\t\t\tinject(s)\n250\t\t\t\t\t\t\treturn result, err\n251\t\t\t\t\t\t}, applyReviewReadView)\n252\t\t\t\t\t\tif err != nil {\n253\t\t\t\t\t\t\tt.Fatal(err)\n254\t\t\t\t\t\t}\n255\t\t\t\t\t\tmetadata, approved, fresh = value.ReadView, value.Approved, value.Fresh\n256\t\t\t\t\t} else {\n257\t\t\t\t\t\tvalue, err := withGovernanceReviewReadView(store, \"closeout\", func(s Store) (CloseoutState, error) {\n258\t\t\t\t\t\t\tresult, err := s.getCloseoutState(\"spec:backend\", true)\n259\t\t\t\t\t\t\tinject(s)\n260\t\t\t\t\t\t\treturn result, err\n261\t\t\t\t\t\t}, func(v *CloseoutState, m *ReadViewMetadata, a governanceReadViewAudit) {\n262\t\t\t\t\t\t\tapplyCloseoutReadView(v, m, \"spec:backend\", a)\n263\t\t\t\t\t\t})\n264\t\t\t\t\t\tif err != nil {\n265\t\t\t\t\t\t\tt.Fatal(err)\n266\t\t\t\t\t\t}\n267\t\t\t\t\t\tmetadata, approved, fresh, terminal = value.ReadView, value.Review.Approved, value.Review.Fresh, value.Terminal\n268\t\t\t\t\t}\n269\t\t\t\t\texpectedCalls := 1\n270\t\t\t\t\tif mode == \"once\" || mode == \"changed\" || mode == \"conflict\" {\n271\t\t\t\t\t\texpectedCalls = 2\n272\t\t\t\t\t}\n273\t\t\t\t\tif calls != expectedCalls {\n274\t\t\t\t\t\tt.Fatalf(\"attempts=%d want=%d\", calls, expectedCalls)\n275\t\t\t\t\t}\n276\t\t\t\t\tif metadata == nil {\n277\t\t\t\t\t\tt.Fatal(\"missing read-view metadata\")\n278\t\t\t\t\t}\n279\t\t\t\t\tstable := mode == \"stable\" || mode == \"once\"\n280\t\t\t\t\tif stable {\n281\t\t\t\t\t\tif !approved || !fresh || gate == \"closeout\" && !terminal || metadata.Freshness != ReadViewFreshnessCurrent {\n282\t\t\t\t\t\t\tt.Fatalf(\"stable result lost: approved=%t fresh=%t terminal=%t metadata=%+v\", approved, fresh, terminal, metadata)\n283\t\t\t\t\t\t}\n284\t\t\t\t\t} else {\n285\t\t\t\t\t\tif metadata.Freshness != ReadViewFreshnessUnknown {\n286\t\t\t\t\t\t\tt.Fatalf(\"registry audit was lost: %+v\", metadata)\n287\t\t\t\t\t\t}\n288\t\t\t\t\t\tif mode != \"budget\" && (approved || fresh || gate == \"closeout\" && terminal) {\n289\t\t\t\t\t\t\tt.Fatalf(\"changed registry retained approval: approved=%t fresh=%t terminal=%t\", approved, fresh, terminal)\n290\t\t\t\t\t\t}\n291\t\t\t\t\t\tif !strings.Contains(strings.Join(metadata.Limitations, \" \"), \"authorized root registry\") {\n292\t\t\t\t\t\t\tt.Fatalf(\"registry limitation omitted: %+v\", metadata)\n293\t\t\t\t\t\t}\n294\t\t\t\t\t\tif mode == \"budget\" && strings.Contains(strings.Join(metadata.Limitations, \" \"), \"observed input changed\") {\n295\t\t\t\t\t\t\tt.Fatalf(\"unknown budget mislabelled as mutation: %+v\", metadata)\n296\t\t\t\t\t\t}\n297\t\t\t\t\t}\n298\t\t\t\t})\n299\t\t\t}\n300\t\t}\n301\t}\n302\t\n303\tfunc TestGovernanceReadViewRegistryFinalAuditBindsIdentity(t *testing.T) {\n304\t\troot, path := d7ProbeCoordinatorRoot(t)\n305\t\tstore := Store{Root: root}\n306\t\tbase, view := store.beginGovernanceReadView(true)\n307\t\tshared := base.withGovernanceReadView(view, \"projection\")\n308\t\tif _, err := shared.fsys().ReadFile(path); err != nil {\n309\t\t\tt.Fatal(err)\n310\t\t}\n311\t\taudit := view.audit()\n312\t\tbefore, _ := view.metadata(base.FederatedProjectID, \"fixture-revision\", \"legacy\", audit)\n313\t\tif before.Freshness != ReadViewFreshnessCurrent {\n314\t\t\tt.Fatalf(\"stable registry fixture was not current: %+v\", before)\n315\t\t}\n316\t\tinjectGovernanceRegistryAudit(shared, \"changed\")\n317\t\taudit = view.audit()\n318\t\tafter, _ := view.metadata(base.FederatedProjectID, \"fixture-revision\", \"legacy\", audit)\n319\t\tif !audit.ChangedProducers[\"projection\"] || after.Freshness != ReadViewFreshnessUnknown || after.ID == before.ID {\n320\t\t\tt.Fatalf(\"registry audit not bound into metadata identity: before=%+v after=%+v audit=%+v\", before, after, audit)\n321\t\t}\n322\t}\n323\t\n324\tfunc TestGovernanceReadViewRegistryFinalAuditReachesProjection(t *testing.T) {\n325\t\tfor _, mode := range []string{\"stable\", \"once\", \"changed\", \"conflict\", \"budget\"} {\n326\t\t\tt.Run(mode, func(t *testing.T) {\n327\t\t\t\tgovernanceReadViewProbeUseKnownEngineVersion(t)\n328\t\t\t\tstore := obligationFixture(t)\n329\t\t\t\tprevious := actionRequestObligationSource\n330\t\t\t\tt.Cleanup(func() { actionRequestObligationSource = previous })\n331\t\t\t\tcalls := 0\n332\t\t\t\tactionRequestObligationSource = func(s Store, _ string, _ []Spec, _ bool, _ *Coverage) ([]Obligation, error) {\n333\t\t\t\t\tcalls++\n334\t\t\t\t\tif mode != \"stable\" && !(mode == \"once\" && calls > 1) {\n335\t\t\t\t\t\tselected := mode\n336\t\t\t\t\t\tif selected == \"once\" {\n337\t\t\t\t\t\t\tselected = \"changed\"\n338\t\t\t\t\t\t}\n339\t\t\t\t\t\tinjectGovernanceRegistryAudit(s, selected)\n340\t\t\t\t\t}\n341\t\t\t\t\treturn nil, nil\n342\t\t\t\t}\n343\t\t\t\treport, err := store.ProjectObligations(ObligationQuery{})\n344\t\t\t\tif err != nil {\n345\t\t\t\t\tt.Fatal(err)\n346\t\t\t\t}\n347\t\t\t\twantCalls := 1\n348\t\t\t\tif mode == \"once\" || mode == \"changed\" || mode == \"conflict\" {\n349\t\t\t\t\twantCalls = 2\n350\t\t\t\t}\n351\t\t\t\tif calls != wantCalls {\n352\t\t\t\t\tt.Fatalf(\"producer attempts=%d want=%d\", calls, wantCalls)\n353\t\t\t\t}\n354\t\t\t\tmetadata := report.Snapshot.ReadView\n355\t\t\t\tif metadata == nil {\n356\t\t\t\t\tt.Fatal(\"projection omitted read-view metadata\")\n357\t\t\t\t}\n358\t\t\t\tif mode == \"stable\" || mode == \"once\" {\n359\t\t\t\t\tif !report.Snapshot.Coherent || metadata.Freshness != ReadViewFreshnessCurrent {\n360\t\t\t\t\t\tt.Fatalf(\"stable projection not current: snapshot=%+v metadata=%+v\", report.Snapshot, metadata)\n361\t\t\t\t\t}\n362\t\t\t\t} else {\n363\t\t\t\t\tif metadata.Freshness != ReadViewFreshnessUnknown {\n364\t\t\t\t\t\tt.Fatalf(\"registry audit disappeared from projection: %+v\", metadata)\n365\t\t\t\t\t}\n366\t\t\t\t\tif mode != \"budget\" && report.Snapshot.Coherent {\n367\t\t\t\t\t\tt.Fatalf(\"changed registry certified coherent: %+v\", report.Snapshot)\n368\t\t\t\t\t}\n369\t\t\t\t\tif governanceReadViewIntegrationCoverage(report, \"action-requests\") == CoverageStateCurrent {\n370\t\t\t\t\t\tt.Fatal(\"registry loss retained current producer coverage\")\n371\t\t\t\t\t}\n372\t\t\t\t}\n373\t\t\t})\n374\t\t}\n375\t}\n376\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"41b03bba-1df3-45b2-8afb-1d96e8448eea","timestamp":"2026-11-06T20:02:25.670Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/pose-review-run-2282112913/worktree/pose-mcp/internal/pose/governance_read_view_d7_probe_test.go","content":"\t\treturn nil\n\t})\n\tif err != nil || count != 2 {\n\t\tt.Fatalf(\"fitting scope reads inherited coordinator exhaustion: count=%d err=%v\", count, err)\n\t}\n}\n\nfunc TestGovernanceReadViewD7ProbeScopeLossDoesNotPoisonHealthySibling(t *testing.T) {\n\troot, path := d7ProbeCoordinatorRoot(t)\n\tvar scopeLoss error\n\thealthy := false\n\terr := (Store{Root: root}).WithReviewCoordinator(func(coordinator Store) error {\n\t\tscopeLoss = coordinator.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\trv, _ := governanceReadViewFromFiles(scope.fsys())\n\t\t\trv.operation.budgetMu.Lock()\n\t\t\trv.operation.records = governanceReadViewMaxRecords\n\t\t\trv.operation.budgetMu.Unlock()\n\t\t\t_, err := scope.fsys().ReadFile(path)\n\t\t\treturn err\n\t\t})\n\t\tsiblingErr := coordinator.WithReviewScopeOperationView(func(scope Store) error {\n\t\t\t_, err := scope.fsys().ReadFile(path)\n\t\t\thealthy = err == nil\n\t\t\treturn err\n\t\t})\n\t\treturn errors.Join(scopeLoss, siblingErr)\n\t})\n\tif scopeLoss == nil || !healthy || !errors.Is(err, ErrGovernanceReadViewUnknown) {\n\t\tt.Fatalf(\"loss was suppressed or poisoned sibling: scope=%v healthy=%t coordinator=%v\", scopeLoss, healthy, err)\n\t}\n}\n\n// The registry is an operation input, not a file in any one root. Inject its\n// final observation at the same boundary used by the production wrappers.\nfunc injectGovernanceRegistryAudit(store Store, mode string) {\n\tview, _ := governanceReadViewFromFiles(store.fsys())\n\top := view.operation\n\top.mu.Lock()\n\troots := map[string]string{}\n\tfor project, root := range op.initialRoots {\n\t\troots[project] = root\n\t}\n\tconflicts := cloneBoolMap(op.initialConflicts)\n\top.currentRoots = func() (map[string]string, map[string]bool, bool) {\n\t\tif mode == \"changed\" {\n\t\t\troots[\"proj.added\"] = filepath.Join(store.Root, \"added-root\")\n\t\t}\n\t\tif mode == \"conflict\" {\n\t\t\tconflicts[op.mainProject] = true\n\t\t}\n\t\treturn roots, conflicts, mode == \"budget\"\n\t}\n\top.mu.Unlock()\n}\n\nfunc TestGovernanceReadViewRegistryFinalAuditReachesReviewAndCloseout(t *testing.T) {\n\tfor _, gate := range []string{\"review\", \"closeout\"} {\n\t\tfor _, mode := range []string{\"stable\", \"once\", \"changed\", \"conflict\", \"budget\"} {\n\t\t\tt.Run(gate+\"/\"+mode, func(t *testing.T) {\n\t\t\t\tstore, _, _ := retentionFixture(t)\n\t\t\t\tcloseBackendSpec(t, store)\n\t\t\t\tbindCurrentReviewFixture(t, store)\n\t\t\t\tcalls := 0\n\t\t\t\tinject := func(s Store) {\n\t\t\t\t\tcalls++\n\t\t\t\t\tif mode == \"stable\" || mode == \"once\" && calls > 1 {\n\t\t\t\t\t\treturn\n\t\t\t\t\t}\n\t\t\t\t\tselected := mode\n\t\t\t\t\tif selected == \"once\" {\n\t\t\t\t\t\tselected = \"changed\"\n\t\t\t\t\t}\n\t\t\t\t\tinjectGovernanceRegistryAudit(s, selected)\n\t\t\t\t}\n\t\t\t\tvar metadata *ReadViewMetadata\n\t\t\t\tvar approved, fresh, terminal bool\n\t\t\t\tif gate == \"review\" {\n\t\t\t\t\tvalue, err := withGovernanceReviewReadView(store, \"review\", func(s Store) (ReviewEvaluation, error) {\n\t\t\t\t\t\tresult, err := s.ReviewCheck(\"spec:backend\")\n\t\t\t\t\t\tinject(s)\n\t\t\t\t\t\treturn result, err\n\t\t\t\t\t}, applyReviewReadView)\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\tt.Fatal(err)\n\t\t\t\t\t}\n\t\t\t\t\tmetadata, approved, fresh = value.ReadView, value.Approved, value.Fresh\n\t\t\t\t} else {\n\t\t\t\t\tvalue, err := withGovernanceReviewReadView(store, \"closeout\", func(s Store) (CloseoutState, error) {\n\t\t\t\t\t\tresult, err := s.getCloseoutState(\"spec:backend\", true)\n\t\t\t\t\t\tinject(s)\n\t\t\t\t\t\treturn result, err\n\t\t\t\t\t}, func(v *CloseoutState, m *ReadViewMetadata, a governanceReadViewAudit) {\n\t\t\t\t\t\tapplyCloseoutReadView(v, m, \"spec:backend\", a)\n\t\t\t\t\t})\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\tt.Fatal(err)\n\t\t\t\t\t}\n\t\t\t\t\tmetadata, approved, fresh, terminal = value.ReadView, value.Review.Approved, value.Review.Fresh, value.Terminal\n\t\t\t\t}\n\t\t\t\texpectedCalls := 1\n\t\t\t\tif mode == \"once\" || mode == \"changed\" || mode == \"conflict\" {\n\t\t\t\t\texpectedCalls = 2\n\t\t\t\t}\n\t\t\t\tif calls != expectedCalls {\n\t\t\t\t\tt.Fatalf(\"attempts=%d want=%d\", calls, expectedCalls)\n\t\t\t\t}\n\t\t\t\tif metadata == nil {\n\t\t\t\t\tt.Fatal(\"missing read-view metadata\")\n\t\t\t\t}\n\t\t\t\tstable := mode == \"stable\" || mode == \"once\"\n\t\t\t\tif stable {\n\t\t\t\t\tif !approved || !fresh || gate == \"closeout\" && !terminal || metadata.Freshness != ReadViewFreshnessCurrent {\n\t\t\t\t\t\tt.Fatalf(\"stable result lost: approved=%t fresh=%t terminal=%t metadata=%+v\", approved, fresh, terminal, metadata)\n\t\t\t\t\t}\n\t\t\t\t} else {\n\t\t\t\t\tif metadata.Freshness != ReadViewFreshnessUnknown {\n\t\t\t\t\t\tt.Fatalf(\"registry audit was lost: %+v\", metadata)\n\t\t\t\t\t}\n\t\t\t\t\tif mode != \"budget\" && (approved || fresh || gate == \"closeout\" && terminal) {\n\t\t\t\t\t\tt.Fatalf(\"changed registry retained approval: approved=%t fresh=%t terminal=%t\", approved, fresh, terminal)\n\t\t\t\t\t}\n\t\t\t\t\tif !strings.Contains(strings.Join(metadata.Limitations, \" \"), \"authorized root registry\") {\n\t\t\t\t\t\tt.Fatalf(\"registry limitation omitted: %+v\", metadata)\n\t\t\t\t\t}\n\t\t\t\t\tif mode == \"budget\" && strings.Contains(strings.Join(metadata.Limitations, \" \"), \"observed input changed\") {\n\t\t\t\t\t\tt.Fatalf(\"unknown budget mislabelled as mutation: %+v\", metadata)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t})\n\t\t}\n\t}\n}\n\nfunc TestGovernanceReadViewRegistryFinalAuditBindsIdentity(t *testing.T) {\n\troot, path := d7ProbeCoordinatorRoot(t)\n\tstore := Store{Root: root}\n\tbase, view := store.beginGovernanceReadView(true)\n\tshared := base.withGovernanceReadView(view, \"projection\")\n\tif _, err := shared.fsys().ReadFile(path); err != nil {\n\t\tt.Fatal(err)\n\t}\n\taudit := view.audit()\n\tbefore, _ := view.metadata(base.FederatedProjectID, \"fixture-revision\", \"legacy\", audit)\n\tif before.Freshness != ReadViewFreshnessCurrent {\n\t\tt.Fatalf(\"stable registry fixture was not current: %+v\", before)\n\t}\n\tinjectGovernanceRegistryAudit(shared, \"changed\")\n\taudit = view.audit()\n\tafter, _ := view.metadata(base.FederatedProjectID, \"fixture-revision\", \"legacy\", audit)\n\tif !audit.ChangedProducers[\"projection\"] || after.Freshness != ReadViewFreshnessUnknown || after.ID == before.ID {\n\t\tt.Fatalf(\"registry audit not bound into metadata identity: before=%+v after=%+v audit=%+v\", before, after, audit)\n\t}\n}\n\nfunc TestGovernanceReadViewRegistryFinalAuditReachesProjection(t *testing.T) {\n\tfor _, mode := range []string{\"stable\", \"once\", \"changed\", \"conflict\", \"budget\"} {\n\t\tt.Run(mode, func(t *testing.T) {\n\t\t\tgovernanceReadViewProbeUseKnownEngineVersion(t)\n\t\t\tstore := obligationFixture(t)\n\t\t\tprevious := actionRequestObligationSource\n\t\t\tt.Cleanup(func() { actionRequestObligationSource = previous })\n\t\t\tcalls := 0\n\t\t\tactionRequestObligationSource = func(s Store, _ string, _ []Spec, _ bool, _ *Coverage) ([]Obligation, error) {\n\t\t\t\tcalls++\n\t\t\t\tif mode != \"stable\" && !(mode == \"once\" && calls > 1) {\n\t\t\t\t\tselected := mode\n\t\t\t\t\tif selected == \"once\" {\n\t\t\t\t\t\tselected = \"changed\"\n\t\t\t\t\t}\n\t\t\t\t\tinjectGovernanceRegistryAudit(s, selected)\n\t\t\t\t}\n\t\t\t\treturn nil, nil\n\t\t\t}\n\t\t\treport, err := store.ProjectObligations(ObligationQuery{})\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\twantCalls := 1\n\t\t\tif mode == \"once\" || mode == \"changed\" || mode == \"conflict\" {\n\t\t\t\twantCalls = 2\n\t\t\t}\n\t\t\tif calls != wantCalls {\n\t\t\t\tt.Fatalf(\"producer attempts=%d want=%d\", calls, wantCalls)\n\t\t\t}\n\t\t\tmetadata := report.Snapshot.ReadView\n\t\t\tif metadata == nil {\n\t\t\t\tt.Fatal(\"projection omitted read-view metadata\")\n\t\t\t}\n\t\t\tif mode == \"stable\" || mode == \"once\" {\n\t\t\t\tif !report.Snapshot.Coherent || metadata.Freshness != ReadViewFreshnessCurrent {\n\t\t\t\t\tt.Fatalf(\"stable projection not current: snapshot=%+v metadata=%+v\", report.Snapshot, metadata)\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif metadata.Freshness != ReadViewFreshnessUnknown {\n\t\t\t\t\tt.Fatalf(\"registry audit disappeared from projection: %+v\", metadata)\n\t\t\t\t}\n\t\t\t\tif mode != \"budget\" && report.Snapshot.Coherent {\n\t\t\t\t\tt.Fatalf(\"changed registry certified coherent: %+v\", report.Snapshot)\n\t\t\t\t}\n\t\t\t\tif governanceReadViewIntegrationCoverage(report, \"action-requests\") == CoverageStateCurrent {\n\t\t\t\t\tt.Fatal(\"registry loss retained current producer coverage\")\n\t\t\t\t}\n\t\t\t}\n\t\t})\n\t}\n}\n","numLines":207,"startLine":170,"totalLines":376}},"tool_result_meta":[{"id":"toolu_01M9zk45e4YoeoPG45ATXYhE","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
