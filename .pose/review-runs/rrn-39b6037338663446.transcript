{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UkjwVVry4LcP4oyU9ywWey","type":"tool_result","content":"1\tpackage pose\n2\t\n3\timport (\n4\t\t\"errors\"\n5\t\t\"fmt\"\n6\t\t\"os\"\n7\t\t\"strings\"\n8\t)\n9\t\n10\t// actionResolutionProjectID prefers the Store's selected project, but only\n11\t// while its declared identity and any resolver binding still name this root.\n12\t// A derived directory/environment identity is used only for an unscoped Store.\n13\tfunc (s Store) actionResolutionProjectID() (string, error) {\n14\t\tproject := strings.TrimSpace(s.FederatedProjectID)\n15\t\tif project == \"\" {\n16\t\t\treturn s.WriteProjectID()\n17\t\t}\n18\t\tif ValidateSlug(project) != nil {\n19\t\t\treturn \"\", fmt.Errorf(\"pose: selected project identity is invalid\")\n20\t\t}\n21\t\tdeclared, found, err := ReadProjectFileIn(s.fsys(), s.Root)\n22\t\tif err != nil {\n23\t\t\treturn \"\", err\n24\t\t}\n25\t\tif found && declared != project {\n26\t\t\treturn \"\", fmt.Errorf(\"pose: selected project identity conflicts with .pose/project.json\")\n27\t\t}\n28\t\tif s.FederatedResolver != nil {\n29\t\t\tresolver := s.FederatedResolver\n30\t\t\tif resolver.Authorize != nil && !resolver.Authorize(project) {\n31\t\t\t\treturn \"\", fmt.Errorf(\"pose: selected project is not authorized\")\n32\t\t\t}\n33\t\t\tif resolver.Roots != nil {\n34\t\t\t\tselected, selectErr := resolver.Roots.StoreFor(project)\n35\t\t\t\tif selectErr == nil {\n36\t\t\t\t\tif !sameProjectRoot(s.fsys(), s.Root, selected.Root) {\n37\t\t\t\t\t\treturn \"\", fmt.Errorf(\"pose: selected project is bound to another root\")\n38\t\t\t\t\t}\n39\t\t\t\t\tif resolver.Roots.cfg.DefaultProjectID != \"\" && resolver.Roots.cfg.DefaultProjectID != project &&\n40\t\t\t\t\t\tresolver.Roots.cfg.DefaultRoot != \"\" &&\n41\t\t\t\t\t\tsameProjectRoot(s.fsys(), s.Root, resolver.Roots.cfg.DefaultRoot) {\n42\t\t\t\t\t\treturn \"\", fmt.Errorf(\"pose: selected project conflicts with the default identity for this root\")\n43\t\t\t\t\t}\n44\t\t\t\t} else if isUnknownProjectSelection(selectErr) {\n45\t\t\t\t\t// An explicitly selected Store can be the local default root even\n46\t\t\t\t\t// when Roots has no nonempty project-id entry for it. Confirm the\n47\t\t\t\t\t// default root and its declared identity before using that fallback.\n48\t\t\t\t\tdefaultStore, defaultErr := resolver.Roots.StoreFor(\"\")\n49\t\t\t\t\tif defaultErr != nil || !sameProjectRoot(s.fsys(), s.Root, defaultStore.Root) ||\n50\t\t\t\t\t\tresolver.Roots.cfg.DefaultProjectID != \"\" && resolver.Roots.cfg.DefaultProjectID != project {\n51\t\t\t\t\t\treturn \"\", fmt.Errorf(\"pose: selected project is not bound to this root\")\n52\t\t\t\t\t}\n53\t\t\t\t} else {\n54\t\t\t\t\treturn \"\", selectErr\n55\t\t\t\t}\n56\t\t\t}\n57\t\t}\n58\t\treturn project, nil\n59\t}\n60\t\n61\t// actionMaterialProjectSet identifies the roots a request evaluation actually\n62\t// resolves. It follows each request reference with the same resolver used by\n63\t// actionMaterial, retaining original, canonical and transitive dependency\n64\t// projects so redirects cannot move the evaluated subject outside the lease.\n65\tfunc (s Store) actionMaterialProjectSet(request ActionRequest) (map[string]bool, error) {\n66\t\tlocalID := request.Project\n67\t\tif localID == \"\" {\n68\t\t\tvar err error\n69\t\t\tlocalID, err = s.WriteProjectID()\n70\t\t\tif err != nil {\n71\t\t\t\treturn nil, err\n72\t\t\t}\n73\t\t}\n74\t\tresolver := ArtifactResolver{}\n75\t\tif s.FederatedResolver != nil {\n76\t\t\tresolver = *s.FederatedResolver\n77\t\t} else {\n78\t\t\tvar err error\n79\t\t\tresolver, _, err = EnvironmentArtifactResolverIn(s.fsys(), s.Root, \"\")\n80\t\t\tif err != nil {\n81\t\t\t\treturn nil, err\n82\t\t\t}\n83\t\t}\n84\t\tprobe := s\n85\t\tprobe.FederatedProjectID = localID\n86\t\tprobe.FederatedResolver = &resolver\n87\t\tprojects := map[string]bool{localID: true}\n88\t\taddResolution := func(raw string) error {\n89\t\t\tref, err := ParseArtifactRef(raw)\n90\t\t\tif err != nil {\n91\t\t\t\treturn err\n92\t\t\t}\n93\t\t\tif ref.Project == \"\" {\n94\t\t\t\tref.Project = localID\n95\t\t\t}\n96\t\t\tif ref.Project == localID {\n97\t\t\t\t// Match actionMaterial: an already-selected local Store does not\n98\t\t\t\t// need federation adoption or a contained foreign-root resolver.\n99\t\t\t\t// addNode still validates the actual artifact/node in that Store.\n100\t\t\t\treturn nil\n101\t\t\t}\n102\t\t\tresolved := resolver.Resolve(localID, ref.String())\n103\t\t\tif !resolved.Resolved {\n104\t\t\t\treturn fmt.Errorf(\"material %s: %s\", raw, resolved.State)\n105\t\t\t}\n106\t\t\taddArtifactProject(projects, resolved.Identity)\n107\t\t\tif resolved.CanonicalIdentity != nil {\n108\t\t\t\taddArtifactProject(projects, *resolved.CanonicalIdentity)\n109\t\t\t}\n110\t\t\tfor _, dependency := range resolved.Dependencies {\n111\t\t\t\taddArtifactProject(projects, dependency)\n112\t\t\t}\n113\t\t\treturn nil\n114\t\t}\n115\t\tvar addNode func(NodeRef) error\n116\t\taddNode = func(node NodeRef) error {\n117\t\t\tref, err := ParseArtifactRef(node.Artifact)\n118\t\t\tif err != nil {\n119\t\t\t\treturn err\n120\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"c8073a8c-3291-44ff-9e9a-ea994fbc0c94","timestamp":"2026-11-06T20:02:47.160Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/pose-review-run-2282112913/worktree/pose-mcp/internal/pose/action_write_scope.go","content":"package pose\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"strings\"\n)\n\n// actionResolutionProjectID prefers the Store's selected project, but only\n// while its declared identity and any resolver binding still name this root.\n// A derived directory/environment identity is used only for an unscoped Store.\nfunc (s Store) actionResolutionProjectID() (string, error) {\n\tproject := strings.TrimSpace(s.FederatedProjectID)\n\tif project == \"\" {\n\t\treturn s.WriteProjectID()\n\t}\n\tif ValidateSlug(project) != nil {\n\t\treturn \"\", fmt.Errorf(\"pose: selected project identity is invalid\")\n\t}\n\tdeclared, found, err := ReadProjectFileIn(s.fsys(), s.Root)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tif found && declared != project {\n\t\treturn \"\", fmt.Errorf(\"pose: selected project identity conflicts with .pose/project.json\")\n\t}\n\tif s.FederatedResolver != nil {\n\t\tresolver := s.FederatedResolver\n\t\tif resolver.Authorize != nil && !resolver.Authorize(project) {\n\t\t\treturn \"\", fmt.Errorf(\"pose: selected project is not authorized\")\n\t\t}\n\t\tif resolver.Roots != nil {\n\t\t\tselected, selectErr := resolver.Roots.StoreFor(project)\n\t\t\tif selectErr == nil {\n\t\t\t\tif !sameProjectRoot(s.fsys(), s.Root, selected.Root) {\n\t\t\t\t\treturn \"\", fmt.Errorf(\"pose: selected project is bound to another root\")\n\t\t\t\t}\n\t\t\t\tif resolver.Roots.cfg.DefaultProjectID != \"\" && resolver.Roots.cfg.DefaultProjectID != project &&\n\t\t\t\t\tresolver.Roots.cfg.DefaultRoot != \"\" &&\n\t\t\t\t\tsameProjectRoot(s.fsys(), s.Root, resolver.Roots.cfg.DefaultRoot) {\n\t\t\t\t\treturn \"\", fmt.Errorf(\"pose: selected project conflicts with the default identity for this root\")\n\t\t\t\t}\n\t\t\t} else if isUnknownProjectSelection(selectErr) {\n\t\t\t\t// An explicitly selected Store can be the local default root even\n\t\t\t\t// when Roots has no nonempty project-id entry for it. Confirm the\n\t\t\t\t// default root and its declared identity before using that fallback.\n\t\t\t\tdefaultStore, defaultErr := resolver.Roots.StoreFor(\"\")\n\t\t\t\tif defaultErr != nil || !sameProjectRoot(s.fsys(), s.Root, defaultStore.Root) ||\n\t\t\t\t\tresolver.Roots.cfg.DefaultProjectID != \"\" && resolver.Roots.cfg.DefaultProjectID != project {\n\t\t\t\t\treturn \"\", fmt.Errorf(\"pose: selected project is not bound to this root\")\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\treturn \"\", selectErr\n\t\t\t}\n\t\t}\n\t}\n\treturn project, nil\n}\n\n// actionMaterialProjectSet identifies the roots a request evaluation actually\n// resolves. It follows each request reference with the same resolver used by\n// actionMaterial, retaining original, canonical and transitive dependency\n// projects so redirects cannot move the evaluated subject outside the lease.\nfunc (s Store) actionMaterialProjectSet(request ActionRequest) (map[string]bool, error) {\n\tlocalID := request.Project\n\tif localID == \"\" {\n\t\tvar err error\n\t\tlocalID, err = s.WriteProjectID()\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t}\n\tresolver := ArtifactResolver{}\n\tif s.FederatedResolver != nil {\n\t\tresolver = *s.FederatedResolver\n\t} else {\n\t\tvar err error\n\t\tresolver, _, err = EnvironmentArtifactResolverIn(s.fsys(), s.Root, \"\")\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t}\n\tprobe := s\n\tprobe.FederatedProjectID = localID\n\tprobe.FederatedResolver = &resolver\n\tprojects := map[string]bool{localID: true}\n\taddResolution := func(raw string) error {\n\t\tref, err := ParseArtifactRef(raw)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif ref.Project == \"\" {\n\t\t\tref.Project = localID\n\t\t}\n\t\tif ref.Project == localID {\n\t\t\t// Match actionMaterial: an already-selected local Store does not\n\t\t\t// need federation adoption or a contained foreign-root resolver.\n\t\t\t// addNode still validates the actual artifact/node in that Store.\n\t\t\treturn nil\n\t\t}\n\t\tresolved := resolver.Resolve(localID, ref.String())\n\t\tif !resolved.Resolved {\n\t\t\treturn fmt.Errorf(\"material %s: %s\", raw, resolved.State)\n\t\t}\n\t\taddArtifactProject(projects, resolved.Identity)\n\t\tif resolved.CanonicalIdentity != nil {\n\t\t\taddArtifactProject(projects, *resolved.CanonicalIdentity)\n\t\t}\n\t\tfor _, dependency := range resolved.Dependencies {\n\t\t\taddArtifactProject(projects, dependency)\n\t\t}\n\t\treturn nil\n\t}\n\tvar addNode func(NodeRef) error\n\taddNode = func(node NodeRef) error {\n\t\tref, err := ParseArtifactRef(node.Artifact)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}","numLines":120,"startLine":1,"totalLines":266}},"tool_result_meta":[{"id":"toolu_01UkjwVVry4LcP4oyU9ywWey","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
