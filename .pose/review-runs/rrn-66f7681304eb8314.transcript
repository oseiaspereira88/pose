epares cmd, a git command reading the repository at root,\n // to read root's index without being able to write it. The returned function\n // releases what it holds; call it after the command ends.\n func ReadOnlyIndex(cmd *exec.Cmd, root string) (func(), error) {\n-\tout, err := RawGit(\"-C\", root, \"rev-parse\", \"--path-format=absolute\", \"--git-path\", \"index\").Output()\n+\tctx, cancel := context.WithTimeout(context.Background(), indexLookupTimeout)\n+\tdefer cancel()\n+\treturn ReadOnlyIndexContext(ctx, cmd, root)\n+}\n+\n+// ReadOnlyIndexContext is ReadOnlyIndex with the lookup of the index bound by\n+// ctx, the caller's deadline (review round 1, N3).\n+func ReadOnlyIndexContext(ctx context.Context, cmd *exec.Cmd, root string) (func(), error) {\n+\t// `--git-path` without `--path-format`, which Git before 2.31 would echo\n+\t// back as a path that does not exist (review round 5, N26): the answer is\n+\t// relative to root unless absolute.\n+\tlookup := gitCommandContext(ctx, \"--no-replace-objects\", \"-C\", root, \"rev-parse\", \"--git-path\", \"index\")\n+\tGitEnglish(lookup)\n+\tvar lookupErr bytes.Buffer\n+\tlookup.Stderr = &lookupErr\n+\tout, err := lookup.Output()\n \tif err != nil {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be located: %w\", root, err)\n+\t\t// Not an index failure: no repository, a broken config or HEAD; Git's\n+\t\t// own words say which (review round 2, N14).\n+\t\treturn func() {}, GitReadError(\"pose: locating the index of \"+root, err, lookupErr.Bytes())\n \t}\n \tpath := strings.TrimSuffix(string(out), \"\\n\")\n-\tbefore, err := os.Stat(path)\n+\tif !filepath.IsAbs(path) {\n+\t\tpath = filepath.Join(root, path)\n+\t}\n+\t// Opened without blocking, so a FIFO or device there cannot hang the\n+\t// read, and judged on the open file, so an index another process\n+\t// replaces atomically is read whole, as Git reads it (review rounds 4\n+\t// N21, 5 N22).\n+\tf, err := openIndexNoBlock(path)\n \tif os.IsNotExist(err) {\n \t\t// No index yet: there is no stat cache to refresh, so the plain read\n \t\t// writes nothing (review round 2, N11).\n \t\treturn func() {}, nil\n \t}\n-\t// A FIFO or device is refused before it is opened, which could block\n-\t// (review round 4, N21); the open file must be the file checked, and is\n-\t// read within the bound (round 3, N17).\n-\tif err != nil || !before.Mode().IsRegular() {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is not a regular file\", root)\n-\t}\n-\tf, err := os.Open(path)\n \tif err != nil {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w\", root, err)\n+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w: %w\", root, ErrIndexUnreadable, err)\n \t}\n \tdefer f.Close()\n \tinfo, err := f.Stat()\n-\tif err != nil || !info.Mode().IsRegular() || !os.SameFile(before, info) {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s changed while it was opened\", root)\n+\tif err != nil || !info.Mode().IsRegular() {\n+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is not a regular file: %w\", root, ErrIndexUnreadable)\n \t}\n \traw, err := io.ReadAll(io.LimitReader(f, diffIndexLimit+1))\n \tif err != nil {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w\", root, err)\n+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w: %w\", root, ErrIndexUnreadable, err)\n \t}\n \tif len(raw) > diffIndexLimit {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is larger than %d bytes\", root, diffIndexLimit)\n+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is larger than %d bytes: %w\", root, diffIndexLimit, ErrIndexUnreadable)\n \t}\n \t// The copy keeps the index's modification time: Git trusts an entry on\n \t// its stat only when the file is older than the index, so a fresher copy\n \t// would hide a change made in the index's own second (review round 2,\n \t// N10, racy-clean entries).\n-\treturn readOnlyIndexFor(cmd, raw, info.ModTime())\n+\t// Git's messages in English, so GitReadError can tell an index failure\n+\t// whatever the user's locale.\n+\tGitEnglish(cmd)\n+\tdone, err := readOnlyIndexFor(cmd, raw, info.ModTime())\n+\tif err != nil {\n+\t\treturn done, fmt.Errorf(\"pose: the index of %s cannot be handed to git: %w: %w\", root, ErrIndexUnreadable, err)\n+\t}\n+\treturn done, nil\n+}\n+\n+// gitReadSaidLimit bounds what a read error keeps of Git's standard error.\n+const gitReadSaidLimit = 600\n+\n+// GitReadError describes a failed git read with what git said on standard\n+// error, all of it on one line and bounded, so a warning Git prints first\n+// does not hide the cause (review round 3, N17). It does not guess from the\n+// words whether the index was at fault: ErrIndexUnreadable marks only the\n+// failures of ReadOnlyIndex itself (review rounds 2 N13, 3 N18).\n+func GitReadError(what string, err error, stderr []byte) error {\n+\t// Git's fatal and error lines first, so a long warning before them does\n+\t// not push the cause past the bound (review round 4, N25).\n+\tvar first, rest []string\n+\tfor _, line := range strings.Split(string(stderr), \"\\n\") {\n+\t\tline = strings.Join(strings.Fields(line), \" \")\n+\t\tswitch {\n+\t\tcase line == \"\":\n+\t\tcase strings.HasPrefix(line, \"fatal:\") || strings.HasPrefix(line, \"error:\"):\n+\t\t\tfirst = append(first, line)\n+\t\tdefault:\n+\t\t\trest = append(rest, line)\n+\t\t}\n+\t}\n+\tsaid := strings.Join(append(first, rest...), \" ; \")\n+\tif len(said) > gitReadSaidLimit {\n+\t\tsaid = said[:gitReadSaidLimit] + \"…\"\n+\t}\n+\tif said == \"\" {\n+\t\treturn fmt.Errorf(\"%s failed: %w\", what, err)\n+\t}\n+\treturn fmt.Errorf(\"%s failed: %w: %s\", what, err, said)\n+}\n+\n+// GitEnglish makes cmd's messages English, so the causes reported read the\n+// same in every locale.\n+func GitEnglish(cmd *exec.Cmd) {\n+\tcmd.Env = append(cmd.Env, \"LC_ALL=C\", \"LANGUAGE=C\")\n+}\n+\n+// privateIndexCopy hands raw to cmd as a private copy: Git refreshes and may\n+// rewrite the copy, never the checkout's index.\n+func privateIndexCopy(cmd *exec.Cmd, raw []byte, modTime time.Time) (func(), error) {\n+\tdir, err := os.MkdirTemp(\"\", \"pose-index-*\")\n+\tif err != nil {\n+\t\treturn func() {}, err\n+\t}\n+\tdone := func() { _ = os.RemoveAll(dir) }\n+\tpath := filepath.Join(dir, \"index\")\n+\tif err := os.WriteFile(path, raw, 0o600); err != nil {\n+\t\tdone()\n+\t\treturn func() {}, err\n+\t}\n+\tif err := os.Chtimes(path, modTime, modTime); err != nil {\n+\t\tdone()\n+\t\treturn func() {}, err\n+\t}\n+\t// A split index would write a new shared index into .git.\n+\tcmd.Args = append([]string{cmd.Args[0], \"-c\", \"core.splitIndex=false\"}, cmd.Args[1:]...)\n+\tcmd.Env = append(cmd.Env, \"GIT_INDEX_FILE=\"+path)\n+\treturn done, nil\n }\n \n // RawGitDiffReadOnly runs RawGit(args...), a diff of the repository at root,\n@@ -73,5 +171,11 @@ func RawGitDiffReadOnly(root string, args ...string) ([]byte, error) {\n \tif err != nil {\n \t\treturn nil, err\n \t}\n-\treturn cmd.Output()\n+\tvar stderr bytes.Buffer\n+\tcmd.Stderr = &stderr\n+\tout, err := cmd.Output()\n+\tif err != nil {\n+\t\treturn nil, GitReadError(\"git diff\", err, stderr.Bytes())\n+\t}\n+\treturn out, nil\n }\ndiff --git a/pose-mcp/internal/pose/git_worktree_reads_linux.go b/pose-mcp/internal/pose/git_worktree_reads_linux.go\nindex bcc6e8fd..508b1ec5 100644\n--- a/pose-mcp/internal/pose/git_worktree_reads_linux.go\n+++ b/pose-mcp/internal/pose/git_worktree_reads_linux.go\n@@ -17,25 +17,36 @@ import (\n // exist, so the lock fails for any user, root included, and the refresh is\n // not written. No file is created.\n func readOnlyIndexFor(cmd *exec.Cmd, raw []byte, modTime time.Time) (func(), error) {\n-\tfd, err := unix.MemfdCreate(\"pose-index/none\", unix.MFD_CLOEXEC)\n+\tfd, err := memfdCreate(\"pose-index/none\", unix.MFD_CLOEXEC)\n \tif err != nil {\n-\t\treturn func() {}, fmt.Errorf(\"pose: an in-memory index cannot be made: %w\", err)\n+\t\t// No memory file here (an old kernel, a seccomp filter): the private\n+\t\t// copy keeps the index untouched too (review round 5, N27).\n+\t\treturn privateIndexCopy(cmd, raw, modTime)\n \t}\n \tf := os.NewFile(uintptr(fd), \"pose-index\")\n \tif _, err := f.Write(raw); err != nil {\n \t\tf.Close()\n-\t\treturn func() {}, err\n+\t\treturn privateIndexCopy(cmd, raw, modTime) // review round 1, N8\n \t}\n \tif _, err := f.Seek(0, 0); err != nil {\n \t\tf.Close()\n-\t\treturn func() {}, err\n+\t\treturn privateIndexCopy(cmd, raw, modTime)\n \t}\n \tts := unix.NsecToTimespec(modTime.UnixNano())\n-\tif err := unix.UtimesNanoAt(unix.AT_FDCWD, fmt.Sprintf(\"/proc/self/fd/%d\", fd), []unix.Timespec{ts, ts}, 0); err != nil {\n+\tif err := utimesNanoAt(unix.AT_FDCWD, fmt.Sprintf(\"/proc/self/fd/%d\", fd), []unix.Timespec{ts, ts}, 0); err != nil {\n+\t\t// Without /proc the memory file cannot carry the time, nor be named\n+\t\t// to Git: the private copy is read instead (review round 5, N27).\n \t\tf.Close()\n-\t\treturn func() {}, fmt.Errorf(\"pose: the in-memory index cannot keep the index's time: %w\", err)\n+\t\treturn privateIndexCopy(cmd, raw, modTime)\n \t}\n \tcmd.ExtraFiles = append(cmd.ExtraFiles, f)\n \tcmd.Env = append(cmd.Env, fmt.Sprintf(\"GIT_INDEX_FILE=/proc/self/fd/%d\", 2+len(cmd.ExtraFiles)))\n \treturn func() { f.Close() }, nil\n }\n+\n+// memfdCreate and utimesNanoAt are the calls the memory file needs; a test\n+// replaces them to exercise the fallback (review round 1, N4).\n+var (\n+\tmemfdCreate  = unix.MemfdCreate\n+\tutimesNanoAt = unix.UtimesNanoAt\n+)\ndiff --git a/pose-mcp/internal/pose/git_worktree_reads_linux_test.go b/pose-mcp/internal/pose/git_worktree_reads_linux_test.go\nnew file mode 100644\nindex 00000000..eac133aa\n--- /dev/null\n+++ b/pose-mcp/internal/pose/git_worktree_reads_linux_test.go\n@@ -0,0 +1,55 @@\n+//go:build linux\n+\n+package pose\n+\n+import (\n+\t\"bytes\"\n+\t\"errors\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"testing\"\n+\n+\t\"golang.org/x/sys/unix\"\n+)\n+\n+// Spec pose-validate-read-only-index-followups R4 (review round 1, N4): when\n+// no memory file can be made, or it cannot carry the index's time, the read\n+// falls back to the private copy, answers and leaves the index.\n+func TestReadOnlyIndexFallsBackWithoutAMemoryFile(t *testing.T) {\n+\tfor _, broken := range []string{\"memfd\", \"utimes\"} {\n+\t\tt.Run(broken, func(t *testing.T) {\n+\t\t\tsaveMemfd, saveUtimes := memfdCreate, utimesNanoAt\n+\t\t\tdefer func() { memfdCreate, utimesNanoAt = saveMemfd, saveUtimes }()\n+\t\t\tif broken == \"memfd\" {\n+\t\t\t\tmemfdCreate = func(string, int) (int, error) { return -1, errors.New(\"no memfd here\") }\n+\t\t\t} else {\n+\t\t\t\tutimesNanoAt = func(int, string, []unix.Timespec, int) error { return errors.New(\"no /proc here\") }\n+\t\t\t}\n+\t\t\ttop, _ := staleRepo(t, \"\")\n+\t\t\tbefore, err := os.ReadFile(filepath.Join(top, \".git\", \"index\"))\n+\t\t\tif err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tout, err := RawGitDiffReadOnly(top, \"-C\", top, \"diff\", \"--name-only\", \"--\")\n+\t\t\tif err != nil || len(out) != 0 {\n+\t\t\t\tt.Fatalf(\"the fallback answered %q %v\", out, err)\n+\t\t\t}\n+\t\t\tif after, _ := os.ReadFile(filepath.Join(top, \".git\", \"index\")); !bytes.Equal(before, after) {\n+\t\t\t\tt.Fatal(\"the fallback read rewrote .git/index\")\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+// Review round 2, N16: a failure handing the index to git, here with neither\n+// a memory file nor a usable temporary directory, is an index failure.\n+func TestAFailedIndexHandOverIsAnIndexFailure(t *testing.T) {\n+\ttop, _ := staleRepo(t, \"\")\n+\tsave := memfdCreate\n+\tdefer func() { memfdCreate = save }()\n+\tmemfdCreate = func(string, int) (int, error) { return -1, errors.New(\"no memfd here\") }\n+\tt.Setenv(\"TMPDIR\", filepath.Join(t.TempDir(), \"missing\"))\n+\tif _, err := RawGitDiffReadOnly(top, \"-C\", top, \"diff\", \"--name-only\", \"--\"); !errors.Is(err, ErrIndexUnreadable) {\n+\t\tt.Fatalf(\"a failed hand-over: %v\", err)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/git_worktree_reads_other.go b/pose-mcp/internal/pose/git_worktree_reads_other.go\nindex 6cb7e722..2cd09871 100644\n--- a/pose-mcp/internal/pose/git_worktree_reads_other.go\n+++ b/pose-mcp/internal/pose/git_worktree_reads_other.go\n@@ -3,31 +3,11 @@\n package pose\n \n import (\n-\t\"os\"\n \t\"os/exec\"\n-\t\"path/filepath\"\n \t\"time\"\n )\n \n-// readOnlyIndexFor hands raw to cmd as a private copy: Git refreshes and may\n-// rewrite the copy, never the checkout's index.\n+// readOnlyIndexFor reads a private copy where no memory file exists.\n func readOnlyIndexFor(cmd *exec.Cmd, raw []byte, modTime time.Time) (func(), error) {\n-\tdir, err := os.MkdirTemp(\"\", \"pose-index-*\")\n-\tif err != nil {\n-\t\treturn func() {}, err\n-\t}\n-\tdone := func() { _ = os.RemoveAll(dir) }\n-\tpath := filepath.Join(dir, \"index\")\n-\tif err := os.WriteFile(path, raw, 0o600); err != nil {\n-\t\tdone()\n-\t\treturn func() {}, err\n-\t}\n-\tif err := os.Chtimes(path, modTime, modTime); err != nil {\n-\t\tdone()\n-\t\treturn func() {}, err\n-\t}\n-\t// A split index would write a new shared index into .git.\n-\tcmd.Args = append([]string{cmd.Args[0], \"-c\", \"core.splitIndex=false\"}, cmd.Args[1:]...)\n-\tcmd.Env = append(cmd.Env, \"GIT_INDEX_FILE=\"+path)\n-\treturn done, nil\n+\treturn privateIndexCopy(cmd, raw, modTime)\n }\ndiff --git a/pose-mcp/internal/pose/git_worktree_reads_test.go b/pose-mcp/internal/pose/git_worktree_reads_test.go\nindex f3fe6224..6686d8fd 100644\n--- a/pose-mcp/internal/pose/git_worktree_reads_test.go\n+++ b/pose-mcp/internal/pose/git_worktree_reads_test.go\n@@ -2,6 +2,8 @@ package pose\n \n import (\n \t\"bytes\"\n+\t\"context\"\n+\t\"errors\"\n \t\"os\"\n \t\"os/exec\"\n \t\"path/filepath\"\n@@ -214,3 +216,235 @@ func TestReadOnlyIndexRefusesAFIFOIndex(t *testing.T) {\n \t\tt.Fatal(\"reading a FIFO index blocked\")\n \t}\n }\n+\n+// staleRepo is a committed repository whose index has a stale stat cache,\n+// with its POSE root optionally below the repository top.\n+func staleRepo(t *testing.T, sub string) (string, string) {\n+\tt.Helper()\n+\ttop := t.TempDir()\n+\troot := filepath.Join(top, sub)\n+\tif err := os.MkdirAll(root, 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tgit := func(args ...string) {\n+\t\tt.Helper()\n+\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", top, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\"}, args...)...).CombinedOutput(); err != nil {\n+\t\t\tt.Fatal(args, err, string(out))\n+\t\t}\n+\t}\n+\tgit(\"init\", \"-q\")\n+\tfile := filepath.Join(root, \"a.txt\")\n+\tif err := os.WriteFile(file, []byte(\"x\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tgit(\"add\", \"-A\")\n+\tgit(\"commit\", \"-q\", \"-m\", \"i\")\n+\tlater := time.Now().Add(2 * time.Second)\n+\tif err := os.Chtimes(file, later, later); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\treturn top, root\n+}\n+\n+// Spec pose-validate-read-only-index-followups R1: an index another process\n+// replaces atomically while it is read is read whole, never refused.\n+func TestReadOnlyIndexToleratesAnAtomicallyReplacedIndex(t *testing.T) {\n+\ttop, _ := staleRepo(t, \"\")\n+\tindex := filepath.Join(top, \".git\", \"index\")\n+\traw, err := os.ReadFile(index)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tstop := make(chan struct{})\n+\tgo func() {\n+\t\tfor i := 0; ; i++ {\n+\t\t\tselect {\n+\t\t\tcase <-stop:\n+\t\t\t\treturn\n+\t\t\tdefault:\n+\t\t\t}\n+\t\t\ttmp := index + \".swap\"\n+\t\t\tif os.WriteFile(tmp, raw, 0o644) == nil {\n+\t\t\t\t_ = os.Rename(tmp, index)\n+\t\t\t}\n+\t\t}\n+\t}()\n+\tdefer close(stop)\n+\tfor i := 0; i < 300; i++ {\n+\t\tif _, err := RawGitDiffReadOnly(top, \"-C\", top, \"diff\", \"--name-only\", \"--\"); err != nil {\n+\t\t\tt.Fatalf(\"read %d refused a replaced index: %v\", i, err)\n+\t\t}\n+\t}\n+}\n+\n+// Spec pose-validate-read-only-index-followups R3: the index is located\n+// without `--path-format`, also from a POSE root below the repository top,\n+// so the read is protected there and leaves the index alone.\n+func TestReadOnlyIndexFindsTheIndexFromASubdirectory(t *testing.T) {\n+\ttop, root := staleRepo(t, \"proj\")\n+\tbefore, err := os.ReadFile(filepath.Join(top, \".git\", \"index\"))\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif _, err := RawGitDiffReadOnly(root, \"-C\", root, \"diff\", \"--name-only\", \"--\"); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif after, _ := os.ReadFile(filepath.Join(top, \".git\", \"index\")); !bytes.Equal(before, after) {\n+\t\tt.Fatal(\"a read from a subdirectory rewrote .git/index\")\n+\t}\n+}\n+\n+// Spec pose-validate-read-only-index-followups R4: the private copy the\n+// memory file falls back to answers as the plain diff and leaves the index.\n+func TestThePrivateIndexCopyLeavesTheIndexAlone(t *testing.T) {\n+\ttop, _ := staleRepo(t, \"\")\n+\tindex := filepath.Join(top, \".git\", \"index\")\n+\tbefore, err := os.ReadFile(index)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tinfo, err := os.Stat(index)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tcmd := RawGit(\"-C\", top, \"diff\", \"--name-only\", \"--\")\n+\tdone, err := privateIndexCopy(cmd, before, info.ModTime())\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tout, err := cmd.Output()\n+\tdone()\n+\tif err != nil || len(out) != 0 {\n+\t\tt.Fatalf(\"the copy answered %q %v\", out, err)\n+\t}\n+\tif after, _ := os.ReadFile(index); !bytes.Equal(before, after) {\n+\t\tt.Fatal(\"the private copy read rewrote .git/index\")\n+\t}\n+}\n+\n+// Spec pose-validate-read-only-index-followups R6: unmerged entries, a\n+// two-revision range and a dirty submodule answer as the plain diff, and\n+// concurrent review history reads never change the index.\n+func TestReadOnlyIndexDiffCoversConflictsRangesAndDirtySubmodules(t *testing.T) {\n+\troot := t.TempDir()\n+\trun := func(dir string, args ...string) string {\n+\t\tt.Helper()\n+\t\tout, err := exec.Command(\"git\", append([]string{\"-C\", dir, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"-c\", \"protocol.file.allow=always\"}, args...)...).CombinedOutput()\n+\t\tif err != nil && !strings.Contains(strings.Join(args, \" \"), \"merge\") {\n+\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n+\t\t}\n+\t\treturn string(out)\n+\t}\n+\tsub := t.TempDir()\n+\trun(sub, \"init\", \"-q\")\n+\tif err := os.WriteFile(filepath.Join(sub, \"s.txt\"), []byte(\"1\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\trun(sub, \"add\", \"s.txt\")\n+\trun(sub, \"commit\", \"-q\", \"-m\", \"s\")\n+\trun(root, \"init\", \"-q\", \"-b\", \"main\")\n+\tif err := os.WriteFile(filepath.Join(root, \"c.txt\"), []byte(\"base\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\trun(root, \"add\", \"c.txt\")\n+\trun(root, \"submodule\", \"add\", \"-q\", sub, \"mod\")\n+\trun(root, \"commit\", \"-q\", \"-m\", \"base\")\n+\tfirst := strings.TrimSpace(run(root, \"rev-parse\", \"HEAD\"))\n+\trun(root, \"checkout\", \"-q\", \"-b\", \"other\")\n+\tif err := os.WriteFile(filepath.Join(root, \"c.txt\"), []byte(\"other\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\trun(root, \"commit\", \"-q\", \"-am\", \"other\")\n+\trun(root, \"checkout\", \"-q\", \"main\")\n+\tif err := os.WriteFile(filepath.Join(root, \"c.txt\"), []byte(\"main\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\trun(root, \"commit\", \"-q\", \"-am\", \"main\")\n+\trun(root, \"merge\", \"-q\", \"other\")\n+\tif err := os.WriteFile(filepath.Join(root, \"mod\", \"s.txt\"), []byte(\"dirty\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tsecond := strings.TrimSpace(run(root, \"rev-parse\", \"HEAD\"))\n+\t// A tracked file whose stat cache is made stale before every read, so a\n+\t// read that refreshes the index would write it (review round 1, N5).\n+\tstale := filepath.Join(root, \"c.txt\")\n+\tstaleAgain := func(i int) {\n+\t\tlater := time.Now().Add(time.Duration(2+i) * time.Second)\n+\t\tif err := os.Chtimes(stale, later, later); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tlater = later.Add(time.Second)\n+\t\tif err := os.Chtimes(filepath.Join(root, \".gitmodules\"), later, later); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tfor i, args := range [][]string{\n+\t\t{\"-C\", root, \"diff\", \"--name-status\", \"--no-renames\", \"--ignore-submodules=none\", \"HEAD\", \"--\"},\n+\t\t{\"-C\", root, \"diff\", \"--name-only\", \"-z\", \"--no-renames\", first, second, \"--\"},\n+\t\t{\"-C\", root, \"diff\", \"--name-only\", \"--ignore-submodules=none\", first, \"--\"},\n+\t} {\n+\t\tstaleAgain(i)\n+\t\tbefore, _ := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n+\t\tgot, err := RawGitDiffReadOnly(root, args...)\n+\t\tif err != nil {\n+\t\t\tt.Fatalf(\"%v: %v\", args, err)\n+\t\t}\n+\t\tif after, _ := os.ReadFile(filepath.Join(root, \".git\", \"index\")); !bytes.Equal(before, after) {\n+\t\t\tt.Fatalf(\"%v rewrote .git/index\", args)\n+\t\t}\n+\t\twant, _ := RawGit(args...).Output()\n+\t\tif !bytes.Equal(got, want) {\n+\t\t\tt.Fatalf(\"%v answered %q, the plain diff %q\", args, got, want)\n+\t\t}\n+\t}\n+\tstaleAgain(9)\n+\tbefore, _ := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n+\terrs := make(chan error, 8)\n+\tfor i := 0; i < 8; i++ {\n+\t\tgo func() {\n+\t\t\t_, err := reviewHistoryGit(root, \"diff\", \"HEAD\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\")\n+\t\t\terrs <- err\n+\t\t}()\n+\t}\n+\tfor i := 0; i < 8; i++ {\n+\t\tif err := <-errs; err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tif after, _ := os.ReadFile(filepath.Join(root, \".git\", \"index\")); !bytes.Equal(before, after) {\n+\t\tt.Fatal(\"concurrent review history reads changed .git/index\")\n+\t}\n+}\n+\n+// Review round 2, N13–N16: Git's message is kept on one bounded line, an\n+// index refusal is told from a revision named after the index, a lookup\n+// outside a repository is not an index failure, and the lookup honours the\n+// caller's context.\n+func TestGitReadErrorsNameTheirCause(t *testing.T) {\n+\t// A warning first does not hide the cause; all of it is one line.\n+\terr := GitReadError(\"git diff\", errors.New(\"exit status 128\"), []byte(\"warning: Found errors in 'diff.dirstat' config variable:\\nfatal: index file corrupt\\n\"))\n+\tif !strings.Contains(err.Error(), \"fatal: index file corrupt\") || strings.Contains(err.Error(), \"\\n\") {\n+\t\tt.Fatalf(\"the cause behind a warning: %q\", err)\n+\t}\n+\t// A long warning does not push the fatal line past the bound.\n+\terr = GitReadError(\"git diff\", errors.New(\"exit status 128\"), []byte(\"warning: \"+strings.Repeat(\"w\", 2000)+\"\\nfatal: index file corrupt\\n\"))\n+\tif !strings.Contains(err.Error(), \"fatal: index file corrupt\") {\n+\t\tt.Fatalf(\"the fatal line behind a long warning: %.120q\", err)\n+\t}\n+\t// Bounded, and never classified from its words.\n+\terr = GitReadError(\"git diff\", errors.New(\"exit status 128\"), []byte(\"fatal: index file smaller than expected \"+strings.Repeat(\"x\", 2000)))\n+\tif len(err.Error()) > 700 || errors.Is(err, ErrIndexUnreadable) {\n+\t\tt.Fatalf(\"a long message: %d bytes, index-marked %v\", len(err.Error()), errors.Is(err, ErrIndexUnreadable))\n+\t}\n+\toutside := t.TempDir()\n+\tt.Setenv(\"GIT_CEILING_DIRECTORIES\", filepath.Dir(outside))\n+\tif _, err := ReadOnlyIndex(RawGit(\"-C\", outside, \"diff\"), outside); err == nil || errors.Is(err, ErrIndexUnreadable) || !strings.Contains(err.Error(), \"not a git repository\") {\n+\t\tt.Fatalf(\"a lookup outside a repository: %v\", err)\n+\t}\n+\ttop, _ := staleRepo(t, \"\")\n+\tctx, cancel := context.WithCancel(context.Background())\n+\tcancel()\n+\tif _, err := ReadOnlyIndexContext(ctx, RawGit(\"-C\", top, \"diff\"), top); err == nil {\n+\t\tt.Fatal(\"the lookup ignored a cancelled context\")\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_attempt_ledger.go b/pose-mcp/internal/pose/review_attempt_ledger.go\nindex 15a1dae2..0e4eb91c 100644\n--- a/pose-mcp/internal/pose/review_attempt_ledger.go\n+++ b/pose-mcp/internal/pose/review_attempt_ledger.go\n@@ -533,7 +533,7 @@ func reviewHistoryGit(root string, args ...string) ([]byte, error) {\n \tif len(args) > 0 && args[0] == \"diff\" {\n \t\t// A diff against the work tree reads the index without writing it\n \t\t// (spec pose-validate-reads-leave-the-index-alone R1).\n-\t\tdone, err := ReadOnlyIndex(cmd, root)\n+\t\tdone, err := ReadOnlyIndexContext(ctx, cmd, root)\n \t\tdefer done()\n \t\tif err != nil {\n \t\t\treturn nil, fmt.Errorf(\"review history Git observation unavailable: %w\", err)\n","numLines":849,"startLine":1,"totalLines":849}},"tool_result_meta":[{"id":"toolu_01H5eTXeqDkFrCyrn282v2UT","permission_decision":{"decision":"accept","source":"config","reason_type":"other"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChSrxvQMe7n9sk15iHxKe","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01To8kuxWFC6hK7vZAE92pgj","name":"Read","input":{"file_path":"/var/tmp/pose-work-go/pose-review-run-0c30daf86e/worktree/.pose/specs/2026-11-26-pose-validate-read-only-index-followups.md"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3228,"cache_read_input_tokens":26048,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3228},"output_tokens":17,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"6f8d88f7-ad83-4173-8cf6-5470d4525e53","timestamp":"2026-11-27T05:14:26.393Z","request_id":"req_011ChSrxvDCTg85kbkAX4aHD","wire_tool_inputs":{"toolu_01To8kuxWFC6hK7vZAE92pgj":{"file_path":"/var/tmp/pose-work-go/pose-review-run-0c30daf86e/worktree/.pose/specs/2026-11-26-pose-validate-read-only-index-followups.md"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01To8kuxWFC6hK7vZAE92pgj","type":"tool_result","content":"1\t---\n2\tslug: pose-validate-read-only-index-followups\n3\tstatus: in-progress        # draft | in-progress | done | superseded | abandoned; blocked = operational wait, not terminal\n4\tcreated_at: 2026-11-26\n5\tcompleted_at:        # stamped on the transition to status: done\n6\tsupersedes:          # slug of the superseded spec (when applicable)\n7\tdepends_on:          # prerequisites, inline list: other-spec, milestone:<roadmap>/<id>, roadmap:<slug>\n8\tremediates:          # optional explicit links: spec:slug@defect-fix, finding:rva-<16hex>/F1@revert (never inferred from depends_on)\n9\tpriority: 1\n10\tcomponents: pose-mcp\n11\ttask_type: bugfix\n12\tsurface: standard\n13\tdelivers: capability:validate-read-only-index-followups\n14\t---\n15\t\n16\t# Spec: pose-validate-read-only-index-followups\n17\t\n18\t## 1. Intent\n19\t\n20\t### Goal\n21\tClose the follow-ups left by `pose-validate-reads-leave-the-index-alone`: the read-only index read must not fail where the plain diff succeeds, must fail loudly where it cannot protect the index, and its tests must cover the states the reviews probed.\n22\t\n23\t### Business value\n24\tThe spec closed on 2026-11-26 (approval rrn of its round 5) with follow-ups from rounds 2 to 5. One is a regression its own fix introduced (round 5, N22): the same-file check refuses an index another process replaced atomically, 2–5 reads in 2000 under concurrent `git status` writers, which fails scope selection and the review history read and makes the ready-transition check drop its diff.\n25\t\n26\t### Constraints\n27\tEach item keeps the behaviour its origin spec delivered; a fix that changes an answer states it as a decision.\n28\t\n29\t### Non-goals\n30\tReopening the decisions of the origin spec.\n31\t\n32\t## 2. Requirements\n33\t\n34\t### Functional\n35\t- R1: The index read shall not fail when another process replaces the index atomically between its checks; a FIFO or device swapped in shall still not block (round 5, N22): open without blocking and judge the opened file.\n36\t- R2: A failed index read shall be reported by the ready-transition check, scope selection and `report --since` with its cause, never dropped or labelled `revision unknown?`; the index lookup shall run within the caller's deadline (rounds 2 N13, 3 N14, 4 N18, 5 N23).\n37\t- R3: The index lookup shall not depend on `rev-parse --path-format` silently: on a Git that does not support it the read shall fail or use a supported lookup, never run the plain diff unprotected (round 5, N26).\n38\t- R4: On Linux, a failing memory file or timestamp call shall fall back to the private copy, as the comment states, or the comment shall say it fails (round 5, N27).\n39\t- R5: A split-index read touches the modification time of `.git/sharedindex.<hash>`; that shall be declared as an accepted limit with what was measured, since the engine cannot prevent it (D1).\n40\t- R6: The equivalence test shall add unmerged, two-revision range and dirty-submodule cases, and the CLI concurrency test shall run the review history reader (rounds 1 N9, 3 N16, 4 N20, 5 N25).\n41\t\n42\t### Non-functional\n43\tExisting behaviour outside the stated requirements is unchanged.\n44\t\n45\t### Security\n46\tNo new input crosses a trust boundary without the existing confinement.\n47\t\n48\t### Compatibility\n49\tRecords and indexes written by earlier engines keep their meaning.\n50\t\n51\t## 3. Technical Plan\n52\t\n53\t### Affected areas\n54\t`pose-mcp`: `git_worktree_reads*.go`, the ready-transition read in `check.go`, `validate_scope.go`, `report.go` and their tests.\n55\t\n56\t### Artifacts\n57\t- created: .pose/specs/2026-11-26-pose-validate-read-only-index-followups.md\n58\t- modified: pose-mcp/internal/pose/git_worktree_reads.go\n59\t- modified: pose-mcp/internal/pose/git_worktree_reads_linux.go\n60\t- modified: pose-mcp/internal/pose/git_worktree_reads_other.go\n61\t- created: pose-mcp/internal/pose/git_index_open_unix.go\n62\t- created: pose-mcp/internal/pose/git_index_open_other.go\n63\t- modified: pose-mcp/internal/pose/git_worktree_reads_test.go\n64\t- created: pose-mcp/internal/pose/git_worktree_reads_linux_test.go\n65\t- modified: pose-mcp/internal/pose/review_attempt_ledger.go\n66\t- modified: pose-mcp/internal/cli/check.go\n67\t- modified: pose-mcp/internal/cli/validate_scope.go\n68\t- modified: pose-mcp/internal/cli/report.go\n69\t- modified: pose-mcp/internal/cli/report_changed_files_test.go\n70\t- modified: pose-mcp/internal/cli/validate_reads_index_test.go\n71\t\n72\t### Delivery targets\n73\t- capability:validate-read-only-index-followups module:pose-mcp profile:composed-capability entrypoint:pose-mcp/internal/cli/validate.go\n74\t\n75\t### Accepted limits\n76\t- L1: In a split-index repository a read touches the modification time of `.git/sharedindex.<hash>`. Accepted because Git freshens the shared index on every read (measured on 2026-11-26: `git status` and `git ls-files` with `GIT_OPTIONAL_LOCKS=0` both move it), so no engine read can avoid it, and the file's bytes do not change.\n77\t\n78\t### API/contract changes\n79\t`reportChangedFiles` returns its error; `pose report` prints a warning and writes the report without the list. `pose check` reports a ready-transition read it could not make. `ErrIndexUnreadable` marks index failures.\n80\t\n81\t### Data/storage changes\n82\tNone.\n83\t\n84\t### Technical risks\n85\tOpening the index with `O_NONBLOCK` returns at once on a FIFO, which is then refused as not regular; on a regular file the flag has no effect.\n86\t\n87\t## 4. Tasks\n88\t\n89\t### Planning\n90\t- [x] Confirm each requirement against the current engine before starting.\n91\t\n92\t### Implementation\n93\t- [x] Implement each requirement with a test that fails before it.\n94\t\n95\t### Validation\n96\t- [ ] `pose validate --carry` and `pose check --strict`.\n97\t\n98\t## 5. Decisions\n99\t\n100\t### Decision D1\n101\t- Basis: R5\n102\tThe split-index touch is Git's own: measured with `core.splitIndex=true`, a plain `git status` and even `git ls-files` with `GIT_OPTIONAL_LOCKS=0` move the shared index's modification time, because Git freshens it whenever it reads it. The engine cannot keep any read from doing so, so R5 declares it as L1 instead of changing code.\n103\t\n104\t### Decision D2\n105\t- Basis: R1\n106\tThe index is judged on the file actually opened, opened with `O_NONBLOCK` where FIFOs exist, instead of a stat before the open: a stat-then-open pair refuses an index replaced atomically in between (round 5, N22), and opening without blocking keeps a FIFO from hanging the read (round 4, N21).\n107\t\n108\t### Decision D3\n109\t- Basis: R2\n110\tThe index lookup runs under the caller's context where the caller has one (`ReadOnlyIndexContext`, used by the review history reader within its 30 s), and under a 30 s bound of its own otherwise. A failure is never classified from Git's words, which two rounds showed incomplete in both directions (a revision named after the index, index refusals worded otherwise, a warning printed first): scope selection runs its diff first, so every revision the diff accepts (a tree, `X^-`, a range) keeps its answer, and only after a failure resolves each revision with `rev-parse --verify --quiet`: one Git cannot find (exit 1, nothing said) is \"revision unknown?\", a rev-parse failing otherwise (no repository, a broken config, dubious ownership) is reported with its own words, and when all resolve the diff's failure is. Git's standard error is kept on one line within 600 bytes, its `fatal:`/`error:` lines first, read with `LC_ALL=C`. `ErrIndexUnreadable` marks only the read-only index's own failures. The report stays silent only where Git cannot open the repository at all, and states any other failure on one line with every absolute path replaced by `<path>`.\n111\t\n112\t## 6. Validation\n113\t\n114\t### Strategy\n115\tEach requirement gets a regression test shown failing before its code.\n116\t\n117\t### Deterministic checks\n118\t\n119\t#### Test\n120\t- Command: `go test ./...` (in `pose-mcp`), then `pose validate --carry`.\n121\t\n122\t### Execution log\n123\t- 2026-11-26: R1 opens without blocking and judges the opened file; R2 reports a failed index read in `check`, names it in scope selection (`ErrIndexUnreadable`) and warns in `report`; R3 locates the index with `--git-path` relative to the root, within a 30 s deadline; R4 falls back to the private copy when the memory file or its time cannot be set. Each has a test that fails with its guard mutated out: `TestReadOnlyIndexToleratesAnAtomicallyReplacedIndex`, `TestAFailedIndexReadIsReported`, `TestReadOnlyIndexFindsTheIndexFromASubdirectory`, `TestThePrivateIndexCopyLeavesTheIndexAlone`. R6 adds `TestReadOnlyIndexDiffCoversConflictsRangesAndDirtySubmodules`, which passes on the existing reader. R5 is L1 (D1).\n124\t- 2026-11-26: review round 1 (rrn-4262ae59adfc1641) requested changes. N1–N2: a corrupt index, which Git itself refuses, is now reported with Git's own message and marked as an index failure in check, scope selection and report (`TestACorruptIndexIsReportedWithItsCause`; fails with the classification or check's capture removed). N3: D3. N4: the memfd and timestamp calls are replaceable, and `TestReadOnlyIndexFallsBackWithoutAMemoryFile` fails with either fallback removed. N5: the R6 test makes the stat cache stale before every read, so it fails with the protection or the ledger's use of it removed, and the CLI concurrency test runs `ReviewRunHistoryFindings`. N8: failures handing the index to Git are index failures, and a failing memfd write falls back too. N9: the report states that the list could not be read, and a plain `pose report` outside a repository stays silent. N10: the check's findings are localised. N6, N7 and N11 are follow-ups.\n125\t- 2026-11-26: review round 2 (rrn-ef7133259b2c911e) requested changes. N12: the plain `report` listing runs in English and is silent only outside a repository (`reportChangedFilesNoted`); N13: the index-failure test matches Git's index refusals, not the word `index`, and the scope message no longer repeats itself; N14: a failed lookup keeps Git's cause and is not an index failure; N15: Git's message is kept on one bounded line and the report states it on one line; N16: `TestIndexFailuresAreNamedInAnyLocale`, `TestGitReadErrorsNameTheirCause` and `TestAFailedIndexHandOverIsAnIndexFailure` fail with each of those guards, the English locale, the context and the hand-over mark mutated out. A failing memfd write still has no test of its own (it falls back as a failing memfd does).\n126\t- 2026-11-26: review round 3 (rrn-bd7106fcc6ae8449) requested changes: the text classification missed index refusals and lost the cause behind a warning. Withdrawn for D3: `TestScopeSelectionTellsRevisionsFromIndexFailures` (a corrupt index behind a `diff.dirstat` warning is not an unknown revision; an unknown revision in a range is) fails with the resolution or the label mutated; `TestGitReadErrorsNameTheirCause` fails with the first-line cut restored; `TestIndexFailuresAreNamedInAnyLocale` fails with the absolute path kept. N19–N21 are follow-ups or answered by D3.\n127\t- 2026-11-26: review round 4 (rrn-f0476b1f18d70fb9) requested changes: resolving revisions before the diff refused trees and `HEAD^-`, and a repository failure lost Git's cause. Now the diff runs first and revisions are resolved only after a failure (D3); `TestScopeSelectionKeepsWhatTheDiffAccepts` (a tree, `HEAD^-`, `A..B`, `A...B`, a broken config, the report's path redaction keeping `feature/index-rework`) and the healthy-range case of `TestScopeSelectionTellsRevisionsFromIndexFailures` fail with the exit-code rule, the range split or the path rule mutated; `TestGitReadErrorsNameTheirCause` fails with the fatal lines no longer first (N25).\n128\t\n129\t### Results summary\n130\tThe full `pose-mcp` suite passes; the canonical result is refreshed with `pose validate --carry`.\n131\t\n132\t### Requirement trace\n133\t- R1 [satisfied] test:TestReadOnlyIndexToleratesAnAtomicallyReplacedIndex, test:TestReadOnlyIndexRefusesAFIFOIndex\n134\t- R2 [satisfied] test:TestScopeSelectionKeepsWhatTheDiffAccepts, test:TestScopeSelectionTellsRevisionsFromIndexFailures, test:TestAFailedIndexReadIsReported, test:TestACorruptIndexIsReportedWithItsCause, test:TestIndexFailuresAreNamedInAnyLocale, test:TestGitReadErrorsNameTheirCause, test:TestAFailedIndexHandOverIsAnIndexFailure\n135\t- R3 [satisfied] test:TestReadOnlyIndexFindsTheIndexFromASubdirectory\n136\t- R4 [satisfied] test:TestThePrivateIndexCopyLeavesTheIndexAlone, test:TestReadOnlyIndexFallsBackWithoutAMemoryFile\n137\t- R5 [satisfied] (accepted limit L1, decision D1)\n138\t- R6 [satisfied] test:TestReadOnlyIndexDiffCoversConflictsRangesAndDirtySubmodules\n139\t\n140\t### Known gaps\n141\tNone.\n142\t\n143\t## 7. Final Report\n144\t\n145\t### Delivered scope\n146\tThe read-only index read tolerates an atomically replaced index, reports its failures with their cause, works without `--path-format`, falls back to a private copy, and its tests cover conflicts, ranges and dirty submodules.\n147\t\n148\t### Files and modules changed\n149\t`pose-mcp` read-only index reads and their callers in check, validate scope and report.\n150\t\n151\t### Validation executed\n152\t`go test ./...` in `pose-mcp`; `pose check --strict`; `pose validate --carry --json-out .pose/results/delivery-validation.json`.\n153\t\n154\t### Residual risks\n155\tL1 above.\n156\t\n157\t### Follow-ups\n158\tOrigin: `pose-validate-reads-leave-the-index-alone` (done 2026-11-26).\n159\t- [open] Test the index lookup against a Git that echoes an unknown `--path-format` (a stand-in executable), so restoring the flag fails a test (review round 1, N6). (owner:@pose-maintainers crit:low review:2026-12-26)\n160\t- [open] Test the `pose report` warning for an unreadable change list end to end (review round 1, N7). (owner:@pose-maintainers crit:low review:2026-12-26)\n161\t- [open] Add failing tests for the guards round 3 listed (the ledger passing its context, `GitEnglish` on the check, hand-over and lookup, the report's stderr warning, the memfd write fallback), and a locale test that does not depend on Git's pt_BR translations being installed (review rounds 2 N16, 3 N21). (owner:@pose-maintainers crit:low review:2026-12-26)\n162\t- [open] List the changed specs of a POSE root below the repository top: `git diff --name-only` names top-relative paths that the `.pose/specs/` filter drops, so their ready transitions go unchecked (review round 1, N11; pre-existing). (owner:@pose-maintainers crit:medium review:2026-12-26)\n163\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"ba3eacff-6257-4bd4-b8c8-331e2c9c196c","timestamp":"2026-11-27T05:14:26.400Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-0c30daf86e/worktree/.pose/specs/2026-11-26-pose-validate-read-only-index-followups.md","content":"---\nslug: pose-validate-read-only-index-followups\nstatus: in-progress        # draft | in-progress | done | superseded | abandoned; blocked = operational wait, not terminal\ncreated_at: 2026-11-26\ncompleted_at:        # stamped on the transition to status: done\nsupersedes:          # slug of the superseded spec (when applicable)\ndepends_on:          # prerequisites, inline list: other-spec, milestone:<roadmap>/<id>, roadmap:<slug>\nremediates:          # optional explicit links: spec:slug@defect-fix, finding:rva-<16hex>/F1@revert (never inferred from depends_on)\npriority: 1\ncomponents: pose-mcp\ntask_type: bugfix\nsurface: standard\ndelivers: capability:validate-read-only-index-followups\n---\n\n# Spec: pose-validate-read-only-index-followups\n\n## 1. Intent\n\n### Goal\nClose the follow-ups left by `pose-validate-reads-leave-the-index-alone`: the read-only index read must not fail where the plain diff succeeds, must fail loudly where it cannot protect the index, and its tests must cover the states the reviews probed.\n\n### Business value\nThe spec closed on 2026-11-26 (approval rrn of its round 5) with follow-ups from rounds 2 to 5. One is a regression its own fix introduced (round 5, N22): the same-file check refuses an index another process replaced atomically, 2–5 reads in 2000 under concurrent `git status` writers, which fails scope selection and the review history read and makes the ready-transition check drop its diff.\n\n### Constraints\nEach item keeps the behaviour its origin spec delivered; a fix that changes an answer states it as a decision.\n\n### Non-goals\nReopening the decisions of the origin spec.\n\n## 2. Requirements\n\n### Functional\n- R1: The index read shall not fail when another process replaces the index atomically between its checks; a FIFO or device swapped in shall still not block (round 5, N22): open without blocking and judge the opened file.\n- R2: A failed index read shall be reported by the ready-transition check, scope selection and `report --since` with its cause, never dropped or labelled `revision unknown?`; the index lookup shall run within the caller's deadline (rounds 2 N13, 3 N14, 4 N18, 5 N23).\n- R3: The index lookup shall not depend on `rev-parse --path-format` silently: on a Git that does not support it the read shall fail or use a supported lookup, never run the plain diff unprotected (round 5, N26).\n- R4: On Linux, a failing memory file or timestamp call shall fall back to the private copy, as the comment states, or the comment shall say it fails (round 5, N27).\n- R5: A split-index read touches the modification time of `.git/sharedindex.<hash>`; that shall be declared as an accepted limit with what was measured, since the engine cannot prevent it (D1).\n- R6: The equivalence test shall add unmerged, two-revision range and dirty-submodule cases, and the CLI concurrency test shall run the review history reader (rounds 1 N9, 3 N16, 4 N20, 5 N25).\n\n### Non-functional\nExisting behaviour outside the stated requirements is unchanged.\n\n### Security\nNo new input crosses a trust boundary without the existing confinement.\n\n### Compatibility\nRecords and indexes written by earlier engines keep their meaning.\n\n## 3. Technical Plan\n\n### Affected areas\n`pose-mcp`: `git_worktree_reads*.go`, the ready-transition read in `check.go`, `validate_scope.go`, `report.go` and their tests.\n\n### Artifacts\n- created: .pose/specs/2026-11-26-pose-validate-read-only-index-followups.md\n- modified: pose-mcp/internal/pose/git_worktree_reads.go\n- modified: pose-mcp/internal/pose/git_worktree_reads_linux.go\n- modified: pose-mcp/internal/pose/git_worktree_reads_other.go\n- created: pose-mcp/internal/pose/git_index_open_unix.go\n- created: pose-mcp/internal/pose/git_index_open_other.go\n- modified: pose-mcp/internal/pose/git_worktree_reads_test.go\n- created: pose-mcp/internal/pose/git_worktree_reads_linux_test.go\n- modified: pose-mcp/internal/pose/review_attempt_ledger.go\n- modified: pose-mcp/internal/cli/check.go\n- modified: pose-mcp/internal/cli/validate_scope.go\n- modified: pose-mcp/internal/cli/report.go\n- modified: pose-mcp/internal/cli/report_changed_files_test.go\n- modified: pose-mcp/internal/cli/validate_reads_index_test.go\n\n### Delivery targets\n- capability:validate-read-only-index-followups module:pose-mcp profile:composed-capability entrypoint:pose-mcp/internal/cli/validate.go\n\n### Accepted limits\n- L1: In a split-index repository a read touches the modification time of `.git/sharedindex.<hash>`. Accepted because Git freshens the shared index on every read (measured on 2026-11-26: `git status` and `git ls-files` with `GIT_OPTIONAL_LOCKS=0` both move it), so no engine read can avoid it, and the file's bytes do not change.\n\n### API/contract changes\n`reportChangedFiles` returns its error; `pose report` prints a warning and writes the report without the list. `pose check` reports a ready-transition read it could not make. `ErrIndexUnreadable` marks index failures.\n\n### Data/storage changes\nNone.\n\n### Technical risks\nOpening the index with `O_NONBLOCK` returns at once on a FIFO, which is then refused as not regular; on a regular file the flag has no effect.\n\n## 4. Tasks\n\n### Planning\n- [x] Confirm each requirement against the current engine before starting.\n\n### Implementation\n- [x] Implement each requirement with a test that fails before it.\n\n### Validation\n- [ ] `pose validate --carry` and `pose check --strict`.\n\n## 5. Decisions\n\n### Decision D1\n- Basis: R5\nThe split-index touch is Git's own: measured with `core.splitIndex=true`, a plain `git status` and even `git ls-files` with `GIT_OPTIONAL_LOCKS=0` move the shared index's modification time, because Git freshens it whenever it reads it. The engine cannot keep any read from doing so, so R5 declares it as L1 instead of changing code.\n\n### Decision D2\n- Basis: R1\nThe index is judged on the file actually opened, opened with `O_NONBLOCK` where FIFOs exist, instead of a stat before the open: a stat-then-open pair refuses an index replaced atomically in between (round 5, N22), and opening without blocking keeps a FIFO from hanging the read (round 4, N21).\n\n### Decision D3\n- Basis: R2\nThe index lookup runs under the caller's context where the caller has one (`ReadOnlyIndexContext`, used by the review history reader within its 30 s), and under a 30 s bound of its own otherwise. A failure is never classified from Git's words, which two rounds showed incomplete in both directions (a revision named after the index, index refusals worded otherwise, a warning printed first): scope selection runs its diff first, so every revision the diff accepts (a tree, `X^-`, a range) keeps its answer, and only after a failure resolves each revision with `rev-parse --verify --quiet`: one Git cannot find (exit 1, nothing said) is \"revision unknown?\", a rev-parse failing otherwise (no repository, a broken config, dubious ownership) is reported with its own words, and when all resolve the diff's failure is. Git's standard error is kept on one line within 600 bytes, its `fatal:`/`error:` lines first, read with `LC_ALL=C`. `ErrIndexUnreadable` marks only the read-only index's own failures. The report stays silent only where Git cannot open the repository at all, and states any other failure on one line with every absolute path replaced by `<path>`.\n\n## 6. Validation\n\n### Strategy\nEach requirement gets a regression test shown failing before its code.\n\n### Deterministic checks\n\n#### Test\n- Command: `go test ./...` (in `pose-mcp`), then `pose validate --carry`.\n\n### Execution log\n- 2026-11-26: R1 opens without blocking and judges the opened file; R2 reports a failed index read in `check`, names it in scope selection (`ErrIndexUnreadable`) and warns in `report`; R3 locates the index with `--git-path` relative to the root, within a 30 s deadline; R4 falls back to the private copy when the memory file or its time cannot be set. Each has a test that fails with its guard mutated out: `TestReadOnlyIndexToleratesAnAtomicallyReplacedIndex`, `TestAFailedIndexReadIsReported`, `TestReadOnlyIndexFindsTheIndexFromASubdirectory`, `TestThePrivateIndexCopyLeavesTheIndexAlone`. R6 adds `TestReadOnlyIndexDiffCoversConflictsRangesAndDirtySubmodules`, which passes on the existing reader. R5 is L1 (D1).\n- 2026-11-26: review round 1 (rrn-4262ae59adfc1641) requested changes. N1–N2: a corrupt index, which Git itself refuses, is now reported with Git's own message and marked as an index failure in check, scope selection and report (`TestACorruptIndexIsReportedWithItsCause`; fails with the classification or check's capture removed). N3: D3. N4: the memfd and timestamp calls are replaceable, and `TestReadOnlyIndexFallsBackWithoutAMemoryFile` fails with either fallback removed. N5: the R6 test makes the stat cache stale before every read, so it fails with the protection or the ledger's use of it removed, and the CLI concurrency test runs `ReviewRunHistoryFindings`. N8: failures handing the index to Git are index failures, and a failing memfd write falls back too. N9: the report states that the list could not be read, and a plain `pose report` outside a repository stays silent. N10: the check's findings are localised. N6, N7 and N11 are follow-ups.\n- 2026-11-26: review round 2 (rrn-ef7133259b2c911e) requested changes. N12: the plain `report` listing runs in English and is silent only outside a repository (`reportChangedFilesNoted`); N13: the index-failure test matches Git's index refusals, not the word `index`, and the scope message no longer repeats itself; N14: a failed lookup keeps Git's cause and is not an index failure; N15: Git's message is kept on one bounded line and the report states it on one line; N16: `TestIndexFailuresAreNamedInAnyLocale`, `TestGitReadErrorsNameTheirCause` and `TestAFailedIndexHandOverIsAnIndexFailure` fail with each of those guards, the English locale, the context and the hand-over mark mutated out. A failing memfd write still has no test of its own (it falls back as a failing memfd does).\n- 2026-11-26: review round 3 (rrn-bd7106fcc6ae8449) requested changes: the text classification missed index refusals and lost the cause behind a warning. Withdrawn for D3: `TestScopeSelectionTellsRevisionsFromIndexFailures` (a corrupt index behind a `diff.dirstat` warning is not an unknown revision; an unknown revision in a range is) fails with the resolution or the label mutated; `TestGitReadErrorsNameTheirCause` fails with the first-line cut restored; `TestIndexFailuresAreNamedInAnyLocale` fails with the absolute path kept. N19–N21 are follow-ups or answered by D3.\n- 2026-11-26: review round 4 (rrn-f0476b1f18d70fb9) requested changes: resolving revisions before the diff refused trees and `HEAD^-`, and a repository failure lost Git's cause. Now the diff runs first and revisions are resolved only after a failure (D3); `TestScopeSelectionKeepsWhatTheDiffAccepts` (a tree, `HEAD^-`, `A..B`, `A...B`, a broken config, the report's path redaction keeping `feature/index-rework`) and the healthy-range case of `TestScopeSelectionTellsRevisionsFromIndexFailures` fail with the exit-code rule, the range split or the path rule mutated; `TestGitReadErrorsNameTheirCause` fails with the fatal lines no longer first (N25).\n\n### Results summary\nThe full `pose-mcp` suite passes; the canonical result is refreshed with `pose validate --carry`.\n\n### Requirement trace\n- R1 [satisfied] test:TestReadOnlyIndexToleratesAnAtomicallyReplacedIndex, test:TestReadOnlyIndexRefusesAFIFOIndex\n- R2 [satisfied] test:TestScopeSelectionKeepsWhatTheDiffAccepts, test:TestScopeSelectionTellsRevisionsFromIndexFailures, test:TestAFailedIndexReadIsReported, test:TestACorruptIndexIsReportedWithItsCause, test:TestIndexFailuresAreNamedInAnyLocale, test:TestGitReadErrorsNameTheirCause, test:TestAFailedIndexHandOverIsAnIndexFailure\n- R3 [satisfied] test:TestReadOnlyIndexFindsTheIndexFromASubdirectory\n- R4 [satisfied] test:TestThePrivateIndexCopyLeavesTheIndexAlone, test:TestReadOnlyIndexFallsBackWithoutAMemoryFile\n- R5 [satisfied] (accepted limit L1, decision D1)\n- R6 [satisfied] test:TestReadOnlyIndexDiffCoversConflictsRangesAndDirtySubmodules\n\n### Known gaps\nNone.\n\n## 7. Final Report\n\n### Delivered scope\nThe read-only index read tolerates an atomically replaced index, reports its failures with their cause, works without `--path-format`, falls back to a private copy, and its tests cover conflicts, ranges and dirty submodules.\n\n### Files and modules changed\n`pose-mcp` read-only index reads and their callers in check, validate scope and report.\n\n### Validation executed\n`go test ./...` in `pose-mcp`; `pose check --strict`; `pose validate --carry --json-out .pose/results/delivery-validation.json`.\n\n### Residual risks\nL1 above.\n\n### Follow-ups\nOrigin: `pose-validate-reads-leave-the-index-alone` (done 2026-11-26).\n- [open] Test the index lookup against a Git that echoes an unknown `--path-format` (a stand-in executable), so restoring the flag fails a test (review round 1, N6). (owner:@pose-maintainers crit:low review:2026-12-26)\n- [open] Test the `pose report` warning for an unreadable change list end to end (review round 1, N7). (owner:@pose-maintainers crit:low review:2026-12-26)\n- [open] Add failing tests for the guards round 3 listed (the ledger passing its context, `GitEnglish` on the check, hand-over and lookup, the report's stderr warning, the memfd write fallback), and a locale test that does not depend on Git's pt_BR translations being installed (review rounds 2 N16, 3 N21). (owner:@pose-maintainers crit:low review:2026-12-26)\n- [open] List the changed specs of a POSE root below the repository top: `git diff --name-only` names top-relative paths that the `.pose/specs/` filter drops, so their ready transitions go unchecked (review round 1, N11; pre-existing). (owner:@pose-maintainers crit:medium review:2026-12-26)\n","numLines":163,"startLine":1,"totalLines":163}},"tool_result_meta":[{"id":"toolu_01To8kuxWFC6hK7vZAE92pgj","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
