r, reviewRunProofDir}\n559\t\tif _, headErr := snapshotGit(s.Root, \"rev-parse\", \"--verify\", \"HEAD\"); headErr != nil {\n560\t\t\t// An unborn repository without delegated data has no delegated history\n561\t\t\t// contract to verify. Preserve the report-history gate's existing behavior.\n562\t\t\tpresent := false\n563\t\t\tfor _, root := range roots {\n564\t\t\t\tif _, err := os.Lstat(filepath.Join(s.Root, root)); !os.IsNotExist(err) {\n565\t\t\t\t\tpresent = true\n566\t\t\t\t\tbreak\n567\t\t\t\t}\n568\t\t\t}\n569\t\t\ttracked, trackedErr := reviewHistoryGit(s.Root, append([]string{\"ls-files\", \"--\"}, roots...)...)\n570\t\t\tif !present && trackedErr == nil && len(bytes.TrimSpace(tracked)) == 0 {\n571\t\t\t\treturn uniqueSorted(findings), nil\n572\t\t\t}\n573\t\t\treturn findings, fmt.Errorf(\"delegated history Git anchor unavailable: %w\", headErr)\n574\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"c13eb04f-8431-4827-b8ec-bc0ff6183b44","timestamp":"2026-11-27T05:15:00.191Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-0c30daf86e/worktree/pose-mcp/internal/pose/review_attempt_ledger.go","content":"\t}\n\treturn findings, nil\n}\n\ntype reviewHistoryBuffer struct{ bytes.Buffer }\n\nfunc (b *reviewHistoryBuffer) Write(p []byte) (int, error) {\n\tif b.Len()+len(p) > 8<<20 {\n\t\treturn 0, fmt.Errorf(\"review history Git output exceeds 8 MiB\")\n\t}\n\treturn b.Buffer.Write(p)\n}\nfunc reviewHistoryGit(root string, args ...string) ([]byte, error) {\n\tctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)\n\tdefer cancel()\n\tbase := gitCommand(append([]string{\"-C\", root}, args...)...)\n\tcmd := exec.CommandContext(ctx, \"git\", base.Args[1:]...)\n\tcmd.Env = base.Env\n\tif len(args) > 0 && args[0] == \"diff\" {\n\t\t// A diff against the work tree reads the index without writing it\n\t\t// (spec pose-validate-reads-leave-the-index-alone R1).\n\t\tdone, err := ReadOnl