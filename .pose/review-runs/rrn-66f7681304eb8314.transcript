{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X9JyACNPyvE2UVjccWYcSS","type":"tool_result","content":"50\t\t}\n51\t\tif err != nil {\n52\t\t\treturn meta, fmt.Errorf(\"module metadata is unreadable: %v\", err)\n53\t\t}\n54\t\tif err := json.Unmarshal(raw, &meta); err != nil {\n55\t\t\treturn scopeMetadata{}, fmt.Errorf(\"module metadata does not decode: %v\", err)\n56\t\t}\n57\t\treturn meta, nil\n58\t}\n59\t\n60\t// scopeSelection maps selected module → deterministic selection reason.\n61\ttype scopeSelection struct {\n62\t\tBase, Head string\n63\t\tChanged    []string\n64\t\tSelected   map[string]string\n65\t}\n66\t\n67\tfunc (s scopeSelection) rangeLabel() string {\n68\t\tif s.Head == \"\" {\n69\t\t\treturn s.Base + \"..worktree\"\n70\t\t}\n71\t\treturn s.Base + \"..\" + s.Head\n72\t}\n73\t\n74\t// computeChangedScope resolves the selection. Modules are selected when they\n75\t// contain changed files, depend (transitively) on a changed module, or policy\n76\t// widens them (criticality high). A change outside every module selects\n77\t// every module that does not declare itself self-contained — uncertainty\n78\t// prefers safe execution. Excluded paths (the run's own canonical result) are\n79\t// not changes.\n80\tfunc computeChangedScope(root, base, head string, modules []validationModule, exclude ...string) (scopeSelection, error) {\n81\t\tmeta, err := loadScopeMetadata(root)\n82\t\tif err != nil {\n83\t\t\treturn scopeSelection{Base: base, Head: head, Selected: map[string]string{}}, err\n84\t\t}\n85\t\treturn computeChangedScopeWith(root, base, head, modules, meta, exclude...)\n86\t}\n87\t\n88\t// computeChangedScopeWith selects with the given metadata snapshot, so a\n89\t// caller that verified one snapshot selects with exactly it (review round 17,\n90\t// N50).\n91\tfunc computeChangedScopeWith(root, base, head string, modules []validationModule, meta scopeMetadata, exclude ...string) (scopeSelection, error) {\n92\t\tsel := scopeSelection{Base: base, Head: head, Selected: map[string]string{}}\n93\t\tfor _, rev := range []string{base, head} {\n94\t\t\tif rev != \"\" && !safeGitRevRE.MatchString(rev) {\n95\t\t\t\treturn sel, fmt.Errorf(\"unsafe git revision: %q\", rev)\n96\t\t\t}\n97\t\t}\n98\t\t// NUL-delimited and without rename pairing: a quoted or multi-line name\n99\t\t// keeps its owner, and a rename names both its source and its destination\n100\t\t// (review round 2, N1 and N3).\n101\t\t// Configuration never hides a changed gitlink (review round 8, N23).\n102\t\tgitArgs := []string{\"-C\", root, \"-c\", \"diff.ignoreSubmodules=none\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"-z\", \"--no-renames\", base}\n103\t\tif head != \"\" {\n104\t\t\tgitArgs = append(gitArgs, head)\n105\t\t}\n106\t\tgitArgs = append(gitArgs, \"--\")\n107\t\t// The diff reads the index without writing it (spec\n108\t\t// pose-validate-reads-leave-the-index-alone R1).\n109\t\tout, err := posemodel.RawGitDiffReadOnly(root, gitArgs...)\n110\t\tif err != nil {\n111\t\t\treturn sel, scopeDiffError(root, base, head, sel.rangeLabel(), err)\n112\t\t}\n113\t\tfor _, name := range strings.Split(string(out), \"\\x00\") {\n114\t\t\tif name != \"\" {\n115\t\t\t\tsel.Changed = append(sel.Changed, filepath.ToSlash(name))\n116\t\t\t}\n117\t\t}\n118\t\tif head == \"\" {\n119\t\t\t// Worktree comparisons must also see untracked files — invisible new\n120\t\t\t// code must never silently narrow validation (safe execution wins).\n121\t\t\tif untracked, err := posemodel.RawHistoryGit(root, \"ls-files\", \"-z\", \"--others\", \"--exclude-standard\").Output(); err == nil {\n122\t\t\t\tfor _, name := range strings.Split(string(untracked), \"\\x00\") {\n123\t\t\t\t\tif name != \"\" {\n124\t\t\t\t\t\tsel.Changed = append(sel.Changed, filepath.ToSlash(name))\n125\t\t\t\t\t}\n126\t\t\t\t}\n127\t\t\t}\n128\t\t}\n129\t\tif len(exclude) > 0 {\n130\t\t\texcluded := map[string]bool{}\n131\t\t\tfor _, path := range exclude {\n132\t\t\t\texcluded[filepath.ToSlash(filepath.Clean(path))] = true\n133\t\t\t}\n134\t\t\tkept := sel.Changed[:0]\n135\t\t\tfor _, file := range sel.Changed {\n136\t\t\t\tif !excluded[file] {\n137\t\t\t\t\tkept = append(kept, file)\n138\t\t\t\t}\n139\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"5db3339f-851b-447a-b125-a0a402986e8d","timestamp":"2026-11-27T05:14:54.853Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-0c30daf86e/worktree/pose-mcp/internal/cli/validate_scope.go","content":"\t}\n\tif err != nil {\n\t\treturn meta, fmt.Errorf(\"module metadata is unreadable: %v\", err)\n\t}\n\tif err := json.Unmarshal(raw, &meta); err != nil {\n\t\treturn scopeMetadata{}, fmt.Errorf(\"module metadata does not decode: %v\", err)\n\t}\n\treturn meta, nil\n}\n\n// scopeSelection maps selected module → deterministic selection reason.\ntype scopeSelection struct {\n\tBase, Head string\n\tChanged    []string\n\tSelected   map[string]string\n}\n\nfunc (s scopeSelection) rangeLabel() string {\n\tif s.Head == \"\" {\n\t\treturn s.Base + \"..worktree\"\n\t}\n\treturn s.Base + \"..\" + s.Head\n}\n\n// computeChangedScope resolves the selection. Modules are selected when they\n// contain changed files, depend (transitively) on a changed module, or policy\n// widens them (criticality high). A change outside every module selects\n// every module that does not declare itself self-contained — uncertainty\n// prefers safe execution. Excluded paths (the run's own canonical result) are\n// not changes.\nfunc computeChangedScope(root, base, head string, modules []validationModule, exclude ...string) (scopeSelection, error) {\n\tmeta, err := loadScopeMetadata(root)\n\tif err != nil {\n\t\treturn scopeSelection{Base: base, Head: head, Selected: map[string]string{}}, err\n\t}\n\treturn computeChangedScopeWith(root, base, head, modules, meta, exclude...)\n}\n\n// computeChangedScopeWith selects with the given metadata snapshot, so a\n// caller that verified one snapshot selects with exactly it (review round 17,\n// N50).\nfunc computeChangedScopeWith(root, base, head string, modules []validationModule, meta scopeMetadata, exclude ...string) (scopeSelection, error) {\n\tsel := scopeSelection{Base: base, Head: head, Selected: map[string]string{}}\n\tfor _, rev := range []string{base, head} {\n\t\tif rev != \"\" && !safeGitRevRE.MatchString(rev) {\n\t\t\treturn sel, fmt.Errorf(\"unsafe git revision: %q\", rev)\n\t\t}\n\t}\n\t// NUL-delimited and without rename pairing: a quoted or multi-line name\n\t// keeps its owner, and a rename names both its source and its destination\n\t// (review round 2, N1 and N3).\n\t// Configuration never hides a changed gitlink (review round 8, N23).\n\tgitArgs := []string{\"-C\", root, \"-c\", \"diff.ignoreSubmodules=none\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"-z\", \"--no-renames\", base}\n\tif head != \"\" {\n\t\tgitArgs = append(gitArgs, head)\n\t}\n\tgitArgs = append(gitArgs, \"--\")\n\t// The diff reads the index without writing it (spec\n\t// pose-validate-reads-leave-the-index-alone R1).\n\tout, err := posemodel.RawGitDiffReadOnly(root, gitArgs...)\n\tif err != nil {\n\t\treturn sel, scopeDiffError(root, base, head, sel.rangeLabel(), err)\n\t}\n\tfor _, name := range strings.Split(string(out), \"\\x00\") {\n\t\tif name != \"\" {\n\t\t\tsel.Changed = append(sel.Changed, filepath.ToSlash(name))\n\t\t}\n\t}\n\tif head == \"\" {\n\t\t// Worktree comparisons must also see untracked files — invisible new\n\t\t// code must never silently narrow validation (safe execution wins).\n\t\tif untracked, err := posemodel.RawHistoryGit(root, \"ls-files\", \"-z\", \"--others\", \"--exclude-standard\").Output(); err == nil {\n\t\t\tfor _, name := range strings.Split(string(untracked), \"\\x00\") {\n\t\t\t\tif name != \"\" {\n\t\t\t\t\tsel.Changed = append(sel.Changed, filepath.ToSlash(name))\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif len(exclude) > 0 {\n\t\texcluded := map[string]bool{}\n\t\tfor _, path := range exclude {\n\t\t\texcluded[filepath.ToSlash(filepath.Clean(path))] = true\n\t\t}\n\t\tkept := sel.Changed[:0]\n\t\tfor _, file := range sel.Changed {\n\t\t\tif !excluded[file] {\n\t\t\t\tkept = append(kept, file)\n\t\t\t}\n\t\t}","numLines":90,"startLine":50,"totalLines":302}},"tool_result_meta":[{"id":"toolu_01X9JyACNPyvE2UVjccWYcSS","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
