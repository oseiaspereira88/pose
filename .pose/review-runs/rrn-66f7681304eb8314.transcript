 at a path here.\n+func openIndexNoBlock(path string) (*os.File, error) {\n+\treturn os.Open(path)\n+}\ndiff --git a/pose-mcp/internal/pose/git_index_open_unix.go b/pose-mcp/internal/pose/git_index_open_unix.go\nnew file mode 100644\nindex 00000000..c84a9c98\n--- /dev/null\n+++ b/pose-mcp/internal/pose/git_index_open_unix.go\n@@ -0,0 +1,13 @@\n+//go:build unix\n+\n+package pose\n+\n+import (\n+\t\"os\"\n+\t\"syscall\"\n+)\n+\n+// openIndexNoBlock opens path for reading without blocking on a FIFO.\n+func openIndexNoBlock(path string) (*os.File, error) {\n+\treturn os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)\n+}\ndiff --git a/pose-mcp/internal/pose/git_worktree_reads.go b/pose-mcp/internal/pose/git_worktree_reads.go\nindex 32e6b681..8fb5d9f5 100644\n--- a/pose-mcp/internal/pose/git_worktree_reads.go\n+++ b/pose-mcp/internal/pose/git_worktree_reads.go\n@@ -1,11 +1,16 @@\n package pose\n \n import (\n+\t\"bytes\"\n+\t\"context\"\n+\t\"errors\"\n \t\"fmt\"\n \t\"io\"\n \t\"os\"\n \t\"os/exec\"\n+\t\"path/filepath\"\n \t\"strings\"\n+\t\"time\"\n )\n \n // Spec pose-validate-reads-leave-the-index-alone R1, D1: `git diff` against\n@@ -15,53 +20,146 @@ import (\n // as it is, but reads the index through a descriptor whose lock Git cannot\n // create: it refreshes in memory, cannot write, and skips the write silently\n // (refresh_index_quietly), so its answer is the plain diff's and nothing is\n-// written anywhere. Where that is not available, it reads a private copy.\n+// written anywhere. Where that is not available (another system, or a\n+// memory file that cannot be made), it reads a private copy.\n \n // diffIndexLimit bounds the index one read loads.\n const diffIndexLimit = 512 << 20\n \n+// ErrIndexUnreadable marks a read that failed on the index, not on the\n+// revisions it compares (review round 5, N23).\n+var ErrIndexUnreadable = errors.New(\"the index cannot be read\")\n+\n+// indexLookupTimeout bounds the lookup of the index's path.\n+const indexLookupTimeout = 30 * time.Second\n+\n // ReadOnlyIndex prepares cmd, a git command reading the repository at root,\n // to read root's index without being able to write it. The returned function\n // releases what it holds; call it after the command ends.\n func ReadOnlyIndex(cmd *exec.Cmd, root string) (func(), error) {\n-\tout, err := RawGit(\"-C\", root, \"rev-parse\", \"--path-format=absolute\", \"--git-path\", \"index\").Output()\n+\tctx, cancel := context.WithTimeout(context.Background(), indexLookupTimeout)\n+\tdefer cancel()\n+\treturn ReadOnlyIndexContext(ctx, cmd, root)\n+}\n+\n+// ReadOnlyIndexContext is ReadOnlyIndex with the lookup of the index bound by\n+// ctx, the caller's deadline (review round 1, N3).\n+func ReadOnlyIndexContext(ctx context.Context, cmd *exec.Cmd, root string) (func(), error) {\n+\t// `--git-path` without `--path-format`, which Git before 2.31 would echo\n+\t// back as a path that does not exist (review round 5, N26): the answer is\n+\t// relative to root unless absolute.\n+\tlookup := gitCommandContext(ctx, \"--no-replace-objects\", \"-C\", root, \"rev-parse\", \"--git-path\", \"index\")\n+\tGitEnglish(lookup)\n+\tvar lookupErr bytes.Buffer\n+\tlookup.Stderr = &lookupErr\n+\tout, err := lookup.Output()\n \tif err != nil {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be located: %w\", root, err)\n+\t\t// Not an index failure: no repository, a broken config or HEAD; Git's\n+\t\t// own words say which (review round 2, N14).\n+\t\treturn func() {}, GitReadError(\"pose: locating the index of \"+root, err, lookupErr.Bytes())\n \t}\n \tpath := strings.TrimSuffix(string(out), \"\\n\")\n-\tbefore, err := os.Stat(path)\n+\tif !filepath.IsAbs(path) {\n+\t\tpath = filepath.Join(root, path)\n+\t}\n+\t// Opened without blocking, so a FIFO or device there cannot hang the\n+\t// read, and judged on the open file, so an index another process\n+\t// replaces atomically is read whole, as Git reads it (review rounds 4\n+\t// N21, 5 N22).\n+\tf, err := openIndexNoBlock(path)\n \tif os.IsNotExist(err) {\n \t\t// No index yet: there is no stat cache to refresh, so the plain read\n \t\t// writes nothing (review round 2, N11).\n \t\treturn func() {}, nil\n \t}\n-\t// A FIFO or device is refused before it is opened, which could block\n-\t// (review round 4, N21); the open file must be the file checked, and is\n-\t// read within the bound (round 3, N17).\n-\tif err != nil || !before.Mode().IsRegular() {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is not a regular file\", root)\n-\t}\n-\tf, err := os.Open(path)\n \tif err != nil {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w\", root, err)\n+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w: %w\", root, ErrIndexUnreadable, err)\n \t}\n \tdefer f.Close()\n \tinfo, err := f.Stat()\n-\tif err != nil || !info.Mode().IsRegular() || !os.SameFile(before, info) {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s changed while it was opened\", root)\n+\tif err != nil || !info.Mode().IsRegular() {\n+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is not a regular file: %w\", root, ErrIndexUnreadable)\n \t}\n \traw, err := io.ReadAll(io.LimitReader(f, diffIndexLimit+1))\n \tif err != nil {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w\", root, err)\n+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w: %w\", root, ErrIndexUnreadable, err)\n \t}\n \tif len(raw) > diffIndexLimit {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is larger than %d bytes\", root, diffIndexLimit)\n+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is larger than %d bytes: %w\", root, diffIndexLimit, ErrIndexUnreadable)\n \t}\n \t// The copy keeps the index's modification time: Git trusts an entry on\n \t// its stat only when the file is older than the index, so a fresher copy\n \t// would hide a change made in the index's own second (review round 2,\n \t// N10, racy-clean entries).\n-\treturn readOnlyIndexFor(cmd, raw, info.ModTime())\n+\t// Git's messages in English, so GitReadError can tell an index failure\n+\t// whatever the user's locale.\n+\tGitEnglish(cmd)\n+\tdone, err := readOnlyIndexFor(cmd, raw, info.ModTime())\n+\tif err != nil {\n+\t\treturn done, fmt.Errorf(\"pose: the index of %s cannot be handed to git: %w: %w\", root, ErrIndexUnreadable, err)\n+\t}\n+\treturn done, nil\n+}\n+\n+// gitReadSaidLimit bounds what a read error keeps of Git's standard error.\n+const gitReadSaidLimit = 600\n+\n+// GitReadError describes a failed git read with what git said on standard\n+// error, all of it on one line and bounded, so a warning Git prints first\n+// does not hide the cause (review round 3, N17). It does not guess from the\n+// words whether the index was at fault: ErrIndexUnreadable marks only the\n+// failures of ReadOnlyIndex itself (review rounds 2 N13, 3 N18).\n+func GitReadError(what string, err error, stderr []byte) error {\n+\t// Git's fatal and error lines first, so a long warning before them does\n+\t// not push the cause past the bound (review round 4, N25).\n+\tvar first, rest []string\n+\tfor _, line := range strings.Split(string(stderr), \"\\n\") {\n+\t\tline = strings.Join(strings.Fields(line), \" \")\n+\t\tswitch {\n+\t\tcase line == \"\":\n+\t\tcase strings.HasPrefix(line, \"fatal:\") || strings.HasPrefix(line, \"error:\"):\n+\t\t\tfirst = append(first, line)\n+\t\tdefault:\n+\t\t\trest = append(rest, line)\n+\t\t}\n+\t}\n+\tsaid := strings.Join(append(first, rest...), \" ; \")\n+\tif len(said) > gitReadSaidLimit {\n+\t\tsaid = said[:gitReadSaidLimit] + \"…\"\n+\t}\n+\tif said == \"\" {\n+\t\treturn fmt.Errorf(\"%s failed: %w\", what, err)\n+\t}\n+\treturn fmt.Errorf(\"%s failed: %w: %s\", what, err, said)\n+}\n+\n+// GitEnglish makes cmd's messages English, so the causes reported read the\n+// same in every locale.\n+func GitEnglish(cmd *exec.Cmd) {\n+\tcmd.Env = append(cmd.Env, \"LC_ALL=C\", \"LANGUAGE=C\")\n+}\n+\n+// privateIndexCopy hands raw to cmd as a private copy: Git refreshes and may\n+// rewrite the copy, never the checkout's index.\n+func privateIndexCopy(cmd *exec.Cmd, raw []byte, modTime time.Time) (func(), error) {\n+\tdir, err := os.MkdirTemp(\"\", \"pose-index-*\")\n+\tif err != nil {\n+\t\treturn func() {}, err\n+\t}\n+\tdone := func() { _ = os.RemoveAll(dir) }\n+\tpath := filepath.Join(dir, \"index\")\n+\tif err := os.WriteFile(path, raw, 0o600); err != nil {\n+\t\tdone()\n+\t\treturn func() {}, err\n+\t}\n+\tif err := os.Chtimes(path, modTime, modTime); err != nil {\n+\t\tdone()\n+\t\treturn func() {}, err\n+\t}\n+\t// A split index would write a new shared index into .git.\n+\tcmd.Args = append([]string{cmd.Args[0], \"-c\", \"core.splitIndex=false\"}, cmd.Args[1:]...)\n+\tcmd.Env = append(cmd.Env, \"GIT_INDEX_FILE=\"+path)\n+\treturn done, nil\n }\n \n // RawGitDiffReadOnly runs RawGit(args...), a diff of the repository at root,\n@@ -73,5 +171,11 @@ func RawGitDiffReadOnly(root string, args ...string) ([]byte, error) {\n \tif err != nil {\n \t\treturn nil, err\n \t}\n-\treturn cmd.Output()\n+\tvar stderr bytes.Buffer\n+\tcmd.Stderr = &stderr\n+\tout, err := cmd.Output()\n+\tif err != nil {\n+\t\treturn nil, GitReadError(\"git diff\", err, stderr.Bytes())\n+\t}\n+\treturn out, nil\n }\ndiff --git a/pose-mcp/internal/pose/git_worktree_reads_linux.go b/pose-mcp/internal/pose/git_worktree_reads_linux.go\nindex bcc6e8fd..508b1ec5 100644\n--- a/pose-mcp/internal/pose/git_worktree_reads_linux.go\n+++ b/pose-mcp/internal/pose/git_worktree_reads_linux.go\n@@ -17,25 +17,36 @@ import (\n // exist, so the lock fails for any user, root included, and the refresh is\n // not written. No file is created.\n func readOnlyIndexFor(cmd *exec.Cmd, raw []byte, modTime time.Time) (func(), error) {\n-\tfd, err := unix.MemfdCreate(\"pose-index/none\", unix.MFD_CLOEXEC)\n+\tfd, err := memfdCreate(\"pose-index/none\", unix.MFD_CLOEXEC)\n \tif err != nil {\n-\t\treturn func() {}, fmt.Errorf(\"pose: an in-memory index cannot be made: %w\", err)\n+\t\t// No memory file here (an old kernel, a seccomp filter): the private\n+\t\t// copy keeps the index untouched too (review round 5, N27).\n+\t\treturn privateIndexCopy(cmd, raw, modTime)\n \t}\n \tf := os.NewFile(uintptr(fd), \"pose-index\")\n \tif _, err := f.Write(raw); err != nil {\n \t\tf.Close()\n-\t\treturn func() {}, err\n+\t\treturn privateIndexCopy(cmd, raw, modTime) // review round 1, N8\n \t}\n \tif _, err := f.Seek(0, 0); err != nil {\n \t\tf.Close()\n-\t\treturn func() {}, err\n+\t\treturn privateIndexCopy(cmd, raw, modTime)\n \t}\n \tts := unix.NsecToTimespec(modTime.UnixNano())\n-\tif err := unix.UtimesNanoAt(unix.AT_FDCWD, fmt.Sprintf(\"/proc/self/fd/%d\", fd), []unix.Timespec{ts, ts}, 0); err != nil {\n+\tif err := utimesNanoAt(unix.AT_FDCWD, fmt.Sprintf(\"/proc/self/fd/%d\", fd), []unix.Timespec{ts, ts}, 0); err != nil {\n+\t\t// Without /proc the memory file cannot carry the time, nor be named\n+\t\t// to Git: the private copy is read instead (review round 5, N27).\n \t\tf.Close()\n-\t\treturn func() {}, fmt.Errorf(\"pose: the in-memory index cannot keep the index's time: %w\", err)\n+\t\treturn privateIndexCopy(cmd, raw, modTime)\n \t}\n \tcmd.ExtraFiles = append(cmd.ExtraFiles, f)\n \tcmd.Env = append(cmd.Env, fmt.Sprintf(\"GIT_INDEX_FILE=/proc/self/fd/%d\", 2+len(cmd.ExtraFiles)))\n \treturn func() { f.Close() }, nil\n }\n+\n+// memfdCreate and utimesNanoAt are the calls the memory file needs; a test\n+// replaces them to exercise the fallback (review round 1, N4).\n+var (\n+\tmemfdCreate  = unix.MemfdCreate\n+\tutimesNanoAt = unix.UtimesNanoAt\n+)\ndiff --git a/pose-mcp/internal/pose/git_worktree_reads_linux_test.go b/pose-mcp/internal/pose/git_worktree_reads_linux_test.go\nnew file mode 100644\nindex 00000000..eac133aa\n--- /dev/null\n+++ b/pose-mcp/internal/pose/git_worktree_reads_linux_test.go\n@@ -0,0 +1,55 @@\n+//go:build linux\n+\n+package pose\n+\n+import (\n+\t\"bytes\"\n+\t\"errors\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"testing\"\n+\n+\t\"golang.org/x/sys/unix\"\n+)\n+\n+// Spec pose-validate-read-only-index-followups R4 (review round 1, N4): when\n+// no memory file can be made, or it cannot carry the index's time, the read\n+// falls back to the private copy, answers and leaves the index.\n+func TestReadOnlyIndexFallsBackWithoutAMemoryFile(t *testing.T) {\n+\tfor _, broken := range []string{\"memfd\", \"utimes\"} {\n+\t\tt.Run(broken, func(t *testing.T) {\n+\t\t\tsaveMemfd, saveUtimes := memfdCreate, utimesNanoAt\n+\t\t\tdefer func() { memfdCreate, utimesNanoAt = saveMemfd, saveUtimes }()\n+\t\t\tif broken == \"memfd\" {\n+\t\t\t\tmemfdCreate = func(string, int) (int, error) { return -1, errors.New(\"no memfd here\") }\n+\t\t\t} else {\n+\t\t\t\tutimesNanoAt = func(int, string, []unix.Timespec, int) error { return errors.New(\"no /proc here\") }\n+\t\t\t}\n+\t\t\ttop, _ := staleRepo(t, \"\")\n+\t\t\tbefore, err := os.ReadFile(filepath.Join(top, \".git\", \"index\"))\n+\t\t\tif err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tout, err := RawGitDiffReadOnly(top, \"-C\", top, \"diff\", \"--name-only\", \"--\")\n+\t\t\tif err != nil || len(out) != 0 {\n+\t\t\t\tt.Fatalf(\"the fallback answered %q %v\", out, err)\n+\t\t\t}\n+\t\t\tif after, _ := os.ReadFile(filepath.Join(top, \".git\", \"index\")); !bytes.Equal(before, after) {\n+\t\t\t\tt.Fatal(\"the fallback read rewrote .git/index\")\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+// Review round 2, N16: a failure handing the index to git, here with neither\n+// a memory file nor a usable temporary directory, is an index failure.\n+func TestAFailedIndexHandOverIsAnIndexFailure(t *testing.T) {\n+\ttop, _ := staleRepo(t, \"\")\n+\tsave := memfdCreate\n+\tdefer func() { memfdCreate = save }()\n+\tmemfdCreate = func(string, int) (int, error) { return -1, errors.New(\"no memfd here\") }\n+\tt.Setenv(\"TMPDIR\", filepath.Join(t.TempDi