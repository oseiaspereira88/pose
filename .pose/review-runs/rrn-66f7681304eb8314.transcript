"check.go\", `pose.GitEnglish(cmd)`, ``},\n\t\t{\"report-warn\", cli + \"report.go\", `render(stderr, stderr).Finding(`, `_ = (`},\n\t\t{\"report-english\", cli + \"report.go\", `posemodel.GitEnglish(cmd)`, ``},\n\t\t{\"report-silent\", cli + \"report.go\", `if since == \"\" && posemodel`, `if false && posemodel`},\n\t\t{\"report-marker\", cli + \"report.go\", `return []string{cliText(locale, \"_The`, `return files, err; return []string{cliText(locale, \"_The`},\n\t\t{\"ledger-ctx\", p + \"review_attempt_ledger.go\", `ReadOnlyIndexContext(ctx, cmd, root)`, `ReadOnlyIndex(cmd, root)`},\n\t\t{\"ledger-unprotected\", p + \"review_attempt_ledger.go\", `done, err := ReadOnlyIndexContext(ctx, cmd, root)`, `done, err := func() {}, error(nil)`},\n\t\t{\"lookup-english\", p + \"git_worktree_reads.go\", `GitEnglish(lookup)`, ``},\n\t\t{\"handover-english\", p + \"git_worktree_reads.go\", \"GitEnglish(cmd)\\n\tdone, err\", \"\\n\tdone, err\"},\n\t\t{\"handover-mark\", p + \"git_worktree_reads.go\", `cannot be handed to git: %w: %w\", root, ErrIndexUnreadable, err)`, `cannot be handed to git: %w\", root, err)`},\n\t\t{\"nonblock\", p + \"git_index_open_unix.go\", `os.O_RDONLY|syscall.O_NONBLOCK, 0)`, `os.O_RDONLY|syscall.O_NONBLOCK&0, 0)`},\n\t\t{\"regular\", p + \"git_worktree_reads.go\", `if err != nil || !info.Mode().IsRegular() {`, `if err != nil {`},\n\t\t{\"memfd-fallback\", p + \"git_worktree_reads_linux.go\", \"return privateIndexCopy(cmd, raw, modTime)\\n\t}\\n\tf :=\", \"return func() {}, err\\n\t}\\n\tf :=\"},\n\t\t{\"write-fallback\", p + \"git_worktree_reads_linux.go\", `return privateIndexCopy(cmd, raw, modTime) // review round 1, N8`, `return func() {}, err`},\n\t\t{\"utimes-fallback\", p + \"git_worktree_reads_linux.go\", \"f.Close()\\n\t\treturn privateIndexCopy(cmd, raw, modTime)\\n\t}\\n\tcmd.ExtraFiles\", \"f.Close()\\n\t\treturn func() {}, err\\n\t}\\n\tcmd.ExtraFiles\"},\n\t\t{\"copy-mtime\", p + \"git_worktree_reads.go\", `os.Chtimes(path, modTime, modTime)`, `os.Chtimes(path, time.Now(), time.Now())`},\n\t}\n\tfor _, m := range ms {\n\t\traw, err := os.ReadFile(m.file)\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif !strings.Contains(string(raw), m.old) {\n\t\t\tt.Logf(\"%s: pattern missing\", m.name)\n\t\t\tcontinue\n\t\t}\n\t\tmf := filepath.Join(os.Getenv(\"TMPDIR\"), \"m_\"+m.name+\".go\")\n\t\tos.WriteFile(mf, []byte(strings.Replace(string(raw), m.old, m.new, 1)), 0o600)\n\t\tj, _ := json.Marshal(map[string]any{\"Replace\": map[string]string{m.file: mf}})\n\t\tof := mf + \".json\"\n\t\tos.WriteFile(of, j, 0o600)\n\t\tcmd := exec.Command(\"go\", \"test\", \"-overlay=\"+of, \"./internal/cli\", \"./internal/pose\", \"-count=1\", \"-timeout=90s\", \"-run\", \"ReadOnlyIndex|PrivateIndexCopy|FailedIndexRead|FailedIndexHandOver|ValidationReads|ScopeSelection|CorruptIndex|IndexFailures|GitReadErrors|ReportChanged|ChangedScope\")\n\t\tcmd.Dir = mod\n\t\tstart := time.Now()\n\t\tout, err := cmd.CombinedOutput()\n\t\tvar fails []string\n\t\tfor _, l := range strings.Split(string(out), \"\\n\") {\n\t\t\tif strings.HasPrefix(l, \"--- FAIL\") || strings.Contains(l, \"build failed\") || strings.Contains(l, \".go:\") && len(fails) < 3 || strings.HasPrefix(l, \"panic:\") {\n\t\t\t\tfails = append(fails, l)\n\t\t\t}\n\t\t}\n\t\tif len(fails) > 5 {\n\t\t\tfails = fails[:5]\n\t\t}\n\t\tt.Logf(\"%s: killed=%v %s %q\", m.name, err != nil, time.Since(start).Round(time.Second), fails)\n\t}\n\t// L1 and the sub-root gap\n\ttop := t.TempDir()\n\tg := func(args ...string) string {\n\t\tc := exec.Command(\"git\", append([]string{\"-C\", top, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\"}, args...)...)\n\t\tc.Env = append(os.Environ(), \"GIT_OPTIONAL_LOCKS=0\")\n\t\tout, err := c.CombinedOutput()\n\t\tif err != nil {\n\t\t\tt.Log(args, err, string(out))\n\t\t}\n\t\treturn string(out)\n\t}\n\tg(\"init\", \"-q\")\n\tos.WriteFile(filepath.Join(top, \"a\"), []byte(\"a\"), 0o644)\n\tg(\"config\", \"core.splitIndex\", \"true\")\n\tg(\"add\", \"a\")\n\tg(\"commit\", \"-qm\", \"i\")\n\tg(\"update-index\", \"--split-index\")\n\tsh, _ := filepath.Glob(filepath.Join(top, \".git\", \"sharedindex.*\"))\n\tfor _, c := range [][]string{{\"status\"}, {\"ls-files\"}, {\"engine\"}} {\n\t\told := time.Now().Add(-time.Hour)\n\t\tfor _, s := range sh {\n\t\t\tos.Chtimes(s, old, old)\n\t\t}\n\t\tif c[0] == \"engine\" {\n\t\t\tif _, err := RawGitDiffReadOnly(top, \"-C\", top, \"diff\", \"--name-only\", \"--\"); err != nil {\n\t\t\t\tt.Log(err)\n\t\t\t}\n\t\t} else {\n\t\t\tg(c...)\n\t\t}\n\t\tfor _, s := range sh {\n\t\t\ti, _ := os.Stat(s)\n\t\t\tt.Logf(\"L1 %v %s moved=%v\", c, filepath.Base(s)[:16], i.ModTime().After(old.Add(time.Minute)))\n\t\t}\n\t}\n}\nEOF\nprintf '{\"Replace\":{\"%s\":\"%s\"}}' \"$PWD/pose-mcp/internal/pose/zz_mut_test.go\" \"$TMPDIR/mut_test.go\" > \"$TMPDIR/overlay2.json\"; go -C pose-mcp test -overlay=\"$TMPDIR/overlay2.json\" ./internal/pose -run ZZMutants -v -count=1 -timeout=590s 2>&1","is_backgrounded":false,"task_type":"local_bash","uuid":"8c1f8ed4-0c75-496e-bae0-6a7db88f4953","session_id":"[private-session]"}
