{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014Ztx3MKM49cPzKvTbVTpj4","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n6\t\t\"os\"\n7\t\t\"os/exec\"\n8\t\t\"path/filepath\"\n9\t\t\"strings\"\n10\t\t\"sync\"\n11\t\t\"testing\"\n12\t\t\"time\"\n13\t)\n14\t\n15\t// staleIndexRepo is a repository whose index holds a stale stat cache for a\n16\t// file whose content did not change, so any read that refreshes the index\n17\t// would write it back.\n18\tfunc staleIndexRepo(t *testing.T) (string, []byte) {\n19\t\tt.Helper()\n20\t\troot := t.TempDir()\n21\t\tgit := func(args ...string) {\n22\t\t\tt.Helper()\n23\t\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", root, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\"}, args...)...)\n24\t\t\tif out, err := cmd.CombinedOutput(); err != nil {\n25\t\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n26\t\t\t}\n27\t\t}\n28\t\tgit(\"init\", \"-q\")\n29\t\tif err := os.MkdirAll(filepath.Join(root, \".pose\", \"specs\"), 0o755); err != nil {\n30\t\t\tt.Fatal(err)\n31\t\t}\n32\t\tfor _, f := range []string{\"a.txt\", \".pose/specs/2026-11-26-alpha.md\"} {\n33\t\t\tif err := os.WriteFile(filepath.Join(root, f), []byte(\"x\\n\"), 0o644); err != nil {\n34\t\t\t\tt.Fatal(err)\n35\t\t\t}\n36\t\t}\n37\t\tgit(\"add\", \"-A\")\n38\t\tgit(\"commit\", \"-q\", \"-m\", \"init\")\n39\t\tlater := time.Now().Add(2 * time.Second)\n40\t\tfor _, f := range []string{\"a.txt\", \".pose/specs/2026-11-26-alpha.md\"} {\n41\t\t\tif err := os.Chtimes(filepath.Join(root, f), later, later); err != nil {\n42\t\t\t\tt.Fatal(err)\n43\t\t\t}\n44\t\t}\n45\t\tindex, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n46\t\tif err != nil {\n47\t\t\tt.Fatal(err)\n48\t\t}\n49\t\treturn root, index\n50\t}\n51\t\n52\t// Spec pose-validate-reads-leave-the-index-alone R1, R2: the reads validate,\n53\t// check and report make leave a stale index byte-identical, and still answer\n54\t// that nothing changed.\n55\tfunc TestValidationReadsLeaveTheIndexAlone(t *testing.T) {\n56\t\troot, before := staleIndexRepo(t)\n57\t\tif !materialWorktreeClean(root) {\n58\t\t\tt.Fatal(\"a stat-only change made the work tree dirty\")\n59\t\t}\n60\t\tsel, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n61\t\tif err != nil || len(sel.Changed) != 0 {\n62\t\t\tt.Fatalf(\"the scope diff against the work tree: %v %v\", sel.Changed, err)\n63\t\t}\n64\t\tif files, err := reportChangedFiles(root, \"HEAD\"); err != nil || len(files) != 0 {\n65\t\t\tt.Fatalf(\"report listed a stat-only change: %v\", files)\n66\t\t}\n67\t\tif got := (&nativeChecker{root: root}).readyTransitionCandidates(); len(got) != 0 {\n68\t\t\tt.Fatalf(\"the ready transition read listed a stat-only change: %v\", got)\n69\t\t}\n70\t\tafter, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n71\t\tif err != nil {\n72\t\t\tt.Fatal(err)\n73\t\t}\n74\t\tif !bytes.Equal(before, after) {\n75\t\t\tt.Fatal(\"a validation read rewrote .git/index\")\n76\t\t}\n77\t}\n78\t\n79\t// Spec pose-validate-reads-leave-the-index-alone R3: while those reads run\n80\t// concurrently, a reader watching .git/index never sees it change.\n81\tfunc TestConcurrentValidationReadsNeverChangeTheIndex(t *testing.T) {\n82\t\troot, before := staleIndexRepo(t)\n83\t\tstop := make(chan struct{})\n84\t\tvar wg sync.WaitGroup\n85\t\tfor i := 0; i < 4; i++ {\n86\t\t\twg.Add(1)\n87\t\t\tgo func() {\n88\t\t\t\tdefer wg.Done()\n89\t\t\t\tfor j := 0; j < 5; j++ {\n90\t\t\t\t\tmaterialWorktreeClean(root)\n91\t\t\t\t\t_, _ = computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n92\t\t\t\t\t_, _ = reportChangedFiles(root, \"HEAD\")\n93\t\t\t\t\t(&nativeChecker{root: root}).readyTransitionCandidates()\n94\t\t\t\t\t// The review history reader runs concurrently too (review\n95\t\t\t\t\t// round 1, N5).\n96\t\t\t\t\t_, _ = posemodel.Store{Root: root}.ReviewRunHistoryFindings()\n97\t\t\t\t}\n98\t\t\t}()\n99\t\t}\n100\t\tchanged := make(chan string, 1)\n101\t\tgo func() {\n102\t\t\tfor {\n103\t\t\t\tselect {\n104\t\t\t\tcase <-stop:\n105\t\t\t\t\treturn\n106\t\t\t\tdefault:\n107\t\t\t\t}\n108\t\t\t\tnow, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n109\t\t\t\tif err == nil && !bytes.Equal(before, now) {\n110\t\t\t\t\tchanged <- \"the index changed while validation reads ran\"\n111\t\t\t\t\treturn\n112\t\t\t\t}\n113\t\t\t\tif _, err := os.Lstat(filepath.Join(root, \".git\", \"index.lock\")); err == nil {\n114\t\t\t\t\tchanged <- \"a validation read took the index lock\"\n115\t\t\t\t\treturn\n116\t\t\t\t}\n117\t\t\t}\n118\t\t}()\n119\t\twg.Wait()\n120\t\tclose(stop)\n121\t\tselect {\n122\t\tcase why := <-changed:\n123\t\t\tt.Fatal(why)\n124\t\tdefault:\n125\t\t}\n126\t}\n127\t\n128\t// Review round 2, N11: without an index file the reads still answer: the\n129\t// untracked spec is a ready-transition candidate and the report lists it.\n130\tfunc TestValidationReadsAnswerWithoutAnIndex(t *testing.T) {\n131\t\troot, _ := staleIndexRepo(t)\n132\t\tif err := os.Remove(filepath.Join(root, \".git\", \"index\")); err != nil {\n133\t\t\tt.Fatal(err)\n134\t\t}\n135\t\tif err := os.WriteFile(filepath.Join(root, \".pose\", \"specs\", \"2026-11-26-beta.md\"), []byte(\"x\\n\"), 0o644); err != nil {\n136\t\t\tt.Fatal(err)\n137\t\t}\n138\t\tfound := false\n139\t\tfor _, c := range (&nativeChecker{root: root}).readyTransitionCandidates() {\n140\t\t\tif strings.HasSuffix(c, \"2026-11-26-beta.md\") {\n141\t\t\t\tfound = true\n142\t\t\t}\n143\t\t}\n144\t\tif !found {\n145\t\t\tt.Fatal(\"the ready transition read lost the new spec without an index\")\n146\t\t}\n147\t\tif files, err := reportChangedFiles(root, \"\"); err != nil || len(files) == 0 {\n148\t\t\tt.Fatal(\"report listed nothing without an index\")\n149\t\t}\n150\t\tif _, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{}); err != nil {\n151\t\t\tt.Fatalf(\"scope selection failed without an index: %v\", err)\n152\t\t}\n153\t}\n154\t\n155\t// Spec pose-validate-read-only-index-followups R2: a failed index read is\n156\t// reported with its cause by the check, scope selection and the report.\n157\tfunc TestAFailedIndexReadIsReported(t *testing.T) {\n158\t\troot, _ := staleIndexRepo(t)\n159\t\tindex := filepath.Join(root, \".git\", \"index\")\n160\t\tif err := os.Remove(index); err != nil {\n161\t\t\tt.Fatal(err)\n162\t\t}\n163\t\tif err := os.Mkdir(index, 0o755); err != nil {\n164\t\t\tt.Fatal(err)\n165\t\t}\n166\t\tvar out bytes.Buffer\n167\t\tchecker := &nativeChecker{root: root, mode: \"strict\", locale: localeEN, stdout: &out}\n168\t\tchecker.readyTransitionCandidates()\n169\t\tif checker.errors == 0 || !strings.Contains(out.String(), \"cannot be listed\") {\n170\t\t\tt.Fatalf(\"the check dropped a failed index read: %d %s\", checker.errors, out.String())\n171\t\t}\n172\t\t_, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n173\t\tif err == nil || strings.Contains(err.Error(), \"revision unknown?\") || !strings.Contains(err.Error(), \"index\") {\n174\t\t\tt.Fatalf(\"scope selection mislabelled a failed index read: %v\", err)\n175\t\t}\n176\t\tif _, err := reportChangedFiles(root, \"HEAD\"); err == nil {\n177\t\t\tt.Fatal(\"report hid a failed index read\")\n178\t\t}\n179\t}\n180\t\n181\t// Review round 1, N1–N2 of spec pose-validate-read-only-index-followups: a\n182\t// corrupt index, which git itself refuses, is reported as an index failure\n183\t// with what git said, not as an unknown revision.\n184\tfunc TestACorruptIndexIsReportedWithItsCause(t *testing.T) {\n185\t\troot, _ := staleIndexRepo(t)\n186\t\tif err := os.WriteFile(filepath.Join(root, \".git\", \"index\"), []byte(\"not an index at all\"), 0o644); err != nil {\n187\t\t\tt.Fatal(err)\n188\t\t}\n189\t\tvar out bytes.Buffer\n190\t\tchecker := &nativeChecker{root: root, mode: \"strict\", locale: localeEN, stdout: &out}\n191\t\tchecker.readyTransitionCandidates()\n192\t\tif checker.errors == 0 || !strings.Contains(out.String(), \"index\") {\n193\t\t\tt.Fatalf(\"the check did not name the corrupt index: %d %s\", checker.errors, out.String())\n194\t\t}\n195\t\t_, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n196\t\tif err == nil || strings.Contains(err.Error(), \"revision unknown?\") || !strings.Contains(err.Error(), \"index\") {\n197\t\t\tt.Fatalf(\"scope selection mislabelled a corrupt index: %v\", err)\n198\t\t}\n199\t\tif _, err := reportChangedFiles(root, \"HEAD\"); err == nil || !strings.Contains(err.Error(), \"index\") {\n200\t\t\tt.Fatalf(\"report did not name the corrupt index: %v\", err)\n201\t\t}\n202\t}\n203\t\n204\t// Review round 2 of spec pose-validate-read-only-index-followups, N12–N16:\n205\t// index failures are named in any locale, a revision named after the index\n206\t// stays a revision failure, the report states a failure on one line and stays\n207\t// silent only outside a repository.\n208\tfunc TestIndexFailuresAreNamedInAnyLocale(t *testing.T) {\n209\t\tt.Setenv(\"LC_ALL\", \"pt_BR.UTF-8\")\n210\t\tt.Setenv(\"LANGUAGE\", \"pt_BR\")\n211\t\troot, _ := staleIndexRepo(t)\n212\t\tif err := os.WriteFile(filepath.Join(root, \".git\", \"index\"), []byte(\"not an index at all\"), 0o644); err != nil {\n213\t\t\tt.Fatal(err)\n214\t\t}\n215\t\tfiles, err := reportChangedFilesNoted(root, \"\", localeEN)\n216\t\tif err == nil || !strings.Contains(err.Error(), \"index file\") {\n217\t\t\tt.Fatalf(\"a corrupt index in another locale was not named in Git's English words: %v\", err)\n218\t\t}\n219\t\tif len(files) != 1 || !strings.HasPrefix(files[0], \"_The changed files could not be listed: \") || strings.Contains(files[0], \"\\n\") || strings.Contains(files[0], root) {\n220\t\t\tt.Fatalf(\"the report did not state the failure on one line: %q\", files)\n221\t\t}\n222\t\tclean, _ := staleIndexRepo(t)\n223\t\tif _, err := computeChangedScopeWith(clean, \"feature/index-rework\", \"\", nil, scopeMetadata{}); err == nil || !strings.Contains(err.Error(), \"revision unknown?\") {\n224\t\t\tt.Fatalf(\"a revision named after the index was taken for an index failure: %v\", err)\n225\t\t}\n226\t\toutside := t.TempDir()\n227\t\tt.Setenv(\"GIT_CEILING_DIRECTORIES\", filepath.Dir(outside))\n228\t\tif files, err := reportChangedFilesNoted(outside, \"\", localeEN); err != nil || len(files) != 0 {\n229\t\t\tt.Fatalf(\"a plain report outside a repository was not silent: %q %v\", files, err)\n230\t\t}\n231\t\t// A failure naming the checkout reaches the versioned report without its\n232\t\t// absolute path (review round 3, N22).\n233\t\tif files, err := reportChangedFilesNoted(outside, \"HEAD\", localeEN); err == nil || len(files) != 1 || strings.Contains(files[0], outside) || !strings.Contains(files[0], \"<path>\") {\n234\t\t\tt.Fatalf(\"the report kept the checkout's path: %q %v\", files, err)\n235\t\t}\n236\t}\n237\t\n238\t// Review round 3, N17–N18: a corrupt index is not taken for an unknown\n239\t// revision, whatever Git says first, and an unknown revision is found by\n240\t// resolving it.\n241\tfunc TestScopeSelectionTellsRevisionsFromIndexFailures(t *testing.T) {\n242\t\troot, _ := staleIndexRepo(t)\n243\t\tcmd := exec.Command(\"git\", \"-C\", root, \"config\", \"diff.dirstat\", \"bogus\")\n244\t\tif out, err := cmd.CombinedOutput(); err != nil {\n245\t\t\tt.Fatal(err, string(out))\n246\t\t}\n247\t\tif err := os.WriteFile(filepath.Join(root, \".git\", \"index\"), []byte(\"not an index at all\"), 0o644); err != nil {\n248\t\t\tt.Fatal(err)\n249\t\t}\n250\t\t_, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n251\t\tif err == nil || strings.Contains(err.Error(), \"revision unknown?\") || !strings.Contains(err.Error(), \"index file\") {\n252\t\t\tt.Fatalf(\"a corrupt index behind a configuration warning: %v\", err)\n253\t\t}\n254\t\t// A healthy range whose read fails on the index is not an unknown\n255\t\t// revision: its ends are resolved one by one.\n256\t\tranged, _ := staleIndexRepo(t)\n257\t\trangedIndex := filepath.Join(ranged, \".git\", \"index\")\n258\t\tif err := os.Remove(rangedIndex); err != nil {\n259\t\t\tt.Fatal(err)\n260\t\t}\n261\t\tif err := os.Mkdir(rangedIndex, 0o755); err != nil {\n262\t\t\tt.Fatal(err)\n263\t\t}\n264\t\tif _, err := computeChangedScopeWith(ranged, \"HEAD..HEAD\", \"\", nil, scopeMetadata{}); err == nil || strings.Contains(err.Error(), \"revision unknown?\") {\n265\t\t\tt.Fatalf(\"a healthy range was taken for an unknown revision: %v\", err)\n266\t\t}\n267\t\tif _, err := computeChangedScopeWith(root, \"HEAD..nonexistent\", \"\", nil, scopeMetadata{}); err == nil || !strings.Contains(err.Error(), \"revision unknown?\") {\n268\t\t\tt.Fatalf(\"an unknown revision in a range: %v\", err)\n269\t\t}\n270\t}\n271\t\n272\t// Review round 4 of spec pose-validate-read-only-index-followups, N23–N27:\n273\t// revisions the diff accepts keep their answer, a repository failure keeps\n274\t// Git's cause, healthy ranges select, and the report keeps relative names.\n275\tfunc TestScopeSelectionKeepsWhatTheDiffAccepts(t *testing.T) {\n276\t\troot, _ := staleIndexRepo(t)\n277\t\tgit := func(args ...string) string {\n278\t\t\tt.Helper()\n279\t\t\tout, err := exec.Command(\"git\", append([]string{\"-C\", root, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\"}, args...)...).CombinedOutput()\n280\t\t\tif err != nil {\n281\t\t\t\tt.Fatal(args, err, string(out))\n282\t\t\t}\n283\t\t\treturn strings.TrimSpace(string(out))\n284\t\t}\n285\t\tif err := os.WriteFile(filepath.Join(root, \"b.txt\"), []byte(\"b\\n\"), 0o644); err != nil {\n286\t\t\tt.Fatal(err)\n287\t\t}\n288\t\tgit(\"add\", \"b.txt\")\n289\t\tgit(\"commit\", \"-q\", \"-m\", \"two\")\n290\t\tfor _, c := range []struct{ base, head string }{\n291\t\t\t{\"4b825dc642cb6eb9a060e54bf8d69288fbee4904\", \"HEAD\"},\n292\t\t\t{\"HEAD^-\", \"\"},\n293\t\t\t{\"HEAD~1..HEAD\", \"\"},\n294\t\t\t{\"HEAD~1...HEAD\", \"\"},\n295\t\t} {\n296\t\t\tsel, err := computeChangedScopeWith(root, c.base, c.head, nil, scopeMetadata{})\n297\t\t\tif err != nil || len(sel.Changed) == 0 {\n298\t\t\t\tt.Fatalf(\"%s %s: %v %v\", c.base, c.head, sel.Changed, err)\n299\t\t\t}\n300\t\t}\n301\t\tif err := os.WriteFile(filepath.Join(root, \".git\", \"config\"), []byte(\"[bad\\n\"), 0o644); err != nil {\n302\t\t\tt.Fatal(err)\n303\t\t}\n304\t\t_, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n305\t\tif err == nil || strings.Contains(err.Error(), \"revision unknown?\") || !strings.Contains(err.Error(), \"bad config\") {\n306\t\t\tt.Fatalf(\"a broken config lost its cause: %v\", err)\n307\t\t}\n308\t\tnote := reportAbsolutePathRE.ReplaceAllString(\"bad revision 'feature/index-rework' at /abs/root/.git/index\", \"${1}<path>\")\n309\t\tif !strings.Contains(note, \"feature/index-rework\") || strings.Contains(note, \"/abs/root\") {\n310\t\t\tt.Fatalf(\"the report note: %q\", note)\n311\t\t}\n312\t}\n313\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"86970f98-266d-4892-aadf-e5e513c4adb6","timestamp":"2026-11-27T05:14:27.656Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-0c30daf86e/worktree/pose-mcp/internal/cli/validate_reads_index_test.go","content":"package cli\n\nimport (\n\t\"bytes\"\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n)\n\n// staleIndexRepo is a repository whose index holds a stale stat cache for a\n// file whose content did not change, so any read that refreshes the index\n// would write it back.\nfunc staleIndexRepo(t *testing.T) (string, []byte) {\n\tt.Helper()\n\troot := t.TempDir()\n\tgit := func(args ...string) {\n\t\tt.Helper()\n\t\tcmd := exec.Command(\"git\", append([]string{\"-C\", root, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\"}, args...)...)\n\t\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t}\n\t}\n\tgit(\"init\", \"-q\")\n\tif err := os.MkdirAll(filepath.Join(root, \".pose\", \"specs\"), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, f := range []string{\"a.txt\", \".pose/specs/2026-11-26-alpha.md\"} {\n\t\tif err := os.WriteFile(filepath.Join(root, f), []byte(\"x\\n\"), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tgit(\"add\", \"-A\")\n\tgit(\"commit\", \"-q\", \"-m\", \"init\")\n\tlater := time.Now().Add(2 * time.Second)\n\tfor _, f := range []string{\"a.txt\", \".pose/specs/2026-11-26-alpha.md\"} {\n\t\tif err := os.Chtimes(filepath.Join(root, f), later, later); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\tindex, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn root, index\n}\n\n// Spec pose-validate-reads-leave-the-index-alone R1, R2: the reads validate,\n// check and report make leave a stale index byte-identical, and still answer\n// that nothing changed.\nfunc TestValidationReadsLeaveTheIndexAlone(t *testing.T) {\n\troot, before := staleIndexRepo(t)\n\tif !materialWorktreeClean(root) {\n\t\tt.Fatal(\"a stat-only change made the work tree dirty\")\n\t}\n\tsel, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n\tif err != nil || len(sel.Changed) != 0 {\n\t\tt.Fatalf(\"the scope diff against the work tree: %v %v\", sel.Changed, err)\n\t}\n\tif files, err := reportChangedFiles(root, \"HEAD\"); err != nil || len(files) != 0 {\n\t\tt.Fatalf(\"report listed a stat-only change: %v\", files)\n\t}\n\tif got := (&nativeChecker{root: root}).readyTransitionCandidates(); len(got) != 0 {\n\t\tt.Fatalf(\"the ready transition read listed a stat-only change: %v\", got)\n\t}\n\tafter, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !bytes.Equal(before, after) {\n\t\tt.Fatal(\"a validation read rewrote .git/index\")\n\t}\n}\n\n// Spec pose-validate-reads-leave-the-index-alone R3: while those reads run\n// concurrently, a reader watching .git/index never sees it change.\nfunc TestConcurrentValidationReadsNeverChangeTheIndex(t *testing.T) {\n\troot, before := staleIndexRepo(t)\n\tstop := make(chan struct{})\n\tvar wg sync.WaitGroup\n\tfor i := 0; i < 4; i++ {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tfor j := 0; j < 5; j++ {\n\t\t\t\tmaterialWorktreeClean(root)\n\t\t\t\t_, _ = computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n\t\t\t\t_, _ = reportChangedFiles(root, \"HEAD\")\n\t\t\t\t(&nativeChecker{root: root}).readyTransitionCandidates()\n\t\t\t\t// The review history reader runs concurrently too (review\n\t\t\t\t// round 1, N5).\n\t\t\t\t_, _ = posemodel.Store{Root: root}.ReviewRunHistoryFindings()\n\t\t\t}\n\t\t}()\n\t}\n\tchanged := make(chan string, 1)\n\tgo func() {\n\t\tfor {\n\t\t\tselect {\n\t\t\tcase <-stop:\n\t\t\t\treturn\n\t\t\tdefault:\n\t\t\t}\n\t\t\tnow, err := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n\t\t\tif err == nil && !bytes.Equal(before, now) {\n\t\t\t\tchanged <- \"the index changed while validation reads ran\"\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif _, err := os.Lstat(filepath.Join(root, \".git\", \"index.lock\")); err == nil {\n\t\t\t\tchanged <- \"a validation read took the index lock\"\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}()\n\twg.Wait()\n\tclose(stop)\n\tselect {\n\tcase why := <-changed:\n\t\tt.Fatal(why)\n\tdefault:\n\t}\n}\n\n// Review round 2, N11: without an index file the reads still answer: the\n// untracked spec is a ready-transition candidate and the report lists it.\nfunc TestValidationReadsAnswerWithoutAnIndex(t *testing.T) {\n\troot, _ := staleIndexRepo(t)\n\tif err := os.Remove(filepath.Join(root, \".git\", \"index\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \".pose\", \"specs\", \"2026-11-26-beta.md\"), []byte(\"x\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfound := false\n\tfor _, c := range (&nativeChecker{root: root}).readyTransitionCandidates() {\n\t\tif strings.HasSuffix(c, \"2026-11-26-beta.md\") {\n\t\t\tfound = true\n\t\t}\n\t}\n\tif !found {\n\t\tt.Fatal(\"the ready transition read lost the new spec without an index\")\n\t}\n\tif files, err := reportChangedFiles(root, \"\"); err != nil || len(files) == 0 {\n\t\tt.Fatal(\"report listed nothing without an index\")\n\t}\n\tif _, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{}); err != nil {\n\t\tt.Fatalf(\"scope selection failed without an index: %v\", err)\n\t}\n}\n\n// Spec pose-validate-read-only-index-followups R2: a failed index read is\n// reported with its cause by the check, scope selection and the report.\nfunc TestAFailedIndexReadIsReported(t *testing.T) {\n\troot, _ := staleIndexRepo(t)\n\tindex := filepath.Join(root, \".git\", \"index\")\n\tif err := os.Remove(index); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Mkdir(index, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvar out bytes.Buffer\n\tchecker := &nativeChecker{root: root, mode: \"strict\", locale: localeEN, stdout: &out}\n\tchecker.readyTransitionCandidates()\n\tif checker.errors == 0 || !strings.Contains(out.String(), \"cannot be listed\") {\n\t\tt.Fatalf(\"the check dropped a failed index read: %d %s\", checker.errors, out.String())\n\t}\n\t_, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n\tif err == nil || strings.Contains(err.Error(), \"revision unknown?\") || !strings.Contains(err.Error(), \"index\") {\n\t\tt.Fatalf(\"scope selection mislabelled a failed index read: %v\", err)\n\t}\n\tif _, err := reportChangedFiles(root, \"HEAD\"); err == nil {\n\t\tt.Fatal(\"report hid a failed index read\")\n\t}\n}\n\n// Review round 1, N1–N2 of spec pose-validate-read-only-index-followups: a\n// corrupt index, which git itself refuses, is reported as an index failure\n// with what git said, not as an unknown revision.\nfunc TestACorruptIndexIsReportedWithItsCause(t *testing.T) {\n\troot, _ := staleIndexRepo(t)\n\tif err := os.WriteFile(filepath.Join(root, \".git\", \"index\"), []byte(\"not an index at all\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvar out bytes.Buffer\n\tchecker := &nativeChecker{root: root, mode: \"strict\", locale: localeEN, stdout: &out}\n\tchecker.readyTransitionCandidates()\n\tif checker.errors == 0 || !strings.Contains(out.String(), \"index\") {\n\t\tt.Fatalf(\"the check did not name the corrupt index: %d %s\", checker.errors, out.String())\n\t}\n\t_, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n\tif err == nil || strings.Contains(err.Error(), \"revision unknown?\") || !strings.Contains(err.Error(), \"index\") {\n\t\tt.Fatalf(\"scope selection mislabelled a corrupt index: %v\", err)\n\t}\n\tif _, err := reportChangedFiles(root, \"HEAD\"); err == nil || !strings.Contains(err.Error(), \"index\") {\n\t\tt.Fatalf(\"report did not name the corrupt index: %v\", err)\n\t}\n}\n\n// Review round 2 of spec pose-validate-read-only-index-followups, N12–N16:\n// index failures are named in any locale, a revision named after the index\n// stays a revision failure, the report states a failure on one line and stays\n// silent only outside a repository.\nfunc TestIndexFailuresAreNamedInAnyLocale(t *testing.T) {\n\tt.Setenv(\"LC_ALL\", \"pt_BR.UTF-8\")\n\tt.Setenv(\"LANGUAGE\", \"pt_BR\")\n\troot, _ := staleIndexRepo(t)\n\tif err := os.WriteFile(filepath.Join(root, \".git\", \"index\"), []byte(\"not an index at all\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfiles, err := reportChangedFilesNoted(root, \"\", localeEN)\n\tif err == nil || !strings.Contains(err.Error(), \"index file\") {\n\t\tt.Fatalf(\"a corrupt index in another locale was not named in Git's English words: %v\", err)\n\t}\n\tif len(files) != 1 || !strings.HasPrefix(files[0], \"_The changed files could not be listed: \") || strings.Contains(files[0], \"\\n\") || strings.Contains(files[0], root) {\n\t\tt.Fatalf(\"the report did not state the failure on one line: %q\", files)\n\t}\n\tclean, _ := staleIndexRepo(t)\n\tif _, err := computeChangedScopeWith(clean, \"feature/index-rework\", \"\", nil, scopeMetadata{}); err == nil || !strings.Contains(err.Error(), \"revision unknown?\") {\n\t\tt.Fatalf(\"a revision named after the index was taken for an index failure: %v\", err)\n\t}\n\toutside := t.TempDir()\n\tt.Setenv(\"GIT_CEILING_DIRECTORIES\", filepath.Dir(outside))\n\tif files, err := reportChangedFilesNoted(outside, \"\", localeEN); err != nil || len(files) != 0 {\n\t\tt.Fatalf(\"a plain report outside a repository was not silent: %q %v\", files, err)\n\t}\n\t// A failure naming the checkout reaches the versioned report without its\n\t// absolute path (review round 3, N22).\n\tif files, err := reportChangedFilesNoted(outside, \"HEAD\", localeEN); err == nil || len(files) != 1 || strings.Contains(files[0], outside) || !strings.Contains(files[0], \"<path>\") {\n\t\tt.Fatalf(\"the report kept the checkout's path: %q %v\", files, err)\n\t}\n}\n\n// Review round 3, N17–N18: a corrupt index is not taken for an unknown\n// revision, whatever Git says first, and an unknown revision is found by\n// resolving it.\nfunc TestScopeSelectionTellsRevisionsFromIndexFailures(t *testing.T) {\n\troot, _ := staleIndexRepo(t)\n\tcmd := exec.Command(\"git\", \"-C\", root, \"config\", \"diff.dirstat\", \"bogus\")\n\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\tt.Fatal(err, string(out))\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \".git\", \"index\"), []byte(\"not an index at all\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n\tif err == nil || strings.Contains(err.Error(), \"revision unknown?\") || !strings.Contains(err.Error(), \"index file\") {\n\t\tt.Fatalf(\"a corrupt index behind a configuration warning: %v\", err)\n\t}\n\t// A healthy range whose read fails on the index is not an unknown\n\t// revision: its ends are resolved one by one.\n\tranged, _ := staleIndexRepo(t)\n\trangedIndex := filepath.Join(ranged, \".git\", \"index\")\n\tif err := os.Remove(rangedIndex); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Mkdir(rangedIndex, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := computeChangedScopeWith(ranged, \"HEAD..HEAD\", \"\", nil, scopeMetadata{}); err == nil || strings.Contains(err.Error(), \"revision unknown?\") {\n\t\tt.Fatalf(\"a healthy range was taken for an unknown revision: %v\", err)\n\t}\n\tif _, err := computeChangedScopeWith(root, \"HEAD..nonexistent\", \"\", nil, scopeMetadata{}); err == nil || !strings.Contains(err.Error(), \"revision unknown?\") {\n\t\tt.Fatalf(\"an unknown revision in a range: %v\", err)\n\t}\n}\n\n// Review round 4 of spec pose-validate-read-only-index-followups, N23–N27:\n// revisions the diff accepts keep their answer, a repository failure keeps\n// Git's cause, healthy ranges select, and the report keeps relative names.\nfunc TestScopeSelectionKeepsWhatTheDiffAccepts(t *testing.T) {\n\troot, _ := staleIndexRepo(t)\n\tgit := func(args ...string) string {\n\t\tt.Helper()\n\t\tout, err := exec.Command(\"git\", append([]string{\"-C\", root, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\"}, args...)...).CombinedOutput()\n\t\tif err != nil {\n\t\t\tt.Fatal(args, err, string(out))\n\t\t}\n\t\treturn strings.TrimSpace(string(out))\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \"b.txt\"), []byte(\"b\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgit(\"add\", \"b.txt\")\n\tgit(\"commit\", \"-q\", \"-m\", \"two\")\n\tfor _, c := range []struct{ base, head string }{\n\t\t{\"4b825dc642cb6eb9a060e54bf8d69288fbee4904\", \"HEAD\"},\n\t\t{\"HEAD^-\", \"\"},\n\t\t{\"HEAD~1..HEAD\", \"\"},\n\t\t{\"HEAD~1...HEAD\", \"\"},\n\t} {\n\t\tsel, err := computeChangedScopeWith(root, c.base, c.head, nil, scopeMetadata{})\n\t\tif err != nil || len(sel.Changed) == 0 {\n\t\t\tt.Fatalf(\"%s %s: %v %v\", c.base, c.head, sel.Changed, err)\n\t\t}\n\t}\n\tif err := os.WriteFile(filepath.Join(root, \".git\", \"config\"), []byte(\"[bad\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n\tif err == nil || strings.Contains(err.Error(), \"revision unknown?\") || !strings.Contains(err.Error(), \"bad config\") {\n\t\tt.Fatalf(\"a broken config lost its cause: %v\", err)\n\t}\n\tnote := reportAbsolutePathRE.ReplaceAllString(\"bad revision 'feature/index-rework' at /abs/root/.git/index\", \"${1}<path>\")\n\tif !strings.Contains(note, \"feature/index-rework\") || strings.Contains(note, \"/abs/root\") {\n\t\tt.Fatalf(\"the report note: %q\", note)\n\t}\n}\n","numLines":313,"startLine":1,"totalLines":313}},"tool_result_meta":[{"id":"toolu_014Ztx3MKM49cPzKvTbVTpj4","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChSry4HsX6P5Jh4Q7A6Ue","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VQYJGfU5bahvPjJE82ZjJi","name":"Read","input":{"file_path":"/var/tmp/pose-work-go/pose-review-run-0c30daf86e/worktree/pose-mcp/internal/cli/check.go","offset":1080,"limit":130},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":23927,"cache_read_input_tokens":29276,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":23927},"output_tokens":17,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"8240aaa3-b617-40c2-aa0f-6ac89a8e39ea","timestamp":"2026-11-27T05:14:28.331Z","request_id":"req_011ChSry45xso86Bgx2wEQNh","wire_tool_inputs":{"toolu_01VQYJGfU5bahvPjJE82ZjJi":{"file_path":"/var/tmp/pose-work-go/pose-review-run-0c30daf86e/worktree/pose-mcp/internal/cli/check.go","offset":1080,"limit":130}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VQYJGfU5bahvPjJE82ZjJi","type":"tool_result","content":"1080\t\tfor _, path := range specPaths {\n1081\t\t\tfields := simpleFrontmatterIn(checker.fsys(), path)\n1082\t\t\tslug := fields[\"slug\"]\n1083\t\t\tif slug == \"\" {\n1084\t\t\t\tslug = filepath.Base(filepath.Dir(path))\n1085\t\t\t}\n1086\t\t\tif fields[\"status\"] == \"done\" && fields[\"changelog\"] != \"none\" && fields[\"completed_at\"] >= policy.AdoptedAt && !covered[slug] {\n1087\t\t\t\tchecker.issue(cliout.StateWarning, checker.message(\"changelog: done spec without a changelog fragment: \", \"changelog: spec done sem changelog fragment: \")+slug)\n1088\t\t\t}\n1089\t\t}\n1090\t}\n1091\t\n1092\tfunc frontmatterBodyIn(files pose.Files, path string) string {\n1093\t\traw, err := files.ReadFile(path)\n1094\t\tif err != nil {\n1095\t\t\treturn \"\"\n1096\t\t}\n1097\t\tlines := strings.Split(string(raw), \"\\n\")\n1098\t\tif len(lines) == 0 || strings.TrimSpace(lines[0]) != \"---\" {\n1099\t\t\treturn string(raw)\n1100\t\t}\n1101\t\tfor index, line := range lines[1:] {\n1102\t\t\tif strings.TrimSpace(line) == \"---\" {\n1103\t\t\t\treturn strings.Join(lines[index+2:], \"\\n\")\n1104\t\t\t}\n1105\t\t}\n1106\t\treturn string(raw)\n1107\t}\n1108\t\n1109\t// frontmatterBody reads and writes the filesystem directly; frontmatterBodyIn takes the\n1110\t// operation's files.\n1111\tfunc frontmatterBody(path string) string {\n1112\t\treturn frontmatterBodyIn(pose.NativeFiles(), path)\n1113\t}\n1114\t\n1115\tfunc stripHTMLComments(value string) string {\n1116\t\treturn regexp.MustCompile(`(?s)<!--.*?-->`).ReplaceAllString(value, \"\")\n1117\t}\n1118\t\n1119\tfunc (checker *nativeChecker) checkReadyTransitions() {\n1120\t\tfor _, rel := range checker.readyTransitionCandidates() {\n1121\t\t\tchecker.checkReadyTransition(rel)\n1122\t\t}\n1123\t}\n1124\t\n1125\t// readyTransitionCandidates lists the spec files that differ from HEAD or are new.\n1126\tfunc (checker *nativeChecker) readyTransitionCandidates() []string {\n1127\t\tif _, err := pose.RawHistoryGit(checker.root, \"rev-parse\", \"--verify\", \"HEAD\").Output(); err != nil {\n1128\t\t\treturn nil\n1129\t\t}\n1130\t\tchanged := map[string]bool{}\n1131\t\tfor _, command := range [][]string{\n1132\t\t\t{\"diff\", \"--name-only\", \"HEAD\", \"--\", \".pose/specs\"},\n1133\t\t\t{\"ls-files\", \"--others\", \"--exclude-standard\", \"--\", \".pose/specs\"},\n1134\t\t} {\n1135\t\t\t// The diff reads the index without writing it (spec\n1136\t\t\t// pose-validate-reads-leave-the-index-alone R1).\n1137\t\t\tcmd := pose.RawHistoryGit(checker.root, command...)\n1138\t\t\tdone := func() {}\n1139\t\t\tif command[0] == \"diff\" {\n1140\t\t\t\tvar err error\n1141\t\t\t\tif done, err = pose.ReadOnlyIndex(cmd, checker.root); err != nil {\n1142\t\t\t\t\tdone()\n1143\t\t\t\t\t// The specs this read would name go unchecked: say so\n1144\t\t\t\t\t// (review round 5, N23).\n1145\t\t\t\t\tchecker.failOrWarn(checker.message(fmt.Sprintf(\"ready transitions: the changed specs cannot be listed: %v\", err), fmt.Sprintf(\"transições de prontidão: as specs alteradas não podem ser listadas: %v\", err)))\n1146\t\t\t\t\tcontinue\n1147\t\t\t\t}\n1148\t\t\t}\n1149\t\t\tvar stderr bytes.Buffer\n1150\t\t\tcmd.Stderr = &stderr\n1151\t\t\tpose.GitEnglish(cmd)\n1152\t\t\toutput, err := cmd.Output()\n1153\t\t\tdone()\n1154\t\t\tif err != nil {\n1155\t\t\t\terr = pose.GitReadError(\"git \"+command[0], err, stderr.Bytes())\n1156\t\t\t\tchecker.failOrWarn(checker.message(fmt.Sprintf(\"ready transitions: the changed specs cannot be listed: %v\", err), fmt.Sprintf(\"transições de prontidão: as specs alteradas não podem ser listadas: %v\", err)))\n1157\t\t\t\tcontinue\n1158\t\t\t}\n1159\t\t\tfor _, rel := range strings.Fields(string(output)) {\n1160\t\t\t\trelNorm := filepath.ToSlash(rel)\n1161\t\t\t\tif strings.HasPrefix(relNorm, \".pose/specs/\") && (strings.HasSuffix(relNorm, \"/spec.md\") || (