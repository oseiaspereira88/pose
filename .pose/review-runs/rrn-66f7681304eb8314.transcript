l/pose/git_index_open_other.go b/pose-mcp/internal/pose/git_index_open_other.go\n209\tnew file mode 100644\n210\tindex 00000000..392779a1\n211\t--- /dev/null\n212\t+++ b/pose-mcp/internal/pose/git_index_open_other.go\n213\t@@ -0,0 +1,10 @@\n214\t+//go:build !unix\n215\t+\n216\t+package pose\n217\t+\n218\t+import \"os\"\n219\t+\n220\t+// openIndexNoBlock opens path for reading; there are no FIFOs at a path here.\n221\t+func openIndexNoBlock(path string) (*os.File, error) {\n222\t+\treturn os.Open(path)\n223\t+}\n224\tdiff --git a/pose-mcp/internal/pose/git_index_open_unix.go b/pose-mcp/internal/pose/git_index_open_unix.go\n225\tnew file mode 100644\n226\tindex 00000000..c84a9c98\n227\t--- /dev/null\n228\t+++ b/pose-mcp/internal/pose/git_index_open_unix.go\n229\t@@ -0,0 +1,13 @@\n230\t+//go:build unix\n231\t+\n232\t+package pose\n233\t+\n234\t+import (\n235\t+\t\"os\"\n236\t+\t\"syscall\"\n237\t+)\n238\t+\n239\t+// openIndexNoBlock opens path for reading without blocking on a FIFO.\n240\t+func openIndexNoBlock(path string) (*os.File, error) {\n241\t+\treturn os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)\n242\t+}\n243\tdiff --git a/pose-mcp/internal/pose/git_worktree_reads.go b/pose-mcp/internal/pose/git_worktree_reads.go\n244\tindex 32e6b681..8fb5d9f5 100644\n245\t--- a/pose-mcp/internal/pose/git_worktree_reads.go\n246\t+++ b/pose-mcp/internal/pose/git_worktree_reads.go\n247\t@@ -1,11 +1,16 @@\n248\t package pose\n249\t \n250\t import (\n251\t+\t\"bytes\"\n252\t+\t\"context\"\n253\t+\t\"errors\"\n254\t \t\"fmt\"\n255\t \t\"io\"\n256\t \t\"os\"\n257\t \t\"os/exec\"\n258\t+\t\"path/filepath\"\n259\t \t\"strings\"\n260\t+\t\"time\"\n261\t )\n262\t \n263\t // Spec pose-validate-reads-leave-the-index-alone R1, D1: `git diff` against\n264\t@@ -15,53 +20,146 @@ import (\n265\t // as it is, but reads the index through a descriptor whose lock Git cannot\n266\t // create: it refreshes in memory, cannot write, and skips the write silently\n267\t // (refresh_index_quietly), so its answer is the plain diff's and nothing is\n268\t-// written anywhere. Where that is not available, it reads a private copy.\n269\t+// written anywhere. Where that is not available (another system, or a\n270\t+// memory file that cannot be made), it reads a private copy.\n271\t \n272\t // diffIndexLimit bounds the index one read loads.\n273\t const diffIndexLimit = 512 << 20\n274\t \n275\t+// ErrIndexUnreadable marks a read that failed on the index, not on the\n276\t+// revisions it compares (review round 5, N23).\n277\t+var ErrIndexUnreadable = errors.New(\"the index cannot be read\")\n278\t+\n279\t+// indexLookupTimeout bounds the lookup of the index's path.\n280\t+const indexLookupTimeout = 30 * time.Second\n281\t+\n282\t // ReadOnlyIndex prepares cmd, a git command reading the repository at root,\n283\t // to read root's index without being able to write it. The returned function\n284\t // releases what it holds; call it after the command ends.\n285\t func ReadOnlyIndex(cmd *exec.Cmd, root string) (func(), error) {\n286\t-\tout, err := RawGit(\"-C\", root, \"rev-parse\", \"--path-format=absolute\", \"--git-path\", \"index\").Output()\n287\t+\tctx, cancel := context.WithTimeout(context.Background(), indexLookupTimeout)\n288\t+\tdefer cancel()\n289\t+\treturn ReadOnlyIndexContext(ctx, cmd, root)\n290\t+}\n291\t+\n292\t+// ReadOnlyIndexContext is ReadOnlyIndex with the lookup of the index bound by\n293\t+// ctx, the caller's deadline (review round 1, N3).\n294\t+func ReadOnlyIndexContext(ctx context.Context, cmd *exec.Cmd, root string) (func(), error) {\n295\t+\t// `--git-path` without `--path-format`, which Git before 2.31 would echo\n296\t+\t// back as a path that does not exist (review round 5, N26): the answer is\n297\t+\t// relative to root unless absolute.\n298\t+\tlookup := gitCommandContext(ctx, \"--no-replace-objects\", \"-C\", root, \"rev-parse\", \"--git-path\", \"index\")\n299\t+\tGitEnglish(lookup)\n300\t+\tvar lookupErr bytes.Buffer\n301\t+\tlookup.Stderr = &lookupErr\n302\t+\tout, err := lookup.Output()\n303\t \tif err != nil {\n304\t-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be located: %w\", root, err)\n305\t+\t\t// Not an index failure: no repository, a broken config or HEAD; Git's\n306\t+\t\t// own words say which (review round 2, N14).\n307\t+\t\treturn func() {}, GitReadError(\"pose: locating the index of \"+root, err, lookupErr.Bytes())\n308\t \t}\n309\t \tpath := strings.TrimSuffix(string(out), \"\\n\")\n310\t-\tbefore, err := os.Stat(path)\n311\t+\tif !filepath.IsAbs(path) {\n312\t+\t\tpath = filepath.Join(root, path)\n313\t+\t}\n314\t+\t// Opened without blocking, so a FIFO or device there cannot hang the\n315\t+\t// read, and judged on the open file, so an index another process\n316\t+\t// replaces atomically is read whole, as Git reads it (review rounds 4\n317\t+\t// N21, 5 N22).\n318\t+\tf, err := openIndexNoBlock(path)\n319\t \tif os.IsNotExist(err) {\n320\t \t\t// No index yet: there is no stat cache to refresh, so the plain read\n321\t \t\t// writes nothing (review round 2, N11).\n322\t \t\treturn func() {}, nil\n323\t \t}\n324\t-\t// A FIFO or device is refused before it is opened, which could block\n325\t-\t// (review round 4, N21); the open file must be the file checked, and is\n326\t-\t// read within the bound (round 3, N17).\n327\t-\tif err != nil || !before.Mode().IsRegular() {\n328\t-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is not a regular file\", root)\n329\t-\t}\n330\t-\tf, err := os.Open(path)\n331\t \tif err != nil {\n332\t-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w\", root, err)\n333\t+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w: %w\", root, ErrIndexUnreadable, err)\n334\t \t}\n335\t \tdefer f.Close()\n336\t \tinfo, err := f.Stat()\n337\t-\tif err != nil || !info.Mode().IsRegular() || !os.SameFile(before, info) {\n338\t-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s changed while it was opened\", root)\n339\t+\tif err != nil || !info.Mode().IsRegular() {\n340\t+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is not a regular file: %w\", root, ErrIndexUnreadable)\n341\t \t}\n342\t \traw, err := io.ReadAll(io.LimitReader(f, diffIndexLimit+1))\n343\t \tif err != nil {\n344\t-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w\", root, err)\n345\t+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w: %w\", root, ErrIndexUnreadable, err)\n346\t \t}\n347\t \tif len(raw) > diffIndexLimit {\n348\t-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is larger than %d bytes\", root, diffIndexLimit)\n349\t+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is larger than %d bytes: %w\", root, diffIndexLimit, ErrIndexUnreadable)\n350\t \t}\n351\t \t// The copy keeps the index's modification time: Git trusts an entry on\n352\t \t// its stat only when the file is older than the index, so a fresher copy\n353\t \t// would hide a change made in the index's own second (review round 2,\n354\t \t// N10, racy-clean entries).\n355\t-\treturn readOnlyIndexFor(cmd, raw, info.ModTime())\n356\t+\t// Git's messages in English, so GitReadError can tell an index failure\n357\t+\t// whatever the user's locale.\n358\t+\tGitEnglish(cmd)\n359\t+\tdone, err := readOnlyIndexFor(cmd, raw, info.ModTime())\n360\t+\tif err != nil {\n361\t+\t\treturn done, fmt.Errorf(\"pose: the index of %s cannot be handed to git: %w: %w\", root, ErrIndexUnreadable, err)\n362\t+\t}\n363\t+\treturn done, nil\n364\t+}\n365\t+\n366\t+// gitReadSaidLimit bounds what a read error keeps of Git's standard error.\n367\t+const gitReadSaidLimit = 600\n368\t+\n369\t+// GitReadError describes a failed git read with what git said on standard\n370\t+// error, all of it on one line and bounded, so a warning Git prints first\n371\t+// does not hide the cause (review round 3, N17). It does not guess from the\n372\t+// words whether the index was at fault: ErrIndexUnreadable marks only the\n373\t+// failures of ReadOnlyIndex itself (review rounds 2 N13, 3 N18).\n374\t+func GitReadError(what string, err error, stderr []byte) error {\n375\t+\t// Git's fatal and error lines first, so a long warning before them does\n376\t+\t// not push the cause past the bound (review round 4, N25).\n377\t+\tvar first, rest []string\n378\t+\tfor _, line := range strings.Split(string(stderr), \"\\n\") {\n379\t+\t\tline = strings.Join(strings.Fields(line), \" \")\n380\t+\t\tswitch {\n381\t+\t\tcase line == \"\":\n382\t+\t\tcase strings.HasPrefix(line, \"fatal:\") || strings.HasPrefix(line, \"error:\"):\n383\t+\t\t\tfirst = append(first, line)\n384\t+\t\tdefault:\n385\t+\t\t\trest = append(rest, line)\n386\t+\t\t}\n387\t+\t}\n388\t+\tsaid := strings.Join(append(first, rest...), \" ; \")\n389\t+\tif len(said) > gitReadSaidLimit {\n390\t+\t\tsaid = said[:gitReadSaidLimit] + \"…\"\n391\t+\t}\n392\t+\tif said == \"\" {\n393\t+\t\treturn fmt.Errorf(\"%s failed: %w\", what, err)\n394\t+\t}\n395\t+\treturn fmt.Errorf(\"%s failed: %w: %s\", what, err, said)\n396\t+}\n397\t+\n398\t+// GitEnglish makes cmd's messages English, so the causes reported read the\n399\t+// same in every locale.\n400\t+func GitEnglish(cmd *exec.Cmd) {\n401\t+\tcmd.Env = append(cmd.Env, \"LC_ALL=C\", \"LANGUAGE=C\")\n402\t+}\n403\t+\n404\t+// privateIndexCopy hands raw to cmd as a private copy: Git refreshes and may\n405\t+// rewrite the copy, never the checkout's index.\n406\t+func privateIndexCopy(cmd *exec.Cmd, raw []byte, modTime time.Time) (func(), error) {\n407\t+\tdir, err := os.MkdirTemp(\"\", \"pose-index-*\")\n408\t+\tif err != nil {\n409\t+\t\treturn func() {}, err\n410\t+\t}\n411\t+\tdone := func() { _ = os.RemoveAll(dir) }\n412\t+\tpath := filepath.Join(dir, \"index\")\n413\t+\tif err := os.WriteFile(path, raw, 0o600); err != nil {\n414\t+\t\tdone()\n415\t+\t\treturn func() {}, err\n416\t+\t}\n417\t+\tif err := os.Chtimes(path, modTime, modTime); err != nil {\n418\t+\t\tdone()\n419\t+\t\treturn func() {}, err\n420\t+\t}\n421\t+\t// A split index would write a new shared index into .git.\n422\t+\tcmd.Args = append([]string{cmd.Args[0], \"-c\", \"core.splitIndex=false\"}, cmd.Args[1:]...)\n423\t+\tcmd.Env = append(cmd.Env, \"GIT_INDEX_FILE=\"+path)\n424\t+\treturn done, nil\n425\t }\n426\t \n427\t // RawGitDiffReadOnly runs RawGit(args...), a diff of the repository at root,\n428\t@@ -73,5 +171,11 @@ func RawGitDiffReadOnly(root string, args ...string) ([]byte, error) {\n429\t \tif err != nil {\n430\t \t\treturn nil, err\n431\t \t}\n432\t-\treturn cmd.Output()\n433\t+\tvar stderr bytes.Buffer\n434\t+\tcmd.Stderr = &stderr\n435\t+\tout, err := cmd.Output()\n436\t+\tif err != nil {\n437\t+\t\treturn nil, GitReadError(\"git diff\", err, stderr.Bytes())\n438\t+\t}\n439\t+\treturn out, nil\n440\t }\n441\tdiff --git a/pose-mcp/internal/pose/git_worktree_reads_linux.go b/pose-mcp/internal/pose/git_worktree_reads_linux.go\n442\tindex bcc6e8fd..508b1ec5 100644\n443\t--- a/pose-mcp/internal/pose/git_worktree_reads_linux.go\n444\t+++ b/pose-mcp/internal/pose/git_worktree_reads_linux.go\n445\t@@ -17,25 +17,36 @@ import (\n446\t // exist, so the lock fails for any user, root included, and the refresh is\n447\t // not written. No file is created.\n448\t func readOnlyIndexFor(cmd *exec.Cmd, raw []byte, modTime time.Time) (func(), error) {\n449\t-\tfd, err := unix.MemfdCreate(\"pose-index/none\", unix.MFD_CLOEXEC)\n450\t+\tfd, err := memfdCreate(\"pose-index/none\", unix.MFD_CLOEXEC)\n451\t \tif err != nil {\n452\t-\t\treturn func() {}, fmt.Errorf(\"pose: an in-memory index cannot be made: %w\", err)\n453\t+\t\t// No memory file here (an old kernel, a seccomp filter): the private\n454\t+\t\t// copy keeps the index untouched too (review round 5, N27).\n455\t+\t\treturn privateIndexCopy(cmd, raw, modTime)\n456\t \t}\n457\t \tf := os.NewFile(uintptr(fd), \"pose-index\")\n458\t \tif _, err := f.Write(raw); err != nil {\n459\t \t\tf.Close()\n460\t-\t\treturn func() {}, err\n461\t+\t\treturn privateIndexCopy(cmd, raw, modTime) // review round 1, N8\n462\t \t}\n463\t \tif _, err := f.Seek(0, 0); err != nil {\n464\t \t\tf.Close()\n465\t-\t\treturn func() {}, err\n466\t+\t\treturn privateIndexCopy(cmd, raw, modTime)\n467\t \t}\n468\t \tts := unix.NsecToTimespec(modTime.UnixNano())\n469\t-\tif err := unix.UtimesNanoAt(unix.AT_FDCWD, fmt.Sprintf(\"/proc/self/fd/%d\", fd), []unix.Timespec{ts, ts}, 0); err != nil {\n470\t+\tif err := utimesNanoAt(unix.AT_FDCWD, fmt.Sprintf(\"/proc/self/fd/%d\", fd), []unix.Timespec{ts, ts}, 0); err != nil {\n471\t+\t\t// Without /proc the memory file cannot carry the time, nor be named\n472\t+\t\t// to Git: the private copy is read instead (review round 5, N27).\n473\t \t\tf.Close()\n474\t-\t\treturn func() {}, fmt.Errorf(\"pose: the in-memory index cannot keep the index's time: %w\", err)\n475\t+\t\treturn privateIndexCopy(cmd, raw, modTime)\n476\t \t}\n477\t \tcmd.ExtraFiles = append(cmd.ExtraFiles, f)\n478\t \tcmd.Env = append(cmd.Env, fmt.Sprintf(\"GIT_INDEX_FILE=/proc/self/fd/%d\", 2+len(cmd.ExtraFiles)))\n479\t \treturn func() { f.Close() }, nil\n480\t }\n481\t+\n482\t+// memfdCreate and utimesNanoAt are the calls the memory file needs; a test\n483\t+// replaces them to exercise the fallback (review round 1, N4).\n484\t+var (\n485\t+\tmemfdCreate  = unix.MemfdCreate\n486\t+\tutimesNanoAt = unix.UtimesNanoAt\n487\t+)\n488\tdiff --git a/pose-mcp/internal/pose/git_worktree_reads_linux_test.go b/pose-mcp/internal/pose/git_worktree_reads_linux_test.go\n489\tnew file mode 100644\n490\tindex 00000000..eac133aa\n491\t--- /dev/null\n492\t+++ b/pose-mcp/internal/pose/git_worktree_reads_linux_test.go\n493\t@@ -0,0 +1,55 @@\n494\t+//go:build linux\n495\t+\n496\t+package pose\n497\t+\n498\t+import (\n499\t+\t\"bytes\"\n500\t+\t\"errors\"\n501\t+\t\"os\"\n502\t+\t\"path/filepath\"\n503\t+\t\"testing\"\n504\t+\n505\t+\t\"golang.org/x/sys/unix\"\n506\t+)\n507\t+\n508\t+// Spec pose-validate-read-only-index-followups R4 (review round 1, N4): when\n509\t+// no memory file can be made, or it cannot carry the index's time, the read\n510\t+// falls back to the private copy, answers and leaves the index.\n511\t+func TestReadOnlyIndexFallsBackWithoutAMemoryFile(t *testing.T) {\n512\t+\tfor _, broken := range []string{\"memfd\", \"utimes\"} {\n513\t+\t\tt.Run(broken, func(t *testing.T) {\n514\t+\t\t\tsaveMemfd, saveUtimes := memfdCreate, utimesNanoAt\n515\t+\t\t\tdefer func() { memfdCreate, utimesNanoAt = saveMemfd, saveUtimes }()\n516\t+\t\t\tif broken == \"memfd\" {\n517\t+\t\t\t\tmemfdCreate = func(string, int) (int, error) { return -1, errors.New(\"no memfd here\") }\n518\t+\t\t\t} else {\n519\t+\t\t\t\tutimesNanoAt = func(int, string, []unix.Timespec, int) error { return errors.New(\"no /proc here\") }\n520\t+\t\t\t}\n521\t+\t\t\ttop, _ := staleRepo(t, \"\")\n522\t+\t\t\tbefore, err := os.ReadFile(filepath.Join(top, \".git\", \"index\"))\n523\t+\t\t\tif err != nil {\n524\t+\t\t\t\tt.Fatal(err)\n525\t+\t\t\t}\n526\t+\t\t\tout, err := RawGitDiffReadOnly(top, \"-C\", top, \"diff\", \"--name-only\", \"--\")\n527\t+\t\t\tif err != nil || len(out) != 0 {\n528\t+\t\t\t\tt.Fatalf(\"the fallback answered %q %v\", out, err)\n529\t+\t\t\t}\n530\t+\t\t\tif after, _ := os.ReadFile(filepath.Join(top, \".git\", \"index\")); !bytes.Equal(before, after) {\n531\t+\t\t\t\tt.Fatal(\"the fallback read rewrote .git/index\")\n532\t+\t\t\t}\n533\t+\t\t})\n534\t+\t}\n535\t+}\n536\t+\n537\t+// Review round 2, N16: a failure handing the index to git, here with neither\n538\t+// a memory file nor a usable temporary directory, is an index failure.\n539\t+func TestAFailedIndexHandOverIsAnIndexFailure(t *testing.T) {\n540\t+\ttop, _ := staleRepo(t, \"\")\n541\t+\tsave := memfdCreate\n542\t+\tdefer func() { memfdCreate = save }()\n543\t+\tmemfdCreate = func(string, int) (int, error) { return -1, errors.New(\"no memfd here\") }\n544\t+\tt.Setenv(\"TMPDIR\", filepath.Join(t.TempDir(), \"missing\"))\n545\t+\tif _, err := RawGitDiffReadOnly(top, \"-C\", top, \"diff\", \"--name-only\", \"--\"); !errors.Is(err, ErrIndexUnreadable) {\n546\t+\t\tt.Fatalf(\"a failed hand-over: %v\", err)\n547\t+\t}\n548\t+}\n549\tdiff --git a/pose-mcp/internal/pose/git_worktree_reads_other.go b/pose-mcp/internal/pose/git_worktree_reads_other.go\n550\tindex 6cb7e722..2cd09871 100644\n551\t--- a/pose-mcp/internal/pose/git_worktree_reads_other.go\n552\t+++ b/pose-mcp/internal/pose/git_worktree_reads_other.go\n553\t@@ -3,31 +3,11 @@\n554\t package pose\n555\t \n556\t import (\n557\t-\t\"os\"\n558\t \t\"os/exec\"\n559\t-\t\"path/filepath\"\n560\t \t\"time\"\n561\t )\n562\t \n563\t-// readOnlyIndexFor hands raw to cmd as a private copy: Git refreshes and may\n564\t-// rewrite the copy, never the checkout's index.\n565\t+// readOnlyIndexFor reads a private copy where no memory file exists.\n566\t func readOnlyIndexFor(cmd *exec.Cmd, raw []byte, modTime time.Time) (func(), error) {\n567\t-\tdir, err := os.MkdirTemp(\"\", \"pose-index-*\")\n568\t-\tif err != nil {\n569\t-\t\treturn func() {}, err\n570\t-\t}\n571\t-\tdone := func() { _ = os.RemoveAll(dir) }\n572\t-\tpath := filepath.Join(dir, \"index\")\n573\t-\tif err := os.WriteFile(path, raw, 0o600); err != nil {\n574\t-\t\tdone()\n575\t-\t\treturn func() {}, err\n576\t-\t}\n577\t-\tif err := os.Chtimes(path, modTime, modTime); err != nil {\n578\t-\t\tdone()\n579\t-\t\treturn func() {}, err\n580\t-\t}\n581\t-\t// A split index would write a new shared index into .git.\n582\t-\tcmd.Args = append([]string{cmd.Args[0], \"-c\", \"core.splitIndex=false\"}, cmd.Args[1:]...)\n583\t-\tcmd.Env = append(cmd.Env, \"GIT_INDEX_FILE=\"+path)\n584\t-\treturn done, nil\n585\t+\treturn privateIndexCopy(cmd, raw, modTime)\n586\t }\n587\tdiff --git a/pose-mcp/internal/pose/git_worktree_reads_test.go b/pose-mcp/internal/pose/git_worktree_reads_test.go\n588\tindex f3fe6224..6686d8fd 100644\n589\t--- a/pose-mcp/internal/pose/git_worktree_reads_test.go\n590\t+++ b/pose-mcp/internal/pose/git_worktree_reads_test.go\n591\t@@ -2,6 +2,8 @@ package pose\n592\t \n593\t import (\n594\t \t\"bytes\"\n595\t+\t\"context\"\n596\t+\t\"errors\"\n597\t \t\"os\"\n598\t \t\"os/exec\"\n599\t \t\"path/filepath\"\n600\t@@ -214,3 +216,235 @@ func TestReadOnlyIndexRefusesAFIFOIndex(t *testing.T) {\n601\t \t\tt.Fatal(\"reading a FIFO index blocked\")\n602\t \t}\n603\t }\n604\t+\n605\t+// staleRepo is a committed repository whose index has a stale stat cache,\n606\t+// with its POSE root optionally below the repository top.\n607\t+func staleRepo(t *testing.T, sub string) (string, string) {\n608\t+\tt.Helper()\n609\t+\ttop := t.TempDir()\n610\t+\troot := filepath.Join(top, sub)\n611\t+\tif err := os.MkdirAll(root, 0o755); err != nil {\n612\t+\t\tt.Fatal(err)\n613\t+\t}\n614\t+\tgit := func(args ...string) {\n615\t+\t\tt.Helper()\n616\t+\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", top, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\"}, args...)...).CombinedOutput(); err != nil {\n617\t+\t\t\tt.Fatal(args, err, string(out))\n618\t+\t\t}\n619\t+\t}\n620\t+\tgit(\"init\", \"-q\")\n621\t+\tfile := filepath.Join(root, \"a.txt\")\n622\t+\tif err := os.WriteFile(file, []byte(\"x\\n\"), 0o644); err != nil {\n623\t+\t\tt.Fatal(err)\n624\t+\t}\n625\t+\tgit(\"add\", \"-A\")\n626\t+\tgit(\"commit\", \"-q\", \"-m\", \"i\")\n627\t+\tlater := time.Now().Add(2 * time.Second)\n628\t+\tif err := os.Chtimes(file, later, later); err != nil {\n629\t+\t\tt.Fatal(err)\n630\t+\t}\n631\t+\treturn top, root\n632\t+}\n633\t+\n634\t+// Spec pose-validate-read-only-index-followups R1: an index another process\n635\t+// replaces atomically while it is read is read whole, never refused.\n636\t+func TestReadOnlyIndexToleratesAnAtomicallyReplacedIndex(t *testing.T) {\n637\t+\ttop, _ := staleRepo(t, \"\")\n638\t+\tindex := filepath.Join(top, \".git\", \"index\")\n639\t+\traw, err := os.ReadFile(index)\n640\t+\tif err != nil {\n641\t+\t\tt.Fatal(err)\n642\t+\t}\n643\t+\tstop := make(chan struct{})\n644\t+\tgo func() {\n645\t+\t\tfor i := 0; ; i++ {\n646\t+\t\t\tselect {\n647\t+\t\t\tcase <-stop:\n648\t+\t\t\t\treturn\n649\t+\t\t\tdefault:\n650\t+\t\t\t}\n651\t+\t\t\ttmp := index + \".swap\"\n652\t+\t\t\tif os.WriteFile(tmp, raw, 0o644) == nil {\n653\t+\t\t\t\t_ = os.Rename(tmp, index)\n654\t+\t\t\t}\n655\t+\t\t}\n656\t+\t}()\n657\t+\tdefer close(stop)\n658\t+\tfor i := 0; i < 300; i++ {\n659\t+\t\tif _, err := RawGitDiffReadOnly(top, \"-C\", top, \"diff\", \"--name-only\", \"--\"); err != nil {\n660\t+\t\t\tt.Fatalf(\"read %d refused a replaced index: %v\", i, err)\n661\t+\t\t}\n662\t+\t}\n663\t+}\n664\t+\n665\t+// Spec pose-validate-read-only-index-followups R3: the index is located\n666\t+// without `--path-format`, also from a POSE root below the repository top,\n667\t+// so the read is protected there and leaves the index alone.\n668\t+func TestReadOnlyIndexFindsTheIndexFromASubdirectory(t *testing.T) {\n669\t+\ttop, root := staleRepo(t, \"proj\")\n670\t+\tbefore, err := os.ReadFile(filepath.Join(top, \".git\", \"index\"))\n671\t+\tif err != nil {\n672\t+\t\tt.Fatal(err)\n673\t+\t}\n674\t+\tif _, err := RawGitDiffReadOnly(root, \"-C\", root, \"diff\", \"--name-only\", \"--\"); err != nil {\n675\t+\t\tt.Fatal(err)\n676\t+\t}\n677\t+\tif after, _ := os.ReadFile(filepath.Join(top, \".git\", \"index\")); !bytes.Equal(before, after) {\n678\t+\t\tt.Fatal(\"a read from a subdirectory rewrote .git/index\")\n679\t+\t}\n680\t+}\n681\t+\n682\t+// Spec pose-validate-read-only-index-followups R4: the private copy the\n683\t+// memory file falls back to answers as the plain diff and leaves the index.\n684\t+func TestThePrivateIndexCopyLeavesTheIndexAlone(t *testing.T) {\n685\t+\ttop, _ := staleRepo(t, \"\")\n686\t+\tindex := filepath.Join(top, \".git\", \"index\")\n687\t+\tbefore, err := os.ReadFile(index)\n688\t+\tif err != nil {\n689\t+\t\tt.Fatal(err)\n690\t+\t}\n691\t+\tinfo, err := os.Stat(index)\n692\t+\tif err != nil {\n693\t+\t\tt.Fatal(err)\n694\t+\t}\n695\t+\tcmd := RawGit(\"-C\", top, \"diff\", \"--name-only\", \"--\")\n696\t+\tdone, err := privateIndexCopy(cmd, before, info.ModTime())\n697\t+\tif err != nil {\n698\t+\t\tt.Fatal(err)\n699\t+\t}\n700\t+\tout, err := cmd.Output()\n701\t+\tdone()\n702\t+\tif err != nil || len(out) != 0 {\n703\t+\t\tt.Fatalf(\"the copy answered %q %v\", out, err)\n704\t+\t}\n705\t+\tif after, _ := os.ReadFile(index); !bytes.Equal(before, after) {\n706\t+\t\tt.Fatal(\"the private copy read rewrote .git/index\")\n707\t+\t}\n708\t+}\n709\t+\n710\t+// Spec pose-validate-read-only-index-followups R6: unmerged entries, a\n711\t+// two-revision range and a dirty submodule answer as the plain diff, and\n712\t+// concurrent review history reads never change the index.\n713\t+func TestReadOnlyIndexDiffCoversConflictsRangesAndDirtySubmodules(t *testing.T) {\n714\t+\troot := t.TempDir()\n715\t+\trun := func(dir string, args ...string) string {\n716\t+\t\tt.Helper()\n717\t+\t\tout, err := exec.Command(\"git\", append([]string{\"-C\", dir, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"-c\", \"protocol.file.allow=always\"}, args...)...).CombinedOutput()\n718\t+\t\tif err != nil && !strings.Contains(strings.Join(args, \" \"), \"merge\") {\n719\t+\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n720\t+\t\t}\n721\t+\t\treturn string(out)\n722\t+\t}\n723\t+\tsub := t.TempDir()\n724\t+\trun(sub, \"init\", \"-q\")\n725\t+\tif err := os.WriteFile(filepath.Join(sub, \"s.txt\"), []byte(\"1\\n\"), 0o644); err != nil {\n726\t+\t\tt.Fatal(err)\n727\t+\t}\n728\t+\trun(sub, \"add\", \"s.txt\")\n729\t+\trun(sub, \"commit\", \"-q\", \"-m\", \"s\")\n730\t+\trun(root, \"init\", \"-q\", \"-b\", \"main\")\n731\t+\tif err := os.WriteFile(filepath.Join(root, \"c.txt\"), []byte(\"base\\n\"), 0o644); err != nil {\n732\t+\t\tt.Fatal(err)\n733\t+\t}\n734\t+\trun(root, \"add\", \"c.txt\")\n735\t+\trun(root, \"submodule\", \"add\", \"-q\", sub, \"mod\")\n736\t+\trun(root, \"commit\", \"-q\", \"-m\", \"base\")\n737\t+\tfirst := strings.TrimSpace(run(root, \"rev-parse\", \"HEAD\"))\n738\t+\trun(root, \"checkout\", \"-q\", \"-b\", \"other\")\n739\t+\tif err := os.WriteFile(filepath.Join(root, \"c.txt\"), []byte(\"other\\n\"), 0o644); err != nil {\n740\t+\t\tt.Fatal(err)\n741\t+\t}\n742\t+\trun(root, \"commit\", \"-q\", \"-am\", \"other\")\n743\t+\trun(root, \"checkout\", \"-q\", \"main\")\n744\t+\tif err := os.WriteFile(filepath.Join(root, \"c.txt\"), []byte(\"main\\n\"), 0o644); err != nil {\n745\t+\t\tt.Fatal(err)\n746\t+\t}\n747\t+\trun(root, \"commit\", \"-q\", \"-am\", \"main\")\n748\t+\trun(root, \"merge\", \"-q\", \"other\")\n749\t+\tif err := os.WriteFile(filepath.Join(root, \"mod\", \"s.txt\"), []byte(\"dirty\\n\"), 0o644); err != nil {\n750\t+\t\tt.Fatal(err)\n751\t+\t}\n752\t+\tsecond := strings.TrimSpace(run(root, \"rev-parse\", \"HEAD\"))\n753\t+\t// A tracked file whose stat cache is made stale before every read, so a\n754\t+\t// read that refreshes the index would write it (review round 1, N5).\n755\t+\tstale := filepath.Join(root, \"c.txt\")\n756\t+\tstaleAgain := func(i int) {\n757\t+\t\tlater := time.Now().Add(time.Duration(2+i) * time.Second)\n758\t+\t\tif err := os.Chtimes(stale, later, later); err != nil {\n759\t+\t\t\tt.Fatal(err)\n760\t+\t\t}\n761\t+\t\tlater = later.Add(time.Second)\n762\t+\t\tif err := os.Chtimes(filepath.Join(root, \".gitmodules\"), later, later); err != nil {\n763\t+\t\t\tt.Fatal(err)\n764\t+\t\t}\n765\t+\t}\n766\t+\tfor i, args := range [][]string{\n767\t+\t\t{\"-C\", root, \"diff\", \"--name-status\", \"--no-renames\", \"--ignore-submodules=none\", \"HEAD\", \"--\"},\n768\t+\t\t{\"-C\", root, \"diff\", \"--name-only\", \"-z\", \"--no-renames\", first, second, \"--\"},\n769\t+\t\t{\"-C\", root, \"diff\", \"--name-only\", \"--ignore-submodules=none\", first, \"--\"},\n770\t+\t} {\n771\t+\t\tstaleAgain(i)\n772\t+\t\tbefore, _ := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n773\t+\t\tgot, err := RawGitDiffReadOnly(root, args...)\n774\t+\t\tif err != nil {\n775\t+\t\t\tt.Fatalf(\"%v: %v\", args, err)\n776\t+\t\t}\n777\t+\t\tif after, _ := os.ReadFile(filepath.Join(root, \".git\", \"index\")); !bytes.Equal(before, after) {\n778\t+\t\t\tt.Fatalf(\"%v rewrote .git/index\", args)\n779\t+\t\t}\n780\t+\t\twant, _ := RawGit(args...).Output()\n781\t+\t\tif !bytes.Equal(got, want) {\n782\t+\t\t\tt.Fatalf(\"%v answered %q, the plain diff %q\", args, got, want)\n783\t+\t\t}\n784\t+\t}\n785\t+\tstaleAgain(9)\n786\t+\tbefore, _ := os.ReadFile(filepath.Join(root, \".git\", \"index\"))\n787\t+\terrs := make(chan error, 8)\n788\t+\tfor i := 0; i < 8; i++ {\n789\t+\t\tgo func() {\n790\t+\t\t\t_, err := reviewHistoryGit(root, \"diff\", \"HEAD\", \"--name-status\", \"--no-renames\", \"--diff-filter=MDT\", \"--\")\n791\t+\t\t\terrs <- err\n792\t+\t\t}()\n793\t+\t}\n794\t+\tfor i := 0; i < 8; i++ {\n795\t+\t\tif err := <-errs; err != nil {\n796\t+\t\t\tt.Fatal(err)\n797\t+\t\t}\n798\t+\t}\n799\t+\tif after, _ := os.ReadFile(filepath.Join(root, \".git\", \"index\")); !bytes.Equal(before, after) {\n800\t+\t\tt.Fatal(\"concurrent review history reads changed .git/index\")\n801\t+\t}\n802\t+}\n803\t+\n804\t+// Review round 2, N13–N16: Git's message is kept on one bounded line, an\n805\t+// index refusal is told from a revision named after the index, a lookup\n806\t+// outside a repository is not an index failure, and the lookup honours the\n807\t+// caller's context.\n808\t+func TestGitReadErrorsNameTheirCause(t *testing.T) {\n809\t+\t// A warning first does not hide the cause; all of it is one line.\n810\t+\terr := GitReadError(\"git diff\", errors.New(\"exit status 128\"), []byte(\"warning: Found errors in 'diff.dirstat' config variable:\\nfatal: index file corrupt\\n\"))\n811\t+\tif !strings.Contains(err.Error(), \"fatal: index file corrupt\") || strings.Contains(err.Error(), \"\\n\") {\n812\t+\t\tt.Fatalf(\"the cause behind a warning: %q\", err