egrity.go:1000:\t\tfor _, observed := range paths {\npose-mcp/internal/cli/artifact_integrity.go:1020:\t\tfor _, observed := range paths {\npose-mcp/internal/cli/artifact_integrity_test.go:42:\twriteArtifactTestFile(t, root, \".pose/policy/artifacts.json\", `{\"schema_version\":1,\"enabled\":true,\"adopted_at\":\"2026-08-03\",\"governed_roots\":[\"internal\"],\"severities\":{\"action-mismatch\":\"error\",\"undeclared\":\"error\",\"orphan\":\"warning\"}}`)\npose-mcp/internal/cli/artifact_integrity_test.go:91:// When observed exceeds claims, the first question is which revisions were\npose-mcp/internal/cli/artifact_integrity_test.go:330:\t\tt.Fatalf(\"expected exactly 2 observed paths for alpha, got: %+v\", set.Paths)\n211:    \"pose-federated-carried-forward-proof\": \"sha256:030abec82df0286f4ff7401b7b3e83ffa85dda30bb7a098c5ae5052738d95d1f\",\n399:    \"pose-seal-names-carried-forward-evidence\": \"sha256:9c9b4073b2c47acde1357f5f6a6915bfc7737476bede3496d8efa5707216b4dd\",\n693:    \"pose-federated-carried-forward-proof\": \"sha256:541c5cfcbf6e29f43c65f0ef156024e2f74b60212c9c64e354117cbe37eeb473\",\n881:    \"pose-seal-names-carried-forward-evidence\": \"sha256:73202188bb9e94d1d9cb195d8c85237694875afd1d7e58c76e99ac51d1489c4c\",\n978:  \"material_clean\": true,\nrg: pose-mcp/internal/cli/artifact.go: IO error for operation on pose-mcp/internal/cli/artifact.go: No such file or directory (os error 2)\n","exit_code":0,"status":"completed"}}
