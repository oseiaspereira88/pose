{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/cli/validate_carry.go'","aggregated_output":"package cli\n\n// Carried checks (spec pose-validate-carries-unchanged-checks): with a\n// comparable canonical result as base, validate --carry runs the modules the\n// changed scope selects between the base head and HEAD and carries the base\n// results of every other module, each stating the head it ran at. Any doubt\n// about the base runs everything and records why (R2).\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path\"\n\t\"path/filepath\"\n\t\"runtime/debug\"\n\t\"sort\"\n\t\"strings\"\n\t\"unicode\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"github.com/harne8/pose-mcp/internal/version\"\n)\n\n// carryRecord is the run's account of its base (R5).\ntype carryRecord struct {\n\tUsed     bool              `json:\"used\"`\n\tReason   string            `json:\"reason,omitempty\"`\n\tBaseHead string            `json:\"base_head,omitempty\"`\n\tChanged  int               `json:\"changed\"`\n\tSelected map[string]string `json:\"selected,omitempty\"`\n}\n\n// carryPlan is what a usable base lets the run reuse.\ntype carryPlan struct {\n\trecord    *carryRecord\n\tselection *scopeSelection\n\tbase      map[string]checkResult\n\tbaseHead  string\n\tbaseTime  string\n}\n\n// carried reports whether module's checks come from the base.\nfunc (p carryPlan) carried(module string) bool {\n\tif p.selection == nil {\n\t\treturn false\n\t}\n\t_, selected := p.selection.Selected[module]\n\treturn !selected\n}\n\n// carriedResult is the base result of a check as this run records it (R4):\n// unchanged, plus where and when it really ran, kept through chained carries.\nfunc (p carryPlan) carriedResult(id string) checkResult {\n\tresult := p.base[id]\n\tif result.CarriedFrom == \"\" {\n\t\tresult.CarriedFrom, result.CarriedGeneratedAt = p.baseHead, p.baseTime\n\t}\n\treturn result\n}\n\n// planCarry judges the canonical result at resultsPath as a base. A nil\n// selection means every check runs; the record says why.\nfunc planCarry(root, resultsPath, mode, matrixSHA, head string, matrix validationMatrix, modules []validationModule) carryPlan {\n\tplan := carryPlan{record: &carryRecord{}}\n\tengine, engineVerifiable := engineIdentityFrom(debug.ReadBuildInfo())\n\tunused := func(format string, args ...any) carryPlan {\n\t\tplan.record.Reason = fmt.Sprintf(format, args...)\n\t\treturn plan\n\t}\n\traw, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(resultsPath)))\n\tif err != nil {\n\t\treturn unused(\"no canonical result at %s\", resultsPath)\n\t}\n\tvar base validationRunResult\n\tif err := json.Unmarshal(raw, &base); err != nil || base.SchemaVersion != validationResultSchema {\n\t\treturn unused(\"the canonical result is unreadable or has another schema\")\n\t}\n\tswitch {\n\tcase base.ModuleFilter != \"\" || base.StackFilter != \"\":\n\t\treturn unused(\"the canonical result was filtered by module or stack, so it is not comparable\")\n\tcase base.Mode != mode:\n\t\treturn unused(\"the canonical result ran in mode %q, this run is %q\", base.Mode, mode)\n\tcase base.MatrixSHA256 != matrixSHA:\n\t\treturn unused(\"the validation matrix changed since the canonical result\")\n\tcase !engineVerifiable:\n\t\treturn unused(\"this engine build was modified from its recorded revision, so its identity cannot be compared\")\n\tcase base.EngineVersion == \"\" || base.EngineVersion != engine || strings.HasSuffix(base.EngineVersion, \".dirty\"):\n\t\treturn unused(\"the engine version differs from the canonical result's or was not recorded\")\n\tcase base.GitHead == \"\" || !safeGitRevRE.MatchString(base.GitHead):\n\t\treturn unused(\"the canonical result records no usable head\")\n\tcase head == \"\" || !safeGitRevRE.MatchString(head):\n\t\treturn unused(\"the current head cannot be read\")\n\t}\n\tif base.Cancelled {\n\t\treturn unused(\"the canonical result was cancelled\")\n\t}\n\tfor _, check := range base.Checks {\n\t\tif check.LimitState == \"cancelled\" {\n\t\t\treturn unused(\"the canonical result was cancelled\")\n\t\t}\n\t}\n\t// The base must have validated the commit it records: a run over a working\n\t// copy that differed from its head proves nothing about that head.\n\tif !base.MaterialClean {\n\t\treturn unused(\"the canonical result did not validate a clean working copy of its head\")\n\t}\n\tfor _, binding := range base.MaterialProvenance {\n\t\tif binding == posemodel.MaterialBindingUnavailable {\n\t\t\treturn unused(\"the canonical result records an unavailable material binding\")\n\t\t}\n\t}\n\tif !materialWorktreeClean(root) {\n\t\treturn unused(\"the working copy differs from HEAD in material paths\")\n\t}\n\t// Selection is lexical: a module reached through a symlink aliases another\n\t// path, so its inputs cannot be told apart (review round 4, N9).\n\t// Two modules sharing one physical directory (a case alias on a\n\t// case-insensitive filesystem) alias each other too (review round 5, N13).\n\tif reason := aliasedModule(modules, filepath.EvalSymlinks, os.Stat); reason != \"\" {\n\t\treturn unused(\"%s\", reason)\n\t}\n\t// Lexical selection cannot see through aliases. Rather than chase every\n\t// alias form (review rounds 4–7, N9, N13, N16–N18), a carry needs a\n\t// case-sensitive filesystem and no tracked symlink that links a module\n\t// (other than the root) or a declared dependency with any other path.\n\t// Module metadata is an administrative record, outside the cleanliness\n\t// check, so the selection policy must be the pinned head's (review round\n\t// 16, N46).\n\tif differs, err := workingFileDiffersFromHead(root, head, \".pose/indexes/module-metadata.json\"); err != nil || differs {\n\t\treturn unused(\"the working module metadata differs from HEAD's, so the selection policy is not the pinned one\")\n\t}\n\tmeta, err := loadScopeMetadata(root)\n\tif err != nil {\n\t\treturn unused(\"changed-scope selection failed: %v\", err)\n\t}\n\t// Symlinks inside a submodule hide behind its gitlink (review round 8,\n\t// N20): scan each checked-out submodule at its recorded commit, and refuse\n\t// when a module or a dependency lies in one that cannot be scanned.\n\tif reason, err := submoduleAliases(root, head, modules, meta); err != nil {\n\t\treturn unused(\"submodules cannot be read: %v\", err)\n\t} else if reason != \"\" {\n\t\treturn unused(\"%s\", reason)\n\t}\n\tif link, err := aliasingSymlink(root, head, modules, meta); err != nil {\n\t\treturn unused(\"tracked symlinks cannot be read: %v\", err)\n\t} else if link != \"\" {\n\t\treturn unused(\"the tree tracks symlink %s into or out of a module or a declared dependency, so changes cannot be attributed\", link)\n\t}\n\t// A declared dependency outside the repository changes without any change\n\t// the selection can see (review round 10, N28).\n\tfor rel, module := range meta.Modules {\n\t\tfor _, dep := range module.DependsOn {\n\t\t\tclean := filepath.ToSlash(filepath.Clean(dep))\n\t\t\tif filepath.IsAbs(dep) || path.IsAbs(clean) || clean == \"..\" || strings.HasPrefix(clean, \"../\") {\n\t\t\t\treturn unused(\"dependency %s of module %s lies outside the repository, so its changes cannot be seen\", dep, rel)\n\t\t\t}\n\t\t\t// A path that is not already clean can traverse a symlink before\n\t\t\t// its \"..\" is applied (review round 11, N30).\n\t\t\tif filepath.ToSlash(dep) != clean {\n\t\t\t\treturn unused(\"dependency %s of module %s is not a clean path, so its physical identity cannot be established\", dep, rel)\n\t\t\t}\n\t\t\t// Non-ASCII names can alias under Unicode normalization (review\n\t\t\t// round 11, N32).\n\t\t\tif !asciiPath(clean) {\n\t\t\t\treturn unused(\"dependency %s of module %s is not an ASCII path, so normalization aliases cannot be ruled out\", dep, rel)\n\t\t\t}\n\t\t\t// Its physical identity, through any symlink tracked or ignored,\n\t\t\t// must be its spelling (review round 12, N33).\n\t\t\tif !physicallyLexical(root, clean) {\n\t\t\t\treturn unused(\"dependency %s of module %s resolves through a symlink, so its changes cannot be attributed\", dep, rel)\n\t\t\t}\n\t\t}\n\t}\n\tfor _, m := range modules {\n\t\tif !asciiPath(m.Rel) {\n\t\t\treturn unused(\"module %s is not an ASCII path, so normalization aliases cannot be ruled out\", m.Rel)\n\t\t}\n\t}\n\tif sub := submodulesCheckedOut(root, head); sub != \"\" {\n\t\treturn unused(\"submodule %s is not checked out at its recorded commit\", sub)\n\t}\n\t// Index flags that hide tracked edits from status (review round 11, N31).\n\tif hidden, err := hiddenIndexEntries(root, head); err != nil {\n\t\treturn unused(\"the index cannot be read: %v\", err)\n\t} else if hidden != \"\" {\n\t\treturn unused(\"%s is marked assume-unchanged or skip-worktree, so the working copy cannot be compared\", hidden)\n\t}\n\tif caseInsensitiveFilesystem(root, os.Stat) {\n\t\treturn unused(\"the filesystem is case-insensitive, so changes cannot be attributed to modules\")\n\t}\n\t// A case-folded directory inside a case-sensitive filesystem is an alias\n\t// too (review round 8, N22).\n\tfor _, dir := range carryRelevantDirs(root, modules, meta) {\n\t\tif casefoldedDirectory(dir, os.ReadDir, os.Lstat) {\n\t\t\treturn unused(\"directory %s folds case, so changes cannot be attributed to modules\", dir)\n\t\t}\n\t}\n\t// Check ids must be unique: two checks sharing an id would share one base\n\t// result (review round 7, N19).\n\tif id := duplicateCheckID(matrix, modules); id != \"\" {\n\t\treturn unused(\"the matrix defines check %s more than once\", id)\n\t}\n\tbaseIDs := map[string]bool{}\n\tfor _, check := range base.Checks {\n\t\tif baseIDs[check.ID] {\n\t\t\treturn unused(\"the canonical result records check %s more than once\", check.ID)\n\t\t}\n\t\tbaseIDs[check.ID] = true\n\t}\n\tif err := posemodel.RawGit(\"-C\", root, \"merge-base\", \"--is-ancestor\", base.GitHead, head).Run(); err != nil {\n\t\treturn unused(\"the canonical result's head %s is not an ancestor of HEAD\", base.GitHead)\n\t}\n\tselection, err := computeChangedScope(root, base.GitHead, head, modules, carryExclusions(root, base.GitHead, head, resultsPath)...)\n\tif err != nil {\n\t\treturn unused(\"changed-scope selection failed: %v\", err)\n\t}\n\tplan.base = map[string]checkResult{}\n\tfor _, check := range base.Checks {\n\t\tplan.base[check.ID] = check\n\t}\n\t// A module whose checks are not all in the base runs (R3).\n\tfor _, module := range modules {\n\t\tif _, selected := selection.Selected[module.Rel]; selected {\n\t\t\tcontinue\n\t\t}\n\t\tstack, checks, _ := moduleValidationChecks(module, matrix, \"\", \"\")\n\t\tfor _, check := range checks {\n\t\t\tif check.Program == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tid := module.Rel + \"/\" + stack + \"/\" + check.Name\n\t\t\tif prior, ok := plan.base[id]; !ok || prior.Outcome == \"skipped\" || prior.Outcome == \"\" {\n\t\t\t\tselection.Selected[module.Rel] = \"carry: no prior result for \" + id\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t}\n\tplan.selection, plan.baseHead, plan.baseTime = &selection, base.GitHead, base.GeneratedAt\n\tplan.record.Used, plan.record.BaseHead, plan.record.Changed, plan.record.Selected = true, base.GitHead, len(selection.Changed), selection.Selected\n\treturn plan\n}\n\n// carryExclusions are the changed paths that are not changes for the carry\n// selection (R3): the canonical result itself and the derived administrative\n// records of the engine's closed list (the same classes material bindings\n// ignore) that are still regular files, or gone, at HEAD. A symlink,\n// submodule or directory in a class stays a change.\nfunc carryExclusions(root, base, head, resultsPath string) []string {\n\texclude := []string{resultsPath}\n\tout, err := posemodel.RawGit(\"-C\", root, \"-c\", \"diff.ignoreSubmodules=none\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"-z\", \"--no-renames\", base, head, \"--\").Output()\n\tif err != nil {\n\t\treturn exclude\n\t}\n\tfor _, file := range strings.Split(string(out), \"\\x00\") {\n\t\tfile = filepath.ToSlash(file)\n\t\tif file == \"\" || !posemodel.IsAdministrativePath(file) {\n\t\t\tcontinue\n\t\t}\n\t\tentry, err := posemodel.RawGit(\"-C\", root, \"ls-tree\", \"-z\", head, \"--\", file).Output()\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tfields := strings.Fields(string(entry))\n\t\tif len(fields) == 0 || fields[0] == \"100644\" || fields[0] == \"100755\" {\n\t\t\texclude = append(exclude, file)\n\t\t}\n\t}\n\treturn exclude\n}\n\n// validationEngineIdentity names the engine that ran a validation: its version\n// plus, when the binary records it, the VCS revision it was built from, marked\n// when the build tree was modified. Development builds share a version string,\n// so the revision is what tells two of them apart (R2).\nfunc validationEngineIdentity() string {\n\tidentity, _ := engineIdentityFrom(debug.ReadBuildInfo())\n\treturn identity\n}\n\n// engineIdentityFrom builds the identity from build information. A build of a\n// modified tree is not verifiable: two such builds at one revision share an\n// identity while their code differs (review round 2, N4).\nfunc engineIdentityFrom(info *debug.BuildInfo, ok bool) (string, bool) {\n\tidentity := version.Version\n\tif !ok || info == nil {\n\t\treturn identity, true\n\t}\n\trevision, modified := \"\", false\n\tfor _, setting := range info.Settings {\n\t\tswitch setting.Key {\n\t\tcase \"vcs.revision\":\n\t\t\trevision = setting.Value\n\t\tcase \"vcs.modified\":\n\t\t\tmodified = setting.Value == \"true\"\n\t\t}\n\t}\n\tif revision != \"\" {\n\t\tidentity += \"+\" + revision\n\t\tif modified {\n\t\t\tidentity += \".dirty\"\n\t\t}\n\t}\n\treturn identity, !modified\n}\n\n// aliasedModule names a module whose changes cannot be attributed lexically:\n// one reached through a symlink, or one sharing its physical directory with\n// another module, as a case alias does on a case-insensitive filesystem\n// (review rounds 4–5, N9 and N13).\nfunc aliasedModule(modules []validationModule, resolve func(string) (string, error), stat func(string) (os.FileInfo, error)) string {\n\tseen := make([]os.FileInfo, 0, len(modules))\n\tfor _, module := range modules {\n\t\tresolved, err := resolve(module.Abs)\n\t\tif err != nil || filepath.Clean(resolved) != filepath.Clean(module.Abs) {\n\t\t\treturn fmt.Sprintf(\"module %s is reached through a symlink, so its changes cannot be attributed\", module.Rel)\n\t\t}\n\t\tinfo, err := stat(module.Abs)\n\t\tif err != nil {\n\t\t\treturn fmt.Sprintf(\"module %s cannot be read\", module.Rel)\n\t\t}\n\t\tfor _, other := range seen {\n\t\t\tif os.SameFile(info, other) {\n\t\t\t\treturn fmt.Sprintf(\"module %s shares its directory with another module, so its changes cannot be attributed\", module.Rel)\n\t\t\t}\n\t\t}\n\t\tseen = append(seen, info)\n\t}\n\treturn \"\"\n}\n\n// aliasingSymlink returns a tracked symlink that could hide a change from the\n// lexical selection: one whose path or target lies in a module other than the\n// root, or intersects a declared dependency, or whose target leaves the\n// repository. Symlinks between paths no module owns are harmless: a change on\n// either side already selects the root module and every module that is not\n// self-contained.\nfunc aliasingSymlink(root, head string, modules []validationModule, meta scopeMetadata) (string, error) {\n\treturn aliasingSymlinkIn(root, root, head, \"\", modules, meta)\n}\n\n// aliasingSymlinkIn scans the tree of the repository at repo, at commit, whose\n// paths sit under prefix in the project.\nfunc aliasingSymlinkIn(root, repo, commit, prefix string, modules []validationModule, meta scopeMetadata) (string, error) {\n\tout, err := posemodel.RawGit(\"-C\", repo, \"ls-tree\", \"-r\", \"-z\", commit).Output()\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tvar deps []string\n\tfor _, module := range meta.Modules {\n\t\tfor _, dep := range module.DependsOn {\n\t\t\tdeps = append(deps, filepath.ToSlash(filepath.Clean(dep)))\n\t\t}\n\t}\n\ttouches := func(p string) bool {\n\t\tfor _, m := range modules {\n\t\t\tif m.Rel != \".\" && (p == m.Rel || strings.HasPrefix(p, m.Rel+\"/\") || strings.HasPrefix(m.Rel, p+\"/\")) {\n\t\t\t\treturn true\n\t\t\t}\n\t\t}\n\t\tfor _, dep := range deps {\n\t\t\tif dep == \".\" || p == dep || strings.HasPrefix(p, dep+\"/\") || strings.HasPrefix(dep, p+\"/\") {\n\t\t\t\treturn true\n\t\t\t}\n\t\t}\n\t\treturn false\n\t}\n\tfor _, entry := range strings.Split(string(out), \"\\x00\") {\n\t\tif !strings.HasPrefix(entry, \"120000 \") {\n\t\t\tcontinue\n\t\t}\n\t\ttab := strings.IndexByte(entry, '\\t')\n\t\tif tab < 0 {\n\t\t\treturn \"\", fmt.Errorf(\"unexpected tree entry %q\", entry)\n\t\t}\n\t\tfields := strings.Fields(entry[:tab])\n\t\tif len(fields) != 3 {\n\t\t\treturn \"\", fmt.Errorf(\"unexpected tree entry %q\", entry)\n\t\t}\n\t\tlink := path.Join(prefix, entry[tab+1:])\n\t\tblob, err := posemodel.RawGit(\"-C\", repo, \"cat-file\", \"blob\", fields[2]).Output()\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\ttarget := string(blob)\n\t\tresolved := path.Clean(path.Join(path.Dir(link), target))\n\t\tif path.IsAbs(target) || resolved == \"..\" || strings.HasPrefix(resolved, \"../\") || touches(link) || touches(resolved) {\n\t\t\treturn link, nil\n\t\t}\n\t}\n\treturn \"\", nil\n}\n\n// caseInsensitiveFilesystem reports whether root's filesystem folds case: the\n// upper-case spelling of its .git entry names the same file.\nfunc caseInsensitiveFilesystem(root string, stat func(string) (os.FileInfo, error)) bool {\n\tlower, err := stat(filepath.Join(root, \".git\"))\n\tif err != nil {\n\t\treturn true\n\t}\n\tupper, err := stat(filepath.Join(root, \".GIT\"))\n\treturn err == nil && os.SameFile(lower, upper)\n}\n\n// duplicateCheckID returns a check id the matrix defines more than once.\nfunc duplicateCheckID(matrix validationMatrix, modules []validationModule) string {\n\tseen := map[string]bool{}\n\tfor _, module := range modules {\n\t\tstack, checks, _ := moduleValidationChecks(module, matrix, \"\", \"\")\n\t\tfor _, check := range checks {\n\t\t\tif check.Program == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tid := module.Rel + \"/\" + stack + \"/\" + check.Name\n\t\t\tif seen[id] {\n\t\t\t\treturn id\n\t\t\t}\n\t\t\tseen[id] = true\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// gitlinks lists the gitlinks of a tree: path and recorded commit.\nfunc gitlinks(repo, commit string) (map[string]string, error) {\n\tout, err := posemodel.RawGit(\"-C\", repo, \"ls-tree\", \"-r\", \"-z\", commit).Output()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tlinks := map[string]string{}\n\tfor _, entry := range strings.Split(string(out), \"\\x00\") {\n\t\tif !strings.HasPrefix(entry, \"160000 \") {\n\t\t\tcontinue\n\t\t}\n\t\ttab := strings.IndexByte(entry, '\\t')\n\t\tfields := strings.Fields(entry[:max(tab, 0)])\n\t\tif tab < 0 || len(fields) != 3 {\n\t\t\treturn nil, fmt.Errorf(\"unexpected tree entry %q\", entry)\n\t\t}\n\t\tlinks[entry[tab+1:]] = fields[2]\n\t}\n\treturn links, nil\n}\n\n// submoduleAliases names a submodule that could hide an alias: one that is\n// not checked out at its recorded commit, or that itself has gitlinks, or\n// whose tree tracks an aliasing symlink.\nfunc submoduleAliases(root, head string, modules []validationModule, meta scopeMetadata) (string, error) {\n\tlinks, err := gitlinks(root, head)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\t// Every gitlink is scanned, not only those holding a module or a\n\t// dependency: one inside a module aliases its paths too (review round 9,\n\t// N24).\n\tfor sub, commit := range links {\n\t\trepo := filepath.Join(root, filepath.FromSlash(sub))\n\t\tif err := posemodel.RawGit(\"-C\", repo, \"cat-file\", \"-e\", commit+\"^{commit}\").Run(); err != nil {\n\t\t\treturn fmt.Sprintf(\"submodule %s is not checked out at its recorded commit, so aliases in it cannot be ruled out\", sub), nil\n\t\t}\n\t\tnested, err := gitlinks(repo, commit)\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tif len(nested) > 0 {\n\t\t\treturn fmt.Sprintf(\"submodule %s has nested submodules, so aliases in it cannot be ruled out\", sub), nil\n\t\t}\n\t\tlink, err := aliasingSymlinkIn(root, repo, commit, sub, modules, meta)\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tif link != \"\" {\n\t\t\treturn fmt.Sprintf(\"the tree tracks symlink %s into or out of a module or a declared dependency, so changes cannot be attributed\", link), nil\n\t\t}\n\t}\n\treturn \"\", nil\n}\n\n// carryRelevantDirs are the directories whose case behaviour decides whether\n// lexical selection is sound: every existing directory on the path from the\n// root to each module and to each declared dependency, ancestors included,\n// since any of them can fold a lookup (review round 9, N26).\nfunc carryRelevantDirs(root string, modules []validationModule, meta scopeMetadata) []string {\n\tseen := map[string]bool{}\n\tdirs := []string{}\n\tadd := func(p string) {\n\t\troot := filepath.Clean(root)\n\t\tfor p = filepath.Clean(p); ; p = filepath.Dir(p) {\n\t\t\tif p != root && !strings.HasPrefix(p, root+string(filepath.Separator)) {\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif info, err := os.Stat(p); err == nil && info.IsDir() && !seen[p] {\n\t\t\t\tseen[p] = true\n\t\t\t\tdirs = append(dirs, p)\n\t\t\t}\n\t\t\tif p == root {\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t}\n\tfor _, m := range modules {\n\t\tadd(m.Abs)\n\t}\n\tfor _, module := range meta.Modules {\n\t\tfor _, dep := range module.DependsOn {\n\t\t\tadd(filepath.Join(root, filepath.FromSlash(filepath.ToSlash(filepath.Clean(dep)))))\n\t\t}\n\t}\n\tsort.Strings(dirs)\n\treturn dirs\n}\n\n// casefoldedDirectory reports whether dir looks names up without case: an\n// entry spelled with its letters' case swapped names the same file.\nfunc casefoldedDirectory(dir string, readDir func(string) ([]os.DirEntry, error), stat func(string) (os.FileInfo, error)) bool {\n\t// An unreadable directory cannot be shown not to fold. Entries are probed\n\t// without following links, and an unusable one is skipped, not taken as\n\t// proof (review round 10, N27).\n\tentries, err := readDir(dir)\n\tif err != nil {\n\t\treturn true\n\t}\n\t// Only ASCII letters swap case without Unicode folding subtleties, such\n\t// as dotless i (review round 12, N35); a directory with no such entry\n\t// cannot be shown not to fold.\n\tfor _, entry := range entries {\n\t\tname := entry.Name()\n\t\tif !asciiPath(name) || !strings.ContainsAny(name, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") {\n\t\t\tcontinue\n\t\t}\n\t\tswapped := swapCase(name)\n\t\toriginal, err := stat(filepath.Join(dir, name))\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\t// The first usable entry decides: its swapped spelling names the same\n\t\t// file only where lookups fold case.\n\t\tother, err := stat(filepath.Join(dir, swapped))\n\t\treturn err == nil && os.SameFile(original, other)\n\t}\n\treturn true\n}\n\nfunc swapCase(s string) string {\n\treturn strings.Map(func(r rune) rune {\n\t\tswitch {\n\t\tcase unicode.IsUpper(r):\n\t\t\treturn unicode.ToLower(r)\n\t\tcase unicode.IsLower(r):\n\t\t\treturn unicode.ToUpper(r)\n\t\t}\n\t\treturn r\n\t}, s)\n}\n\n// asciiPath reports whether p is plain ASCII.\nfunc asciiPath(p string) bool {\n\tfor i := 0; i < len(p); i++ {\n\t\tif p[i] >= 0x80 {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// hiddenIndexEntries returns a tracked path, in the repository or in one of\n// its checked-out submodules, whose index entry is marked assume-unchanged or\n// skip-worktree: status cannot see edits to it.\nfunc hiddenIndexEntries(root, head string) (string, error) {\n\tcheck := func(repo, prefix string) (string, error) {\n\t\tout, err := posemodel.RawGit(\"-C\", repo, \"ls-files\", \"-v\", \"-z\").Output()\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tfor _, entry := range strings.Split(string(out), \"\\x00\") {\n\t\t\tif len(entry) < 3 {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\ttag := entry[0]\n\t\t\tif (tag >= 'a' && tag <= 'z') || tag == 'S' {\n\t\t\t\treturn path.Join(prefix, entry[2:]), nil\n\t\t\t}\n\t\t}\n\t\treturn \"\", nil\n\t}\n\tif hidden, err := check(root, \"\"); err != nil || hidden != \"\" {\n\t\treturn hidden, err\n\t}\n\tlinks, err := gitlinks(root, head)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tfor sub := range links {\n\t\trepo := filepath.Join(root, filepath.FromSlash(sub))\n\t\tif _, err := os.Stat(filepath.Join(repo, \".git\")); err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tif hidden, err := check(repo, sub); err != nil || hidden != \"\" {\n\t\t\treturn hidden, err\n\t\t}\n\t}\n\treturn \"\", nil\n}\n\n// physicallyLexical reports whether rel, and every existing ancestor of it,\n// resolves to its own spelling: no symlink, tracked or not, on the way.\nfunc physicallyLexical(root, rel string) bool {\n\troot = filepath.Clean(root)\n\tresolvedRoot, err := filepath.EvalSymlinks(root)\n\tif err != nil {\n\t\treturn false\n\t}\n\tp := filepath.Join(root, filepath.FromSlash(rel))\n\tfor ; p != root && strings.HasPrefix(p, root+string(filepath.Separator)); p = filepath.Dir(p) {\n\t\tif _, err := os.Lstat(p); err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tresolved, err := filepath.EvalSymlinks(p)\n\t\tif err != nil {\n\t\t\treturn false\n\t\t}\n\t\twant := filepath.Join(resolvedRoot, strings.TrimPrefix(p, root+string(filepath.Separator)))\n\t\tif filepath.Clean(resolved) != filepath.Clean(want) {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// headReflogLength counts the entries of HEAD's reflog; -1 when it cannot be\n// read or reflogs are disabled.\nfunc headReflogLength(root string) int {\n\tout, err := posemodel.RawGit(\"-C\", root, \"reflog\", \"show\", \"--format=%H\", \"HEAD\", \"--\").Output()\n\tif err != nil {\n\t\treturn -1\n\t}\n\tlines := strings.Count(string(out), \"\\n\")\n\tif lines == 0 {\n\t\treturn -1\n\t}\n\treturn lines\n}\n\n// submodulesCheckedOut returns a gitlink of head whose working repository is\n// missing or not at the recorded commit; \"\" when every one is.\nfunc submodulesCheckedOut(root, head string) string {\n\tlinks, err := gitlinks(root, head)\n\tif err != nil {\n\t\treturn \"(gitlinks unreadable)\"\n\t}\n\tfor sub, commit := range links {\n\t\trepo := filepath.Join(root, filepath.FromSlash(sub))\n\t\tif _, err := os.Stat(filepath.Join(repo, \".git\")); err != nil {\n\t\t\treturn sub\n\t\t}\n\t\tout, err := posemodel.RawGit(\"-C\", repo, \"rev-parse\", \"HEAD\").Output()\n\t\tif err != nil || strings.TrimSpace(string(out)) != commit {\n\t\t\treturn sub\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// validationMaterialClean is the full predicate a run must satisfy at its\n// start and at its end to validate head (review rounds 8–14): no tracked or\n// untracked unignored difference in status (mode changes included), no index\n// entry hiding edits, and every submodule checked out at its recorded commit\n// (an uninitialized one reads as clean to status).\nfunc validationMaterialClean(root, head string) bool {\n\tif !materialWorktreeClean(root) {\n\t\treturn false\n\t}\n\tif hidden, err := hiddenIndexEntries(root, head); err != nil || hidden != \"\" {\n\t\treturn false\n\t}\n\tif submodulesCheckedOut(root, head) != \"\" {\n\t\treturn false\n\t}\n\t// Nested submodules are neither witnessed nor checked: a run over them\n\t// cannot claim its recorded material (review round 16, N48).\n\tlinks, err := gitlinks(root, head)\n\tif err != nil {\n\t\treturn false\n\t}\n\tfor sub, commit := range links {\n\t\tnested, err := gitlinks(filepath.Join(root, filepath.FromSlash(sub)), commit)\n\t\tif err != nil || len(nested) > 0 {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// finalizeCancellation records a cancelled run: not clean, and binding no\n// material, whatever was decided before the signal was seen (review round 16,\n// N47). It returns true for the run's cancelled field.\nfunc finalizeCancellation(run *validationRunResult) bool {\n\trun.MaterialClean = false\n\tfor spec := range run.MaterialProvenance {\n\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n\t}\n\treturn true\n}\n\n// workingFileDiffersFromHead reports whether rel in the working copy differs\n// from its blob at head; absent on both sides is equal.\nfunc workingFileDiffersFromHead(root, head, rel string) (bool, error) {\n\tworking, werr := os.ReadFile(filepath.Join(root, filepath.FromSlash(rel)))\n\tcommitted, cerr := posemodel.RawGit(\"-C\", root, \"show\", head+\":\"+rel).Output()\n\tswitch {\n\tcase errors.Is(werr, os.ErrNotExist) && cerr != nil:\n\t\treturn false, nil\n\tcase werr != nil || cerr != nil:\n\t\treturn true, nil\n\t}\n\treturn !bytes.Equal(working, committed), nil\n}\n\n// movementWitness summarizes the reflog lengths of HEAD and of every\n// checked-out submodule's HEAD; \"\" when any cannot be read, so the witness\n// never passes by default.\nfunc movementWitness(root, head string) string {\n\tparent := headReflogLength(root)\n\tif parent < 0 || head == \"\" {\n\t\treturn \"\"\n\t}\n\tparts := []string{fmt.Sprintf(\".=%d\", parent)}\n\tlinks, err := gitlinks(root, head)\n\tif err != nil {\n\t\treturn \"\"\n\t}\n\tsubs := make([]string, 0, len(links))\n\tfor sub := range links {\n\t\tsubs = append(subs, sub)\n\t}\n\tsort.Strings(subs)\n\tfor _, sub := range subs {\n\t\trepo := filepath.Join(root, filepath.FromSlash(sub))\n\t\tif _, err := os.Stat(filepath.Join(repo, \".git\")); err != nil {\n\t\t\tparts = append(parts, sub+\"=absent\")\n\t\t\tcontinue\n\t\t}\n\t\tn := headReflogLength(repo)\n\t\tif n < 0 {\n\t\t\treturn \"\"\n\t\t}\n\t\tparts = append(parts, fmt.Sprintf(\"%s=%d\", sub, n))\n\t}\n\treturn strings.Join(parts, \",\")\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc 'cat .pose/specs/2026-11-22-pose-validate-carries-unchanged-checks.md .pose/adr/2026-11-22-validate-carries-unchanged-checks.md; cat .pose/rules/documentation-style.md .pose/rules/knowledge-governance.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/bash -lc 'cat .pose/specs/2026-11-22-pose-validate-carries-unchanged-checks.md .pose/adr/2026-11-22-validate-carries-unchanged-checks.md; cat .pose/rules/documentation-style.md .pose/rules/knowledge-governance.md'","aggregated_output":"---\nslug: pose-validate-carries-unchanged-checks\nstatus: in-progress\ncreated_at: 2026-11-22\ncompleted_at:\nsupersedes:\ndepends_on: pose-changed-scope-validation, pose-validation-evidence-material-binding\nremediates:\npriority: 1\ncomponents: pose-mcp\ntask_type: feature\nsurface: standard\ndelivers:\n---\n\n# Spec: pose-validate-carries-unchanged-checks\n\n## 1. Intent\n\n### Goal\nLet `pose validate` refresh the canonical structured result by running only the checks a change can affect and carrying forward, unchanged and labelled, the results of the checks it cannot affect.\n\n### Business value\nIn the Harne8 batch of 2026-11-22, every material change to one module required the whole 72-check matrix again. Each run took about 35 minutes with three jobs. Intermittent failures in unrelated suites made roughly one run in three useless. A hooks change confined to `scripts/` needed four full runs in one review round. The canonical record is all-or-nothing today. `--changed-from` already selects the affected modules, but it writes a partial record that cannot replace the canonical one in `results_path`, so closeout still needs the full run.\n\n### Constraints\nA carried result must say where it ran. It never upgrades its outcome, so a carried failure stays a failure. Any doubt about eligibility widens to a full run, and the record states why. The selection reuses the changed-scope rules and widens them only by explicit declaration. Results and indexes written by earlier engines keep their meaning.\n\n### Non-goals\nCaching individual command outputs, hashing arbitrary inputs of a check, carrying across a matrix or engine change, and changing how review bundles seal evidence beyond reading the per-check head.\n\n## 2. Requirements\n\n### Functional\n- R1: `pose validate --carry --json-out <results_path>` shall read the canonical record at the configured `results_path` as its base. It shall be refused with exit 2 when no `results_path` is configured, when the output path is not that path, or when combined with `--module`, `--stack`, `--workspace`, `--changed-from` or `--changed-to`.\n- R2: The base shall be used only when every condition below holds. Otherwise the run shall execute every check and record `carry.used: false` with the first failing condition as `carry.reason`.\n  - Its schema, mode, `matrix_sha256` and `engine_version` equal the current run's. Neither engine build is modified from its recorded revision.\n  - Its `git_head` is an ancestor of, or equal to, `HEAD`.\n  - It was not cancelled, at run level or in any check. A signal marks the whole run `cancelled`, even when every check was carried, and leaves no material binding available.\n  - It recorded `material_clean`: one full predicate held when the head was pinned, before any plan input was read, and again when the run ended. The predicate covers status, hidden index entries and submodule checkouts. Its own working copy matched its head when it started and when it ended, HEAD did not move during the run, no untracked unignored material appeared, no index entry hid edits, neither HEAD's reflog nor any checked-out submodule's reflog grew (readable reflogs are required), mode changes counted whatever `core.fileMode` says, every submodule held its recorded commit, and none of its material bindings is unavailable. A run that did not validate its recorded head records every material binding as unavailable.\n  - The filesystem is case-sensitive, and no directory from the root to a module or a declared dependency folds case. An unreadable directory counts as folding, and so does a directory with no ASCII-letter entry to probe.\n  - No declared dependency lies outside the repository, and every one is already a clean path that resolves physically to its own spelling, through no symlink, tracked or ignored. Module and dependency paths are ASCII.\n  - No index entry, in the repository or a checked-out submodule, is marked assume-unchanged or skip-worktree. No module is reached through a symlink or shares its physical directory with another module. No tracked symlink has its path or target in a module other than the root or in a declared dependency, and no tracked target leaves the repository. This includes the tree of every submodule at its recorded commit. A submodule that cannot be scanned, because it is not checked out or has nested submodules, refuses.\n  - No check id occurs twice, in the matrix or in the base.\n  - The head and its reflog are pinned before any plan input is read; selection and the end-of-run comparison use that commit.\n  - Every submodule is checked out at its recorded commit and has no nested submodules.\n  - The working module metadata equals HEAD's, so the selection policy is the pinned one.\n  - The working copy is clean in material paths.\n- R3: With a usable base, the run shall select modules with the changed-scope rules over `base.git_head..HEAD`, excluding the `results_path` file itself. It shall also exclude derived administrative records of the engine's closed list (`posemodel.IsAdministrativePath`, the classes material bindings ignore) that are regular files, or absent, at `HEAD`. Otherwise the index and state commits that follow every record would select every module. It shall execute every check of a selected module. Every check of an unselected module whose base result exists and was not skipped shall be carried. A module with any check lacking such a base result shall be selected with the reason `carry: no prior result for <check id>`.\n- R4: A carried check shall keep the base result's outcome, exit code, duration, limit state, output and evidence class. It shall add `carried_from`, the head the check actually ran at, preserved through chained carries, and `carried_generated_at`. Counts shall add `carried`. Carried failures and errors shall count toward the run outcome exactly like executed ones.\n- R5: The record shall add `engine_version` on every run: the engine version plus the VCS revision the binary was built from, when the build records it. With `--carry` it shall also add a `carry` object: `used`, `reason`, `base_head`, `changed` (the number of files) and `selected` (module to reason).\n- R6: The changed set shall show every gitlink change whatever the Git configuration, and shall read Git names NUL-delimited and without rename pairing, so a quoted or multi-line name keeps its owner and a rename names both its source and its destination. A root module `.` owns the files no other module owns, whatever it declares. Each changed file independently selects its most specific owner, every module enclosing that owner (the root module encloses them all), every module beneath it, and every module whose declared dependency contains it, lies beneath it or is the root `.`. Every eligible dependency counts, whatever its order. The dependency case applies to discovered and undiscovered dependencies alike. The exception is the file's own owner, which reaches its dependents through the transitive widening. A file no module owns also selects the root module and every module that is not self-contained. Module metadata that does not decode is an error, never a partial reading. A module declared `\"selfContained\": true` in `.pose/indexes/module-metadata.json` shall not be selected by a change outside every module. It is still selected by changes inside it, by its declared `dependsOn` and by policy. This shall hold for `--changed-from` and `--carry` alike, with the reason recorded for the modules it widens.\n- R7: Reading the record into the delivery index shall use a check's `carried_from` and `carried_generated_at` as that result's head and time. Every consumer of a result's head therefore judges the commit a carried check really ran at.\n\n### Non-functional\n- R8: A run where every module is carried shall execute no check and finish in the time of the selection and the record write.\n\n### Security\n- R9: Revisions read from the base record shall pass the same confinement as `--changed-from` revisions before any Git call.\n\n### Compatibility\n- R10: A base record without `engine_version` shall never be used. Records without the new fields shall be read exactly as before.\n\n## 3. Technical Plan\n\n### Affected areas\n`pose-mcp/internal/cli` (argument parsing, the run loop and record fields of `validate`, changed-scope selection), `pose-mcp/internal/pose` (reading the structured result into delivery results), the manual and the CLI help.\n\n### Artifacts\n- created: .pose/specs/2026-11-22-pose-validate-carries-unchanged-checks.md\n- created: .pose/adr/2026-11-22-validate-carries-unchanged-checks.md\n- modified: pose-mcp/internal/cli/validate.go\n- modified: pose-mcp/internal/cli/validate_scope.go\n- modified: pose-mcp/internal/cli/validate_results.go\n- created: pose-mcp/internal/cli/validate_carry.go\n- created: pose-mcp/internal/cli/validate_carry_test.go\n- created: pose-mcp/internal/cli/validate_engine_identity_test.go\n- modified: pose-mcp/internal/pose/delivery_validation_run.go\n- created: pose-mcp/internal/pose/delivery_validation_run_test.go\n- modified: POSE.md\n- modified: locales/pt-BR/POSE.md\n- modified: pose-mcp/internal/cli/help_catalog.go\n- modified: pose-mcp/internal/scaffold/dist/POSE.md\n- modified: pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\n\n### Delivery targets\n\n### API/contract changes\nAdditive fields in the structured validation result: `engine_version`, `carry`, `counts.carried`, and per check `carried_from` and `carried_generated_at`. There is a new `validate --carry` flag and a new optional `selfContained` field in module metadata.\n\n### Data/storage changes\nNone beyond the additive record fields.\n\n### Technical risks\nAn instance that marks a module `selfContained` while its checks read root files would carry stale results. The declaration is explicit, documented and opt-in, and the default stays the full fallback.\n\n## 4. Tasks\n\n### Planning\n- [x] ADR for carrying results and the self-contained declaration.\n\n### Implementation\n- [x] Record fields and base eligibility.\n- [x] Selection excluding the results file, the self-contained declaration and the no-prior-result widening.\n- [x] Carried entries in the run loop and counts.\n- [x] Per-check head in the delivery reading.\n- [x] Manual and help.\n\n### Validation\n- [x] Unit and fixture tests for every requirement, each shown failing before its code.\n- [x] `pose validate --module pose-mcp` and `check --strict`.\n\n## 5. Decisions\n\n### Decision D1\nA carried result is the base's result, not a new observation. It keeps the head where it ran, and consumers judge that head. The run's material binding is still computed at `HEAD`. This holds only because the selection guarantees that a carried module's inputs did not change between the two heads, under the changed-scope rules and the instance's declarations. See ADR `2026-11-22-validate-carries-unchanged-checks`.\n\n### Decision D2\nEligibility compares the whole matrix digest and the engine version instead of per-check definitions. A matrix or engine change reruns everything. That is the existing rule for material bindings, and it keeps the comparison obviously sound.\n\n### Decision D3\nOut-of-module changes keep selecting every module unless a module declares itself self-contained. Instances opt in per module, so a repository that never declares anything gets today's behaviour.\n\n## 6. Validation\n\n### Strategy\nGo tests in `internal/cli` drive real Git fixtures through `validate --carry`. They cover:\n- the base conditions of R2, one fixture each;\n- a change in one module that carries the other;\n- chained carries;\n- a carried failure;\n- the self-contained declaration of R6, under both flags;\n- the refusals of R1;\n- the per-check head reading of R7.\n\nEach test is run against the code before its requirement and must fail there.\n\n### Deterministic checks\n\n#### Test\n- Command: `go test ./internal/cli/ ./internal/pose/` (in `pose-mcp`), then `pose validate --module pose-mcp`.\n\n#### Lint\n- Command: `go vet ./...` (in `pose-mcp`).\n\n#### Typecheck\n- Command: compiled by the tests.\n\n#### Build\n- Command: `go build ./...` (in `pose-mcp`).\n\n#### Security / Contract\n- Command: `pose check --strict`.\n\n### Execution log\n- 2026-11-22: the new fixtures in `validate_carry_test.go` and `delivery_validation_run_test.go` drive real Git repositories through `validate --carry`. Each requirement's code was mutated out and its test failed: the per-check head reading, the self-contained declaration, the canonical-result exclusion and the derived-record exclusion.\n- 2026-11-22: `go test ./...` in `pose-mcp` first failed on `TestDirectPrintSitesOnlyShrink` and `TestEmbeddedDistMatchesPoseDist`; the carry lines now go through `cliout` and the embedded manual was regenerated. A full `pose validate` then failed the post-install gate because the manual cited derived-record directories absent from a fresh install; the text was rewritten without those paths.\n- 2026-11-22: `pose validate --json-out .pose/results/delivery-validation.json` with a binary built from `606a0fa8` passed 236 of 236 checks in 786 s.\n- 2026-11-22: dogfood: `validate --carry --explain` at `c4182727` used that record as base. The record and index commits counted as zero changed files. Five of six modules were carried, and `pose-mcp` ran because its criticality is high. The run passed with `counts.carried` 3, and the record is kept at `.pose/bin/batch-20261118/engine-a-dogfood-carried.json` in the Harne8 batch.\n\n- 2026-11-22: review round 1 (rrn-0dd98c4aab8b5918, Codex) found F1 (high). A base that validated a dirty working copy could be carried. The record now has `material_clean`, and a base without it, or with an unavailable material binding, is refused. `TestCarryRefusesABaseThatValidatedADirtyWorkingCopy` reproduces the sequence. It failed with the check mutated out and passes with it.\n- 2026-11-22: review round 2 (rrn-1c033e4c349d7794) confirmed R1-F1 fixed and found four new issues. N1: a rename's source path was missing from the changed set. N2: a self-contained root module was exempt from its own files. N3: quoted, newline-delimited Git names lost their owner. N4: modified engine builds at one revision shared an identity. All four are fixed, each with a regression test that failed when its fix was mutated out.\n- 2026-11-22: review round 3 (rrn-3461f6ff36909419) confirmed N1–N4 fixed and found two more issues. N5: a deleted dependency left its self-contained dependents carried. N6: module metadata that did not decode was ignored. Both are fixed, each with a regression test that failed when its fix was mutated out.\n- 2026-11-22: lead's own sweep before round 4: a gitlink above a declared dependency changed only the gitlink path, so the self-contained dependent stayed carried. A changed path now selects the modules and dependencies under it, tested through the shared selection; the test failed with the rule mutated out.\n- 2026-11-23: review round 4 (rrn-4b28f2ff95acf9c4) found N7–N10.\n  - N7: dependency and ancestor widening applied only to unowned files.\n  - N8: a root dependency `.` never matched.\n  - N9: modules aliased through symlinks.\n  - N10: `material_clean` ignored HEAD moving during the run.\n  The selection was rewritten so that each changed file applies every rule independently. Aliased modules refuse the carry, and a moved HEAD clears `material_clean`. Each regression test failed with its fix mutated out.\n- 2026-11-23: review round 5 (rrn-b07ee93779a65e40) found N11–N14.\n  - N11: the first matching dependency masked later ones.\n  - N12: a moved HEAD kept the material bindings.\n  - N13: case aliases on case-insensitive filesystems.\n  - N14: the head was captured after planning.\n  All four are fixed, each with a regression test that failed when its fix was mutated out.\n- 2026-11-23: review round 6 (rrn-88e0428bda9bc9c7) found N15 and N16. N15: a discovered ancestor dependency missed changes in nested modules. N16: declared dependencies reached through symlinks. Both are fixed, each with a regression test that failed when its fix was mutated out.\n- 2026-11-23: review round 7 (rrn-85704a129332a685) found N17–N19.\n  - N17: an absent dependency leaf beneath a symlink.\n  - N18: dependency case aliases.\n  - N19: duplicate check ids sharing one base result.\n  The per-path alias checks gave way to global rules: a case-insensitive filesystem refuses, and so does any tracked symlink whose path or target is in a non-root module or a declared dependency, or whose target leaves the repository. Symlinks between unowned paths are allowed, which covers both repositories' `.claude/skills` links. Duplicate check ids refuse. A mutation of the link-path rule first survived, which exposed a missing test for a module's outward link; that test was added. The matrix duplicate check is redundant with the base check under an equal matrix digest, so the two were mutated together.\n- 2026-11-23: review round 8 (rrn-0375009e985e6a3d) found N20–N23.\n  - N20: symlinks inside submodules.\n  - N21: untracked material created during the run.\n  - N22: case-folded directories within a case-sensitive filesystem.\n  - N23: `diff.ignoreSubmodules` hiding gitlink changes.\n  All four are fixed, each with a regression test that failed when its fix was mutated out.\n- 2026-11-23: review round 9 (rrn-dfc7e3348240ce19) found N24–N26.\n  - N24: gitlinks inside a module were not scanned.\n  - N25: an enclosing module was not selected when a nested module changed.\n  - N26: case folding in ancestor directories of a dependency.\n  All three are fixed, and the lead extended N25 so the root module encloses every module. Each regression test failed when its fix was mutated out.\n- 2026-11-23: review round 10 (rrn-29af03286365811e) found N27–N29. N27: the case probe failed open on an unusable first entry. N28: dependencies outside the repository were accepted. N29: the ADR and this summary misdescribed the self-contained fallback. All three are fixed; N27 and N28 have regression tests that failed when their fixes were mutated out.\n- 2026-11-23: review round 11 (rrn-c0b4006e2a8ff303) found N30–N32.\n  - N30: unclean dependency paths traversing symlinks.\n  - N31: assume-unchanged and skip-worktree hiding edits from status.\n  - N32: Unicode normalization aliases.\n  All three are fixed conservatively, each with a regression test that failed when its fix was mutated out.\n- 2026-11-23: review round 12 (rrn-abb61f059dc6d700) found N33–N35.\n  - N33: dependencies reached through ignored symlinks.\n  - N34: HEAD moving away and back between the endpoints.\n  - N35: non-ASCII case swaps in the case probe.\n  All three are fixed conservatively, each with a regression test that failed when its fix was mutated out. The first N35 mutation survived, which exposed a test entry without an ASCII letter; the test was corrected.\n- 2026-11-23: review round 13 (rrn-f6546af4c9e5625e) found N36–N38 and the follow-up N39.\n  - N36: `core.fileMode=false` hid mode changes.\n  - N37: the head was pinned after the plan inputs were read.\n  - N38: uninitialized submodules looked clean.\n  N36 and N38 have regression tests that failed when their fixes were mutated out; the first N38 fixture did not isolate the fix and was corrected. N37 is an ordering fix: the pin now precedes the matrix and module reads, and a race before planning cannot be reproduced deterministically. N39, carried checks in `--report`, is follow-up F2.\n- 2026-11-23: review round 14 (rrn-db44fd7f02f7b981) found N40 and N41, and N42 restated F2. N40: submodule and hidden-index conditions were checked only at the end. N41: start cleanliness was sampled after the plan inputs were read. One predicate, `validationMaterialClean`, now runs at the pin before the plan is read and again at the end. `TestValidateConditionClearedDuringTheRunIsNotClean` failed with the start predicate mutated back to status only.\n- 2026-11-23: review round 15 (rrn-16091dd78a12cc0b; the first attempt rrn-7d33ba9fc274421f stopped on the sandbox's read-only scratch) found N43 and N45, and N44 restated F2. N43: submodule movement was not witnessed. N45: an all-carried run ignored a signal. The movement witness now covers every submodule's reflog, and a signal sets the run-level `cancelled`, which bases refuse. Both regression tests failed when their fixes were mutated out.\n- 2026-11-23: review round 16 (rrn-328651cf23a32126) found N46–N48, and F2 was restated.\n  - N46: working module metadata, an administrative record, steered the selection.\n  - N47: a cancellation left bindings available.\n  - N48: nested submodules went unwitnessed.\n  All three are fixed, each with a regression test that failed when its fix was mutated out. The first N48 fixture did not isolate the fix and was corrected.\n\n### Results summary\nAll new and existing tests pass, and the strict matrix is green. In this repository, `pose-mcp` holds 233 of the 236 checks and is high criticality, so carrying saves little here. In an instance with many modules, a change confined to one of them reruns that module, the modules enclosing it and its declared dependents. A changed file that no module owns also reruns every module that is not declared self-contained.\n\n### Requirement trace\n- R1 [satisfied] test:TestCarryRefusesIncompatibleFlags\n- R2 [satisfied] test:TestCarryFallsBackToAFullRun test:TestCarryRefusesAFilteredBase test:TestCarryRefusesABaseThatValidatedADirtyWorkingCopy test:TestEngineIdentityRefusesModifiedBuilds test:TestCarryRefusesModulesReachedThroughASymlink test:TestValidateHeadMovingDuringTheRunIsNotClean test:TestValidateHeadMovingDuringTheRunBindsNoMaterial test:TestCarryRefusesModulesSharingADirectory test:TestCarryPlansAgainstThePinnedHead test:TestCarryRefusesDependenciesReachedThroughASymlink test:TestCarryRefusesASymlinkInsideAModule test:TestCarryRefusesASymlinkFromAModuleToAnUnownedPath test:TestCarryAllowsSymlinksBetweenUnownedPaths test:TestCarryDetectsACaseInsensitiveFilesystem test:TestCarryRefusesDuplicateCheckIDs test:TestValidateUntrackedMaterialCreatedDuringTheRunIsNotClean test:TestCarryRefusesAnAliasingSymlinkInsideASubmodule test:TestCarryDetectsACaseFoldedDirectory test:TestCarryScansAGitlinkInsideAModule test:TestCarryRelevantDirsIncludeEveryAncestor test:TestCarryCaseProbeSkipsUnusableEntries test:TestCarryRefusesDependenciesOutsideTheRepository test:TestCarryRefusesUncleanDependencies test:TestCarryRefusesNonASCIIPaths test:TestCarryRefusesHiddenIndexEntries test:TestCarryRefusesDependenciesThroughAnIgnoredSymlink test:TestValidateHeadMovingAndReturningIsNotClean test:TestCarryCaseProbeUsesOnlyASCIILetters test:TestValidateModeChangeHiddenByConfigurationIsNotClean test:TestValidateUninitializedSubmoduleIsNotClean test:TestValidateConditionClearedDuringTheRunIsNotClean test:TestValidateSubmoduleMovingAndReturningIsNotClean test:TestCarryRefusesABaseCancelledAtRunLevel test:TestCarryRefusesWorkingMetadataThatDiffersFromHead test:TestCancellationMakesBindingsUnavailable test:TestValidateNestedSubmodulesAreNotClean\n- R3 [satisfied] test:TestCarryRunsOnlyTheChangedModule test:TestCarryRecordFileIsNotAChange test:TestCarryIgnoresDerivedAdministrativeRecords test:TestCarrySelectsAModuleWithoutAPriorResult\n- R4 [satisfied] test:TestCarryKeepsTheOriginalHeadAcrossChainedCarries test:TestCarryKeepsACarriedFailureAFailure\n- R5 [satisfied] test:TestCarryRunsOnlyTheChangedModule\n- R6 [satisfied] test:TestCarryRootChangeRunsEverythingUnlessSelfContained test:TestChangedScopeHonoursSelfContainedModules test:TestCarrySelectsBothSidesOfARename test:TestCarryKeepsTheOwnerOfAQuotedName test:TestCarryRootModuleOwnsRootFiles test:TestCarryDeletedDependencySelectsItsDependents test:TestCarryRejectsUndecodableMetadata test:TestChangedScopeGitlinkAboveADependencySelectsItsDependents test:TestCarryDeletedNestedDependencySelectsItsDependents test:TestCarryRootDependencyIsChangedByRootFiles test:TestChangedScopeEvaluatesEveryDeclaredDependency test:TestChangedScopeDiscoveredAncestorDependencySelectsItsDependents test:TestChangedScopeIgnoresSubmoduleHidingConfiguration test:TestChangedScopeSelectsTheEnclosingModule test:TestChangedScopeRootModuleEnclosesEveryModule\n- R7 [satisfied] test:TestDeliveryValidationRunReadsTheCarriedHead\n- R8 [satisfied] test:TestCarryRecordFileIsNotAChange\n- R9 [satisfied] test:TestCarryFallsBackToAFullRun\n- R10 [satisfied] test:TestCarryFallsBackToAFullRun\n\nR9 is enforced by `safeGitRevRE` in `planCarry` before any Git call; the not-an-ancestor case drives a forged head through it. R10 is the `base without engine version` case.\n\n### Known gaps\nReview bundles and closeout consume the per-check head through the delivery index. No separate end-to-end test seals a bundle over a carried record.\n\n## 7. Final Report\n\n### Delivered scope\n`pose validate --carry` refreshes the canonical structured result. It runs the modules the changed-scope rules select since the canonical base and carries the other checks with their outcome and the head where they ran. The changed set ignores the result file and the derived administrative records that material bindings already ignore. Any doubt about the base runs everything, and the record says why. Modules can declare `selfContained` to stop being widened by changes outside every module. The delivery index reads a carried result as an observation of its own head. The record now names the engine version together with its build revision.\n\n### Files and modules changed\n`pose-mcp/internal/cli` (validate, its scope selection, its result fields and the help catalogue), `pose-mcp/internal/pose` (the delivery reading of the result), the manual in English and pt-BR with their embedded copies, this spec and its ADR.\n\n### Validation executed\nSee the execution log: the package tests with mutation checks, the full `go test ./...` and the strict matrix with 236 of 236 checks.\n\n### Residual risks\nAn instance that declares a module self-contained while its checks read files outside it would carry a stale result. The declaration is explicit and documented, and the default stays the full fallback.\n\n### Follow-ups\n- [open] F1: cover with an end-to-end test that a review bundle sealed over a carried record judges the carried head (seal, verify and closeout-check on a fixture). (owner:@pose-maintainers crit:low review:2026-12-15)\n- [open] F2: `--carry --report` lists carried checks as executed commands without their `carried_from` head and time; exclude them from the executed summary and label reused results (review round 13, N39). (owner:@pose-maintainers crit:low review:2026-12-15)\n# ADR: Carry unchanged checks into the canonical validation result\n\n## Status\n\nAccepted on 2026-11-22 for `pose-validate-carries-unchanged-checks`.\n\n## Context\n\nThe canonical structured result at `results_path` is the only validation evidence that review bundles and closeout load. Producing it means running the whole matrix. `--changed-from` already selects the modules a change can affect: it uses changed paths, declared `dependsOn` edges and the high-criticality policy, and falls back to every module for a change outside all modules. Its record, though, marks the other checks as skipped, so it cannot stand in for the canonical result. In an instance with a slow and partly intermittent matrix, every review round pays for the full run.\n\n## Decision\n\nAdd `validate --carry`. The flag uses the existing canonical result as a base when that base is provably comparable:\n- the same schema, mode, matrix digest and engine version;\n- a head that is an ancestor of the current head;\n- not cancelled;\n- a clean material working copy.\n\nWith a usable base, the run executes the changed-scope selection between the two heads. That selection ignores the canonical result file and the derived administrative records that material bindings already ignore: the engine's closed list, still regular files at `HEAD`. It copies the base results of every unselected module. Each copied result keeps its outcome and states the head where it really ran (`carried_from`) and when (`carried_generated_at`). The delivery reading uses that head for the result. Any unmet condition runs everything and records the reason.\n\nA module may declare `\"selfContained\": true` in its metadata. A change outside every module then stops selecting it. The declaration is the instance's statement that the module's checks read only its own directory and its declared dependencies, so it applies to `--changed-from` too. Without it, the existing safe fallback stays.\n\n## Consequences\n\nA change confined to one module reruns that module, the modules enclosing it (the root module included), the modules beneath the changed path and its declared dependents. Everything else is reused with its true origin visible. Only a changed file that no module owns widens the run to every module that does not declare itself self-contained. Consumers that compare a result's head with a subject head now see carried results as observations of the earlier head, which is accurate. An incorrect `selfContained` declaration can carry a stale result. That risk sits with the instance's explicit declaration and is documented next to it.\n\n## Alternatives considered\n\n- Hashing each check's declared inputs would be more precise. It needs every check's inputs declared and verified, and it is a larger contract.\n- Merging a partial `--changed-from` record into the canonical file by hand would hide which results were reused.\n- Carrying across matrix or engine changes would make a definition change invisible to the evidence.\n# Rule: Documentation Style\n\n## When to consult\n\nConsult this guide for process documentation, rules, specs, workflows, and operational instructions.\n\n## Required conventions\n\n- Write instructions in the imperative mood and begin them with action verbs.\n- Keep bullets short and limited to one idea.\n- Avoid duplicating sections with the same purpose across files.\n- Link to the single source of truth instead of copying its content.\n- Use `check`, `spec`, and `workflow` consistently.\n- State each instruction's scope explicitly to reduce ambiguity.\n\n## Examples: good and bad\n\n### Redundancy\n\n- **Good:** \"Update review criteria in `.pose/workflows/review.md` and reference that workflow from the root AGENTS file.\"\n- **Bad:** \"Repeat review criteria in AGENTS, the workflow, and every related spec.\"\n\n### Ambiguous reference\n\n- **Good:** \"Run the lint check described by the review workflow.\"\n- **Bad:** \"Run that standard validation before pushing.\"\n\n## Quick editorial checklist\n\n- Language is imperative and direct.\n- Bullets are short and non-overlapping.\n- Files do not duplicate sections.\n- `check`, `spec`, and `workflow` are used consistently.\n- References point to explicit files or paths.\n\n## Precedence in multi-domain conflicts\n\n- Apply the most restrictive security, contract, and operational rule when domain rules conflict.\n- Prefer verifiable check evidence and explicit risk mitigation when speed conflicts with control.\n- Record the precedence decision and objective rationale in the review.\n\n## Recurrence traceability\n\n> Also apply: [.pose/rules/_base-recurrence.md](_base-recurrence.md)\n# Rule: Knowledge Governance\n\n## When to consult\n\nConsult this guide when creating, updating, reviewing, or removing artifacts under `.pose/knowledge/`.\n\n## TTL and retention\n\n- Set `expires_at` on every artifact when it is created.\n- Use a default TTL of 30 days for notes, decision logs, and handoffs.\n- Use a TTL of up to 90 days only with a justification recorded in the artifact body.\n- Treat an artifact without `expires_at` as non-compliant and block its creation or merge.\n\n## When this is not the right home\n\n- Use `.pose/knowledge/` only for time-bound operational memory: content\n  tied to a decision moment, a handoff between executions, or something\n  meant to be reviewed and eventually expire.\n- A durable fact or convention that will not become false and carries no\n  review trigger — a third-party tool's parsing quirk, a naming\n  convention, a recurring gotcha — is not a `decision-log` just because no\n  better type exists. Route it to `.pose/rules/` instead: add it to an\n  existing rule file or create one, then wire it into the relevant task\n  type's base `rules` array in `.pose/indexes/task-map.json` so\n  `pose suggest <task>` surfaces it automatically. No path scoping is\n  required — a task type's base `rules` list is returned regardless of\n  `--path`; only language/component-specific rules need the\n  `rules_by_domain` layer.\n- Rule of thumb: if nothing was decided or traded off, and nothing about\n  the fact will change on a predictable timeline, it is not a\n  `decision-log` and not an ADR — it is a rule. See ADR\n  `2026-08-15-durable-non-architectural-knowledge-belongs-in-rules-not-a-new-type`.\n\n## Reusable cross-execution format\n\n- Structure reusable context as a handoff with fixed sections: Context, Current state, Next checks, Risks, and Next owner.\n- Keep `source_refs` linked to the relevant spec, workflow, and executed check commands.\n- Record `last_reviewed_at` in the body to make effective cross-execution updates traceable.\n\n## Archiving and purging\n\n- Run biweekly triage to list expired artifacts.\n- Move expired artifacts to `.pose/knowledge/archive/` when they retain audit value.\n- Purge archived artifacts 180 days after expiration unless documented legal or compliance requirements apply.\n- Record every archive and purge action in the housekeeping log.\n\n## Sensitive content\n\n- Prohibit secrets, tokens, credentials, private keys, and equivalent material.\n- Prohibit personal data and non-anonymized customer data.\n- Do not copy restricted incidents or reports in full; keep only a controlled reference.\n- Classify frontmatter `sensitivity` as `public-internal` or `restricted`.\n- Remove identified sensitive content immediately and open a security follow-up.\n\n## Ownership and review\n\n- Keep `@pose-maintainers` as the primary governance owner.\n- Require an owner in every artifact frontmatter.\n- Review expiration biweekly and quality monthly.\n- Escalate a backlog overdue by more than two cycles to the primary owner.\n- Block backlog growth when `list-expired` exceeds the operational limit: zero in strict mode, two in tolerant mode.\n\n## Minimum operational checks\n\n- Run `pose knowledge-check --strict` biweekly to validate the expired backlog.\n- Run `pose knowledge-housekeeping list-expired` for detailed triage.\n- Run `pose knowledge-housekeeping archive-expired --dry-run` before applying changes.\n- Execute destructive actions only with an explicit `--apply` flag.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/cli/validate_scope.go; git diff dec2e64c1395fafbf8e2a78171e5437c1720bbbf bae831dfe1f3585a69eeaecc0dcecbf1e3cfe0c9 -- pose-mcp/internal/cli/validate.go pose-mcp/internal/cli/validate_results.go pose-mcp/internal/pose/delivery_validation_run.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/bash -lc 'cat pose-mcp/internal/cli/validate_scope.go; git diff dec2e64c1395fafbf8e2a78171e5437c1720bbbf bae831dfe1f3585a69eeaecc0dcecbf1e3cfe0c9 -- pose-mcp/internal/cli/validate.go pose-mcp/internal/cli/validate_results.go pose-mcp/internal/pose/delivery_validation_run.go'","aggregated_output":"package cli\n\n// Explainable changed-scope validation (spec pose-changed-scope-validation):\n// select the minimum safe set of modules from explicit Git revisions,\n// declared dependency edges and policy. Selection is deterministic for the\n// same base/head/config; every decision carries a reason and every\n// unselected check is recorded as skipped with a machine-readable reason.\n// Uncertainty always widens toward safe execution.\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n)\n\n// safeGitRevRE rejects revisions that could be parsed as options or escape\n// expected forms (confinement: never pass untrusted flags to git).\nvar safeGitRevRE = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._/~^-]*$`)\n\ntype scopeModuleMeta struct {\n\tCriticality string   `json:\"criticality\"`\n\tDependsOn   []string `json:\"dependsOn\"`\n\t// SelfContained declares that the module's checks read only its own\n\t// directory and its declared dependencies, so a change outside every\n\t// module does not select it (spec pose-validate-carries-unchanged-checks R6).\n\tSelfContained bool `json:\"selfContained\"`\n}\n\ntype scopeMetadata struct {\n\tModules map[string]scopeModuleMeta `json:\"modules\"`\n}\n\n// loadScopeMetadata reads the module metadata. An absent file is empty\n// metadata; a file that does not decode is an error, never a partial\n// reading that could keep an exemption and drop a dependency (review round\n// 3, N6).\nfunc loadScopeMetadata(root string) (scopeMetadata, error) {\n\tvar meta scopeMetadata\n\traw, err := os.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"module-metadata.json\"))\n\tif errors.Is(err, os.ErrNotExist) {\n\t\treturn meta, nil\n\t}\n\tif err != nil {\n\t\treturn meta, fmt.Errorf(\"module metadata is unreadable: %v\", err)\n\t}\n\tif err := json.Unmarshal(raw, &meta); err != nil {\n\t\treturn scopeMetadata{}, fmt.Errorf(\"module metadata does not decode: %v\", err)\n\t}\n\treturn meta, nil\n}\n\n// scopeSelection maps selected module → deterministic selection reason.\ntype scopeSelection struct {\n\tBase, Head string\n\tChanged    []string\n\tSelected   map[string]string\n}\n\nfunc (s scopeSelection) rangeLabel() string {\n\tif s.Head == \"\" {\n\t\treturn s.Base + \"..worktree\"\n\t}\n\treturn s.Base + \"..\" + s.Head\n}\n\n// computeChangedScope resolves the selection. Modules are selected when they\n// contain changed files, depend (transitively) on a changed module, or policy\n// widens them (criticality high). A change outside every module selects\n// every module that does not declare itself self-contained — uncertainty\n// prefers safe execution. Excluded paths (the run's own canonical result) are\n// not changes.\nfunc computeChangedScope(root, base, head string, modules []validationModule, exclude ...string) (scopeSelection, error) {\n\tsel := scopeSelection{Base: base, Head: head, Selected: map[string]string{}}\n\tfor _, rev := range []string{base, head} {\n\t\tif rev != \"\" && !safeGitRevRE.MatchString(rev) {\n\t\t\treturn sel, fmt.Errorf(\"unsafe git revision: %q\", rev)\n\t\t}\n\t}\n\t// NUL-delimited and without rename pairing: a quoted or multi-line name\n\t// keeps its owner, and a rename names both its source and its destination\n\t// (review round 2, N1 and N3).\n\t// Configuration never hides a changed gitlink (review round 8, N23).\n\tgitArgs := []string{\"-C\", root, \"-c\", \"diff.ignoreSubmodules=none\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"-z\", \"--no-renames\", base}\n\tif head != \"\" {\n\t\tgitArgs = append(gitArgs, head)\n\t}\n\tgitArgs = append(gitArgs, \"--\")\n\tout, err := posemodel.RawGit(gitArgs...).Output()\n\tif err != nil {\n\t\treturn sel, fmt.Errorf(\"git diff %s failed (revision unknown?)\", sel.rangeLabel())\n\t}\n\tfor _, name := range strings.Split(string(out), \"\\x00\") {\n\t\tif name != \"\" {\n\t\t\tsel.Changed = append(sel.Changed, filepath.ToSlash(name))\n\t\t}\n\t}\n\tif head == \"\" {\n\t\t// Worktree comparisons must also see untracked files — invisible new\n\t\t// code must never silently narrow validation (safe execution wins).\n\t\tif untracked, err := posemodel.RawHistoryGit(root, \"ls-files\", \"-z\", \"--others\", \"--exclude-standard\").Output(); err == nil {\n\t\t\tfor _, name := range strings.Split(string(untracked), \"\\x00\") {\n\t\t\t\tif name != \"\" {\n\t\t\t\t\tsel.Changed = append(sel.Changed, filepath.ToSlash(name))\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif len(exclude) > 0 {\n\t\texcluded := map[string]bool{}\n\t\tfor _, path := range exclude {\n\t\t\texcluded[filepath.ToSlash(filepath.Clean(path))] = true\n\t\t}\n\t\tkept := sel.Changed[:0]\n\t\tfor _, file := range sel.Changed {\n\t\t\tif !excluded[file] {\n\t\t\t\tkept = append(kept, file)\n\t\t\t}\n\t\t}\n\t\tsel.Changed = kept\n\t}\n\tsort.Strings(sel.Changed)\n\n\tmeta, err := loadScopeMetadata(root)\n\tif err != nil {\n\t\treturn sel, err\n\t}\n\tmoduleOf := func(file string) string {\n\t\tmatch := \"\"\n\t\tfor _, m := range modules {\n\t\t\tif file == m.Rel || strings.HasPrefix(file, m.Rel+\"/\") {\n\t\t\t\tif len(m.Rel) > len(match) {\n\t\t\t\t\tmatch = m.Rel\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn match\n\t}\n\t// Every changed file selects, independently of one another (review rounds\n\t// 2–4, N2, N5, N7, N8):\n\t//   - its most specific owning module;\n\t//   - every module under it (a gitlink or a replaced directory changes what\n\t//     lies beneath);\n\t//   - every module whose declared dependsOn contains it, lies under it, or\n\t//     is the project root \".\", whether or not the dependency is discovered;\n\t//   - when no module owns it: the root module and every module that does\n\t//     not declare itself self-contained (safe execution wins).\n\tselectModule := func(rel, reason string) {\n\t\tif _, ok := sel.Selected[rel]; !ok {\n\t\t\tsel.Selected[rel] = reason\n\t\t}\n\t}\n\tfor _, file := range sel.Changed {\n\t\towner := moduleOf(file)\n\t\tif owner != \"\" {\n\t\t\tselectModule(owner, \"contains changed file: \"+file)\n\t\t\t// An enclosing module's checks may read inside the modules nested\n\t\t\t// in its directory, and the root module encloses them all (review\n\t\t\t// round 9, N25).\n\t\t\tfor _, m := range modules {\n\t\t\t\tif m.Rel != owner && (m.Rel == \".\" || strings.HasPrefix(owner, m.Rel+\"/\")) {\n\t\t\t\t\tselectModule(m.Rel, \"changed file in nested module \"+owner+\": \"+file)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tfor _, m := range modules {\n\t\t\tif m.Rel != \".\" && strings.HasPrefix(m.Rel, file+\"/\") {\n\t\t\t\tselectModule(m.Rel, \"changed path above the module: \"+file)\n\t\t\t}\n\t\t\t// Every eligible dependency counts, whatever its order (review\n\t\t\t// round 5, N11).\n\t\t\t// A dependency that is the file's own owner reaches its dependents\n\t\t\t// through the transitive widening; any other one, discovered or not,\n\t\t\t// selects here (review round 6, N15).\n\t\t\tfor _, dep := range declaredDependencyHits(file, meta.Modules[m.Rel].DependsOn) {\n\t\t\t\tif dep != owner {\n\t\t\t\t\tselectModule(m.Rel, \"declared dependency \"+dep+\" changed: \"+file)\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif owner == \"\" && (m.Rel == \".\" || !meta.Modules[m.Rel].SelfContained) {\n\t\t\t\tselectModule(m.Rel, \"root-level change outside any module: \"+file)\n\t\t\t}\n\t\t}\n\t}\n\t// Policy widening: high-criticality modules always run.\n\tfor _, m := range modules {\n\t\tif meta.Modules[m.Rel].Criticality == \"high\" {\n\t\t\tif _, ok := sel.Selected[m.Rel]; !ok {\n\t\t\t\tsel.Selected[m.Rel] = \"policy: criticality high always runs\"\n\t\t\t}\n\t\t}\n\t}\n\t// Transitive dependents of selected modules (declared edges only).\n\tfor changed := true; changed; {\n\t\tchanged = false\n\t\tfor _, m := range modules {\n\t\t\tif _, ok := sel.Selected[m.Rel]; ok {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfor _, dep := range meta.Modules[m.Rel].DependsOn {\n\t\t\t\tif reason, ok := sel.Selected[filepath.ToSlash(filepath.Clean(dep))]; ok {\n\t\t\t\t\tsel.Selected[m.Rel] = \"depends on selected module \" + dep + \" (\" + firstScopeReason(reason) + \")\"\n\t\t\t\t\tchanged = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn sel, nil\n}\n\n// firstScopeReason keeps chained dependency reasons short and readable.\nfunc firstScopeReason(reason string) string {\n\tif i := strings.Index(reason, \" (\"); i > 0 {\n\t\treturn reason[:i]\n\t}\n\treturn reason\n}\n\n// declaredDependencyHits returns every declared dependency file changes: one\n// it lies in, one it lies above, or the project root \".\", which every file\n// changes.\nfunc declaredDependencyHits(file string, deps []string) []string {\n\tvar hits []string\n\tfor _, dep := range deps {\n\t\tdep = filepath.ToSlash(filepath.Clean(dep))\n\t\tif dep == \".\" || file == dep || strings.HasPrefix(file, dep+\"/\") || strings.HasPrefix(dep, file+\"/\") {\n\t\t\thits = append(hits, dep)\n\t\t}\n\t}\n\treturn hits\n}\ndiff --git a/pose-mcp/internal/cli/validate.go b/pose-mcp/internal/cli/validate.go\nindex 1ed4d9a5..d08c33d2 100644\n--- a/pose-mcp/internal/cli/validate.go\n+++ b/pose-mcp/internal/cli/validate.go\n@@ -65,7 +65,10 @@ type validationEntry struct {\n \tskip     string\n \tsilent   bool\n \tisolated bool\n-\tresult   checkResult\n+\t// carried marks a check whose result comes from the canonical base (spec\n+\t// pose-validate-carries-unchanged-checks R4); it is silent and never runs.\n+\tcarried bool\n+\tresult  checkResult\n \tdone     chan struct{}\n }\n \n@@ -905,6 +908,7 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \tverbose := false\n \tautoReport := false\n \trootOnly := false\n+\tcarry := false\n \tworkspaceFilter := \"\"\n \tjobs := 0\n \tvar isolationChecks []checkResult\n@@ -922,6 +926,10 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t\t\t// A check's output is captured by default; --verbose streams it\n \t\t\t// (spec pose-cli-output-rendering-system R7).\n \t\t\tverbose = true\n+\t\tcase \"--carry\":\n+\t\t\t// Refresh the canonical result, carrying the checks a change\n+\t\t\t// cannot affect (spec pose-validate-carries-unchanged-checks).\n+\t\t\tcarry = true\n \t\tcase \"--root-only\":\n \t\t\t// Documented alias of --module . (spec\n \t\t\t// pose-monorepo-validation-advisory, R2) — sugar over the\n@@ -995,9 +1003,22 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t\t}\n \t}\n \tcanonicalResultsPath := \"\"\n-\tif jsonOut != \"\" {\n+\tif jsonOut != \"\" || carry {\n \t\tcanonicalResultsPath = configuredDeliveryResultsPath(root)\n \t}\n+\tif carry {\n+\t\tswitch {\n+\t\tcase moduleFilter != \"\" || stackFilter != \"\" || workspaceFilter != \"\" || changedFrom != \"\" || changedTo != \"\":\n+\t\t\trender(stdout, stderr).Failure(cliText(locale, \"--carry refreshes the whole canonical result; it cannot be combined with --module, --stack, --workspace, --root-only, --changed-from or --changed-to\", \"--carry renova o resultado canônico inteiro; não combina com --module, --stack, --workspace, --root-only, --changed-from ou --changed-to\"))\n+\t\t\treturn 2\n+\t\tcase canonicalResultsPath == \"\":\n+\t\t\trender(stdout, stderr).Failure(cliText(locale, \"--carry needs results_path in .pose/policy/delivery.json\", \"--carry exige results_path em .pose/policy/delivery.json\"))\n+\t\t\treturn 2\n+\t\tcase normalizeValidationOutputPath(jsonOut) != canonicalResultsPath:\n+\t\t\trender(stdout, stderr).Failure(fmt.Sprintf(cliText(locale, \"--carry writes the canonical result: use --json-out %s\", \"--carry grava o resultado canônico: use --json-out %s\"), canonicalResultsPath))\n+\t\t\treturn 2\n+\t\t}\n+\t}\n \t// The report --report writes records this run, so it reads this run's own\n \t// output. It used to look for a pose-validate.latest.log that native\n \t// validation never writes, and every report said \"Fill manually\" and \"No\n@@ -1015,6 +1036,18 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t\tfmt.Fprintln(stderr, cliText(locale, \"Error: --module must remain inside the project.\", \"Erro: --module deve permanecer dentro do projeto.\"))\n \t\treturn 2\n \t}\n+\t// HEAD and its movement witness are pinned before any plan input is read:\n+\t// the matrix and the module discovery then belong to this head, or the\n+\t// end-of-run comparison sees the move (review round 13, N37).\n+\tpinnedHead := \"\"\n+\tif head, err := gitOutputBounded(root, 1024, \"rev-parse\", \"HEAD\"); err == nil {\n+\t\tpinnedHead = strings.TrimSpace(string(head))\n+\t}\n+\tstartReflog := movementWitness(root, pinnedHead)\n+\t// The working copy must match the pinned head before the plan inputs are\n+\t// read, by the same full predicate checked at the end: status, hidden\n+\t// index entries and submodule checkouts (review round 14, N40 and N41).\n+\tstartedClean := pinnedHead != \"\" && validationMaterialClean(root, pinnedHead)\n \tmatrixPath := filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\")\n \traw, err := os.ReadFile(matrixPath)\n \tif err != nil {\n@@ -1121,8 +1154,30 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t}\n \tmatrixDigest := sha256.Sum256(raw)\n \trun.MatrixSHA256 = \"sha256:\" + hex.EncodeToString(matrixDigest[:])\n-\tif head, err := gitOutputBounded(root, 1024, \"rev-parse\", \"HEAD\"); err == nil {\n-\t\trun.GitHead = strings.TrimSpace(string(head))\n+\trun.EngineVersion = validationEngineIdentity()\n+\t// The head is pinned before anything is planned: selection, carried\n+\t// results and the end-of-run comparison all name this one commit (review\n+\t// round 5, N14).\n+\trun.GitHead = pinnedHead\n+\tvar carryState carryPlan\n+\tif carry {\n+\t\tcarryState = planCarry(root, canonicalResultsPath, mode, run.MatrixSHA256, run.GitHead, matrix, modules)\n+\t\trun.Carry = carryState.record\n+\t\tout := render(stdout, stderr)\n+\t\tif !carryState.record.Used {\n+\t\t\tout.ContractLine(\"[carry] full run: \" + carryState.record.Reason)\n+\t\t} else {\n+\t\t\tout.ContractLine(fmt.Sprintf(\"[carry] base %s: %d changed file(s), %d/%d module(s) run\", carryState.record.BaseHead, carryState.record.Changed, len(carryState.record.Selected), len(modules)))\n+\t\t\tif explain {\n+\t\t\t\tfor _, m := range modules {\n+\t\t\t\t\tif reason, ok := carryState.record.Selected[m.Rel]; ok {\n+\t\t\t\t\t\tout.ContractLine(\"  + \" + m.Rel + \": \" + reason)\n+\t\t\t\t\t} else {\n+\t\t\t\t\t\tout.ContractLine(\"  = \" + m.Rel + \": carried from \" + carryState.record.BaseHead)\n+\t\t\t\t\t}\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n \t}\n \tif graph, err := buildCurrentDeliveryGraph(root); err == nil {\n \t\trun.ProvenanceDigest = graph.ProvenanceDigest\n@@ -1171,6 +1226,9 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t\t\t\tcontinue\n \t\t\t}\n \t\t}\n+\t\tif carryState.carried(module.Rel) {\n+\t\t\tcontinue\n+\t\t}\n \t\tfor _, check := range checks {\n \t\t\tif check.Program != \"\" {\n \t\t\t\tplanned++\n@@ -1214,6 +1272,16 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t\t\t\tcontinue\n \t\t\t}\n \t\t}\n+\t\tif carryState.carried(module.Rel) {\n+\t\t\tfor _, check := range checks {\n+\t\t\t\tif check.Program == \"\" {\n+\t\t\t\t\tcontinue\n+\t\t\t\t}\n+\t\t\t\tid := module.Rel + \"/\" + stack + \"/\" + check.Name\n+\t\t\t\tentries = append(entries, &validationEntry{check: check, silent: true, carried: true, result: carryState.carriedResult(id)})\n+\t\t\t}\n+\t\t\tcontinue\n+\t\t}\n \t\tmoduleMode := mode\n \t\tif override.Mode != \"\" {\n \t\t\tmoduleMode = override.Mode\n@@ -1269,6 +1337,34 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \t\t\tsteps.Note(entry.note)\n \t\t\tcontinue\n \t\t}\n+\t\tif entry.carried {\n+\t\t\t// A carried result counts toward the outcome exactly as it did in\n+\t\t\t// its own run; a carried failure stays a failure (R4).\n+\t\t\trun.Counts.Carried++\n+\t\t\tswitch entry.result.Outcome {\n+\t\t\tcase \"pass\":\n+\t\t\t\trun.Counts.Passed++\n+\t\t\tcase \"fail\":\n+\t\t\t\tif entry.result.Severity == \"required\" {\n+\t\t\t\t\tfailures++\n+\t\t\t\t\trun.Counts.Failed++\n+\t\t\t\t} else {\n+\t\t\t\t\toptionalFailures++\n+\t\t\t\t\trun.Counts.OptionalFailed++\n+\t\t\t\t}\n+\t\t\tcase \"skipped\":\n+\t\t\t\trun.Counts.Skipped++\n+\t\t\tdefault:\n+\t\t\t\trun.Counts.Errored++\n+\t\t\t\tif entry.result.Severity == \"required\" {\n+\t\t\t\t\tfailures++\n+\t\t\t\t} else {\n+\t\t\t\t\toptionalFailures++\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\trun.Checks = append(run.Checks, entry.result)\n+\t\t\tcontinue\n+\t\t}\n \t\tif !entry.silent && !entry.isolated {\n \t\t\tif jobs > 1 {\n \t\t\t\t<-entry.done\n@@ -1335,22 +1431,47 @@ func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr i\n \trun.WallSeconds = time.Since(wallStart).Seconds()\n \t// A check that changed a tracked file changed the material it ran over: the\n \t// committed tree no longer describes what was validated.\n-\tif len(run.MaterialProvenance) > 0 && !materialTrackedUnchanged(root) {\n+\tendedClean := materialTrackedUnchanged(root)\n+\t// The run validated its recorded head only if HEAD never moved: a commit\n+\t// made while checks ran would let them observe code the record does not\n+\t// name (review round 4, N10).\n+\tendHead := \"\"\n+\tif head, err := gitOutputBounded(root, 1024, \"rev-parse\", \"HEAD\"); err == nil {\n+\t\tendHead = strings.TrimSpace(string(head))\n+\t}\n+\t// Untracked material created while checks ran counts too (review round 8,\n+\t// N21): only ignored files may differ from the recorded head.\n+\n+\t// Equal endpoints do not show HEAD never moved: H -> H' -> H leaves them\n+\t// equal. The reflog must not have grown (review round 12, N34).\n+\t// The witness covers HEAD and every submodule's HEAD: a submodule moved\n+\t// away and back while checks ran is movement too (review round 15, N43).\n+\tendReflog := movementWitness(root, run.GitHead)\n+\trun.MaterialClean = startedClean && endedClean && run.GitHead != \"\" && endHead == run.GitHead && validationMaterialClean(root, run.GitHead) && startReflog != \"\" && endReflog == startReflog\n+\t// A run that did not validate its recorded head binds no material: its\n+\t// bindings would let a later tree make a misattributed pass current again\n+\t// (review round 5, N12).\n+\tif len(run.MaterialProvenance) > 0 && !run.MaterialClean {\n \t\tfor spec := range run.MaterialProvenance {\n \t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n \t\t}\n \t}\n \t// A cancelled run never reads as a success, whatever the severity of the\n \t// checks it stopped (review round 1, B5).\n-\tcancelled := false\n+\t// A signal cancels the run even when no executed check saw it, as in an\n+\t// all-carried run (review round 15, N45).\n+\tcancelled := runCtx.Err() != nil\n \tfor _, check := range run.Checks {\n \t\tcancelled = cancelled || check.LimitState == \"cancelled\"\n \t}\n+\tif cancelled {\n+\t\trun.Cancelled = finalizeCancellation(&run)\n+\t}\n \tfor _, line := range validationTimingNotes(run) {\n \t\tsteps.Note(line)\n \t}\n \tsteps.Summary()\n-\tif executed == 0 {\n+\tif executed == 0 && run.Counts.Carried == 0 {\n \t\tfmt.Fprintln(stdout, \"No modules/checks matched the matrix and filters.\")\n \t}\n \tresult := \"pass\"\n@@ -1595,7 +1716,8 @@ func sanitizeGoCheckArgs(ctx context.Context, dir, program string, args []string\n // path outside the administrative classes, untracked files included. A status\n // that cannot be read is not clean.\n func materialWorktreeClean(root string) bool {\n-\tout, err := gitOutputBounded(root, 16*1024*1024, \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=all\")\n+\t// Mode changes count whatever core.fileMode says (review round 13, N36).\n+\tout, err := gitOutputBounded(root, 16*1024*1024, \"-c\", \"core.fileMode=true\", \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=all\")\n \tif err != nil {\n \t\treturn false\n \t}\n@@ -1628,7 +1750,7 @@ func materialWorktreeClean(root string) bool {\n // outside the administrative records. Untracked files are not counted: checks\n // leave build products behind, and those are not the material they ran over.\n func materialTrackedUnchanged(root string) bool {\n-\tout, err := gitOutputBounded(root, 16*1024*1024, \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=no\")\n+\tout, err := gitOutputBounded(root, 16*1024*1024, \"-c\", \"core.fileMode=true\", \"status\", \"--porcelain=v1\", \"-z\", \"--ignore-submodules=none\", \"--untracked-files=no\")\n \tif err != nil {\n \t\treturn false\n \t}\ndiff --git a/pose-mcp/internal/cli/validate_results.go b/pose-mcp/internal/cli/validate_results.go\nindex 6af16e09..b2cd3a3a 100644\n--- a/pose-mcp/internal/cli/validate_results.go\n+++ b/pose-mcp/internal/cli/validate_results.go\n@@ -42,6 +42,10 @@ type checkResult struct {\n \t// Runtime guardrails (spec pose-validation-runtime-guardrails), additive:\n \tLimitState string `json:\"limit_state,omitempty\"` // timeout | output-limit | cancelled | no-tests\n \tIsolation  string `json:\"isolation,omitempty\"`   // required = delegated to Harness\n+\t// A carried result is the base's, run at CarriedFrom (spec\n+\t// pose-validate-carries-unchanged-checks R4).\n+\tCarriedFrom        string `json:\"carried_from,omitempty\"`\n+\tCarriedGeneratedAt string `json:\"carried_generated_at,omitempty\"`\n }\n \n // outputLimiter cancels the check when total output exceeds the limit —\n@@ -73,6 +77,16 @@ type validationRunResult struct {\n \tProvenanceDigest   string            `json:\"provenance_digest,omitempty\"`\n \tScopeProvenance    map[string]string `json:\"scope_provenance,omitempty\"`\n \tMaterialProvenance map[string]string `json:\"material_provenance,omitempty\"`\n+\t// EngineVersion and Carry let a later run judge this one as a base (spec\n+\t// pose-validate-carries-unchanged-checks R2, R5).\n+\tEngineVersion string       `json:\"engine_version,omitempty\"`\n+\tCarry         *carryRecord `json:\"carry,omitempty\"`\n+\t// MaterialClean says the working copy matched HEAD in material paths when\n+\t// the run started and still did when it ended, so the run validated the\n+\t// commit it records. Only such a run can be a carry base (R2).\n+\tMaterialClean bool `json:\"material_clean,omitempty\"`\n+\t// Cancelled records a run a signal stopped, whatever its checks recorded.\n+\tCancelled bool `json:\"cancelled,omitempty\"`\n \t// Jobs is how many checks ran at once; WallSeconds the run's elapsed time\n \t// (spec pose-validate-concurrent-steps R3–R4).\n \tJobs        int     `json:\"jobs,omitempty\"`\n@@ -91,6 +105,7 @@ type runCounts struct {\n \tOptionalFailed int `json:\"optional_failed\"`\n \tErrored        int `json:\"errored\"`\n \tSkipped        int `json:\"skipped\"`\n+\tCarried        int `json:\"carried,omitempty\"`\n }\n \n // secretEnvKeyRE marks configured env keys whose values are redacted from\ndiff --git a/pose-mcp/internal/pose/delivery_validation_run.go b/pose-mcp/internal/pose/delivery_validation_run.go\nindex 07b52e0b..f78cddd7 100644\n--- a/pose-mcp/internal/pose/delivery_validation_run.go\n+++ b/pose-mcp/internal/pose/delivery_validation_run.go\n@@ -28,6 +28,10 @@ func ParseDeliveryValidationRun(raw []byte, relative string) ([]DeliveryValidati\n \t\t\tSeverity      string `json:\"severity\"`\n \t\t\tEvidenceClass string `json:\"evidence_class,omitempty\"`\n \t\t\tOutcome       string `json:\"outcome\"`\n+\t\t\t// A carried check ran at its own head (spec\n+\t\t\t// pose-validate-carries-unchanged-checks R7).\n+\t\t\tCarriedFrom        string `json:\"carried_from,omitempty\"`\n+\t\t\tCarriedGeneratedAt string `json:\"carried_generated_at,omitempty\"`\n \t\t} `json:\"checks\"`\n \t}\n \tif err := json.Unmarshal(raw, &run); err != nil || run.SchemaVersion != DeliveryValidationResultSchema {\n@@ -38,7 +42,11 @@ func ParseDeliveryValidationRun(raw []byte, relative string) ([]DeliveryValidati\n \t\tif check.EvidenceClass == \"\" {\n \t\t\tcontinue\n \t\t}\n-\t\tresults = append(results, DeliveryValidationResult{ID: check.ID, Module: check.Module, Check: check.Name, EvidenceClass: check.EvidenceClass, Severity: check.Severity, Outcome: check.Outcome, GitHead: run.GitHead, GeneratedAt: run.GeneratedAt, ProvenanceDigest: run.ProvenanceDigest, ScopeProvenance: run.ScopeProvenance, MaterialProvenance: run.MaterialProvenance, Report: relative})\n+\t\thead, generated := run.GitHead, run.GeneratedAt\n+\t\tif check.CarriedFrom != \"\" {\n+\t\t\thead, generated = check.CarriedFrom, check.CarriedGeneratedAt\n+\t\t}\n+\t\tresults = append(results, DeliveryValidationResult{ID: check.ID, Module: check.Module, Check: check.Name, EvidenceClass: check.EvidenceClass, Severity: check.Severity, Outcome: check.Outcome, GitHead: head, GeneratedAt: generated, ProvenanceDigest: run.ProvenanceDigest, ScopeProvenance: run.ScopeProvenance, MaterialProvenance: run.MaterialProvenance, Report: relative})\n \t}\n \tsort.Slice(results, func(i, j int) bool { return results[i].ID < results[j].ID })\n \treturn results, nil\n","exit_code":0,"status":"completed"}}
