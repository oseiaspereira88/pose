{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/usr/bin/bash -lc \"cat .pose/policy/artifacts.json; sed -n '880,965p' pose-mcp/internal/cli/artifact_integrity.go; git diff --name-only dec2e64..132dcaf7 -- pose-mcp POSE.md locales/pt-BR/POSE.md; cat .pose/results/pose-validate-carries-unchanged-checks-matrix.md; sed -n '955,985p' .pose/results/delivery-validation.json\"","aggregated_output":"{\n  \"schema_version\": 1,\n  \"enabled\": true,\n  \"adopted_at\": \"2026-08-03\",\n  \"governed_roots\": [\n    \".agents/skills\",\n    \".github/workflows\",\n    \".pose/templates\",\n    \".pose/workflows\",\n    \"docs-site/docs\",\n    \"pose-mcp/internal\",\n    \"scripts\"\n  ],\n  \"exclusions\": [\n    \"pose-mcp/internal/scaffold/dist\",\n    \"pose-mcp/internal/mcpserver/testdata\",\n    \"pose-mcp/internal/pose/testdata\"\n  ],\n  \"none_reasons\": [\"release\", \"migration\"],\n  \"severities\": {\n    \"resolvability\": \"error\",\n    \"existence\": \"error\",\n    \"action-mismatch\": \"error\",\n    \"undeclared\": \"error\",\n    \"orphan\": \"warning\",\n    \"legacy-narrative\": \"info\"\n  }\n}\n\t}\n\tfor _, claim := range claims {\n\t\tif claim.Action == \"none\" {\n\t\t\tcontinue\n\t\t}\n\t\tpaths := []string{claim.Path}\n\t\tif claim.Action == \"renamed\" {\n\t\t\tpaths = []string{claim.OldPath, claim.NewPath}\n\t\t}\n\t\tfor _, path := range paths {\n\t\t\tif err := posemodel.ValidateArtifactPath(root, path, false); err != nil {\n\t\t\t\tseverity := policy.Severities[\"resolvability\"]\n\t\t\t\tif severity == \"\" {\n\t\t\t\t\tseverity = \"warning\"\n\t\t\t\t}\n\t\t\t\tgraph.Findings = append(graph.Findings, posemodel.NewDeliveryIntegrityFinding(\"resolvability\", severity, spec, path, set.ID, err.Error(), \"declare an exact confined tracked file path\"))\n\t\t\t}\n\t\t}\n\t}\n\tsort.Slice(graph.Findings, func(i, j int) bool { return graph.Findings[i].ID < graph.Findings[j].ID })\n\tif jsonOutput {\n\t\t_ = writeJSON(stdout, graph)\n\t} else {\n\t\t// The change set's provenance is what an operator needs first when\n\t\t// `observed` exceeds `claims`: which revisions were attributed, and how\n\t\t// many commits they span. Hiding it behind --json leaves the default\n\t\t// output advising \"narrow the attributed change set\" without saying what\n\t\t// the change set is (spec pose-diagnose-invisible-governance-failures).\n\t\tfmt.Fprintf(stdout, \"artifact.spec=%s\\nartifact.change_set=%s\\nartifact.change_set.base=%s\\nartifact.change_set.head=%s\\nartifact.change_set.commits=%d\\nartifact.diff_digest=%s\\nartifact.claims=%d\\nartifact.observed=%d\\nartifact.findings=%d\\n\",\n\t\t\tspec, set.ID, set.ResolvedBase, set.ResolvedHead, len(set.Commits), set.DiffDigest, len(claims), len(set.Paths), len(graph.Findings))\n\t\t// A claim resolved through a release names a path that is no longer\n\t\t// there; say where it went, or the pass reads as magic (spec\n\t\t// pose-release-archival-attested-by-the-ledger).\n\t\tfor _, a := range graph.Archivals {\n\t\t\tfmt.Fprintf(stdout, \"artifact.archived=%s -> %s (release %s)\\n\", a.Pending, a.Archived, a.Version)\n\t\t}\n\t\tfor _, finding := range graph.Findings {\n\t\t\trender(stdout, stderr).Finding(cliout.Finding{\n\t\t\t\tState: cliout.StateFromKey(finding.Severity), Code: finding.Code, Path: finding.Path,\n\t\t\t\tMessage: finding.Message, Remediation: finding.Remediation,\n\t\t\t})\n\t\t}\n\t}\n\tif strict {\n\t\tfor _, finding := range graph.Findings {\n\t\t\tif finding.Severity == \"error\" || finding.Severity == \"critical\" {\n\t\t\t\tif !jsonOutput {\n\t\t\t\t\tPrintContributorFailureHint(root, stderr, cliLocaleValue())\n\t\t\t\t}\n\t\t\t\treturn 1\n\t\t\t}\n\t\t}\n\t}\n\tif deliveryGraph, err := buildCurrentDeliveryGraph(root); err == nil {\n\t\tif raw, err := deliveryGraph.IndexJSON(); err == nil {\n\t\t\trefreshDeliveryIndex(root, append(raw, '\\n'), stderr)\n\t\t}\n\t}\n\treturn 0\n}\n\ntype artifactBackfillProposal struct {\n\tSchemaVersion int                                 `json:\"schema_version\"`\n\tDryRun        bool                                `json:\"dry_run\"`\n\tSpecs         map[string][]posemodel.ObservedPath `json:\"specs\"`\n\tConfidence    map[string]string                   `json:\"confidence\"`\n\tConflicts     map[string][]string                 `json:\"conflicts\"`\n}\n\nfunc cmdArtifactBackfill(root string, args []string, stdout, stderr io.Writer) int {\n\tapply, confirm, fromGit := false, false, false\n\tfor _, arg := range args {\n\t\tswitch arg {\n\t\tcase \"--from-git\":\n\t\t\tfromGit = true\n\t\tcase \"--apply\":\n\t\t\tapply = true\n\t\tcase \"--confirm-spec-edits\":\n\t\t\tconfirm = true\n\t\tdefault:\n\t\t\treturn usageError(stderr, \"Usage: pose artifact-backfill --from-git [--apply --confirm-spec-edits]\")\n\t\t}\n\t}\n\tif !fromGit {\n\t\treturn usageError(stderr, \"Usage: pose artifact-backfill --from-git [--apply --confirm-spec-edits]\")\n\t}\nPOSE.md\nlocales/pt-BR/POSE.md\npose-mcp/internal/cli/help_catalog.go\npose-mcp/internal/cli/validate.go\npose-mcp/internal/cli/validate_carry.go\npose-mcp/internal/cli/validate_carry_test.go\npose-mcp/internal/cli/validate_engine_identity_test.go\npose-mcp/internal/cli/validate_results.go\npose-mcp/internal/cli/validate_scope.go\npose-mcp/internal/pose/delivery_validation_run.go\npose-mcp/internal/pose/delivery_validation_run_test.go\npose-mcp/internal/scaffold/dist/POSE.md\npose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\n# Strict matrix for pose-validate-carries-unchanged-checks, round 17\n\nThe [structured result](delivery-validation.json) is the run after the fixes for findings N46–N48 of review round 16. The engine changed, so `--carry` ran everything. It passed.\n    \"pose-verifier-assets-variable-fix\": \"unavailable\",\n    \"pose-verifier-extension-install-cwd\": \"unavailable\",\n    \"pose-version-contract\": \"sha256:ab51f0a4d2d3b1379edc83e6160d33e3033b29a78098f1224d2670bb67430a04\",\n    \"pose-workflow-event-ref-contract\": \"unavailable\",\n    \"pose-worktree-runtime-qos-and-measurement\": \"sha256:877639269b0764a77aa02fa27097d60da0a2972b58bfe3fa98fdf80383686fd1\",\n    \"pose-worktree-runtime-resident-cache\": \"sha256:dc311de6965e10d7751855ea17a0af0c325d7ca8d6a0d0f1b2102f7b2127c9a3\",\n    \"pose-writer-coordination-and-atomic-publication\": \"sha256:0d8358825118ab5ef15415803b22dc172dd75e0c5365f5f79a868858f6b6dd04\",\n    \"project-id-from-any-directory-name\": \"sha256:e4ec2bbfc33827a50e71af86191e4610362a8d7062ac178ed6d1102cd88c35fa\",\n    \"public-claims-reads-release-lines\": \"sha256:80a0ef9dee245403e32082d70046bb050b1f6daa306a2ae692efd2fda478566c\",\n    \"release-runs-the-ci-gates\": \"sha256:d4af9de4762ae83ea2058cdccb49b2033c7a5bf87bbfe6ed3dfef4917548ce11\",\n    \"retained-review-survives-an-invalid-newer-approval\": \"sha256:f9d888abdcd20b4c559ce02f1ebbace64d47e27bedc2cf2a680a18ec67b9cbd0\",\n    \"review-check-names-a-negative-verdict\": \"sha256:b13c009ce6a32cf4c454da2343f716ba2d76c47ddaf03f0486cbfcb861dd7a2d\",\n    \"review-policy-adoption-is-the-instances\": \"sha256:9a817f7e665754f284900be437e1dd9d1a4e7d3bb60e1e509c6e98e630949457\",\n    \"review-subject-classifies-capabilities\": \"sha256:b49f98c169ba8ce1a7f5cfe81c0b0fbba8059b2ba66ec63a8a0fed779a533149\",\n    \"review-verify-retains-completed-scopes\": \"sha256:2e44c4b3b9c5ece5e79a3dff3d34d152c222fd34402a94f2c2f7dd54c4549e6b\",\n    \"test-git-repos-run-no-background-maintenance\": \"sha256:925f4b780011e93d2570f8e4b4b711abd81daa08293ab4255faee5fb3e31afa8\"\n  },\n  \"engine_version\": \"7.4.1-dev+04beef1fa7edc88a2c8c55c291a53e6044975d58\",\n  \"carry\": {\n    \"used\": false,\n    \"reason\": \"the engine version differs from the canonical result's or was not recorded\",\n    \"changed\": 0\n  },\n  \"material_clean\": true,\n  \"jobs\": 8,\n  \"wall_seconds\": 614.852391134,\n  \"outcome\": \"pass\",\n  \"counts\": {\n    \"executed\": 236,\n    \"passed\": 236,\n    \"failed\": 0,\n","exit_code":0,"status":"completed"}}
