t\t\t\t}\n   233\t\t\t\tid := module.Rel + \"/\" + stack + \"/\" + check.Name\n   234\t\t\t\tif prior, ok := plan.base[id]; !ok || prior.Outcome == \"skipped\" || prior.Outcome == \"\" {\n   235\t\t\t\t\tselection.Selected[module.Rel] = \"carry: no prior result for \" + id\n   236\t\t\t\t\tbreak\n   237\t\t\t\t}\n   238\t\t\t}\n   239\t\t}\n   240\t\tplan.selection, plan.baseHead, plan.baseTime = &selection, base.GitHead, base.GeneratedAt\n   241\t\tplan.record.Used, plan.record.BaseHead, plan.record.Changed, plan.record.Selected = true, base.GitHead, len(selection.Changed), selection.Selected\n   242\t\treturn plan\n   117\t\t\t\texcluded[filepath.ToSlash(filepath.Clean(path))] = true\n   118\t\t\t}\n   119\t\t\tkept := sel.Changed[:0]\n   120\t\t\tfor _, file := range sel.Changed {\n   121\t\t\t\tif !excluded[file] {\n   122\t\t\t\t\tkept = append(kept, file)\n   123\t\t\t\t}\n   124\t\t\t}\n   125\t\t\tsel.Changed = kept\n   126\t\t}\n   127\t\tsort.Strings(sel.Changed)\n   128\t\n   129\t\tmeta, err := loadScopeMetadata(root)\n   130\t\tif err != nil {\n   131\t\t\treturn sel, err\n   132\t\t}\n   133\t\tmoduleOf := func(file string) string {\n    28\t// owned by the engine; adding a class is a contract change that needs an ADR.\n    29\tvar administrativeDirs = []string{\".pose/indexes/\", \".pose/results/\", \".pose/state/\", \".pose/assessments/\"}\n    30\t\n    31\t// materialIndexes are files inside an administrative directory that still\n    32\t// change what the checks demand.\n    33\tvar materialIndexes = map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n    34\t\n    35\t// IsAdministrativePath reports whether p is a derived administrative record.\n    36\tfunc IsAdministrativePath(p string) bool {\n    37\t\tif p == \"\" || p != path.Clean(p) || strings.HasPrefix(p, \"/\") || strings.HasPrefix(p, \"../\") {\n    38\t\t\treturn false\n    39\t\t}\n    40\t\tif materialIndexes[p] {\n    41\t\t\treturn false\n    42\t\t}\n    43\t\tif !recordExtensions[strings.ToLower(path.Ext(p))] {\n    44\t\t\treturn false\n    45\t\t}\n    46\t\tfor _, dir := range administrativeDirs {\n    47\t\t\tif strings.HasPrefix(p, dir) {\n    48\t\t\t\treturn true\n    49\t\t\t}\n    50\t\t}\n    51\t\tif rest, ok := strings.CutPrefix(p, \".pose/\"); ok {\n    52\t\t\tif i := strings.Index(rest, \"/\"); i > 0 && strings.HasPrefix(rest[:i], \"review-\") {\n    53\t\t\t\treturn true\n    54\t\t\t}\n    55\t\t}\n    56\t\treturn false\n    57\t}\n    58\t\n    59\t// recordExtensions are the data formats a derived record is written in. Code or\n    60\t// a script stored in a class is material: that keeps a source file moved or\n    61\t// copied into a class from hiding its later edits. A copied data file stays\n    62\t// indistinguishable from a record; a check that reads data out of a derived-record\n    63\t// directory is outside this contract (ADR validation-evidence-binds-to-validated-material).\n    64\tvar recordExtensions = map[string]bool{\".json\": true, \".jsonl\": true, \".ndjson\": true, \".md\": true, \".txt\": true, \".log\": true, \".transcript\": true}\n    65\t\n    66\t// TreeEntry is one entry of the validated head's tree.\n    67\ttype TreeEntry struct{ Mode, Blob string }\n    68\t\n    69\tfunc regularMode(mode string) bool { return mode == \"100644\" || mode == \"100755\" }\n    70\t\n    71\t// MaterialInputs are what a material digest is computed from: the paths a change\n    72\t// set names (both sides of a rename, and the validation matrix) and the\n    73\t// destinations of renames. They are stored with the set so the digest can be\n    74\t// recomputed against the current tree without the commits' own records.\n    75\ttype MaterialInputs struct {\n    76\t\tNames []string `json:\"names\"`\n    77\t\tMoved []string `json:\"moved,omitempty\"`\n    78\t}\n    79\t\n    80\t// MaterialInputsOf derives the inputs from per-commit path records. They must\n    81\t// be unmerged: folding a create and a later rename into one creation would hide\n    82\t// that the file moved into a class.\n    83\tfunc MaterialInputsOf(paths []ObservedPath) MaterialInputs {\n    84\t\tnames := map[string]bool{\".pose/indexes/validation-matrix.json\": true}\n","exit_code":0,"status":"completed"}}
