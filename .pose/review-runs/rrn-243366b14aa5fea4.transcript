{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n '\"'^func |writeValidation|NotifyContext|runCtx|validationSummaryOf'\"' pose-mcp/internal/cli/validate.go; cat pose-mcp/internal/cli/validate_results.go | tail -150; rg -n '\"'^func Test'\"' pose-mcp/internal/cli/validate_carry_test.go; pose suggest review --path pose-mcp\"","aggregated_output":"77:func (e *validationEntry) resolveWhen() {\n85:func (e *validationEntry) execute(parent context.Context, matrix validationMatrix, verbose bool, stdout, stderr io.Writer, beforeStream func()) {\n178:func goFlagName(arg string) (name, value string, inline, ok bool) {\n194:func goTestSelection(check validationCheck) (flag, pattern string, judged bool) {\n278:func (p *goTestPackages) Write(data []byte) (int, error) {\n300:func (p *goTestPackages) line(line string) {\n311:func (p *goTestPackages) ranNone() bool {\n317:func (e *validationEntry) markCancelled() {\n325:func dispatchValidationEntries(ctx context.Context, entries []*validationEntry, jobs int, matrix validationMatrix) {\n383:func (r *validationResources) limitMemory(available uint64) {\n389:func (r *validationResources) limitCPU(quota, period float64) {\n399:func defaultValidationJobs(available validationResources) int {\n428:func decodeMountField(field string) string {\n433:func parseCgroupMounts(raw string) []cgroupMount {\n458:func (m cgroupMount) visibleCgroupDirs(path string) ([]string, bool) {\n479:func effectiveValidationResources(read func(string) ([]byte, error), cores int) validationResources {\n588:func validationTimingNotes(run validationRunResult) []string {\n633:func parseValidationMatrix(raw []byte) (validationMatrix, error) {\n639:func parseStructuredChecks(raw []byte) ([]validationCheck, error) {\n659:func confinedRelativePath(path string) bool {\n667:func discoverValidationModulesIn(files posemodel.Files, root string) ([]validationModule, error) {\n734:func discoverValidationModules(root string) ([]validationModule, error) {\n743:func isAndroidModuleIn(files posemodel.Files, moduleDir string) bool {\n757:func isAndroidModule(moduleDir string) bool {\n764:func validationSkipReason(module string, when validationWhen) string {\n792:func validateStructuredMatrixPaths(matrix validationMatrix) error {\n821:func validateDeliveryMatrixContract(matrix validationMatrix) error {\n877:func matrixHasLegacyChecks(matrix validationMatrix) bool {\n895:func cmdValidate(root string, args []string, stdout, stderr io.Writer) int {\n901:func cmdValidateWithStore(store posemodel.Store, args []string, stdout, stderr io.Writer) int {\n1323:\trunCtx, stopSignals := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n1328:\t\t<-runCtx.Done()\n1333:\t\tgo dispatchValidationEntries(runCtx, entries, jobs, matrix)\n1371:\t\t\t} else if runCtx.Err() != nil {\n1396:\t\t\tentry.execute(runCtx, matrix, verbose, stdout, stderr, steps.Release)\n1463:\tcancelled := runCtx.Err() != nil\n1510:\t\t\"json\":  {jsonOut, writeValidationJSON},\n1511:\t\t\"junit\": {junitOut, writeValidationJUnit},\n1512:\t\t\"sarif\": {sarifOut, writeValidationSARIF},\n1577:\t\t_ = runReportWith(root, reportArgs, nil, validationSummaryOf(run), io.Discard, stderr)\n1585:// validationSummaryOf projects a finished run for `pose report`: the commands\n1593:func moduleValidationChecks(module validationModule, matrix validationMatrix, stackFilter, moduleFilter string) (string, []validationCheck, bool) {\n1611:func tailLines(text string, n int) string {\n1619:func validationSummaryOf(run validationRunResult) *validationSummary {\n1653:func sanitizeGoCheckArgs(ctx context.Context, dir, program string, args []string) []string {\n1718:func materialWorktreeClean(root string) bool {\n1752:func materialTrackedUnchanged(root string) bool {\n1784:func administrativeRecordsAreRegular(root string, paths []string) bool {\n\t})\n}\n\n// --- JUnit projection -------------------------------------------------------\n// Mapping: one <testsuite> per module, one <testcase> per check. POSE\n// \"error\" maps to <error> (infrastructure), \"fail\" to <failure>, \"skipped\"\n// to <skipped> with the deterministic reason. Optional-severity failures are\n// still <failure> — JUnit has no tolerated level, so the POSE severity is\n// preserved in the testcase classname suffix (documented lossy edge).\n\ntype junitTestCase struct {\n\tXMLName   xml.Name      `xml:\"testcase\"`\n\tName      string        `xml:\"name,attr\"`\n\tClassName string        `xml:\"classname,attr\"`\n\tTime      string        `xml:\"time,attr\"`\n\tFailure   *junitMessage `xml:\"failure,omitempty\"`\n\tError     *junitMessage `xml:\"error,omitempty\"`\n\tSkipped   *junitMessage `xml:\"skipped,omitempty\"`\n}\n\ntype junitMessage struct {\n\tMessage string `xml:\"message,attr\"`\n\tBody    string `xml:\",chardata\"`\n}\n\ntype junitSuite struct {\n\tXMLName  xml.Name        `xml:\"testsuite\"`\n\tName     string          `xml:\"name,attr\"`\n\tTests    int             `xml:\"tests,attr\"`\n\tFailures int             `xml:\"failures,attr\"`\n\tErrors   int             `xml:\"errors,attr\"`\n\tSkipped  int             `xml:\"skipped,attr\"`\n\tCases    []junitTestCase `xml:\"testcase\"`\n}\n\ntype junitSuites struct {\n\tXMLName xml.Name     `xml:\"testsuites\"`\n\tName    string       `xml:\"name,attr\"`\n\tSuites  []junitSuite `xml:\"testsuite\"`\n}\n\nfunc writeValidationJUnit(path string, run validationRunResult) error {\n\tbyModule := map[string]*junitSuite{}\n\tvar order []string\n\tfor _, c := range run.Checks {\n\t\tsuite, ok := byModule[c.Module]\n\t\tif !ok {\n\t\t\tsuite = &junitSuite{Name: c.Module}\n\t\t\tbyModule[c.Module] = suite\n\t\t\torder = append(order, c.Module)\n\t\t}\n\t\ttc := junitTestCase{\n\t\t\tName:      c.Name,\n\t\t\tClassName: \"pose-validate.\" + c.Stack + \".\" + c.Severity,\n\t\t\tTime:      fmt.Sprintf(\"%.3f\", c.DurationSeconds),\n\t\t}\n\t\tswitch c.Outcome {\n\t\tcase \"fail\":\n\t\t\tsuite.Failures++\n\t\t\ttc.Failure = &junitMessage{Message: c.Program + \" exited non-zero\", Body: c.Output}\n\t\tcase \"error\":\n\t\t\tsuite.Errors++\n\t\t\ttc.Error = &junitMessage{Message: c.Program + \" could not run\", Body: c.Output}\n\t\tcase \"skipped\":\n\t\t\tsuite.Skipped++\n\t\t\ttc.Skipped = &junitMessage{Message: c.SkipReason}\n\t\t}\n\t\tsuite.Tests++\n\t\tsuite.Cases = append(suite.Cases, tc)\n\t}\n\tdoc := junitSuites{Name: \"pose-validate\"}\n\tfor _, m := range order {\n\t\tdoc.Suites = append(doc.Suites, *byModule[m])\n\t}\n\tpayload, err := xml.MarshalIndent(doc, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.WriteFile(path, append([]byte(xml.Header), append(payload, '\\n')...), 0o644)\n}\n\n// --- SARIF projection -------------------------------------------------------\n// Mapping (SARIF 2.1.0): one run, driver \"pose-validate\", one reportingRule\n// per check ID; results only for fail/error (level: error for required,\n// warning for optional, note for infra errors of optional checks). The full\n// POSE outcome, severity and skip reason live in result properties —\n// documented extensions so the projection is never silently lossy.\n\nfunc writeValidationSARIF(path string, run validationRunResult) error {\n\trules := []map[string]any{}\n\tresults := []map[string]any{}\n\tfor _, c := range run.Checks {\n\t\trules = append(rules, map[string]any{\n\t\t\t\"id\":   c.ID,\n\t\t\t\"name\": c.Name,\n\t\t\t\"properties\": map[string]any{\n\t\t\t\t\"pose/severity\": c.Severity,\n\t\t\t\t\"pose/stack\":    c.Stack,\n\t\t\t},\n\t\t})\n\t\tif c.Outcome != \"fail\" && c.Outcome != \"error\" {\n\t\t\tcontinue\n\t\t}\n\t\tlevel := \"error\"\n\t\tif c.Severity == \"optional\" {\n\t\t\tlevel = \"warning\"\n\t\t}\n\t\tmessage := c.Program + \" failed\"\n\t\tif c.Outcome == \"error\" {\n\t\t\tmessage = c.Program + \" could not run (infrastructure)\"\n\t\t}\n\t\tresults = append(results, map[string]any{\n\t\t\t\"ruleId\":  c.ID,\n\t\t\t\"level\":   level,\n\t\t\t\"message\": map[string]any{\"text\": message},\n\t\t\t\"locations\": []map[string]any{{\n\t\t\t\t\"physicalLocation\": map[string]any{\n\t\t\t\t\t\"artifactLocation\": map[string]any{\"uri\": c.Module},\n\t\t\t\t},\n\t\t\t}},\n\t\t\t\"properties\": map[string]any{\n\t\t\t\t\"pose/outcome\":  c.Outcome,\n\t\t\t\t\"pose/severity\": c.Severity,\n\t\t\t},\n\t\t})\n\t}\n\tdoc := map[string]any{\n\t\t\"$schema\": \"https://docs.oasis-open.org/sarif/sarif/v2.1.0/sarif-schema-2.1.0.json\",\n\t\t\"version\": \"2.1.0\",\n\t\t\"runs\": []map[string]any{{\n\t\t\t\"tool\": map[string]any{\"driver\": map[string]any{\n\t\t\t\t\"name\":           \"pose-validate\",\n\t\t\t\t\"informationUri\": \"https://github.com/oseiaspereira88/pose\",\n\t\t\t\t\"version\":        Version,\n\t\t\t\t\"rules\":          rules,\n\t\t\t}},\n\t\t\t\"results\": results,\n\t\t\t\"properties\": map[string]any{\n\t\t\t\t\"pose/schema_version\": run.SchemaVersion,\n\t\t\t\t\"pose/mode\":           run.Mode,\n\t\t\t\t\"pose/outcome\":        run.Outcome,\n\t\t\t},\n\t\t}},\n\t}\n\tpayload, err := json.MarshalIndent(doc, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.WriteFile(path, append(payload, '\\n'), 0o644)\n}\n127:func TestCarryRunsOnlyTheChangedModule(t *testing.T) {\n156:func TestCarryKeepsTheOriginalHeadAcrossChainedCarries(t *testing.T) {\n173:func TestCarryKeepsACarriedFailureAFailure(t *testing.T) {\n189:func TestCarryFallsBackToAFullRun(t *testing.T) {\n242:func TestCarryRootChangeRunsEverythingUnlessSelfContained(t *testing.T) {\n265:func TestChangedScopeHonoursSelfContainedModules(t *testing.T) {\n274:func TestCarryRecordFileIsNotAChange(t *testing.T) {\n283:func TestCarrySelectsAModuleWithoutAPriorResult(t *testing.T) {\n309:func TestCarryRefusesAFilteredBase(t *testing.T) {\n321:func TestCarryRefusesIncompatibleFlags(t *testing.T) {\n334:func TestCarryIgnoresDerivedAdministrativeRecords(t *testing.T) {\n355:func TestCarryRefusesABaseThatValidatedADirtyWorkingCopy(t *testing.T) {\n378:func TestCarrySelectsBothSidesOfARename(t *testing.T) {\n395:func TestCarryKeepsTheOwnerOfAQuotedName(t *testing.T) {\n411:func TestCarryRootModuleOwnsRootFiles(t *testing.T) {\n429:func TestCarryDeletedDependencySelectsItsDependents(t *testing.T) {\n445:func TestCarryRejectsUndecodableMetadata(t *testing.T) {\n461:func TestChangedScopeGitlinkAboveADependencySelectsItsDependents(t *testing.T) {\n477:func TestCarryDeletedNestedDependencySelectsItsDependents(t *testing.T) {\n492:func TestCarryRootDependencyIsChangedByRootFiles(t *testing.T) {\n507:func TestCarryRefusesModulesReachedThroughASymlink(t *testing.T) {\n526:func TestValidateHeadMovingDuringTheRunIsNotClean(t *testing.T) {\n539:func TestChangedScopeEvaluatesEveryDeclaredDependency(t *testing.T) {\n554:func TestValidateHeadMovingDuringTheRunBindsNoMaterial(t *testing.T) {\n581:func TestCarryRefusesModulesSharingADirectory(t *testing.T) {\n601:func TestCarryPlansAgainstThePinnedHead(t *testing.T) {\n628:func TestChangedScopeDiscoveredAncestorDependencySelectsItsDependents(t *testing.T) {\n652:func TestCarryRefusesDependenciesReachedThroughASymlink(t *testing.T) {\n669:func TestCarryRefusesASymlinkInsideAModule(t *testing.T) {\n686:func TestCarryAllowsSymlinksBetweenUnownedPaths(t *testing.T) {\n707:func TestCarryDetectsACaseInsensitiveFilesystem(t *testing.T) {\n729:func TestCarryRefusesDuplicateCheckIDs(t *testing.T) {\n746:func TestCarryRefusesASymlinkFromAModuleToAnUnownedPath(t *testing.T) {\n763:func TestChangedScopeIgnoresSubmoduleHidingConfiguration(t *testing.T) {\n772:func TestValidateUntrackedMaterialCreatedDuringTheRunIsNotClean(t *testing.T) {\n785:func TestCarryRefusesAnAliasingSymlinkInsideASubmodule(t *testing.T) {\n819:func TestCarryDetectsACaseFoldedDirectory(t *testing.T) {\n844:func TestChangedScopeSelectsTheEnclosingModule(t *testing.T) {\n857:func TestCarryScansAGitlinkInsideAModule(t *testing.T) {\n888:func TestCarryRelevantDirsIncludeEveryAncestor(t *testing.T) {\n909:func TestChangedScopeRootModuleEnclosesEveryModule(t *testing.T) {\n922:func TestCarryCaseProbeSkipsUnusableEntries(t *testing.T) {\n955:func TestCarryRefusesDependenciesOutsideTheRepository(t *testing.T) {\n970:func TestCarryRefusesUncleanDependencies(t *testing.T) {\n983:func TestCarryRefusesNonASCIIPaths(t *testing.T) {\n996:func TestCarryRefusesHiddenIndexEntries(t *testing.T) {\n1018:func TestCarryRefusesDependenciesThroughAnIgnoredSymlink(t *testing.T) {\n1036:func TestValidateHeadMovingAndReturningIsNotClean(t *testing.T) {\n1050:func TestCarryCaseProbeUsesOnlyASCIILetters(t *testing.T) {\n1078:func TestValidateModeChangeHiddenByConfigurationIsNotClean(t *testing.T) {\n1094:func TestValidateUninitializedSubmoduleIsNotClean(t *testing.T) {\n1118:func TestValidateConditionClearedDuringTheRunIsNotClean(t *testing.T) {\n1135:func TestValidateSubmoduleMovingAndReturningIsNotClean(t *testing.T) {\n1166:func TestCarryRefusesABaseCancelledAtRunLevel(t *testing.T) {\n1184:func TestCarryRefusesWorkingMetadataThatDiffersFromHead(t *testing.T) {\n1197:func TestCancellationMakesBindingsUnavailable(t *testing.T) {\n1206:func TestValidateNestedSubmodulesAreNotClean(t *testing.T) {\n# POSE trail — review\n\nAvaliação técnica de PR/diff: escopo, contratos, segurança, validação.\n- Path:      pose-mcp → domain: backend-go (repo-map)\n- Workflow:  .pose/workflows/review.md\n- Skill:     pose-review\n- Rules:     .pose/rules/security.md, .pose/rules/documentation-style.md, .pose/rules/backend-go.md\n- Spec:      false\n- ADR:       false\n- Knowledge: consume=true, produce=handoff (quando aceitar risco residual ou condicionar merge)\n- Validation: exigir evidência de pose validate do implementador\n","exit_code":0,"status":"completed"}}
