\t\treturn -1\n   641\t\t}\n   642\t\treturn lines\n   643\t}\n   644\t\n   645\t// submodulesCheckedOut returns a gitlink of head whose working repository is\n   723\tfunc movementWitness(root, head string) string {\n   724\t\tparent := headReflogLength(root)\n   725\t\tif parent < 0 || head == \"\" {\n   726\t\t\treturn \"\"\n   727\t\t}\n   728\t\tparts := []string{fmt.Sprintf(\".=%d\", parent)}\n   729\t\tlinks, err := gitlinks(root, head)\n   730\t\tif err != nil {\n   731\t\t\treturn \"\"\n   732\t\t}\n   733\t\tsubs := make([]string, 0, len(links))\n   734\t\tfor sub := range links {\n   735\t\t\tsubs = append(subs, sub)\n   736\t\t}\n   737\t\tsort.Strings(subs)\n   738\t\tfor _, sub := range subs {\n   739\t\t\trepo := filepath.Join(root, filepath.FromSlash(sub))\n   740\t\t\tif _, err := os.Stat(filepath.Join(repo, \".git\")); err != nil {\n   741\t\t\t\tparts = append(parts, sub+\"=absent\")\n   742\t\t\t\tcontinue\n   743\t\t\t}\n   744\t\t\tn := headReflogLength(repo)\n   745\t\t\tif n < 0 {\n   746\t\t\t\treturn \"\"\n   747\t\t\t}\n   748\t\t\tparts = append(parts, fmt.Sprintf(\"%s=%d\", sub, n))\n   749\t\t}\n   750\t\treturn strings.Join(parts, \",\")\n   751\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_37","type":"agent_message","text":"I’m treating the transient-edit case as a blocker: endpoint cleanliness and reflog continuity do not prove that a check observed the committed material D1 binds it to. A cancelled base and submodule commit movement are now handled, but an uncommitted edit followed by `git restore` leaves neither witness. This finding is based on source tracing; the read-only scratch directory prevented a new fixture reproduction.\n"}}
