{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/cli/doctor.go'","aggregated_output":"     1\tpackage cli\n     2\t\n     3\t// pose doctor — installation and instance diagnostics (spec pose-doctor,\n     4\t// pose-doctor-guided-remediation). Diagnosis is always read-only; mutation\n     5\t// only happens under --fix, defaults to a dry-run preview, and requires\n     6\t// --yes to actually apply — never silently.\n     7\t\n     8\timport (\n     9\t\t\"bytes\"\n    10\t\t\"context\"\n    11\t\t\"encoding/json\"\n    12\t\t\"fmt\"\n    13\t\t\"io\"\n    14\t\t\"io/fs\"\n    15\t\t\"os\"\n    16\t\t\"os/exec\"\n    17\t\t\"path/filepath\"\n    18\t\t\"sort\"\n    19\t\t\"strconv\"\n    20\t\t\"strings\"\n    21\t\n    22\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n    23\t\t\"github.com/harne8/pose-mcp/internal/scaffold\"\n    24\t\t\"github.com/harne8/pose-mcp/internal/version\"\n    25\t)\n    26\t\n    27\t// doctorSchemaVersion versions doctor's own JSON output shape (distinct\n    28\t// from the POSE instance schema-version). Existing fields are never\n    29\t// renamed or removed across versions — only added — so consumers pinned to\n    30\t// v1 keep working; bump this only for a genuinely breaking shape change.\n    31\t// Version 2 added the \"next\" level and the \"next_steps\" count (spec\n    32\t// pose-fresh-install-doctor-is-clean).\n    33\tconst doctorSchemaVersion = 2\n    34\t\n    35\t// remediationClass distinguishes what an operator (or an automated caller)\n    36\t// can do about a finding (spec pose-doctor-guided-remediation R2):\n    37\t//   - \"n/a\": informational, level is ok.\n    38\t//   - \"fixable\": pose itself can apply a confined, reversible fix via\n    39\t//     `pose doctor --fix`.\n    40\t//   - \"detectable\": diagnosed with a concrete hint, but the fix is outside\n    41\t//     doctor's confined-mutation scope (e.g. `pose upgrade`, a manual\n    42\t//     `pose install`) and must be run explicitly by the operator.\n    43\t//   - \"blocked\": outside POSE's control entirely (missing external tool).\n    44\tconst (\n    45\t\tremediationNA         = \"n/a\"\n    46\t\tremediationFixable    = \"fixable\"\n    47\t\tremediationDetectable = \"detectable\"\n    48\t\tremediationBlocked    = \"blocked\"\n    49\t)\n    50\t\n    51\ttype doctorFinding struct {\n    52\t\tCheck             string `json:\"check\"`\n    53\t\tLevel             string `json:\"level\"` // ok | next | warn | error\n    54\t\tMessage           string `json:\"message\"`\n    55\t\tHint              string `json:\"hint,omitempty\"`\n    56\t\tEvidence          string `json:\"evidence,omitempty\"`\n    57\t\tRemediationClass  string `json:\"remediation_class\"`\n    58\t\tFixCode           string `json:\"fix_code,omitempty\"`\n    59\t\tDiagnosticScope   string `json:\"diagnostic_scope,omitempty\"`\n    60\t\tConnectionChecked *bool  `json:\"connection_checked,omitempty\"`\n    61\t}\n    62\t\n    63\t// doctorFix is a confined, reversible, idempotent remediation action. Every\n    64\t// entry here is safe to apply blind (no destructive or irreversible\n    65\t// operation, never touches instance content) — that confinement is what\n    66\t// lets `pose doctor --fix --yes` apply it without per-action confirmation\n    67\t// once the operator has already opted into --yes.\n    68\ttype doctorFix struct {\n    69\t\tdescribe string\n    70\t\tapply    func(root string) error\n    71\t}\n    72\t\n    73\tvar doctorFixRegistry = map[string]doctorFix{\n    74\t\t\"hooks.pre-commit\": {\n    75\t\t\tdescribe: \"install the pre-commit hook (pose hooks install)\",\n    76\t\t\tapply: func(root string) error {\n    77\t\t\t\tvar out, errB bytes.Buffer\n    78\t\t\t\tif code := cmdHooks(root, []string{\"install\"}, &out, &errB); code != 0 {\n    79\t\t\t\t\treturn fmt.Errorf(\"%s\", strings.TrimSpace(errB.String()))\n    80\t\t\t\t}\n    81\t\t\t\treturn nil\n    82\t\t\t},\n    83\t\t},\n    84\t\t\"mcp.config\": {\n    85\t\t\tdescribe: \"regenerate .mcp.json to point at the native pose binary\",\n    86\t\t\tapply: func(root string) error {\n    87\t\t\t\tprojectID := posemodel.DefaultProjectID(root)\n    88\t\t\t\t_, err := configureMCP(filepath.Join(root, \".mcp.json\"), root, projectID)\n    89\t\t\t\treturn err\n    90\t\t\t},\n    91\t\t},\n    92\t\t\"skills.symlinks\": {\n    93\t\t\tdescribe: \"recreate .claude/skills symlinks\",\n    94\t\t\tapply: func(root string) error {\n    95\t\t\t\tlinked, err := recreateClaudeSkillSymlinks(root)\n    96\t\t\t\tif err != nil {\n    97\t\t\t\t\treturn err\n    98\t\t\t\t}\n    99\t\t\t\tif !linked {\n   100\t\t\t\t\treturn fmt.Errorf(\"filesystem does not support symlinks\")\n   101\t\t\t\t}\n   102\t\t\t\treturn nil\n   103\t\t\t},\n   104\t\t},\n   105\t}\n   106\t\n   107\t// classifyFinding derives the guided-remediation class from the check code\n   108\t// and level, so every call site of add() stays a plain (check, level,\n   109\t// message, hint) tuple — the classification lives in one place.\n   110\tfunc classifyFinding(check, level string) (class, fixCode string) {\n   111\t\tif level == \"ok\" {\n   112\t\t\treturn remediationNA, \"\"\n   113\t\t}\n   114\t\tif _, ok := doctorFixRegistry[check]; ok {\n   115\t\t\treturn remediationFixable, check\n   116\t\t}\n   117\t\tswitch check {\n   118\t\tcase \"deps.git\", \"deps.go\":\n   119\t\t\treturn remediationBlocked, \"\"\n   120\t\t}\n   121\t\treturn remediationDetectable, \"\"\n   122\t}\n   123\t\n   124\t// redactSecretShapedContent is the same offline, deterministic defense-in-depth scan\n   125\t// pose skills-check applies to skill content (secretLikePatterns,\n   126\t// skills_check.go) — doctor never prints a secret even if a future check\n   127\t// starts echoing file content as evidence (security requirement: never\n   128\t// print secrets).\n   129\tfunc redactSecretShapedContent(s string) string {\n   130\t\tfor _, re := range secretLikePatterns {\n   131\t\t\ts = re.ReplaceAllString(s, \"[REDACTED]\")\n   132\t\t}\n   133\t\treturn s\n   134\t}\n   135\t\n   136\tfunc cmdDoctor(args []string, stdout, stderr io.Writer) int {\n   137\t\tlocale := cliLocaleValue()\n   138\t\ttext := func(english, portuguese string) string { return cliText(locale, english, portuguese) }\n   139\t\tjsonOut, fix, yes := false, false, false\n   140\t\tonly := \"\"\n   141\t\tfor i := 0; i < len(args); i++ {\n   142\t\t\ta := args[i]\n   143\t\t\tswitch a {\n   144\t\t\tcase \"--json\":\n   145\t\t\t\tjsonOut = true\n   146\t\t\tcase \"--fix\":\n   147\t\t\t\tfix = true\n   148\t\t\tcase \"--dry-run\":\n   149\t\t\t\t// explicit alias for --fix's default (no-op if --yes not set)\n   150\t\t\tcase \"--yes\":\n   151\t\t\t\tyes = true\n   152\t\t\tcase \"--only\":\n   153\t\t\t\tif i+1 >= len(args) {\n   154\t\t\t\t\tfmt.Fprintln(stderr, text(\"Error: --only requires a check code\", \"Erro: --only exige um código de check\"))\n   155\t\t\t\t\treturn 2\n   156\t\t\t\t}\n   157\t\t\t\ti++\n   158\t\t\t\tonly = args[i]\n   159\t\t\tcase \"-h\", \"--help\":\n   160\t\t\t\tfmt.Fprintln(stdout, text(\n   161\t\t\t\t\t\"Usage: pose doctor [--json] [--fix [--yes] [--only <check>]] — read-only diagnostics, optional guided remediation\",\n   162\t\t\t\t\t\"Uso: pose doctor [--json] [--fix [--yes] [--only <check>]] — diagnóstico read-only, remediação guiada opcional\"))\n   163\t\t\t\treturn 0\n   164\t\t\tdefault:\n   165\t\t\t\tfmt.Fprintf(stderr, text(\"Error: invalid argument: %s\\n\", \"Erro: argumento inválido: %s\\n\"), a)\n   166\t\t\t\treturn 2\n   167\t\t\t}\n   168\t\t}\n   169\t\tif yes && !fix {\n   170\t\t\tfmt.Fprintln(stderr, text(\"Error: --yes requires --fix\", \"Erro: --yes exige --fix\"))\n   171\t\t\treturn 2\n   172\t\t}\n   173\t\tif only != \"\" && !fix {\n   174\t\t\tfmt.Fprintln(stderr, text(\"Error: --only requires --fix\", \"Erro: --only exige --fix\"))\n   175\t\t\treturn 2\n   176\t\t}\n   177\t\tif only != \"\" {\n   178\t\t\tif _, ok := doctorFixRegistry[only]; !ok {\n   179\t\t\t\tfmt.Fprintf(stderr, text(\"Error: %q is not a fixable check code (available: %s)\\n\", \"Erro: %q não é um código de check corrigível (disponíveis: %s)\\n\"), only, strings.Join(fixableCodes(), \", \"))\n   180\t\t\t\treturn 2\n   181\t\t\t}\n   182\t\t}\n   183\t\n   184\t\troot, findings := runDoctorDiagnostics(locale)\n   185\t\tif !fix {\n   186\t\t\treturn doctorReport(root, findings, jsonOut, stdout, locale)\n   187\t\t}\n   188\t\n   189\t\tvar candidates []string\n   190\t\tfor _, f := range findings {\n   191\t\t\tif f.RemediationClass != remediationFixable {\n   192\t\t\t\tcontinue\n   193\t\t\t}\n   194\t\t\tif only != \"\" && f.FixCode != only {\n   195\t\t\t\tcontinue\n   196\t\t\t}\n   197\t\t\tcandidates = append(candidates, f.FixCode)\n   198\t\t}\n   199\t\n   200\t\tif !yes {\n   201\t\t\treturn doctorFixPreview(findings, candidates, jsonOut, stdout, locale)\n   202\t\t}\n   203\t\treturn doctorFixApply(root, findings, candidates, jsonOut, stdout, stderr, locale)\n   204\t}\n   205\t\n   206\tfunc fixableCodes() []string {\n   207\t\tcodes := make([]string, 0, len(doctorFixRegistry))\n   208\t\tfor c := range doctorFixRegistry {\n   209\t\t\tcodes = append(codes, c)\n   210\t\t}\n   211\t\treturn codes\n   212\t}\n   213\t\n   214\t// runDoctorDiagnostics is the read-only diagnostic pass, factored out so\n   215\t// --fix --yes can call it again after applying fixes (recheck, R3).\n   216\tfunc runDoctorDiagnostics(locale cliLocale) (root string, findings []doctorFinding) {\n   217\t\ttext := func(english, portuguese string) string { return cliText(locale, english, portuguese) }\n   218\t\tadd := func(check, level, message, hint string) {\n   219\t\t\tclass, fixCode := classifyFinding(check, level)\n   220\t\t\tfindings = append(findings, doctorFinding{\n   221\t\t\t\tCheck:            check,\n   222\t\t\t\tLevel:            level,\n   223\t\t\t\tMessage:          redactSecretShapedContent(message),\n   224\t\t\t\tHint:             redactSecretShapedContent(hint),\n   225\t\t\t\tEvidence:         redactSecretShapedContent(message),\n   226\t\t\t\tRemediationClass: class,\n   227\t\t\t\tFixCode:          fixCode,\n   228\t\t\t})\n   229\t\t}\n   230\t\tmarkStaticMCPConfig := func() {\n   231\t\t\tchecked := false\n   232\t\t\tfindings[len(findings)-1].DiagnosticScope = \"static-configuration\"\n   233\t\t\tfindings[len(findings)-1].ConnectionChecked = &checked\n   234\t\t}\n   235\t\n   236\t\t// 1. Binary + toolchain deps.\n   237\t\tadd(\"binary\", \"ok\", fmt.Sprintf(\"pose %s\", Version), \"\")\n   238\t\tif _, err := exec.LookPath(\"git\"); err != nil {\n   239\t\t\tadd(\"deps.git\", \"error\", text(\"git not found in PATH\", \"git não encontrado no PATH\"), text(\"install git; POSE uses it to resolve the project root\", \"instale git — o POSE resolve o root do projeto por ele\"))\n   240\t\t} else {\n   241\t\t\tadd(\"deps.git\", \"ok\", text(\"git available\", \"git disponível\"), \"\")\n   242\t\t}\n   243\t\tif _, err := exec.LookPath(\"go\"); err != nil {\n   244\t\t\tadd(\"deps.go\", \"warn\", text(\"go not found (optional; needed only to rebuild MCP)\", \"go não encontrado (opcional: só para rebuild do MCP)\"), \"\")\n   245\t\t} else {\n   246\t\t\tadd(\"deps.go\", \"ok\", text(\"go available\", \"go disponível\"), \"\")\n   247\t\t}\n   248\t\n   249\t\t// 2. Instance.\n   250\t\tr, err := projectRoot()\n   251\t\tif err != nil {\n   252\t\t\tadd(\"instance.root\", \"error\", fmt.Sprintf(text(\"could not resolve root: %v\", \"root não resolvido: %v\"), err), \"\")\n   253\t\t\treturn \"\", findings\n   254\t\t}\n   255\t\troot = r\n   256\t\tadd(\"instance.root\", \"ok\", root, \"\")\n   257\t\tposeDir := filepath.Join(root, \".pose\")\n   258\t\tif fi, err := os.Stat(poseDir); err != nil || !fi.IsDir() {\n   259\t\t\tadd(\"instance.pose-dir\", \"error\", text(\".pose/ not found — POSE is not installed in this repository\", \".pose/ ausente — este repo não tem POSE instalado\"),\n   260\t\t\t\ttext(\"run the POSE distribution install.sh\", \"rode o install.sh da distribuição POSE\"))\n   261\t\t\treturn root, findings\n   262\t\t}\n   263\t\tadd(\"instance.pose-dir\", \"ok\", text(\".pose/ present\", \".pose/ presente\"), \"\")\n   264\t\tdiagnoseProjectState(root, add, text)\n   265\t\tdiagnoseCloseoutReviewPolicy(root, add, text)\n   266\t\tdiagnoseReviewContinuity(root, add)\n   267\t\n   268\t\t// 3. Native engine contract.\n   269\t\tadd(\"engine.native\", \"ok\", text(\"native Go engine active; no script runtime required\", \"motor Go nativo ativo; runtime de scripts não é necessário\"), \"\")\n   270\t\n   271\t\t// 4. Schema version.\n   272\t\tsvPath := filepath.Join(poseDir, \"schema-version\")\n   273\t\tengineVersion := engineSchemaVersion(root)\n   274\t\tif b, err := os.ReadFile(svPath); err != nil {\n   275\t\t\tadd(\"schema.version\", \"warn\", text(\"instance has no .pose/schema-version\", \"instância sem .pose/schema-version\"), text(\"run 'pose update'\", \"rode 'pose update'\"))\n   276\t\t} else {\n   277\t\t\tinstance := strings.TrimSpace(string(b))\n   278\t\t\tn, convErr := strconv.Atoi(instance)\n   279\t\t\tswitch {\n   280\t\t\tcase convErr != nil:\n   281\t\t\t\tadd(\"schema.version\", \"error\", fmt.Sprintf(text(\"invalid schema-version: %q\", \"schema-version inválido: %q\"), instance), text(\"run 'pose update'\", \"rode 'pose update'\"))\n   282\t\t\tcase engineVersion > 0 && n > engineVersion:\n   283\t\t\t\tadd(\"schema.version\", \"error\",\n   284\t\t\t\t\tfmt.Sprintf(text(\"instance v%d is newer than engine v%d\", \"instância v%d é mais nova que o motor v%d\"), n, engineVersion),\n   285\t\t\t\t\ttext(\"update the POSE engine; downgrade is unsupported\", \"atualize o motor POSE (não há downgrade)\"))\n   286\t\t\tcase engineVersion > 0 && n < engineVersion:\n   287\t\t\t\tadd(\"schema.version\", \"warn\",\n   288\t\t\t\t\tfmt.Sprintf(text(\"instance v%d is behind engine v%d\", \"instância v%d atrás do motor v%d\"), n, engineVersion), text(\"run 'pose update'\", \"rode 'pose update'\"))\n   289\t\t\tdefault:\n   290\t\t\t\tadd(\"schema.version\", \"ok\", \"schema v\"+instance, \"\")\n   291\t\t\t}\n   292\t\t}\n   293\t\n   294\t\t// 5. Skills symlinks (.claude/skills → .agents/skills).\n   295\t\tclaudeSkills := filepath.Join(root, \".claude\", \"skills\")\n   296\t\tif entries, err := os.ReadDir(claudeSkills); err == nil {\n   297\t\t\tbroken := 0\n   298\t\t\tnames := []string{}\n   299\t\t\tfor _, e := range entries {\n   300\t\t\t\tlink := filepath.Join(claudeSkills, e.Name())\n   301\t\t\t\tif fi, err := os.Lstat(link); err == nil && fi.Mode()&os.ModeSymlink != 0 {\n   302\t\t\t\t\tif _, err := os.Stat(link); err != nil {\n   303\t\t\t\t\t\tbroken++\n   304\t\t\t\t\t\tnames = append(names, e.Name())\n   305\t\t\t\t\t}\n   306\t\t\t\t}\n   307\t\t\t}\n   308\t\t\tif broken > 0 {\n   309\t\t\t\tadd(\"skills.symlinks\", \"error\", fmt.Sprintf(text(\"%d broken symlink(s) under .claude/skills: %s\", \"%d symlink(s) quebrado(s) em .claude/skills: %s\"), broken, strings.Join(names, \", \")), text(\"rerun install.sh to recreate symlinks\", \"re-rode o install.sh para recriar os symlinks\"))\n   310\t\t\t} else {\n   311\t\t\t\tadd(\"skills.symlinks\", \"ok\", text(\"skill symlinks are healthy\", \"symlinks de skills íntegros\"), \"\")\n   312\t\t\t}\n   313\t\t}\n   314\t\n   315\t\t// Where this project's identity is declared, and whether an environment\n   316\t\t// binding disagrees with it (spec pose-project-identity-file).\n   317\t\tif declared, ok, fileErr := posemodel.ReadProjectFile(root); fileErr != nil {\n   318\t\t\tadd(\"project.identity\", \"error\", fileErr.Error(), text(\"fix .pose/project.json: {\\\"schema_version\\\":1,\\\"project_id\\\":\\\"proj.<name>\\\"}\", \"corrija .pose/project.json: {\\\"schema_version\\\":1,\\\"project_id\\\":\\\"proj.<nome>\\\"}\"))\n   319\t\t} else if !ok {\n   320\t\t\tadd(\"project.identity\", \"warn\", fmt.Sprintf(text(\"no .pose/project.json: the project id is derived from the directory name (%s) and changes with the checkout\", \"sem .pose/project.json: o id do projeto vem do nome do diretório (%s) e muda com o checkout\"), posemodel.DefaultProjectID(root)), text(\"declare it: {\\\"schema_version\\\":1,\\\"project_id\\\":\\\"proj.<name>\\\"} in .pose/project.json\", \"declare-o: {\\\"schema_version\\\":1,\\\"project_id\\\":\\\"proj.<nome>\\\"} em .pose/project.json\"))\n   321\t\t} else if env := os.Getenv(\"POSE_DEFAULT_PROJECT_ID\"); env != \"\" && env != declared {\n   322\t\t\tadd(\"project.identity\", \"warn\", fmt.Sprintf(text(\"POSE_DEFAULT_PROJECT_ID is %s but .pose/project.json declares %s; resolution refuses the conflict\", \"POSE_DEFAULT_PROJECT_ID é %s mas .pose/project.json declara %s; a resolução recusa o conflito\"), env, declared), text(\"make the binding (.mcp.json or the environment) name the declared id\", \"faça o vínculo (.mcp.json ou ambiente) usar o id declarado\"))\n   323\t\t} else {\n   324\t\t\tadd(\"project.identity\", \"ok\", fmt.Sprintf(text(\"project %s declared in .pose/project.json\", \"projeto %s declarado em .pose/project.json\"), declared), \"\")\n   325\t\t}\n   326\t\t// An instance last updated by an older engine reads current everywhere else;\n   327\t\t// only its stamp says otherwise (spec pose-update-dry-run-reports-the-whole-update).\n   328\t\tif stale := staleInstanceEngine(root); stale != \"\" {\n   329\t\t\tadd(\"instance.engine\", \"warn\", fmt.Sprintf(text(\"the instance was last updated by POSE %s and this engine is %s\", \"a instância foi atualizada pela última vez pelo POSE %s e este motor é %s\"), stale, version.ReleaseBase()), text(\"run 'pose update' (preview with 'pose update --dry-run')\", \"rode 'pose update' (prévia com 'pose update --dry-run')\"))\n   330\t\t}\n   331\t\t// 6. MCP uses the same native binary directly.\n   332\t\tif b, err := os.ReadFile(filepath.Join(root, \".mcp.json\")); err != nil {\n   333\t\t\tadd(\"mcp.config\", \"warn\", text(\"static .mcp.json configuration not found\", \"configuração estática .mcp.json ausente\"), text(\"run 'pose install', then restart/reconnect the client and call pose_mcp_context\", \"rode 'pose install', reinicie/reconecte o cliente e chame pose_mcp_context\"))\n   334\t\t\tmarkStaticMCPConfig()\n   335\t\t} else if id := declaredMCPProjectID(b); id != \"\" && posemodel.ValidateSlug(id) != nil {\n   336\t\t\t// Engines before 6.0.1 stamped \"proj.\" + the directory name verbatim, so\n   337\t\t\t// a checkout named MyApp carries an id every resolver refuses.\n   338\t\t\tadd(\"mcp.config\", \"warn\", fmt.Sprintf(text(\"static MCP configuration declares an invalid project id %q\", \"configuração estática MCP declara um id de projeto inválido %q\"), id), fmt.Sprintf(text(\"run 'pose doctor --fix --yes' to declare %s, then restart/reconnect the client\", \"rode 'pose doctor --fix --yes' para declarar %s e reinicie/reconecte o cliente\"), posemodel.DefaultProjectID(root)))\n   339\t\t\tmarkStaticMCPConfig()\n   340\t\t} else if strings.Contains(string(b), `\"command\": \"pose\"`) {\n   341\t\t\tadd(\"mcp.config\", \"ok\", text(\"static MCP configuration points to the native pose binary\", \"configuração estática MCP aponta para o binário pose nativo\"), text(\"active connection not checked; call pose_mcp_context after workspace or configuration changes\", \"conexão ativa não verificada; chame pose_mcp_context após mudar workspace ou configuração\"))\n   342\t\t\tmarkStaticMCPConfig()\n   343\t\t} else {\n   344\t\t\tadd(\"mcp.config\", \"warn\", text(\"static MCP configuration does not use the native pose command\", \"configuração estática MCP não usa o comando pose nativo\"), text(\"regenerate .mcp.json with 'pose install', restart/reconnect, then call pose_mcp_context\", \"regenere .mcp.json com 'pose install', reinicie/reconecte e chame pose_mcp_context\"))\n   345\t\t\tmarkStaticMCPConfig()\n   346\t\t}\n   347\t\n   348\t\t// 7. Git hooks.\n   349\t\thook := filepath.Join(posemodel.GitHooksDir(root), \"pre-commit\")\n   350\t\tif _, err := os.Lstat(hook); err != nil {\n   351\t\t\t// A recommended step, not a problem: a fresh install reports it as next\n   352\t\t\t// (spec pose-fresh-install-doctor-is-clean).\n   353\t\t\tadd(\"hooks.pre-commit\", \"next\", text(\"pre-commit hook not installed\", \"pre-commit não instalado\"), text(\"run 'pose hooks install' (or 'pose doctor --fix --yes') for an automatic commit gate\", \"rode 'pose hooks install' (ou 'pose doctor --fix --yes') para gate automático no commit\"))\n   354\t\t} else {\n   355\t\t\tadd(\"hooks.pre-commit\", \"ok\", text(\"pre-commit hook installed\", \"pre-commit instalado\"), \"\")\n   356\t\t}\n   357\t\n   358\t\t// 8. Delivery-integrity / artifact-contract policy roots (issue #17): a\n   359\t\t// v1.2.0 `pose install`/`pose update --force` could seed\n   360\t\t// .pose/policy/{delivery,artifacts}.json with roots copied verbatim from\n   361\t\t// pose-mcp's own source tree (fixed at the source in\n   362\t\t// internal/scaffold/distpolicy — see NeutralPolicyTemplates). An instance\n   363\t\t// that already seeded those files before the fix keeps the contaminated\n   364\t\t// content — `pose install`/`update` never overwrite an existing policy\n   365\t\t// file — so detect it here instead of relying on a fresh\n   366\t\t// install/update to self-heal.\n   367\t\tif dp, err := posemodel.LoadDeliveryPolicy(root); err == nil && dp.Enabled && len(dp.Roots) > 0 {\n   368\t\t\tvar missing []string\n   369\t\t\tfor _, r := range dp.Roots {\n   370\t\t\t\tif _, err := os.Stat(filepath.Join(root, filepath.FromSlash(r.Path))); err != nil {\n   371\t\t\t\t\tmissing = append(missing, r.Path)\n   372\t\t\t\t}\n   373\t\t\t}\n   374\t\t\tif len(missing) == len(dp.Roots) {\n   375\t\t\t\tadd(\"policy.delivery-roots\", \"warn\",\n   376\t\t\t\t\tfmt.Sprintf(text(\"delivery policy roots do not exist in this project: %s\", \"raízes da política de entrega não existem neste projeto: %s\"), strings.Join(missing, \", \")),\n   377\t\t\t\t\ttext(\"check .pose/policy/delivery.json — roots may have been inherited from a contaminated pose-mcp v1.2.0 template (github.com/oseiaspereira88/pose issue #17); replace with this project's own module paths\",\n   378\t\t\t\t\t\t\".pose/policy/delivery.json — as roots podem ter vindo de um template pose-mcp v1.2.0 contaminado (issue #17); substitua pelos caminhos reais deste projeto\"))\n   379\t\t\t} else {\n   380\t\t\t\tadd(\"policy.delivery-roots\", \"ok\", text(\"delivery policy roots resolve in this project\", \"raízes da política de entrega resolvem neste projeto\"), \"\")\n   381\t\t\t}\n   382\t\t}\n   383\t\tif ap, err := posemodel.LoadArtifactPolicy(root); err == nil && ap.Enabled && len(ap.GovernedRoots) > 0 {\n   384\t\t\tvar missing []string\n   385\t\t\tfor _, p := range ap.GovernedRoots {\n   386\t\t\t\tif _, err := os.Stat(filepath.Join(root, filepath.FromSlash(p))); err != nil {\n   387\t\t\t\t\tmissing = append(missing, p)\n   388\t\t\t\t}\n   389\t\t\t}\n   390\t\t\tif len(missing) == len(ap.GovernedRoots) {\n   391\t\t\t\tadd(\"policy.artifact-roots\", \"warn\",\n   392\t\t\t\t\tfmt.Sprintf(text(\"artifact policy governed_roots do not exist in this project: %s\", \"governed_roots da política de artefatos não existem neste projeto: %s\"), strings.Join(missing, \", \")),\n   393\t\t\t\t\ttext(\"check .pose/policy/artifacts.json — governed_roots may have been inherited from a contaminated pose-mcp v1.2.0 template (github.com/oseiaspereira88/pose issue #17); replace with this project's own source directories\",\n   394\t\t\t\t\t\t\".pose/policy/artifacts.json — governed_roots podem ter vindo de um template pose-mcp v1.2.0 contaminado (issue #17); substitua pelos diretórios reais deste projeto\"))\n   395\t\t\t} else {\n   396\t\t\t\tadd(\"policy.artifact-roots\", \"ok\", text(\"artifact policy governed_roots resolve in this project\", \"governed_roots da política de artefatos resolvem neste projeto\"), \"\")\n   397\t\t\t}\n   398\t\t}\n   399\t\n   400\t\t// 8a. Instance config completeness. A `.pose/schema-version` stamp means\n   401\t\t// this instance considers itself current, so the subsystems every other\n   402\t\t// current instance has should exist too. Before spec\n   403\t\t// pose-upgrade-path-audit-fixes, a plain `pose update`\n   404\t\t// (without --force) refreshed AGENTS.md/POSE.md to reference these\n   405\t\t// subsystems without ever seeding them on an old instance, so `Result:\n   406\t\t// SUCCESS` could be followed immediately by `pose check --strict`\n   407\t\t// failing with broken references — and this same doctor run reported no\n   408\t\t// error. Detected here so an instance a stale binary already left in\n   409\t\t// that state surfaces it, not just prevented going forward.\n   410\t\tif _, err := os.Stat(filepath.Join(root, \".pose\", \"schema-version\")); err == nil {\n   411\t\t\tvar missing []string\n   412\t\t\tfor _, rel := range []string{\n   413\t\t\t\tfilepath.Join(\".pose\", \"policy\", \"delivery.json\"),\n   414\t\t\t\tfilepath.Join(\".pose\", \"policy\", \"artifacts.json\"),\n   415\t\t\t\tfilepath.Join(\".pose\", \"indexes\", \"spec-graph.json\"),\n   416\t\t\t\tfilepath.Join(\".pose\", \"indexes\", \"extensions.lock.json\"),\n   417\t\t\t} {\n   418\t\t\t\tif _, err := os.Stat(filepath.Join(root, rel)); err != nil {\n   419\t\t\t\t\tmissing = append(missing, filepath.ToSlash(rel))\n   420\t\t\t\t}\n   421\t\t\t}\n   422\t\t\tif len(missing) > 0 {\n   423\t\t\t\tadd(\"instance.config-completeness\", \"warn\",\n   424\t\t\t\t\tfmt.Sprintf(text(\"subsystems referenced by this instance's manuals were never seeded: %s\", \"subsistemas referenciados pelos manuais desta instância nunca foram semeados: %s\"), strings.Join(missing, \", \")),\n   425\t\t\t\t\ttext(\"run 'pose update' to seed them (safe: additive-only, never overwrites an existing file)\", \"rode 'pose update' para semeá-los (seguro: só adiciona, nunca sobrescreve um arquivo existente)\"))\n   426\t\t\t} else {\n   427\t\t\t\tadd(\"instance.config-completeness\", \"ok\", text(\"subsystems referenced by this instance's manuals are all seeded\", \"subsistemas referenciados pelos manuais desta instância estão todos semeados\"), \"\")\n   428\t\t\t}\n   429\t\t}\n   430\t\n   431\t\t// 9. Review-scope recorded change set coverage (issue #17, comments 2-3):\n   432\t\t// `pose review bundle <scope> --seal` reads its subject exclusively from\n   433\t\t// graph.ChangeSets (`.pose/indexes/delivery-integrity.json`), which\n   434\t\t// `pose index` builds solely from change sets persisted via\n   435\t\t// `pose report --spec <slug> --change-from <rev> --change-to <rev>`\n   436\t\t// (loadRecordedChangeSets, reports/history/*.jsonl). A commit carrying\n   437\t\t// the `POSE-Spec: <slug>` trailer does NOT by itself make a spec\n   438\t\t// sealable — that trailer only feeds resolveGitChangeSet's live\n   439\t\t// auto-discovery fallback used by `pose artifact-check`/\n   440\t\t// `artifact-backfill --from-git` when called without --from/--to, which\n   441\t\t// is a different, ephemeral code path that never persists into the\n   442\t\t// index. (This corrects the original issue #17 investigation, which\n   443\t\t// attributed the review-bundle blocking to missing trailers; verified\n   444\t\t// empirically while implementing this check — spec\n   445\t\t// pose-review-scope-trailer-check Decision 2.) Warn before someone hits\n   446\t\t// \"no immutable attributed change set exists\" at seal time.\n   447\t\tif specs, err := (posemodel.Store{Root: root}).ListSpecs(\"\", \"\"); err == nil {\n   448\t\t\trecorded := map[string]bool{}\n   449\t\t\tfor _, set := range loadRecordedChangeSets(root) {\n   450\t\t\t\tif set.Spec != \"\" {\n   451\t\t\t\t\trecorded[set.Spec] = true\n   452\t\t\t\t}\n   453\t\t\t}\n   454\t\t\tif trailers, err := allCommitsWithSpecTrailers(root); err == nil {\n   455\t\t\t\tfor spec := range trailers {\n   456\t\t\t\t\trecorded[spec] = true\n   457\t\t\t\t}\n   458\t\t\t}\n   459\t\t\tvar untraceable []string\n   460\t\t\tfor _, spec := range specs {\n   461\t\t\t\tif len(spec.Delivers) == 0 {\n   462\t\t\t\t\tcontinue\n   463\t\t\t\t}\n   464\t\t\t\tif spec.Status != \"in-progress\" && spec.Status != \"done\" {\n   465\t\t\t\t\tcontinue\n   466\t\t\t\t}\n   467\t\t\t\tif recorded[spec.Slug] {\n   468\t\t\t\t\tcontinue\n   469\t\t\t\t}\n   470\t\t\t\tuntraceable = append(untraceable, spec.Slug)\n   471\t\t\t}\n   472\t\t\tif len(untraceable) > 0 {\n   473\t\t\t\tsort.Strings(untraceable)\n   474\t\t\t\tadd(\"review.scope-change-set\", \"warn\",\n   475\t\t\t\t\tfmt.Sprintf(text(\"%d spec(s) with delivers: have no change set recorded in .pose/reports/history or Git POSE-Spec trailers: %s\",\n   476\t\t\t\t\t\t\"%d spec(s) com delivers: não têm nenhum change set registrado em .pose/reports/history ou trailers Git POSE-Spec: %s\"),\n   477\t\t\t\t\t\tlen(untraceable), strings.Join(untraceable, \", \")),\n   478\t\t\t\t\ttext(\"commit changes with a 'POSE-Spec: <slug>' trailer or run 'pose report --spec <slug> --change-from <rev> --change-to <rev>' to record the delivering range before sealing (github.com/oseiaspereira88/pose issue #17)\",\n   479\t\t\t\t\t\t\"comite as mudanças com o trailer 'POSE-Spec: <slug>' ou rode 'pose report --spec <slug> --change-from <rev> --change-to <rev>' para registrar o range antes de selar (issue #17)\"))\n   480\t\t\t} else {\n   481\t\t\t\tadd(\"review.scope-change-set\", \"ok\", text(\"every in-progress/done spec with delivers: has an attributed change set\", \"toda spec em andamento/concluída com delivers: tem change set atribuído\"), \"\")\n   482\t\t\t}\n   483\t\t}\n   484\t\n   485\t\t// 10. Retired machinery still on disk (spec\n   486\t\t// pose-domain-rule-extension-migration, ADR\n   487\t\t// retired-machinery-files-stay-on-disk-never-auto-migrated-by-pose-update):\n   488\t\t// deliverMachinery only ever walks the *current* engine source's\n   489\t\t// machineryRoots, so a file the engine used to ship but no longer does\n   490\t\t// (moved out to become an extension) is simply never revisited — it\n   491\t\t// stays on disk untouched and un-updated. That is the deliberate,\n   492\t\t// non-breaking compatibility strategy; this check is the discoverability\n   493\t\t// half of it, since nothing else would ever tell an instance the file it\n   494\t\t// still has is no longer receiving updates.\n   495\t\tif delivered := loadMachineryManifest(root); len(delivered) > 0 {\n   496\t\t\tcurrent := map[string]bool{}\n   497\t\t\tfor _, mroot := range machineryRoots {\n   498\t\t\t\t_ = fs.WalkDir(scaffold.Dist(), mroot, func(path string, d fs.DirEntry, err error) error {\n   499\t\t\t\t\tif err != nil || d.IsDir() {\n   500\t\t\t\t\t\treturn nil\n   501\t\t\t\t\t}\n   502\t\t\t\t\tcurrent[path] = true\n   503\t\t\t\t\treturn nil\n   504\t\t\t\t})\n   505\t\t\t}\n   506\t\t\tvar retired []string\n   507\t\t\tfor path := range delivered {\n   508\t\t\t\tif current[path] {\n   509\t\t\t\t\tcontinue\n   510\t\t\t\t}\n   511\t\t\t\tif _, statErr := os.Stat(filepath.Join(root, filepath.FromSlash(path))); statErr != nil {\n   512\t\t\t\t\tcontinue // instance already removed it — nothing to flag\n   513\t\t\t\t}\n   514\t\t\t\tretired = append(retired, path)\n   515\t\t\t}\n   516\t\t\tsort.Strings(retired)\n   517\t\t\tif len(retired) > 0 {\n   518\t\t\t\thints := make([]string, 0, len(retired))\n   519\t\t\t\tfor _, path := range retired {\n   520\t\t\t\t\tif rest, ok := strings.CutPrefix(path, \".pose/rules/\"); ok {\n   521\t\t\t\t\t\tif slug, ok := strings.CutSuffix(rest, \".md\"); ok {\n   522\t\t\t\t\t\t\thints = append(hints, fmt.Sprintf(\"%s -> pose extension install pose-rule-%s\", path, slug))\n   523\t\t\t\t\t\t\tcontinue\n   524\t\t\t\t\t\t}\n   525\t\t\t\t\t}\n   526\t\t\t\t\thints = append(hints, path)\n   527\t\t\t\t}\n   528\t\t\t\tadd(\"machinery.retired-on-disk\", \"warn\",\n   529\t\t\t\t\tfmt.Sprintf(text(\"%d machinery file(s) present but no longer delivered by this engine version: %s\",\n   530\t\t\t\t\t\t\"%d arquivo(s) de machinery presente(s) mas não mais entregue(s) por esta versão do engine: %s\"),\n   531\t\t\t\t\t\tlen(retired), strings.Join(retired, \", \")),\n   532\t\t\t\t\ttext(\"content is untouched and still valid, it just no longer receives engine updates; install the matching extension to resume updates: \"+strings.Join(hints, \"; \"),\n   533\t\t\t\t\t\t\"o conteúdo está intacto e continua válido, só não recebe mais atualizações do engine; instale a extensão correspondente para retomar: \"+strings.Join(hints, \"; \")))\n   534\t\t\t} else {\n   535\t\t\t\tadd(\"machinery.retired-on-disk\", \"ok\", text(\"no retired machinery content found\", \"nenhum conteúdo de machinery aposentado encontrado\"), \"\")\n   536\t\t\t}\n   537\t\t}\n   538\t\n   539\t\t// 11. Stack-matched rule extension not installed (spec\n   540\t\t// pose-adaptive-rule-delivery): module-metadata.json already knows\n   541\t\t// each module's stack, which may resolve to a matching rule extension\n   542\t\t// (resolveRuleExtension) that is not installed. Advisory only — no\n   543\t\t// fetch/catalog mechanism exists to install it automatically\n   544\t\t// (Decision 1), so this only ever recommends by name.\n   545\t\tif raw, err := os.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"module-metadata.json\")); err == nil {\n   546\t\t\tvar doc struct {\n   547\t\t\t\tModules map[string]map[string]string `json:\"modules\"`\n   548\t\t\t}\n   549\t\t\tif json.Unmarshal(raw, &doc) == nil {\n   550\t\t\t\tvar recommend []string\n   551\t\t\t\tpaths := make([]string, 0, len(doc.Modules))\n   552\t\t\t\tfor p := range doc.Modules {\n   553\t\t\t\t\tpaths = append(paths, p)\n   554\t\t\t\t}\n   555\t\t\t\tsort.Strings(paths)\n   556\t\t\t\tfor _, modPath := range paths {\n   557\t\t\t\t\tstack := doc.Modules[modPath][\"domain\"]\n   558\t\t\t\t\tif stack == \"\" {\n   559\t\t\t\t\t\tcontinue\n   560\t\t\t\t\t}\n   561\t\t\t\t\textID, ok := resolveRuleExtension(root, modPath, stack)\n   562\t\t\t\t\tif !ok {\n   563\t\t\t\t\t\tcontinue\n   564\t\t\t\t\t}\n   565\t\t\t\t\truleFile, ok := ruleExtensionFile[extID]\n   566\t\t\t\t\tif !ok || ruleExtensionInstalled(root, ruleFile) {\n   567\t\t\t\t\t\tcontinue\n   568\t\t\t\t\t}\n   569\t\t\t\t\trecommend = append(recommend, fmt.Sprintf(\"%s (%s) -> pose extension install %s\", modPath, stack, extID))\n   570\t\t\t\t}\n   571\t\t\t\tif len(recommend) > 0 {\n   572\t\t\t\t\t// A rule pack the project can add is a recommended step, not\n   573\t\t\t\t\t// a fault (spec pose-quickstart-real-lifecycle).\n   574\t\t\t\t\tadd(\"rules.stack-extension-available\", \"next\",\n   575\t\t\t\t\t\tfmt.Sprintf(text(\"%d module(s) match a rule extension not yet installed: %s\",\n   576\t\t\t\t\t\t\t\"%d módulo(s) combinam com uma extensão de rule ainda não instalada: %s\"),\n   577\t\t\t\t\t\t\tlen(recommend), strings.Join(recommend, \"; \")),\n   578\t\t\t\t\t\ttext(\"'pose extension install <id>' resolves it from the release catalog ('<path>' installs a local package) — see AGENTS.md's Domain rules section\",\n   579\t\t\t\t\t\t\t\"'pose extension install <id>' resolve pelo catálogo da release ('<path>' instala um pacote local) — veja a seção Domain rules do AGENTS.md\"))\n   580\t\t\t\t} else {\n   581\t\t\t\t\tadd(\"rules.stack-extension-available\", \"ok\", text(\"no unmatched rule extensions for detected modules\", \"nenhuma extensão de rule pendente para os módulos detectados\"), \"\")\n   582\t\t\t\t}\n   583\t\n   584\t\t\t\t// 11a. Orphaned module-metadata entries (specs\n   585\t\t\t\t// pose-upgrade-path-audit-fixes,\n   586\t\t\t\t// pose-stack-detection-consolidation): discovery is additive-only\n   587\t\t\t\t// and never removes an entry, so a path that stopped existing —\n   588\t\t\t\t// a stale self-referential entry from an old scaffold version, a\n   589\t\t\t\t// typo/case mismatch, a module that was deleted — stays forever,\n   590\t\t\t\t// silently. Root (\"\") is exempt: it is a valid module-metadata\n   591\t\t\t\t// key that legitimately has no directory of its own to stat.\n   592\t\t\t\tvar orphans []string\n   593\t\t\t\tmodPaths := make([]string, 0, len(doc.Modules))\n   594\t\t\t\tfor p := range doc.Modules {\n   595\t\t\t\t\tmodPaths = append(modPaths, p)\n   596\t\t\t\t}\n   597\t\t\t\tsort.Strings(modPaths)\n   598\t\t\t\tfor _, modPath := range modPaths {\n   599\t\t\t\t\tif modPath == \"\" || modPath == \".\" {\n   600\t\t\t\t\t\tcontinue\n   601\t\t\t\t\t}\n   602\t\t\t\t\tif !confinedRelativePath(modPath) {\n   603\t\t\t\t\t\tcontinue\n   604\t\t\t\t\t}\n   605\t\t\t\t\tif _, err := os.Stat(filepath.Join(root, filepath.FromSlash(modPath))); err != nil {\n   606\t\t\t\t\t\torphans = append(orphans, modPath)\n   607\t\t\t\t\t}\n   608\t\t\t\t}\n   609\t\t\t\tif len(orphans) > 0 {\n   610\t\t\t\t\tadd(\"module-metadata.orphan-entries\", \"warn\",\n   611\t\t\t\t\t\tfmt.Sprintf(text(\"%d module-metadata.json entr(y/ies) do not resolve to a directory in this project: %s\",\n   612\t\t\t\t\t\t\t\"%d entrada(s) de module-metadata.json não resolvem a um diretório neste projeto: %s\"),\n   613\t\t\t\t\t\t\tlen(orphans), strings.Join(orphans, \", \")),\n   614\t\t\t\t\t\ttext(\"check .pose/indexes/module-metadata.json — the module may have been deleted, renamed, or (github.com/oseiaspereira88/pose issue #21-adjacent) inherited from an old scaffold that leaked its own modules; remove the entry or fix the path\",\n   615\t\t\t\t\t\t\t\"confira .pose/indexes/module-metadata.json — o módulo pode ter sido apagado, renomeado, ou (adjacente à issue #21) herdado de um scaffold antigo que vazou seus próprios módulos; remova a entrada ou corrija o caminho\"))\n   616\t\t\t\t} else {\n   617\t\t\t\t\tadd(\"module-metadata.orphan-entries\", \"ok\", text(\"every module-metadata.json entry resolves to a real directory\", \"toda entrada de module-metadata.json resolve a um diretório real\"), \"\")\n   618\t\t\t\t}\n   619\t\t\t}\n   620\t\t}\n   621\t\n   622\t\t// 12. Redundant root-plus-child monorepo execution (spec\n   623\t\t// pose-monorepo-validation-advisory): a root module whose configured\n   624\t\t// checks delegate to workspace members (npm's --workspaces, Cargo's\n   625\t\t// --workspace) alongside child modules POSE also validates directly\n   626\t\t// runs those children's tests twice. The fix already exists —\n   627\t\t// moduleOverrides.<path>.replaceDefaultChecks — this is purely\n   628\t\t// discoverability, never an automatic skip (spec Decision 1).\n   629\t\tif raw, err := os.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\")); err == nil {\n   630\t\t\tif matrix, err := parseValidationMatrix(raw); err == nil {\n   631\t\t\t\tif modules, err := discoverValidationModules(root); err == nil {\n   632\t\t\t\t\trootStack := \"\"\n   633\t\t\t\t\tvar children []string\n   634\t\t\t\t\tfor _, m := range modules {\n   635\t\t\t\t\t\tif m.Rel == \".\" {\n   636\t\t\t\t\t\t\trootStack = m.Stack\n   637\t\t\t\t\t\t} else {\n   638\t\t\t\t\t\t\tchildren = append(children, m.Rel)\n   639\t\t\t\t\t\t}\n   640\t\t\t\t\t}\n   641\t\t\t\t\tdelegates := false\n   642\t\t\t\t\t// The delegation flag (npm's --workspaces) typically lives\n   643\t\t\t\t\t// inside the root package.json's own \"scripts\" values, not\n   644\t\t\t\t\t// in POSE's generic per-stack check args — `npm test\n   645\t\t\t\t\t// --if-present` (POSE's own invocation) reads\n   646\t\t\t\t\t// scripts.test, and THAT string is what actually contains\n   647\t\t\t\t\t// \"--workspaces\". Checking POSE's own check definitions\n   648\t\t\t\t\t// alone (as an earlier version of this check did) never\n   649\t\t\t\t\t// finds it, since those are stack-generic and never\n   650\t\t\t\t\t// contain the flag themselves.\n   651\t\t\t\t\tif rootStack == \"node\" {\n   652\t\t\t\t\t\tif raw, err := os.ReadFile(filepath.Join(root, \"package.json\")); err == nil {\n   653\t\t\t\t\t\t\tvar pkg struct {\n   654\t\t\t\t\t\t\t\tScripts map[string]string `json:\"scripts\"`\n   655\t\t\t\t\t\t\t}\n   656\t\t\t\t\t\t\tif json.Unmarshal(raw, &pkg) == nil {\n   657\t\t\t\t\t\t\t\tfor _, script := range pkg.Scripts {\n   658\t\t\t\t\t\t\t\t\tif strings.Contains(script, \"--workspace\") {\n   659\t\t\t\t\t\t\t\t\t\tdelegates = true\n   660\t\t\t\t\t\t\t\t\t}\n   661\t\t\t\t\t\t\t\t}\n   662\t\t\t\t\t\t\t}\n   663\t\t\t\t\t\t}\n   664\t\t\t\t\t}\n   665\t\t\t\t\t// Cargo has no scripts indirection layer: a workspace\n   666\t\t\t\t\t// delegation would appear directly in POSE's own\n   667\t\t\t\t\t// configured check args for the root (moduleOverrides[\".\"]\n   668\t\t\t\t\t// or the generic \"rust\" stack, if customized to invoke\n   669\t\t\t\t\t// `cargo test --workspace`).\n   670\t\t\t\t\trootChecks := matrix.Stacks[rootStack].Checks\n   671\t\t\t\t\tif override, ok := matrix.ModuleOverrides[\".\"]; ok {\n   672\t\t\t\t\t\trootChecks = override.Checks\n   673\t\t\t\t\t}\n   674\t\t\t\t\tfor _, c := range rootChecks {\n   675\t\t\t\t\t\tfor _, a := range c.Args {\n   676\t\t\t\t\t\t\tif strings.Contains(a, \"--workspace\") {\n   677\t\t\t\t\t\t\t\tdelegates = true\n   678\t\t\t\t\t\t\t}\n   679\t\t\t\t\t\t}\n   680\t\t\t\t\t}\n   681\t\t\t\t\tvar flagged []string\n   682\t\t\t\t\tif delegates {\n   683\t\t\t\t\t\tfor _, childRel := range children {\n   684\t\t\t\t\t\t\tif o, ok := matrix.ModuleOverrides[childRel]; ok && o.ReplaceDefaultChecks {\n   685\t\t\t\t\t\t\t\tcontinue // already resolved\n   686\t\t\t\t\t\t\t}\n   687\t\t\t\t\t\t\tflagged = append(flagged, childRel)\n   688\t\t\t\t\t\t}\n   689\t\t\t\t\t\tsort.Strings(flagged)\n   690\t\t\t\t\t}\n   691\t\t\t\t\tif len(flagged) > 0 {\n   692\t\t\t\t\t\texamples := make([]string, 0, len(flagged))\n   693\t\t\t\t\t\tfor _, rel := range flagged {\n   694\t\t\t\t\t\t\texamples = append(examples, fmt.Sprintf(`\"%s\": {\"replaceDefaultChecks\": true, \"checks\": []}`, rel))\n   695\t\t\t\t\t\t}\n   696\t\t\t\t\t\tadd(\"validate.redundant-workspace-execution\", \"warn\",\n   697\t\t\t\t\t\t\tfmt.Sprintf(text(\"root module's checks delegate to workspace members (--workspace flag) while %d child module(s) are also validated directly, likely running the same tests twice: %s\",\n   698\t\t\t\t\t\t\t\t\"os checks do módulo raiz delegam para os membros do workspace (flag --workspace) enquanto %d módulo(s) filho(s) também são validados diretamente, provavelmente rodando os mesmos testes duas vezes: %s\"),\n   699\t\t\t\t\t\t\t\tlen(flagged), strings.Join(flagged, \", \")),\n   700\t\t\t\t\t\t\ttext(\"add to .pose/indexes/validation-matrix.json's moduleOverrides to stop the direct run and keep only the root's delegated one: \"+strings.Join(examples, \", \"),\n   701\t\t\t\t\t\t\t\t\"adicione em moduleOverrides de .pose/indexes/validation-matrix.json para parar a execução direta e manter só a delegada pelo root: \"+strings.Join(examples, \", \")))\n   702\t\t\t\t\t} else {\n   703\t\t\t\t\t\tadd(\"validate.redundant-workspace-execution\", \"ok\", text(\"no redundant root-plus-child execution detected\", \"nenhuma execução redundante raiz+filho detectada\"), \"\")\n   704\t\t\t\t\t}\n   705\t\t\t\t}\n   706\t\t\t}\n   707\t\t}\n   708\t\n   709\t\t// 12. Invisible governance failures (spec\n   710\t\t// pose-diagnose-invisible-governance-failures). Both of the below are cases\n   711\t\t// where POSE silently reduces what it knows and reports a downstream symptom\n   712\t\t// instead of the upstream loss, so the operator ends up reading the engine's\n   713\t\t// source to find a cause POSE already had.\n   714\t\n   715\t\t// 12a. A review profile may name an evidence class that `pose validate`\n   716\t\t// refuses to register on a check. Nothing cross-validates the two\n   717\t\t// vocabularies, so the divergence only shows up as a bundle resolving\n   718\t\t// evidence=0, with no indication that the class was unsatisfiable by\n   719\t\t// construction.\n   720\t\t//\n   721\t\t// Only the profiles policy actually selects. A profile sitting on disk that\n   722\t\t// no scope resolves to and no overlay list names builds no plan, so\n   723\t\t// reporting it is noise an operator has to investigate to dismiss — the case\n   724\t\t// that appears the moment a project owns its profiles and leaves the shipped\n   725\t\t// ones in place.\n   726\t\tif policy, policyErr := (posemodel.Store{Root: root}).GetReviewPolicy(); policyErr == nil {\n   727\t\t\tselected := map[string]bool{}\n   728\t\t\tfor _, ref := range policy.Profiles {\n   729\t\t\t\tselected[strings.SplitN(ref, \"@\", 2)[0]] = true\n   730\t\t\t}\n   731\t\t\tfor _, ref := range policy.OverlayProfiles {\n   732\t\t\t\tselected[strings.SplitN(ref, \"@\", 2)[0]] = true\n   733\t\t\t}\n   734\t\t\tunreachable := map[string][]string{}\n   735\t\t\tfor id := range selected {\n   736\t\t\t\tif id == \"\" {\n   737\t\t\t\t\tcontinue\n   738\t\t\t\t}\n   739\t\t\t\tentryName := id + \".json\"\n   740\t\t\t\traw, readErr := os.ReadFile(filepath.Join(root, \".pose\", \"review-profiles\", entryName))\n   741\t\t\t\tif readErr != nil {\n   742\t\t\t\t\tcontinue\n   743\t\t\t\t}\n   744\t\t\t\tentry := struct{ name string }{entryName}\n   745\t\t\t\tvar profile struct {\n   746\t\t\t\t\tCriteria []struct {\n   747\t\t\t\t\t\tEvidenceClasses []string `json:\"evidence_classes\"`\n   748\t\t\t\t\t} `json:\"criteria\"`\n   749\t\t\t\t\tTools []struct {\n   750\t\t\t\t\t\tEvidenceClasses []string `json:\"evidence_classes\"`\n   751\t\t\t\t\t} `json:\"tools\"`\n   752\t\t\t\t}\n   753\t\t\t\tif json.Unmarshal(raw, &profile) != nil {\n   754\t\t\t\t\tcontinue\n   755\t\t\t\t}\n   756\t\t\t\tseen := map[string]bool{}\n   757\t\t\t\tfor _, criterion := range profile.Criteria {\n   758\t\t\t\t\tfor _, class := range criterion.EvidenceClasses {\n   759\t\t\t\t\t\tif !posemodel.ValidEvidenceClasses[class] && !seen[class] {\n   760\t\t\t\t\t\t\tseen[class] = true\n   761\t\t\t\t\t\t\tunreachable[entry.name] = append(unreachable[entry.name], class)\n   762\t\t\t\t\t\t}\n   763\t\t\t\t\t}\n   764\t\t\t\t}\n   765\t\t\t\tfor _, tool := range profile.Tools {\n   766\t\t\t\t\tfor _, class := range tool.EvidenceClasses {\n   767\t\t\t\t\t\tif !posemodel.ValidEvidenceClasses[class] && !seen[class] {\n   768\t\t\t\t\t\t\tseen[class] = true\n   769\t\t\t\t\t\t\tunreachable[entry.name] = append(unreachable[entry.name], class)\n   770\t\t\t\t\t\t}\n   771\t\t\t\t\t}\n   772\t\t\t\t}\n   773\t\t\t}\n   774\t\t\tif len(unreachable) > 0 {\n   775\t\t\t\tnames := make([]string, 0, len(unreachable))\n   776\t\t\t\tfor file, classes := range unreachable {\n   777\t\t\t\t\tsort.Strings(classes)\n   778\t\t\t\t\tnames = append(names, fmt.Sprintf(\"%s (%s)\", file, strings.Join(classes, \", \")))\n   779\t\t\t\t}\n   780\t\t\t\tsort.Strings(names)\n   781\t\t\t\tadd(\"review.evidence-vocabulary\", \"warn\",\n   782\t\t\t\t\tfmt.Sprintf(text(\"%d selected review profile(s) demand evidence classes no registered check may emit: %s\",\n   783\t\t\t\t\t\t\"%d review profile(s) selecionado(s) exigem classes de evidência que nenhum check registrado pode emitir: %s\"),\n   784\t\t\t\t\t\tlen(unreachable), strings.Join(names, \"; \")),\n   785\t\t\t\t\ttext(\"pose validate only accepts the classes in the delivery contract's vocabulary; a criterion demanding another one can never be satisfied by a real check, leaving auto-attest as the only path that completes — reconcile the profile or register a check that emits the class\",\n   786\t\t\t\t\t\t\"o pose validate só aceita as classes do vocabulário do contrato de entrega; um critério que exige outra jamais é satisfeito por check real, e sobra o auto-attest como único caminho que completa — reconcilie o profile ou registre um check que emita a classe\"))\n   787\t\t\t} else {\n   788\t\t\t\tadd(\"review.evidence-vocabulary\", \"ok\", text(\"every evidence class the selected review profiles demand can be emitted by a check\", \"toda classe de evidência exigida pelos review profiles selecionados pode ser emitida por um check\"), \"\")\n   789\t\t\t}\n   790\t\n   791\t\t\t// 12f. The vocabulary check above asks whether a class *could* be\n   792\t\t\t// emitted by some check somewhere. This asks whether one actually is,\n   793\t\t\t// here. The two came apart when `go vet` moved from `build` to `lint`:\n   794\t\t\t// `build` stayed a perfectly valid class, the profiles kept demanding\n   795\t\t\t// it, and no registered check produced it any more — a gate depending\n   796\t\t\t// on evidence this repository does not generate, with nothing saying so\n   797\t\t\t// (spec pose-report-a-demanded-class-nothing-produces).\n   798\t\t\t// A criterion's `evidence_classes` is a disjunction: the attestation cites\n   799\t\t\t// one of them, and the first match satisfies it. So the unit that can be\n   800\t\t\t// unsatisfiable is the criterion, not the class — reporting classes one\n   801\t\t\t// by one said `e2e` was unproduced while every criterion listing it also\n   802\t\t\t// accepted `integration` or `unit`, both of which are produced. A true\n   803\t\t\t// statement that names nothing to fix, which is how a check earns being\n   804\t\t\t// ignored (spec pose-class-producers-reads-the-disjunction).\n   805\t\t\ttype classDemand struct {\n   806\t\t\t\twhere   string\n   807\t\t\t\tclasses []string\n   808\t\t\t}\n   809\t\t\t// A profile selected by a language this repository does not have can never\n   810\t\t\t// be selected for any component, so its criteria are not ones anyone here\n   811\t\t\t// will be held to. Reporting them is the second kind of false alarm this\n   812\t\t\t// check had: `frontend-review` demands `a11y`, and there is no JavaScript\n   813\t\t\t// or TypeScript module for it to apply to.\n   814\t\t\t//\n   815\t\t\t// Only the language selector is evaluated. The others need the\n   816\t\t\t// component-aware planner, and a partial evaluation can only make this\n   817\t\t\t// quieter, never wrongly loud: a profile is skipped solely when it names\n   818\t\t\t// languages and none of them is present.\n   819\t\t\tdomains := map[string]bool{}\n   820\t\t\tif raw, metaErr := os.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"module-metadata.json\")); metaErr == nil {\n   821\t\t\t\tvar metadata struct {\n   822\t\t\t\t\tModules map[string]struct {\n   823\t\t\t\t\t\tDomain string `json:\"domain\"`\n   824\t\t\t\t\t} `json:\"modules\"`\n   825\t\t\t\t}\n   826\t\t\t\tif json.Unmarshal(raw, &metadata) == nil {\n   827\t\t\t\t\tfor _, module := range metadata.Modules {\n   828\t\t\t\t\t\tif module.Domain != \"\" {\n   829\t\t\t\t\t\t\tdomains[module.Domain] = true\n   830\t\t\t\t\t\t}\n   831\t\t\t\t\t}\n   832\t\t\t\t}\n   833\t\t\t}\n   834\t\t\t// Milestone and roadmap profiles judge roadmap work; a project with no\n   835\t\t\t// roadmap is held to none of their criteria, so a fresh install is not\n   836\t\t\t// told it lacks integration evidence (spec\n   837\t\t\t// pose-fresh-install-doctor-is-clean).\n   838\t\t\troadmaps, _ := filepath.Glob(filepath.Join(root, \".pose\", \"roadmaps\", \"*.md\"))\n   839\t\t\tdemands := []classDemand{}\n   840\t\t\tfor id := range selected {\n   841\t\t\t\tif id == \"\" {\n   842\t\t\t\t\tcontinue\n   843\t\t\t\t}\n   844\t\t\t\traw, readErr := os.ReadFile(filepath.Join(root, \".pose\", \"review-profiles\", id+\".json\"))\n   845\t\t\t\tif readErr != nil {\n   846\t\t\t\t\tcontinue\n   847\t\t\t\t}\n   848\t\t\t\tvar profile struct {\n   849\t\t\t\t\tScope     string `json:\"scope\"`\n   850\t\t\t\t\tSelectors struct {\n   851\t\t\t\t\t\tLanguages []string `json:\"languages\"`\n   852\t\t\t\t\t} `json:\"selectors\"`\n   853\t\t\t\t\tCriteria []struct {\n   854\t\t\t\t\t\tID              string   `json:\"id\"`\n   855\t\t\t\t\t\tEvidenceClasses []string `json:\"evidence_classes\"`\n   856\t\t\t\t\t} `json:\"criteria\"`\n   857\t\t\t\t\tTools []struct {\n   858\t\t\t\t\t\tID              string   `json:\"id\"`\n   859\t\t\t\t\t\tEvidenceClasses []string `json:\"evidence_classes\"`\n   860\t\t\t\t\t} `json:\"tools\"`\n   861\t\t\t\t}\n   862\t\t\t\tif json.Unmarshal(raw, &profile) != nil {\n   863\t\t\t\t\tcontinue\n   864\t\t\t\t}\n   865\t\t\t\tif (profile.Scope == \"milestone\" || profile.Scope == \"roadmap\") && len(roadmaps) == 0 {\n   866\t\t\t\t\tcontinue\n   867\t\t\t\t}\n   868\t\t\t\tif len(profile.Selectors.Languages) > 0 && len(domains) > 0 {\n   869\t\t\t\t\tapplies := false\n   870\t\t\t\t\tfor _, language := range profile.Selectors.Languages {\n   871\t\t\t\t\t\tif domains[language] {\n   872\t\t\t\t\t\t\tapplies = true\n   873\t\t\t\t\t\t\tbreak\n   874\t\t\t\t\t\t}\n   875\t\t\t\t\t}\n   876\t\t\t\t\tif !applies {\n   877\t\t\t\t\t\tcontinue\n   878\t\t\t\t\t}\n   879\t\t\t\t}\n   880\t\t\t\tfor _, criterion := range profile.Criteria {\n   881\t\t\t\t\tif len(criterion.EvidenceClasses) > 0 {\n   882\t\t\t\t\t\tdemands = append(demands, classDemand{id + \"/\" + criterion.ID, criterion.EvidenceClasses})\n   883\t\t\t\t\t}\n   884\t\t\t\t}\n   885\t\t\t\tfor _, tool := range profile.Tools {\n   886\t\t\t\t\tif len(tool.EvidenceClasses) > 0 {\n   887\t\t\t\t\t\tdemands = append(demands, classDemand{id + \"/tool:\" + tool.ID, tool.EvidenceClasses})\n   888\t\t\t\t\t}\n   889\t\t\t\t}\n   890\t\t\t}\n   891\t\t\tif len(demands) > 0 {\n   892\t\t\t\tproduced := map[string]bool{}\n   893\t\t\t\tif raw, matrixErr := os.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\")); matrixErr == nil {\n   894\t\t\t\t\tif matrix, parseErr := parseValidationMatrix(raw); parseErr == nil {\n   895\t\t\t\t\t\tfor _, stack := range matrix.Stacks {\n   896\t\t\t\t\t\t\tfor _, check := range stack.Checks {\n   897\t\t\t\t\t\t\t\tif class := strings.TrimSpace(check.EvidenceClass); class != \"\" {\n   898\t\t\t\t\t\t\t\t\tproduced[class] = true\n   899\t\t\t\t\t\t\t\t}\n   900\t\t\t\t\t\t\t}\n   901\t\t\t\t\t\t}\n   902\t\t\t\t\t\tfor _, override := range matrix.ModuleOverrides {\n   903\t\t\t\t\t\t\tfor _, check := range override.Checks {\n   904\t\t\t\t\t\t\t\tif class := strings.TrimSpace(check.EvidenceClass); class != \"\" {\n   905\t\t\t\t\t\t\t\t\tproduced[class] = true\n   906\t\t\t\t\t\t\t\t}\n   907\t\t\t\t\t\t\t}\n   908\t\t\t\t\t\t}\n   909\t\t\t\t\t}\n   910\t\t\t\t}\n   911\t\t\t\tunsatisfiable := []string{}\n   912\t\t\t\tfor _, demand := range demands {\n   913\t\t\t\t\tsatisfiable := false\n   914\t\t\t\t\tfor _, class := range demand.classes {\n   915\t\t\t\t\t\tif produced[class] {\n   916\t\t\t\t\t\t\tsatisfiable = true\n   917\t\t\t\t\t\t\tbreak\n   918\t\t\t\t\t\t}\n   919\t\t\t\t\t}\n   920\t\t\t\t\tif !satisfiable {\n   921\t\t\t\t\t\tunsatisfiable = append(unsatisfiable, demand.where+\" (\"+strings.Join(demand.classes, \"|\")+\")\")\n   922\t\t\t\t\t}\n   923\t\t\t\t}\n   924\t\t\t\tsort.Strings(unsatisfiable)\n   925\t\t\t\tif len(unsatisfiable) > 0 {\n   926\t\t\t\t\tadd(\"validate.class-producers\", \"warn\",\n   927\t\t\t\t\t\tfmt.Sprintf(text(\"%d review criterion/criteria demand evidence no registered check produces: %s\",\n   928\t\t\t\t\t\t\t\"%d critério(s) de review exigem evidência que nenhum check registrado produz: %s\"),\n   929\t\t\t\t\t\t\tlen(unsatisfiable), strings.Join(unsatisfiable, \", \")),\n   930\t\t\t\t\t\ttext(\"none of the classes a criterion accepts is emitted here, so it can only be satisfied by evidence this repository does not generate — register a check that emits one of them in .pose/indexes/validation-matrix.json, or reconcile the profile\",\n   931\t\t\t\t\t\t\t\"nenhuma das classes que o critério aceita é emitida aqui, então ele só é satisfeito por evidência que este repositório não gera — registre em .pose/indexes/validation-matrix.json um check que emita uma delas, ou reconcilie o profile\"))\n   932\t\t\t\t} else {\n   933\t\t\t\t\tadd(\"validate.class-producers\", \"ok\",\n   934\t\t\t\t\t\ttext(\"every review criterion the selected profiles declare accepts a class some registered check produces\", \"todo critério de review declarado pelos profiles selecionados aceita uma classe que algum check registrado produz\"), \"\")\n   935\t\t\t\t}\n   936\t\t\t}\n   937\t\t}\n   938\t\n   939\t\t// 12c. `.pose/policy/` is not machinery, so an update delivers a stricter\n   940\t\t// engine and never a statement of when the instance received it. Without a\n   941\t\t// date, rules introduced after a closeout was recorded judge it anyway, and\n   942\t\t// an operator sees a wall of failures about work nobody touched. The\n   943\t\t// contracts come from the registry, so a future one is reported here\n   944\t\t// without this block learning about it.\n   945\t\tif raw, err := os.ReadFile(filepath.Join(root, \".pose\", \"policy\", \"review.json\")); err == nil {\n   946\t\t\tvar policy posemodel.ReviewPolicy\n   947\t\t\tif json.Unmarshal(raw, &policy) == nil {\n   948\t\t\t\tvar declarations map[string]json.RawMessage\n   949\t\t\t\t_ = json.Unmarshal(raw, &declarations)\n   950\t\t\t\tfor _, contract := range posemodel.ReviewContracts() {\n   951\t\t\t\t\tadopted, recorded := policy.ContractAdoptions[contract.ID]\n   952\t\t\t\t\tvar legacy string\n   953\t\t\t\t\tif value, present := declarations[contract.LegacyField]; recorded && present && json.Unmarshal(value, &legacy) == nil && adopted != legacy {\n   954\t\t\t\t\t\tadd(\"review.adoption-conflict\", \"warn\",\n   955\t\t\t\t\t\t\tfmt.Sprintf(text(\"contract %s records conflicting adoption dates: map=%q, %s=%q\", \"contrato %s registra datas de adoção conflitantes: mapa=%q, %s=%q\"), contract.ID, adopted, contract.LegacyField, legacy),\n   956\t\t\t\t\t\t\ttext(\"contract_adoptions takes precedence; reconcile the legacy date without changing the intended adoption boundary\", \"contract_adoptions tem precedência; reconcilie a data legada sem alterar o limite de adoção pretendido\"))\n   957\t\t\t\t\t}\n   958\t\t\t\t}\n   959\t\t\t\t// Where each contract's date comes from (spec\n   960\t\t\t\t// pose-legacy-contract-cutoffs). Absent, explicitly empty, map and\n   961\t\t\t\t// legacy are different statements, and the typed policy cannot\n   962\t\t\t\t// tell them apart, so the raw document is classified here.\n   963\t\t\t\tsources := []string{}\n   964\t\t\t\tfor _, contract := range posemodel.ReviewContracts() {\n   965\t\t\t\t\tsource, err := posemodel.ContractAdoptionSourceOf(raw, contract.ID)\n   966\t\t\t\t\tif err != nil {\n   967\t\t\t\t\t\tcontinue\n   968\t\t\t\t\t}\n   969\t\t\t\t\tentry := contract.ID + \"=\" + source.Source\n   970\t\t\t\t\tif source.Date != \"\" {\n   971\t\t\t\t\t\tentry += \"(\" + source.Date + \")\"\n   972\t\t\t\t\t}\n   973\t\t\t\t\tif source.LegacyShadowed {\n   974\t\t\t\t\t\tentry += text(\"[legacy \"+source.LegacyField+\" shadowed by contract_adoptions]\", \"[legado \"+source.LegacyField+\" sombreado por contract_adoptions]\")\n   975\t\t\t\t\t}\n   976\t\t\t\t\tsources = append(sources, entry)\n   977\t\t\t\t}\n   978\t\t\t\tadd(\"review.adoption-source\", \"ok\",\n   979\t\t\t\t\tfmt.Sprintf(text(\"contract adoption sources: %s\", \"origem das adoções de contrato: %s\"), strings.Join(sources, \", \")), \"\")\n   980\t\t\t\t// Agency readiness makes an unanswered request block what it\n   981\t\t\t\t// restricts; a new instance adopts it with an empty role map, so a\n   982\t\t\t\t// request addressed to a role has nobody to answer it until the\n   983\t\t\t\t// project names one (spec\n   984\t\t\t\t// pose-governed-capabilities-default-on-new-instances).\n   985\t\t\t\tif policy.AgencyReadinessVersion == posemodel.AgencyReadinessPolicyVersion {\n   986\t\t\t\t\tif actions, actionsErr := posemodel.LoadActionPolicy(root); actionsErr == nil {\n   987\t\t\t\t\t\theld := 0\n   988\t\t\t\t\t\tfor _, principals := range actions.Roles {\n   989\t\t\t\t\t\t\theld += len(principals)\n   990\t\t\t\t\t\t}\n   991\t\t\t\t\t\tif held == 0 {\n   992\t\t\t\t\t\t\t// The default adoption leaves the roles empty on\n   993\t\t\t\t\t\t\t// purpose: naming them is the next step, not a fault.\n   994\t\t\t\t\t\t\tadd(\"actions.roles\", \"next\",\n   995\t\t\t\t\t\t\t\ttext(\"agency readiness is adopted and no principal holds a role in .pose/policy/actions.json: a request addressed to a role cannot be answered\",\n   996\t\t\t\t\t\t\t\t\t\"agency readiness está adotada e nenhum principal tem papel em .pose/policy/actions.json: um request endereçado a um papel não pode ser respondido\"),\n   997\t\t\t\t\t\t\t\ttext(\"register yourself: pose identity add --key ~/.ssh/<key>.pub --role maintainer --apply (or list principals in .pose/policy/actions.json); a request addressed to a principal is unaffected\",\n   998\t\t\t\t\t\t\t\t\t\"registre-se: pose identity add --key ~/.ssh/<chave>.pub --role maintainer --apply (ou liste principals em .pose/policy/actions.json); um request endereçado a um principal não é afetado\"))\n   999\t\t\t\t\t\t} else {\n  1000\t\t\t\t\t\t\tadd(\"actions.roles\", \"ok\", fmt.Sprintf(text(\"%d principal(s) hold action-request roles\", \"%d principal(is) com papéis de action request\"), held), \"\")\n  1001\t\t\t\t\t\t}\n  1002\t\t\t\t\t}\n  1003\t\t\t\t}\n  1004\t\t\t\t// A delegation profile whose dependencies are not installed would start and\n  1005\t\t\t\t// fail, or run without the guarantee it names: say so before it is used (spec\n  1006\t\t\t\t// pose-claude-sandboxed-profile).\n  1007\t\t\t\tif policy, _, found, policyErr := (posemodel.Store{Root: root}).LoadDelegationPolicy(); policyErr == nil && found {\n  1008\t\t\t\t\tfor _, name := range policy.DeclaredAgentNames() {\n  1009\t\t\t\t\t\tagent := policy.Agents[name]\n  1010\t\t\t\t\t\tfor access, missing := range agent.MissingRequirements() {\n  1011\t\t\t\t\t\t\tadd(\"delegation.requirements\", \"warn\",\n  1012\t\t\t\t\t\t\t\tfmt.Sprintf(text(\"agent %s: its %s profile needs %s, which is not installed\", \"agente %s: o perfil %s precisa de %s, que não está instalado\"), name, access, strings.Join(missing, \", \")),\n  1013\t\t\t\t\t\t\t\tstrings.TrimPrefix(installHint(agent, access), \"; \")+text(\" — until then that profile refuses to start\", \" — até lá esse perfil recusa iniciar\"))\n  1014\t\t\t\t\t\t}\n  1015\t\t\t\t\t}\n  1016\t\t\t\t}\n  1017\t\t\t\t// Capabilities this project has not decided for the engine it runs\n  1018\t\t\t\t// are a next step, not a fault (spec pose-setup-command).\n  1019\t\t\t\tif pending, pendingErr := posemodel.CapabilitiesToReview(root, version.ReleaseBase()); pendingErr == nil && len(pending) > 0 {\n  1020\t\t\t\t\tids := make([]string, 0, len(pending))\n  1021\t\t\t\t\tfor _, state := range pending {\n  1022\t\t\t\t\t\tids = append(ids, state.ID)\n  1023\t\t\t\t\t}\n  1024\t\t\t\t\tadd(\"setup.capabilities\", \"next\",\n  1025\t\t\t\t\t\tfmt.Sprintf(text(\"%d capability decision(s) pending since the last configuration review: %s\", \"%d decisão(ões) de capacidade pendente(s) desde a última revisão de configuração: %s\"), len(pending), strings.Join(ids, \", \")),\n  1026\t\t\t\t\t\ttext(\"run `pose setup`: it shows what each changes and asks, one confirmed decision at a time\", \"rode `pose setup`: mostra o que cada uma muda e pergunta, uma decisão confirmada por vez\"))\n  1027\t\t\t\t}\n  1028\t\t\t\t// A human role under verified assurance needs a way to prove an\n  1029\t\t\t\t// answer: a registered key (one that proves presence, for a\n  1030\t\t\t\t// person) or a trusted issuer authorised for humans (spec\n  1031\t\t\t\t// pose-signed-action-answers).\n  1032\t\t\t\tif actions, actionsErr := posemodel.LoadActionPolicy(root); actionsErr != nil {\n  1033\t\t\t\t\tadd(\"actions.keys\", \"error\", \"invalid .pose/policy/actions.json: \"+actionsErr.Error(), text(\"fix the policy; `pose identity list` reads it the same way\", \"corrija a policy; `pose identity list` a lê do mesmo jeito\"))\n  1034\t\t\t\t} else {\n  1035\t\t\t\t\tpresence := actions.PresencePolicy()\n  1036\t\t\t\t\tif presence.MigrationRequired {\n  1037\t\t\t\t\t\tadd(\"actions.presence\", \"error\", text(\"presence scope is legacy-sshsig-only; new human answers require migration\", \"o escopo de presença é legacy-sshsig-only; novas respostas humanas exigem migração\"), text(\"explicitly set actions.json schema_version: 2 and presence_scope: universal or sshsig; no scope is selected automatically\", \"configure explicitamente schema_version: 2 e presence_scope: universal ou sshsig em actions.json; nenhum escopo é escolhido automaticamente\"))\n  1038\t\t\t\t\t} else if actions.RequirePresence {\n  1039\t\t\t\t\t\tadd(\"actions.presence\", \"ok\", text(\"configured human presence scope: \", \"escopo configurado de presença humana: \")+presence.Scope, text(\"issuer claims establish identity/authority, not presence; universal requires a registered SK user-present assertion\", \"claims de issuer estabelecem identidade/autoridade, não presença; universal exige asserção SK user-present registrada\"))\n  1040\t\t\t\t\t}\n  1041\t\t\t\t\tif actions.IdentityAssurance == posemodel.ReviewIdentityAssuranceVerified || actions.RequirePresence && actions.PresenceScope == posemodel.ActionPresenceUniversal {\n  1042\t\t\t\t\t\tunproven, untouched := []string{}, []string{}\n  1043\t\t\t\t\t\tfor _, principal := range actions.Principals() {\n  1044\t\t\t\t\t\t\tif !strings.HasPrefix(principal, \"human:\") || strings.HasSuffix(principal, \"*\") || len(actions.RolesOf(principal)) == 0 {\n  1045\t\t\t\t\t\t\t\tcontinue\n  1046\t\t\t\t\t\t\t}\n  1047\t\t\t\t\t\t\tkeys := actions.KeysFor(principal)\n  1048\t\t\t\t\t\t\tif len(keys) == 0 {\n  1049\t\t\t\t\t\t\t\tif actions.RequirePresence && (actions.PresenceScope == posemodel.ActionPresenceUniversal || presence.MigrationRequired) {\n  1050\t\t\t\t\t\t\t\t\tuntouched = append(untouched, principal)\n  1051\t\t\t\t\t\t\t\t} else if len(policy.HumanAuthorityIssuers) == 0 {\n  1052\t\t\t\t\t\t\t\t\tunproven = append(unproven, principal)\n  1053\t\t\t\t\t\t\t\t}\n  1054\t\t\t\t\t\t\t\tcontinue\n  1055\t\t\t\t\t\t\t}\n  1056\t\t\t\t\t\t\tpresent := false\n  1057\t\t\t\t\t\t\tfor _, key := range keys {\n  1058\t\t\t\t\t\t\t\tpresent = present || key.ProvesPresence()\n  1059\t\t\t\t\t\t\t}\n  1060\t\t\t\t\t\t\tif !present {\n  1061\t\t\t\t\t\t\t\tuntouched = append(untouched, principal)\n  1062\t\t\t\t\t\t\t}\n  1063\t\t\t\t\t\t}\n  1064\t\t\t\t\t\tswitch {\n  1065\t\t\t\t\t\tcase len(unproven) > 0:\n  1066\t\t\t\t\t\t\tadd(\"actions.keys\", \"warn\",\n  1067\t\t\t\t\t\t\t\tfmt.Sprintf(text(\"identity assurance is verified and %s can prove no answer: no registered key and no issuer authorised for humans\",\n  1068\t\t\t\t\t\t\t\t\t\"a garantia de identidade é verified e %s não consegue provar resposta: nenhuma chave registrada e nenhum emissor autorizado para humanos\"), strings.Join(unproven, \", \")),\n  1069\t\t\t\t\t\t\t\ttext(\"register a key: pose identity add <principal> --key <file.pub> --apply (a security key, ssh-keygen -t ed25519-sk, also proves presence)\",\n  1070\t\t\t\t\t\t\t\t\t\"registre uma chave: pose identity add <principal> --key <arquivo.pub> --apply (uma chave de segurança, ssh-keygen -t ed25519-sk, também prova presença)\"))\n  1071\t\t\t\t\t\tcase len(untouched) > 0 && actions.RequirePresence && (actions.PresenceScope == posemodel.ActionPresenceUniversal || presence.MigrationRequired || len(policy.HumanAuthorityIssuers) == 0):\n  1072\t\t\t\t\t\t\tadd(\"actions.keys\", \"error\",\n  1073\t\t\t\t\t\t\t\tfmt.Sprintf(text(\"require_presence is set and %s lacks a registered key capable of the required presence assertion (or still needs legacy migration)\",\n  1074\t\t\t\t\t\t\t\t\t\"require_presence está ativo e %s não tem chave registrada capaz da asserção de presença exigida (ou ainda precisa migrar a policy legada)\"), strings.Join(untouched, \", \")),\n  1075\t\t\t\t\t\t\t\ttext(\"register a security key (ssh-keygen -t ed25519-sk) with pose identity add\", \"registre uma chave de segurança (ssh-keygen -t ed25519-sk) com pose identity add\"))\n  1076\t\t\t\t\t\tcase len(untouched) > 0:\n  1077\t\t\t\t\t\t\tadd(\"actions.keys\", \"warn\",\n  1078\t\t\t\t\t\t\t\tfmt.Sprintf(text(\"%s signs with keys that cannot prove presence: whoever holds the key file can answer as them\",\n  1079\t\t\t\t\t\t\t\t\t\"%s assina com chaves que não provam presença: quem tiver o arquivo da chave responde por eles\"), strings.Join(untouched, \", \")),\n  1080\t\t\t\t\t\t\t\ttext(\"prefer a security key (ssh-keygen -t ed25519-sk); set require_presence in .pose/policy/actions.json to demand it\",\n  1081\t\t\t\t\t\t\t\t\t\"prefira uma chave de segurança (ssh-keygen -t ed25519-sk); ative require_presence em .pose/policy/actions.json para exigi-la\"))\n  1082\t\t\t\t\t\tdefault:\n  1083\t\t\t\t\t\t\tadd(\"actions.keys\", \"ok\", text(\"enumerated human role holders have a configured identity/presence path\", \"os humanos enumerados com papel têm um caminho configurado de identidade/presença\"), \"\")\n  1084\t\t\t\t\t\t}\n  1085\t\t\t\t\t}\n  1086\t\t\t\t}\n  1087\t\t\t\t// Legacy attempts live in `.pose/reviews/*.md` — the directory\n  1088\t\t\t\t// Store.ListReviewAttempts reads. An earlier version of this check\n  1089\t\t\t\t// globbed `.pose/review-attempts/`, which nothing writes, so the\n  1090\t\t\t\t// pre-bundle instance it exists to diagnose always counted zero and\n  1091\t\t\t\t// got an ok. Its test seeded an attestation, which does exist, and\n  1092\t\t\t\t// passed over the dead path.\n  1093\t\t\t\tattestations, _ := filepath.Glob(filepath.Join(root, \".pose\", \"review-attestations\", \"*.json\"))\n  1094\t\t\t\tattempts, _ := filepath.Glob(filepath.Join(root, \".pose\", \"reviews\", \"*.md\"))\n  1095\t\t\t\thistory := len(attestations) + len(attempts)\n  1096\t\t\t\tunrecorded := []string{}\n  1097\t\t\t\tsummaries := map[string]string{}\n  1098\t\t\t\tfor _, contract := range posemodel.ReviewContracts() {\n  1099\t\t\t\t\tsummaries[contract.ID] = contract.Summary\n  1100\t\t\t\t\tif !policy.ContractAdoptionRecorded(contract.ID) {\n  1101\t\t\t\t\t\tunrecorded = append(unrecorded, contract.ID)\n  1102\t\t\t\t\t}\n  1103\t\t\t\t}\n  1104\t\t\t\tsort.Strings(unrecorded)\n  1105\t\t\t\tswitch {\n  1106\t\t\t\tcase len(unrecorded) == 0:\n  1107\t\t\t\t\tadd(\"review.contract-adoption\", \"ok\",\n  1108\t\t\t\t\t\ttext(\"every governance contract records the date this instance received it\",\n  1109\t\t\t\t\t\t\t\"todo contrato de governança registra a data em que esta instância o recebeu\"), \"\")\n  1110\t\t\t\tcase history == 0:\n  1111\t\t\t\t\tadd(\"review.contract-adoption\", \"ok\",\n  1112\t\t\t\t\t\ttext(\"no recorded review predates a governance contract\", \"nenhuma review registrada precede um contrato de governança\"), \"\")\n  1113\t\t\t\tdefault:\n  1114\t\t\t\t\tdetails := make([]string, 0, len(unrecorded))\n  1115\t\t\t\t\tfor _, id := range unrecorded {\n  1116\t\t\t\t\t\tdetails = append(details, fmt.Sprintf(\"%s (%s)\", id, summaries[id]))\n  1117\t\t\t\t\t}\n  1118\t\t\t\t\tadd(\"review.contract-adoption\", \"warn\",\n  1119\t\t\t\t\t\tfmt.Sprintf(text(\"%d recorded review(s) may predate %d governance contract(s) this instance records no adoption date for: %s\",\n  1120\t\t\t\t\t\t\t\"%d review(s) registrada(s) pode(m) preceder %d contrato(s) de governança sem data de adoção nesta instância: %s\"),\n  1121\t\t\t\t\t\t\thistory, len(unrecorded), strings.Join(details, \"; \")),\n  1122\t\t\t\t\t\ttext(\"a review recorded before a contract existed fails it without having become less considered — `pose update` stamps today's date into contract_adoptions, or set it by hand to the day this instance received the contract; an explicitly empty value means judge my whole history by the current contract\",\n  1123\t\t\t\t\t\t\t\"uma review registrada antes de um contrato existir reprova sem ter se tornado menos criteriosa — o `pose update` carimba a data de hoje em contract_adoptions, ou defina à mão o dia em que esta instância recebeu o contrato; um valor explicitamente vazio significa julgue todo o meu histórico pelo contrato atual\"))\n  1124\t\t\t\t}\n  1125\t\t\t}\n  1126\t\t}\n  1127\t\n  1128\t\t// 12e. A review profile left at schema v1 is exempt from the closed rule and\n  1129\t\t// evidence catalogs v2 enforces — the check that stops a profile demanding a\n  1130\t\t// class no check may emit. Two profiles shipped at v1 for long enough that\n  1131\t\t// every instance installed in that window still carries them, and the\n  1132\t\t// migration that should have moved them reported success without doing so\n  1133\t\t// (spec pose-doctor-reports-a-profile-left-behind).\n  1134\t\tif entries, err := os.ReadDir(filepath.Join(root, \".pose\", \"review-profiles\")); err == nil {\n  1135\t\t\tbehind := []string{}\n  1136\t\t\texamined := 0\n  1137\t\t\tfor _, entry := range entries {\n  1138\t\t\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".json\") {\n  1139\t\t\t\t\tcontinue\n  1140\t\t\t\t}\n  1141\t\t\t\traw, readErr := os.ReadFile(filepath.Join(root, \".pose\", \"review-profiles\", entry.Name()))\n  1142\t\t\t\tif readErr != nil {\n  1143\t\t\t\t\tcontinue\n  1144\t\t\t\t}\n  1145\t\t\t\tvar profile struct {\n  1146\t\t\t\t\tSchemaVersion int `json:\"schema_version\"`\n  1147\t\t\t\t}\n  1148\t\t\t\tif json.Unmarshal(raw, &profile) != nil {\n  1149\t\t\t\t\tcontinue\n  1150\t\t\t\t}\n  1151\t\t\t\texamined++\n  1152\t\t\t\tif profile.SchemaVersion < posemodel.ReviewPolicySchemaVersion {\n  1153\t\t\t\t\tdetail := fmt.Sprintf(\"%s (v%d)\", entry.Name(), profile.SchemaVersion)\n  1154\t\t\t\t\tif issue := (posemodel.Store{Root: root}).ReviewProfileMigrationIssue(raw); issue != \"\" {\n  1155\t\t\t\t\t\tdetail += \": \" + issue\n  1156\t\t\t\t\t}\n  1157\t\t\t\t\tbehind = append(behind, detail)\n  1158\t\t\t\t}\n  1159\t\t\t}\n  1160\t\t\tsort.Strings(behind)\n  1161\t\t\tif len(behind) > 0 {\n  1162\t\t\t\tadd(\"review.profile-schema\", \"warn\",\n  1163\t\t\t\t\tfmt.Sprintf(text(\"%d review profile(s) are below schema v%d: %s\",\n  1164\t\t\t\t\t\t\"%d review profile(s) abaixo do schema v%d: %s\"), len(behind), posemodel.ReviewPolicySchemaVersion, strings.Join(behind, \", \")),\n  1165\t\t\t\t\ttext(\"a schema-v1 profile is exempt from the closed rule and evidence catalogs, so it can demand a class no check may emit — run `pose update` to migrate it\",\n  1166\t\t\t\t\t\t\"um profile schema-v1 fica isento dos catálogos fechados de rules e classes, então pode exigir uma classe que nenhum check emite — rode `pose update` para migrá-lo\"))\n  1167\t\t\t} else if examined > 0 {\n  1168\t\t\t\tadd(\"review.profile-schema\", \"ok\",\n  1169\t\t\t\t\tfmt.Sprintf(text(\"every review profile is at schema v%d\", \"todo review profile está no schema v%d\"), posemodel.ReviewPolicySchemaVersion), \"\")\n  1170\t\t\t}\n  1171\t\t}\n  1172\t\n  1173\t\tif paths, err := filepath.Glob(filepath.Join(root, \".pose/review-bundles/*.json\")); err == nil {\n  1174\t\t\tmissingContracts, missingGates, examined := 0, 0, 0\n  1175\t\t\tfor _, path := range paths {\n  1176\t\t\t\traw, err := os.ReadFile(path)\n  1177\t\t\t\tif err != nil {\n  1178\t\t\t\t\tcontinue\n  1179\t\t\t\t}\n  1180\t\t\t\tvar bundle posemodel.ReviewBundle\n  1181\t\t\t\tif json.Unmarshal(raw, &bundle) != nil || bundle.State != \"sealed\" {\n  1182\t\t\t\t\tcontinue\n  1183\t\t\t\t}\n  1184\t\t\t\texamined++\n  1185\t\t\t\tif len(bundle.Payload.GoverningContracts) == 0 {\n  1186\t\t\t\t\tmissingContracts++\n  1187\t\t\t\t}\n  1188\t\t\t\tif bundle.Payload.Gates == nil {\n  1189\t\t\t\t\tmissingGates++\n  1190\t\t\t\t}\n  1191\t\t\t}\n  1192\t\t\tif missingContracts > 0 || missingGates > 0 {\n  1193\t\t\t\tadd(\"review.legacy-bundles\", \"warn\",\n  1194\t\t\t\t\tfmt.Sprintf(text(\"%d sealed bundle(s): %d without governing contracts, %d without sealed gates\", \"%d bundle(s) selado(s): %d sem contratos governantes, %d sem gates selados\"), examined, missingContracts, missingGates),\n  1195\t\t\t\t\ttext(\"these bundles use compatibility fallbacks; retain those fallbacks until historical acceptance has been audited\", \"esses bundles usam fallbacks de compatibilidade; preserve-os até auditar o aceite histórico\"))\n  1196\t\t\t}\n  1197\t\t}\n  1198\t\n  1199\t\t// 12d. Every policy decoder ignores keys it does not know, so a newer field\n  1200\t\t// never breaks an older binary reading the same repository. What that gives\n  1201\t\t// up is telling an operator that a key they wrote is not one the engine\n  1202\t\t// reads: a misspelling takes the default and the setting silently does\n  1203\t\t// nothing. Reported here, where it costs a finding instead of a refusal.\n  1204\t\t//\n  1205\t\t// The review policy was the first to get this, because that is where the\n  1206\t\t// strict decoder had to be dropped. The exposure is identical in every\n  1207\t\t// other policy the engine models, and identical is the point: an operator\n  1208\t\t// who learns the finding exists for one file has no way to know it does not\n  1209\t\t// exist for the next.\n  1210\t\tfor _, policy := range policyKeyChecks() {\n  1211\t\t\tvar raw []byte\n  1212\t\t\tvar err error\n  1213\t\t\tfor _, candidate := range policy.paths() {\n  1214\t\t\t\tif raw, err = os.ReadFile(filepath.Join(root, \".pose\", \"policy\", candidate)); err == nil {\n  1215\t\t\t\t\tbreak\n  1216\t\t\t\t}\n  1217\t\t\t}\n  1218\t\t\tif err != nil {\n  1219\t\t\t\tcontinue\n  1220\t\t\t}\n  1221\t\t\tvar document map[string]json.RawMessage\n  1222\t\t\tif json.Unmarshal(raw, &document) != nil {\n  1223\t\t\t\tcontinue\n  1224\t\t\t}\n  1225\t\t\tknown := map[string]bool{}\n  1226\t\t\tfor _, key := range policy.known {\n  1227\t\t\t\tknown[key] = true\n  1228\t\t\t}\n  1229\t\t\tunknown := []string{}\n  1230\t\t\tfor key := range document {\n  1231\t\t\t\tif !known[key] && !posemodel.PolicyKeyIsAnnotation(key) {\n  1232\t\t\t\t\tunknown = append(unknown, key)\n  1233\t\t\t\t}\n  1234\t\t\t}\n  1235\t\t\tsort.Strings(unknown)\n  1236\t\t\tif len(unknown) > 0 {\n  1237\t\t\t\tadd(policy.check, \"warn\",\n  1238\t\t\t\t\tfmt.Sprintf(text(\"the %s policy carries %d key(s) this engine does not read: %s\",\n  1239\t\t\t\t\t\t\"a política de %s carrega %d chave(s) que este engine não lê: %s\"), policy.label, len(unknown), strings.Join(unknown, \", \")),\n  1240\t\t\t\t\tfmt.Sprintf(text(\"a key the engine does not model is ignored, so its setting has no effect — check the spelling, or remove it; the keys read are: %s\",\n  1241\t\t\t\t\t\t\"uma chave que o engine não modela é ignorada, então o ajuste não tem efeito — confira a grafia, ou remova; as chaves lidas são: %s\"),\n  1242\t\t\t\t\t\tstrings.Join(policy.known, \", \")))\n  1243\t\t\t} else {\n  1244\t\t\t\tadd(policy.check, \"ok\",\n  1245\t\t\t\t\tfmt.Sprintf(text(\"every key in the %s policy is one this engine reads\", \"toda chave da política de %s é lida por este engine\"), policy.label), \"\")\n  1246\t\t\t}\n  1247\t\t}\n  1248\t\n  1249\t\t// 12b. A check with no evidenceClass still runs and still passes, but its\n  1250\t\t// result carries no class, so review evidence collection discards it. The\n  1251\t\t// module looks covered and contributes nothing.\n  1252\t\tif raw, err := os.ReadFile(filepath.Join(root, \".pose\", \"indexes\", \"validation-matrix.json\")); err == nil {\n  1253\t\t\tif matrix, parseErr := parseValidationMatrix(raw); parseErr == nil {\n  1254\t\t\t\t// A shipped stack counts only when some module here uses it, and\n  1255\t\t\t\t// only for its required checks: a stack nothing selects never runs,\n  1256\t\t\t\t// and an optional probe the distribution ships (wrangler --version)\n  1257\t\t\t\t// gates nothing, so neither is a gap in this project's evidence.\n  1258\t\t\t\t// The project's own overrides are all its declarations and are all\n  1259\t\t\t\t// read (spec pose-fresh-install-doctor-is-clean).\n  1260\t\t\t\trequired := func(check validationCheck) bool {\n  1261\t\t\t\t\treturn check.Severity == \"\" || check.Severity == \"required\"\n  1262\t\t\t\t}\n  1263\t\t\t\tinUse := map[string]bool{}\n  1264\t\t\t\tif modules, discoverErr := discoverValidationModules(root); discoverErr == nil {\n  1265\t\t\t\t\tfor _, module := range modules {\n  1266\t\t\t\t\t\tinUse[module.Stack] = true\n  1267\t\t\t\t\t}\n  1268\t\t\t\t}\n  1269\t\t\t\tfor _, override := range matrix.ModuleOverrides {\n  1270\t\t\t\t\tif override.Stack != \"\" {\n  1271\t\t\t\t\t\tinUse[override.Stack] = true\n  1272\t\t\t\t\t}\n  1273\t\t\t\t}\n  1274\t\t\t\tunclassed := []string{}\n  1275\t\t\t\tfor name, override := range matrix.ModuleOverrides {\n  1276\t\t\t\t\tfor _, check := range override.Checks {\n  1277\t\t\t\t\t\tif strings.TrimSpace(check.EvidenceClass) == \"\" {\n  1278\t\t\t\t\t\t\tunclassed = append(unclassed, name+\"/\"+check.Name)\n  1279\t\t\t\t\t\t}\n  1280\t\t\t\t\t}\n  1281\t\t\t\t}\n  1282\t\t\t\tfor name, stack := range matrix.Stacks {\n  1283\t\t\t\t\tif !inUse[name] {\n  1284\t\t\t\t\t\tcontinue\n  1285\t\t\t\t\t}\n  1286\t\t\t\t\tfor _, check := range stack.Checks {\n  1287\t\t\t\t\t\tif required(check) && strings.TrimSpace(check.EvidenceClass) == \"\" {\n  1288\t\t\t\t\t\t\tunclassed = append(unclassed, \"stack:\"+name+\"/\"+check.Name)\n  1289\t\t\t\t\t\t}\n  1290\t\t\t\t\t}\n  1291\t\t\t\t}\n  1292\t\t\t\tsort.Strings(unclassed)\n  1293\t\t\t\tif len(unclassed) > 0 {\n  1294\t\t\t\t\tadd(\"validate.evidence-class-coverage\", \"warn\",\n  1295\t\t\t\t\t\tfmt.Sprintf(text(\"%d registered check(s) declare no evidenceClass, so their results are discarded when a review collects evidence: %s\",\n  1296\t\t\t\t\t\t\t\"%d check(s) registrado(s) não declaram evidenceClass, então os resultados deles são descartados quando uma review coleta evidência: %s\"),\n  1297\t\t\t\t\t\t\tlen(unclassed), strings.Join(unclassed, \", \")),\n  1298\t\t\t\t\t\ttext(\"declare the class each check actually produces in .pose/indexes/validation-matrix.json — a passing check with no class leaves the module looking covered while contributing nothing to a review\",\n  1299\t\t\t\t\t\t\t\"declare em .pose/indexes/validation-matrix.json a classe que cada check de fato produz — um check verde sem classe deixa o módulo parecendo coberto sem contribuir nada para uma review\"))\n  1300\t\t\t\t} else {\n  1301\t\t\t\t\tadd(\"validate.evidence-class-coverage\", \"ok\", text(\"every required check of the stacks in use declares an evidence class\", \"todo check obrigatório das stacks em uso declara uma classe de evidência\"), \"\")\n  1302\t\t\t\t}\n  1303\t\t\t}\n  1304\t\t}\n  1305\t\n  1306\t\treturn root, findings\n  1307\t}\n  1308\t\n  1309\t// diagnoseProjectState shares the state command's parser and resolver. Findings\n  1310\t// are detectable only: diagnosis never refreshes or repairs governed artifacts.\n  1311\tfunc diagnoseProjectState(root string, add func(string, string, string, string), text func(string, string) string) {\n  1312\t\tstore := posemodel.Store{Root: root}\n  1313\t\tif _, err := os.Stat(store.StatePath()); os.IsNotExist(err) {\n  1314\t\t\tadd(\"state.artifact\", \"ok\", text(\"optional project state is not initialized\", \"estado opcional do projeto não inicializado\"), text(\"run `pose state init` when needed\", \"rode `pose state init` quando necessário\"))\n  1315\t\t\treturn\n  1316\t\t} else if err != nil {\n  1317\t\t\tadd(\"state.artifact\", \"error\", fmt.Sprintf(text(\"cannot inspect project state: %v\", \"não foi possível inspecionar o estado: %v\"), err), text(\"check state path permissions; run `pose state`\", \"confira permissões do estado; rode `pose state`\"))\n  1318\t\t\treturn\n  1319\t\t}\n  1320\t\tstate, err := store.ProjectState(context.Background(), \"\")\n  1321\t\tif err != nil {\n  1322\t\t\tadd(\"state.artifact\", \"error\", fmt.Sprintf(text(\"cannot read project state: %v\", \"não foi possível ler o estado: %v\"), err), text(\"run `pose state`; repair the source before refreshing\", \"rode `pose state`; corrija a origem antes de atualizar\"))\n  1323\t\t\treturn\n  1324\t\t}\n  1325\t\tadd(\"state.artifact\", \"ok\", text(\"project state is readable\", \"estado do projeto legível\"), \"\")\n  1326\t\tbroken := store.ValidatePointers(state)\n  1327\t\tif len(broken) > 0 {\n  1328\t\t\tdetails := broken\n  1329\t\t\tif len(details) > 10 {\n  1330\t\t\t\tdetails = details[:10]\n  1331\t\t\t}\n  1332\t\t\tadd(\"state.pointers\", \"error\", fmt.Sprintf(text(\"%d broken project-state pointer(s): %s\", \"%d ponteiro(s) inválido(s) no estado: %s\"), len(broken), strings.Join(details, \"; \")), text(\"run `pose state`; correct source references, then `pose state refresh`\", \"rode `pose state`; corrija as referências de origem e rode `pose state refresh`\"))\n  1333\t\t} else {\n  1334\t\t\tadd(\"state.pointers\", \"ok\", text(\"project-state pointers resolve\", \"ponteiros do estado resolvem\"), \"\")\n  1335\t\t}\n  1336\t\tif state.Tampered {\n  1337\t\t\tadd(\"state.integrity\", \"error\", text(\"derived project-state sections were modified\", \"seções derivadas do estado foram modificadas\"), text(\"run `pose state`; inspect edits before `pose state refresh`\", \"rode `pose state`; inspecione as edições antes de `pose state refresh`\"))\n  1338\t\t} else {\n  1339\t\t\tadd(\"state.integrity\", \"ok\", text(\"derived project-state sections match their recorded hashes\", \"seções derivadas do estado correspondem aos hashes registrados\"), \"\")\n  1340\t\t}\n  1341\t\tif _, unfinished, _ := refreshPendingMeaning(state.RefreshPending); unfinished {\n  1342\t\t\tadd(\"state.freshness\", \"warn\", text(\"project state is published; its last refresh left an effect to finish\", \"estado publicado; a última atualização deixou um efeito por concluir\"), text(\"run 'pose state refresh'\", \"execute 'pose state refresh'\"))\n  1343\t\t} else if state.Staleness.Stale || state.RefreshPending != \"\" {\n  1344\t\t\tadd(\"state.freshness\", \"warn\", text(\"project state is stale or has a pending refresh\", \"estado desatualizado ou com atualização pendente\"), text(\"run `pose state` for details, then `pose state refresh`\", \"rode `pose state` para detalhes, depois `pose state refresh`\"))\n  1345\t\t} else {\n  1346\t\t\tadd(\"state.freshness\", \"ok\", text(\"project state is current under its staleness policy\", \"estado atual conforme sua política de atualização\"), \"\")\n  1347\t\t}\n  1348\t}\n  1349\t\n  1350\tfunc engineSchemaVersion(root string) int {\n  1351\t\treturn nativeSchemaVersion\n  1352\t}\n  1353\t\n  1354\t// countNext counts the recommended steps that are not problems: they are\n  1355\t// listed and counted apart, and never change the exit code.\n  1356\tfunc countNext(findings []doctorFinding) (next int) {\n  1357\t\tfor _, f := range findings {\n  1358\t\t\tif f.Level == \"next\" {\n  1359\t\t\t\tnext++\n  1360\t\t\t}\n  1361\t\t}\n  1362\t\treturn\n  1363\t}\n  1364\t\n  1365\tfunc countLevels(findings []doctorFinding) (errors, warns int) {\n  1366\t\tfor _, f := range findings {\n  1367\t\t\tswitch f.Level {\n  1368\t\t\tcase \"error\":\n  1369\t\t\t\terrors++\n  1370\t\t\tcase \"warn\":\n  1371\t\t\t\twarns++\n  1372\t\t\t}\n  1373\t\t}\n  1374\t\treturn\n  1375\t}\n  1376\t\n  1377\tfunc renderFindingsText(findings []doctorFinding, stdout io.Writer, locale cliLocale) {\n  1378\t\tfor _, f := range findings {\n  1379\t\t\ticon := map[string]string{\"ok\": \"✓\", \"next\": \"→\", \"warn\": \"!\", \"error\": \"✗\"}[f.Level]\n  1380\t\t\tsuffix := \"\"\n  1381\t\t\tif f.RemediationClass == remediationFixable {\n  1382\t\t\t\tsuffix = cliText(locale, \" (fixable: pose doctor --fix)\", \" (corrigível: pose doctor --fix)\")\n  1383\t\t\t}\n  1384\t\t\tfmt.Fprintf(stdout, \"[%s] %-18s %s%s\\n\", icon, f.Check, f.Message, suffix)\n  1385\t\t\tif f.Hint != \"\" {\n  1386\t\t\t\tfmt.Fprintf(stdout, \"      ↳ %s\\n\", f.Hint)\n  1387\t\t\t}\n  1388\t\t}\n  1389\t}\n  1390\t\n  1391\tfunc printSummaryLine(findings []doctorFinding, stdout io.Writer, locale cliLocale) {\n  1392\t\terrors, warns := countLevels(findings)\n  1393\t\tfmt.Fprintf(stdout, cliText(locale, \"\\ndoctor: %d error(s), %d warning(s), %d next step(s)\\n\", \"\\ndoctor: %d erro(s), %d aviso(s), %d próximo(s) passo(s)\\n\"), errors, warns, countNext(findings))\n  1394\t}\n  1395\t\n  1396\tfunc doctorReport(root string, findings []doctorFinding, jsonOut bool, stdout io.Writer, locale cliLocale) int {\n  1397\t\terrors, warns := countLevels(findings)\n  1398\t\tif jsonOut {\n  1399\t\t\tenc := json.NewEncoder(stdout)\n  1400\t\t\tenc.SetIndent(\"\", \"  \")\n  1401\t\t\t_ = enc.Encode(map[string]any{\n  1402\t\t\t\t\"doctor_schema_version\": doctorSchemaVersion,\n  1403\t\t\t\t\"findings\":              findings,\n  1404\t\t\t\t\"errors\":                errors,\n  1405\t\t\t\t\"warnings\":              warns,\n  1406\t\t\t\t\"next_steps\":            countNext(findings),\n  1407\t\t\t})\n  1408\t\t} else {\n  1409\t\t\trenderFindingsText(findings, stdout, locale)\n  1410\t\t\tprintSummaryLine(findings, stdout, locale)\n  1411\t\t\tPrintContributorDoctorHint(root, stdout, locale)\n  1412\t\t}\n  1413\t\tif errors > 0 {\n  1414\t\t\treturn 1\n  1415\t\t}\n  1416\t\treturn 0\n  1417\t}\n  1418\t\n  1419\ttype doctorFixCandidate struct {\n  1420\t\tCheck    string `json:\"check\"`\n  1421\t\tDescribe string `json:\"describe\"`\n  1422\t}\n  1423\t\n  1424\t// doctorFixPreview is the default `pose doctor --fix` behavior: report the\n  1425\t// diagnostics, then list what each fixable finding *would* do — no\n  1426\t// mutation (constraint: default to advice or dry-run).\n  1427\tfunc doctorFixPreview(findings []doctorFinding, candidates []string, jsonOut bool, stdout io.Writer, locale cliLocale) int {\n  1428\t\terrors, warns := countLevels(findings)\n  1429\t\tplanned := make([]doctorFixCandidate, 0, len(candidates))\n  1430\t\tfor _, c := range candidates {\n  1431\t\t\tplanned = append(planned, doctorFixCandidate{c, doctorFixRegistry[c].describe})\n  1432\t\t}\n  1433\t\tif jsonOut {\n  1434\t\t\tenc := json.NewEncoder(stdout)\n  1435\t\t\tenc.SetIndent(\"\", \"  \")\n  1436\t\t\t_ = enc.Encode(map[string]any{\n  1437\t\t\t\t\"doctor_schema_version\": doctorSchemaVersion,\n  1438\t\t\t\t\"findings\":              findings,\n  1439\t\t\t\t\"errors\":                errors,\n  1440\t\t\t\t\"warnings\":              warns,\n  1441\t\t\t\t\"next_steps\":            countNext(findings),\n  1442\t\t\t\t\"fix\": map[string]any{\n  1443\t\t\t\t\t\"mode\":       \"dry-run\",\n  1444\t\t\t\t\t\"candidates\": planned,\n  1445\t\t\t\t},\n  1446\t\t\t})\n  1447\t\t} else {\n  1448\t\t\trenderFindingsText(findings, stdout, locale)\n  1449\t\t\tprintSummaryLine(findings, stdout, locale)\n  1450\t\t\tif len(candidates) == 0 {\n  1451\t\t\t\tfmt.Fprintln(stdout, cliText(locale, \"\\nfix: nothing fixable right now.\", \"\\nfix: nada corrigível no momento.\"))\n  1452\t\t\t} else {\n  1453\t\t\t\tfmt.Fprintln(stdout, cliText(locale, \"\\n[DRY-RUN] would apply:\", \"\\n[DRY-RUN] aplicaria:\"))\n  1454\t\t\t\tfor _, c := range planned {\n  1455\t\t\t\t\tfmt.Fprintf(stdout, \"  - %s: %s\\n\", c.Check, c.Describe)\n  1456\t\t\t\t}\n  1457\t\t\t\tfmt.Fprintln(stdout, cliText(locale, \"Result: DRY-RUN — no changes applied. Re-run with --fix --yes to apply.\", \"Resultado: DRY-RUN — nenhuma mudança aplicada. Rode com --fix --yes para aplicar.\"))\n  1458\t\t\t}\n  1459\t\t}\n  1460\t\tif errors > 0 {\n  1461\t\t\treturn 1\n  1462\t\t}\n  1463\t\treturn 0\n  1464\t}\n  1465\t\n  1466\ttype doctorFixResult struct {\n  1467\t\tCheck  string `json:\"check\"`\n  1468\t\tStatus string `json:\"status\"` // applied | error\n  1469\t\tDetail string `json:\"detail,omitempty\"`\n  1470\t}\n  1471\t\n  1472\t// doctorFixApply applies every candidate fix, then reruns diagnostics\n  1473\t// (recheck, R3) and reports whether each targeted check now reads ok —\n  1474\t// applying it twice in a row is a no-op by construction, since every\n  1475\t// registered fix is idempotent.\n  1476\tfunc doctorFixApply(root string, before []doctorFinding, candidates []string, jsonOut bool, stdout, stderr io.Writer, locale cliLocale) int {\n  1477\t\tif len(candidates) == 0 {\n  1478\t\t\terrors, warns := countLevels(before)\n  1479\t\t\tif jsonOut {\n  1480\t\t\t\tenc := json.NewEncoder(stdout)\n  1481\t\t\t\tenc.SetIndent(\"\", \"  \")\n  1482\t\t\t\t_ = enc.Encode(map[string]any{\n  1483\t\t\t\t\t\"doctor_schema_version\": doctorSchemaVersion,\n  1484\t\t\t\t\t\"findings\":              before,\n  1485\t\t\t\t\t\"errors\":                errors,\n  1486\t\t\t\t\t\"warnings\":              warns,\n  1487\t\t\t\t\t\"next_steps\":            countNext(before),\n  1488\t\t\t\t\t\"fix\":                   map[string]any{\"mode\": \"apply\", \"results\": []doctorFixResult{}},\n  1489\t\t\t\t})\n  1490\t\t\t} else {\n  1491\t\t\t\trenderFindingsText(before, stdout, locale)\n  1492\t\t\t\tprintSummaryLine(before, stdout, locale)\n  1493\t\t\t\tfmt.Fprintln(stdout, cliText(locale, \"\\nfix: nothing fixable right now.\", \"\\nfix: nada corrigível no momento.\"))\n  1494\t\t\t}\n  1495\t\t\treturn 0\n  1496\t\t}\n  1497\t\n  1498\t\tvar results []doctorFixResult\n  1499\t\tfor _, c := range candidates {\n  1500\t\t\tif err := doctorFixRegistry[c].apply(root); err != nil {\n  1501\t\t\t\tresults = append(results, doctorFixResult{c, \"error\", redactSecretShapedContent(err.Error())})\n  1502\t\t\t} else {\n  1503\t\t\t\tresults = append(results, doctorFixResult{c, \"applied\", \"\"})\n  1504\t\t\t}\n  1505\t\t}\n  1506\t\n  1507\t\t_, after := runDoctorDiagnostics(locale)\n  1508\t\tstillBroken := map[string]bool{}\n  1509\t\tfor _, f := range after {\n  1510\t\t\tif f.Level != \"ok\" {\n  1511\t\t\t\tstillBroken[f.Check] = true\n  1512\t\t\t}\n  1513\t\t}\n  1514\t\tallResolved := true\n  1515\t\tfor _, c := range candidates {\n  1516\t\t\tif stillBroken[c] {\n  1517\t\t\t\tallResolved = false\n  1518\t\t\t}\n  1519\t\t}\n  1520\t\n  1521\t\terrors, warns := countLevels(after)\n  1522\t\tif jsonOut {\n  1523\t\t\tenc := json.NewEncoder(stdout)\n  1524\t\t\tenc.SetIndent(\"\", \"  \")\n  1525\t\t\t_ = enc.Encode(map[string]any{\n  1526\t\t\t\t\"doctor_schema_version\": doctorSchemaVersion,\n  1527\t\t\t\t\"findings\":              after,\n  1528\t\t\t\t\"errors\":                errors,\n  1529\t\t\t\t\"warnings\":              warns,\n  1530\t\t\t\t\"next_steps\":            countNext(after),\n  1531\t\t\t\t\"fix\": map[string]any{\n  1532\t\t\t\t\t\"mode\":    \"apply\",\n  1533\t\t\t\t\t\"results\": results,\n  1534\t\t\t\t},\n  1535\t\t\t})\n  1536\t\t} else {\n  1537\t\t\trenderFindingsText(after, stdout, locale)\n  1538\t\t\tprintSummaryLine(after, stdout, locale)\n  1539\t\t\tfmt.Fprintln(stdout, cliText(locale, \"\\n[APPLIED]\", \"\\n[APLICADO]\"))\n  1540\t\t\tfor _, r := range results {\n  1541\t\t\t\tdetail := \"\"\n  1542\t\t\t\tif r.Detail != \"\" {\n  1543\t\t\t\t\tdetail = \" (\" + r.Detail + \")\"\n  1544\t\t\t\t}\n  1545\t\t\t\tfmt.Fprintf(stdout, \"  - %s: %s%s\\n\", r.Check, r.Status, detail)\n  1546\t\t\t}\n  1547\t\t\tif allResolved {\n  1548\t\t\t\tfmt.Fprintln(stdout, cliText(locale, \"Result: SUCCESS — recheck confirms every targeted finding is now ok.\", \"Resultado: SUCESSO — a reverificação confirma que todo achado alvo agora está ok.\"))\n  1549\t\t\t} else {\n  1550\t\t\t\tfmt.Fprintln(stdout, cliText(locale, \"Result: PARTIAL — recheck still finds an issue on at least one targeted check.\", \"Resultado: PARCIAL — a reverificação ainda encontra um problema em pelo menos um check alvo.\"))\n  1551\t\t\t}\n  1552\t\t}\n  1553\t\tif !allResolved {\n  1554\t\t\treturn 1\n  1555\t\t}\n  1556\t\tfor _, r := range results {\n  1557\t\t\tif r.Status == \"error\" {\n  1558\t\t\t\treturn 1\n  1559\t\t\t}\n  1560\t\t}\n  1561\t\treturn 0\n  1562\t}\n  1563\t\n  1564\t// declaredMCPProjectID returns the POSE_DEFAULT_PROJECT_ID the \"pose\" server\n  1565\t// entry of a .mcp.json declares, or \"\" when it declares none or cannot be read.\n  1566\tfunc declaredMCPProjectID(raw []byte) string {\n  1567\t\tvar doc struct {\n  1568\t\t\tMCPServers map[string]struct {\n  1569\t\t\t\tEnv map[string]any `json:\"env\"`\n  1570\t\t\t} `json:\"mcpServers\"`\n  1571\t\t}\n  1572\t\tif json.Unmarshal(raw, &doc) != nil {\n  1573\t\t\treturn \"\"\n  1574\t\t}\n  1575\t\tid, _ := doc.MCPServers[\"pose\"].Env[\"POSE_DEFAULT_PROJECT_ID\"].(string)\n  1576\t\treturn id\n  1577\t}\n  1578\t\n  1579\t// diagnoseCloseoutReviewPolicy reports open milestones and roadmaps that owe\n  1580\t// their own review under the adopted closeout review policy, because of the\n  1581\t// policy or of their composition (spec pose-closeout-review-policy-by-cost-benefit\n  1582\t// R6). It only reports: `pose close` remains the gate.\n  1583\tfunc diagnoseCloseoutReviewPolicy(root string, add func(string, string, string, string), text func(string, string) string) {\n  1584\t\tstore := posemodel.Store{Root: root}\n  1585\t\tpolicy, err := store.GetReviewPolicy()\n  1586\t\tif err != nil || !policy.CloseoutReviewAdopted() {\n  1587\t\t\treturn\n  1588\t\t}\n  1589\t\towing, err := store.CloseoutReviewsOwed()\n  1590\t\tif err != nil {\n  1591\t\t\tadd(\"closeout-review.owed\", \"warn\", fmt.Sprintf(text(\"open scopes owing a closeout review could not be listed: %v\", \"escopos abertos que devem revisão de fechamento não puderam ser listados: %v\"), err), text(\"run `pose closeout-check <scope>` for each open milestone and roadmap\", \"rode `pose closeout-check <escopo>` para cada milestone e roadmap aberto\"))\n  1592\t\t\treturn\n  1593\t\t}\n  1594\t\tif len(owing) == 0 {\n  1595\t\t\tadd(\"closeout-review.owed\", \"ok\", fmt.Sprintf(text(\"no open scope owes a review it lacks (milestone_review_required=%s, roadmap_review_required=%s)\", \"nenhum escopo aberto deve uma revisão que não tem (milestone_review_required=%s, roadmap_review_required=%s)\"), policy.MilestoneReviewRequired, policy.RoadmapReviewRequired), \"\")\n  1596\t\t\treturn\n  1597\t\t}\n  1598\t\tfor _, item := range owing {\n  1599\t\t\tadd(\"closeout-review.owed\", \"warn\", fmt.Sprintf(text(\"%s owes its own review: %s=%s, %s; previous rule %s\", \"%s deve revisão própria: %s=%s, %s; regra anterior %s\"), item.Scope, item.Decision.PolicyKey, item.Decision.PolicyValue, item.Decision.Reason, item.Previous), item.Action)\n  1600\t\t}\n  1601\t}\n","exit_code":0,"status":"completed"}}
