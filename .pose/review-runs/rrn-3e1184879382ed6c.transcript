rawTools, findings []string, componentAware bool) (string, error) {\n1435:\tfmt.Fprintf(&b, \"---\\nschema_version: 1\\nreview_id: %s\\nscope: %s\\nscope_digest: %s\\nplan_digest: %s\\nprofile: %s\\nreviewer: %s\\ndecision: %s\\nreviewed_at: %s\\n\", id, scope, digest, plan.PlanDigest, profile.Ref(), reviewer, decision, reviewedAt)\n1500:// once, and does not hold a negative decision to the approval bar (spec\n1959:\t// roadmap publishes a receipt. A receipt already there makes the close a\n1961:\treceiptClose, code := closeoutReceiptPreflight(store, ref, scope, &state, stdout, stderr)\n1980:\t\tif receiptClose != nil {\n1981:\t\t\tjudgedState, code := verifyCloseoutPublication(store, ref, *receiptClose, guard, stderr)\n1985:\t\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, judgedState, stdout, stderr); code != 0 {\n2083:\t} else if !(closeReviewSatisfied(current) || receiptClose != nil && !receiptClose.Required) || hasActionRequestPending(current.Diagnostics) || hasDiagnostic(current.Diagnostics, posemodel.AdjudicationDoesNotHoldCode) {\n2104:\tvar receiptState posemodel.CloseoutState\n2105:\tif receiptClose != nil {\n2108:\t\tjudgedState, code := verifyCloseoutPublication(store, ref, *receiptClose, nil, stderr)\n2112:\t\treceiptState = judgedState\n2113:\t\t// The intent stands from before the status until the receipt: an\n2116:\t\tif err := store.PublishCloseoutIntent(ref, *receiptClose, time.Now()); err != nil {\n2136:\tif receiptClose != nil {\n2137:\t\t// The status is published; the receipt is the terminal marker and\n2140:\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, receiptState, stdout, stderr); code != 0 {\n2178:\tcase \"milestone\":\n2393:\tcase \"roadmap\":\n2437:// closeoutReceiptPreflight decides whether this close publishes a receipt.\n2438:// It returns the decision to record (nil: legacy close) and an exit code, or\n2439:// -1 to go on. A receipt already there makes the close a verification of the\n2440:// current terminal contract. A done roadmap with no receipt is the incomplete\n2441:// case: its decision is taken again over the current inputs, under the same\n2461:\t\t// policy: a receipt does not stand for a gate that no longer holds.\n2466:\t\treceipt := state.CloseoutReceipt\n2467:\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; closeout receipt of \"+receipt.ClosedAt+\" stands (review: \"+receipt.Review+\"); applicable terminal verifier passed; no transition executed\")\n2470:\tdecision := state.Review.CloseoutReview\n2471:\tif decision == nil {\n2472:\t\t// No decision: a scope of a roadmap closed before adoption, verified by\n2473:\t\t// the contract it was sealed under. It never gets a receipt; for a done\n2485:\tif !decision.Known {\n2486:\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout review of \" + ref + \" cannot be decided: \" + strings.Join(decision.Diagnostics, \"; \"))\n2491:\tif !decision.Required && len(state.Blockers) > 0 && !onlyLifecycleBlockers(state.Blockers) {\n2495:\trender(stdout, stderr).Field(\"close.review\", decision.Review()+\" (\"+decision.PolicyKey+\"=\"+decision.PolicyValue+\", \"+decision.Reason+\")\")\n2496:\treturn decision, -1\n2500:// the protected region: the same protected decision, the same members and\n2502:// which the receipt is built from.\n2503:func verifyCloseoutPublication(store posemodel.Store, ref string, decision posemodel.CloseoutReviewDecision, guard func() error, stderr io.Writer) (posemodel.CloseoutState, int) {\n2519:\tif current.Required != decision.Required || current.Known != decision.Known || current.PolicyValue != decision.PolicyValue ||\n2520:\t\tstrings.Join(current.Members, \",\") != strings.Join(decision.Members, \",\") || strings.Join(current.ADRs, \",\") != strings.Join(decision.ADRs, \",\") {\n2521:\t\treturn changed(\"the review decision differs\")\n2529:\t\treturn changed(\"a receipt was published meanwhile\")\n2531:\tif decision.Required && !state.Review.Approved {\n2534:\tif !decision.Required && state.Review.Required && !state.LifecycleDone {\n2543:// publishCloseoutReceipt publishes the receipt of a close from the state the\n2545:func publishCloseoutReceipt(store posemodel.Store, ref string, decision posemodel.CloseoutReviewDecision, judged posemodel.CloseoutState, stdout, stderr io.Writer) int {\n2546:\treceipt, err := store.NewCloseoutReceipt(ref, decision, judged.Review, judged.ScopeDigest, time.Now())\n2551:\tif err := store.PublishCloseoutReceipt(receipt); err != nil {\n2555:\t\t\trender(io.Discard, stderr).Failure(\"pose close: closeout receipt not published: \" + err.Error() + \"; `pose close \" + ref + \"` verifies again and publishes it\")\n2560:\t\trender(stdout, stderr).Field(\"close.intent\", \"the receipt stands; its intent record could not be removed: \"+err.Error())\n2562:\trender(stdout, stderr).Field(\"close.receipt\", \"review: \"+receipt.Review+\"; \"+decision.PolicyKey+\"=\"+decision.PolicyValue+\"; \"+decision.Reason)\n2567:// is not done yet: the receipt is published right after that status.\n2581:\tcase \"milestone\":\n2589:\tcase \"roadmap\":\n","exit_code":0,"status":"completed"}}
