{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/usr/bin/bash -lc \"sed -n '2040,2155p' pose-mcp/internal/cli/review_closeout.go\"","aggregated_output":"\t\t\t// promise at nothing (spec pose-trace-test-refs-resolve).\n\t\t\tcatalog, catalogErr := posemodel.LoadTestCatalogChecked(root)\n\t\t\tif catalogErr != nil {\n\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate incomplete: \" + catalogErr.Error())\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\tif unresolved := posemodel.UnresolvedTestRefs(posemodel.ParseRequirementTrace(string(raw)), catalog); len(unresolved) > 0 {\n\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: requirement trace gate failed: \" + strings.Join(unresolved, \"; \") + \" names no test in this repository or its submodules — cite the test function, subtest, test title or test file\")\n\t\t\t\treturn 1\n\t\t\t}\n\t\t}\n\t\tpath = sp.Path\n\t} else {\n\t\tvar gateOut, gateErr bytes.Buffer\n\t\tif code := cmdRoadmapCheck(root, []string{scope.Slug, \"--strict\"}, &gateOut, &gateErr); code != 0 {\n\t\t\tfmt.Fprintf(stderr, \"pose close: roadmap gate failed: %s%s\", gateErr.String(), gateOut.String())\n\t\t\treturn 1\n\t\t}\n\t\tpath = filepath.Join(root, \".pose\", \"roadmaps\", scope.Slug+\".md\")\n\t}\n\tif closeGatesJudged != nil {\n\t\tcloseGatesJudged()\n\t}\n\t// Start, close and transfer of a spec share its lifecycle lock (R3).\n\tif scope.Kind == \"spec\" {\n\t\tunlock, err := posemodel.LockSpecLifecycle(root, scope.Slug, \"close.transition\")\n\t\tif err != nil {\n\t\t\tvar held *posemodel.StartLockError\n\t\t\tif errors.As(err, &held) {\n\t\t\t\trenderStartLock(render(stdout, stderr), scope.Slug, held)\n\t\t\t}\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tdefer unlock()\n\t}\n\t// The authorization is judged again inside the protected region: a\n\t// review that stopped being approved, or an action request that now\n\t// restricts closeout, while the gates ran does not govern this\n\t// publication (spec pose-writer-coordination-and-atomic-publication R4).\n\tif current, err := cliCloseoutStateForStore(store, ref); err != nil {\n\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\treturn 1\n\t} else if !(closeReviewSatisfied(current) || receiptClose != nil && !receiptClose.Required) || hasActionRequestPending(current.Diagnostics) || hasDiagnostic(current.Diagnostics, posemodel.AdjudicationDoesNotHoldCode) {\n\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout authorization changed while its gates ran; next action: \" + current.NextAction)\n\t\treturn 1\n\t}\n\tif guard != nil {\n\t\tif err := guard(); err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t}\n\tif scope.Kind == \"spec\" {\n\t\tsp, err := store.GetSpec(scope.Slug)\n\t\tif err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tif _, findings, err := store.InspectAmendmentHistory(*sp); err != nil || len(findings) > 0 {\n\t\t\trender(io.Discard, stderr).Failure(fmt.Sprintf(\"pose close: amendment history gate failed: %v %s\", err, strings.Join(findings, \"; \")))\n\t\t\treturn 1\n\t\t}\n\t}\n\tvar receiptState posemodel.CloseoutState\n\tif receiptClose != nil {\n\t\t// Judged before the status is published: afterwards the index no\n\t\t// longer matches the tree until it is regenerated.\n\t\tjudgedState, code := verifyCloseoutPublication(store, ref, *receiptClose, nil, stderr)\n\t\tif code != 0 {\n\t\t\treturn code\n\t\t}\n\t\treceiptState = judgedState\n\t\t// The intent stands from before the status until the receipt: an\n\t\t// interruption between them reads as an incomplete close, never as\n\t\t// a roadmap closed before adoption.\n\t\tif err := store.PublishCloseoutIntent(ref, *receiptClose, time.Now()); err != nil {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: closeout intent not recorded: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t}\n\tvar unsynced error\n\tif err := applyLifecycleDoneIn(store.FS, path, scope.Kind == \"spec\", judged); err != nil {\n\t\tif errors.Is(err, posemodel.ErrPublishConflict) {\n\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error() + \"; the gates judged other bytes, so run `pose close \" + ref + \"` again to judge the current ones\")\n\t\t\treturn 1\n\t\t}\n\t\t// The transition took effect and only its durability is unconfirmed: the\n\t\t// scope is closed, and refusing here would say otherwise.\n\t\tif !errors.Is(err, posemodel.ErrPublishUnsynced) {\n\t\t\tfmt.Fprintf(stderr, \"pose close: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tunsynced = err\n\t\trender(stdout, stderr).Field(\"close.unsynced\", err.Error())\n\t}\n\tif receiptClose != nil {\n\t\t// The status is published; the receipt is the terminal marker and\n\t\t// comes after it. A failure here leaves the roadmap explicitly\n\t\t// incomplete, and the next `pose close` verifies again and publishes.\n\t\tif code := publishCloseoutReceipt(store, ref, *receiptClose, receiptState, stdout, stderr); code != 0 {\n\t\t\treturn code\n\t\t}\n\t}\n\tif transitioned != nil {\n\t\ttransitioned(unsynced)\n\t}\n\tfmt.Fprintf(stdout, \"Closed: %s\\n\", ref)\n\trenderCloseNext(render(stdout, stderr), nextCloses(store, ref))\n\treturn 0\n}\n\n// nextCloses names what the close of a scope leaves reachable: the milestones a\n// spec finished, or the roadmap a milestone finished (spec\n// pose-milestone-closes-when-reached R3). A failed read is reported in its place,\n// since the close itself stands.\n","exit_code":0,"status":"completed"}}
