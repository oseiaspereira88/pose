{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 8e3009b2 b2fe0321 -- pose-mcp/internal/cli/surface_check.go pose-mcp/internal/pose/review_plan.go pose-mcp/internal/pose/artifact_ref.go pose-mcp/internal/pose/spec_transfer.go'","aggregated_output":"diff --git a/pose-mcp/internal/cli/surface_check.go b/pose-mcp/internal/cli/surface_check.go\nindex 1c9cd9c2..179ff26f 100644\n--- a/pose-mcp/internal/cli/surface_check.go\n+++ b/pose-mcp/internal/cli/surface_check.go\n@@ -397,12 +397,16 @@ func roadmapGate(root, slug, milestone string) (roadmapGateResult, error) {\n \t\t}\n \t\tfound = true\n \t\tfor _, member := range candidate.Specs {\n-\t\t\tlocal := member\n-\t\t\tif ref, err := posemodel.ParseArtifactRef(member); err == nil && ref.Project != \"\" {\n-\t\t\t\tif ref.Project != project {\n-\t\t\t\t\tcontinue\n-\t\t\t\t}\n-\t\t\t\tlocal = ref.Slug\n+\t\t\t// The member as the closeout review policy counts it: a local\n+\t\t\t// member a transfer moved is judged at its destination, and an\n+\t\t\t// external one by federated acceptance (review round 6, N24).\n+\t\t\tlocal, external, unresolved := store.CloseoutMemberTarget(member)\n+\t\t\tif unresolved != \"\" {\n+\t\t\t\tblockers = append(blockers, \"member spec is not resolvable: \"+unresolved)\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tif external {\n+\t\t\t\tcontinue\n \t\t\t}\n \t\t\tstate, err := store.GetCloseoutState(\"spec:\" + local)\n \t\t\tif err != nil || !state.Terminal {\ndiff --git a/pose-mcp/internal/pose/artifact_ref.go b/pose-mcp/internal/pose/artifact_ref.go\nindex 22fc3d8a..f9f09763 100644\n--- a/pose-mcp/internal/pose/artifact_ref.go\n+++ b/pose-mcp/internal/pose/artifact_ref.go\n@@ -201,7 +201,13 @@ func (r ArtifactResolver) resolve(localProject, raw string, redirectPath map[str\n \t\trefsRequired := policy.SchemaVersion == QualifiedArtifactPolicySchemaVersion || policy.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion\n \t\ttransferValid := policy.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion && policy.TransferVersion == 1 || policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && policy.TransferVersion == 0\n \t\trefsCompatible := policy.RefsVersion == 0 || policy.RefsVersion == 1 && refsRequired\n-\t\tif !refsCompatible || refsRequired && policy.RefsVersion != 1 || policy.SchemaVersion > SpecAuthorityTransferPolicySchemaVersion || !transferValid {\n+\t\tif policy.SchemaVersion == CloseoutReviewPolicySchemaVersion {\n+\t\t\t// Schema 5 (closeout review pair) keeps references and transfer\n+\t\t\t// optional: 0, or 1 as schemas 3 and 4 define them.\n+\t\t\trefsCompatible = policy.RefsVersion == 0 || policy.RefsVersion == 1\n+\t\t\ttransferValid = policy.TransferVersion == 0 || policy.TransferVersion == 1 && policy.RefsVersion == 1\n+\t\t}\n+\t\tif !refsCompatible || refsRequired && policy.RefsVersion != 1 || policy.SchemaVersion > CloseoutReviewPolicySchemaVersion || !transferValid {\n \t\t\tout.State = \"unsupported-artifact-contract\"\n \t\t\treturn out\n \t\t}\ndiff --git a/pose-mcp/internal/pose/review_plan.go b/pose-mcp/internal/pose/review_plan.go\nindex 0782e239..7182af75 100644\n--- a/pose-mcp/internal/pose/review_plan.go\n+++ b/pose-mcp/internal/pose/review_plan.go\n@@ -131,6 +131,10 @@ type ReviewPlan struct {\n \tWarnings                  []string `json:\"warnings,omitempty\"`\n \tBlockers                  []string `json:\"blockers,omitempty\"`\n \tExplain                   []string `json:\"explain\"`\n+\t// CloseoutReview is the closeout-review@1 decision for a milestone or a\n+\t// roadmap under an adopted policy. Like Band it is a projection: it stays\n+\t// out of the plan digest (spec pose-closeout-review-policy-by-cost-benefit).\n+\tCloseoutReview *CloseoutReviewDecision `json:\"closeout_review,omitempty\"`\n }\n \n type reviewRepoEntry struct {\n@@ -397,6 +401,16 @@ func (s Store) ReviewPlan(ref string) (ReviewPlan, error) {\n \tif err != nil {\n \t\treturn ReviewPlan{}, err\n \t}\n+\t// Warnings and Explain enter the digest; the decision does not, so it is\n+\t// attached only as its own field. A gate that cannot answer (a corrupt or\n+\t// drifted receipt) fails the plan as it fails closeout-check.\n+\tif !s.planWithoutCloseoutGate {\n+\t\tdecision, _, gateErr := s.closeoutReviewGate(ref, policy)\n+\t\tif gateErr != nil {\n+\t\t\treturn ReviewPlan{}, gateErr\n+\t\t}\n+\t\tplan.CloseoutReview = decision\n+\t}\n \treturn plan, nil\n }\n \n@@ -565,7 +579,7 @@ func (s Store) reviewScopeSpecs(scope ScopeRef) ([]Spec, error) {\n \t\t// Another project's member contributes no local components; its\n \t\t// review lives in its own project and reaches this scope through the\n \t\t// federated manifest.\n-\t\tslug, external := s.milestoneMember(raw)\n+\t\tslug, external := s.canonicalMember(raw)\n \t\tif external {\n \t\t\tcontinue\n \t\t}\n@@ -1085,6 +1099,7 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \tif err != nil {\n \t\treturn criteria, blockers\n \t}\n+\tadopted, _ := s.closeoutReviewPolicyAdopted()\n \tfor _, rm := range roadmaps {\n \t\tif terminalStatuses[rm.Status] {\n \t\t\tcontinue\n@@ -1094,10 +1109,19 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \t\t\t\tcontinue\n \t\t\t}\n \t\t\tref := ScopeRef{Kind: \"milestone\", Roadmap: rm.Slug, Milestone: milestone.ID}\n-\t\t\tif member, ok := s.soleMemberOf(ref); !ok || member != scope.Slug {\n+\t\t\tmember, ok := s.soleMemberOf(ref)\n+\t\t\tcarries := ok && member == scope.Slug\n+\t\t\t// Under an adopted closeout review policy a milestone of more\n+\t\t\t// members may close without its own review; its gate is then\n+\t\t\t// judged in the review of its last member (spec\n+\t\t\t// pose-closeout-review-policy-by-cost-benefit, review round 5 N19).\n+\t\t\tif !carries && adopted {\n+\t\t\t\tcarries = s.lastOpenMemberOf(rm.Slug, milestone, scope.Slug)\n+\t\t\t}\n+\t\t\tif !carries {\n \t\t\t\tcontinue\n \t\t\t}\n-\t\t\tif done && !sealedCarries(\"milestone-exit-gate-\"+rm.Slug+\"-\"+milestone.ID) {\n+\t\t\tif done && !sealedCarries(milestoneExitGateCriterionID(rm.Slug, milestone.ID)) {\n \t\t\t\tif historyUnknown != \"\" {\n \t\t\t\t\t// Absent history is not unreadable history: the plan says it cannot\n \t\t\t\t\t// tell whether the gate was sealed, instead of silently dropping it.\n@@ -1106,8 +1130,8 @@ func (s Store) addMilestoneGateCriterion(scope ScopeRef, criteria []ReviewPlanCr\n \t\t\t\tcontinue\n \t\t\t}\n \t\t\tcriteria, blockers = addReviewCriterion(criteria, ReviewPlanCriterion{\n-\t\t\t\tID:          \"milestone-exit-gate-\" + rm.Slug + \"-\" + milestone.ID,\n-\t\t\t\tDescription: \"The exit gate of milestone:\" + rm.Slug + \"/\" + milestone.ID + \" holds: \" + milestone.ExitGate,\n+\t\t\t\tID:          milestoneExitGateCriterionID(rm.Slug, milestone.ID),\n+\t\t\t\tDescription: milestoneExitGateCriterionDescription(rm.Slug, milestone.ID, milestone.ExitGate),\n \t\t\t\tRequired:    true,\n \t\t\t\tKind:        ReviewCriterionKindJudgment,\n \t\t\t\tProfiles:    []string{\"milestone-exit-gate\"},\ndiff --git a/pose-mcp/internal/pose/spec_transfer.go b/pose-mcp/internal/pose/spec_transfer.go\nindex 09ae1fe4..1fd62349 100644\n--- a/pose-mcp/internal/pose/spec_transfer.go\n+++ b/pose-mcp/internal/pose/spec_transfer.go\n@@ -528,7 +528,7 @@ func requireSpecTransferCapability(files Files, store Store) error {\n \tif err != nil {\n \t\treturn specTransferError(\"unsupported-policy\")\n \t}\n-\tif policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion || policy.QualifiedArtifactRefsVersion != 1 || policy.SpecAuthorityTransferVersion != 1 {\n+\tif (policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && policy.SchemaVersion != CloseoutReviewPolicySchemaVersion) || policy.QualifiedArtifactRefsVersion != 1 || policy.SpecAuthorityTransferVersion != 1 {\n \t\treturn specTransferError(\"spec-authority-transfer-capability-not-