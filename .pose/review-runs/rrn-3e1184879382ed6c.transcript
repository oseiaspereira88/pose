t// An adopted closeout review policy decides an aggregate scope before the\n1525:\t// what it requires (spec pose-closeout-review-policy-by-cost-benefit).\n1526:\tdecision, exempt, err := s.closeoutReviewGate(ref, policy)\n1530:\teval.CloseoutReview = decision\n1535:\t\t\teval.ApprovalOrigin = closeoutApprovalOrigin(*decision)\n1536:\t\t\teval.Warnings = append(eval.Warnings, closeoutExemptionWarning(ref, *decision))\n1546:\t\teval.Warnings = append(eval.Warnings, \"review policy is absent or disabled; closeout review is not enforced\")\n1732:\t// every past closeout stale, without any of them having become less\n1896:\t\teval.Blockers = append(eval.Blockers, \"review decision does not permit closeout: \"+current.Decision)\n2057:// closeout recorded under the previous rule starts failing — not because it\n2313:// check can actually emit retroactively invalidates every closeout that cited\n2437:// reviewed work: the closeout commit extends the scope's change set, so the\n2440:// Both happen after every ordinary closeout. `review-check` has always applied\n2653:func (s Store) GetCloseoutState(ref string) (CloseoutState, error) {\n2654:\treturn withGovernanceReviewReadView(s, \"closeout\", func(store Store) (CloseoutState, error) {\n2655:\t\treturn store.getCloseoutState(ref, true)\n2656:\t}, func(state *CloseoutState, metadata *ReadViewMetadata, audit governanceReadViewAudit) {\n2657:\t\tapplyCloseoutReadView(state, metadata, ref, audit)\n2661:func (s Store) getCloseoutState(ref string, includeFederated bool) (CloseoutState, error) {\n2665:\t\treturn CloseoutState{}, err\n2669:\t\treturn CloseoutState{}, err\n2671:\tstate := CloseoutState{SchemaVersion: ReviewSchemaVersion, Scope: ref, ScopeDigest: review.ScopeDigest, Review: review, LifecycleDone: true, Blockers: append([]string{}, review.Blockers...)}\n2682:\t\tdiagnostics = append(diagnostics, OpaqueDiagnostic(\"review-blocker\", DiagnosticCloseout, blocker))\n2700:\t\t// blocks the closeout as it fails the lint (spec\n2703:\t\t\tblock(OpaqueDiagnostic(AdjudicationDoesNotHoldCode, DiagnosticCloseout, message))\n2706:\t\t\tblock(OpaqueDiagnostic(\"amendment-history-invalid\", DiagnosticCloseout, \"amendment history: \"+historyErr.Error()))\n2710:\t\t\t\tblock(OpaqueDiagnostic(\"amendment-history-invalid\", DiagnosticCloseout, \"amendment history: \"+finding))\n2725:\t\t\t\tslug, external, unresolved := s.CloseoutMemberTarget(raw)\n2727:\t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", unresolved, raw))\n2736:\t\t\t\tchild, err := childStore.getCloseoutState(\"spec:\"+slug, false)\n2742:\t\t\t\tif !child.Terminal && !(review.Approved && s.declaredUnreviewed(scope) != \"\") {\n2751:\t\t\tif decision := review.CloseoutReview; decision != nil && !decision.Required && strings.TrimSpace(milestone.ExitGate) != \"\" && !review.Approved && !s.exitGateJudgedByMember(rm.Slug, milestone, state.Children) {\n2766:\t\t\tchild, err := childStore.getCloseoutState(\"milestone:\"+rm.Slug+\"/\"+milestone.ID, false)\n2771:\t\t\tif !child.Terminal {\n2790:\t\t\t\tblock(OpaqueDiagnostic(\"federated-acceptance-blocker\", DiagnosticCloseout, blocker))\n2803:\t\t\t\t\tblock(OpaqueDiagnostic(\"federated-acceptance-blocker\", DiagnosticCloseout, blocker))\n2810:\t\tif policy, policyErr := s.GetReviewPolicy(); policyErr == nil && policy.CloseoutReviewAdopted() {\n2811:\t\t\treceipt, receiptErr := s.ReadCloseoutReceipt(ref)\n2813:\t\t\t\tblock(OpaqueDiagnostic(\"closeout-receipt-invalid\", DiagnosticCloseout, receiptErr.Error()))\n2815:\t\t\tstate.CloseoutReceipt = receipt\n2816:\t\t\tif decision := review.CloseoutReview; decision != nil && receipt == nil && receiptErr == nil {\n2817:\t\t\t\t// Terminal members make the scope eligible, never closed: the\n2821:\t\t\t\t\tblock(NewDiagnostic(\"closeout-review-unknown\", diagnostic, ref))\n2824:\t\t\tif review.CloseoutReview == nil && receipt == nil && scope.Kind == \"roadmap\" && state.LifecycleDone && review.Required && !review.Approved {\n2825:\t\t\t\tdiagnostics = append(diagnostics, NewDiagnostic(\"closeout-receipt-incomplete\", \"roadmap \"+scope.Slug+\" is done with neither an approved review nor a closeout receipt; `pose close \"+ref+\"` verifies its inputs again and publishes the receipt\", ref))\n2830:\tif scope.Kind == \"roadmap\" && state.CloseoutReceipt != nil {\n2834:\t\t\tblock(NewDiagnostic(\"closeout-receipt-gate-failed\", blocker, ref))\n2839:\tif !review.Required && review.CloseoutReview == nil {\n2856:\t// adopted capability, an unsatisfied action request restricting closeout\n2861:\t\t\trestrictions, restrictErr := s.GovernedEffectRestrictions(PhaseCloseout, []string{scope.Slug})\n2866:\t\t\t\tblock(governedEffectDiagnostic(o, PhaseCloseout, ref))\n2871:\tstate.Terminal = len(state.Blockers) == 0 && (review.Approved || !review.Required) && state.LifecycleDone && !closeOwed\n2872:\tif state.Terminal {\n2876:\t\t\tif !child.Terminal {\n2896:\t\tstate.NextAction = \"close \" + ref + \" with `pose close \" + ref + \"`, which publishes its closeout receipt\"\n2899:\t\tstate.NextAction = \"resolve closeout blockers for \" + ref\n2909:\tstate.NextStep = closeoutNextStep(state, review, ref)\n2913:// closeoutNextStep types NextAction: the same decision, as a code and refs.\n2914:func closeoutNextStep(state CloseoutState, review ReviewEvaluation, ref string) *Diagnostic {\n2916:\t\treturn &Diagnostic{Code: code, Domain: DiagnosticCloseout, Refs: refs, Message: state.NextAction}\n2924:\tcase state.Terminal:\n2928:\t\t\tif !child.Terminal {\n2945:\treturn step(\"resolve-closeout-blockers\", ref)\n2962:// GetCloseoutStateWithFederatedAcceptance adds the current cross-project\n2963:// roadmap snapshot to roadmap and milestone closeout. The caller supplies the\n2965:func (s Store) GetCloseoutStateWithFederatedAcceptance(ref, projectID string, resolver ArtifactResolver) (CloseoutState, error) {\n2968:\treturn s.GetCloseoutState(ref)\n2973:// another project is external: local closeout cannot read it, and only\n","exit_code":0,"status":"completed"}}
