{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XCfSfFZp5UU1fr8Pr95HHX","type":"tool_result","content":"50\t\tRequiresPrimaryRevision   bool\n51\t}\n52\t\n53\t// BuildIndexFederatedMaterialIn returns the specs, roadmaps, semantic\n54\t// projections and exact foreign projects whose contents were resolved. The\n55\t// Store must carry the operation's authorized resolver when one has already\n56\t// been established; it is reused unchanged except for the captured Files the\n57\t// operation view supplies.\n58\tfunc BuildIndexFederatedMaterialIn(store Store) (IndexFederatedMaterial, error) {\n59\t\tresolver := ArtifactResolver{}\n60\t\tproject := store.FederatedProjectID\n61\t\tif store.FederatedResolver != nil {\n62\t\t\tresolver = *store.FederatedResolver\n63\t\t\tif resolver.Roots == nil {\n64\t\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: authorized project roots are unavailable for index material\")\n65\t\t\t}\n66\t\t} else {\n67\t\t\tvar err error\n68\t\t\tresolver, project, err = EnvironmentArtifactResolverIn(store.fsys(), store.Root, \"\")\n69\t\t\tif err != nil {\n70\t\t\t\treturn IndexFederatedMaterial{}, fmt.Errorf(\"pose: index material resolver: %w\", err)\n71\t\t\t}\n72\t\t}\n73\t\tif project == \"\" {\n74\t\t\tvar found, ambiguous, overflow bool\n75\t\t\tproject, found, ambiguous, overflow = uniqueProjectIDForRootIn(store.fsys(), resolver.Roots, store.Root, resolver.Authorize)\n76\t\t\tif overflow {\n77\t\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material root identity exceeds the authorized-root snapshot budget\")\n78\t\t\t}\n79\t\t\tif ambiguous {\n80\t\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material root has multiple authorized project identities\")\n81\t\t\t}\n82\t\t\tif !found {\n83\t\t\t\tproject = DefaultProjectIDIn(store.fsys(), store.Root)\n84\t\t\t\tif ValidateSlug(project) != nil || resolver.Authorize != nil && !resolver.Authorize(project) {\n85\t\t\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material project identity is not authorized\")\n86\t\t\t\t}\n87\t\t\t\tbound, err := resolver.Roots.StoreFor(project)\n88\t\t\t\tif err != nil || !sameProjectRoot(store.fsys(), bound.Root, store.Root) {\n89\t\t\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material root is outside the authorized project registry\")\n90\t\t\t\t}\n91\t\t\t}\n92\t\t}\n93\t\tif ValidateSlug(project) != nil {\n94\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material project identity is unavailable\")\n95\t\t}\n96\t\n97\t\t// Fresh for this build, never inherited from an earlier advisory operation.\n98\t\tresolver = resolver.WithSpecSnapshots()\n99\t\tspecs, err := store.ListSpecs(\"\", \"\")\n100\t\tif err != nil && !errors.Is(err, fs.ErrNotExist) {\n101\t\t\treturn IndexFederatedMaterial{}, fmt.Errorf(\"pose: listing specs for index material: %w\", err)\n102\t\t}\n103\t\troadmaps, err := store.ListRoadmaps()\n104\t\tif err != nil {\n105\t\t\treturn IndexFederatedMaterial{}, fmt.Errorf(\"pose: listing roadmaps for index material: %w\", err)\n106\t\t}\n107\t\tsort.Slice(specs, func(i, j int) bool { return specs[i].Slug < specs[j].Slug })\n108\t\tsort.Slice(roadmaps, func(i, j int) bool { return roadmaps[i].Slug < roadmaps[j].Slug })\n109\t\n110\t\tmaterial := IndexFederatedMaterial{\n111\t\t\tSpecs:                     specs,\n112\t\t\tRoadmaps:                  roadmaps,\n113\t\t\tSpecDependencyResolutions: make(map[string][]ArtifactResolution, len(specs)),\n114\t\t\tRoadmapAcceptances:        make(map[string]FederatedRoadmapAcceptanceReport, len(roadmaps)),\n115\t\t\tProjection: IndexFederatedMaterialProjection{\n116\t\t\t\tSchemaVersion: 1,\n117\t\t\t\tSpecs:         make([]IndexFederatedSpecMaterial, 0, len(specs)),\n118\t\t\t\tRoadmaps:      make([]IndexFederatedRoadmapMaterial, 0, len(roadmaps)),\n119\t\t\t},\n120\t\t}\n121\t\tprojects := map[string]bool{}\n122\t\treferencedProjects := map[string]bool{}\n123\t\taddProject := func(id string) {\n124\t\t\tif id == \"\" || id == project {\n125\t\t\t\treturn\n126\t\t\t}\n127\t\t\treferencedProjects[id] = true\n128\t\t\tif resolver.Authorize != nil && !resolver.Authorize(id) {\n129\t\t\t\treturn\n130\t\t\t}\n131\t\t\tif _, err := resolver.Roots.StoreFor(id); err == nil {\n132\t\t\t\t// Include only foreign roots named by this semantic projection. A\n133\t\t\t\t// project discovered for reading still has to pass the explicit-root\n134\t\t\t\t// write guard before this generation can be published.\n135\t\t\t\tprojects[id] = true\n136\t\t\t}\n137\t\t}\n138\t\tfor _, spec := range specs {\n139\t\t\tresolutions := make([]ArtifactResolution, 0, len(spec.DependsOn))"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"692c9c8a-67bf-4bb5-af95-9704ce730b2d","timestamp":"2026-11-10T14:21:17.056Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2171335808/worktree/pose-mcp/internal/pose/index_federated_material.go","content":"\tRequiresPrimaryRevision   bool\n}\n\n// BuildIndexFederatedMaterialIn returns the specs, roadmaps, semantic\n// projections and exact foreign projects whose contents were resolved. The\n// Store must carry the operation's authorized resolver when one has already\n// been established; it is reused unchanged except for the captured Files the\n// operation view supplies.\nfunc BuildIndexFederatedMaterialIn(store Store) (IndexFederatedMaterial, error) {\n\tresolver := ArtifactResolver{}\n\tproject := store.FederatedProjectID\n\tif store.FederatedResolver != nil {\n\t\tresolver = *store.FederatedResolver\n\t\tif resolver.Roots == nil {\n\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: authorized project roots are unavailable for index material\")\n\t\t}\n\t} else {\n\t\tvar err error\n\t\tresolver, project, err = EnvironmentArtifactResolverIn(store.fsys(), store.Root, \"\")\n\t\tif err != nil {\n\t\t\treturn IndexFederatedMaterial{}, fmt.Errorf(\"pose: index material resolver: %w\", err)\n\t\t}\n\t}\n\tif project == \"\" {\n\t\tvar found, ambiguous, overflow bool\n\t\tproject, found, ambiguous, overflow = uniqueProjectIDForRootIn(store.fsys(), resolver.Roots, store.Root, resolver.Authorize)\n\t\tif overflow {\n\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material root identity exceeds the authorized-root snapshot budget\")\n\t\t}\n\t\tif ambiguous {\n\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material root has multiple authorized project identities\")\n\t\t}\n\t\tif !found {\n\t\t\tproject = DefaultProjectIDIn(store.fsys(), store.Root)\n\t\t\tif ValidateSlug(project) != nil || resolver.Authorize != nil && !resolver.Authorize(project) {\n\t\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material project identity is not authorized\")\n\t\t\t}\n\t\t\tbound, err := resolver.Roots.StoreFor(project)\n\t\t\tif err != nil || !sameProjectRoot(store.fsys(), bound.Root, store.Root) {\n\t\t\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material root is outside the authorized project registry\")\n\t\t\t}\n\t\t}\n\t}\n\tif ValidateSlug(project) != nil {\n\t\treturn IndexFederatedMaterial{}, errors.New(\"pose: index material project identity is unavailable\")\n\t}\n\n\t// Fresh for this build, never inherited from an earlier advisory operation.\n\tresolver = resolver.WithSpecSnapshots()\n\tspecs, err := store.ListSpecs(\"\", \"\")\n\tif err != nil && !errors.Is(err, fs.ErrNotExist) {\n\t\treturn IndexFederatedMaterial{}, fmt.Errorf(\"pose: listing specs for index material: %w\", err)\n\t}\n\troadmaps, err := store.ListRoadmaps()\n\tif err != nil {\n\t\treturn IndexFederatedMaterial{}, fmt.Errorf(\"pose: listing roadmaps for index material: %w\", err)\n\t}\n\tsort.Slice(specs, func(i, j int) bool { return specs[i].Slug < specs[j].Slug })\n\tsort.Slice(roadmaps, func(i, j int) bool { return roadmaps[i].Slug < roadmaps[j].Slug })\n\n\tmaterial := IndexFederatedMaterial{\n\t\tSpecs:                     specs,\n\t\tRoadmaps:                  roadmaps,\n\t\tSpecDependencyResolutions: make(map[string][]ArtifactResolution, len(specs)),\n\t\tRoadmapAcceptances:        make(map[string]FederatedRoadmapAcceptanceReport, len(roadmaps)),\n\t\tProjection: IndexFederatedMaterialProjection{\n\t\t\tSchemaVersion: 1,\n\t\t\tSpecs:         make([]IndexFederatedSpecMaterial, 0, len(specs)),\n\t\t\tRoadmaps:      make([]IndexFederatedRoadmapMaterial, 0, len(roadmaps)),\n\t\t},\n\t}\n\tprojects := map[string]bool{}\n\treferencedProjects := map[string]bool{}\n\taddProject := func(id string) {\n\t\tif id == \"\" || id == project {\n\t\t\treturn\n\t\t}\n\t\treferencedProjects[id] = true\n\t\tif resolver.Authorize != nil && !resolver.Authorize(id) {\n\t\t\treturn\n\t\t}\n\t\tif _, err := resolver.Roots.StoreFor(id); err == nil {\n\t\t\t// Include only foreign roots named by this semantic projection. A\n\t\t\t// project discovered for reading still has to pass the explicit-root\n\t\t\t// write guard before this generation can be published.\n\t\t\tprojects[id] = true\n\t\t}\n\t}\n\tfor _, spec := range specs {\n\t\tresolutions := make([]ArtifactResolution, 0, len(spec.DependsOn))","numLines":90,"startLine":50,"totalLines":250}},"tool_result_meta":[{"id":"toolu_01XCfSfFZp5UU1fr8Pr95HHX","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
