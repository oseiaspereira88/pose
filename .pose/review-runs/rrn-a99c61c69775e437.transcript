{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013YrNk3GJgJbUYjXQMD6VCa","type":"tool_result","content":"80\t}\n81\t\n82\tfunc viewDeliveryIntegrityGraphErr(owner string, raw []byte, fn func(DeliveryIntegrityGraph)) error {\n83\t\tsum := sha256.Sum256(raw)\n84\t\tkey := fmt.Sprintf(\"%s|%d|%x\", engineVersion, len(raw), sum)\n85\t\treturn deliveryGraphCache.View(context.Background(), owner, key, graphParseReserve(raw), func() (DeliveryIntegrityGraph, int64, error) {\n86\t\t\tparsed, ok := decodeDeliveryIntegrityIndex(raw)\n87\t\t\tif !ok {\n88\t\t\t\treturn DeliveryIntegrityGraph{}, 0, errInvalidDeliveryIndex\n89\t\t\t}\n90\t\t\treturn parsed, estimateGraphBytes(parsed), nil\n91\t\t}, fn)\n92\t}\n93\t\n94\t// ViewDeliveryIntegrity gives fn the delivery graph of the current index without a\n95\t// copy (spec pose-bounded-isolated-graph-caches R1). fn is read-only: it must not\n96\t// modify or retain the graph. The error is that of GetDeliveryIntegrity.\n97\tfunc (s Store) ViewDeliveryIntegrity(fn func(DeliveryIntegrityGraph)) error {\n98\t\traw, _, err := s.ReadIndex(\"delivery-integrity.json\")\n99\t\tif errors.Is(err, ErrIndexGenerationUnavailable) {\n100\t\t\treturn err\n101\t\t}\n102\t\tif err != nil {\n103\t\t\treturn fmt.Errorf(\"pose: delivery-integrity index not found; run `pose index`\")\n104\t\t}\n105\t\tif err := viewDeliveryIntegrityGraphErr(s.Root, raw, fn); err != nil {\n106\t\t\treturn deliveryIndexError(err)\n107\t\t}\n108\t\treturn nil\n109\t}\n110\t\n111\tvar errInvalidDeliveryIndex = errors.New(\"pose: invalid delivery-integrity index\")\n112\t\n113\t// deliveryIndexError names an overload as such and anything else as an invalid index.\n114\tfunc deliveryIndexError(err error) error {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"e393fbca-590a-47e1-85a8-81aed3b4ca46","timestamp":"2026-11-10T14:21:24.469Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2171335808/worktree/pose-mcp/internal/pose/delivery_integrity_cache.go","content":"}\n\nfunc viewDeliveryIntegrityGraphErr(owner string, raw []byte, fn func(DeliveryIntegrityGraph)) error {\n\tsum := sha256.Sum256(raw)\n\tkey := fmt.Sprintf(\"%s|%d|%x\", engineVersion, len(raw), sum)\n\treturn deliveryGraphCache.View(context.Background(), owner, key, graphParseReserve(raw), func() (DeliveryIntegrityGraph, int64, error) {\n\t\tparsed, ok := decodeDeliveryIntegrityIndex(raw)\n\t\tif !ok {\n\t\t\treturn DeliveryIntegrityGraph{}, 0, errInvalidDeliveryIndex\n\t\t}\n\t\treturn parsed, estimateGraphBytes(parsed), nil\n\t}, fn)\n}\n\n// ViewDeliveryIntegrity gives fn the delivery graph of the current index without a\n// copy (spec pose-bounded-isolated-graph-caches R1). fn is read-only: it must not\n// modify or retain the graph. The error is that of GetDeliveryIntegrity.\nfunc (s Store) ViewDeliveryIntegrity(fn func(DeliveryIntegrityGraph)) error {\n\traw, _, err := s.ReadIndex(\"delivery-integrity.json\")\n\tif errors.Is(err, ErrIndexGenerationUnavailable) {\n\t\treturn err\n\t}\n\tif err != nil {\n\t\treturn fmt.Errorf(\"pose: delivery-integrity index not found; run `pose index`\")\n\t}\n\tif err := viewDeliveryIntegrityGraphErr(s.Root, raw, fn); err != nil {\n\t\treturn deliveryIndexError(err)\n\t}\n\treturn nil\n}\n\nvar errInvalidDeliveryIndex = errors.New(\"pose: invalid delivery-integrity index\")\n\n// deliveryIndexError names an overload as such and anything else as an invalid index.\nfunc deliveryIndexError(err error) error {","numLines":35,"startLine":80,"totalLines":247}},"tool_result_meta":[{"id":"toolu_013YrNk3GJgJbUYjXQMD6VCa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
