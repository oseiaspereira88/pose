{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HfgzCg2y1oEobcAhrMzpbs","type":"tool_result","content":"diff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex e776a81a..9f51ade3 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2596,6 +2596,20 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"index-recovery-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\n+            \"test\",\n+            \"./internal/cli\",\n+            \"./internal/pose\",\n+            \"-run\",\n+            \"TestClosePlanModesOnANonSpecScope|TestIndexRepairsAnUnavailable|TestModuleDiscoveryDoesNotWalk|TestModuleDiscoveryNamesItsBound\",\n+            \"-count=1\"\n+          ],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"runtime-qos-integration\",\n           \"program\": \"go\",\ndiff --git a/pose-mcp/internal/cli/close_plan_nonspec_test.go b/pose-mcp/internal/cli/close_plan_nonspec_test.go\nnew file mode 100644\nindex 00000000..aaf42868\n--- /dev/null\n+++ b/pose-mcp/internal/cli/close_plan_nonspec_test.go\n@@ -0,0 +1,35 @@\n+package cli\n+\n+import (\n+\t\"bytes\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-index-recovery-and-close-scope-consistency.\n+\n+// R1: the plan modes of `pose close` are a spec's; for any other scope the refusal says so, says how\n+// that scope does close, and never proposes the invocation that was just refused.\n+func TestClosePlanModesOnANonSpecScopeNameTheRightInvocation(t *testing.T) {\n+\tfor _, tc := range []struct{ ref, kind string }{\n+\t\t{\"milestone:pose-shared-runtime/optional-worktree-runtime\", \"milestone\"},\n+\t\t{\"roadmap:pose-shared-runtime\", \"roadmap\"},\n+\t} {\n+\t\tfor _, mode := range []string{\"--plan\", \"--apply\", \"--resume\"} {\n+\t\t\tvar out, errb bytes.Buffer\n+\t\t\tcode := cmdClose(t.TempDir(), []string{tc.ref, mode}, &out, &errb)\n+\t\t\tmsg := errb.String() + out.String()\n+\t\t\tif code != 2 {\n+\t\t\t\tt.Errorf(\"%s %s exited %d, want the usage error 2: %s\", tc.ref, mode, code, msg)\n+\t\t\t}\n+\t\t\tfor _, want := range []string{mode + \" is the closeout plan of a spec\", \"a \" + tc.kind + \" scope closes with `pose close \" + tc.ref + \"`\", \"`pose closeout-check \" + tc.ref + \"`\"} {\n+\t\t\t\tif !strings.Contains(msg, want) {\n+\t\t\t\t\tt.Errorf(\"%s %s: the refusal lacks %q: %s\", tc.ref, mode, want, msg)\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif strings.Contains(msg, \"pose close \"+tc.ref+\" \"+mode) || strings.Contains(msg, \"use `pose close \"+tc.ref+\"` for\") {\n+\t\t\t\tt.Errorf(\"%s %s: the refusal proposes the invocation it refused: %s\", tc.ref, mode, msg)\n+\t\t\t}\n+\t\t}\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/closeout_plan.go b/pose-mcp/internal/cli/closeout_plan.go\nindex fe76cc1e..66b395b2 100644\n--- a/pose-mcp/internal/cli/closeout_plan.go\n+++ b/pose-mcp/internal/cli/closeout_plan.go\n@@ -67,6 +67,12 @@ func cmdClosePlan(root string, args []string, stdout, stderr io.Writer) int {\n \tif ref == \"\" || mode == \"\" {\n \t\treturn usageError(stderr, usage)\n \t}\n+\t// The plan modes are the closeout of a spec. Any other scope closes by the guarded\n+\t// transition, which takes no mode: say so before anything is read, instead of pointing at\n+\t// the invocation that was just refused.\n+\tif scope, perr := posemodel.ParseScopeRef(ref); perr == nil && scope.Kind != \"spec\" {\n+\t\treturn refuse(\"--\" + mode + \" is the closeout plan of a spec; a \" + scope.Kind + \" scope closes with `pose close \" + ref + \"` and no --plan, --apply or --resume (it verifies the gate and names the next closeout), and is read with `pose closeout-check \" + ref + \"`\")\n+\t}\n \tif mode == \"plan\" && (digest != \"\" || reviewer != \"\" || skipEvidence) {\n \t\treturn refuse(\"--digest, --reviewer and --skip-evidence are taken only by --apply and --resume\")\n \t}\ndiff --git a/pose-mcp/internal/cli/index_generation_test.go b/pose-mcp/internal/cli/index_generation_test.go\nindex b44a95d1..1326d2b4 100644\n--- a/pose-mcp/internal/cli/index_generation_test.go\n+++ b/pose-mcp/internal/cli/index_generation_test.go\n@@ -322,3 +322,51 @@ func TestRefreshDeliveryIndexNamesACommittedGenerationWhoseDurabilityIsUnconfirm\n \t\tt.Fatalf(\"the refresh denied or hid its committed effect: %q\", errOut.String())\n \t}\n }\n+\n+// Spec pose-index-recovery-and-close-scope-consistency R1: a set whose published generation is\n+// unavailable (the legacy copy of an index no longer matches the descriptor, and the generation\n+// directory, which a checkout does not carry, is gone) is read as unavailable by every reader and\n+// by --verify, and `pose index` repairs it: the indexes are derived, and the command the readers\n+// name as the remedy has to be able to run.\n+func TestIndexRepairsAnUnavailableGenerationThatItsReadersTellYouToRun(t *testing.T) {\n+\troot, _, _ := artifactGitFixture(t)\n+\tif code, _, errOut := runIndex(t, root); code != 0 {\n+\t\tt.Fatalf(\"index: %d %s\", code, errOut)\n+\t}\n+\tbefore := string(indexBytes(t, root, \"generation.json\"))\n+\tif err := os.RemoveAll(filepath.Join(root, \".pose\", \"indexes\", \"generations\")); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.WriteFile(filepath.Join(root, \".pose\", \"indexes\", \"spec-graph.json\"), []byte(\"{\\\"edited\\\":true}\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tstore := posemodel.Store{Root: root}\n+\tif view := store.ReadIndexGeneration(); view.Status != posemodel.IndexGenerationUnavailable {\n+\t\tt.Fatalf(\"the set is %s, the test needs it unavailable\", view.Status)\n+\t}\n+\tif code, _, errOut := runIndex(t, root, \"--verify\"); code == 0 || !strings.Contains(errOut, \"unavailable\") {\n+\t\tt.Fatalf(\"verify of an unavailable set: code=%d err=%s\", code, errOut)\n+\t}\n+\t// A reader names `pose index` as the remedy ...\n+\tif _, _, err := store.ReadIndex(\"spec-graph.json\"); err == nil || !strings.Contains(err.Error(), \"pose index\") {\n+\t\tt.Fatalf(\"a reader of the unavailable set does not name the remedy: %v\", err)\n+\t}\n+\t// ... and the remedy works.\n+\tcode, out, errOut := runIndex(t, root)\n+\tif code != 0 {\n+\t\tt.Fatalf(\"pose index over an unavailable generation exited %d: %s %s\", code, out, errOut)\n+\t}\n+\tif view := store.ReadIndexGeneration(); view.Status != posemodel.IndexGenerationCurrent {\n+\t\tt.Fatalf(\"after the repair the set is %s: %s\", view.Status, view.Reason)\n+\t}\n+\tif strings.Contains(string(indexBytes(t, root, \"spec-graph.json\")), \"edited\") {\n+\t\tt.Fatal(\"the repaired set kept the edited file\")\n+\t}\n+\tif code, _, errOut := runIndex(t, root, \"--verify\"); code != 0 {\n+\t\tt.Fatalf(\"verify after the repair: %d %s\", code, errOut)\n+\t}\n+\t// The same inputs name the same generation: the repair returns the set to what it was.\n+\tif string(indexBytes(t, root, \"generation.json\")) != before {\n+\t\tt.Fatal(\"the repair named another generation for the same inputs\")\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/closeout_plan.go b/pose-mcp/internal/pose/closeout_plan.go\nindex c91c6aba..72cc1ead 100644\n--- a/pose-mcp/internal/pose/closeout_plan.go\n+++ b/pose-mcp/internal/pose/closeout_plan.go\n@@ -128,7 +128,7 @@ func (s Store) planCloseout(ref string) (CloseoutPlan, error) {\n \t\treturn CloseoutPlan{}, err\n \t}\n \tif scope.Kind != \"spec\" {\n-\t\treturn CloseoutPlan{}, fmt.Errorf(\"pose: the closeout plan covers spec scopes; use `pose close %s` for %s scopes\", ref, scope.Kind)\n+\t\treturn CloseoutPlan{}, fmt.Errorf(\"pose: the closeout plan (--plan, --apply, --resume) covers spec scopes; a %s scope closes with `pose close %s` and none of those flags, and is read with `pose closeout-check %s`\", scope.Kind, ref, ref)\n \t}\n \tspec, err := s.GetSpec(scope.Slug)\n \tif err != nil {\ndiff --git a/pose-mcp/internal/pose/governance_read_view.go b/pose-mcp/internal/pose/governance_read_view.go\nindex b6076400..5d9f6e5d 100644\n--- a/pose-mcp/internal/pose/governance_read_view.go\n+++ b/pose-mcp/internal/pose/governance_read_view.go\n@@ -92,23 +92,27 @@ type governanceReadViewOperation struct {\n \trootProjectByPath                 map[string]string\n \trootRegistryID                    string\n \tallowMissingPrimarySourceRevision bool\n-\tcurrentRoots                      func() (map[string]string, map[string]bool, bool)\n-\tresolver                          ArtifactResolver\n-\tbaseStore                         Store\n-\tmainProject                       string\n-\tindexPins                         map[string]*IndexGenerationView\n-\tindexInputChecks                  map[string]*governanceReadViewIndexInputCheck\n-\tunknown                           map[string]map[string]bool\n-\trootOverflow                      bool\n-\tregistryOverflow                  bool\n-\tfinalAudits                       map[*governanceReadView]governanceReadViewAudit\n-\tbudgetMu                          sync.Mutex\n-\tinputBytes                        int64\n-\tmetadataBytes                     int64\n-\trecords                           int\n-\tdirectoryEntries                  int\n-\tgit                               *governanceReadViewGitState\n-\tmu                                sync.Mutex\n+\t// rebuildsIndex is set for the one operation that computes the index set from its sources:\n+\t// it reads nothing from the published generation, so a generation that is unavailable\n+\t// does not make its closure unknown (spec pose-index-recovery-and-close-scope-consistency).\n+\trebuildsIndex    bool\n+\tcurrentRoots     func() (map[string]string, map[string]bool, bool)\n+\tresolver         ArtifactResolver\n+\tbaseStore        Store\n+\tmainProject      string\n+\tindexPins        map[string]*IndexGenerationView\n+\tindexInputChecks map[string]*governanceReadViewIndexInputCheck\n+\tunknown          map[string]map[string]bool\n+\trootOverflow     bool\n+\tregistryOverflow bool\n+\tfinalAudits      map[*governanceReadView]governanceReadViewAudit\n+\tbudgetMu         sync.Mutex\n+\tinputBytes       int64\n+\tmetadataBytes    int64\n+\trecords          int\n+\tdirectoryEntries int\n+\tgit              *governanceReadViewGitState\n+\tmu               sync.Mutex\n }\n \n type governanceReadViewIndexInputCheck struct {\n@@ -304,7 +308,9 @@ func (op *governanceReadViewOperation) route(name, producer, project string) *go\n \t\t\tentry.indexGeneration = slot.Descriptor.GenerationID\n \t\tcase IndexGenerationUnavailable:\n \t\t\tentry.indexGeneration = \"unknown\"\n-\t\t\tview.markUnknown(producer, \"index generation could not be pinned: \"+slot.Reason)\n+\t\t\tif !op.rebuildsIndex {\n+\t\t\t\tview.markUnknown(producer, \"index generation could not be pinned: \"+slot.Reason)\n+\t\t\t}\n \t\t}\n \t}\n \tif err := op.adoptCapturedView(view); err != nil {\n@@ -883,6 +889,7 @@ func (s Store) beginGovernanceReadView(allowMissingPrimaryRevision ...bool) (Sto\n \top := &governanceReadViewOperation{\n \t\tprimary: primary, resolver: resolver, baseStore: base, mainProject: project,\n \t\tallowMissingPrimarySourceRevision: len(allowMissingPrimaryRevision) > 0 && allowMissingPrimaryRevision[0],\n+\t\trebuildsIndex:                     len(allowMissingPrimaryRevision) > 0 && allowMissingPrimaryRevision[0],\n \t\tindexPins:                         map[string]*IndexGenerationView{}, indexInputChecks: map[string]*governanceReadViewIndexInputCheck{}, unknown: map[string]map[string]bool{},\n \t}\n \top.git = newGovernanceReadViewGitState(op)\n@@ -1040,7 +1047,9 @@ func (op *governanceReadViewOperation) recordIndexPin(root string, pin *IndexGen\n \t\t\tentry.indexGeneration = pin.Descriptor.GenerationID\n \t\tcase IndexGenerationUnavailable:\n \t\t\tentry.indexGeneration = \"unknown\"\n-\t\t\tentry.view.markUnknown(\"projection\", \"index generation could not be pinned: \"+pin.Reason)\n+\t\t\tif !op.rebuildsIndex {\n+\t\t\t\tentry.view.markUnknown(\"projection\", \"index generation could not be pinned: \"+pin.Reason)\n+\t\t\t}\n \t\t}\n \t}\n }\ndiff --git a/pose-mcp/internal/pose/module_discovery.go b/pose-mcp/internal/pose/module_discovery.go\nindex c3fb9953..7a455d00 100644\n--- a/pose-mcp/internal/pose/module_discovery.go\n+++ b/pose-mcp/internal/pose/module_discovery.go\n@@ -71,7 +71,11 @@ func ScanModuleDiscoveryIn(files Files, root string) (ModuleDiscoveryInventory,\n \t\treturn ModuleDiscoveryInventory{}, fmt.Errorf(\"pose: module discovery ignore inventory: %w\", err)\n \t}\n \tstaticIgnored := map[string]bool{\n-\t\t\".git\": true, \".qwen\": true, \"node_modules\": true, \".gradle\": true,\n+\t\t// .pose is the governance record (specs, review bundles and attestations, results): it\n+\t\t// holds no module, and it grows with every closeout, so counting it against the bound of\n+\t\t// the walk would stop an instance from ever refreshing its indexes once it is large (spec\n+\t\t// pose-index-recovery-and-close-scope-consistency).\n+\t\t\".git\": true, \".pose\": true, \".qwen\": true, \"node_modules\": true, \".gradle\": true,\n \t\t\"build\": true, \"dist\": true, \"target\": true, \"vendor\": true,\n \t\t\"__pycache__\": true, \"testdata\": true, \"fixture\": true, \"fixtures\": true,\n \t}\n@@ -96,7 +100,7 @@ func ScanModuleDiscoveryIn(files Files, root string) (ModuleDiscoveryInventory,\n \t\tvisitedEntries++\n \t\ttraversalBytes += len(filepath.ToSlash(path)) + len(entry.Name())*2 + len(fmt.Sprintf(\"%o\", entry.Type())) + 128\n \t\tif visitedEntries > moduleDiscoveryMaxEntries || traversalBytes > moduleDiscoveryMaxBytes {\n-\t\t\treturn errGovernanceReadViewBudget\n+\t\t\treturn fmt.Errorf(\"%w: module discovery visited more than %d entries or %d bytes of paths; ignore generated or vendored directories in .gitignore\", errGovernanceReadViewBudget, moduleDiscoveryMaxEntries, moduleDiscoveryMaxBytes)\n \t\t}\n \t\tif entry.IsDir() {\n \t\t\tif path != root && (staticIgnored[entry.Name()] || strings.HasPrefix(entry.Name(), \".venv\")) {\ndiff --git a/pose-mcp/internal/pose/module_discovery_governance_record_test.go b/pose-mcp/internal/pose/module_discovery_governance_record_test.go\nnew file mode 100644\nindex 00000000..7cbc8224\n--- /dev/null\n+++ b/pose-mcp/internal/pose/module_discovery_governance_record_test.go\n@@ -0,0 +1,67 @@\n+package pose\n+\n+import (\n+\t\"fmt\"\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-index-recovery-and-close-scope-consistency.\n+\n+// R1: the governance record under .pose, at the root and inside a submodule or nested project, is\n+// not walked: it cannot make the walk exceed its bound, and it adds no module, README or file to\n+// the inventory, however many records it holds.\n+func TestModuleDiscoveryDoesNotWalkTheGovernanceRecord(t *testing.T) {\n+\troot := snapshotRepo(t, map[string]string{\"service/go.mod\": \"module example.test/service\\n\", \"README.md\": \"# project\\n\"})\n+\tfor _, dir := range []string{\".pose\", \"nested/.pose\"} {\n+\t\trecords := filepath.Join(root, dir, \"review-bundles\")\n+\t\tif err := os.MkdirAll(records, 0o755); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tfor i := 0; i < moduleDiscoveryMaxEntries/2+200; i++ {\n+\t\t\tif err := os.WriteFile(filepath.Join(records, fmt.Sprintf(\"rvb-%05d.json\", i)), []byte(\"{}\"), 0o644); err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t}\n+\t\tif err := os.WriteFile(filepath.Join(root, dir, \"README.md\"), []byte(\"# governance\\n\"), 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\tinventory, err := ScanModuleDiscoveryIn(NativeFiles(), root)\n+\tif err != nil {\n+\t\tt.Fatalf(\"a large governance record stopped the module discovery: %v\", err)\n+\t}\n+\tvar paths []string\n+\tfor _, m := range inventory.Manifests {\n+\t\tpaths = append(paths, m.Path)\n+\t}\n+\tif len(paths) != 1 || paths[0] != \"service/go.mod\" {\n+\t\tt.Fatalf(\"manifests = %v, want the service's go.mod alone\", paths)\n+\t}\n+\tfor _, readme := range inventory.Readmes {\n+\t\tif strings.Contains(readme, \".pose\") {\n+\t\t\tt.Fatalf(\"a README of the governance record is an inventory entry: %v\", inventory.Readmes)\n+\t\t}\n+\t}\n+}\n+\n+// R2: when the bound is exceeded by what is not governance record, the failure says what was\n+// counted and what to do, instead of the bare name of the budget.\n+func TestModuleDiscoveryNamesItsBoundWhenItIsExceeded(t *testing.T) {\n+\troot := snapshotRepo(t, map[string]string{\"service/go.mod\": \"module example.test/service\\n\"})\n+\tdir := filepath.Join(root, \"generated\")\n+\tif err := os.MkdirAll(dir, 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor i := 0; i < moduleDiscoveryMaxEntries+100; i++ {\n+\t\tif err := os.WriteFile(filepath.Join(dir, fmt.Sprintf(\"f%05d.txt\", i)), nil, 0o644); err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t}\n+\t_, err := ScanModuleDiscoveryIn(NativeFiles(), root)\n+\tif err == nil || !strings.Contains(err.Error(), \"module discovery visited more than\") || !strings.Contains(err.Error(), \".gitignore\") {\n+\t\tt.Fatalf(\"the bound is not named: %v\", err)\n+\t}\n+}","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"19ab0600-2a86-4202-b43a-7abb3a8e715e","timestamp":"2026-11-10T14:20:46.197Z","tool_use_result":{"stdout":"diff --git a/.pose/indexes/validation-matrix.json b/.pose/indexes/validation-matrix.json\nindex e776a81a..9f51ade3 100644\n--- a/.pose/indexes/validation-matrix.json\n+++ b/.pose/indexes/validation-matrix.json\n@@ -2596,6 +2596,20 @@\n           \"severity\": \"required\",\n           \"evidenceClass\": \"integration\"\n         },\n+        {\n+          \"name\": \"index-recovery-integration\",\n+          \"program\": \"go\",\n+          \"args\": [\n+            \"test\",\n+            \"./internal/cli\",\n+            \"./internal/pose\",\n+            \"-run\",\n+            \"TestClosePlanModesOnANonSpecScope|TestIndexRepairsAnUnavailable|TestModuleDiscoveryDoesNotWalk|TestModuleDiscoveryNamesItsBound\",\n+            \"-count=1\"\n+          ],\n+          \"severity\": \"required\",\n+          \"evidenceClass\": \"integration\"\n+        },\n         {\n           \"name\": \"runtime-qos-integration\",\n           \"program\": \"go\",\ndiff --git a/pose-mcp/internal/cli/close_plan_nonspec_test.go b/pose-mcp/internal/cli/close_plan_nonspec_test.go\nnew file mode 100644\nindex 00000000..aaf42868\n--- /dev/null\n+++ b/pose-mcp/internal/cli/close_plan_nonspec_test.go\n@@ -0,0 +1,35 @@\n+package cli\n+\n+import (\n+\t\"bytes\"\n+\t\"strings\"\n+\t\"testing\"\n+)\n+\n+// Spec pose-index-recovery-and-close-scope-consistency.\n+\n+// R1: the plan modes of `pose close` are a spec's; for any other scope the refusal says so, says how\n+// that scope does close, and never proposes the invocation that was just refused.\n+func TestClosePlanModesOnANonSpecScopeNameTheRightInvocation(t *testing.T) {\n+\tfor _, tc := range []struct{ ref, kind string }{\n+\t\t{\"milestone:pose-shared-runtime/optional-worktree-runtime\", \"milestone\"},\n+\t\t{\"roadmap:pose-shared-runtime\", \"roadmap\"},\n+\t} {\n+\t\tfor _, mode := range []string{\"--plan\", \"--apply\", \"--resume\"} {\n+\t\t\tvar out, errb bytes.Buffer\n+\t\t\tcode := cmdClose(t.TempDir(), []string{tc.ref, mode}, &out, &errb)\n+\t\t\tmsg := errb.String() + out.String()\n+\t\t\tif code != 2 {\n+\t\t\t\tt.Errorf(\"%s %s exited %d, want the usage error 2: %s\", tc.ref, mode, code, msg)\n+\t\t\t}\n+\t\t\tfor _, want := range []string{mode + \" is the closeout plan of a spec\", \"a \" + tc.kind + \" scope closes with `pose close \" + tc.ref + \"`\", \"`pose closeout-check \" + tc.ref + \"`\"} {\n+\t\t\t\tif !strings.Contains(msg, want) {\n+\t\t\t\t\tt.Errorf(\"%s %s: the refusal lacks %q: %s\", tc.ref, mode, want, msg)\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tif strings.Contains(msg, \"pose close \"+tc.ref+\" \"+mode) || strings.Contains(msg, \"use `pose close \"+tc.ref+\"` for\") {\n+\t\t\t\tt.Errorf(\"%s %s: the refusal proposes the invocation it refused: %s\", tc.ref, mode, msg)\n+\t\t\t}\n+\t\t}\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/closeout_plan.go b/pose-mcp/internal/cli/closeout_plan.go\nindex fe76cc1e..66b395b2 100644\n--- a/pose-mcp/internal/cli/closeout_plan.go\n+++ b/pose-mcp/internal/cli/closeout_plan.go\n@@ -67,6 +67,12 @@ func cmdClosePlan(root string, args []string, stdout, stderr io.Writer) int {\n \tif ref == \"\" || mode == \"\" {\n \t\treturn usageError(stderr, usage)\n \t}\n+\t// The plan modes are the closeout of a spec. Any other scope closes by the guarded\n+\t// transition, which takes no mode: say so before anything is read, instead of pointing at\n+\t// the invocation that was just refused.\n+\tif scope, perr := posemodel.ParseScopeRef(ref); perr == nil && scope.Kind != \"spec\" {\n+\t\treturn refuse(\"--\" + mode + \" is the closeout plan of a spec; a \" + scope.Kind + \" scope closes with `pose close \" + ref + \"` and no --plan, --apply or --resume (it verifies the gate and names the next closeout), and is read with `pose closeout-check \" + ref + \"`\")\n+\t}\n \tif mode == \"plan\" && (digest != \"\" || reviewer != \"\" || skipEvidence) {\n \t\treturn refuse(\"--digest, --reviewer and --skip-evidence are taken only by --apply and --resume\")\n \t}\ndiff --git a/pose-mcp/internal/cli/index_generation_test.go b/pose-mcp/internal/cli/index_generation_test.go\nindex b44a95d1..1326d2b4 100644\n--- a/pose-mcp/internal/cli/index_generation_test.go\n+++ b/pose-mcp/internal/cli/index_generation_test.go\n@@ -322,3 +322,51 @@ func TestRefreshDeliveryIndexNamesACommittedGenerationWhoseDurabilityIsUnconfirm\n \t\tt.Fatalf(\"the refresh denied or hid its committed effect: %q\", errOut.String())\n \t}\n }\n+\n+// Spec pose-index-recovery-and-close-scope-consistency R1: a set whose published generation is\n+// unavailable (the legacy copy of an index no longer matches the descriptor, and the generation\n+// directory, which a checkout does not carry, is gone) is read as unavailable by every reader and\n+// by --verify, and `pose index` repairs it: the indexes are derived, and the command the readers\n+// name as the remedy has to be able to run.\n+func TestIndexRepairsAnUnavailableGenerationThatItsReadersTellYouToRun(t *testing.T) {\n+\troot, _, _ := artifactGitFixture(t)\n+\tif code, _, errOut := runIndex(t, root); code != 0 {\n+\t\tt.Fatalf(\"index: %d %s\", code, errOut)\n+\t}\n+\tbefore := string(indexBytes(t, root, \"generation.json\"))\n+\tif err := os.RemoveAll(filepath.Join(root, \".pose\", \"indexes\", \"generations\")); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.WriteFile(filepath.Join(root, \".pose\", \"indexes\", \"spec-graph.json\"), []byte(\"{\\\"edited\\\":true}\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tstore := posemodel.Store{Root: root}\n+\tif view := store.ReadIndexGeneration(); view.Status != posemodel.IndexGenerationUnavailable {\n+\t\tt.Fatalf(\"the set is %s, the test needs it unavailable\", view.Status)\n+\t}\n+\tif code, _, errOut := runIndex(t, root, \"--verify\"); code == 0 || !strings.Contains(errOut, \"unavailable\") {\n+\t\tt.Fatalf(\"verify of an unavailable set: code=%d err=%s\", code, errOut)\n+\t}\n+\t// A reader names `pose index` as the remedy ...\n+\tif _, _, err := store.ReadIndex(\"spec-graph.json\"); err == nil || !strings.Contains(err.Error(), \"pose index\") {\n+\t\tt.Fatalf(\"a reader of the unavailable set does not name the remedy: %v\", err)\n+\t}\n+\t// ... and the remedy works.\n+\tcode, out, errOut := runIndex(t, root)\n+\tif code != 0 {\n+\t\tt.Fatalf(\"pose index over an unavailable generation exited %d: %s %s\", code, out, errOut)\n+\t}\n+\tif view := store.ReadIndexGeneration(); view.Status != posemodel.IndexGenerationCurrent {\n+\t\tt.Fatalf(\"after the repair the set is %s: %s\", view.Status, view.Reason)\n+\t}\n+\tif strings.Contains(string(indexBytes(t, root, \"spec-graph.json\")), \"edited\") {\n+\t\tt.Fatal(\"the repaired set kept the edited file\")\n+\t}\n+\tif code, _, errOut := runIndex(t, root, \"--verify\"); code != 0 {\n+\t\tt.Fatalf(\"verify after the repair: %d %s\", code, errOut)\n+\t}\n+\t// The same inputs name the same generation: the repair returns the set to what it was.\n+\tif string(indexBytes(t, root, \"generation.json\")) != before {\n+\t\tt.Fatal(\"the repair named another generation for the same inputs\")\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/closeout_plan.go b/pose-mcp/internal/pose/closeout_plan.go\nindex c91c6aba..72cc1ead 100644\n--- a/pose-mcp/internal/pose/closeout_plan.go\n+++ b/pose-mcp/internal/pose/closeout_plan.go\n@@ -128,7 +128,7 @@ func (s Store) planCloseout(ref string) (CloseoutPlan, error) {\n \t\treturn CloseoutPlan{}, err\n \t}\n \tif scope.Kind != \"spec\" {\n-\t\treturn CloseoutPlan{}, fmt.Errorf(\"pose: the closeout plan covers spec scopes; use `pose close %s` for %s scopes\", ref, scope.Kind)\n+\t\treturn CloseoutPlan{}, fmt.Errorf(\"pose: the closeout plan (--plan, --apply, --resume) covers spec scopes; a %s scope closes with `pose close %s` and none of those flags, and is read with `pose closeout-check %s`\", scope.Kind, ref, ref)\n \t}\n \tspec, err := s.GetSpec(scope.Slug)\n \tif err != nil {\ndiff --git a/pose-mcp/internal/pose/governance_read_view.go b/pose-mcp/internal/pose/governance_read_view.go\nindex b6076400..5d9f6e5d 100644\n--- a/pose-mcp/internal/pose/governance_read_view.go\n+++ b/pose-mcp/internal/pose/governance_read_view.go\n@@ -92,23 +92,27 @@ type governanceReadViewOperation struct {\n \trootProjectByPath                 map[string]string\n \trootRegistryID                    string\n \tallowMissingPrimarySourceRevision bool\n-\tcurrentRoots                      func() (map[string]string, map[string]bool, bool)\n-\tresolver             