{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MCkgMjYnHJzCzPrrMSKgmr","type":"tool_result","content":"20\t// pose-recoverable-closeout-plan): the closeout as an ordered, recoverable\n21\t// plan. --plan previews; --apply runs every mechanical step in order and stops\n22\t// at the first one that needs a person (a judgment criterion) or fails;\n23\t// --resume is --apply after an interruption — the plan is recomputed from the\n24\t// repository, so done steps are not repeated.\n25\t//\n26\t// Apply and resume build one posemodel.OperationResult (spec\n27\t// pose-cli-mcp-operation-results); --json writes it as the only document on\n28\t// stdout and the human renderer reads the same value.\n29\tfunc cmdClosePlan(root string, args []string, stdout, stderr io.Writer) int {\n30\t\tconst usage = \"Usage: pose close spec:<slug> --plan [--json] | --apply|--resume [--digest <plan digest>] [--reviewer agent:<id>] [--skip-evidence] [--json]\"\n31\t\tref, mode, digest, reviewer, jsonOutput, skipEvidence := \"\", \"\", \"\", \"\", false, false\n32\t\trefuse := func(reason string) int {\n33\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + reason)\n34\t\t\treturn usageError(stderr, usage)\n35\t\t}\n36\t\tfor i := 0; i < len(args); i++ {\n37\t\t\tswitch args[i] {\n38\t\t\tcase \"--plan\", \"--apply\", \"--resume\":\n39\t\t\t\t// One mode per call: a second, different mode is refused rather\n40\t\t\t\t// than resolved by its position (R3).\n41\t\t\t\tnext := strings.TrimPrefix(args[i], \"--\")\n42\t\t\t\tif mode != \"\" && mode != next {\n43\t\t\t\t\treturn refuse(\"--\" + mode + \" and --\" + next + \" are exclusive modes\")\n44\t\t\t\t}\n45\t\t\t\tmode = next\n46\t\t\tcase \"--json\":\n47\t\t\t\tjsonOutput = true\n48\t\t\tcase \"--skip-evidence\":\n49\t\t\t\tskipEvidence = true\n50\t\t\tcase \"--digest\", \"--reviewer\":\n51\t\t\t\tif i+1 >= len(args) || strings.HasPrefix(args[i+1], \"-\") {\n52\t\t\t\t\treturn refuse(args[i] + \" needs a value\")\n53\t\t\t\t}\n54\t\t\t\ti++\n55\t\t\t\tif args[i-1] == \"--digest\" {\n56\t\t\t\t\tdigest = args[i]\n57\t\t\t\t} else {\n58\t\t\t\t\treviewer = args[i]\n59\t\t\t\t}\n60\t\t\tdefault:\n61\t\t\t\tif strings.HasPrefix(args[i], \"-\") || ref != \"\" {\n62\t\t\t\t\treturn usageError(stderr, usage)\n63\t\t\t\t}\n64\t\t\t\tref = args[i]\n65\t\t\t}\n66\t\t}\n67\t\tif ref == \"\" || mode == \"\" {\n68\t\t\treturn usageError(stderr, usage)\n69\t\t}\n70\t\t// The plan modes are the closeout of a spec. Any other scope closes by the guarded\n71\t\t// transition, which takes no mode: say so before anything is read, instead of pointing at\n72\t\t// the invocation that was just refused.\n73\t\tif scope, perr := posemodel.ParseScopeRef(ref); perr == nil && scope.Kind != \"spec\" {\n74\t\t\treturn refuse(\"--\" + mode + \" is the closeout plan of a spec; a \" + scope.Kind + \" scope closes with `pose close \" + ref + \"` and no --plan, --apply or --resume (it verifies the gate and names the next closeout), and is read with `pose closeout-check \" + ref + \"`\")\n75\t\t}\n76\t\tif mode == \"plan\" && (digest != \"\" || reviewer != \"\" || skipEvidence) {\n77\t\t\treturn refuse(\"--digest, --reviewer and --skip-evidence are taken only by --apply and --resume\")\n78\t\t}\n79\t\tstore := cliGovernedStore(root)\n80\t\tout := render(stdout, stderr)\n81\t\tif mode == \"plan\" {\n82\t\t\tplan, err := store.PlanCloseout(ref)\n83\t\t\tif err != nil && jsonOutput {\n84\t\t\t\treturn writeOperationFailure(stdout, stderr, \"close.plan\", ref, \"plan-unavailable\", \"pose close: \"+err.Error())\n85\t\t\t}\n86\t\t\tif err != nil {\n87\t\t\t\tout.Failure(\"pose close: \" + err.Error())\n88\t\t\t\treturn 1\n89\t\t\t}\n90\t\t\tread := store.InspectCloseoutCheckpoint(ref)\n91\t\t\tif read.State != posemodel.CheckpointAbsent {\n92\t\t\t\tplan.Checkpoint = &read\n93\t\t\t}\n94\t\t\tif jsonOutput {\n95\t\t\t\treturn writeJSON(stdout, plan)\n96\t\t\t}\n97\t\t\trenderCloseoutPlan(out, plan)\n98\t\t\tswitch read.State {\n99\t\t\tcase posemodel.CheckpointAbsent:"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"58792177-17f9-47c9-82bc-b40ec623446a","timestamp":"2026-11-10T14:21:37.462Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2171335808/worktree/pose-mcp/internal/cli/closeout_plan.go","content":"// pose-recoverable-closeout-plan): the closeout as an ordered, recoverable\n// plan. --plan previews; --apply runs every mechanical step in order and stops\n// at the first one that needs a person (a judgment criterion) or fails;\n// --resume is --apply after an interruption — the plan is recomputed from the\n// repository, so done steps are not repeated.\n//\n// Apply and resume build one posemodel.OperationResult (spec\n// pose-cli-mcp-operation-results); --json writes it as the only document on\n// stdout and the human renderer reads the same value.\nfunc cmdClosePlan(root string, args []string, stdout, stderr io.Writer) int {\n\tconst usage = \"Usage: pose close spec:<slug> --plan [--json] | --apply|--resume [--digest <plan digest>] [--reviewer agent:<id>] [--skip-evidence] [--json]\"\n\tref, mode, digest, reviewer, jsonOutput, skipEvidence := \"\", \"\", \"\", \"\", false, false\n\trefuse := func(reason string) int {\n\t\trender(io.Discard, stderr).Failure(\"pose close: \" + reason)\n\t\treturn usageError(stderr, usage)\n\t}\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch args[i] {\n\t\tcase \"--plan\", \"--apply\", \"--resume\":\n\t\t\t// One mode per call: a second, different mode is refused rather\n\t\t\t// than resolved by its position (R3).\n\t\t\tnext := strings.TrimPrefix(args[i], \"--\")\n\t\t\tif mode != \"\" && mode != next {\n\t\t\t\treturn refuse(\"--\" + mode + \" and --\" + next + \" are exclusive modes\")\n\t\t\t}\n\t\t\tmode = next\n\t\tcase \"--json\":\n\t\t\tjsonOutput = true\n\t\tcase \"--skip-evidence\":\n\t\t\tskipEvidence = true\n\t\tcase \"--digest\", \"--reviewer\":\n\t\t\tif i+1 >= len(args) || strings.HasPrefix(args[i+1], \"-\") {\n\t\t\t\treturn refuse(args[i] + \" needs a value\")\n\t\t\t}\n\t\t\ti++\n\t\t\tif args[i-1] == \"--digest\" {\n\t\t\t\tdigest = args[i]\n\t\t\t} else {\n\t\t\t\treviewer = args[i]\n\t\t\t}\n\t\tdefault:\n\t\t\tif strings.HasPrefix(args[i], \"-\") || ref != \"\" {\n\t\t\t\treturn usageError(stderr, usage)\n\t\t\t}\n\t\t\tref = args[i]\n\t\t}\n\t}\n\tif ref == \"\" || mode == \"\" {\n\t\treturn usageError(stderr, usage)\n\t}\n\t// The plan modes are the closeout of a spec. Any other scope closes by the guarded\n\t// transition, which takes no mode: say so before anything is read, instead of pointing at\n\t// the invocation that was just refused.\n\tif scope, perr := posemodel.ParseScopeRef(ref); perr == nil && scope.Kind != \"spec\" {\n\t\treturn refuse(\"--\" + mode + \" is the closeout plan of a spec; a \" + scope.Kind + \" scope closes with `pose close \" + ref + \"` and no --plan, --apply or --resume (it verifies the gate and names the next closeout), and is read with `pose closeout-check \" + ref + \"`\")\n\t}\n\tif mode == \"plan\" && (digest != \"\" || reviewer != \"\" || skipEvidence) {\n\t\treturn refuse(\"--digest, --reviewer and --skip-evidence are taken only by --apply and --resume\")\n\t}\n\tstore := cliGovernedStore(root)\n\tout := render(stdout, stderr)\n\tif mode == \"plan\" {\n\t\tplan, err := store.PlanCloseout(ref)\n\t\tif err != nil && jsonOutput {\n\t\t\treturn writeOperationFailure(stdout, stderr, \"close.plan\", ref, \"plan-unavailable\", \"pose close: \"+err.Error())\n\t\t}\n\t\tif err != nil {\n\t\t\tout.Failure(\"pose close: \" + err.Error())\n\t\t\treturn 1\n\t\t}\n\t\tread := store.InspectCloseoutCheckpoint(ref)\n\t\tif read.State != posemodel.CheckpointAbsent {\n\t\t\tplan.Checkpoint = &read\n\t\t}\n\t\tif jsonOutput {\n\t\t\treturn writeJSON(stdout, plan)\n\t\t}\n\t\trenderCloseoutPlan(out, plan)\n\t\tswitch read.State {\n\t\tcase posemodel.CheckpointAbsent:","numLines":80,"startLine":20,"totalLines":761}},"tool_result_meta":[{"id":"toolu_01MCkgMjYnHJzCzPrrMSKgmr","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
