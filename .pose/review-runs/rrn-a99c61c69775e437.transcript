\"state\": \"active\",\n46\t        \"relations\": [\n47\t          \"R2\"\n48\t        ]\n49\t      },\n50\t      {\n51\t        \"id\": \"D2\",\n52\t        \"kind\": \"decision\",\n53\t        \"namespace\": \"spec:pose-index-recovery-and-close-scope-consistency\",\n54\t        \"hash\": \"c88ccddbdc41\",\n55\t        \"state\": \"active\",\n56\t        \"relations\": [\n57\t          \"R3\"\n58\t        ]\n59\t      }\n60\t    ],\n61\t    \"digest\": \"sha256:53fb4c276cbb87d37a823ebbd30b41a5e4d811ec16f31d02f6bde4cd7f7aa829\"\n62\t  },\n63\t  \"phase\": \"started\",\n64\t  \"recorded_at\": \"2026-11-10T14:07:59Z\"\n65\t}\n66\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"a5968775-5179-465f-a71b-8f5b42687240","timestamp":"2026-11-10T14:24:03.542Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-2171335808/worktree/.pose/starts/pose-index-recovery-and-close-scope-consistency.json","content":"{\n  \"schema_version\": 1,\n  \"spec\": \"pose-index-recovery-and-close-scope-consistency\",\n  \"plan_digest\": \"5d610e7cd8222d76c86726563a316219370a585b4cb8c950285d0ad105299b6c\",\n  \"revision\": \"86add3f4ee0b656a56934a90518f9c83e1af4f4e\",\n  \"spec_digest_before\": \"3875287d5579d9bba1d0dfaaeff8fdba00af9acce9b122fe373498c202a690d4\",\n  \"spec_digest_after\": \"1590c7728d2ec9cb1fb29b5e7bd3ae863bedf88fe0b5d8c1e42e0883149fc022\",\n  \"baseline\": {\n    \"schema_version\": 1,\n    \"namespace\": \"spec:pose-index-recovery-and-close-scope-consistency\",\n    \"nodes\": [\n      {\n        \"id\": \"R1\",\n        \"kind\": \"requirement\",\n        \"namespace\": \"spec:pose-index-recovery-and-close-scope-consistency\",\n        \"hash\": \"9b5daf23c84b\",\n        \"state\": \"active\"\n      },\n      {\n        \"id\": \"R2\",\n        \"kind\": \"requirement\",\n        \"namespace\": \"spec:pose-index-recovery-and-close-scope-consistency\",\n        \"hash\": \"87da7b4f7bf0\",\n        \"state\": \"a