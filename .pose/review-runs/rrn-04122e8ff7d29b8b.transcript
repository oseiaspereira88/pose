{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015bHG27x8KqnFjsiQoapqWa","type":"tool_result","content":"700\t\tflush()\n701\t\treturn sections\n702\t}\n703\t\n704\tfunc (s Store) reviewBundleSubject(scope ScopeRef, components []ReviewPlanComponent, graph DeliveryIntegrityGraph, blockers []string) (ReviewBundleSubject, []ReviewBundleInput, []string, error) {\n705\t\tif len(components) == 0 {\n706\t\t\tif ctx, err := s.resolveReviewPlanContext(scope); err == nil {\n707\t\t\t\tcomponents = ctx.Components\n708\t\t\t}\n709\t\t}\n710\t\tsubject := ReviewBundleSubject{ChangeSets: []string{}, Entries: []ReviewBundleSubjectEntry{}}\n711\t\texcluded := []ReviewBundleInput{}\n712\t\tallowedSpecs, err := s.reviewBundleScopeSpecs(scope)\n713\t\tif err != nil {\n714\t\t\treturn subject, excluded, blockers, err\n715\t\t}\n716\t\tsets := []ChangeSet{}\n717\t\tfor _, set := range graph.ChangeSets {\n718\t\t\tif allowedSpecs[set.Spec] {\n719\t\t\t\tsets = append(sets, set)\n720\t\t\t}\n721\t\t}\n722\t\t// Every selected spec that observes a path the subject reads — whatever\n723\t\t// its action, and read before reduction drops a set whose commits\n724\t\t// another contains: an entry is kept once, but a removal must hold for\n725\t\t// all of them (SR-R1-02, SR-R2-01, SR-R3-01). The removing spec's own\n726\t\t// observation asks nothing of it.\n727\t\tobservers := map[string][]string{}\n728\t\tfor _, set := range sets {\n729\t\t\tfor _, observed := range set.Paths {\n730\t\t\t\tif observed.Action == \"removed\" {\n731\t\t\t\t\tcontinue\n732\t\t\t\t}\n733\t\t\t\tpath := observed.Path\n734\t\t\t\tif observed.Action == \"renamed\" {\n735\t\t\t\t\tpath = observed.NewPath\n736\t\t\t\t}\n737\t\t\t\tobservers[path] = append(observers[path], set.Spec)\n738\t\t\t}\n739\t\t}\n740\t\tsets = reduceReviewBundleChangeSets(sets)\n741\t\tif len(sets) == 0 && s.milestoneOnlyExternal(scope) {\n742\t\t\t// Every member is owned by another project: the implementation is\n743\t\t\t// sealed through the federated manifest, with its source proof, and\n744\t\t\t// there is no local subject to attribute.\n745\t\t\treturn subject, excluded, blockers, nil\n746\t\t}\n747\t\tif len(sets) == 0 {\n748\t\t\tmissing := missingChangeSetBlocker + scope.String()\n749\t\t\tif scope.Kind == \"spec\" {\n750\t\t\t\tmissing += \"; the index holds no commit with `POSE-Spec: \" + scope.Slug + \"`: add the line to the implementing commit, run `pose index` and confirm with `pose artifact-check --spec \" + scope.Slug + \"`\"\n751\t\t\t}\n752\t\t\tblockers = append(blockers, missing)\n753\t\t\treturn subject, excluded, blockers, nil\n754\t\t}\n755\t\tsort.Slice(sets, func(i, j int) bool { return sets[i].ID < sets[j].ID })\n756\t\tseen := map[string]bool{}\n757\t\tsupersededPaths := map[string]bool{}\n758\t\tfor _, set := range sets {\n759\t\t\tfor _, observed := range set.Paths {\n760\t\t\t\tif observed.Action == \"renamed\" && observed.OldPath != \"\" {\n761\t\t\t\t\tsupersededPaths[observed.OldPath] = true\n762\t\t\t\t}\n763\t\t\t}\n764\t\t}\n765\t\t// Resolve every gitlink up front, in one call. A submodule is a gitlink in\n766\t\t// the index and a directory in the working tree, so it has no blob to read —\n767\t\t// and it is not recognisable by path shape, which means asking after the\n768\t\t// shape rules have already classified it is too late: a submodule under a\n769\t\t// mapped component or a known prefix is classified as implementation, skips\n770\t\t// the lookup, and then fails when the digest step tries to read a directory.\n771\t\tcandidatePaths := []string{}\n772\t\tfor _, set := range sets {\n773\t\t\tfor _, observed := range set.Paths {\n774\t\t\t\tcandidatePaths = append(candidatePaths, observed.Path)\n775\t\t\t\tif observed.NewPath != \"\" {\n776\t\t\t\t\tcandidatePaths = append(candidatePaths, observed.NewPath)\n777\t\t\t\t}\n778\t\t\t}\n779\t\t}\n780\t\tgitlinks := reviewBundleGitlinksIn(s.fsys(), s.Root, uniqueSorted(candidatePaths))\n781\t\t// One status of the tree for the whole subject, taken on first need.\n782\t\tvar status *workingTreeSnapshot\n783\t\tnewestHead := s.newestResolvedHead(sets)\n784\t\tfor _, set := range sets {\n785\t\t\tsubject.ChangeSets = append(subject.ChangeSets, set.ID)\n786\t\t\tif subject.Base == \"\" {\n787\t\t\t\tsubject.Base = set.ResolvedBase\n788\t\t\t}\n789\t\t\t// The head of the subject is the newest head of its change sets, not the head of the\n790\t\t\t// one the sort by id happens to put last (spec pose-review-subject-head-is-the-newest).\n791\t\t\tsubject.Head = set.ResolvedHead\n792\t\t\tif newestHead != \"\" {\n793\t\t\t\tsubject.Head = newestHead\n794\t\t\t}\n795\t\t\tfor _, observed := range set.Paths {\n796\t\t\t\tif observed.Action != \"renamed\" && supersededPaths[observed.Path] {\n797\t\t\t\t\texcluded = append(excluded, ReviewBundleInput{Kind: \"superseded-path\", Path: observed.Path, Reason: \"a later attributed rename supplies the current review subject identity\"})\n798\t\t\t\t\tcontinue\n799\t\t\t\t}\n800\t\t\t\tkey := observedKey(observed)\n801\t\t\t\tif seen[key] {\n802\t\t\t\t\tcontinue\n803\t\t\t\t}\n804\t\t\t\tseen[key] = true\n805\t\t\t\tentry := ReviewBundleSubjectEntry{Action: observed.Action, Path: observed.Path, OldPath: observed.OldPath, NewPath: observed.NewPath}\n806\t\t\t\tpath := observed.Path\n807\t\t\t\tif observed.Action == \"renamed\" {\n808\t\t\t\t\tpath = observed.NewPath\n809\t\t\t\t}\n810\t\t\t\tclass, include := reviewBundlePathClass(path, scope, components)\n811\t\t\t\t// Git's answer wins over the path's shape. reviewBundlePathClass stays\n812\t\t\t\t// a pure function of the path; being a gitlink is a fact about the\n813\t\t\t\t// index that no path shape can express.\n814\t\t\t\tgitlinkSHA := gitlinks[path]\n815\t\t\t\tif gitlinkSHA != \"\" {\n816\t\t\t\t\tclass, include = \"submodule\", true\n817\t\t\t\t}\n818\t\t\t\tswitch {\n819\t\t\t\tcase class == \"\" && observed.Action == \"removed\":\n820\t\t\t\t\t// A removal has no content to classify and none to read. The\n821\t\t\t\t\t// reviewable fact is the deletion itself, and it is in the\n822\t\t\t\t\t// subject either way — so refusing the whole bundle because the\n823\t\t\t\t\t// shape rules do not recognise a path that no longer exists\n824\t\t\t\t\t// costs the reviewer the entire review to tell them nothing.\n825\t\t\t\t\tentry.Class, include = \"removed\", true\n826\t\t\t\t\tentry.Reason = \"attributed removal of a path with no governed classification\"\n827\t\t\t\tcase class == \"\":\n828\t\t\t\t\tblockers = append(blockers, \"unclassified review subject path \"+path)\n829\t\t\t\t\tentry.Class = \"unclassified\"\n830\t\t\t\t\tentry.Reason = \"attributed path has no governed review classification\"\n831\t\t\t\tcase gitlinkSHA != \"\":\n832\t\t\t\t\tentry.Class = class\n833\t\t\t\t\tentry.Reason = \"attributed submodule pinned to \" + gitlinkSHA\n834\t\t\t\tdefault:\n835\t\t\t\t\tentry.Class = class\n836\t\t\t\t\tentry.Reason = \"attributed \" + class + \" path in the immutable change set\"\n837\t\t\t\t}\n838\t\t\t\tif !include {\n839\t\t\t\t\texcluded = append(excluded, ReviewBundleInput{Kind: class, Path: path, Reason: \"attributed path is outside the semantic review subject\"})\n840\t\t\t\t\tcontinue\n841\t\t\t\t}\n842\t\t\t\tif status == nil {\n843\t\t\t\t\tstatus = takeWorkingTreeSnapshotIn(s.fsys(), s.Root)\n844\t\t\t\t}\n845\t\t\t\tif dirty, detail := status.change(path); dirty {\n846\t\t\t\t\tblockers = append(blockers, \"review subject path \"+path+\" has working-tree-only content\"+detail)\n847\t\t\t\t}\n848\t\t\t\tif include && observed.Action != \"removed\" {\n849\t\t\t\t\tif gitlinkSHA != \"\" {\n850\t\t\t\t\t\t// The reviewable identity of a submodule is the commit it is\n851\t\t\t\t\t\t// pinned to. There is no file to read: the path is a directory\n852\t\t\t\t\t\t// in the working tree and a gitlink in the index.\n853\t\t\t\t\t\tentry.Digest = digestBytes([]byte(gitlinkSHA))\n854\t\t\t\t\t} else if digest, 