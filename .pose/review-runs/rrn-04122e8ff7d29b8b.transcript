{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PiHtFitbwJ5pmyghenEdUV","type":"tool_result","content":"2083\tfunc (s Store) sealReviewBundle(ref string, identity *ReviewBundleImplementation, declared bool, warning string, now time.Time) (ReviewBundle, error) {\n2084\t\tbundle, err := s.PrepareReviewBundle(ref)\n2085\t\tif err != nil {\n2086\t\t\treturn ReviewBundle{}, err\n2087\t\t}\n2088\t\tif len(bundle.Blockers) > 0 {\n2089\t\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", strings.Join(bundle.Blockers, \"; \"))\n2090\t\t}\n2091\t\tsealed, err := s.ListReviewBundles(bundle.Payload.Scope.Ref)\n2092\t\tif err != nil {\n2093\t\t\treturn ReviewBundle{}, err\n2094\t\t}\n2095\t\t// Content a sealed bundle already holds keeps the bundle that governs it,\n2096\t\t// unless a declared identity names another: then the new seal replaces\n2097\t\t// that bundle's identity by name, so it governs whatever the seal instants\n2098\t\t// say, and a historical identity declared again is a new seal, never the\n2099\t\t// historical bundle handed back (spec pose-delegation-routing D3).\n2100\t\tif governing := governingSealedBundle(sealed, bundle); governing != nil {\n2101\t\t\tif !declared || identity == nil || governing.Payload.Implementation != nil && sameImplementation(*governing.Payload.Implementation, *identity) {\n2102\t\t\t\treturn *governing, nil\n2103\t\t\t}\n2104\t\t\treplaced := *identity\n2105\t\t\treplaced.Replaces = governing.BundleID\n2106\t\t\tidentity = &replaced\n2107\t\t}\n2108\t\t// A bundle already sealed reads as it was; a new seal holds a validation result,\n2109\t\t// whatever the lifecycle of the scope says.\n2110\t\tif !holdsValidationResult(bundle.Payload.Evidence) {\n2111\t\t\tscope, err := ParseScopeRef(bundle.Payload.Scope.Ref)\n2112\t\t\tif err != nil {\n2113\t\t\t\treturn ReviewBundle{}, err\n2114\t\t\t}\n2115\t\t\tgraph, err := s.GetDeliveryIntegrity(\"\")\n2116\t\t\tif err != nil {\n2117\t\t\t\treturn ReviewBundle{}, err\n2118\t\t\t}\n2119\t\t\tif s.reviewScopeRequiresValidationEvidence(scope, bundle.Payload.Plan, graph) {\n2120\t\t\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", noValidationEvidenceBlocker)\n2121\t\t\t}\n2122\t\t}\n2123\t\tif identity != nil {\n2124\t\t\tbundle.Payload.Implementation = identity\n2125\t\t\tdigest, err := reviewBundlePayloadDigest(bundle.Payload)\n2126\t\t\tif err != nil {\n2127\t\t\t\treturn ReviewBundle{}, err\n2128\t\t\t}\n2129\t\t\tbundle.BundleDigest = digest\n2130\t\t\tbundle.BundleID = \"rvb-\" + strings.TrimPrefix(digest, \"sha256:\")[:16]\n2131\t\t}\n2132\t\tif warning != \"\" {\n2133\t\t\tbundle.Warnings = uniqueSorted(append(bundle.Warnings, warning))\n2134\t\t}\n2135\t\tbundle.State = \"sealed\"\n2136\t\tbundle.SealedAt = now.UTC().Truncate(time.Second).Format(time.RFC3339)\n2137\t\tbundle.Path = filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\", bundle.BundleID+\".json\"))\n2138\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-bundles\")), true)\n2139\t\tif err != nil {\n2140\t\t\treturn ReviewBundle{}, err\n2141\t\t}\n2142\t\tpath := filepath.Join(dir, bundle.BundleID+\".json\")\n2143\t\tif existing, readErr := s.LoadReviewBundle(bundle.BundleID); readErr == nil {\n2144\t\t\tif existing.BundleDigest != bundle.BundleDigest {\n2145\t\t\t\treturn ReviewBundle{}, fmt.Errorf(\"pose: review bundle identity collision for %s\", bundle.BundleID)\n2146\t\t\t}\n2147\t\t\treturn existing, nil\n2148\t\t}\n2149\t\traw, err := json.MarshalIndent(bundle, \"\", \"  \")\n2150\t\tif err != nil {\n2151\t\t\treturn ReviewBundle{}, err\n2152\t\t}\n2153\t\traw = append(raw, '\\n')\n2154\t\tif err := writeImmutableJSONIn(s.fsys(), path, raw); err != nil {\n2155\t\t\tvar durability *PublishDurabilityError\n2156\t\t\tif errors.As(err, &durability) {\n2157\t\t\t\t// The publisher reports this error only after the immutable name is\n2158\t\t\