 \"clean\"\n950\t\t\t\t\tobservation.RangeCommits = count\n951\t\t\t\t}\n952\t\t\t}\n953\t\t\tobservations = append(observations, observation)\n954\t\t}\n955\t\tsort.Slice(observations, func(i, j int) bool { return observations[i].ChangeSet < observations[j].ChangeSet })\n956\t\treturn observations\n957\t}\n958\t\n959\t// rangeUnattributedOwners reads the trailers of the commits set's range spans\n960\t// but does not attribute. It reports nothing when Git cannot answer: the\n961\t// counts above already say the range is contaminated.\n962\tfunc rangeUnattributedOwners(files Files, root string, set ChangeSet) ([]string, int) {\n963\t\tattributed := map[string]bool{}\n964\t\tfor _, commit := range set.Commits {\n965\t\t\tattributed[commit] = true\n966\t\t}\n967\t\tvar out bytes.Buffer\n968\t\tproducer := governanceProducerFromFiles(files, \"review\")\n969\t\traw, err := captureGovernanceGit(files, root, producer, \"log\", \"--no-color\", \"--format=%x01%H%n%B%x02\", ChangeSetRange(set.ResolvedBase, set.ResolvedHead), \"--\")\n970\t\tif err != nil || len(raw) > reviewAttributionMaxBytes {\n971\t\t\treturn nil, 0\n972\t\t}\n973\t\tout.Write(raw)\n974\t\tspecs := []string{}\n975\t\tuntrailed := 0\n976\t\tfor _, chunk := range strings.Split(out.String(), \"\\x01\") {\n977\t\t\tend := strings.Index(chunk, \"\\x02\")\n978\t\t\tnewline := strings.Index(chunk, \"\\n\")\n979\t\t\tif end < 0 || newline < 0 || newline > end {\n980\t\t\t\tcontinue\n981\t\t\t}\n982\t\t\tsha := strings.TrimSpace(chunk[:newline])\n983\t\t\tif attributed[sha] {\n984\t\t\t\tcontinue\n985\t\t\t}\n986\t\t\towned := false\n987\t\t\tfor _, line := range strings.Split(chunk[newline+1:end], \"\\n\") {\n988\t\t\t\tif spec, ok := strings.CutPrefix(strings.TrimSpace(line), \"POSE-Spec:\"); ok && strings.TrimSpace(spec) != \"\" {\n989\t\t\t\t\towned = true\n990\t\t\t\t\tif strings.TrimSpace(spec) != set.Spec {\n991\t\t\t\t\t\tspecs = append(specs, strings.TrimSpace(spec))\n992\t\t\t\t\t}\n993\t\t\t\t}\n994\t\t\t}\n995\t\t\tif !owned {\n996\t\t\t\tuntrailed++\n997\t\t\t}\n998\t\t}\n999\t\treturn uniqueSorted(specs), untrailed\n1000\t}\n1001\t\n1002\tfunc gitRevListCount(root, base, head string) (int, error) {\n1003\t\tout, err := gitCommand(\"-C\", root, \"rev-list\", \"--count\", ChangeSetRange(base, head), \"--\").Output()\n1004\t\tif err != nil {\n1005\t\t\treturn 0, err\n1006\t\t}\n1007\t\treturn strconv.Atoi(strings.TrimSpace(string(out)))\n1008\t}\n1009\t\n1010\tfunc gitRevListCountIn(files Files, root, producer, base, head string) (int, error) {\n1011\t\tproducer = governanceProducerFromFiles(files, producer)\n1012\t\tout, err := captureGovernanceGit(files, root, producer, \"rev-list\", \"--count\", ChangeSetRange(base, head), \"--\")\n1013\t\tif err != nil {\n1014\t\t\treturn 0, err\n1015\t\t}\n1016\t\treturn strconv.Atoi(strings.TrimSpace(string(out)))\n1017\t}\n1018\t\n1019\tfunc reduceReviewBundleChangeSets(sets []ChangeSet) []ChangeSet {\n1020\t\tresult := make([]ChangeSet, 0, len(sets))\n1021\t\tfor i, candidate := range sets {\n1022\t\t\tcandidateCommits := map[string]bool{}\n1023\t\t\tfor _, commit := range candidate.Commits {\n1024\t\t\t\tcandidateCommits[commit] = true\n1025\t\t\t}\n1026\t\t\tsubsumed := false\n1027\t\t\tif len(candidateCommits) > 0 {\n1028\t\t\t\tfor j, other := range sets {\n1029\t\t\t\t\tif i == j || len(other.Commits) <= len(candidate.Commits) {\n1030\t\t\t\t\t\tcontinue\n1031\t\t\t\t\t}\n1032\t\t\t\t\tcontainsAll := true\n1033\t\t\t\t\totherCommits := map[string]bool{}\n1034\t\t\t\t\tfor _, commit := range other.Commits {\n1035\t\t\t\t\t\totherCommits[commit] = true\n1036\t\t\t\t\t}\n1037\t\t\t\t\tfor commit := range candidateCommits {\n1038\t\t\t\t\t\tif !otherCommits[commit] {\n1039\t\t\t\t\t\t\tcontainsAll = false\n1040\t\t\t\t\t\t\tbreak\n1041\t\t\t\t\t\t}\n1042\t\t\t\t\t}\n1043\t\t\t\t\tif containsAll {\n1044\t\t\t\t\t\tsubsumed = true\n1045\t\t\t\t\t\tbreak\n1046\t\t\t\t\t}\n1047\t\t\t\t}\n1048\t\t\t}\n1049\t\t\tif !subsumed {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"098e39ba-1fe3-4cbb-a78e-28eae62c9d52","timestamp":"2026-11-11T05:15:46.417Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-3283377101/worktree/pose-mcp/internal/pose/review_bundle.go","content":"\tfor _, set := range graph.ChangeSets {\n\t\tbyID[set.ID] = set\n\t}\n\tobservations := []ReviewBundleRangeObservation{}\n\tfor _, id := range ids {\n\t\tset, ok := byID[id]\n\t\tif !ok {\n\t\t\tobservations = append(observations, ReviewBundleRangeObservation{ChangeSet: id, State: \"unknown\", Reason: \"the change set is not present in the current integrity graph\"})\n\t\t\tcontinue\n\t\t}\n\t\tobservation := ReviewBundleRangeObservation{\n\t\t\tChangeSet:         set.ID,\n\t\t\tAttributedCommits: len(set.Commits),\n\t\t}\n\t\tswitch {\n\t\tcase set.ResolvedBase == \"\" || set.ResolvedHead == \"\":\n\t\t\tobservation.State = \"unknown\"\n\t\t\tobservation.Reason = \"the change set resolves no immutable range to count against\"\n\t\tdefault:\n\t\t\tcount, err := gitRevListCountIn(s.fsys(), s.Root, \"review\", set.ResolvedBase, set.ResolvedHead)\n\t\t\tswitch {\n\t\t\tcase err != nil:\n\t\t\t\tobservation.State = \"unknown\"\n\t\t\t\tobservation.Reason = \"the range could not be counted in this working tree\"\n\t\t\tcase len(set.Commits) == 0:\n\t\t\t\tobservation.State = \"unknown\"\n\t\t\t\tobservation.Reason = \"the change set attributes no commit to compare the range with\"\n\t\t\tcase count > len(set.Commits):\n\t\t\t\tobservation.State = \"contaminated\"\n\t\t\t\tobservation.RangeCommits = count\n\t\t\t\tobservation.UnattributedCommits = count - len(set.Commits)\n\t\t\t\tobservation.UnattributedSpecs, observation.UntrailedCommits = rangeUnattributedOwners(s.fsys(), s.Root, set)\n\t\t\t\tobservation.Reason = \"the range spans commits this change set does not attribute; its paths are attributed, its base..head is not\"\n\t\t\tdefault:\n\t\t\t\tobservation.State = \"clean\"\n\t\t\t\tobservation.RangeCommits = count\n\t\t\t}\n\t\t}\n\t\tobservations = append(observations, observation)\n\t}\n\tsort.Slice(observations, func(i, j int) bool { return observations[i].ChangeSet < observations[j].ChangeSet })\n\treturn observations\n}\n\n// rangeUnattributedOwners reads the trailers of the commits set's range spans\n// but does not attribute. It reports nothing when Git cannot answer: the\n// counts above already say the range is contaminated.\nfunc rangeUnattributedOwners(files Files, root string, set ChangeSet) ([]string, int) {\n\tattributed := map[string]bool{}\n\tfor _, commit := range set.Commits {\n\t\tattributed[commit] = true\n\t}\n\tvar out bytes.Buffer\n\tproducer := governanceProducerFromFiles(files, \"review\")\n\traw, err := captureGovernanceGit(files, root, producer, \"log\", \"--no-color\", \"--format=%x01%H%n%B%x02\", ChangeSetRange(set.ResolvedBase, set.ResolvedHead), \"--\")\n\tif err != nil || len(raw) > reviewAttributionMaxBytes {\n\t\treturn nil, 0\n\t}\n\tout.Write(raw)\n\tspecs := []string{}\n\tuntrailed := 0\n\tfor _, chunk := range strings.Split(out.String(), \"\\x01\") {\n\t\tend := strings.Index(chunk, \"\\x02\")\n\t\tnewline := strings.Index(chunk, \"\\n\")\n\t\tif end < 0 || newline < 0 || newline > end {\n\t\t\tcontinue\n\t\t}\n\t\tsha := strings.TrimSpace(chunk[:newline])\n\t\tif attributed[sha] {\n\t\t\tcontinue\n\t\t}\n\t\towned := false\n\t\tfor _, line := range strings.Split(chunk[newline+1:end], \"\\n\") {\n\t\t\tif spec, ok := strings.CutPrefix(strings.TrimSpace(line), \"POSE-Spec:\"); ok && strings.TrimSpace(spec) != \"\" {\n\t\t\t\towned = true\n\t\t\t\tif strings.TrimSpace(spec) != set.Spec {\n\t\t\t\t\tspecs = append(specs, strings.TrimSpace(spec))\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif !owned {\n\t\t\tuntrailed++\n\t\t}\n\t}\n\treturn uniqueSorted(specs), untrailed\n}\n\nfunc gitRevListCount(root, base, head string) (int, error) {\n\tout, err := gitCommand(\"-C\", root, \"rev-list\", \"--count\", ChangeSetRange(base, head), \"--\").Output()\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\treturn strconv.Atoi(strings.TrimSpace(string(out)))\n}\n\nfunc gitRevListCountIn(files Files, root, producer, base, head string) (int, error) {\n\tproducer = governanceProducerFromFiles(files, producer)\n\tout, err := captureGovernanceGit(files, root, producer, \"rev-list\", \"--count\", ChangeSetRange(base, head), \"--\")\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\treturn strconv.Atoi(strings.TrimSpace(string(out)))\n}\n\nfunc reduceReviewBundleChangeSets(sets []ChangeSet) []ChangeSet {\n\tresult := make([]ChangeSet, 0, len(sets))\n\tfor i, candidate := range sets {\n\t\tcandidateCommits := map[string]bool{}\n\t\tfor _, commit := range candidate.Commits {\n\t\t\tcandidateCommits[commit] = true\n\t\t}\n\t\tsubsumed := false\n\t\tif len(candidateCommits) > 0 {\n\t\t\tfor j, other := range sets {\n\t\t\t\tif i == j || len(other.Commits) <= len(candidate.Commits) {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tcontainsAll := true\n\t\t\t\totherCommits := map[string]bool{}\n\t\t\t\tfor _, commit := range other.Commits {\n\t\t\t\t\totherCommits[commit] = true\n\t\t\t\t}\n\t\t\t\tfor commit := range candidateCommits {\n\t\t\t\t\tif !otherCommits[commit] {\n\t\t\t\t\t\tcontainsAll = false\n\t\t\t\t\t\tbreak\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif containsAll {\n\t\t\t\t\tsubsumed = true\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif !subsumed {","numLines":135,"startLine":915,"totalLines":4658}},"tool_result_meta":[{"id":"toolu_013wRm237xduLtYSD3AVoZX7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
