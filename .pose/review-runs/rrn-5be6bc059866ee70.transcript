t, \"resume\", 1, err)\n1064\t\t\t}\n1065\t\t}\n1066\t\tif f.dryRun {\n1067\t\t\textra := map[string]any{\"resumes\": target, \"attempt\": attempt.AttemptID, \"label\": attempt.Label}\n1068\t\t\tif plan.Existing != nil {\n1069\t\t\t\textra[\"recorded_continuation\"] = plan.Existing.RunID\n1070\t\t\t}\n1071\t\t\tif f.wait {\n1072\t\t\t\textra[\"wait\"] = delay.String()\n1073\t\t\t}\n1074\t\t\tplan.Purpose = attempt.Purpose\n1075\t\t\targv := redactArgv(posemodel.ReviewerArgv(plan.Config.Resume.Command, \"{output}\", \"{session}\", plan.Effort, plan.Config.Effort), plan.Config)\n1076\t\t\treturn delegatePrintPlan(stdout, stderr, f.jsonOut, plan, argv, extra)\n1077\t\t}\n1078\t\tif delay > 0 {\n1079\t\t\tif !f.jsonOut {\n1080\t\t\t\trender(stdout, stderr).Field(\"delegate.wait\", delay.String())\n1081\t\t\t}\n1082\t\t\ttime.Sleep(delay)\n1083\t\t\tif plan, err = store.PlanReviewResume(target); err != nil {\n1084\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n1085\t\t\t}\n1086\t\t}\n1087\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n1088\t\tdefer stop()\n1089\t\tif delegateSupervised() {\n1090\t\t\tplan.OnStart = supervisorHandback()\n1091\t\t}\n1092\t\t// The containment the run will run under is disclosed before it runs, as\n1093\t\t// pose review dispatch disclosed it (spec pose-delegation-parity-gate R6;\n1094\t\t// review round 1, PG-R1-08); the JSON document carries it with the run.\n1095\t\tif safety, _ := posemodel.ResolveReviewerContainment(plan.Config); safety != nil && !f.jsonOut {\n1096\t\t\traw, _ := json.Marshal(safety)\n1097\t\t\trender(stdout, stderr).Field(\"delegate.safety\", string(raw))\n1098\t\t}\n1099\t\trun, err := store.RunReviewDispatchContext(ctx, plan, time.Now)\n1100\t\thandBackExisting(run, err)\n1101\t\tdelegateAutoConclude(store, run, err, stdout, stderr)\n1102\t\tdelegateTerminalHook(store, run, err, stdout, stderr, \"resume\")\n1103\t\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, \"resume\", run, err, delegateRunNextActions(store, run, err)...)\n1104\t\tif err == nil && !f.jsonOut {\n1105\t\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n1106\t\t\t\treturn next\n1107\t\t\t}\n1108\t\t}\n1109\t\treturn code\n1110\t}\n1111\t\n1112\tfunc cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n1113\t\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n1114\t\tif problem != \"\" {\n1115\t\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n1116\t\t}\n1117\t\tstore := posemodel.Store{Root: root}\n1118\t\tattempts, lost, err := store.ListDelegationAttempts()\n1119\t\tif err != nil {\n1120\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n1121\t\t}\n1122\t\tattempt, code, err := namedAttempt(attempts, f)\n1123\t\tif err != nil {\n1124\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n1125\t\t}\n1126\t\tif !attempt.Active && !f.dryRun {\n1127\t\t\t// An attempt whose dispatch, or whose earlier release, ended before\n1128\t\t\t// its receipt is released with a failed run and its receipt, so it\n1129\t\t\t// stops blocking the bundle; the release proves the abandonment\n1130\t\t\t// itself (spec pose-review-run-reaps-lingering-reviewer-processes R5,\n1131\t\t\t// review round 4, N1).\n1132\t\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n1133\t\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n1134\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n1135\t\t\t}\n1136\t\t\tif err != nil {\n1137\t\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n1138\t\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n1139\t\t\t}\n1140\t\t\tif f.jsonOut {\n1141\t\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n1142\t\t\t\treturn 0\n1143\t\t\t}\n1144\t\t\tout := render(stdout, stderr)\n1145\t\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n1146\t\t\tswitch {\n1147\t\t\tcase run.RunID == \"\":\n1148\t\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n1149\t\t\tcase run.Status == posemodel.ReviewRunFailed && strings.HasPrefix(run.Failure, posemodel.DelegationAbandonedCause):"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"713bb549-a7cd-4a19-8222-ce08ffc2f20e","timestamp":"2026-11-27T07:17:45.772Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-28c7b07899/worktree/pose-mcp/internal/cli/delegate.go","content":"\t// A detached resume is this command run again in its own session (spec\n\t// pose-delegation-mcp R4); it hands its attempt back once it starts.\n\tif f.detach && !f.dryRun && !delegateSupervised() {\n\t\tif f.wait {\n\t\t\treturn delegateUsage(stdout, stderr, args, \"resume\", tr(\"--detach does not wait for a reset: resume after it, or without --detach\", \"--detach não espera um reset: retome depois dele, ou sem --detach\"))\n\t\t}\n\t\treturn detachDelegateRun(root, \"resume\", args, f, stdout, stderr)\n\t}\n\tstore := cliGovernedStore(root)\n\tattempts, _, err := store.ListDelegationAttempts()\n\tif err != nil {\n\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n\t}\n\tattempt, code, err := namedAttempt(attempts, f)\n\tif err != nil {\n\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", code, err)\n\t}\n\tif attempt.Active {\n\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, errors.New(tr(\"attempt \"+attempt.AttemptID+\" is still running\", \"a tentativa \"+attempt.AttemptID+\" ainda está rodando\")))\n\t}\n\tref := attempt.AttemptID\n\tif len(f.positional) == 1 {\n\t\tref = f.positional[0]\n\t}\n\ttarget, err := resumeTarget(attempt, ref)\n\tif err != nil {\n\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n\t}\n\tif attempt.Purpose == posemodel.DelegationPurposeTask {\n\t\treturn cmdDelegateTaskResume(root, store, f, attempt, target, stdout, stderr)\n\t}\n\tif f.promptFile != \"\" {\n\t\treturn delegateUsage(stdout, stderr, args, \"resume\", tr(\"--prompt is for a task; a review is resumed with its own brief\", \"--prompt é para uma task; uma review é retomada com o próprio brief\"))\n\t}\n\tplan, err := store.PlanReviewResume(target)\n\tif err != nil {\n\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n\t}\n\tif pending := plan.PendingContinuation; pending != nil {\n\t\t// A continuation already reserved is answered, as pose review resume\n\t\t// answered it: pending, with its ids, and no second process (spec\n\t\t// pose-delegation-parity-gate R6; review round 1, PG-R1-07).\n\t\thandBackAttempt(pending.AttemptID)\n\t\tif f.jsonOut {\n\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateRunSchema, \"purpose\": attempt.Purpose, \"attempt\": pending.AttemptID, \"resumes\": pending.Predecessor,\n\t\t\t\t\"continuation\": pending.ID, \"status\": \"pending\"})\n\t\t\treturn 0\n\t\t}\n\t\tout := render(stdout, stderr)\n\t\tout.Field(\"delegate.resumes\", pending.Predecessor)\n\t\tout.Field(\"delegate.continuation\", pending.ID)\n\t\tout.Field(\"delegate.attempt\", pending.AttemptID)\n\t\tout.Field(\"delegate.status\", \"pending\")\n\t\treturn 0\n\t}\n\tvar delay time.Duration\n\tif f.wait && plan.Existing == nil {\n\t\tvar seed [1]byte\n\t\tif _, err := rand.Read(seed[:]); err != nil {\n\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n\t\t}\n\t\tvar prior posemodel.ReviewRun\n\t\tif latest := attempt.Latest(); latest != nil && latest.RunID == target {\n\t\t\tprior = *latest\n\t\t} else if runs, rerr := store.ListReviewRuns(\"\"); rerr == nil {\n\t\t\tfor _, r := range runs {\n\t\t\t\tif r.RunID == target {\n\t\t\t\t\tprior = r\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tdelay, err = posemodel.ReviewResumeDelay(prior, time.Now(), f.waitMax, time.Duration(seed[0])*time.Second/255)\n\t\tif err != nil {\n\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n\t\t}\n\t}\n\tif f.dryRun {\n\t\textra := map[string]any{\"resumes\": target, \"attempt\": attempt.AttemptID, \"label\": attempt.Label}\n\t\tif plan.Existing != nil {\n\t\t\textra[\"recorded_continuation\"] = plan.Existing.RunID\n\t\t}\n\t\tif f.wait {\n\t\t\textra[\"wait\"] = delay.String()\n\t\t}\n\t\tplan.Purpose = attempt.Purpose\n\t\targv := redactArgv(posemodel.ReviewerArgv(plan.Config.Resume.Command, \"{output}\", \"{session}\", plan.Effort, plan.Config.Effort), plan.Config)\n\t\treturn delegatePrintPlan(stdout, stderr, f.jsonOut, plan, argv, extra)\n\t}\n\tif delay > 0 {\n\t\tif !f.jsonOut {\n\t\t\trender(stdout, stderr).Field(\"delegate.wait\", delay.String())\n\t\t}\n\t\ttime.Sleep(delay)\n\t\tif plan, err = store.PlanReviewResume(target); err != nil {\n\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"resume\", 1, err)\n\t\t}\n\t}\n\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n\tdefer stop()\n\tif delegateSupervised() {\n\t\tplan.OnStart = supervisorHandback()\n\t}\n\t// The containment the run will run under is disclosed before it runs, as\n\t// pose review dispatch disclosed it (spec pose-delegation-parity-gate R6;\n\t// review round 1, PG-R1-08); the JSON document carries it with the run.\n\tif safety, _ := posemodel.ResolveReviewerContainment(plan.Config); safety != nil && !f.jsonOut {\n\t\traw, _ := json.Marshal(safety)\n\t\trender(stdout, stderr).Field(\"delegate.safety\", string(raw))\n\t}\n\trun, err := store.RunReviewDispatchContext(ctx, plan, time.Now)\n\thandBackExisting(run, err)\n\tdelegateAutoConclude(store, run, err, stdout, stderr)\n\tdelegateTerminalHook(store, run, err, stdout, stderr, \"resume\")\n\tcode = delegatePrintRun(stdout, stderr, f.jsonOut, \"resume\", run, err, delegateRunNextActions(store, run, err)...)\n\tif err == nil && !f.jsonOut {\n\t\tif next, chose := offerDelegateChoices(root, run, stdout, stderr); chose {\n\t\t\treturn next\n\t\t}\n\t}\n\treturn code\n}\n\nfunc cmdDelegateCancel(root string, args []string, stdout, stderr io.Writer) int {\n\tf, problem := parseDelegateFlags(args, \"--confirm-abandoned\")\n\tif problem != \"\" {\n\t\treturn delegateUsage(stdout, stderr, args, \"cancel\", problem+\"\\n\"+tr(\"Usage: \", \"Uso: \")+\"pose delegate cancel <run> [--confirm-abandoned] [--dry-run] [--json]\")\n\t}\n\tstore := posemodel.Store{Root: root}\n\tattempts, lost, err := store.ListDelegationAttempts()\n\tif err != nil {\n\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n\t}\n\tattempt, code, err := namedAttempt(attempts, f)\n\tif err != nil {\n\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", code, withDelegationLosses(err, lost))\n\t}\n\tif !attempt.Active && !f.dryRun {\n\t\t// An attempt whose dispatch, or whose earlier release, ended before\n\t\t// its receipt is released with a failed run and its receipt, so it\n\t\t// stops blocking the bundle; the release proves the abandonment\n\t\t// itself (spec pose-review-run-reaps-lingering-reviewer-processes R5,\n\t\t// review round 4, N1).\n\t\trun, err := store.ReleaseAbandonedAttempt(attempt.AttemptID, time.Now(), f.confirmAbandoned)\n\t\tif err != nil && (attempt.State == posemodel.DelegationStalled || !errors.Is(err, posemodel.ErrAttemptNotAbandoned)) {\n\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, err)\n\t\t}\n\t\tif err != nil {\n\t\t\treturn delegateFail(stdout, stderr, f.jsonOut, \"cancel\", 1, withDelegationLosses(errors.New(tr(\"attempt \"+attempt.AttemptID+\" is \"+attempt.State+\", not running\",\n\t\t\t\t\"a tentativa \"+attempt.AttemptID+\" está \"+attempt.State+\", não rodando\")), lost))\n\t\t}\n\t\tif f.jsonOut {\n\t\t\twriteDelegateJSON(stdout, map[string]any{\"schema\": delegateCancelSchema, \"attempt\": attempt.AttemptID, \"released\": true, \"run\": run.RunID, \"status\": run.Status})\n\t\t\treturn 0\n\t\t}\n\t\tout := render(stdout, stderr)\n\t\tout.Field(\"delegate.attempt\", attempt.AttemptID)\n\t\tswitch {\n\t\tcase run.RunID == \"\":\n\t\t\tout.Field(\"delegate.released\", tr(\"true: no reservation was published; the stalled marker was removed\", \"true: nenhuma reserva foi publicada; o marcador parado foi removido\"))\n\t\tcase run.Status == posemodel.ReviewRunFailed && strings.HasPrefix(run.Failure, posemodel.DelegationAbandonedCause):","numLines":160,"startLine":990,"totalLines":1358}},"tool_result_meta":[{"id":"toolu_01LerKbBczb5JDn7suM43B5K","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
