{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TTbPeKTJAvhD2FWVTVha76","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"os\"\n6\t\t\"os/exec\"\n7\t\t\"path/filepath\"\n8\t\t\"strings\"\n9\t\t\"testing\"\n10\t\n11\t\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n12\t)\n13\t\n14\t// nextReviewRound changes the scope, commits it and seals the next bundle, as\n15\t// an implementer does after a rejection.\n16\tfunc nextReviewRound(t *testing.T, root, change string) {\n17\t\tt.Helper()\n18\t\tgit := func(args ...string) string {\n19\t\t\tt.Helper()\n20\t\t\tout, err := exec.Command(\"git\", append([]string{\"-C\", root, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"-c\", \"commit.gpgsign=false\"}, args...)...).CombinedOutput()\n21\t\t\tif err != nil {\n22\t\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n23\t\t\t}\n24\t\t\treturn strings.TrimSpace(string(out))\n25\t\t}\n26\t\tlib := filepath.Join(root, \"pose-mcp\", \"lib.go\")\n27\t\traw, _ := os.ReadFile(lib)\n28\t\tif err := os.WriteFile(lib, append(raw, []byte(\"// \"+change+\"\\n\")...), 0o644); err != nil {\n29\t\t\tt.Fatal(err)\n30\t\t}\n31\t\tgit(\"add\", \"-A\")\n32\t\tgit(\"commit\", \"-q\", \"-m\", change)\n33\t\thead := git(\"rev-parse\", \"HEAD\")\n34\t\tgraphPath := filepath.Join(root, \".pose\", \"indexes\", \"delivery-integrity.json\")\n35\t\tvar graph posemodel.DeliveryIntegrityGraph\n36\t\trawGraph, _ := os.ReadFile(graphPath)\n37\t\tif err := json.Unmarshal(rawGraph, &graph); err != nil {\n38\t\t\tt.Fatal(err)\n39\t\t}\n40\t\tcs := &graph.ChangeSets[0]\n41\t\tcs.Selector, cs.Head, cs.ResolvedHead = \"range:\"+cs.Base+\"..\"+head, head, head\n42\t\tgraph.ValidationResults[0].GitHead = head\n43\t\trawGraph, _ = json.Marshal(graph)\n44\t\twriteCloseoutCLIFile(t, root, \".pose/indexes/delivery-integrity.json\", string(rawGraph))\n45\t\tif code, out := runPose(t, root, \"review\", \"bundle\", \"spec:alpha\", \"--seal\"); code != 0 {\n46\t\t\tt.Fatalf(\"seal: %s\", out)\n47\t\t}\n48\t}\n49\t\n50\t// roundsAgent answers round 1 with two findings and, from round 2, accounts\n51\t// for them; it marks whether it ran its resume command, so a continued\n52\t// thread shows. sloppy omits a prior finding.\n53\tfunc roundsAgent(name, vendor string, sloppy bool) string {\n54\t\tprior := `{\"id\":\"R1-B1\",\"status\":\"fixed\",\"evidence\":\"lib.go:2\"},{\"id\":\"R1-B2\",\"status\":\"partial\",\"evidence\":\"half done\"}`\n55\t\tif sloppy {\n56\t\t\tprior = `{\"id\":\"R1-B1\",\"status\":\"fixed\",\"evidence\":\"lib.go:2\"}`\n57\t\t}\n58\t\t// The drafts sit in single-quoted shell words and are printed with %s:\n59\t\t// no printf escape, so every sh prints them alike.\n60\t\tsecond := `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"approved\",\"findings\":[],\"prior_findings\":[` + prior + `],\"sweep\":\"the whole change\"}`\n61\t\tfirst := `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"changes-requested\",\"findings\":[{\"id\":\"B1\",\"severity\":\"high\",\"disposition\":\"blocker\",\"file\":\"pose-mcp/lib.go\",\"line\":1,\"summary\":\"first defect\"},{\"id\":\"B2\",\"severity\":\"medium\",\"disposition\":\"blocker\",\"summary\":\"second defect\"}]}`\n62\t\tfence := \"```\"\n63\t\tscript := `in=$(cat); echo \"session: rounds-sess-01\"; [ -n \"$1\" ] && echo RESUMED-$1; ` +\n64\t\t\t`if printf '%s' \"$in\" | grep -q 'This is round 2'; then printf '%s\\n' 'decision: approved' '` + fence + `pose-draft' '` + second + `' '` + fence + `'; ` +\n65\t\t\t`else printf '%s\\n' 'decision: changes-requested' '` + fence + `pose-draft' '` + first + `' '` + fence + `'; fi`\n66\t\targv, _ := json.Marshal([]string{\"sh\", \"-c\", script, \"x\"})\n67\t\tresume, _ := json.Marshal([]string{\"sh\", \"-c\", script, \"x\", \"{session}\"})\n68\t\treturn `\"` + name + `\": {\"vendor\": \"` + vendor + `\", \"model\": \"` + name + `-1\", \"timeout\": \"30s\",\n69\t      \"commands\": {\"read\": ` + string(argv) + `},\n70\t      \"session\": {\"pattern\": \"session: (\\\\S+)\"},\n71\t      \"resume\": {\"command\": ` + string(resume) + `}}`\n72\t}\n73\t\n74\t// roundsMetric reads the round figures of the one scope insights reports.\n75\tfunc roundsMetric(t *testing.T, out string) posemodel.ReviewRoundMetric {\n76\t\tt.Helper()\n77\t\tvar doc struct {\n78\t\t\tDelegatedReview struct {\n79\t\t\t\tRounds []posemodel.ReviewRoundMetric `json:\"rounds\"`\n80\t\t\t} `json:\"delegated_review\"`\n81\t\t}\n82\t\tif err := json.Unmarshal([]byte(out), &doc); err != nil || len(doc.DelegatedReview.Rounds) != 1 {\n83\t\t\tt.Fatalf(\"insights rounds: %v %s\", err, out)\n84\t\t}\n85\t\treturn doc.DelegatedReview.Rounds[0]\n86\t}\n87\t\n88\tfunc roundRun(t *testing.T, root, agent string) map[string]any {\n89\t\tt.Helper()\n90\t\tcode, out, errOut := runPoseSplit(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", agent, \"--json\", \"--reason\", \"next round\")\n91\t\tvar doc map[string]any\n92\t\tif json.Unmarshal([]byte(out), &doc) != nil || doc[\"status\"] != \"completed\" {\n93\t\t\tt.Fatalf(\"round run: %d %s %s\", code, out, errOut)\n94\t\t}\n95\t\treturn doc\n96\t}\n97\t\n98\tfunc runRecord(t *testing.T, root, id string) posemodel.ReviewRun {\n99\t\tt.Helper()\n100\t\truns, _ := posemodel.Store{Root: root}.ListReviewRuns(\"\")\n101\t\tfor _, r := range runs {\n102\t\t\tif r.RunID == id {\n103\t\t\t\treturn r\n104\t\t\t}\n105\t\t}\n106\t\tt.Fatalf(\"no run %s\", id)\n107\t\treturn posemodel.ReviewRun{}\n108\t}\n109\t\n110\t// R1–R7, R9: round 2 is briefed with round 1's findings, continues the\n111\t// thread's session, and its draft accounts for each; verify discloses the\n112\t// round and the lineage; insights measure convergence.\n113\tfunc TestReviewRoundsContinueTheThreadAndAccountForFindings(t *testing.T) {\n114\t\troot := dispatchInstance(t)\n115\t\twriteDelegation(t, root, delegationPolicy(roundsAgent(\"rounder\", \"other\", false)))\n116\t\tfirst := roundRun(t, root, \"rounder\")\n117\t\tif r := runRecord(t, root, first[\"run\"].(string)); r.Round != 1 || r.Thread != nil || len(r.DraftProblems) != 0 {\n118\t\t\tt.Fatalf(\"round 1: %+v\", r)\n119\t\t}\n120\t\tnextReviewRound(t, root, \"fix B1\")\n121\t\tbrief, err := posemodel.Store{Root: root}.RenderReviewBrief(\"spec:alpha\", \"review\", \"\")\n122\t\tif err != nil || !strings.Contains(brief.Text, \"This is round 2\") || !strings.Contains(brief.Text, \"> R1-B1 (high, blocker, round 1) at pose-mcp/lib.go:1 — first defect\") {\n123\t\t\tt.Fatalf(\"round 2 brief: %v\\n%s\", err, brief.Text)\n124\t\t}\n125\t\tsecond := roundRun(t, root, \"rounder\")\n126\t\tr2 := runRecord(t, root, second[\"run\"].(string))\n127\t\tif r2.Round != 2 || !strings.Contains(r2.Output, \"RESUMED-\") || r2.Thread == nil || r2.Thread.Mode != posemodel.ReviewThreadContinued || r2.Thread.From != first[\"run\"] || len(r2.DraftProblems) != 0 {\n128\t\t\tt.Fatalf(\"round 2: round=%d thread=%+v problems=%v output=%q\", r2.Round, r2.Thread, r2.DraftProblems, r2.Output)\n129\t\t}\n130\t\tif code, out, _ := runPoseSplit(t, root, \"delegate\", \"wait\", second[\"run\"].(string), \"--json\"); code != 0 || !strings.Contains(out, `\"decision\":\"approved\"`) {\n131\t\t\tt.Fatalf(\"wait: %d %s\", code, out)\n132\t\t}\n133\t\t_, out := runPose(t, root, \"review\", \"verify\", \"spec:alpha\")\n134\t\tif !strings.Contains(out, \"review_verify.round=2\") || !strings.Contains(out, \"review_verify.thread.\"+second[\"run\"].(string)+\"=round 2: continued session from \"+first[\"run\"].(string)) {\n135\t\t\tt.Fatalf(\"verify: %s\", out)\n136\t\t}\n137\t\tcode, out := runPose(t, root, \"insights\", \"--json\")\n138\t\tif m := roundsMetric(t, out); code != 0 || m.Scope != \"spec:alpha\" || m.RoundsToApproval == nil || *m.RoundsToApproval != 2 || m.Continued.Rounds != 1 || m.Continued.Approvals != 1 || m.Continued.Accounted != 2 || m.Continued.Fixed != 1 || m.Continued.Partial != 1 {\n139\t\t\tt.Fatalf(\"insights: %d %s\", code, out)\n140\t\t}\n141\t}\n142\t\n143\t// R4, R6, R9: a draft that omits a prior finding is invalid and never an\n144\t// approval, continued session or not; a vendor change opens a new session\n145\t// with its reason; cold-session opens one every round.\n146\tfunc TestReviewRoundsRefuseAnIncompleteAccount(t *testing.T) {\n147\t\troot := dispatchInstance(t)\n148\t\twriteDelegation(t, root, delegationPolicy(roundsAgent(\"rounder\", \"other\", false), roundsAgent(\"sloppy\", \"other\", true), roundsAgent(\"elsewhere\", \"third\", false)))\n149\t\tfirst := roundRun(t, root, \"rounder\")\n150\t\tnextReviewRound(t, root, \"fix B1\")\n151\t\tsecond := roundRun(t, root, \"sloppy\")\n152\t\tr2 := runRecord(t, root, second[\"run\"].(string))\n153\t\tif len(r2.DraftProblems) == 0 || !strings.Contains(strings.Join(r2.DraftProblems, \";\"), \"R1-B2\") {\n154\t\t\tt.Fatalf(\"an incomplete account passed: round=%d thread=%+v problems=%v output=%q\", r2.Round, r2.Thread, r2.DraftProblems, r2.Output)\n155\t\t}\n156\t\tif r2.Thread == nil || r2.Thread.Mode != posemodel.ReviewThreadNew || !strings.Contains(r2.Thread.Reason, \"agent changed\") {\n157\t\t\tt.Fatalf(\"another agent continued the session: %+v\", r2.Thread)\n158\t\t}\n159\t\tif code, out, _ := runPoseSplit(t, root, \"delegate\", \"wait\", second[\"run\"].(string), \"--json\"); code == 0 || !strings.Contains(out, `\"decision\":\"invalid\"`) {\n160\t\t\tt.Fatalf(\"an invalid draft decided: %d %s\", code, out)\n161\t\t}\n162\t\tthird := roundRun(t, root, \"elsewhere\")\n163\t\tif r3 := runRecord(t, root, third[\"run\"].(string)); r3.Thread == nil || r3.Thread.Mode != posemodel.ReviewThreadNew || !strings.Contains(r3.Thread.Reason, \"vendor changed\") {\n164\t\t\tt.Fatalf(\"a vendor change continued the session: %+v\", r3.Thread)\n165\t\t}\n166\t\t_ = first\n167\t\troot = dispatchInstance(t)\n168\t\twriteDelegation(t, root, `{\"schema_version\": 2, \"agents\": {`+roundsAgent(\"rounder\", \"other\", false)+`}, \"routing\": {\"rounds\": \"cold-session\"}, \"purposes\": {\"review\": {\"max_runs_per_bundle\": 5}}}`)\n169\t\troundRun(t, root, \"rounder\")\n170\t\tnextReviewRound(t, root, \"fix B1\")\n171\t\tcold := roundRun(t, root, \"rounder\")\n172\t\tif r := runRecord(t, root, cold[\"run\"].(string)); r.Thread == nil || r.Thread.Mode != posemodel.ReviewThreadNew || !strings.Contains(r.Thread.Reason, \"cold-session\") || strings.Contains(r.Output, \"RESUMED\") {\n173\t\t\tt.Fatalf(\"cold-session continued: %+v %s\", r.Thread, r.Output)\n174\t\t}\n175\t\t// R6, R7: at the round threshold a new session opens and verify warns.\n176\t\troot = dispatchInstance(t)\n177\t\twriteDelegation(t, root, `{\"schema_version\": 2, \"agents\": {`+roundsAgent(\"rounder\", \"other\", false)+`}, \"routing\": {\"round_threshold\": 2}, \"purposes\": {\"review\": {\"max_runs_per_bundle\": 5}}}`)\n178\t\troundRun(t, root, \"rounder\")\n179\t\tnextReviewRound(t, root, \"fix B1\")\n180\t\tlate := roundRun(t, root, \"rounder\")\n181\t\tif r := runRecord(t, root, late[\"run\"].(string)); r.Thread == nil || r.Thread.Mode != posemodel.ReviewThreadNew || !strings.Contains(r.Thread.Reason, \"threshold\") {\n182\t\t\tt.Fatalf(\"the threshold continued the session: %+v\", r.Thread)\n183\t\t}\n184\t\tif _, out := runPose(t, root, \"review\", \"verify\", \"spec:alpha\"); !strings.Contains(out, \"round threshold 2\") {\n185\t\t\tt.Fatalf(\"verify did not warn at the threshold: %s\", out)\n186\t\t}\n187\t\tif code, out, _ := runPoseSplit(t, root, \"delegate\", \"ls\", late[\"run\"].(string), \"--json\"); code != 0 || !strings.Contains(out, `\"round\": 2`) {\n188\t\t\tt.Fatalf(\"ls does not show the round: %d %s\", code, out)\n189\t\t}\n190\t}\n191\t\n192\t// Review round 1, B9, B10, B11: a bundle of an earlier round that cannot be\n193\t// read makes the brief refuse rather than fall back to round 1; ls and\n194\t// insights show the round in text; a resume in round 2 keeps its thread.\n195\tfunc TestReviewRoundsSurviveLossesAndResumes(t *testing.T) {\n196\t\troot := dispatchInstance(t)\n197\t\twriteDelegation(t, root, delegationPolicy(roundsAgent(\"rounder\", \"other\", false)))\n198\t\tfirst := roundRun(t, root, \"rounder\")\n199\t\tnextReviewRound(t, root, \"fix B1\")\n200\t\tif code, out, _ := runPoseSplit(t, root, \"delegate\", \"ls\", first[\"run\"].(string)); code != 0 || !strings.Contains(out, \"round=1\") {"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"73105da3-dadf-4c57-98df-0c73a8088f8c","timestamp":"2026-11-27T07:19:35.021Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-28c7b07899/worktree/pose-mcp/internal/cli/delegate_rounds_test.go","content":"package cli\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\n// nextReviewRound changes the scope, commits it and seals the next bundle, as\n// an implementer does after a rejection.\nfunc nextReviewRound(t *testing.T, root, change string) {\n\tt.Helper()\n\tgit := func(args ...string) string {\n\t\tt.Helper()\n\t\tout, err := exec.Command(\"git\", append([]string{\"-C\", root, \"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"-c\", \"commit.gpgsign=false\"}, args...)...).CombinedOutput()\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"git %v: %v %s\", args, err, out)\n\t\t}\n\t\treturn strings.TrimSpace(string(out))\n\t}\n\tlib := filepath.Join(root, \"pose-mcp\", \"lib.go\")\n\traw, _ := os.ReadFile(lib)\n\tif err := os.WriteFile(lib, append(raw, []byte(\"// \"+change+\"\\n\")...), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgit(\"add\", \"-A\")\n\tgit(\"commit\", \"-q\", \"-m\", change)\n\thead := git(\"rev-parse\", \"HEAD\")\n\tgraphPath := filepath.Join(root, \".pose\", \"indexes\", \"delivery-integrity.json\")\n\tvar graph posemodel.DeliveryIntegrityGraph\n\trawGraph, _ := os.ReadFile(graphPath)\n\tif err := json.Unmarshal(rawGraph, &graph); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcs := &graph.ChangeSets[0]\n\tcs.Selector, cs.Head, cs.ResolvedHead = \"range:\"+cs.Base+\"..\"+head, head, head\n\tgraph.ValidationResults[0].GitHead = head\n\trawGraph, _ = json.Marshal(graph)\n\twriteCloseoutCLIFile(t, root, \".pose/indexes/delivery-integrity.json\", string(rawGraph))\n\tif code, out := runPose(t, root, \"review\", \"bundle\", \"spec:alpha\", \"--seal\"); code != 0 {\n\t\tt.Fatalf(\"seal: %s\", out)\n\t}\n}\n\n// roundsAgent answers round 1 with two findings and, from round 2, accounts\n// for them; it marks whether it ran its resume command, so a continued\n// thread shows. sloppy omits a prior finding.\nfunc roundsAgent(name, vendor string, sloppy bool) string {\n\tprior := `{\"id\":\"R1-B1\",\"status\":\"fixed\",\"evidence\":\"lib.go:2\"},{\"id\":\"R1-B2\",\"status\":\"partial\",\"evidence\":\"half done\"}`\n\tif sloppy {\n\t\tprior = `{\"id\":\"R1-B1\",\"status\":\"fixed\",\"evidence\":\"lib.go:2\"}`\n\t}\n\t// The drafts sit in single-quoted shell words and are printed with %s:\n\t// no printf escape, so every sh prints them alike.\n\tsecond := `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"approved\",\"findings\":[],\"prior_findings\":[` + prior + `],\"sweep\":\"the whole change\"}`\n\tfirst := `{\"schema\":\"pose.review.draft/v1\",\"decision\":\"changes-requested\",\"findings\":[{\"id\":\"B1\",\"severity\":\"high\",\"disposition\":\"blocker\",\"file\":\"pose-mcp/lib.go\",\"line\":1,\"summary\":\"first defect\"},{\"id\":\"B2\",\"severity\":\"medium\",\"disposition\":\"blocker\",\"summary\":\"second defect\"}]}`\n\tfence := \"```\"\n\tscript := `in=$(cat); echo \"session: rounds-sess-01\"; [ -n \"$1\" ] && echo RESUMED-$1; ` +\n\t\t`if printf '%s' \"$in\" | grep -q 'This is round 2'; then printf '%s\\n' 'decision: approved' '` + fence + `pose-draft' '` + second + `' '` + fence + `'; ` +\n\t\t`else printf '%s\\n' 'decision: changes-requested' '` + fence + `pose-draft' '` + first + `' '` + fence + `'; fi`\n\targv, _ := json.Marshal([]string{\"sh\", \"-c\", script, \"x\"})\n\tresume, _ := json.Marshal([]string{\"sh\", \"-c\", script, \"x\", \"{session}\"})\n\treturn `\"` + name + `\": {\"vendor\": \"` + vendor + `\", \"model\": \"` + name + `-1\", \"timeout\": \"30s\",\n      \"commands\": {\"read\": ` + string(argv) + `},\n      \"session\": {\"pattern\": \"session: (\\\\S+)\"},\n      \"resume\": {\"command\": ` + string(resume) + `}}`\n}\n\n// roundsMetric reads the round figures of the one scope insights reports.\nfunc roundsMetric(t *testing.T, out string) posemodel.ReviewRoundMetric {\n\tt.Helper()\n\tvar doc struct {\n\t\tDelegatedReview struct {\n\t\t\tRounds []posemodel.ReviewRoundMetric `json:\"rounds\"`\n\t\t} `json:\"delegated_review\"`\n\t}\n\tif err := json.Unmarshal([]byte(out), &doc); err != nil || len(doc.DelegatedReview.Rounds) != 1 {\n\t\tt.Fatalf(\"insights rounds: %v %s\", err, out)\n\t}\n\treturn doc.DelegatedReview.Rounds[0]\n}\n\nfunc roundRun(t *testing.T, root, agent string) map[string]any {\n\tt.Helper()\n\tcode, out, errOut := runPoseSplit(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", agent, \"--json\", \"--reason\", \"next round\")\n\tvar doc map[string]any\n\tif json.Unmarshal([]byte(out), &doc) != nil || doc[\"status\"] != \"completed\" {\n\t\tt.Fatalf(\"round run: %d %s %s\", code, out, errOut)\n\t}\n\treturn doc\n}\n\nfunc runRecord(t *testing.T, root, id string) posemodel.ReviewRun {\n\tt.Helper()\n\truns, _ := posemodel.Store{Root: root}.ListReviewRuns(\"\")\n\tfor _, r := range runs {\n\t\tif r.RunID == id {\n\t\t\treturn r\n\t\t}\n\t}\n\tt.Fatalf(\"no run %s\", id)\n\treturn posemodel.ReviewRun{}\n}\n\n// R1–R7, R9: round 2 is briefed with round 1's findings, continues the\n// thread's session, and its draft accounts for each; verify discloses the\n// round and the lineage; insights measure convergence.\nfunc TestReviewRoundsContinueTheThreadAndAccountForFindings(t *testing.T) {\n\troot := dispatchInstance(t)\n\twriteDelegation(t, root, delegationPolicy(roundsAgent(\"rounder\", \"other\", false)))\n\tfirst := roundRun(t, root, \"rounder\")\n\tif r := runRecord(t, root, first[\"run\"].(string)); r.Round != 1 || r.Thread != nil || len(r.DraftProblems) != 0 {\n\t\tt.Fatalf(\"round 1: %+v\", r)\n\t}\n\tnextReviewRound(t, root, \"fix B1\")\n\tbrief, err := posemodel.Store{Root: root}.RenderReviewBrief(\"spec:alpha\", \"review\", \"\")\n\tif err != nil || !strings.Contains(brief.Text, \"This is round 2\") || !strings.Contains(brief.Text, \"> R1-B1 (high, blocker, round 1) at pose-mcp/lib.go:1 — first defect\") {\n\t\tt.Fatalf(\"round 2 brief: %v\\n%s\", err, brief.Text)\n\t}\n\tsecond := roundRun(t, root, \"rounder\")\n\tr2 := runRecord(t, root, second[\"run\"].(string))\n\tif r2.Round != 2 || !strings.Contains(r2.Output, \"RESUMED-\") || r2.Thread == nil || r2.Thread.Mode != posemodel.ReviewThreadContinued || r2.Thread.From != first[\"run\"] || len(r2.DraftProblems) != 0 {\n\t\tt.Fatalf(\"round 2: round=%d thread=%+v problems=%v output=%q\", r2.Round, r2.Thread, r2.DraftProblems, r2.Output)\n\t}\n\tif code, out, _ := runPoseSplit(t, root, \"delegate\", \"wait\", second[\"run\"].(string), \"--json\"); code != 0 || !strings.Contains(out, `\"decision\":\"approved\"`) {\n\t\tt.Fatalf(\"wait: %d %s\", code, out)\n\t}\n\t_, out := runPose(t, root, \"review\", \"verify\", \"spec:alpha\")\n\tif !strings.Contains(out, \"review_verify.round=2\") || !strings.Contains(out, \"review_verify.thread.\"+second[\"run\"].(string)+\"=round 2: continued session from \"+first[\"run\"].(string)) {\n\t\tt.Fatalf(\"verify: %s\", out)\n\t}\n\tcode, out := runPose(t, root, \"insights\", \"--json\")\n\tif m := roundsMetric(t, out); code != 0 || m.Scope != \"spec:alpha\" || m.RoundsToApproval == nil || *m.RoundsToApproval != 2 || m.Continued.Rounds != 1 || m.Continued.Approvals != 1 || m.Continued.Accounted != 2 || m.Continued.Fixed != 1 || m.Continued.Partial != 1 {\n\t\tt.Fatalf(\"insights: %d %s\", code, out)\n\t}\n}\n\n// R4, R6, R9: a draft that omits a prior finding is invalid and never an\n// approval, continued session or not; a vendor change opens a new session\n// with its reason; cold-session opens one every round.\nfunc TestReviewRoundsRefuseAnIncompleteAccount(t *testing.T) {\n\troot := dispatchInstance(t)\n\twriteDelegation(t, root, delegationPolicy(roundsAgent(\"rounder\", \"other\", false), roundsAgent(\"sloppy\", \"other\", true), roundsAgent(\"elsewhere\", \"third\", false)))\n\tfirst := roundRun(t, root, \"rounder\")\n\tnextReviewRound(t, root, \"fix B1\")\n\tsecond := roundRun(t, root, \"sloppy\")\n\tr2 := runRecord(t, root, second[\"run\"].(string))\n\tif len(r2.DraftProblems) == 0 || !strings.Contains(strings.Join(r2.DraftProblems, \";\"), \"R1-B2\") {\n\t\tt.Fatalf(\"an incomplete account passed: round=%d thread=%+v problems=%v output=%q\", r2.Round, r2.Thread, r2.DraftProblems, r2.Output)\n\t}\n\tif r2.Thread == nil || r2.Thread.Mode != posemodel.ReviewThreadNew || !strings.Contains(r2.Thread.Reason, \"agent changed\") {\n\t\tt.Fatalf(\"another agent continued the session: %+v\", r2.Thread)\n\t}\n\tif code, out, _ := runPoseSplit(t, root, \"delegate\", \"wait\", second[\"run\"].(string), \"--json\"); code == 0 || !strings.Contains(out, `\"decision\":\"invalid\"`) {\n\t\tt.Fatalf(\"an invalid draft decided: %d %s\", code, out)\n\t}\n\tthird := roundRun(t, root, \"elsewhere\")\n\tif r3 := runRecord(t, root, third[\"run\"].(string)); r3.Thread == nil || r3.Thread.Mode != posemodel.ReviewThreadNew || !strings.Contains(r3.Thread.Reason, \"vendor changed\") {\n\t\tt.Fatalf(\"a vendor change continued the session: %+v\", r3.Thread)\n\t}\n\t_ = first\n\troot = dispatchInstance(t)\n\twriteDelegation(t, root, `{\"schema_version\": 2, \"agents\": {`+roundsAgent(\"rounder\", \"other\", false)+`}, \"routing\": {\"rounds\": \"cold-session\"}, \"purposes\": {\"review\": {\"max_runs_per_bundle\": 5}}}`)\n\troundRun(t, root, \"rounder\")\n\tnextReviewRound(t, root, \"fix B1\")\n\tcold := roundRun(t, root, \"rounder\")\n\tif r := runRecord(t, root, cold[\"run\"].(string)); r.Thread == nil || r.Thread.Mode != posemodel.ReviewThreadNew || !strings.Contains(r.Thread.Reason, \"cold-session\") || strings.Contains(r.Output, \"RESUMED\") {\n\t\tt.Fatalf(\"cold-session continued: %+v %s\", r.Thread, r.Output)\n\t}\n\t// R6, R7: at the round threshold a new session opens and verify warns.\n\troot = dispatchInstance(t)\n\twriteDelegation(t, root, `{\"schema_version\": 2, \"agents\": {`+roundsAgent(\"rounder\", \"other\", false)+`}, \"routing\": {\"round_threshold\": 2}, \"purposes\": {\"review\": {\"max_runs_per_bundle\": 5}}}`)\n\troundRun(t, root, \"rounder\")\n\tnextReviewRound(t, root, \"fix B1\")\n\tlate := roundRun(t, root, \"rounder\")\n\tif r := runRecord(t, root, late[\"run\"].(string)); r.Thread == nil || r.Thread.Mode != posemodel.ReviewThreadNew || !strings.Contains(r.Thread.Reason, \"threshold\") {\n\t\tt.Fatalf(\"the threshold continued the session: %+v\", r.Thread)\n\t}\n\tif _, out := runPose(t, root, \"review\", \"verify\", \"spec:alpha\"); !strings.Contains(out, \"round threshold 2\") {\n\t\tt.Fatalf(\"verify did not warn at the threshold: %s\", out)\n\t}\n\tif code, out, _ := runPoseSplit(t, root, \"delegate\", \"ls\", late[\"run\"].(string), \"--json\"); code != 0 || !strings.Contains(out, `\"round\": 2`) {\n\t\tt.Fatalf(\"ls does not show the round: %d %s\", code, out)\n\t}\n}\n\n// Review round 1, B9, B10, B11: a bundle of an earlier round that cannot be\n// read makes the brief refuse rather than fall back to round 1; ls and\n// insights show the round in text; a resume in round 2 keeps its thread.\nfunc TestReviewRoundsSurviveLossesAndResumes(t *testing.T) {\n\troot := dispatchInstance(t)\n\twriteDelegation(t, root, delegationPolicy(roundsAgent(\"rounder\", \"other\", false)))\n\tfirst := roundRun(t, root, \"rounder\")\n\tnextReviewRound(t, root, \"fix B1\")\n\tif code, out, _ := run