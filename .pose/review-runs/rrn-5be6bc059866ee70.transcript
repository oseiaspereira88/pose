t take it claims nothing, so the\n+\t\t// predecessor stays resumable, and one that lost the race to another\n+\t\t// resume is told the continuation is pending (spec\n+\t\t// pose-review-resume-runtime-dir-followups R1).\n+\t\tdir, err := s.takeContinuationRuntimeDir(plan)\n+\t\tif err != nil {\n+\t\t\treturn ReviewRun{}, err\n+\t\t}\n+\t\tpreparedRuntimeDir = dir\n \t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n+\t\t\tif dir != \"\" {\n+\t\t\t\t_ = os.Remove(dir)\n+\t\t\t}\n \t\t\treturn ReviewRun{}, err\n \t\t}\n \t}\n@@ -806,7 +820,10 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n \t\t}\n \t}\n-\ttmp, err := reviewRunRuntimeDir(run.AttemptID)\n+\ttmp, err := preparedRuntimeDir, error(nil)\n+\tif tmp == \"\" {\n+\t\ttmp, err = reviewRunRuntimeDir(s.runtimeSourceFor(plan, run.AttemptID))\n+\t}\n \tif err != nil {\n \t\treturn finish(ReviewRunFailed, \"runtime directory setup failed: \"+err.Error())\n \t}\n@@ -2040,6 +2057,52 @@ func sourceMaterializationDiffers(root, commit string, entries []ReviewBundleSub\n // os.MkdirTemp, a uint32 in decimal (ten digits).\n const reviewRunRuntimeHex = 10\n \n+// reviewRuntimeNameRE is the form of a runtime directory name a run records\n+// in safety.runtime_id: the stable one, or the random one earlier engines\n+// and runs without an attempt used.\n+var reviewRuntimeNameRE = regexp.MustCompile(`^pose-review-run-[0-9A-Za-z]{1,40}$`)\n+\n+// runtimeSourceOf is what names the runtime directory of a continuation of\n+// prior: the name prior recorded, so the session finds the checkout where it\n+// saw it, also when an earlier engine named it at random (spec\n+// pose-review-resume-runtime-dir-followups R2); otherwise prior's attempt.\n+func runtimeSourceOf(prior ReviewRun) string {\n+\tif prior.Safety != nil && reviewRuntimeNameRE.MatchString(prior.Safety.RuntimeID) {\n+\t\treturn prior.Safety.RuntimeID\n+\t}\n+\treturn prior.AttemptID\n+}\n+\n+// runtimeSourceFor is what names the runtime directory of a run of plan: the\n+// predecessor's, for a continuation; the previous round's run, for a round\n+// that continues its thread, whose session saw that checkout (R3); the\n+// attempt otherwise.\n+func (s Store) runtimeSourceFor(plan DispatchPlan, attemptID string) string {\n+\tif plan.predecessor != nil {\n+\t\treturn runtimeSourceOf(*plan.predecessor)\n+\t}\n+\tvar runs []ReviewRun\n+\tif plan.thread.continued() {\n+\t\truns, _, _ = s.ReadReviewRuns(\"\")\n+\t}\n+\treturn runtimeSourceAmong(plan, attemptID, runs)\n+}\n+\n+// runtimeSourceAmong is runtimeSourceFor over the recorded runs given.\n+func runtimeSourceAmong(plan DispatchPlan, attemptID string, runs []ReviewRun) string {\n+\tif plan.predecessor != nil {\n+\t\treturn runtimeSourceOf(*plan.predecessor)\n+\t}\n+\tif plan.thread.continued() && plan.thread.From != \"\" {\n+\t\tfor _, r := range runs {\n+\t\t\tif r.RunID == plan.thread.From {\n+\t\t\t\treturn runtimeSourceOf(r)\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn attemptID\n+}\n+\n // reviewAttemptIDRE is the form of a delegated review attempt's id.\n var reviewAttemptIDRE = regexp.MustCompile(`^rat-[0-9a-f]{64}$`)\n \n@@ -2058,7 +2121,7 @@ func reviewRunRuntimeDir(attemptID string) (string, error) {\n \t}\n \tif err := os.Mkdir(dir, 0o700); err != nil {\n \t\tif errors.Is(err, fs.ErrExist) {\n-\t\t\treturn \"\", fmt.Errorf(\"the attempt's runtime directory %s already exists; an earlier run of the attempt did not clean up, or another process holds the path; when no run of the attempt is live, remove it, then run again\", dir)\n+\t\t\treturn \"\", fmt.Errorf(\"the attempt's runtime directory %s already exists; an earlier run of the attempt did not clean up, or another process holds the path; when no run of the attempt is live, remove it, then run again: %w\", dir, fs.ErrExist)\n \t\t}\n \t\treturn \"\", err\n \t}\n@@ -2068,6 +2131,11 @@ func reviewRunRuntimeDir(attemptID string) (string, error) {\n // reviewRunRuntimeDirPath is the runtime directory every run of an attempt\n // uses, or false for a run without an attempt.\n func reviewRunRuntimeDirPath(attemptID string) (string, bool) {\n+\t// A runtime name a run recorded is used as it is (spec\n+\t// pose-review-resume-runtime-dir-followups R2, R3).\n+\tif reviewRuntimeNameRE.MatchString(attemptID) {\n+\t\treturn filepath.Join(os.TempDir(), attemptID), true\n+\t}\n \tif !reviewAttemptIDRE.MatchString(attemptID) {\n \t\treturn \"\", false\n \t}\n@@ -2096,3 +2164,47 @@ func reviewRunRuntimeDirFree(attemptID, verb string) error {\n \t}\n \treturn nil\n }\n+\n+// takeContinuationRuntimeDir creates the attempt's runtime directory for a\n+// continuation before its claim. When the directory is there, a claim that\n+// appears meanwhile means another resume holds it: the continuation is\n+// pending. Otherwise the directory belongs to no run of the attempt, and the\n+// resume is refused with nothing claimed.\n+func (s Store) takeContinuationRuntimeDir(plan DispatchPlan) (string, error) {\n+\tsource := runtimeSourceOf(*plan.predecessor)\n+\tif _, ok := reviewRunRuntimeDirPath(source); !ok {\n+\t\treturn \"\", nil\n+\t}\n+\tdir, err := reviewRunRuntimeDir(source)\n+\tif err == nil {\n+\t\treturn dir, nil\n+\t}\n+\tif !errors.Is(err, fs.ErrExist) {\n+\t\treturn \"\", err\n+\t}\n+\t// The resume that took it claims right after; look for that claim.\n+\tif pending := s.awaitContinuationClaim(*plan.predecessor); pending != nil {\n+\t\treturn \"\", pending\n+\t}\n+\treturn \"\", err\n+}\n+\n+// awaitContinuationClaim waits briefly for a claim on prior's continuation,\n+// returning it as pending, or nil when none appears.\n+func (s Store) awaitContinuationClaim(prior ReviewRun) *PendingReviewContinuation {\n+\tfor i := 0; i < 20; i++ {\n+\t\truns, _, err := s.ReadReviewRuns(\"\")\n+\t\tif err == nil {\n+\t\t\texisting, e := s.existingReviewContinuation(prior, runs)\n+\t\t\tvar pending *PendingReviewContinuation\n+\t\t\tif errors.As(e, &pending) {\n+\t\t\t\treturn pending\n+\t\t\t}\n+\t\t\tif e == nil && existing != nil {\n+\t\t\t\treturn &PendingReviewContinuation{ID: \"resume-of:\" + prior.RunID, Predecessor: prior.RunID, AttemptID: prior.AttemptID}\n+\t\t\t}\n+\t\t}\n+\t\ttime.Sleep(100 * time.Millisecond)\n+\t}\n+\treturn nil\n+}\ndiff --git a/pose-mcp/internal/pose/review_run_continuity.go b/pose-mcp/internal/pose/review_run_continuity.go\nindex 66697c22..77ac8f69 100644\n--- a/pose-mcp/internal/pose/review_run_continuity.go\n+++ b/pose-mcp/internal/pose/review_run_continuity.go\n@@ -428,7 +428,14 @@ func (s Store) PlanReviewResume(id string) (DispatchPlan, error) {\n \t}\n \t// Only a continuation still to start needs the attempt's runtime\n \t// directory free; a repeated resume returns the recorded one.\n-\tif e = reviewRunRuntimeDirFree(prior.AttemptID, \"resume\"); e != nil {\n+\tif e = reviewRunRuntimeDirFree(runtimeSourceOf(*prior), \"resume\"); e != nil {\n+\t\t// Another resume takes the directory just before its claim: a claim\n+\t\t// that appears meanwhile makes this one pending (spec\n+\t\t// pose-review-resume-runtime-dir-followups R1).\n+\t\tif pending := s.awaitContinuationClaim(*prior); pending != nil {\n+\t\t\tplan.PendingContinuation = pending\n+\t\t\treturn plan, nil\n+\t\t}\n \t\treturn DispatchPlan{}, e\n \t}\n \t// The attempt's budget, not this agent's: after a handoff the resumed\ndiff --git a/pose-mcp/internal/pose/review_run_runtime_dir_test.go b/pose-mcp/internal/pose/review_run_runtime_dir_test.go\nindex 2bea2bbc..443add55 100644\n--- a/pose-mcp/internal/pose/review_run_runtime_dir_test.go\n+++ b/pose-mcp/internal/pose/review_run_runtime_dir_test.go\n@@ -48,3 +48,61 @@ func TestRunContinuityAttemptRuntimeDirectoryIsCreatedExclusively(t *testing.T)\n \t\tt.Fatalf(\"a run without an attempt: %s %v\", again, err)\n \t}\n }\n+\n+// Spec pose-review-resume-runtime-dir-followups R2, R3: a continuation reuses\n+// the runtime name its predecessor recorded, also a random one of an earlier\n+// engine; a round continuing its thread reuses the previous round's; a name\n+// that is not a runtime name is never used as a path.\n+func TestRunContinuityRuntimeNameFollowsTheSession(t *testing.T) {\n+\ttmp := t.TempDir()\n+\tfor _, name := range []string{\"TMPDIR\", \"TMP\", \"TEMP\"} {\n+\t\tt.Setenv(name, tmp)\n+\t}\n+\tattempt := \"rat-\" + strings.Repeat(\"cd\", 32)\n+\tstable, _ := reviewRunRuntimeDirPath(attempt)\n+\told := ReviewRun{RunID: \"rrn-old\", AttemptID: attempt, Safety: &ReviewExecutionSafety{RuntimeID: \"pose-review-run-1504287996\"}}\n+\tif got := runtimeSourceOf(old); got != \"pose-review-run-1504287996\" {\n+\t\tt.Fatalf(\"an earlier engine's random name was not reused: %s\", got)\n+\t}\n+\tif dir, ok := reviewRunRuntimeDirPath(runtimeSourceOf(old)); !ok || dir != filepath.Join(os.TempDir(), \"pose-review-run-1504287996\") {\n+\t\tt.Fatalf(\"the recorded name's directory: %s %v\", dir, ok)\n+\t}\n+\tbad := ReviewRun{AttemptID: attempt, Safety: &ReviewExecutionSafety{RuntimeID: \"../escape\"}}\n+\tif dir, _ := reviewRunRuntimeDirPath(runtimeSourceOf(bad)); dir != stable {\n+\t\tt.Fatalf(\"a name that is not a runtime name was used: %s\", dir)\n+\t}\n+\tif got := runtimeSourceAmong(DispatchPlan{predecessor: &old}, \"rat-\"+strings.Repeat(\"ef\", 32), nil); got != \"pose-review-run-1504287996\" {\n+\t\tt.Fatalf(\"a continuation did not follow its predecessor: %s\", got)\n+\t}\n+\tthread := DispatchPlan{thread: &ReviewThread{Mode: ReviewThreadContinued, From: \"rrn-old\"}}\n+\tif got := runtimeSourceAmong(thread, \"rat-\"+strings.Repeat(\"ef\", 32), []ReviewRun{old}); got != \"pose-review-run-1504287996\" {\n+\t\tt.Fatalf(\"a continued thread did not follow its previous round: %s\", got)\n+\t}\n+\tfresh := DispatchPlan{thread: &ReviewThread{Mode: ReviewThreadNew, From: \"rrn-old\"}}\n+\tif got := runtimeSourceAmong(fresh, attempt, []ReviewRun{old}); got != attempt {\n+\t\tt.Fatalf(\"a new thread followed the previous round: %s\", got)\n+\t}\n+}\n+\n+// Spec pose-review-resume-runtime-dir-followups R1: the continuation takes\n+// its runtime directory before any claim; a directory already there, with no\n+// claim appearing, refuses it with nothing claimed.\n+func TestRunContinuityTakesTheRuntimeDirectoryBeforeTheClaim(t *testing.T) {\n+\ttmp := t.TempDir()\n+\tfor _, name := range []string{\"TMPDIR\", \"TMP\", \"TEMP\"} {\n+\t\tt.Setenv(name, tmp)\n+\t}\n+\ts := Store{Root: t.TempDir()}\n+\tprior := ReviewRun{RunID: \"rrn-prior\", AttemptID: \"rat-\" + strings.Repeat(\"ab\", 32)}\n+\tplan := DispatchPlan{predecessor: &prior}\n+\tdir, err := s.takeContinuationRuntimeDir(plan)\n+\tif err != nil || dir == \"\" {\n+\t\tt.Fatalf(\"a free directory was not taken: %q %v\", dir, err)\n+\t}\n+\tif _, err := s.takeContinuationRuntimeDir(plan); err == nil || !strings.Contains(err.Error(), \"already exists\") {\n+\t\tt.Fatalf(\"a taken directory was shared: %v\", err)\n+\t}\n+\tif entries, _ := os.ReadDir(filepath.Join(s.Root, \".pose\")); len(entries) != 0 {\n+\t\tt.Fatalf(\"the refused continuation wrote records: %v\", entries)\n+\t}\n+}","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"eb0bfddd-a51c-4e1e-9523-7f71ff6b6352","timestamp":"2026-11-27T07:17:37.638Z","tool_use_result":{"stdout":"diff --git a/.pose/specs/2026-11-26-pose-review-resume-runtime-dir-followups.md b/.pose/specs/2026-11-26-pose-review-resume-runtime-dir-followups.md\nindex 93f68bbb..a8cdfd5b 100644\n--- a/.pose/specs/2026-11-26-pose-review-resume-runtime-dir-followups.md\n+++ b/.pose/specs/2026-11-26-pose-review-resume-runtime-dir-followups.md\n@@ -1,6 +1,6 @@\n ---\n slug: pose-review-resume-runtime-dir-followups\n-status: draft        # draft | in-progress | done | superseded | abandoned; blocked = operational wait, not terminal\n+status: in-progress        # draft | in-progress | done | superseded | abandoned; blocked = operational wait, not terminal\n created_at: 2026-11-26\n completed_at:        # stamped on the transition to status: done\n supersedes:          # slug of the superseded spec (when applicable)\n@@ -10,7 +10,7 @@ priority: 2\n components: pose-mcp\n task_type: bugfix\n surface: standard\n-delivers:            # optional typed refs: surface:id, contract:id, capability:id, infrastructure:id, governance:id\n+delivers: capability:review-resume-runtime-dir-followups\n ---\n \n # Spec: pose-review-resume-runtime-dir-followups\n@@ -33,7 +33,7 @@ Reopening the decisions of the origin spec.\n \n ### Functional\n - R1: The continuation claim and the runtime-directory check shall be one step: a resume or handoff that loses a race shall be told the continuation is pending, never asked to remove a live run's directory; a collision found at creation shall leave the predecessor resumable (rounds 2 N8, 3 N12, 4 N17, 5 N22).\n-- R2: A run interrupted under an engine that named its runtime directory at random (its `safety.runtime_id` differs from the attempt's stable name) shall not be resumed into a checkout its session cannot find: the resume shall refuse and point to a handoff (rounds 3 N11, 4 N18, 5 N23).\n+- R2: A run interrupted under an engine that named its runtime directory at random (its `safety.runtime_id` differs from the attempt's stable name) shall be resumed into a checkout its session can find: the continuation reuses the recorded name, or the resume refuses and points to a handoff (rounds 3 N11, 4 N18, 5 N23).\n - R3: A session continued into a new review round shall be given the checkout path it saw, or the brief shall state the new path, so a continued thread does not meet the same failure (rounds 3 N15, 4 N21, 5 N24).\n - R4: The resume-refusal regression test shall assert the resume's own refusal, not any 'still exists' text in the output (round 5, N25).\n \n@@ -52,33 +52,49 @@ Records and indexes written by earlier engines keep their meaning.\n `pose-mcp`: `review_dispatch.go` (runtime directory), `review_run_continuity.go`, `delegation_handoff.go`, the round-continuation path, and `review_run_continuity_test.go`.\n \n ### Artifacts\n-Declared when the spec starts.\n+- created: .pose/specs/2026-11-26-pose-review-resume-runtime-dir-followups.md\n+- modified: pose-mcp/internal/pose/review_dispatch.go\n+- modified: pose-mcp/internal/pose/review_run_continuity.go\n+- modified: pose-mcp/internal/pose/delegation_handoff.go\n+- modified: pose-mcp/internal/pose/review_run_runtime_dir_test.go\n+- modified: pose-mcp/internal/cli/review_run_continuity_test.go\n \n ### Delivery targets\n-Declared when the spec starts.\n+- capability:review-resume-runtime-dir-followups module:pose-mcp profile:composed-capability entrypoint:pose-mcp/internal/cli/delegate.go\n+\n+### Accepted limits\n+- L1: A recorded runtime name is a path component taken from the run ledger, which the repository holds. Accepted because only names of the form `pose-review-run-<1–40 letters or digits>` are used, always below the temporary directory, and the directory is still created exclusively and never followed.\n \n ### API/contract changes\n-To be detailed when the spec starts.\n+None: run records and briefs are unchanged; a continuation now reads the runtime name its predecessor recorded.\n \n ### Data/storage changes\n-To be detailed when the spec starts.\n+None.\n \n ### Technical risks\n-To be detailed when the spec starts.\n+A resume waits up to two seconds for another resume's claim before it reports an existing directory.\n \n ## 4. Tasks\n \n ### Planning\n-- [ ] Confirm each requirement against the current engine before starting.\n+- [x] Confirm each requirement against the current engine before starting.\n \n ### Implementation\n-- [ ] Implement each requirement with a test that fails before it.\n+- [x] Implement each requirement with a test that fails before it.\n \n ### Validation\n - [ ] `pose validate --carry` and `pose check --strict`.\n \n ## 5. Decisions\n \n+### Decision D1\n+- Basis: R1\n+The attempt's runtime directory is the lock: a continuation creates it, exclusively, before it claims the predecessor, and removes it if the claim fails. A resume that cannot create it has claimed nothing, so the predecessor stays resumable; when the directory is there, a claim that appears within two seconds means another resume holds it, and the continuation is reported pending. The plan-time check waits for a claim the same way.\n+\n+### Decision D2\n+- Basis: R2, R3\n+The runtime directory of a continuation is named by what its predecessor recorded in `safety.runtime_id`, so a session finds the checkout where it saw it, also when an earlier engine named it at random; a round that continues its thread takes the name of the previous round's run. Only an attempt's first run derives the name from the attempt id. This answers R2 by resuming instead of refusing.\n+\n ## 6. Validation\n \n ### Strategy\n@@ -90,22 +106,33 @@ Each requirement gets a regression test shown failing before its code.\n - Command: `go test ./...` (in `pose-mcp`), then `pose validate --carry`.\n \n ### Execution log\n+- 2026-11-27: D1 in `RunReviewDispatch` (`takeContinuationRuntimeDir`) and in the plans (`awaitContinuationClaim`); D2 by `runtimeSourceOf` and `runtimeSourceAmong`; the refusal test asserts the resume's own wording (`then resume again`). `TestRunContinuityTakesTheRuntimeDirectoryBeforeTheClaim`, `TestRunContinuityRuntimeNameFollowsTheSession` and `TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath` fail with each guard mutated out (the recorded name, the thread's source, the name's path, the exclusive take, the verb).\n \n ### Results summary\n+The full `pose-mcp` suite passes; the canonical result is refreshed with `pose validate --carry`.\n \n ### Requirement trace\n+- R1 [satisfied] test:TestRunContinuityTakesTheRuntimeDirectoryBeforeTheClaim, test:TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath\n+- R2 [satisfied] test:TestRunContinuityRuntimeNameFollowsTheSession\n+- R3 [satisfied] test:TestRunContinuityRuntimeNameFollowsTheSession\n+- R4 [satisfied] test:TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath\n \n ### Known gaps\n+None.\n \n ## 7. Final Report\n \n ### Delivered scope\n+A continuation takes the attempt's runtime directory before its claim, and every continuation, including a run from an earlier engine and a round continuing its thread, recreates the checkout under the name its session saw.\n \n ### Files and modules changed\n+`pose-mcp` review dispatch, resume and handoff plans, and their tests.\n \n ### Validation executed\n+`go test ./...` in `pose-mcp`; `pose check --strict`; `pose validate --carry --json-out .pose/results/delivery-validation.json`.\n \n ### Residual risks\n+L1 above.\n \n ### Follow-ups\n-Origin: `pose-review-resume-keeps-the-sealed-checkout` (done 2026-11-26).\n+None. Origin: `pose-review-resume-keeps-the-sealed-checkout` (done 2026-11-26).\ndiff --git a/pose-mcp/internal/cli/review_run_continuity_test.go b/pose-mcp/internal/cli/review_run_continuity_test.go\nindex 414ace8f..9ea10c6c 100644\n--- a/pose-mcp/internal/cli/review_run_continuity_test.go\n+++ b/pose-mcp/internal/cli/review_run_continuity_test.go\n@@ -317,7 +317,7 @@ func TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath(t *testin\n \tif err := os.Mkdir(runtimeDir, 0o700); err != nil {\n \t\tt.Fatal(err)\n \t}\n-\tif code, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID); code == 0 || !strings.Contains(out, \"still exists\") {\n+\tif code, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID); code == 0 || !strings.Contains(out, \"then resume again\") {\n \t\tt.Fatalf(\"a resume beside a leftover runtime directory: %d %s\", code, out)\n \t}\n \t// Review round 2, N6: a handoff is refused the same way, before it\n@@ -328,6 +328,23 @@ func TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath(t *testin\n \tif err := os.Remove(runtimeDir); err != nil {\n \t\tt.Fatal(err)\n \t}\n+\t// Spec pose-review-resume-runtime-dir-followups R1: a directory that\n+\t// appears between the plan and the dispatch is refused before the claim,\n+\t// so the interrupted run stays resumable.\n+\tstore := posemodel.Store{Root: root}\n+\tplan, err := store.PlanReviewResume(prior.RunID)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.Mkdir(runtimeDir, 0o700); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif _, err := store.RunReviewDispatch(plan, time.Now); err == nil || !(strings.Contains(err.Error(), \"already exists\") || strings.Contains(err.Error(), \"still exists\")) {\n+\t\tt.Fatalf(\"a dispatch beside a directory that appeared: %v\", err)\n+\t}\n+\tif err := os.Remove(runtimeDir); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n \tcode, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID)\n \tif code != 0 || !strings.Contains(out, \"status=completed\") {\n \t\tt.Fatalf(\"the resumed session did not find its checkout at %s: %d %s\", checkout, code, out)\ndiff --git a/pose-mcp/internal/pose/delegation_handoff.go b/pose-mcp/internal/pose/delegation_handoff.go\nindex c5b6278b..c157a8cb 100644\n--- a/pose-mcp/internal/pose/delegation_handoff.go\n+++ b/pose-mcp/internal/pose/delegation_handoff.go\n@@ -344,7 +344,14 @@ func (s Store) PlanReviewHandoff(id, agent string) (DispatchPlan, error) {\n \t}\n \t// A handoff runs in the attempt's runtime directory too (spec\n \t// pose-review-resume-keeps-the-sealed-checkout, review round 2, N6).\n-\tif e = reviewRunRuntimeDirFree(prior.AttemptID, \"hand off\"); e != nil {\n+\tif e = reviewRunRuntimeDirFree(runtimeSourceOf(*prior), \"hand off\"); e != nil {\n+\t\t// Another resume takes the directory just before its claim: a claim\n+\t\t// that appears meanwhile makes this one pending (spec\n+\t\t// pose-review-resume-runtime-dir-followups R1).\n+\t\tif pending := s.awaitContinuationClaim(*prior); pending != nil {\n+\t\t\tplan.PendingContinuation = pending\n+\t\t\treturn plan, nil\n+\t\t}\n \t\treturn DispatchPlan{}, e\n \t}\n \tcount, spent, limit, total, e := attemptContinuationBudget(runs, *prior, policy)\ndiff --git a/pose-mcp/internal/pose/review_dispatch.go b/pose-mcp/internal/pose/review_dispatch.go\nindex ec60960f..6f59ccbc 100644\n--- a/pose-mcp/internal/pose/review_dispatch.go\n+++ b/pose-mcp/internal/pose/review_dispatch.go\n@@ -713,6 +713,7 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t\treturn finish(ReviewRunFailed, \"the run was not started: \"+err.Error())\n \t}\n \tvar attempt DelegatedReviewAttempt\n+\tpreparedRuntimeDir := \"\"\n \tif plan.predecessor == nil {\n \t\tvar err error\n \t\tattempt, err = s.prepareDelegatedReviewAttempt(plan, now())\n@@ -743,7 +744,20 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t\trun.TreeDigest = fresh.predecessor.TreeDigest\n \t\t// A continuation is the same task: it keeps the predecessor's name and purpose.\n \t\trun.Label, run.Purpose, run.Lead = fresh.predecessor.Label, fresh.predecessor.Purpose, fresh.predecessor.Lead\n+\t\t// The attempt's runtime directory is taken before the claim, and is\n+\t\t// the lock: a resume that cannot take it claims nothing, so the\n+\t\t// predecessor stays resumable, and one that lost the race to another\n+\t\t// resume is told the continuation is pending (spec\n+\t\t// pose-review-resume-runtime-dir-followups R1).\n+\t\tdir, err := s.takeContinuationRuntimeDir(plan)\n+\t\tif err != nil {\n+\t\t\treturn ReviewRun{}, err\n+\t\t}\n+\t\tpreparedRuntimeDir = dir\n \t\tif err := s.claimReviewContinuation(*fresh.predecessor, now()); err != nil {\n+\t\t\tif dir != \"\" {\n+\t\t\t\t_ = os.Remove(dir)\n+\t\t\t}\n \t\t\treturn ReviewRun{}, err\n \t\t}\n \t}\n@@ -806,7 +820,10 @@ func (s Store) RunReviewDispatchContext(parent context.Context, plan DispatchPla\n \t\t\treturn finish(ReviewRunFailed, \"the run was not started: its attempt could not be handed back: \"+err.Error())\n \t\t}\n \t}\n-\ttmp, err := reviewRunRuntimeDir(run.AttemptID)\n+\ttmp, err := preparedRuntimeDir, error(nil)\n+\tif tmp == \"\" {\n+\t\ttmp, err = reviewRunRuntimeDir(s.runtimeSourceFor(plan, run.AttemptID))\n+\t}\n \tif err != nil {\n \t\treturn finish(ReviewRunFailed, \"runtime directory setup failed: \"+err.Error())\n \t}\n@@ -2040,6 +2057,52 @@ func sourceMaterializationDiffers(root, commit string, entries []ReviewBundleSub\n // os.MkdirTemp, a uint32 in decimal (ten digits).\n const reviewRunRuntimeHex = 10\n \n+// reviewRuntimeNameRE is the form of a runtime directory name a run records\n+// in safety.runtime_id: the stable one, or the random one earlier engines\n+// and runs without an attempt used.\n+var reviewRuntimeNameRE = regexp.MustCompile(`^pose-review-run-[0-9A-Za-z]{1,40}$`)\n+\n+// runtimeSourceOf is what names the runtime directory of a continuation of\n+// prior: the name prior recorded, so the session finds the checkout where it\n+// saw it, also when an earlier engine named it at random (spec\n+// pose-review-resume-runtime-dir-followups R2); otherwise prior's attempt.\n+func runtimeSourceOf(prior ReviewRun) string {\n+\tif prior.Safety != nil && reviewRuntimeNameRE.MatchString(prior.Safety.RuntimeID) {\n+\t\treturn prior.Safety.RuntimeID\n+\t}\n+\treturn prior.AttemptID\n+}\n+\n+// runtimeSourceFor is what names the runtime directory of a run of plan: the\n+// predecessor's, for a continuation; the previous round's run, for a round\n+// that continues its thread, whose session saw that checkout (R3); the\n+// attempt otherwise.\n+func (s Store) runtimeSourceFor(plan DispatchPlan, attemptID string) string {\n+\tif plan.predecessor != nil {\n+\t\treturn runtimeSourceOf(*plan.predecessor)\n+\t}\n+\tvar runs []ReviewRun\n+\tif plan.thread.continued() {\n+\t\truns, _, _ = s.ReadReviewRuns(\"\")\n+\t}\n+\treturn runtimeSourceAmong(plan, attemptID, runs)\n+}\n+\n+// runtimeSourceAmong is runtimeSourceFor over the recorded runs given.\n+func runtimeSourceAmong(plan DispatchPlan, attemptID string, runs []ReviewRun) string {\n+\tif plan.predecessor != nil {\n+\t\treturn runtimeSourceOf(*plan.predecessor)\n+\t}\n+\tif plan.thread.continued() && plan.thread.From != \"\" {\n+\t\tfor _, r := range runs {\n+\t\t\tif r.RunID == plan.thread.From {\n+\t\t\t\treturn runtimeSourceOf(r)\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn attemptID\n+}\n+\n // reviewAttemptIDRE is the form of a delegated review attempt's id.\n var reviewAttemptIDRE = regexp.MustCompile(`^rat-[0-9a-f]{64}$`)\n \n@@ -2058,7 +2121,7 @@ func reviewRunRuntimeDir(attemptID string) (string, error) {\n \t}\n \tif err := os.Mkdir(dir, 0o700); err != nil {\n \t\tif errors.Is(err, fs.ErrExist) {\n-\t\t\treturn \"\", fmt.Errorf(\"the attempt's runtime directory %s already exists; an earlier run of the attempt did not clean up, or another process holds the path; when no run of the attempt is live, remove it, then run again\", dir)\n+\t\t\treturn \"\", fmt.Errorf(\"the attempt's runtime directory %s already exists; an earlier run of the attempt did not clean up, or another process holds the path; when no run of the attempt is live, remove it, then run again: %w\", dir, fs.ErrExist)\n \t\t}\n \t\treturn \"\", err\n \t}\n@@ -2068,6 +2131,11 @@ func reviewRunRuntimeDir(attemptID string) (string, error) {\n // reviewRunRuntimeDirPath is the runtime directory every run of an attempt\n // uses, or false for a run without an attempt.\n func reviewRunRuntimeDirPath(attemptID string) (string, bool) {\n+\t// A runtime name a run recorded is used as it is (spec\n+\t// pose-review-resume-runtime-dir-followups R2, R3).\n+\tif reviewRuntimeNameRE.MatchString(attemptID) {\n+\t\treturn filepath.Join(os.TempDir(), attemptID), true\n+\t}\n \tif !reviewAttemptIDRE.MatchString(attemptID) {\n \t\treturn \"\", false\n \t}\n@@ -2096,3 +2164,47 @@ func reviewRunRuntimeDirFree(attemptID, verb string) error {\n \t}\n \treturn nil\n }\n+\n+// takeContinuationRuntimeDir creates the attempt's runtime directory for a\n+// continuation before its claim. When the directory is there, a claim that\n+// appears meanwhile means another resume holds it: the continuation is\n+// pending. Otherwise the directory belongs to no run of the attempt, and the\n+// resume is refused with nothing claimed.\n+func (s Store) takeContinuationRuntimeDir(plan DispatchPlan) (string, error) {\n+\tsource := runtimeSourceOf(*plan.predecessor)\n+\tif _, ok := reviewRunRuntimeDirPath(source); !ok {\n+\t\treturn \"\", nil\n+\t}\n+\tdir, err := reviewRunRuntimeDir(source)\n+\tif err == nil {\n+\t\treturn dir, nil\n+\t}\n+\tif !errors.Is(err, fs.ErrExist) {\n+\t\treturn \"\", err\n+\t}\n+\t// The resume that took it claims right after; look for that claim.\n+\tif pending := s.awaitContinuationClaim(*plan.predecessor); pending != nil {\n+\t\treturn \"\", pending\n+\t}\n+\treturn \"\", err\n+}\n+\n+// awaitContinuationClaim waits briefly for a claim on prior's continuation,\n+// returning it as pending, or nil when none appears.\n+func (s Store) awaitContinuationClaim(prior ReviewRun) *PendingReviewContinuation {\n+\tfor i := 0; i < 20; i++ {\n+\t\truns, _, err := s.ReadReviewRuns(\"\")\n+\t\tif err == nil {\n+\t\t\texisting, e := s.existingReviewContinuation(prior, runs)\n+\t\t\tvar pending *PendingReviewContinuation\n+\t\t\tif errors.As(e, &pending) {\n+\t\t\t\treturn pending\n+\t\t\t}\n+\t\t\tif e == nil && existing != nil {\n+\t\t\t\treturn &PendingReviewContinuation{ID: \"resume-of:\" + prior.RunID, Predecessor: prior.RunID, AttemptID: prior.AttemptID}\n+\t\t\t}\n+\t\t}\n+\t\ttime.Sleep(100 * time.Millisecond)\n+\t}\n+\treturn nil\n+}\ndiff --git a/pose-mcp/internal/pose/review_run_continuity.go b/pose-mcp/internal/pose/review_run_continuity.go\nindex 66697c22..77ac8f69 100644\n--- a/pose-mcp/internal/pose/review_run_continuity.go\n+++ b/pose-mcp/internal/pose/review_run_continuity.go\n@@ -428,7 +428,14 @@ func (s Store) PlanReviewResume(id string) (DispatchPlan, error) {\n \t}\n \t// Only a continuation still to start needs the attempt's runtime\n \t// directory free; a repeated resume returns the recorded one.\n-\tif e = reviewRunRuntimeDirFree(prior.AttemptID, \"resume\"); e != nil {\n+\tif e = reviewRunRuntimeDirFree(runtimeSourceOf(*prior), \"resume\"); e != nil {\n+\t\t// Another resume takes the directory just before its claim: a claim\n+\t\t// that appears meanwhile makes this one pending (spec\n+\t\t// pose-review-resume-runtime-dir-followups R1).\n+\t\tif pending := s.awaitContinuationClaim(*prior); pending != nil {\n+\t\t\tplan.PendingContinuation = pending\n+\t\t\treturn plan, nil\n+\t\t}\n \t\treturn DispatchPlan{}, e\n \t}\n \t// The attempt's budget, not this agent's: after a handoff the resumed\ndiff --git a/pose-mcp/internal/pose/review_run_runtime_dir_test.go b/pose-mcp/internal/pose/review_run_runtime_dir_test.go\nindex 2bea2bbc..443add55 100644\n--- a/pose-mcp/internal/pose/review_run_runtime_dir_test.go\n+++ b/pose-mcp/internal/pose/review_run_runtime_dir_test.go\n@@ -48,3 +48,61 @@ func TestRunContinuityAttemptRuntimeDirectoryIsCreatedExclusively(t *testing.T)\n \t\tt.Fatalf(\"a run without an attempt: %s %v\", again, err)\n \t}\n }\n+\n+// Spec pose-review-resume-runtime-dir-followups R2, R3: a continuation reuses\n+// the runtime name its predecessor recorded, also a random one of an earlier\n+// engine; a round continuing its thread reuses the previous round's; a name\n+// that is not a runtime name is never used as a path.\n+func TestRunContinuityRuntimeNameFollowsTheSession(t *testing.T) {\n+\ttmp := t.TempDir()\n+\tfor _, name := range []string{\"TMPDIR\", \"TMP\", \"TEMP\"} {\n+\t\tt.Setenv(name, tmp)\n+\t}\n+\tattempt := \"rat-\" + strings.Repeat(\"cd\", 32)\n+\tstable, _ := reviewRunRuntimeDirPath(attempt)\n+\told := ReviewRun{RunID: \"rrn-old\", AttemptID: attempt, Safety: &ReviewExecutionSafety{RuntimeID: \"pose-review-run-1504287996\"}}\n+\tif got := runtimeSourceOf(old); got != \"pose-review-run-1504287996\" {\n+\t\tt.Fatalf(\"an earlier engine's random name was not reused: %s\", got)\n+\t}\n+\tif dir, ok := reviewRunRuntimeDirPath(runtimeSourceOf(old)); !ok || dir != filepath.Join(os.TempDir(), \"pose-review-run-1504287996\") {\n+\t\tt.Fatalf(\"the recorded name's directory: %s %v\", dir, ok)\n+\t}\n+\tbad := ReviewRun{AttemptID: attempt, Safety: &ReviewExecutionSafety{RuntimeID: \"../escape\"}}\n+\tif dir, _ := reviewRunRuntimeDirPath(runtimeSourceOf(bad)); dir != stable {\n+\t\tt.Fatalf(\"a name that is not a runtime name was used: %s\", dir)\n+\t}\n+\tif got := runtimeSourceAmong(DispatchPlan{predecessor: &old}, \"rat-\"+strings.Repeat(\"ef\", 32), nil); got != \"pose-review-run-1504287996\" {\n+\t\tt.Fatalf(\"a continuation did not follow its predecessor: %s\", got)\n+\t}\n+\tthread := DispatchPlan{thread: &ReviewThread{Mode: ReviewThreadContinued, From: \"rrn-old\"}}\n+\tif got := runtimeSourceAmong(thread, \"rat-\"+strings.Repeat(\"ef\", 32), []ReviewRun{old}); got != \"pose-review-run-1504287996\" {\n+\t\tt.Fatalf(\"a continued thread did not follow its previous round: %s\", got)\n+\t}\n+\tfresh := DispatchPlan{thread: &ReviewThread{Mode: ReviewThreadNew, From: \"rrn-old\"}}\n+\tif got := runtimeSourceAmong(fresh, attempt, []ReviewRun{old}); got != attempt {\n+\t\tt.Fatalf(\"a new thread followed the previous round: %s\", got)\n+\t}\n+}\n+\n+// Spec pose-review-resume-runtime-dir-followups R1: the continuation takes\n+// its runtime directory before any claim; a directory already there, with no\n+// claim appearing, refuses it with nothing claimed.\n+func TestRunContinuityTakesTheRuntimeDirectoryBeforeTheClaim(t *testing.T) {\n+\ttmp := t.TempDir()\n+\tfor _, name := range []string{\"TMPDIR\", \"TMP\", \"TEMP\"} {\n+\t\tt.Setenv(name, tmp)\n+\t}\n+\ts := Store{Root: t.TempDir()}\n+\tprior := ReviewRun{RunID: \"rrn-prior\", AttemptID: \"rat-\" + strings.Repeat(\"ab\", 32)}\n+\tplan := DispatchPlan{predecessor: &prior}\n+\tdir, err := s.takeContinuationRuntimeDir(plan)\n+\tif err != nil || dir == \"\" {\n+\t\tt.Fatalf(\"a free directory was not taken: %q %v\", dir, err)\n+\t}\n+\tif _, err := s.takeContinuationRuntimeDir(plan); err == nil || !strings.Contains(err.Error(), \"already exists\") {\n+\t\tt.Fatalf(\"a taken directory was shared: %v\", err)\n+\t}\n+\tif entries, _ := os.ReadDir(filepath.Join(s.Root, \".pose\")); len(entries) != 0 {\n+\t\tt.Fatalf(\"the refused continuation wrote records: %v\", entries)\n+\t}\n+}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01AJyE5EHDBSyRTmJ2YqaTkv","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
