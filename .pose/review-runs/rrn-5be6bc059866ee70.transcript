on the index, not on the\n+// revisions it compares (review round 5, N23).\n+var ErrIndexUnreadable = errors.New(\"the index cannot be read\")\n+\n+// indexLookupTimeout bounds the lookup of the index's path.\n+const indexLookupTimeout = 30 * time.Second\n+\n // ReadOnlyIndex prepares cmd, a git command reading the repository at root,\n // to read root's index without being able to write it. The returned function\n // releases what it holds; call it after the command ends.\n func ReadOnlyIndex(cmd *exec.Cmd, root string) (func(), error) {\n-\tout, err := RawGit(\"-C\", root, \"rev-parse\", \"--path-format=absolute\", \"--git-path\", \"index\").Output()\n+\tctx, cancel := context.WithTimeout(context.Background(), indexLookupTimeout)\n+\tdefer cancel()\n+\treturn ReadOnlyIndexContext(ctx, cmd, root)\n+}\n+\n+// ReadOnlyIndexContext is ReadOnlyIndex with the lookup of the index bound by\n+// ctx, the caller's deadline (review round 1, N3).\n+func ReadOnlyIndexContext(ctx context.Context, cmd *exec.Cmd, root string) (func(), error) {\n+\t// `--git-path` without `--path-format`, which Git before 2.31 would echo\n+\t// back as a path that does not exist (review round 5, N26): the answer is\n+\t// relative to root unless absolute.\n+\tlookup := gitCommandContext(ctx, \"--no-replace-objects\", \"-C\", root, \"rev-parse\", \"--git-path\", \"index\")\n+\tGitEnglish(lookup)\n+\tvar lookupErr bytes.Buffer\n+\tlookup.Stderr = &lookupErr\n+\tout, err := lookup.Output()\n \tif err != nil {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be located: %w\", root, err)\n+\t\t// Not an index failure: no repository, a broken config or HEAD; Git's\n+\t\t// own words say which (review round 2, N14).\n+\t\treturn func() {}, GitReadError(\"pose: locating the index of \"+root, err, lookupErr.Bytes())\n \t}\n \tpath := strings.TrimSuffix(string(out), \"\\n\")\n-\tbefore, err := os.Stat(path)\n+\tif !filepath.IsAbs(path) {\n+\t\tpath = filepath.Join(root, path)\n+\t}\n+\t// Opened without blocking, so a FIFO or device there cannot hang the\n+\t// read, and judged on the open file, so an index another process\n+\t// replaces atomically is read whole, as Git reads it (review rounds 4\n+\t// N21, 5 N22).\n+\tf, err := openIndexNoBlock(path)\n \tif os.IsNotExist(err) {\n \t\t// No index yet: there is no stat cache to refresh, so the plain read\n \t\t// writes nothing (review round 2, N11).\n \t\treturn func() {}, nil\n \t}\n-\t// A FIFO or device is refused before it is opened, which could block\n-\t// (review round 4, N21); the open file must be the file checked, and is\n-\t// read within the bound (round 3, N17).\n-\tif err != nil || !before.Mode().IsRegular() {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is not a regular file\", root)\n-\t}\n-\tf, err := os.Open(path)\n \tif err != nil {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w\", root, err)\n+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w: %w\", root, ErrIndexUnreadable, err)\n \t}\n \tdefer f.Close()\n \tinfo, err := f.Stat()\n-\tif err != nil || !info.Mode().IsRegular() || !os.SameFile(before, info) {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s changed while it was opened\", root)\n+\tif err != nil || !info.Mode().IsRegular() {\n+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is not a regular file: %w\", root, ErrIndexUnreadable)\n \t}\n \traw, err := io.ReadAll(io.LimitReader(f, diffIndexLimit+1))\n \tif err != nil {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w\", root, err)\n+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s cannot be read: %w: %w\", root, ErrIndexUnreadable, err)\n \t}\n \tif len(raw) > diffIndexLimit {\n-\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is larger than %d bytes\", root, diffIndexLimit)\n+\t\treturn func() {}, fmt.Errorf(\"pose: the index of %s is larger than %d bytes: %w\", root, diffIndexLimit, ErrIndexUnreadable)\n \t}\n \t// The copy keeps the index's modification time: Git trusts an entry on\n \t// its stat only when the file is older than the index, so a fresher copy\n \t// would hide a change made in the index's own second (review round 2,\n \t// N10, racy-clean entries).\n-\treturn readOnlyIndexFor(cmd, raw, info.ModTime())\n+\t// Git's messages in English, so GitReadError can tell an index failure\n+\t// whatever the user's locale.\n+\tGitEnglish(cmd)\n+\tdone, err := readOnlyIndexFor(cmd, raw, info.ModTime())\n+\tif err != nil {\n+\t\treturn done, fmt.Errorf(\"pose: the index of %s cannot be handed to git: %w: %w\", root, ErrIndexUnreadable, err)\n+\t}\n+\treturn done, nil\n+}\n+\n+// gitReadSaidLimit bounds what a read error keeps of Git's standard error.\n+const gitReadSaidLimit = 600\n+\n+// GitReadError describes a failed git read with what git said on standard\n+// error, all of it on one line and bounded, so a warning Git prints first\n+// does not hide the cause (review round 3, N17). It does not guess from the\n+// words whether the index was at fault: ErrIndexUnreadable marks only the\n+// failures of ReadOnlyIndex itself (review rounds 2 N13, 3 N18).\n+func GitReadError(what string, err error, stderr []byte) error {\n+\t// Git's fatal and error lines first, so a long warning before them does\n+\t// not push the cause past the bound (review round 4, N25).\n+\tvar first, rest []string\n+\tfor _, line := range strings.Split(string(stderr), \"\\n\") {\n+\t\tline = strings.Join(strings.Fields(line), \" \")\n+\t\tswitch {\n+\t\tcase line == \"\":\n+\t\tcase strings.HasPrefix(line, \"fatal:\") || strings.HasPrefix(line, \"error:\"):\n+\t\t\tfirst = append(first, line)\n+\t\tdefault:\n+\t\t\trest = append(rest, line)\n+\t\t}\n+\t}\n+\tsaid := strings.Join(append(first, rest...), \" ; \")\n+\tif len(said) > gitReadSaidLimit {\n+\t\tsaid = said[:gitReadSaidLimit] + \"…\"\n+\t}\n+\tif said == \"\" {\n+\t\treturn fmt.Errorf(\"%s failed: %w\", what, err)\n+\t}\n+\treturn fmt.Errorf(\"%s failed: %w: %s\", what, err, said)\n+}\n+\n+// GitEnglish makes cmd's messages English, so the causes reported read the\n+// same in every locale.\n+func GitEnglish(cmd *exec.Cmd) {\n+\tcmd.Env = append(cmd.Env, \"LC_ALL=C\", \"LANGUAGE=C\")\n+}\n+\n+// privateIndexCopy hands raw to cmd as a private copy: Git refreshes and may\n+// rewrite the copy, never the checkout's index.\n+func privateIndexCopy(cmd *exec.Cmd, raw []byte, modTime time.Time) (func(), error) {\n+\tdir, err := os.MkdirTemp(\"\", \"pose-index-*\")\n+\tif err != nil {\n+\t\treturn func() {}, err\n+\t}\n+\tdone := func() { _ = os.RemoveAll(d","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/home/go/.claude/projects/-var-tmp-pose-work-go-pose-review-run-28c7b07899-worktree/[private-session]/tool-results/bca10uw7i.txt","persistedOutputSize":58604},"tool_result_meta":[{"id":"toolu_019nTH7YHBwL4DoRnbvXncYp","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
