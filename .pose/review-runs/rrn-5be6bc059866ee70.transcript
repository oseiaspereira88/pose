{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EMxN981ETTTS5KeXWXrwpN","type":"tool_result","content":"1\tpackage pose\n2\t\n3\t// Review rounds (spec pose-delegated-review-round-protocol).\n4\t//\n5\t// The rounds of a scope are the sealed bundles of that scope a completed\n6\t// delegated review concluded on, in the order those runs ended. A round after\n7\t// the first is briefed with the open findings of the round before, each with\n8\t// the identity it was first given, and its draft must account for every one\n9\t// of them and say what it swept (R1–R5, D2). The draft is the fenced\n10\t// `pose-draft` block of the reviewer's final message: JSON, versioned, read\n11\t// strictly; prose around it is the reviewer's and is not read.\n12\t\n13\timport (\n14\t\t\"bytes\"\n15\t\t\"encoding/json\"\n16\t\t\"fmt\"\n17\t\t\"io\"\n18\t\t\"reflect\"\n19\t\t\"regexp\"\n20\t\t\"sort\"\n21\t\t\"strings\"\n22\t\t\"time\"\n23\t)\n24\t\n25\t// ReviewDraftSchema is the schema of a pose-draft block.\n26\tconst ReviewDraftSchema = \"pose.review.draft/v1\"\n27\t\n28\tconst (\n29\t\treviewDraftFence            = \"```pose-draft\"\n30\t\treviewDraftMaxFindings      = 500\n31\t\treviewDraftMaxText          = 4000\n32\t\tReviewRoundThresholdDefault = 5\n33\t)\n34\t\n35\t// A finding's own identifier never carries a round prefix, which the engine\n36\t// reserves; the identity it is carried under is that prefix and the\n37\t// identifier, so the mapping is injective (review round 1, B2, B12).\n38\tvar (\n39\t\treviewFindingID   = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n40\t\treviewRoundPrefix = regexp.MustCompile(`^R[0-9]+-`)\n41\t\treviewCarriedID   = regexp.MustCompile(`^R[0-9]{1,6}-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n42\t\t// reviewDraftOpening is any fence line that names pose-draft.\n43\t\treviewDraftOpening = regexp.MustCompile(\"^(`{3,}|~{3,})\\\\s*pose-draft\")\n44\t)\n45\t\n46\t// ReviewDraftFinding is one finding a draft reports.\n47\ttype ReviewDraftFinding struct {\n48\t\tID          string `json:\"id\"`\n49\t\tSeverity    string `json:\"severity\"`\n50\t\tDisposition string `json:\"disposition\"`\n51\t\tFile        string `json:\"file,omitempty\"`\n52\t\tLine        int    `json:\"line,omitempty\"`\n53\t\tSummary     string `json:\"summary\"`\n54\t\t// Action, Owner and ReviewBy let a follow-up become an accepted risk in\n55\t\t// the attestation the engine records (spec\n56\t\t// pose-delegated-review-conclusions R1).\n57\t\tAction   string `json:\"action,omitempty\"`\n58\t\tOwner    string `json:\"owner,omitempty\"`\n59\t\tReviewBy string `json:\"review_by,omitempty\"`\n60\t\t// Limit names the declared accepted limit the finding falls inside\n61\t\t// (spec pose-review-declared-threat-model R2).\n62\t\tLimit string `json:\"limit,omitempty\"`\n63\t}\n64\t\n65\t// ReviewDraftCriterion answers one criterion of the plan, as the reviewer of\n66\t// a recorded attestation does (spec pose-delegated-review-conclusions R1).\n67\ttype ReviewDraftCriterion struct {\n68\t\tID          string `json:\"id\"`\n69\t\tDisposition string `json:\"disposition\"`\n70\t\tEvidence    string `json:\"evidence,omitempty\"`\n71\t\tRationale   string `json:\"rationale,omitempty\"`\n72\t\t// Mappings answer the structural facts the criterion is responsible for,\n73\t\t// as `--criterion` mappings do; the writer's gate judges them (review\n74\t\t// round 1, B4).\n75\t\tMappings []ReviewCriterionMapping `json:\"mappings,omitempty\"`\n76\t}\n77\t\n78\t// ReviewDraftTool is the disposition of one tool the plan requires.\n79\ttype ReviewDraftTool struct {\n80\t\tID          string `json:\"id\"`\n81\t\tComponent   string `json:\"component,omitempty\"`\n82\t\tDisposition string `json:\"disposition\"`\n83\t\tEvidence    string `json:\"evidence,omitempty\"`\n84\t\tRationale   string `json:\"rationale,omitempty\"`\n85\t}\n86\t\n87\t// ReviewDraftPrior is a draft's account of one prior finding (R3, R4).\n88\ttype ReviewDraftPrior struct {\n89\t\tID       string `json:\"id\"`\n90\t\tStatus   string `json:\"status\"`\n91\t\tEvidence string `json:\"evidence\"`\n92\t}\n93\t\n94\t// ReviewDraft is the pose-draft block of a reviewer's final message.\n95\ttype ReviewDraft struct {\n96\t\tSchema        string               `json:\"schema\"`\n97\t\tDecision      string               `json:\"decision\"`\n98\t\tFindings      []ReviewDraftFinding `json:\"findings\"`\n99\t\tPriorFindings []ReviewDraftPrior   `json:\"prior_findings,omitempty\"`\n100\t\tSweep         string               `json:\"sweep,omitempty\"`\n101\t\t// Criteria and Tools are the typed conclusion the engine records as an\n102\t\t// attestation (spec pose-delegated-review-conclusions R1).\n103\t\tCriteria []ReviewDraftCriterion `json:\"criteria,omitempty\"`\n104\t\tTools    []ReviewDraftTool      `json:\"tools,omitempty\"`\n105\t\t// Questions and Surfaces are the typed verdict of an adjudication and of\n106\t\t// a smoke run, recorded where their origin reads them (spec\n107\t\t// pose-delegated-verdict-destinations R1, R2).\n108\t\tQuestions []ReviewDraftQuestion `json:\"questions,omitempty\"`\n109\t\tSurfaces  []ReviewDraftSurface  `json:\"surfaces,omitempty\"`\n110\t\t// BusinessDecision is a question the reviewer cannot answer from the\n111\t\t// code, for a person to decide (spec\n112\t\t// pose-delegated-review-action-fulfillment R7).\n113\t\tBusinessDecision *ReviewDraftBusinessDecision `json:\"business_decision,omitempty\"`\n114\t}\n115\t\n116\t// ReviewDraftBusinessDecision is a business question and its options.\n117\ttype ReviewDraftBusinessDecision struct {\n118\t\tQuestion string         `json:\"question\"`\n119\t\tOptions  []ActionOption `json:\"options\"`\n120\t}\n121\t\n122\t// ReviewDraftQuestion is an adjudication's verdict on one question the\n123\t// scope records: a decision (D<n>) or a requirement (R<n>).\n124\ttype ReviewDraftQuestion struct {\n125\t\tID        string `json:\"id\"`\n126\t\tVerdict   string `json:\"verdict\"`\n127\t\tEvidence  string `json:\"evidence,omitempty\"`\n128\t\tRationale string `json:\"rationale\"`\n129\t}\n130\t\n131\t// ReviewDraftSurface is what a smoke run observed on one delivery target.\n132\ttype ReviewDraftSurface struct {\n133\t\tRef      string   `json:\"ref\"`\n134\t\tOutcome  string   `json:\"outcome\"`\n135\t\tCommands []string `json:\"commands\"`\n136\t\tObserved string   `json:\"observed\"`\n137\t}\n138\t\n139\t// Adjudication verdicts and smoke outcomes.\n140\tconst (\n141\t\tAdjudicationHolds           = \"holds\"\n142\t\tAdjudicationDoesNotHold     = \"does-not-hold\"\n143\t\tAdjudicationCannotDetermine = \"cannot-determine\"\n144\t\tSmokeObserved               = \"observed\"\n145\t\tSmokeNotObserved            = \"not-observed\"\n146\t\tSmokeNotReachable           = \"not-reachable\"\n147\t)\n148\t\n149\tvar adjudicationQuestionID = regexp.MustCompile(`^[DR][0-9]{1,4}$`)\n150\t\n151\t// Prior finding statuses (R3).\n152\tconst (\n153\t\tPriorFindingFixed      = \"fixed\"\n154\t\tPriorFindingPartial    = \"partial\"\n155\t\tPriorFindingNotFixed   = \"not-fixed\"\n156\t\tPriorFindingSuperseded = \"superseded\"\n157\t)\n158\t\n159\t// ParseReviewDraft reads the pose-draft block of output: nil when there is\n160\t// none, an error when the block is not one valid draft. Fences are whole\n161\t// lines, LF or CRLF: an opening line is exactly \"```pose-draft\", the block\n162\t// closes at the first line that is exactly \"```\", and any other line that\n163\t// starts a fence before it, or a second block, is an error, never a block\n164\t// read as absent (review round 2, R2-B2). Every decision line outside the\n165\t// block must agree with it (R2-B1).\n166\tfunc ParseReviewDraft(output string) (*ReviewDraft, error) {\n167\t\tlines := strings.Split(output, \"\\n\")\n168\t\tfor i := range lines {\n169\t\t\tlines[i] = strings.TrimSuffix(lines[i], \"\\r\")\n170\t\t}\n171\t\topen, close := -1, -1\n172\t\tfor i, line := range lines {\n173\t\t\ttrimmed := strings.TrimSpace(line)\n174\t\t\t// Any fence that names pose-draft — indented, spaced, longer, or\n175\t\t\t// with tildes — is an attempt at a block: only the exact form opens\n176\t\t\t// one, and any other is an error (review round 3, R3-B1).\n177\t\t\tattempt := reviewDraftOpening.MatchString(trimmed)\n178\t\t\tswitch {\n179\t\t\tcase attempt && (open >= 0 || line != reviewDraftFence):\n180\t\t\t\tif close >= 0 || open >= 0 {\n181\t\t\t\t\treturn nil, fmt.Errorf(\"the message carries more than one pose-draft block\")\n182\t\t\t\t}\n183\t\t\t\treturn nil, fmt.Errorf(\"line %d opens a pose-draft block in a form the engine does not read: %q\", i+1, quoteLedgerText(line))\n184\t\t\tcase attempt:\n185\t\t\t\topen = i\n186\t\t\tcase open >= 0 && close < 0 && (strings.HasPrefix(trimmed, \"```\") || strings.HasPrefix(trimmed, \"~~~\")):\n187\t\t\t\tif line != \"```\" {\n188\t\t\t\t\treturn nil, fmt.Errorf(\"line %d inside the pose-draft block is not its closing fence: %q\", i+1, quoteLedgerText(line))\n189\t\t\t\t}\n190\t\t\t\tclose = i\n191\t\t\t}\n192\t\t}\n193\t\tif open < 0 {\n194\t\t\treturn nil, nil\n195\t\t}\n196\t\tif close < 0 {\n197\t\t\treturn nil, fmt.Errorf(\"the pose-draft block is not closed\")\n198\t\t}\n199\t\traw := []byte(strings.Join(lines[open+1:close], \"\\n\"))\n200\t\tvar draft ReviewDraft\n201\t\tdec := json.NewDecoder(bytes.NewReader(raw))\n202\t\tdec.DisallowUnknownFields()\n203\t\tif err := dec.Decode(&draft); err != nil {\n204\t\t\treturn nil, fmt.Errorf(\"the pose-draft block is not a draft: %v\", err)\n205\t\t}\n206\t\tif _, err := dec.Token(); err != io.EOF {\n207\t\t\treturn nil, fmt.Errorf(\"the pose-draft block carries data after the draft\")\n208\t\t}\n209\t\tif err := exactJSONKeys(json.NewDecoder(bytes.NewReader(raw)), reflect.TypeOf(draft)); err != nil {\n210\t\t\treturn nil, fmt.Errorf(\"the pose-draft block is ambiguous: %v\", err)\n211\t\t}\n212\t\tif err := validateReviewDraft(draft); err != nil {\n213\t\t\treturn nil, err\n214\t\t}\n215\t\tfor i, line := range lines {\n216\t\t\tif i > open && i <= close {\n217\t\t\t\tcontinue\n218\t\t\t}\n219\t\t\tkey, value, ok := strings.Cut(strings.TrimSpace(line), \":\")\n220\t\t\tif ok && key == \"decision\" && strings.TrimSpace(value) != draft.Decision {\n221\t\t\t\treturn nil, fmt.Errorf(\"the draft's decision %s differs from the decision line %q\", draft.Decision, strings.TrimSpace(value))\n222\t\t\t}\n223\t\t}\n224\t\treturn &draft, nil\n225\t}\n226\t\n227\t// draftReviewDecision is the decision a run's final message declares: the\n228\t// pose-draft block's when there is one, which a contradicting decision line\n229\t// makes unknown, or else the legacy decision line (review round 1, B13).\n230\tfunc draftReviewDecision(output string) string {\n231\t\tdraft, err := ParseReviewDraft(output)\n232\t\tswitch {\n233\t\tcase err != nil:\n234\t\t\treturn \"unknown\"\n235\t\tcase draft != nil:\n236\t\t\treturn draft.Decision\n237\t\t}\n238\t\treturn legacyReviewDecision(output)\n239\t}\n240\t\n241\tfunc validateReviewDraft(d ReviewDraft) error {\n242\t\tif d.Schema != ReviewDraftSchema {\n243\t\t\treturn fmt.Errorf(\"the draft's schema is %q, not %s\", d.Schema, ReviewDraftSchema)\n244\t\t}\n245\t\tswitch d.Decision {\n246\t\tcase \"approved\", \"changes-requested\", \"rejected\":\n247\t\tdefault:\n248\t\t\treturn fmt.Errorf(\"the draft's decision %q is not approved, changes-requested or rejected\", d.Decision)\n249\t\t}\n250\t\tif len(d.Findings) > reviewDraftMaxFindings || len(d.PriorFindings) > reviewDraftMaxFindings || len(d.Sweep) > reviewDraftMaxText {\n251\t\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n252\t\t}\n253\t\tseen := map[string]bool{}\n254\t\tfor _, f := range d.Findings {\n255\t\t\tswitch {\n256\t\t\tcase !reviewFindingID.MatchString(f.ID) || reviewRoundPrefix.MatchString(f.ID) || seen[f.ID]:\n257\t\t\t\treturn fmt.Errorf(\"finding id %q is not a unique identifier without a round prefix\", f.ID)\n258\t\t\tcase f.Severity != \"high\" && f.Severity != \"medium\" && f.Severity != \"low\":\n259\t\t\t\treturn fmt.Errorf(\"finding %s: severity %q is not high, medium or low\", f.ID, f.Severity)\n260\t\t\tcase f.Disposition != \"blocker\" && f.Disposition != \"follow-up\":\n261\t\t\t\treturn fmt.Errorf(\"finding %s: disposition %q is not blocker or follow-up\", f.ID, f.Disposition)\n262\t\t\tcase strings.TrimSpace(f.Summary) == \"\" || len(f.Summary) > reviewDraftMaxText || len(f.File) > 1024 || f.Line < 0:\n263\t\t\t\treturn fmt.Errorf(\"finding %s needs a bounded summary and location\", f.ID)\n264\t\t\t}\n265\t\t\tseen[f.ID] = true\n266\t\t}\n267\t\tanswered := map[string]bool{}\n268\t\tfor _, c := range d.Criteria {\n269\t\t\tswitch {\n270\t\t\tcase ValidateSlug(c.ID) != nil || answered[c.ID]:\n271\t\t\t\treturn fmt.Errorf(\"criterion %q is not a unique criterion id\", c.ID)\n272\t\t\tcase c.Disposition != \"passed\" && c.Disposition != \"finding\" && c.Disposition != \"not-applicable\":\n273\t\t\t\treturn fmt.Errorf(\"criterion %s: disposition %q is not passed, finding or not-applicable\", c.ID, c.Disposition)\n274\t\t\tcase len(c.Evidence) > reviewDraftMaxText || len(c.Rationale) > reviewDraftMaxText || len(c.Mappings) > reviewDraftMaxFindings:\n275\t\t\t\treturn fmt.Errorf(\"criterion %s exceeds its bounds\", c.ID)\n276\t\t\t}\n277\t\t\tfor _, m := range c.Mappings {\n278\t\t\t\tif strings.TrimSpace(m.Delta) == \"\" || len(m.Delta) > 256 || len(m.Basis) > 256 || len(m.Disposition) > 64 || len(m.Rationale) > reviewDraftMaxText || len(m.Owner) > 256 || len(m.ReviewBy) > 64 {\n279\t\t\t\t\treturn fmt.Errorf(\"criterion %s: a mapping needs a delta and bounded text\", c.ID)\n280\t\t\t\t}\n281\t\t\t}\n282\t\t\tanswered[c.ID] = true\n283\t\t}\n284\t\tfor _, t := range d.Tools {\n285\t\t\tif ValidateSlug(t.ID) != nil || strings.TrimSpace(t.Disposition) == \"\" || len(t.Evidence) > reviewDraftMaxText || len(t.Rationale) > reviewDraftMaxText || len(t.Component) > 256 {\n286\t\t\t\treturn fmt.Errorf(\"tool %q needs an id, a disposition and bounded text\", t.ID)\n287\t\t\t}\n288\t\t}\n289\t\tfor _, f := range d.Findings {\n290\t\t\tif len(f.Action) > reviewDraftMaxText || len(f.Owner) > 256 || len(f.ReviewBy) > 64 {\n291\t\t\t\treturn fmt.Errorf(\"finding %s exceeds its bounds\", f.ID)\n292\t\t\t}\n293\t\t}\n294\t\tif len(d.Criteria) > reviewDraftMaxFindings || len(d.Tools) > reviewDraftMaxFindings || len(d.Questions) > reviewDraftMaxFindings || len(d.Surfaces) > reviewDraftMaxFindings {\n295\t\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n296\t\t}\n297\t\tif b := d.BusinessDecision; b != nil {\n298\t\t\tif strings.TrimSpace(b.Question) == \"\" || len(b.Question) > reviewDraftMaxText || len(b.Options) < 2 || len(b.Options) > 8 {\n299\t\t\t\treturn fmt.Errorf(\"a business decision needs a bounded question and two to eight options\")\n300\t\t\t}\n301\t\t\tseen := map[string]bool{}\n302\t\t\tfor _, o := range b.Options {\n303\t\t\t\tif ValidateSlug(o.ID) != nil || seen[o.ID] || strings.TrimSpace(o.Consequence) == \"\" || len(o.Consequence) > reviewDraftMaxText {\n304\t\t\t\t\treturn fmt.Errorf(\"business decision option %q needs a unique slug and its consequence\", o.ID)\n305\t\t\t\t}\n306\t\t\t\tseen[o.ID] = true\n307\t\t\t}\n308\t\t}\n309\t\tasked := map[string]bool{}\n310\t\tfor _, q := range d.Questions {\n311\t\t\tswitch {\n312\t\t\tcase !adjudicationQuestionID.MatchString(q.ID) || asked[q.ID]:\n313\t\t\t\treturn fmt.Errorf(\"question %q is not a unique decision or requirement id\", q.ID)\n314\t\t\tcase q.Verdict != AdjudicationHolds && q.Verdict != AdjudicationDoesNotHold && q.Verdict != AdjudicationCannotDetermine:\n315\t\t\t\treturn fmt.Errorf(\"question %s: verdict %q is not holds, does-not-hold or cannot-determine\", q.ID, q.Verdict)\n316\t\t\tcase strings.TrimSpace(q.Rationale) == \"\" || len(q.Rationale) > reviewDraftMaxText || len(q.Evidence) > reviewDraftMaxText:\n317\t\t\t\treturn fmt.Errorf(\"question %s needs a bounded rationale\", q.ID)\n318\t\t\t}\n319\t\t\tasked[q.ID] = true\n320\t\t}\n321\t\tobserved := map[string]bool{}\n322\t\tfor _, sf := range d.Surfaces {\n323\t\t\tswitch {\n324\t\t\tcase !deliveryRefRE.MatchString(sf.Ref) || observed[sf.Ref]:\n325\t\t\t\treturn fmt.Errorf(\"surface %q is not a unique delivery target\", sf.Ref)\n326\t\t\tcase sf.Outcome != SmokeObserved && sf.Outcome != SmokeNotObserved && sf.Outcome != SmokeNotReachable:\n327\t\t\t\treturn fmt.Errorf(\"surface %s: outcome %q is not observed, not-observed or not-reachable\", sf.Ref, sf.Outcome)\n328\t\t\tcase len(sf.Commands) == 0 || len(sf.Commands) > 64 || strings.TrimSpace(sf.Observed) == \"\" || len(sf.Observed) > reviewDraftMaxText:\n329\t\t\t\treturn fmt.Errorf(\"surface %s needs the commands run and what was observed\", sf.Ref)\n330\t\t\t}"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"5696b910-f56d-4d85-a762-1af4a6990b4d","timestamp":"2026-11-27T07:18:30.803Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-28c7b07899/worktree/pose-mcp/internal/pose/review_rounds.go","content":"package pose\n\n// Review rounds (spec pose-delegated-review-round-protocol).\n//\n// The rounds of a scope are the sealed bundles of that scope a completed\n// delegated review concluded on, in the order those runs ended. A round after\n// the first is briefed with the open findings of the round before, each with\n// the identity it was first given, and its draft must account for every one\n// of them and say what it swept (R1–R5, D2). The draft is the fenced\n// `pose-draft` block of the reviewer's final message: JSON, versioned, read\n// strictly; prose around it is the reviewer's and is not read.\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"reflect\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strings\"\n\t\"time\"\n)\n\n// ReviewDraftSchema is the schema of a pose-draft block.\nconst ReviewDraftSchema = \"pose.review.draft/v1\"\n\nconst (\n\treviewDraftFence            = \"```pose-draft\"\n\treviewDraftMaxFindings      = 500\n\treviewDraftMaxText          = 4000\n\tReviewRoundThresholdDefault = 5\n)\n\n// A finding's own identifier never carries a round prefix, which the engine\n// reserves; the identity it is carried under is that prefix and the\n// identifier, so the mapping is injective (review round 1, B2, B12).\nvar (\n\treviewFindingID   = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n\treviewRoundPrefix = regexp.MustCompile(`^R[0-9]+-`)\n\treviewCarriedID   = regexp.MustCompile(`^R[0-9]{1,6}-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n\t// reviewDraftOpening is any fence line that names pose-draft.\n\treviewDraftOpening = regexp.MustCompile(\"^(`{3,}|~{3,})\\\\s*pose-draft\")\n)\n\n// ReviewDraftFinding is one finding a draft reports.\ntype ReviewDraftFinding struct {\n\tID          string `json:\"id\"`\n\tSeverity    string `json:\"severity\"`\n\tDisposition string `json:\"disposition\"`\n\tFile        string `json:\"file,omitempty\"`\n\tLine        int    `json:\"line,omitempty\"`\n\tSummary     string `json:\"summary\"`\n\t// Action, Owner and ReviewBy let a follow-up become an accepted risk in\n\t// the attestation the engine records (spec\n\t// pose-delegated-review-conclusions R1).\n\tAction   string `json:\"action,omitempty\"`\n\tOwner    string `json:\"owner,omitempty\"`\n\tReviewBy string `json:\"review_by,omitempty\"`\n\t// Limit names the declared accepted limit the finding falls inside\n\t// (spec pose-review-declared-threat-model R2).\n\tLimit string `json:\"limit,omitempty\"`\n}\n\n// ReviewDraftCriterion answers one criterion of the plan, as the reviewer of\n// a recorded attestation does (spec pose-delegated-review-conclusions R1).\ntype ReviewDraftCriterion struct {\n\tID          string `json:\"id\"`\n\tDisposition string `json:\"disposition\"`\n\tEvidence    string `json:\"evidence,omitempty\"`\n\tRationale   string `json:\"rationale,omitempty\"`\n\t// Mappings answer the structural facts the criterion is responsible for,\n\t// as `--criterion` mappings do; the writer's gate judges them (review\n\t// round 1, B4).\n\tMappings []ReviewCriterionMapping `json:\"mappings,omitempty\"`\n}\n\n// ReviewDraftTool is the disposition of one tool the plan requires.\ntype ReviewDraftTool struct {\n\tID          string `json:\"id\"`\n\tComponent   string `json:\"component,omitempty\"`\n\tDisposition string `json:\"disposition\"`\n\tEvidence    string `json:\"evidence,omitempty\"`\n\tRationale   string `json:\"rationale,omitempty\"`\n}\n\n// ReviewDraftPrior is a draft's account of one prior finding (R3, R4).\ntype ReviewDraftPrior struct {\n\tID       string `json:\"id\"`\n\tStatus   string `json:\"status\"`\n\tEvidence string `json:\"evidence\"`\n}\n\n// ReviewDraft is the pose-draft block of a reviewer's final message.\ntype ReviewDraft struct {\n\tSchema        string               `json:\"schema\"`\n\tDecision      string               `json:\"decision\"`\n\tFindings      []ReviewDraftFinding `json:\"findings\"`\n\tPriorFindings []ReviewDraftPrior   `json:\"prior_findings,omitempty\"`\n\tSweep         string               `json:\"sweep,omitempty\"`\n\t// Criteria and Tools are the typed conclusion the engine records as an\n\t// attestation (spec pose-delegated-review-conclusions R1).\n\tCriteria []ReviewDraftCriterion `json:\"criteria,omitempty\"`\n\tTools    []ReviewDraftTool      `json:\"tools,omitempty\"`\n\t// Questions and Surfaces are the typed verdict of an adjudication and of\n\t// a smoke run, recorded where their origin reads them (spec\n\t// pose-delegated-verdict-destinations R1, R2).\n\tQuestions []ReviewDraftQuestion `json:\"questions,omitempty\"`\n\tSurfaces  []ReviewDraftSurface  `json:\"surfaces,omitempty\"`\n\t// BusinessDecision is a question the reviewer cannot answer from the\n\t// code, for a person to decide (spec\n\t// pose-delegated-review-action-fulfillment R7).\n\tBusinessDecision *ReviewDraftBusinessDecision `json:\"business_decision,omitempty\"`\n}\n\n// ReviewDraftBusinessDecision is a business question and its options.\ntype ReviewDraftBusinessDecision struct {\n\tQuestion string         `json:\"question\"`\n\tOptions  []ActionOption `json:\"options\"`\n}\n\n// ReviewDraftQuestion is an adjudication's verdict on one question the\n// scope records: a decision (D<n>) or a requirement (R<n>).\ntype ReviewDraftQuestion struct {\n\tID        string `json:\"id\"`\n\tVerdict   string `json:\"verdict\"`\n\tEvidence  string `json:\"evidence,omitempty\"`\n\tRationale string `json:\"rationale\"`\n}\n\n// ReviewDraftSurface is what a smoke run observed on one delivery target.\ntype ReviewDraftSurface struct {\n\tRef      string   `json:\"ref\"`\n\tOutcome  string   `json:\"outcome\"`\n\tCommands []string `json:\"commands\"`\n\tObserved string   `json:\"observed\"`\n}\n\n// Adjudication verdicts and smoke outcomes.\nconst (\n\tAdjudicationHolds           = \"holds\"\n\tAdjudicationDoesNotHold     = \"does-not-hold\"\n\tAdjudicationCannotDetermine = \"cannot-determine\"\n\tSmokeObserved               = \"observed\"\n\tSmokeNotObserved            = \"not-observed\"\n\tSmokeNotReachable           = \"not-reachable\"\n)\n\nvar adjudicationQuestionID = regexp.MustCompile(`^[DR][0-9]{1,4}$`)\n\n// Prior finding statuses (R3).\nconst (\n\tPriorFindingFixed      = \"fixed\"\n\tPriorFindingPartial    = \"partial\"\n\tPriorFindingNotFixed   = \"not-fixed\"\n\tPriorFindingSuperseded = \"superseded\"\n)\n\n// ParseReviewDraft reads the pose-draft block of output: nil when there is\n// none, an error when the block is not one valid draft. Fences are whole\n// lines, LF or CRLF: an opening line is exactly \"```pose-draft\", the block\n// closes at the first line that is exactly \"```\", and any other line that\n// starts a fence before it, or a second block, is an error, never a block\n// read as absent (review round 2, R2-B2). Every decision line outside the\n// block must agree with it (R2-B1).\nfunc ParseReviewDraft(output string) (*ReviewDraft, error) {\n\tlines := strings.Split(output, \"\\n\")\n\tfor i := range lines {\n\t\tlines[i] = strings.TrimSuffix(lines[i], \"\\r\")\n\t}\n\topen, close := -1, -1\n\tfor i, line := range lines {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\t// Any fence that names pose-draft — indented, spaced, longer, or\n\t\t// with tildes — is an attempt at a block: only the exact form opens\n\t\t// one, and any other is an error (review round 3, R3-B1).\n\t\tattempt := reviewDraftOpening.MatchString(trimmed)\n\t\tswitch {\n\t\tcase attempt && (open >= 0 || line != reviewDraftFence):\n\t\t\tif close >= 0 || open >= 0 {\n\t\t\t\treturn nil, fmt.Errorf(\"the message carries more than one pose-draft block\")\n\t\t\t}\n\t\t\treturn nil, fmt.Errorf(\"line %d opens a pose-draft block in a form the engine does not read: %q\", i+1, quoteLedgerText(line))\n\t\tcase attempt:\n\t\t\topen = i\n\t\tcase open >= 0 && close < 0 && (strings.HasPrefix(trimmed, \"```\") || strings.HasPrefix(trimmed, \"~~~\")):\n\t\t\tif line != \"```\" {\n\t\t\t\treturn nil, fmt.Errorf(\"line %d inside the pose-draft block is not its closing fence: %q\", i+1, quoteLedgerText(line))\n\t\t\t}\n\t\t\tclose = i\n\t\t}\n\t}\n\tif open < 0 {\n\t\treturn nil, nil\n\t}\n\tif close < 0 {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block is not closed\")\n\t}\n\traw := []byte(strings.Join(lines[open+1:close], \"\\n\"))\n\tvar draft ReviewDraft\n\tdec := json.NewDecoder(bytes.NewReader(raw))\n\tdec.DisallowUnknownFields()\n\tif err := dec.Decode(&draft); err != nil {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block is not a draft: %v\", err)\n\t}\n\tif _, err := dec.Token(); err != io.EOF {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block carries data after the draft\")\n\t}\n\tif err := exactJSONKeys(json.NewDecoder(bytes.NewReader(raw)), reflect.TypeOf(draft)); err != nil {\n\t\treturn nil, fmt.Errorf(\"the pose-draft block is ambiguous: %v\", err)\n\t}\n\tif err := validateReviewDraft(draft); err != nil {\n\t\treturn nil, err\n\t}\n\tfor i, line := range lines {\n\t\tif i > open && i <= close {\n\t\t\tcontinue\n\t\t}\n\t\tkey, value, ok := strings.Cut(strings.TrimSpace(line), \":\")\n\t\tif ok && key == \"decision\" && strings.TrimSpace(value) != draft.Decision {\n\t\t\treturn nil, fmt.Errorf(\"the draft's decision %s differs from the decision line %q\", draft.Decision, strings.TrimSpace(value))\n\t\t}\n\t}\n\treturn &draft, nil\n}\n\n// draftReviewDecision is the decision a run's final message declares: the\n// pose-draft block's when there is one, which a contradicting decision line\n// makes unknown, or else the legacy decision line (review round 1, B13).\nfunc draftReviewDecision(output string) string {\n\tdraft, err := ParseReviewDraft(output)\n\tswitch {\n\tcase err != nil:\n\t\treturn \"unknown\"\n\tcase draft != nil:\n\t\treturn draft.Decision\n\t}\n\treturn legacyReviewDecision(output)\n}\n\nfunc validateReviewDraft(d ReviewDraft) error {\n\tif d.Schema != ReviewDraftSchema {\n\t\treturn fmt.Errorf(\"the draft's schema is %q, not %s\", d.Schema, ReviewDraftSchema)\n\t}\n\tswitch d.Decision {\n\tcase \"approved\", \"changes-requested\", \"rejected\":\n\tdefault:\n\t\treturn fmt.Errorf(\"the draft's decision %q is not approved, changes-requested or rejected\", d.Decision)\n\t}\n\tif len(d.Findings) > reviewDraftMaxFindings || len(d.PriorFindings) > reviewDraftMaxFindings || len(d.Sweep) > reviewDraftMaxText {\n\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n\t}\n\tseen := map[string]bool{}\n\tfor _, f := range d.Findings {\n\t\tswitch {\n\t\tcase !reviewFindingID.MatchString(f.ID) || reviewRoundPrefix.MatchString(f.ID) || seen[f.ID]:\n\t\t\treturn fmt.Errorf(\"finding id %q is not a unique identifier without a round prefix\", f.ID)\n\t\tcase f.Severity != \"high\" && f.Severity != \"medium\" && f.Severity != \"low\":\n\t\t\treturn fmt.Errorf(\"finding %s: severity %q is not high, medium or low\", f.ID, f.Severity)\n\t\tcase f.Disposition != \"blocker\" && f.Disposition != \"follow-up\":\n\t\t\treturn fmt.Errorf(\"finding %s: disposition %q is not blocker or follow-up\", f.ID, f.Disposition)\n\t\tcase strings.TrimSpace(f.Summary) == \"\" || len(f.Summary) > reviewDraftMaxText || len(f.File) > 1024 || f.Line < 0:\n\t\t\treturn fmt.Errorf(\"finding %s needs a bounded summary and location\", f.ID)\n\t\t}\n\t\tseen[f.ID] = true\n\t}\n\tanswered := map[string]bool{}\n\tfor _, c := range d.Criteria {\n\t\tswitch {\n\t\tcase ValidateSlug(c.ID) != nil || answered[c.ID]:\n\t\t\treturn fmt.Errorf(\"criterion %q is not a unique criterion id\", c.ID)\n\t\tcase c.Disposition != \"passed\" && c.Disposition != \"finding\" && c.Disposition != \"not-applicable\":\n\t\t\treturn fmt.Errorf(\"criterion %s: disposition %q is not passed, finding or not-applicable\", c.ID, c.Disposition)\n\t\tcase len(c.Evidence) > reviewDraftMaxText || len(c.Rationale) > reviewDraftMaxText || len(c.Mappings) > reviewDraftMaxFindings:\n\t\t\treturn fmt.Errorf(\"criterion %s exceeds its bounds\", c.ID)\n\t\t}\n\t\tfor _, m := range c.Mappings {\n\t\t\tif strings.TrimSpace(m.Delta) == \"\" || len(m.Delta) > 256 || len(m.Basis) > 256 || len(m.Disposition) > 64 || len(m.Rationale) > reviewDraftMaxText || len(m.Owner) > 256 || len(m.ReviewBy) > 64 {\n\t\t\t\treturn fmt.Errorf(\"criterion %s: a mapping needs a delta and bounded text\", c.ID)\n\t\t\t}\n\t\t}\n\t\tanswered[c.ID] = true\n\t}\n\tfor _, t := range d.Tools {\n\t\tif ValidateSlug(t.ID) != nil || strings.TrimSpace(t.Disposition) == \"\" || len(t.Evidence) > reviewDraftMaxText || len(t.Rationale) > reviewDraftMaxText || len(t.Component) > 256 {\n\t\t\treturn fmt.Errorf(\"tool %q needs an id, a disposition and bounded text\", t.ID)\n\t\t}\n\t}\n\tfor _, f := range d.Findings {\n\t\tif len(f.Action) > reviewDraftMaxText || len(f.Owner) > 256 || len(f.ReviewBy) > 64 {\n\t\t\treturn fmt.Errorf(\"finding %s exceeds its bounds\", f.ID)\n\t\t}\n\t}\n\tif len(d.Criteria) > reviewDraftMaxFindings || len(d.Tools) > reviewDraftMaxFindings || len(d.Questions) > reviewDraftMaxFindings || len(d.Surfaces) > reviewDraftMaxFindings {\n\t\treturn fmt.Errorf(\"the draft exceeds its bounds\")\n\t}\n\tif b := d.BusinessDecision; b != nil {\n\t\tif strings.TrimSpace(b.Question) == \"\" || len(b.Question) > reviewDraftMaxText || len(b.Options) < 2 || len(b.Options) > 8 {\n\t\t\treturn fmt.Errorf(\"a business decision needs a bounded question and two to eight options\")\n\t\t}\n\t\tseen := map[string]bool{}\n\t\tfor _, o := range b.Options {\n\t\t\tif ValidateSlug(o.ID) != nil || seen[o.ID] || strings.TrimSpace(o.Consequence) == \"\" || len(o.Consequence) > reviewDraftMaxText {\n\t\t\t\treturn fmt.Errorf(\"business decision option %q needs a unique slug and its consequence\", o.ID)\n\t\t\t}\n\t\t\tseen[o.ID] = true\n\t\t}\n\t}\n\tasked := map[string]bool{}\n\tfor _, q := range d.Questions {\n\t\tswitch {\n\t\tcase !adjudicationQuestionID.MatchString(q.ID) || asked[q.ID]:\n\t\t\treturn fmt.Errorf(\"question %q is not a unique decision or requirement id\", q.ID)\n\t\tcase q.Verdict != AdjudicationHolds && q.Verdict != AdjudicationDoesNotHold && q.Verdict != AdjudicationCannotDetermine:\n\t\t\treturn fmt.Errorf(\"question %s: verdict %q is not holds, does-not-hold or cannot-determine\", q.ID, q.Verdict)\n\t\tcase strings.TrimSpace(q.Rationale) == \"\" || len(q.Rationale) > reviewDraftMaxText || len(q.Evidence) > reviewDraftMaxText:\n\t\t\treturn fmt.Errorf(\"question %s needs a bounded rationale\", q.ID)\n\t\t}\n\t\tasked[q.ID] = true\n\t}\n\tobserved := map[string]bool{}\n\tfor _, sf := range d.Surfaces {\n\t\tswitch {\n\t\tcase !deliveryRefRE.MatchString(sf.Ref) || observed[sf.Ref]:\n\t\t\treturn fmt.Errorf(\"surface %q is not a unique delivery target\", sf.Ref)\n\t\tcase sf.Outcome != SmokeObserved && sf.Outcome != SmokeNotObserved && sf.Outcome != SmokeNotReachable:\n\t\t\treturn fmt.Errorf(\"surface %s: outcome %q is not observed, not-observed or not-reachable\", sf.Ref, sf.Outcome)\n\t\tcase len(sf.Commands) == 0 || len(sf.Commands) > 64 || strings.TrimSpace(sf.Observed) == \"\" || len(sf.Observed) > reviewDraftMaxText:\n\t\t\treturn fmt.Errorf(\"surface %s needs the commands run and what was observed\", sf.Ref)\n\t\t}","numLines":330,"startLine":1,"totalLines":895}},"tool_result_meta":[{"id":"toolu_01EMxN981ETTTS5KeXWXrwpN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011ChT2NVimMzmJfHc8d2QJU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UZoAUMEo9yP3tkN4TikiWq","name":"Read","input":{"file_path":"/var/tmp/pose-work-go/pose-review-run-28c7b07899/worktree/pose-mcp/internal/pose/review_dispatch.go","offset":2040,"limit":180},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22513,"cache_read_input_tokens":59446,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22513},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"56d35ef9-a9f6-476c-96d7-a02b80da4d7e","timestamp":"2026-11-27T07:18:31.547Z","request_id":"req_011ChT2NVZLDqesPerQhBrbD","wire_tool_inputs":{"toolu_01UZoAUMEo9yP3tkN4TikiWq":{"file_path":"/var/tmp/pose-work-go/pose-review-run-28c7b07899/worktree/pose-mcp/internal/pose/review_dispatch.go","offset":2040,"limit":180}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UZoAUMEo9yP3tkN4TikiWq","type":"tool_result","content":"2040\t\t\t\tif info.Mode()&os.ModeSymlink == 0 || rerr != nil || gitBlobID(\"sha1\", []byte(target)) != object && gitBlobID(\"sha256\", []byte(target)) != object {\n2041\t\t\t\t\treturn rel + \" (it is not the link the sealed commit records)\"\n2042\t\t\t\t}\n2043\t\t\tdefault:\n2044\t\t\t\tif !info.Mode().IsRegular() {\n2045\t\t\t\t\treturn rel + \" (it is not a regular file, and the sealed commit records one)\"\n2046\t\t\t\t}\n2047\t\t\t\tif runtime.GOOS != \"windows\" && (info.Mode().Perm()&0o111 != 0) != (mode == \"100755\") {\n2048\t\t\t\t\treturn rel + \" (its executable bit differs)\"\n2049\t\t\t\t}\n2050\t\t\t}\n2051\t\t}\n2052\t\treturn \"\"\n2053\t}\n2054\t\n2055\t// reviewRunRuntimeHex is how many hex digits of the attempt id name its\n2056\t// runtime directory: no more than the longest random suffix of\n2057\t// os.MkdirTemp, a uint32 in decimal (ten digits).\n2058\tconst reviewRunRuntimeHex = 10\n2059\t\n2060\t// reviewRuntimeNameRE is the form of a runtime directory name a run records\n2061\t// in safety.runtime_id: the stable one, or the random one earlier engines\n2062\t// and runs without an attempt used.\n2063\tvar reviewRuntimeNameRE = regexp.MustCompile(`^pose-review-run-[0-9A-Za-z]{1,40}$`)\n2064\t\n2065\t// runtimeSourceOf is what names the runtime directory of a continuation of\n2066\t// prior: the name prior recorded, so the session finds the checkout where it\n2067\t// saw it, also when an earlier engine named it at random (spec\n2068\t// pose-review-resume-runtime-dir-followups R2); otherwise prior's attempt.\n2069\tfunc runtimeSourceOf(prior ReviewRun) string {\n2070\t\tif prior.Safety != nil && reviewRuntimeNameRE.MatchString(prior.Safety.RuntimeID) {\n2071\t\t\treturn prior.Safety.RuntimeID\n2072\t\t}\n2073\t\treturn prior.AttemptID\n2074\t}\n2075\t\n2076\t// runtimeSourceFor is what names the runtime directory of a run of plan: the\n2077\t// predecessor's, for a continuation; the previous round's run, for a round\n2078\t// that continues its thread, whose session saw that checkout (R3); the\n2079\t// attempt otherwise.\n2080\tfunc (s Store) runtimeSourceFor(plan DispatchPlan, attemptID string) string {\n2081\t\tif plan.predecessor != nil {\n2082\t\t\treturn runtimeSourceOf(*plan.predecessor)\n2083\t\t}\n2084\t\tvar runs []ReviewRun\n2085\t\tif plan.thread.continued() {\n2086\t\t\truns, _, _ = s.ReadReviewRuns(\"\")\n2087\t\t}\n2088\t\treturn runtimeSourceAmong(plan, attemptID, runs)\n2089\t}\n2090\t\n2091\t// runtimeSourceAmong is runtimeSourceFor over the recorded runs given.\n2092\tfunc runtimeSourceAmong(plan DispatchPlan, attemptID string, runs []ReviewRun) string {\n2093\t\tif plan.predecessor != nil {\n2094\t\t\treturn runtimeSourceOf(*plan.predecessor)\n2095\t\t}\n2096\t\tif plan.thread.continued() && plan.thread.From != \"\" {\n2097\t\t\tfor _, r := range runs {\n2098\t\t\t\tif r.RunID == plan.thread.From {\n2099\t\t\t\t\treturn runtimeSourceOf(r)\n2100\t\t\t\t}\n2101\t\t\t}\n2102\t\t}\n2103\t\treturn attemptID\n2104\t}\n2105\t\n2106\t// reviewAttemptIDRE is the form of a delegated review attempt's id.\n2107\tvar reviewAttemptIDRE = regexp.MustCompile(`^rat-[0-9a-f]{64}$`)\n2108\t\n2109\t// reviewRunRuntimeDir creates the private directory of one run. Every run of\n2110\t// an attempt uses the same path, so a resumed reviewer session, which still\n2111\t// refers to the sealed checkout it worked in, finds the checkout recreated\n2112\t// there after the interrupted run removed it (spec\n2113\t// pose-review-resume-keeps-the-sealed-checkout R1). The directory is created\n2114\t// exclusively and never followed: when the path already exists, from an\n2115\t// unfinished cleanup or from someone else, the run fails instead of sharing\n2116\t// it. A run without an attempt keeps a random name.\n2117\tfunc reviewRunRuntimeDir(attemptID string) (string, error) {\n211