n671\t\t\tcleaned = true\n672\t\t\toutcome := NewOperationResult(\"review.dispatch.cleanup\", run.Scope)\n673\t\t\toutcome.StepsRun = append(outcome.StepsRun, OperationStep{ID: \"cleanup\", Result: \"done\"})\n674\t\t\tif terminationFailed {\n675\t\t\t\tcleanupErr = fmt.Errorf(\"process termination incomplete; runtime resources retained\")\n676\t\t\t} else if cleanup != nil {\n677\t\t\t\tcleanupErr = cleanup()\n678\t\t\t}\n679\t\t\tif cleanupErr != nil {\n680\t\t\t\toutcome.StepsRun[0].Result = \"failed\"\n681\t\t\t\toutcome.Fail(OutcomeFailed, \"cleanup\", \"cleanup-incomplete\", cleanupErr.Error())\n682\t\t\t\toutcome.Unconfirmed = []OperationUncertain{{Step: \"cleanup\", Reason: \"owned resources may remain; no automatic respawn\"}}\n683\t\t\t} else {\n684\t\t\t\toutcome.Outcome = OutcomeCompleted\n685\t\t\t}\n686\t\t\trun.Safety.Operation = outcome\n687\t\t}\n688\t\tdefer func() {\n689\t\t\tdoCleanup()\n690\t\t\tif cleanupErr != nil {\n691\t\t\t\tresultErr = errors.Join(resultErr, cleanupErr)\n692\t\t\t}\n693\t\t}()\n694\t\ttranscript := []byte{}\n695\t\tfinish := func(status, failure string) (ReviewRun, error) {\n696\t\t\tdoCleanup()\n697\t\t\tif cancelled != nil && cancelled.Load() && status != ReviewRunCompleted {\n698\t\t\t\t// A deliberate cancellation is a failure, never a resumable interruption,\n699\t\t\t\t// and it returns no budget (spec pose-delegation-surface D2).\n700\t\t\t\tstatus, failure = ReviewRunFailed, \"cancelled by pose delegate cancel\"\n701\t\t\t\trun.Safety.ExecutionCause = \"cancelled\"\n702\t\t\t}\n703\t\t\trun.sessionForRedaction = \"\"\n704\t\t\trun.Status, run.Failure = status, failure\n705\t\t\tif status != ReviewRunInterrupted {\n706\t\t\t\trun.Interruption, run.PartialDigest = nil, \"\"\n707\t\t\t}\n708\t\t\trun.EndedAt = now().UTC().Format(time.RFC3339Nano)\n709\t\t\treturn s.recordReviewRun(run, transcript)\n710\t\t}\n711\t\t// Recompute semantic freshness at execution time, not just preview time.\n712\t\tif err := s.checkDispa