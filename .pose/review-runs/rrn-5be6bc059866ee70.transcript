7\t\troot, s, prior := runContinuityFixture(t)\n38\t\tif prior.PartialDigest == \"\" || prior.Interruption.Cause != \"usage-limit\" || !prior.Interruption.Resumable {\n39\t\t\tt.Fatalf(\"partial: %+v\", prior)\n40\t\t}\n41\t\tfor _, path := range []string{prior.Path, prior.TranscriptPath} {\n42\t\t\traw, e := os.ReadFile(filepath.Join(root, path))\n43\t\t\tif e != nil || strings.Contains(string(raw), \"fixture-private-session\") {\n44\t\t\t\tt.Fatal(\"session leaked\", path, e)\n45\t\t\t}\n46\t\t}\n47\t\tif code, out := runPose(t, root, \"delegate\", \"ls\"); code != 0 || !strings.Contains(out, \"cause=usage-limit\") || !strings.Contains(out, \"partial=true\") || strings.Contains(out, \"fixture-private-session\") {\n48\t\t\tt.Fatal(code, out)\n49\t\t}\n50\t\tmetrics, e := s.Insights(\"workflow\", 0)\n51\t\tif e != nil || metrics.DelegatedReview.ByBundle[0].RejectingDrafts != 0 {\n52\t\t\tt.Fatal(\"partial counted as verdict\", e)\n53\t\t}\n54\t\tif _, e = s.PlanReviewResume(prior.RunID); e != nil {\n55\t\t\tt.Fatal(e)\n56\t\t}\n57\t\tcode, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID)\n58\t\tif code != 0 || !strings.Contains(out, \"status=completed\") {\n59\t\t\tt.Fatal(code, out)\n60\t\t}\n61\t\truns, lost, e := s.ReadReviewRuns(\"\")\n62\t\tif e != nil || len(lost) > 0 || len(runs) != 2 {\n63\t\t\tt.Fatal(len(runs), lost, e)\n64\t\t}\n65\t\tvar completed posemodel.ReviewRun\n66\t\tfor _, r := range runs {\n67\t\t\tif r.Status == posemodel.ReviewRunCompleted {\n68\t\t\t\tcompleted = r\n69\t\t\t}\n70\t\t}\n71\t\tif completed.Resumes != prior.RunID || completed.AttemptID != prior.AttemptID || completed.BriefDigest != prior.BriefDigest || completed.TreeDigest != prior.TreeDigest {\n72\t\t\tt.Fatalf(\"chain: %+v\", completed)\n73\t\t}\n74\t\tif code, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID); code != 0 || !strings.Contains(out, completed.RunID) {\n75\t\t\tt.Fatal(\"idempotent\", code, out)\n76\t\t}\n77\t\truns, _ = s.ListReviewRuns(\"\")\n78\t\tif len(runs) != 2 {\n79\t\t\tt.Fatal(\"duplicate process\")\n80\t\t}\n81\t\tmetrics, e = s.Insights(\"workflow\", 0)\n82\t\tm := metrics.DelegatedReview.ByBundle[0]\n83\t\tif e != nil || m.Attempts != 1 || m.Resumes != 1 || m.Reruns != 0 || m.ApprovedDrafts != 1 || m.RejectingDrafts != 0 {\n84\t\t\tt.Fatal(m, e)\n85\t\t}\n86\t\tif _, e = s.PlanReviewResume(completed.RunID); e == nil {\n87\t\t\tt.Fatal(\"completed run resumed\")\n88\t\t}\n89\t\tif _, e = s.PlanReviewDispatch(prior.BundleID, \"review\", \"\", \"fake\", \"reason\"); e == nil || !strings.Contains(e.Error(), \"budget\") {\n90\t\t\tt.Fatal(\"resume reset attempt quota\", e)\n91\t\t}\n92\t\tif rows, lost := s.PendingReviewInterruptions(); len(rows) != 0 || len(lost) != 0 {\n93\t\t\tt.Fatal(rows, lost)\n94\t\t}\n95\t}\n96\tfunc TestRunContinuityRefusalAndExplicitFallback(t *testing.T) {\n97\t\troot, s, prior := runContinuityFixture(t)\n98\t\tif code, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID, \"--wait-until-reset=1s\"); code != 1 || !strings.Contains(out, \"maximum wait\") {\n99\t\t\tt.Fatal(code, out)\n100\t\t}\n101\t\tplan, e := s.PlanReviewDispatch(prior.BundleID, \"review\", \"\", \"other\")\n102\t\tif e != nil {\n103\t\t\tt.Fatal(e)\n104\t\t}\n105\t\tnext, e := s.RunReviewDispatch(plan, time.Now)\n106\t\tif e != nil || next.LimitOf != prior.RunID || next.Reason != \"limit-of:\"+prior.RunID || next.AttemptID == prior.AttemptID {\n107\t\t\tt.Fatal(next, e)\n108\t\t}\n109\t\traw, e := os.ReadFile(filepath.Join(root, prior.Path))\n110\t\tif e != nil {\n111\t\t\tt.Fatal(e)\n112\t\t}\n113\t\tvar edited map[string]any\n114\t\tjson.Unmarshal(raw, &edited)\n115\t\tedited[\"output\"] = \"rewritten\"\n116\t\tchanged, _ := json.Marshal(edited)\n117\t\tos.WriteFile(filepath.Join(root, prior.Path), changed, 0644)\n118\t\tif _, e = s.PlanReviewResume(prior.RunID); e == nil {\n119\t\t\tt.Fatal(\"rewritten predecessor resumed\")\n120\t\t}\n121\t}\n122\t\n123\tfunc TestRunContinuityOutputCaptureAndConflicts(t *testing.T) {\n124\t\troot, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n125\t\t\ta.Command = []string{\"sh\", \"-c\", `printf 'session: fixture-private-session\\nreset: 2030-01-01T00:00:00Z\\nLIMIT\\n' > \"$1\"`, \"sh\", \"{output}\"}\n126\t\t\ta.Limit.OutputPatterns = []string{\"LIMIT\"}\n127\t\t})\n128\t\tif !r.Interruption.Resumable || r.SessionDigest == \"\" || r.Interruption.ResetAt == \"\" || strings.Contains(r.Output, \"fixture-private-session\") {\n129\t\t\tt.Fatal(\"output channel not captured/redacted\", r)\n130\t\t}\n131\t\tif code, out := runPose(t, root, \"delegate\", \"resume\", r.RunID); code != 0 {\n132\t\t\tt.Fatal(code, out)\n133\t\t}\n134\t\truns, lost, e := s.ReadReviewRuns(\"\")\n135\t\tif e != nil || len(lost) > 0 || len(runs) != 2 {\n136\t\t\tt.Fatal(lost, e)\n137\t\t}\n138\t\troot = dispatchInstance(t)\n139\t\twriteReviewers(t, root, map[string]posemodel.ReviewerAdapter{\"fake\": {\n140\t\t\tCommand: []string{\"sh\", \"-c\", `printf 'session: one\\n'; printf 'session: two\\n' > \"$1\"; exit 75`, \"sh\", \"{output}\"}, Vendor: \"fixture\", Model: \"fixture\",\n141\t\t\tLimit: &posemodel.ReviewerLimit{ExitCodes: []int{75}}, Session: &posemodel.ReviewerSession{Pattern: `session: (\\S+)`}, Resume: &posemodel.ReviewerResume{Command: []string{\"fake\", \"{session}\"}},\n142\t\t}})\n143\t\tif code, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"fake\"); code != 1 || !strings.Contains(out, \"unredacted output withheld\") {\n144\t\t\tt.Fatal(code, out)\n145\t\t}\n146\t\truns, lost, e = (posemodel.Store{Root: root}).ReadReviewRuns(\"\")\n147\t\tif e != nil || len(lost) > 0 || len(runs) != 1 || runs[0].Output != \"\" {\n148\t\t\tt.Fatal(\"conflict not withheld\", runs, lost, e)\n149\t\t}\n150\t}\n151\tfunc TestRunContinuityBudgetsAndChangedInputs(t *testing.T) {\n152\t\t_, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) { a.Resume.MaxWallTime = \"1ns\" })\n153\t\tif _, e := s.PlanReviewResume(r.RunID); e == nil || !strings.Contains(e.Error(), \"budget exhausted\") {\n154\t\t\tt.Fatal(\"wall budget accepted\", e)\n155\t\t}\n156\t\troot, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n157\t\t\ta.Resume.MaxResumes = 1\n158\t\t\ta.Resume.Command = a.Command\n159\t\t\ta.Resume.Command = append(a.Resume.Command, \"{session}\")\n160\t\t})\n161\t\tif code, out := runPose(t, root, \"delegate\", \"resume\", r.RunID); code != 1 || !strings.Contains(out, \"status=interrupted\") {\n162\t\t\tt.Fatal(code, out)\n163\t\t}\n164\t\truns, lost, e := s.ReadReviewRuns(\"\")\n165\t\tif e != nil || len(lost) > 0 {\n166\t\t\tt.Fatal(lost, e)\n167\t\t}\n168\t\tfor _, next := range runs {\n169\t\t\tif next.Resumes == r.RunID {\n170\t\t\t\tif _, e = s.PlanReviewResume(next.RunID); e == nil || !strings.Contains(e.Error(), \"budget exhausted\") {\n171\t\t\t\t\tt.Fatal(\"resume budget accepted\", e)\n172\t\t\t\t}\n173\t\t\t}\n174\t\t}\n175\t\troot, s, r = runContinuityFixture(t)\n176\t\tif e = os.WriteFile(filepath.Join(root, \"pose-mcp/lib.go\"), []byte(\"package changed\\n\"), 0644); e != nil {\n177\t\t\tt.Fatal(e)\n178\t\t}\n179\t\tif _, e = s.PlanReviewResume(r.RunID); e == nil {\n180\t\t\tt.Fatal(\"changed sealed source resumed\")\n181\t\t}\n182\t\troot, s, r = runContinuityFixture(t)\n183\t\tbundlePath := filepath.Join(root, \".pose/review-bundles\", r.BundleID+\".json\")\n184\t\traw, e := os.ReadFile(bundlePath)\n185\t\tif e != nil {\n186\t\t\tt.Fatal(e)\n187\t\t}\n188\t\traw = []byte(strings.Replace(string(raw), r.BundleDigest, \"sha256:changed\", 1))\n189\t\tif e = os.WriteFile(bundlePath, raw, 0644); e != nil {\n190\t\t\tt.Fatal(e)\n191\t\t}\n192\t\tif _, e = s.PlanReviewResume(r.RunID); e == nil {\n193\t\t\tt.Fatal(\"changed bundle resumed\")\n194\t\t}\n195\t}\n196\t\n197\tfunc TestRunContinuityLaunchFailureAndSessionRotation(t *testing.T) {\n198\t\troot := dispatchInstance(t)\n199\t\twriteReviewers(t, root, map[string]posemodel.ReviewerAdapter{\"missing\": {Command: []string{\"/nonexistent/pose-fixture-command\"}, Vendor: \"fixture\", Model: \"fixture\"}})\n200\t\tif code, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"missing\"); code != 1 || !strings.Contains(out, \"status=failed\") {\n201\t\t\tt.Fatal(code, out)\n202\t\t}\n203\t\truns, lost, e := (posemodel.Store{Root: root}).ReadReviewRuns(\"\")\n204\t\tif e != nil || len(lost) > 0 || len(runs) != 1 || runs[0].Interruption != nil {\n205\t\t\tt.Fatal(runs, lost, e)\n206\t\t}\n207\t\troot, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n208\t\t\ta.Resume.Command = []string{\"sh\", \"-c\", `printf 'session: different-reference\\nold reference: %s\\n' \"$1\"; exit 75`, \"sh\", \"{session}\"}\n209\t\t})\n210\t\tif code, out := runPose(t, root, \"delegate\", \"resume\", r.RunID); code != 1 || !strings.Contains(out, \"status=failed\") {\n211\t\t\tt.Fatal(code, out)\n212\t\t}\n213\t\truns, lost, e = s.ReadReviewRuns(\"\")\n214\t\tif e != nil || len(lost) > 0 || len(runs) != 2 {\n215\t\t\tt.Fatal(runs, lost, e)\n216\t\t}\n217\t\tfor _, next := range runs {\n218\t\t\tif next.Resumes != \"\" {\n219\t\t\t\traw, _ := os.ReadFile(filepath.Join(root, next.TranscriptPath))\n220\t\t\t\tif next.Output != \"\" || len(raw) != 0 || next.Interruption != nil {\n221\t\t\t\t\tt.Fatal(\"rotated session leaked\", next)\n222\t\t\t\t}\n223\t\t\t}\n224\t\t}\n225\t}\n226\tfunc TestRunContinuityDoctorStatusAndPending(t *testing.T) {\n227\t\troot, s, r := runContinuityFixture(t)\n228\t\twarns := 0\n229\t\tdiagnoseReviewContinuity(root, func(check, level, message, hint string) {\n230\t\t\tif check == \"review.interrupted\" && level == \"warn\" && strings.Contains(message, r.RunID) {\n231\t\t\t\twarns++\n232\t\t\t}\n233\t\t})\n234\t\tif warns != 1 {\n235\t\t\tt.Fatal(\"doctor missed interruption\")\n236\t\t}\n237\t\tif code, out := runPose(t, root, \"delegate\", \"ls\", \"--json\"); code != 0 || !strings.Contains(out, `\"time_left\"`) || !strings.Contains(out, `\"partial\": true`) {\n238\t\t\tt.Fatal(code, out)\n239\t\t}\n240\t\traw, _ := json.Marshal(r)\n241\t\tdigest := sha256.Sum256(raw)\n242\t\tclaim := map[string]any{\"schema_version\": 1, \"predecessor\": r.RunID, \"attempt_id\": r.AttemptID, \"predecessor_digest\": \"sha256:\" + hex.EncodeToString(digest[:]), \"claimed_at\": time.Now().UTC().Format(time.RFC3339Nano), \"nonce\": strings.Repeat(\"a\", 32)}\n243\t\tclaimRaw, _ := json.Marshal(claim)\n244\t\tdir := filepath.Join(root, \".pose/review-continuations\")\n245\t\tif e := os.MkdirAll(dir, 0755); e != nil {\n246\t\t\tt.Fatal(e)\n247\t\t}\n248\t\tif e := os.WriteFile(filepath.Join(dir, r.RunID+\".json\"), claimRaw, 0644); e != nil {\n249\t\t\tt.Fatal(e)\n250\t\t}\n251\t\tif code, out := runPose(t, root, \"delegate\", \"resume\", r.RunID); code != 0 || !strings.Contains(out, \"delegate.status=pending\") || !strings.Contains(out, \"resume-of:\"+r.RunID) {\n252\t\t\tt.Fatal(\"pending not returned\", code, out)\n253\t\t}\n254\t\truns, _ := s.ListReviewRuns(\"\")\n255\t\tif len(runs) != 1 {\n256\t\t\tt.Fatal(\"pending claim launched another process\")\n257\t\t}\n258\t}\n259\t\n260\tfunc TestRunContinuityConcurrentResumeLaunchesOnce(t *testing.T) {\n261\t\tmarker := filepath.Join(t.TempDir(), \"launches\")\n262\t\t_, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n263\t\t\ta.Resume.Command = []string{\"sh\", \"-c\", `printf 'start\\n' >> \"$2\"; sleep 0.05; printf 'decision: approved\\n'`, \"sh\", \"{session}\", marker}\n264\t\t})\n265\t\tplan, e := s.PlanReviewResume(r.RunID)\n266\t\tif e != nil {\n267\t\t\tt.Fatal(e)\n268\t\t}\n269\t\tvar wg sync.WaitGroup\n270\t\tfor i := 0; i < 8; i++ {\n271\t\t\twg.Add(1)\n272\t\t\tgo func() { defer wg.Done(); _, _ = s.RunReviewDispatch(plan, time.Now) }()\n273\t\t}\n274\t\twg.Wait()\n275\t\traw, e := os.ReadFile(marker)\n276\t\tif e != nil || string(raw) != \"start\\n\" {\n277\t\t\tt.Fatalf(\"duplicate launches %q %v\", raw, e)\n278\t\t}\n279\t\truns, lost, e := s.ReadReviewRuns(\"\")\n280\t\tif e != nil || len(lost) > 0 || len(runs) != 2 {\n281\t\t\tt.Fatal(len(runs), lost, e)\n282\t\t}\n283\t}\n284\tfunc TestRunContinuityObservedProcessLoss(t *testing.T) {\n285\t\t_, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n286\t\t\ta.Command = []string{\"sh\", \"-c\", `printf 'session: fixture-private-session\\n'; kill -KILL $$`}\n287\t\t})\n288\t\tif r.Interruption.Cause != \"process-lost\" || !r.Interruption.Resumable {\n289\t\t\tt.Fatal(r.Interruption)\n290\t\t}\n291\t\tif _, e := s.PlanReviewResume(r.RunID); e != nil {\n292\t\t\tt.Fatal(e)\n293\t\t}\n294\t}\n295\t\n296\t// Spec pose-review-resume-keeps-the-sealed-checkout R1, R2: a resumed session\n297\t// works in the sealed checkout it saw before the interruption, recreated at\n298\t// the same path after the interrupted run removed it.\n299\tfunc TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath(t *testing.T) {\n300\t\tmarks := t.TempDir()\n301\t\tfirst := filepath.Join(marks, \"first\")\n302\t\troot, _, prior := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n303\t\t\ta.Command = []string{\"sh\", \"-c\", `pwd > \"$1\"; printf 'session: fixture-private-session\\nreset: 2030-01-01T00:00:00Z\\ndecision: rejected\\n'; exit 75`, \"sh\", first}\n304\t\t\ta.Resume.Command = []string{\"sh\", \"-c\", `test \"$(pwd)\" = \"$(cat \"$1\")\" || { echo \"moved from $(cat \"$1\") to $(pwd)\" >&2; exit 3; }; test -f .pose/specs/alpha/spec.md || exit 4; printf 'decision: approved\\n'`, \"sh\", first, \"{session}\"}\n305\t\t})\n306\t\traw, err := os.ReadFile(first)\n307\t\tif err != nil {\n308\t\t\tt.Fatal(err)\n309\t\t}\n310\t\tcheckout := strings.TrimSpace(string(raw))\n311\t\tif _, err := os.Stat(checkout); !os.IsNotExist(err) {\n312\t\t\tt.Fatalf(\"the interrupted run left its checkout %s behind: %v\", checkout, err)\n313\t\t}\n314\t\t// Review round 1, N1: a leftover runtime directory refuses the resume\n315\t\t// before it is claimed, so removing it restores the resume.\n316\t\truntimeDir := filepath.Dir(checkout)\n317\t\tif err := os.Mkdir(runtimeDir, 0o700); err != nil {\n318\t\t\tt.Fatal(err)\n319\t\t}\n320\t\tif code, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID); code == 0 || !strings.Contains(out, \"then resume again\") {\n321\t\t\tt.Fatalf(\"a resume beside a leftover runtime directory: %d %s\", code, out)\n322\t\t}\n323\t\t// Review round 2, N6: a handoff is refused the same way, before it\n324\t\t// claims the interrupted run.\n325\t\tif _, err := (posemodel.Store{Root: root}).PlanReviewHandoff(prior.RunID, \"other\"); err == nil || !strings.Contains(err.Error(), \"still exists\") || !strings.Contains(err.Error(), \"then hand off again\") {\n326\t\t\tt.Fatalf(\"a handoff beside a leftover runtime directory: %v\", err)\n327\t\t}\n328\t\tif err := os.Remove(runtimeDir); err != nil {\n329\t\t\tt.Fatal(err)\n330\t\t}\n331\t\t// Spec pose-review-resume-runtime-dir-followups R1: a directory that\n332\t\t// appears between the plan and the dispatch is refused before the claim,\n333\t\t// so the interrupted run stays resumable.\n334\t\tstore := posemodel.Store{Root: root}\n335\t\tplan, err := store.PlanReviewResume(prior.RunID)\n336\t\tif err != nil {\n337\t\t\tt.Fatal(err)\n338\t\t}\n339\t\tif err := os.Mkdir(runtimeDir, 0o700); err != nil {\n340\t\t\tt.Fatal(err)\n341\t\t}\n342\t\tif _, err := store.RunReviewDispatch(plan, time.Now); err == nil || !(strings.Contains(err.Error(), \"already exists\") || strings.Contains(err.Error(), \"still exists\")) {\n343\t\t\tt.Fatalf(\"a dispatch beside a directory that appeared: %v\", err)\n344\t\t}\n345\t\tif err := os.Remove(runtimeDir); err != nil {\n346\t\t\tt.Fatal(err)\n347\t\t}\n348\t\tcode, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID)\n349\t\tif code != 0 || !strings.Contains(out, \"status=completed\") {\n350\t\t\tt.Fatalf(\"the resumed session did not find its checkout at %s: %d %s\", checkout, code, out)\n351\t\t}\n352\t}\n353\t"}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"3f8185a2-dc84-40eb-86fa-cd65aa3d1491","timestamp":"2026-11-27T07:19:35.700Z","tool_use_result":{"type":"text","file":{"filePath":"/var/tmp/pose-work-go/pose-review-run-28c7b07899/worktree/pose-mcp/internal/cli/review_run_continuity_test.go","content":"package cli\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"sync\"\n\t\"testing\"\n\t\"time\"\n\n\tposemodel \"github.com/harne8/pose-mcp/internal/pose\"\n)\n\nfunc runContinuityFixture(t *testing.T, changes ...func(*posemodel.ReviewerAdapter)) (string, posemodel.Store, posemodel.ReviewRun) {\n\tt.Helper()\n\troot := dispatchInstance(t)\n\ta := posemodel.ReviewerAdapter{Command: []string{\"sh\", \"-c\", \"printf 'session: fixture-private-session\\\\nreset: 2030-01-01T00:00:00Z\\\\ndecision: rejected\\\\n'; exit 75\"}, Vendor: \"fixture\", Model: \"fixture\", MaxRunsPerBundle: 1, Limit: &posemodel.ReviewerLimit{ExitCodes: []int{75}, ResetPattern: `reset: (\\S+)`}, Session: &posemodel.ReviewerSession{Pattern: `session: (\\S+)`}, Resume: &posemodel.ReviewerResume{Command: []string{\"sh\", \"-c\", `test \"$1\" = fixture-private-session || exit 2; printf 'decision: approved\\n'`, \"sh\", \"{session}\"}}}\n\tfor _, change := range changes {\n\t\tchange(&a)\n\t}\n\twriteReviewers(t, root, map[string]posemodel.ReviewerAdapter{\"fake\": a, \"other\": {Command: []string{\"sh\", \"-c\", \"printf 'decision: approved\\\\n'\"}, Vendor: \"other\", Model: \"fixture\"}})\n\tcode, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"fake\")\n\tif code != 1 || !strings.Contains(out, \"status=interrupted\") {\n\t\tt.Fatalf(\"interrupt: %d %s\", code, out)\n\t}\n\ts := posemodel.Store{Root: root}\n\truns, lost, e := s.ReadReviewRuns(\"\")\n\tif e != nil || len(lost) > 0 || len(runs) != 1 {\n\t\tt.Fatal(runs, lost, e)\n\t}\n\treturn root, s, runs[0]\n}\nfunc TestRunContinuityInterruptedResumeAndAccounting(t *testing.T) {\n\troot, s, prior := runContinuityFixture(t)\n\tif prior.PartialDigest == \"\" || prior.Interruption.Cause != \"usage-limit\" || !prior.Interruption.Resumable {\n\t\tt.Fatalf(\"partial: %+v\", prior)\n\t}\n\tfor _, path := range []string{prior.Path, prior.TranscriptPath} {\n\t\traw, e := os.ReadFile(filepath.Join(root, path))\n\t\tif e != nil || strings.Contains(string(raw), \"fixture-private-session\") {\n\t\t\tt.Fatal(\"session leaked\", path, e)\n\t\t}\n\t}\n\tif code, out := runPose(t, root, \"delegate\", \"ls\"); code != 0 || !strings.Contains(out, \"cause=usage-limit\") || !strings.Contains(out, \"partial=true\") || strings.Contains(out, \"fixture-private-session\") {\n\t\tt.Fatal(code, out)\n\t}\n\tmetrics, e := s.Insights(\"workflow\", 0)\n\tif e != nil || metrics.DelegatedReview.ByBundle[0].RejectingDrafts != 0 {\n\t\tt.Fatal(\"partial counted as verdict\", e)\n\t}\n\tif _, e = s.PlanReviewResume(prior.RunID); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tcode, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID)\n\tif code != 0 || !strings.Contains(out, \"status=completed\") {\n\t\tt.Fatal(code, out)\n\t}\n\truns, lost, e := s.ReadReviewRuns(\"\")\n\tif e != nil || len(lost) > 0 || len(runs) != 2 {\n\t\tt.Fatal(len(runs), lost, e)\n\t}\n\tvar completed posemodel.ReviewRun\n\tfor _, r := range runs {\n\t\tif r.Status == posemodel.ReviewRunCompleted {\n\t\t\tcompleted = r\n\t\t}\n\t}\n\tif completed.Resumes != prior.RunID || completed.AttemptID != prior.AttemptID || completed.BriefDigest != prior.BriefDigest || completed.TreeDigest != prior.TreeDigest {\n\t\tt.Fatalf(\"chain: %+v\", completed)\n\t}\n\tif code, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID); code != 0 || !strings.Contains(out, completed.RunID) {\n\t\tt.Fatal(\"idempotent\", code, out)\n\t}\n\truns, _ = s.ListReviewRuns(\"\")\n\tif len(runs) != 2 {\n\t\tt.Fatal(\"duplicate process\")\n\t}\n\tmetrics, e = s.Insights(\"workflow\", 0)\n\tm := metrics.DelegatedReview.ByBundle[0]\n\tif e != nil || m.Attempts != 1 || m.Resumes != 1 || m.Reruns != 0 || m.ApprovedDrafts != 1 || m.RejectingDrafts != 0 {\n\t\tt.Fatal(m, e)\n\t}\n\tif _, e = s.PlanReviewResume(completed.RunID); e == nil {\n\t\tt.Fatal(\"completed run resumed\")\n\t}\n\tif _, e = s.PlanReviewDispatch(prior.BundleID, \"review\", \"\", \"fake\", \"reason\"); e == nil || !strings.Contains(e.Error(), \"budget\") {\n\t\tt.Fatal(\"resume reset attempt quota\", e)\n\t}\n\tif rows, lost := s.PendingReviewInterruptions(); len(rows) != 0 || len(lost) != 0 {\n\t\tt.Fatal(rows, lost)\n\t}\n}\nfunc TestRunContinuityRefusalAndExplicitFallback(t *testing.T) {\n\troot, s, prior := runContinuityFixture(t)\n\tif code, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID, \"--wait-until-reset=1s\"); code != 1 || !strings.Contains(out, \"maximum wait\") {\n\t\tt.Fatal(code, out)\n\t}\n\tplan, e := s.PlanReviewDispatch(prior.BundleID, \"review\", \"\", \"other\")\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tnext, e := s.RunReviewDispatch(plan, time.Now)\n\tif e != nil || next.LimitOf != prior.RunID || next.Reason != \"limit-of:\"+prior.RunID || next.AttemptID == prior.AttemptID {\n\t\tt.Fatal(next, e)\n\t}\n\traw, e := os.ReadFile(filepath.Join(root, prior.Path))\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tvar edited map[string]any\n\tjson.Unmarshal(raw, &edited)\n\tedited[\"output\"] = \"rewritten\"\n\tchanged, _ := json.Marshal(edited)\n\tos.WriteFile(filepath.Join(root, prior.Path), changed, 0644)\n\tif _, e = s.PlanReviewResume(prior.RunID); e == nil {\n\t\tt.Fatal(\"rewritten predecessor resumed\")\n\t}\n}\n\nfunc TestRunContinuityOutputCaptureAndConflicts(t *testing.T) {\n\troot, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n\t\ta.Command = []string{\"sh\", \"-c\", `printf 'session: fixture-private-session\\nreset: 2030-01-01T00:00:00Z\\nLIMIT\\n' > \"$1\"`, \"sh\", \"{output}\"}\n\t\ta.Limit.OutputPatterns = []string{\"LIMIT\"}\n\t})\n\tif !r.Interruption.Resumable || r.SessionDigest == \"\" || r.Interruption.ResetAt == \"\" || strings.Contains(r.Output, \"fixture-private-session\") {\n\t\tt.Fatal(\"output channel not captured/redacted\", r)\n\t}\n\tif code, out := runPose(t, root, \"delegate\", \"resume\", r.RunID); code != 0 {\n\t\tt.Fatal(code, out)\n\t}\n\truns, lost, e := s.ReadReviewRuns(\"\")\n\tif e != nil || len(lost) > 0 || len(runs) != 2 {\n\t\tt.Fatal(lost, e)\n\t}\n\troot = dispatchInstance(t)\n\twriteReviewers(t, root, map[string]posemodel.ReviewerAdapter{\"fake\": {\n\t\tCommand: []string{\"sh\", \"-c\", `printf 'session: one\\n'; printf 'session: two\\n' > \"$1\"; exit 75`, \"sh\", \"{output}\"}, Vendor: \"fixture\", Model: \"fixture\",\n\t\tLimit: &posemodel.ReviewerLimit{ExitCodes: []int{75}}, Session: &posemodel.ReviewerSession{Pattern: `session: (\\S+)`}, Resume: &posemodel.ReviewerResume{Command: []string{\"fake\", \"{session}\"}},\n\t}})\n\tif code, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"fake\"); code != 1 || !strings.Contains(out, \"unredacted output withheld\") {\n\t\tt.Fatal(code, out)\n\t}\n\truns, lost, e = (posemodel.Store{Root: root}).ReadReviewRuns(\"\")\n\tif e != nil || len(lost) > 0 || len(runs) != 1 || runs[0].Output != \"\" {\n\t\tt.Fatal(\"conflict not withheld\", runs, lost, e)\n\t}\n}\nfunc TestRunContinuityBudgetsAndChangedInputs(t *testing.T) {\n\t_, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) { a.Resume.MaxWallTime = \"1ns\" })\n\tif _, e := s.PlanReviewResume(r.RunID); e == nil || !strings.Contains(e.Error(), \"budget exhausted\") {\n\t\tt.Fatal(\"wall budget accepted\", e)\n\t}\n\troot, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n\t\ta.Resume.MaxResumes = 1\n\t\ta.Resume.Command = a.Command\n\t\ta.Resume.Command = append(a.Resume.Command, \"{session}\")\n\t})\n\tif code, out := runPose(t, root, \"delegate\", \"resume\", r.RunID); code != 1 || !strings.Contains(out, \"status=interrupted\") {\n\t\tt.Fatal(code, out)\n\t}\n\truns, lost, e := s.ReadReviewRuns(\"\")\n\tif e != nil || len(lost) > 0 {\n\t\tt.Fatal(lost, e)\n\t}\n\tfor _, next := range runs {\n\t\tif next.Resumes == r.RunID {\n\t\t\tif _, e = s.PlanReviewResume(next.RunID); e == nil || !strings.Contains(e.Error(), \"budget exhausted\") {\n\t\t\t\tt.Fatal(\"resume budget accepted\", e)\n\t\t\t}\n\t\t}\n\t}\n\troot, s, r = runContinuityFixture(t)\n\tif e = os.WriteFile(filepath.Join(root, \"pose-mcp/lib.go\"), []byte(\"package changed\\n\"), 0644); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = s.PlanReviewResume(r.RunID); e == nil {\n\t\tt.Fatal(\"changed sealed source resumed\")\n\t}\n\troot, s, r = runContinuityFixture(t)\n\tbundlePath := filepath.Join(root, \".pose/review-bundles\", r.BundleID+\".json\")\n\traw, e := os.ReadFile(bundlePath)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\traw = []byte(strings.Replace(string(raw), r.BundleDigest, \"sha256:changed\", 1))\n\tif e = os.WriteFile(bundlePath, raw, 0644); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif _, e = s.PlanReviewResume(r.RunID); e == nil {\n\t\tt.Fatal(\"changed bundle resumed\")\n\t}\n}\n\nfunc TestRunContinuityLaunchFailureAndSessionRotation(t *testing.T) {\n\troot := dispatchInstance(t)\n\twriteReviewers(t, root, map[string]posemodel.ReviewerAdapter{\"missing\": {Command: []string{\"/nonexistent/pose-fixture-command\"}, Vendor: \"fixture\", Model: \"fixture\"}})\n\tif code, out := runPose(t, root, \"delegate\", \"review\", \"spec:alpha\", \"--agent\", \"missing\"); code != 1 || !strings.Contains(out, \"status=failed\") {\n\t\tt.Fatal(code, out)\n\t}\n\truns, lost, e := (posemodel.Store{Root: root}).ReadReviewRuns(\"\")\n\tif e != nil || len(lost) > 0 || len(runs) != 1 || runs[0].Interruption != nil {\n\t\tt.Fatal(runs, lost, e)\n\t}\n\troot, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n\t\ta.Resume.Command = []string{\"sh\", \"-c\", `printf 'session: different-reference\\nold reference: %s\\n' \"$1\"; exit 75`, \"sh\", \"{session}\"}\n\t})\n\tif code, out := runPose(t, root, \"delegate\", \"resume\", r.RunID); code != 1 || !strings.Contains(out, \"status=failed\") {\n\t\tt.Fatal(code, out)\n\t}\n\truns, lost, e = s.ReadReviewRuns(\"\")\n\tif e != nil || len(lost) > 0 || len(runs) != 2 {\n\t\tt.Fatal(runs, lost, e)\n\t}\n\tfor _, next := range runs {\n\t\tif next.Resumes != \"\" {\n\t\t\traw, _ := os.ReadFile(filepath.Join(root, next.TranscriptPath))\n\t\t\tif next.Output != \"\" || len(raw) != 0 || next.Interruption != nil {\n\t\t\t\tt.Fatal(\"rotated session leaked\", next)\n\t\t\t}\n\t\t}\n\t}\n}\nfunc TestRunContinuityDoctorStatusAndPending(t *testing.T) {\n\troot, s, r := runContinuityFixture(t)\n\twarns := 0\n\tdiagnoseReviewContinuity(root, func(check, level, message, hint string) {\n\t\tif check == \"review.interrupted\" && level == \"warn\" && strings.Contains(message, r.RunID) {\n\t\t\twarns++\n\t\t}\n\t})\n\tif warns != 1 {\n\t\tt.Fatal(\"doctor missed interruption\")\n\t}\n\tif code, out := runPose(t, root, \"delegate\", \"ls\", \"--json\"); code != 0 || !strings.Contains(out, `\"time_left\"`) || !strings.Contains(out, `\"partial\": true`) {\n\t\tt.Fatal(code, out)\n\t}\n\traw, _ := json.Marshal(r)\n\tdigest := sha256.Sum256(raw)\n\tclaim := map[string]any{\"schema_version\": 1, \"predecessor\": r.RunID, \"attempt_id\": r.AttemptID, \"predecessor_digest\": \"sha256:\" + hex.EncodeToString(digest[:]), \"claimed_at\": time.Now().UTC().Format(time.RFC3339Nano), \"nonce\": strings.Repeat(\"a\", 32)}\n\tclaimRaw, _ := json.Marshal(claim)\n\tdir := filepath.Join(root, \".pose/review-continuations\")\n\tif e := os.MkdirAll(dir, 0755); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif e := os.WriteFile(filepath.Join(dir, r.RunID+\".json\"), claimRaw, 0644); e != nil {\n\t\tt.Fatal(e)\n\t}\n\tif code, out := runPose(t, root, \"delegate\", \"resume\", r.RunID); code != 0 || !strings.Contains(out, \"delegate.status=pending\") || !strings.Contains(out, \"resume-of:\"+r.RunID) {\n\t\tt.Fatal(\"pending not returned\", code, out)\n\t}\n\truns, _ := s.ListReviewRuns(\"\")\n\tif len(runs) != 1 {\n\t\tt.Fatal(\"pending claim launched another process\")\n\t}\n}\n\nfunc TestRunContinuityConcurrentResumeLaunchesOnce(t *testing.T) {\n\tmarker := filepath.Join(t.TempDir(), \"launches\")\n\t_, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n\t\ta.Resume.Command = []string{\"sh\", \"-c\", `printf 'start\\n' >> \"$2\"; sleep 0.05; printf 'decision: approved\\n'`, \"sh\", \"{session}\", marker}\n\t})\n\tplan, e := s.PlanReviewResume(r.RunID)\n\tif e != nil {\n\t\tt.Fatal(e)\n\t}\n\tvar wg sync.WaitGroup\n\tfor i := 0; i < 8; i++ {\n\t\twg.Add(1)\n\t\tgo func() { defer wg.Done(); _, _ = s.RunReviewDispatch(plan, time.Now) }()\n\t}\n\twg.Wait()\n\traw, e := os.ReadFile(marker)\n\tif e != nil || string(raw) != \"start\\n\" {\n\t\tt.Fatalf(\"duplicate launches %q %v\", raw, e)\n\t}\n\truns, lost, e := s.ReadReviewRuns(\"\")\n\tif e != nil || len(lost) > 0 || len(runs) != 2 {\n\t\tt.Fatal(len(runs), lost, e)\n\t}\n}\nfunc TestRunContinuityObservedProcessLoss(t *testing.T) {\n\t_, s, r := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n\t\ta.Command = []string{\"sh\", \"-c\", `printf 'session: fixture-private-session\\n'; kill -KILL $$`}\n\t})\n\tif r.Interruption.Cause != \"process-lost\" || !r.Interruption.Resumable {\n\t\tt.Fatal(r.Interruption)\n\t}\n\tif _, e := s.PlanReviewResume(r.RunID); e != nil {\n\t\tt.Fatal(e)\n\t}\n}\n\n// Spec pose-review-resume-keeps-the-sealed-checkout R1, R2: a resumed session\n// works in the sealed checkout it saw before the interruption, recreated at\n// the same path after the interrupted run removed it.\nfunc TestRunContinuityResumedReviewFindsItsSealedCheckoutAtTheSamePath(t *testing.T) {\n\tmarks := t.TempDir()\n\tfirst := filepath.Join(marks, \"first\")\n\troot, _, prior := runContinuityFixture(t, func(a *posemodel.ReviewerAdapter) {\n\t\ta.Command = []string{\"sh\", \"-c\", `pwd > \"$1\"; printf 'session: fixture-private-session\\nreset: 2030-01-01T00:00:00Z\\ndecision: rejected\\n'; exit 75`, \"sh\", first}\n\t\ta.Resume.Command = []string{\"sh\", \"-c\", `test \"$(pwd)\" = \"$(cat \"$1\")\" || { echo \"moved from $(cat \"$1\") to $(pwd)\" >&2; exit 3; }; test -f .pose/specs/alpha/spec.md || exit 4; printf 'decision: approved\\n'`, \"sh\", first, \"{session}\"}\n\t})\n\traw, err := os.ReadFile(first)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcheckout := strings.TrimSpace(string(raw))\n\tif _, err := os.Stat(checkout); !os.IsNotExist(err) {\n\t\tt.Fatalf(\"the interrupted run left its checkout %s behind: %v\", checkout, err)\n\t}\n\t// Review round 1, N1: a leftover runtime directory refuses the resume\n\t// before it is claimed, so removing it restores the resume.\n\truntimeDir := filepath.Dir(checkout)\n\tif err := os.Mkdir(runtimeDir, 0o700); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif code, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID); code == 0 || !strings.Contains(out, \"then resume again\") {\n\t\tt.Fatalf(\"a resume beside a leftover runtime directory: %d %s\", code, out)\n\t}\n\t// Review round 2, N6: a handoff is refused the same way, before it\n\t// claims the interrupted run.\n\tif _, err := (posemodel.Store{Root: root}).PlanReviewHandoff(prior.RunID, \"other\"); err == nil || !strings.Contains(err.Error(), \"still exists\") || !strings.Contains(err.Error(), \"then hand off again\") {\n\t\tt.Fatalf(\"a handoff beside a leftover runtime directory: %v\", err)\n\t}\n\tif err := os.Remove(runtimeDir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\t// Spec pose-review-resume-runtime-dir-followups R1: a directory that\n\t// appears between the plan and the dispatch is refused before the claim,\n\t// so the interrupted run stays resumable.\n\tstore := posemodel.Store{Root: root}\n\tplan, err := store.PlanReviewResume(prior.RunID)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.Mkdir(runtimeDir, 0o700); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, err := store.RunReviewDispatch(plan, time.Now); err == nil || !(strings.Contains(err.Error(), \"already exists\") || strings.Contains(err.Error(), \"still exists\")) {\n\t\tt.Fatalf(\"a dispatch beside a directory that appeared: %v\", err)\n\t}\n\tif err := os.Remove(runtimeDir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcode, out := runPose(t, root, \"delegate\", \"resume\", prior.RunID)\n\tif code != 0 || !strings.Contains(out, \"status=completed\") {\n\t\tt.Fatalf(\"the resumed session did not find its checkout at %s: %d %s\", checkout, code, out)\n\t}\n}\n","numLines":353,"startLine":1,"totalLines":353}},"tool_result_meta":[{"id":"toolu_01U2aF1dKDNjrmzeziR6kFEG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
