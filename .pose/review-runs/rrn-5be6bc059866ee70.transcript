g it to a failed run\n2154\t// (review round 1, N1).\n2155\tfunc reviewRunRuntimeDirFree(attemptID, verb string) error {\n2156\t\tdir, ok := reviewRunRuntimeDirPath(attemptID)\n2157\t\tif !ok {\n2158\t\t\treturn nil\n2159\t\t}\n2160\t\tif _, err := os.Lstat(dir); err == nil {\n2161\t\t\treturn fmt.Errorf(\"the attempt's runtime directory %s still exists although its last run cleaned up; another process holds the path, or a run of the attempt is starting; when none is live, remove it, then %s again\", dir, verb)\n2162\t\t} else if !errors.Is(err, fs.ErrNotExist) {\n2163\t\t\treturn fmt.Errorf(\"the attempt's runtime directory %s cannot be checked: %w\", dir, err)\n2164\t\t}\n2165\t\treturn nil\n2166\t}\n2167\t\n2168\t// takeContinuationRuntimeDir creates the attempt's runtime directory for a\n2169\t// continuation before its claim. When the directory is there, a claim that\n2170\t// appears meanwhile means another resume holds it: the continuation is\n2171\t// pending. Otherwise the directory belongs to no run of the attempt, and the\n2172\t// resume is refused with nothing claimed.\n2173\tfunc (s Store) takeContinuationRuntimeDir(plan DispatchPlan) (string, error) {\n2174\t\tsource := runtimeSourceOf(*plan.predecessor)\n2175\t\tif _, ok := reviewRunRuntimeDirPath(source); !ok {\n2176\t\t\treturn \"\", nil\n2177\t\t}\n2178\t\tdir, err := reviewRunRuntimeDir(source)\n2179\t\tif err == nil {\n2180\t\t\treturn dir, nil\n2181\t\t}\n2182\t\tif !errors.Is(err, fs.ErrExist) {\n2183\t\t\treturn \"\", err\n2184\t\t}\n2185\t\t// The resume that took it claims right after; look for that claim.\n2186\t\tif pending := s.awaitContinuationClaim(*plan.predecessor); pending != nil {\n2187\t\t\treturn \"\", pending\n2188\t\t}\n2189\t\treturn \"\", err\n2190\t}\n2191\t\n2192\t// awaitContinuationClaim waits briefly for a claim on prior's continuation,\n2193\t// returning it as pending, or nil when none appears.\n2194\tfunc (s Store) awaitContinuationClaim(prior ReviewRun) *PendingRevie