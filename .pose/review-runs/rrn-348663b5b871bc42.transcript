required\", \"never\"},\npose-mcp/internal/cli/closeout_review_policy_test.go:177:\t\t{\"adopt\", \"closeout-review-policy\", \"--milestone-review-required\", \"sometimes\", \"--roadmap-review-required\", \"never\", \"--apply\"},\npose-mcp/internal/cli/closeout_review_policy_test.go:186:\tif code, out := runPose(t, root, \"adopt\", \"closeout-review-policy\", \"--apply\"); code != 0 {\npose-mcp/internal/cli/closeout_review_policy_test.go:193:\tif code, out := runPose(t, root, \"adopt\", \"closeout-review-policy\", \"--milestone-review-required\", \"when-justified\", \"--roadmap-review-required\", \"always\", \"--apply\"); code != 0 {\npose-mcp/internal/cli/closeout_review_policy_test.go:200:\tif code, out := runPose(t, root, \"adopt\", \"closeout-review-policy\", \"--off\", \"--apply\"); code == 0 || !strings.Contains(out, \"cannot be turned off\") {\npose-mcp/internal/cli/closeout_review_policy_test.go:215:\tif code, out := runPoseJSON(t, root, &plan, \"setup\", \"--json\"); code != 0 || !plan.CloseoutReview.Adopted || plan.CloseoutReview.Milestone != \"when-justified\" {\npose-mcp/internal/cli/closeout_review_policy_test.go:220:func TestCloseoutReviewPolicySetupShowsTheLegacyRule(t *testing.T) {\npose-mcp/internal/cli/closeout_review_policy_test.go:223:\tif code, out := runPoseJSON(t, root, &plan, \"setup\", \"--json\"); code != 0 || plan.CloseoutReview.Adopted || !strings.HasPrefix(plan.CloseoutReview.Milestone, \"legacy\") || plan.CloseoutReview.ProposedMilestone != \"never\" {\npose-mcp/internal/cli/closeout_review_policy_test.go:232:func TestCloseoutReviewPolicyDoctor(t *testing.T) {\npose-mcp/internal/cli/closeout_review_policy_test.go:245:// TestCloseoutReviewPolicySmoke drives the built binary from the production\npose-mcp/internal/cli/closeout_review_policy_test.go:248:func TestCloseoutReviewPolicySmoke(t *testing.T) {\npose-mcp/internal/cli/closeout_review_policy_test.go:257:\tif code, out := runBuilt(t, root, \"adopt\", \"closeout-review-policy\", \"--mi