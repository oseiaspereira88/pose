inal_verification_test.go\npose-mcp/internal/cli/closeout_plan_test.go\npose-mcp/internal/cli/closeout_plan.go\npose-mcp/internal/cli/review_closeout.go\npose-mcp/internal/cli/closeout_review_policy_test.go\n.pose/specs/2026-11-01-pose-closeout-names-the-missing-trailer.md\n.pose/specs/2026-10-13-pose-closeout-terminal-verification.md\n.pose/specs/2026-08-02-pose-hierarchical-review-closeout.md\n.pose/specs/2026-11-11-pose-closeout-review-policy-by-cost-benefit.md\n","exit_code":0,"status":"completed"}}
