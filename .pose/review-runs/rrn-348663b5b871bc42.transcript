{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/usr/bin/bash -lc 'nl -ba pose-mcp/internal/pose/closeout_adr_associations.go'","aggregated_output":"     1\tpackage pose\n     2\t\n     3\t// ADR associations of a roadmap, for the when-justified roadmap rule of the\n     4\t// closeout review evaluator (spec pose-closeout-review-policy-by-cost-benefit).\n     5\t//\n     6\t// An association is explicit, never inferred from prose:\n     7\t//   - forward: the roadmap's `adrs: [adr:<file>.md]` frontmatter, or a local\n     8\t//     Markdown link from its body to a file in .pose/adr/;\n     9\t//   - backward: an ADR's `roadmaps: [roadmap:<slug>]` (or the qualified\n    10\t//     `xref:<project>/roadmap:<slug>`) frontmatter, or a local Markdown link\n    11\t//     from the ADR to .pose/roadmaps/<slug>.md.\n    12\t//\n    13\t// Only the owning project's .pose/adr/ is inventoried; nothing searches other\n    14\t// projects. A malformed declaration, a link to a missing file or an\n    15\t// incomplete inventory is unknown, which can never prove absence.\n    16\t\n    17\timport (\n    18\t\t\"fmt\"\n    19\t\t\"os\"\n    20\t\t\"path/filepath\"\n    21\t\t\"regexp\"\n    22\t\t\"sort\"\n    23\t\t\"strings\"\n    24\t)\n    25\t\n    26\tconst (\n    27\t\tcloseoutADRInventoryLimit = 4096\n    28\t\tcloseoutADRSizeLimit      = 1 << 20\n    29\t)\n    30\t\n    31\tvar (\n    32\t\t// [text](dest \"title\") and [text](<dest>) inline links.\n    33\t\tmarkdownInlineLinkRE = regexp.MustCompile(`\\]\\(\\s*(<[^>\\n]*>|[^)\\s]+)(?:\\s+(?:\"[^\"]*\"|'[^']*'|\\([^)]*\\)))?\\s*\\)`)\n    34\t\t// [label]: dest \"title\" reference definitions.\n    35\t\tmarkdownReferenceLinkRE = regexp.MustCompile(`(?m)^\\s{0,3}\\[[^\\]\\n]+\\]:\\s*(<[^>\\n]*>|\\S+)`)\n    36\t)\n    37\t\n    38\tfunc (s Store) adrDir() string { return filepath.Join(s.Root, \".pose\", \"adr\") }\n    39\t\n    40\t// markdownLinkDestinations lists the link destinations of a Markdown body,\n    41\t// angle brackets and fragments removed. External URLs are kept out.\n    42\tfunc markdownLinkDestinations(body string) []string {\n    43\t\t// Fenced code, inline code and comments document links; they do not make\n    44\t\t// them (review round 12, N40).\n    45\t\tbody = markdownWithoutCode(body)\n    46\t\tout := []string{}\n    47\t\tadd := func(dest string) {\n    48\t\t\tdest = strings.TrimSpace(dest)\n    49\t\t\tdest = strings.TrimSuffix(strings.TrimPrefix(dest, \"<\"), \">\")\n    50\t\t\tif i := strings.IndexAny(dest, \"#?\"); i >= 0 {\n    51\t\t\t\tdest = dest[:i]\n    52\t\t\t}\n    53\t\t\tif dest == \"\" || strings.Contains(dest, \"://\") || strings.HasPrefix(dest, \"mailto:\") || strings.HasPrefix(dest, \"/\") {\n    54\t\t\t\treturn\n    55\t\t\t}\n    56\t\t\tout = append(out, dest)\n    57\t\t}\n    58\t\tfor _, m := range markdownInlineLinkRE.FindAllStringSubmatch(body, -1) {\n    59\t\t\tadd(m[1])\n    60\t\t}\n    61\t\tfor _, m := range markdownReferenceLinkRE.FindAllStringSubmatch(body, -1) {\n    62\t\t\tadd(m[1])\n    63\t\t}\n    64\t\treturn out\n    65\t}\n    66\t\n    67\tvar (\n    68\t\tmarkdownCommentRE    = regexp.MustCompile(`(?s)<!--.*?-->`)\n    69\t\tmarkdownInlineCodeRE = regexp.MustCompile(\"`+[^`\\n]*`+\")\n    70\t)\n    71\t\n    72\t// markdownWithoutCode blanks fenced code blocks, inline code spans and HTML\n    73\t// comments, so the links they show are not read as links.\n    74\tfunc markdownWithoutCode(body string) string {\n    75\t\tbody = markdownCommentRE.ReplaceAllString(body, \"\")\n    76\t\tvar out strings.Builder\n    77\t\t// A fence keeps its whole delimiter: it closes only on a line of the\n    78\t\t// same character, at least as long, and nothing else (review round 13,\n    79\t\t// N44).\n    80\t\tfenceChar, fenceLen := byte(0), 0\n    81\t\trun := func(s string) (byte, int) {\n    82\t\t\tif s == \"\" || s[0] != '`' && s[0] != '~' {\n    83\t\t\t\treturn 0, 0\n    84\t\t\t}\n    85\t\t\tn := 0\n    86\t\t\tfor n < len(s) && s[n] == s[0] {\n    87\t\t\t\tn++\n    88\t\t\t}\n    89\t\t\treturn s[0], n\n    90\t\t}\n    91\t\tfor _, line := range strings.SplitAfter(body, \"\\n\") {\n    92\t\t\ttrimmed := strings.TrimSpace(line)\n    93\t\t\tif fenceLen > 0 {\n    94\t\t\t\tif c, n := run(trimmed); c == fenceChar && n >= fenceLen && n == len(trimmed) {\n    95\t\t\t\t\tfenceChar, fenceLen = 0, 0\n    96\t\t\t\t}\n    97\t\t\t\tout.WriteString(\"\\n\")\n    98\t\t\t\tcontinue\n    99\t\t\t}\n   100\t\t\tif c, n := run(trimmed); n >= 3 && !(c == '`' && strings.Contains(trimmed[n:], \"`\")) {\n   101\t\t\t\tfenceChar, fenceLen = c, n\n   102\t\t\t\tout.WriteString(\"\\n\")\n   103\t\t\t\tcontinue\n   104\t\t\t}\n   105\t\t\tout.WriteString(markdownInlineCodeRE.ReplaceAllString(line, \"\"))\n   106\t\t}\n   107\t\treturn out.String()\n   108\t}\n   109\t\n   110\t// associationList reads one association key (adrs: on a roadmap, roadmaps: on\n   111\t// an ADR) from the raw frontmatter of a governance file, strictly: a key\n   112\t// declared more than once, declared with no value, outside a [list], or with\n   113\t// an empty item is reported, never read as an absent or empty association. An\n   114\t// explicit [] declares none (review round 12, N39).\n   115\tfunc associationList(raw, key, owner string) ([]string, bool, string) {\n   116\t\tlines := strings.Split(strings.ReplaceAll(raw, \"\\r\\n\", \"\\n\"), \"\\n\")\n   117\t\tif len(lines) == 0 || strings.TrimSpace(lines[0]) != \"---\" {\n   118\t\t\treturn nil, false, \"\"\n   119\t\t}\n   120\t\tvalues := []string{}\n   121\t\tfor _, line := range lines[1:] {\n   122\t\t\tif strings.TrimSpace(line) == \"---\" {\n   123\t\t\t\tbreak\n   124\t\t\t}\n   125\t\t\t// The key and value as SplitFrontmatter reads them: the key trimmed,\n   126\t\t\t// a template comment removed (review round 13, N45).\n   127\t\t\tif name, value, ok := strings.Cut(line, \":\"); ok && strings.TrimSpace(name) == key {\n   128\t\t\t\tvalues = append(values, cleanValue(value))\n   129\t\t\t}\n   130\t\t}\n   131\t\tswitch {\n   132\t\tcase len(values) == 0:\n   133\t\t\treturn nil, false, \"\"\n   134\t\tcase len(values) > 1:\n   135\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: %d times; one declaration is required\", owner, key, len(values))\n   136\t\t}\n   137\t\tvalue := values[0]\n   138\t\tif value == \"\" {\n   139\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: with no value; declare [] for none\", owner, key)\n   140\t\t}\n   141\t\tif !strings.HasPrefix(value, \"[\") || !strings.HasSuffix(value, \"]\") {\n   142\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: outside a [list]\", owner, key)\n   143\t\t}\n   144\t\tinner := strings.TrimSpace(value[1 : len(value)-1])\n   145\t\tif inner == \"\" {\n   146\t\t\treturn []string{}, true, \"\"\n   147\t\t}\n   148\t\titems := []string{}\n   149\t\tfor _, item := range strings.Split(inner, \",\") {\n   150\t\t\titem = strings.TrimSpace(item)\n   151\t\t\tif item == \"\" {\n   152\t\t\t\treturn nil, true, fmt.Sprintf(\"%s declares %s: with an empty item\", owner, key)\n   153\t\t\t}\n   154\t\t\titems = append(items, item)\n   155\t\t}\n   156\t\treturn items, true, \"\"\n   157\t}\n   158\t\n   159\t// validADRBasename accepts exactly a file name ending in .md directly inside\n   160\t// .pose/adr/: no directory, traversal, hidden file or URI.\n   161\tfunc validADRBasename(name string) bool {\n   162\t\treturn name != \"\" && filepath.Base(name) == name && !strings.ContainsAny(name, `/\\:`) &&\n   163\t\t\t!strings.HasPrefix(name, \".\") && strings.HasSuffix(name, \".md\") && name != \".md\"\n   164\t}\n   165\t\n   166\t// regularADR reports a regular, non-symlinked file of .pose/adr/ within the root.\n   167\tfunc (s Store) regularADR(name string) error {\n   168\t\tpath := filepath.Join(s.adrDir(), name)\n   169\t\tinfo, err := s.fsys().Lstat(path)\n   170\t\tif err != nil {\n   171\t\t\treturn err\n   172\t\t}\n   173\t\tif info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, path) {\n   174\t\t\treturn fmt.Errorf(\"not a regular file inside .pose/adr\")\n   175\t\t}\n   176\t\treturn nil\n   177\t}\n   178\t\n   179\t// closeoutADRAssociations returns the sorted ADR basenames associated with a\n   180\t// roadmap, and the diagnostics that make the answer unknown.\n   181\tfunc (s Store) closeoutADRAssociations(rm *Roadmap, project string) ([]string, []string) {\n   182\t\tfound := map[string]bool{}\n   183\t\tdiagnostics := []string{}\n   184\t\trawRoadmap, readErr := s.fsys().ReadFile(rm.Path)\n   185\t\tif readErr != nil {\n   186\t\t\tdiagnostics = append(diagnostics, \"roadmap \"+rm.Slug+\" could not be read for its adrs: \"+readErr.Error())\n   187\t\t}\n   188\t\tdeclared, _, declarationProblem := associationList(string(rawRoadmap), \"adrs\", \"roadmap \"+rm.Slug)\n   189\t\tif declarationProblem != \"\" {\n   190\t\t\tdiagnostics = append(diagnostics, declarationProblem)\n   191\t\t}\n   192\t\tfor _, item := range declared {\n   193\t\t\tname, ok := strings.CutPrefix(item, \"adr:\")\n   194\t\t\tif !ok || !validADRBasename(name) {\n   195\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares %q, not adr:<file>.md\", rm.Slug, item))\n   196\t\t\t\tcontinue\n   197\t\t\t}\n   198\t\t\tif err := s.regularADR(name); err != nil {\n   199\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s declares adr:%s, which cannot be read: %v\", rm.Slug, name, err))\n   200\t\t\t\tcontinue\n   201\t\t\t}\n   202\t\t\tfound[name] = true\n   203\t\t}\n   204\t\tbody := rm.Body\n   205\t\tif body == \"\" {\n   206\t\t\tif full, err := s.GetRoadmap(rm.Slug); err == nil {\n   207\t\t\t\tbody = full.Body\n   208\t\t\t}\n   209\t\t}\n   210\t\troadmapDir := filepath.Dir(rm.Path)\n   211\t\tfor _, dest := range markdownLinkDestinations(body) {\n   212\t\t\ttarget := filepath.Clean(filepath.Join(roadmapDir, filepath.FromSlash(dest)))\n   213\t\t\tif filepath.Dir(target) != filepath.Clean(s.adrDir()) || !strings.HasSuffix(target, \".md\") {\n   214\t\t\t\tcontinue\n   215\t\t\t}\n   216\t\t\tname := filepath.Base(target)\n   217\t\t\tif err := s.regularADR(name); err != nil {\n   218\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"roadmap %s links to %s, which cannot be read: %v\", rm.Slug, dest, err))\n   219\t\t\t\tcontinue\n   220\t\t\t}\n   221\t\t\tfound[name] = true\n   222\t\t}\n   223\t\tentries, err := s.fsys().ReadDir(s.adrDir())\n   224\t\tif err != nil && !os.IsNotExist(err) {\n   225\t\t\tdiagnostics = append(diagnostics, \"the ADR inventory could not be read: \"+err.Error())\n   226\t\t}\n   227\t\tif len(entries) > closeoutADRInventoryLimit {\n   228\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"the ADR inventory has %d entries, above the limit of %d\", len(entries), closeoutADRInventoryLimit))\n   229\t\t\tentries = nil\n   230\t\t}\n   231\t\troadmapPath := filepath.Clean(filepath.Join(s.roadmapsDir(), rm.Slug+\".md\"))\n   232\t\tfor _, entry := range entries {\n   233\t\t\tname := entry.Name()\n   234\t\t\t// Every candidate is read, the associated ones included: its size,\n   235\t\t\t// its readability and its own declaration are inputs. One that\n   236\t\t\t// cannot be read could hold a backlink, so it is unknown.\n   237\t\t\tif entry.IsDir() || !strings.HasSuffix(name, \".md\") {\n   238\t\t\t\tcontinue\n   239\t\t\t}\n   240\t\t\tif err := s.regularADR(name); err != nil {\n   241\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is not a regular file of .pose/adr: \"+err.Error())\n   242\t\t\t\tcontinue\n   243\t\t\t}\n   244\t\t\tpath := filepath.Join(s.adrDir(), name)\n   245\t\t\tif info, err := s.fsys().Lstat(path); err != nil || info.Size() > closeoutADRSizeLimit {\n   246\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" is unreadable or above the size limit\")\n   247\t\t\t\tcontinue\n   248\t\t\t}\n   249\t\t\traw, err := s.fsys().ReadFile(path)\n   250\t\t\tif err != nil {\n   251\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" could not be read: \"+err.Error())\n   252\t\t\t\tcontinue\n   253\t\t\t}\n   254\t\t\t_, adrBody := SplitFrontmatter(string(raw))\n   255\t\t\tbackward, _, backwardProblem := associationList(string(raw), \"roadmaps\", \"ADR \"+name)\n   256\t\t\tif backwardProblem != \"\" {\n   257\t\t\t\tdiagnostics = append(diagnostics, backwardProblem)\n   258\t\t\t}\n   259\t\t\tfor _, item := range backward {\n   260\t\t\t\tref, err := ParseArtifactRef(item)\n   261\t\t\t\tif err != nil || ref.Kind != \"roadmap\" || ref.Milestone != \"\" {\n   262\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %q, not roadmap:<slug>\", name, item))\n   263\t\t\t\t\tcontinue\n   264\t\t\t\t}\n   265\t\t\t\tif ref.Project != \"\" && ref.Project != project {\n   266\t\t\t\t\tcontinue // a roadmap of another project: not this association\n   267\t\t\t\t}\n   268\t\t\t\tif _, err := s.GetRoadmap(ref.Slug); err != nil {\n   269\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %s, which names no roadmap of this project\", name, item))\n   270\t\t\t\t\tcontinue\n   271\t\t\t\t}\n   272\t\t\t\tif ref.Slug == rm.Slug {\n   273\t\t\t\t\tfound[name] = true\n   274\t\t\t\t}\n   275\t\t\t}\n   276\t\t\tfor _, dest := range markdownLinkDestinations(adrBody) {\n   277\t\t\t\ttarget := filepath.Clean(filepath.Join(s.adrDir(), filepath.FromSlash(dest)))\n   278\t\t\t\tif filepath.Dir(target) != filepath.Clean(s.roadmapsDir()) || !strings.HasSuffix(target, \".md\") {\n   279\t\t\t\t\tcontinue\n   280\t\t\t\t}\n   281\t\t\t\t// A link into the roadmaps namespace is an association input: one\n   282\t\t\t\t// that does not resolve to a roadmap leaves the answer unknown.\n   283\t\t\t\tif info, err := s.fsys().Lstat(target); err != nil || !info.Mode().IsRegular() || !artifactPathWithin(s.fsys(), s.Root, target) {\n   284\t\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which is not a roadmap of this project\")\n   285\t\t\t\t\tcontinue\n   286\t\t\t\t}\n   287\t\t\t\t// The target is read as the roadmap it names, as a roadmaps:\n   288\t\t\t\t// declaration is: a regular entry that cannot be read or parsed\n   289\t\t\t\t// leaves the answer unknown, never an absence. The roadmaps README\n   290\t\t\t\t// is no roadmap, as ListRoadmaps reads the namespace.\n   291\t\t\t\tif strings.EqualFold(filepath.Base(target), \"README.md\") {\n   292\t\t\t\t\tcontinue\n   293\t\t\t\t}\n   294\t\t\t\tif _, err := s.GetRoadmap(strings.TrimSuffix(filepath.Base(target), \".md\")); err != nil {\n   295\t\t\t\t\tdiagnostics = append(diagnostics, \"ADR \"+name+\" links to \"+dest+\", which could not be read as a roadmap of this project\")\n   296\t\t\t\t\tcontinue\n   297\t\t\t\t}\n   298\t\t\t\tif target == roadmapPath {\n   299\t\t\t\t\tfound[name] = true\n   300\t\t\t\t}\n   301\t\t\t}\n   302\t\t}\n   303\t\tadrs := make([]string, 0, len(found))\n   304\t\tfor name := range found {\n   305\t\t\tadrs = append(adrs, name)\n   306\t\t}\n   307\t\tsort.Strings(adrs)\n   308\t\tsort.Strings(diagnostics)\n   309\t\treturn adrs, diagnostics\n   310\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 8e3009b2 4cd03ae9 -- .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md .pose/templates/roadmap.md POSE.md pose-mcp/internal/cli/doctor.go pose-mcp/internal/cli/surface_check.go pose-mcp/internal/pose/spec.go'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 8e3009b2 4cd03ae9 -- .pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md .pose/templates/roadmap.md POSE.md pose-mcp/internal/cli/doctor.go pose-mcp/internal/cli/surface_check.go pose-mcp/internal/pose/spec.go'","aggregated_output":"diff --git a/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md b/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\nindex 6e369a55..570b9503 100644\n--- a/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n+++ b/.pose/adr/2026-11-03-governance-reads-use-bounded-operation-scoped-views.md\n@@ -229,3 +229,24 @@ uses Read/Grep/Glob/Bash without Edit/Write/Agent tools or plan approval mode.\n This changes neither independence nor stream/output/run limits; the actual\n working tree remains checked for mutation. No vendor profile becomes a scaffold\n default.\n+\n+\n+## Capacity recalibration of captured input bytes (D10) — 2026-11-13\n+\n+Closing spec `pose-closeout-review-policy-by-cost-benefit`, `pose index` in a\n+fresh clone and then in the maintainer checkout refused the pose-dist corpus:\n+`index.delivery-integrity` exceeded the captured-input budget and\n+`index.generate` was left without a complete observation. Measured with a Git\n+shim on the real builder: the change sets of every spec read `git show\n+--binary` for 2,451 distinct trailer commits, 492 MB of Git output in the\n+capture (the final audit reads it again under its own budget), plus the file\n+inputs of the generation, so the operation needed more than 512 MiB. Nothing\n+was truncated; the refusal was correct. Raise the captured-input budget to\n+1 GiB, for capture and audit alike, and keep every other limit, including the\n+512 MiB executable-hash bound of D9. Observations retain their bytes, so the\n+operation may now hold up to 1 GiB of captured input in memory. This\n+recalibration buys headroom, not a scaling property: the corpus grows with\n+every attributed commit. The structural fix, retaining only a digest for pure\n+reads of immutable Git objects whose bytes a producer only hashes, is a\n+follow-up of that spec, and a further raise again requires a measured\n+reassessment.\ndiff --git a/.pose/templates/roadmap.md b/.pose/templates/roadmap.md\nindex 54699c8b..25a3e861 100644\n--- a/.pose/templates/roadmap.md\n+++ b/.pose/templates/roadmap.md\n@@ -3,6 +3,7 @@ slug: <roadmap-slug>\n status: draft        # draft | active | done | abandoned\n created_at: <YYYY-MM-DD>\n depends_on:          # prerequisite roadmaps, inline list: other-roadmap-a, other-roadmap-b\n+adrs: []             # optional ADR associations: [adr:<file>.md] (closeout review policy, when-justified)\n ---\n \n # Roadmap: <roadmap-slug>\ndiff --git a/POSE.md b/POSE.md\nindex 404ee8cb..45860721 100644\n--- a/POSE.md\n+++ b/POSE.md\n@@ -371,6 +371,7 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n   **Raw history:** every history reader of structural review and of the delivery graph ignores replace refs and grafts; a repository with either gets other review inputs than before, so rerun `pose index` and reseal. A trailer change set that starts at the repository's first commit resolves against the empty tree.\n   **Removal witnesses:** a review subject path a later spec removed reads as that removal only while Git still shows it: the deleting commit on `HEAD`, read raw, with no later commit touching the path, in a clone that is not shallow. Otherwise preparation refuses and asks for `pose index`. A generation binds the change sets of `.pose/reports/history` as `recorded-change-sets`, so one published earlier reads as unbound until the next `pose index`.\n   **Children:** a milestone of one local member has no review of its own and stands on that spec's closed approval, and a roadmap may declare `unreviewed_milestones` for milestones whose members are all terminal, sealed by its own review. Otherwise a milestone or roadmap's approval stands only while the review of each child does: a child rejected, stale, with lost attestation history, or not closed under a done parent stops the parent verifying approved, in `review verify`, `review-check` and closeout, and the parent recovers with its child, with no reseal. Selection follows replacement lineage: a replacement of the same content comes before what it replaces whatever the seal times say, a `replaces` naming other content counts for nothing, and a replaced bundle's approval is not retained.\n+  **Closeout review policy (schema 5):** an instance that adopts `pose adopt closeout-review-policy` decides with `milestone_review_required` and `roadmap_review_required` (`never`, `when-justified`, `always`) whether the close of a milestone or a roadmap owes its own review. `when-justified` requires it for a milestone with more than two distinct specs, and for a roadmap with more than one distinct spec and at least one ADR association (`adrs: [adr:<file>.md]` on the roadmap, `roadmaps: [roadmap:<slug>]` on the ADR, or a local Markdown link either way). `always` requires it even for a one-member milestone, and neither the singleton inheritance nor `unreviewed_milestones` weakens it. Member reviews stay required; a review recorded on the scope anyway is verified as before and its rejection stands; a member or association that cannot be resolved never grants an exemption. A milestone that closes without its own review keeps its exit gate: the gate is carried into the review plan of its only member, or of its last member (the one sealed once every other member is terminal), and the close is blocked until an approved member review judged the gate as it reads now, or the milestone is reviewed itself. A member a transfer moved counts at its destination, and a milestone or roadmap named by `after:`, `consumes:` or a spec's `depends_on` satisfies the edge, and makes a dependent spec ready, only once closed under its project's adopted policy, not by its members' status; a done roadmap closed by its receipt keeps its milestones reachable again if their closure stops verifying. Under the adopted policy `pose close milestone:<roadmap>/<id>` and `pose close roadmap:<slug>` stay explicit in every mode and publish a receipt (`review-closeouts/<milestone|roadmap>/…json` inside `.pose/`) with `review: required|not-required`, the key, the value, `closeout-review@1` and the reason (`members=1, threshold>2`); the scope is terminal only with it. New instances adopt `never`/`never`; an existing policy keeps the legacy rule until it adopts, `pose setup` shows both, `pose doctor` lists open scopes that owe a review, and roadmaps closed before adoption are verified by the contract they were sealed under.\n - `close` — applies a review-gated lifecycle transition to complete a spec, milestone, or roadmap. The transition is published only over the bytes its gates judged, under the spec's lifecycle lock that start and transfer also take (spec `pose-writer-coordination-and-atomic-publication`): an edit made while the gates ran is a `publish-conflict` that keeps the edit, the authorization is judged again inside the lock, and a start or transfer holding the spec refuses the close with the lock's owner (`start-in-progress` or `spec-lifecycle-in-progress`). Git state (spec `pose-git-and-dispatch-snapshot-integrity`): a `git status`, HEAD or tree that cannot be read is unknown, not clean — the close plan blocks on it rather than sealing evidence over a working tree it could not see (a directory with no repository at all is a different fact and keeps its behaviour); the governed snapshot, the review-bundle path check and the obligation snapshot report an unreadable status as unknown too. `review dispatch` compares the review worktree with the sealed commit's own tree before and after the run, so `assume-unchanged`, `skip-worktree`, a replaced type or a link cannot hide an edit; native derived regeneration requires exact producer outputs that remain regular files; adapter output belongs on stdout or the external output path, and directory names grant no permission to modify the review worktree, and a run that finishes after its bundle was superseded or its policy changed is recorded `stale`, history and not the scope's current fulfilment.\n - `continuous-closeout` — persists and projects continuous closeout terminal state for rapid-iteration workflows. `status --json` writes one operation result whose `data` holds `active` and `terminal`; the exit stays 1 while an active scope is not terminal.\n - **Output channels** — the result (verdict, findings, data) goes to stdout and progress (steps, usage, the command's own failures) to stderr, so `pose x --json | jq` is safe and `2>/dev/null` never hides a finding. `--json` prints one document whose finding `severity` is the untranslated anchor; `--quiet` prints the verdict alone; `pose validate --verbose` streams a check's output instead of capturing it. Colour, symbols and the spinner exist only on a terminal, resolved per stream, and honour `--color`, `POSE_COLOR`, `NO_COLOR` and `TERM`; `COLUMNS` sets the wrap width and `POSE_LOCALE` (`en` or `pt-BR`) the language of every message POSE composes. Exit codes: 0 pass, 1 gate failure, 2 usage error.\n@@ -381,7 +382,7 @@ pose release-package-manifests --version X.Y.Z --checksums <checksums.txt> --out\n - `state --governance [--scope <ref>] [--json]` (spec `pose-effective-governance-projection`) — live, read-only projection of what governance is in force here: for each registry contract, optional capability (atomic start, contract nodes, causality closeout, qualified references, spec transfer, criterion reuse, signed attestations, verified identity) and gate (Definition of Ready, delivery integrity), whether it is `supported`, `configured`, `applicable` and `effective`, with reason codes such as `not-adopted`, `no-readiness-cutoff`, `legacy-cutoff:<date>` or `identity-assurance-declared`. `--scope` compares the scope's newest sealed bundle — the contracts it stamped — with what the policy seals today. It reads the same functions the gates call and writes nothing. `pose_project_state` carries the same projection as `effective_governance` (optional `governance_scope`).\n - `state --attention` (specs `pose-obligation-projection`, `pose-state-attention`) — live, read-only answer to \"what is still owed, by whom, restricting which phase?\". Obligations are projected from the subsystems that own them — readiness (unmet `depends_on`, Definition of Ready, unexplained `blocked`), closeout and review of in-progress specs (an unapproved review, each judgment criterion a sealed bundle still owes, text blockers carried as `legacy-opaque`), start reconciliation when atomic start is adopted, and open follow-ups as advisory residual debt — never stored a second time. Project-level sources are projected too (spec `pose-attention-projects-every-source`), originating on `xref:<project>/project:<project>`: an open docs review mark (owed by the doc's owner until `pose docs-review resolve`), a capability mechanism with a stale trigger, a release newer than the newest verified one that is not yet verified, and an accepted-risk or follow-up finding past its review date in the latest legacy review record. Free-form investigation notes carry no state and are not a source. The render shows coverage first: a producer that failed, or action requests until adopted, makes the answer `INCOMPLETE`, so an empty group never reads as nothing owed, and a fresh install, once committed, reads `complete`. Then what needs `--actor` (or any person or role), then what restricts each phase (`start`, `execution`, `review`, `closeout`, `release`), then residual debt. `--json` returns the report — stable `obl-` ids, qualified refs, reason codes, conditions, recipients, effects, satisfaction, knowledge, waiting, a snapshot of revision/dirty tree/policy/contract/index digests, per-producer coverage — plus the `attention` grouping. MCP: `pose_obligations` returns the same ids from the same function. Attention is not a gate.\n - Governance read views (spec `pose-governance-read-view-generation`) — inspect `snapshot.read_view` in `state --attention --json` and `pose_obligations`: its own `schema_version: 1`, observed-input ID, engine/parser versions and root bindings describe one operation. The enclosing report stays at schema version 1. Review and closeout JSON expose the same contract in `read_view`. The ID binds consumed bytes, directory observations, errors and absences; revision, dirty state, size and mtime alone do not prove equivalence. `current` describes the final audit instant only. Coherence, producer coverage and freshness are separate: `unknown` or incomplete coverage must never be read as nothing owed or as write authorization. A historical report without this binding remains readable and proves no current authorization.\n-  Reads retain at most 40,000 observations including retained directory entries, 512 MiB of input bytes and 16 MiB of metadata. A detected interleaving discards that attempt and retries the whole read once; another change leaves the affected coverage incomplete and freshness `unknown`. Unsupported readers and unbound federated inputs remain unknown. Participating writers acquire authorized root guards before reevaluation and hold them through publication; destination CAS and index descriptor checks remain in force. Writers outside that protocol, including an external change restored before audit, are outside this exclusion guarantee. No watcher, daemon or cross-operation cache is introduced.\n+  Reads retain at most 40,000 observations including retained directory entries, 1 GiB of input bytes and 16 MiB of metadata. A detected interleaving discards that attempt and retries the whole read once; another change leaves the affected coverage incomplete and freshness `unknown`. Unsupported readers and unbound federated inputs remain unknown. Participating writers acquire authorized root guards before reevaluation and hold them through publication; destination CAS and index descriptor checks remain in force. Writers outside that protocol, including an external change restored before audit, are outside this exclusion guarantee. No watcher, daemon or cross-operation cache is introduced.\n   The global review-closeout check composes an audited selection/catalogue coordinator with independently bounded scope operations. A scope and its recursive children use one closure; workers share only the explicitly bound immutable catalogue. At most 16 scope closures are live, further limited by `POSE_CHECK_WORKERS` or the core count. Scope findings are buffered until their audits and the coordinator audit finish. This proves coherent selection and individually audited results, not a simultaneous snapshot across every completed scope; one exhausted scope cannot consume its sibling's capture budget, and any unresolved loss still fails the global gate.\n - `action <open|list|show|resolve|cancel|waive|invalidate>` (specs `pose-action-requests`, `pose-action-request-resolution`) — material requests to a person or an external system that no other source records: a decision, an approval, an input, an external operation or an acceptance, with its question, options and consequences, recommendation, recipient (principal, role or `unassigned`), qualified targets (`requirement:R4` inside the origin spec, or `xref:…`), per-phase effects (`--effect closeout:block` lets implementation continue) and an optional subject (`--subject requirement:R4` or `path:<file>`) whose change invalidates an answer recorded for the old content. Open one only when a different answer would materially change execution, scope, authority, risk acceptance, closeout or publication and no authorization already given covers it. Each request is an append-only journal under `.pose/actions/`, read whole: a line with a second value, a duplicate field (keys differing only in case included), an unknown event type, another schema, a sequence gap, an empty line or no terminator is never part of a view; `action show|list` and MCP locate it (line, byte offset, length, SHA-256) as an `interrupted-tail`, with a truncation proposal for a person to review, or as `corrupt`, to restore from version control — the engine repairs nothing (spec `pose-journal-checkpoint-and-lock-recovery`); `open` is a preview until `--apply`. Targets are qualified with the current project id; when it is derived from the directory name (no `.pose/project.json`, `POSE_DEFAULT_PROJECT_ID` or `POSE_PROJECT_ROOTS` binding), `open --apply` says so (on stderr with `--json`), because a checkout under another name would record another project, and the obligation snapshot lists the same limitation. A resolution names the `--request-digest` it answers and the `--expected-revision` it read, carries an `--idempotency-key` (a retry is a no-op, the same key with other content is refused, a second answer against the same revision is refused) and comes from an actor holding the recipient role in `.pose/policy/actions.json` (`{\"schema_version\":1,\"roles\":{\"maintainer\":[\"human:<name>\"]},\"identity_assurance\":\"declared|verified\"}`); under `verified` it needs `--claim <file>` with an Ed25519 claim from an issuer pinned in the review policy, bound to project, audience, request digest, principal and answer (a human principal also needs `human_authority_issuers`). Answered is not satisfied: a declined approval, a rejected acceptance or a failed external operation leaves the condition unmet. The requester may cancel its own question; a waiver needs the recipient authority and a reason. Open requests are projected as `actor-action` obligations in `state --attention` and `pose_obligations`; MCP opens requests with `pose_action_open` (risk class `governance-write`, a preview unless `apply` is true) and reads them with `pose_action_requests`; `pose_action_resolve` (spec `pose-mcp-action-resolve-signed-only`, `governance-write`) records an answer only with the principal's proof — a signature by a key registered to it, or a trusted issuer's claim — and refuses a declared answer under any assurance; its preview returns the statement to sign and the `ssh-keygen` command.\n - Action destination scoping (spec `pose-action-target-and-node-scoping`) — origin is provenance, targets select relevance, and effects select restrictions. An empty effect scope still means the whole source artifact; a roadmap or milestone expands its current members. Explicit scopes replace that default, so a request from alpha can restrict beta without blocking alpha. A named whole artifact is a whole restriction, not partial merely because it is qualified. Pending requests remain visible when their origin becomes terminal. Unknown membership or unreadable material is reported as limited coverage and never expands into every spec. CLI accepts `--effect-json '{\"phase\":\"start\",\"mode\":\"block\",\"scope\":[\"xref:project/spec:beta\"]}'`; MCP `effects` accepts the same object alongside legacy `\"start:block\"` strings. Targets and subjects resolve by project/artifact/kind/ID, and a subject is re-read in its recorded artifact. Under adopted agency readiness, new approvals and acceptances require an explicit `--subject` / `subject`; legacy unbound requests retain their journal and report that answers have no content-change detection. Policy-off creation and transition defaults remain unchanged. This compatibility tightening requires release review; no policy adoption happens here.\n@@ -899,6 +900,10 @@ versus task and follow native next actions.\n \n `pose review` governs the subject (bundle, brief, attestation, verify); `pose delegate` governs executions. An **agent** is a CLI profile configured in `.pose/policy/delegation.json`; a **run** is one execution; an **attempt** is a run and its continuations; a **thread** is the rounds of one scope. `pose delegate review`, `adjudicate` and `smoke` run the sealed bundle's generated brief on a disposable worktree at the sealed commit with read access only, under the attempt ledger and containment below; any other `--access` is refused. The agent never records an attestation: the engine records the conclusion of a completed review run only as the conclusions of delegated reviews below describe. Without `--agent` (or with `auto`) routing chooses among the agents of the purpose: first by `routing.prefer` (default `opposite-vendor-of-implementation`, in the order the policy declares its agents), then by the steps of `routing.on_unavailable` (default `same-vendor-other-model`, `wait`, `same-model`). `wait` applies only when every earlier candidate is limited with a known reset within `routing.max_wait` (default 5h) and starts the run after the first reset, without polling. The implementation routed against is the identity the bundle sealed; for a bundle sealed before bundles recorded it, the policy's `provenance.implementation`, else `--lead`. An agent named with `--agent` bypasses routing and warns when it shares the implementation's vendor. Every run records the decision (`routing`: the candidates, why each was skipped, the step taken) and `independence_achieved` (`different-vendor`, `different-model` or `same-model`); with no agent available the run does not start and the error carries the decision. `--label` names the run, `--lead <vendor>[/<model>]` declares the implementation when the bundle records none, `--dry-run` prints the resolved agent, purpose, access, working directory and argv (authorized credential values redacted) and reserves nothing, and `--json` prints one versioned document (`pose.delegate.run/v1`, `plan/v1`, `ls/v1`, `cancel/v1`, `agents/v1`, `error/v1`), usage errors included. On `ls`, `resume`, `cancel` and `agents` the same flags select: a run or an agent that does not match is not listed, or is refused when named; `--dry-run` changes nothing anywhere. Messages follow `POSE_LOCALE` (`en` or `pt-BR`). A run reference is a run id, an attempt id, a label or a session prefix of six characters or more; an ambiguous reference exits 2 and lists the candidates.\n \n+A schema-2 agent may opt in to `review_profile.command` and `review_profile.resume_command` for governed review only. Omission preserves its existing read adapter; tasks, adjudication and smoke keep their commands. A resumable agent must declare the profile's resumed command with `{session}`. Once selected, failure never falls back to the read or task profile. The selected commands remain bound by policy/provenance verification. Older strict parsers reject the new field. The configured Claude event codec canonicalizes repeated typed init records only for the same parsed session identity before session recognition. Different identities and generic regex ambiguity are still refused; raw provenance/redaction and limit/reset channels retain the original bytes.\n+\n+This repository's Claude review profile uses safe/restricted mode, Read/Grep/Glob/Bash only, mandatory shell sandboxing (`failIfUnavailable:true`, `allowUnsandboxedCommands:false`), and a read-only sealed source tree. Both fresh and resumed wrappers require bubblewrap, socat and jq on Linux (jq remains required on macOS), with installation advice on refusal. Go cache/temp writes go to private operation-owned scratch outside the checkout; the existing module cache is read, and unavailable downloads/tests that write into source can fail. The profile instructs the reviewer to run `go clean -cache` as its final Bash command inside the sandbox; the engine independently retains incomplete cleanup as a failed run under its unchanged limits. Never clean an adapter-controlled cache outside the sandbox: a test can replace its path with a symlink. This qualifies Claude's shell subprocess boundary, not isolation of the trusted Claude executable or arbitrary credential reads. Checkout integrity checks still apply. Installing engine code does not adopt the profile in another instance; copy and qualify its explicit policy block before use. The wrapper also denies the resolved physical Git common directory, because Claude auto-allows it for worktrees. For this opt-in profile, POSE prepares only empty `.claude/.cc-writes` directories at the disposable checkout root and declared components before taking its integrity snapshot; added files and all later mutations still fail. Final sandboxed cleanup includes leftover `go-build*` directories directly under GOTMPDIR after all jobs finish.\n+\n `pose delegate ls` lists attempts by their latest run with state, purpose, agent, label, turns, age and last step — for an interrupted run also its cause, whether a partial draft exists, the reset instant and the time left — and the runs in progress with the liveness of their process. `pose delegate cancel <run>` stops a run in progress; it is recorded `failed` with the cause `cancelled`, and its attempt stays consumed. `pose delegate agents` lists each agent with vendor, model, whether its CLI is on the path, the reset instant of its last recorded usage limit and the state routing reads: `available`, `limited until <instant>` (its last run hit a usage limit whose reset is ahead), `missing` (its CLI is not on the path), `unknown` (the run history could not be read whole) or `probe-failed` (its optional `probe` failed within its bound). Availability is read from the path and the recorded runs; only a configured probe runs anything. `pose delegate review|adjudicate|smoke --detach` starts the run as a process of its own, in a session of its own that survives the caller's terminal, and returns at once with the attempt (a run reference) and the path of its log; a run whose route must first wait for a usage-limit reset is not detached. `pose delegate wait <run> [--timeout <d>] [--json]` is a plain foreground process that ends when the run does and prints one line — run, state, decision, resumable flag, reset instant — with the exit code `0` approved, `10` changes requested or rejected, `20` failed (a completed run with no decision too), `30` interrupted, `40` stalled, `50` the wait timed out, and `2` for a usage error; every waiter is released, a run already ended returns at once, and killing a wait leaves the run running. The process running an attempt rewrites a heartbeat in its marker every 10 seconds; a run whose heartbeat is older than three intervals and whose process is provably gone is recorded `stalled` by the first reader, through an exclusive claim every reader then agrees on, and `ls` shows each running run's heartbeat age. `pose delegate watch [<run>|<label>]` shows an attempt as one task: the runs it recorded are replayed with a marker where a run resumed another and the interrupted run naming the run that continued it, then a running attempt is followed through the normalized, redacted events its process writes as they come, until the record is published; `--no-follow` prints what exists and exits, `-v` adds the tail of each tool's output (`--lines <n>`, default 12) and `--json` prints NDJSON. With no reference it follows the only running run; at a terminal it otherwise opens fzf with a preview of the run under the cursor refreshed every `--refresh <d>` (default 2s, 0 turns it off), or a numbered menu without fzf; outside a terminal an absent reference exits 2 and lists the candidates. Colours appear only on a terminal and follow `NO_COLOR`. A live event is redacted with the credentials and the session references the stream has declared so far; the events bound to the record are derived again from the whole transcript. `on_terminal` on an agent (or else on a purpose) is a command run once after a run ends, with only `POSE_DELEGATE_RUN` and `POSE_DELEGATE_STATE` in its environment, the run directory as working directory, its own process group and a bound (`timeout`, default 30s, at most 5m); its failure is recorded beside the run, shown by `ls`, and never changes the run's state. `pose delegate handoff <run> --to <agent|auto>` continues a run that stopped interrupted or failed, short of a conclusion, with another agent under the same attempt and its continuation budget, which is the `resume.max_resumes` and `max_wall_time` of the agent that opened the attempt (3 and 60 minutes by default) whichever agent continues it, so changing agents never widens it; a completed run, the same agent and a run already continued are refused, and a run handed off is no longer resumed. Its brief is the predecessor's generated brief followed by a labelled section: the predecessor's partial final message and the commands it ran with their exit status, paired by the call identifier the agent's stream records and otherwise left unknown rather than guessed, each with its digest, quoted so no line of it reads as a decision, bounded at 16 KiB with the cut disclosed, and an instruction to re-verify. Only the handoff run concludes. The record binds the base brief digest and the section digest in `handoff_digest`, names its predecessor in `hands_off_from`, and a signed proof verifies the section against the predecessor's record. `--to auto` routes as the purpose does, the stopped agent excluded and unavailable ones skipped. A foreground run or handoff that stops interrupted in a terminal offers waiting for its reset and resuming, handing off, or cancelling, which is offered even alone, and does nothing until answered; the stopping command's result, `ls --json` and `wait --json` carry the same ways forward as `next_actions`, each with its command, whether it is available now — judged by the planning its command runs, budget and wait bound included — and why not, and a `cancel` that leaves the run stopped. `watch` marks a handoff with `⇄` beside the `↻` of a resume. `pose delegate task <prompt-file|->` hands any task to another agent: the prompt goes on stdin in `--cd` (default: the current directory) with the agent's command for `--access read|sandboxed|write|full`; the default is `purposes.task.default_access` (read when unset), `full` is never a default and prints a warning naming what it disables. A task's template places `{add_dirs}`, `{no_network}` and `{outside_git}`, filled from the agent's `add_dir_args` (with `{dir}`), `no_network_args` and `outside_git_args`; `--add-dir`, `--no-network` and `--effort` that the agent's template cannot carry are refused with exit 2, and `--no-network` with `write` or `full` too. The final message goes to stdout and the agent's exit code is returned; `--json` replaces both with one document. A task runs in the real directory: containment bounds its time and output, not its filesystem. Its record (prompt, stream, error stream, normalized events, argv, removed variable names, exit code, label) is owner-only under the user's state directory (`$XDG_STATE_HOME/pose/delegate/`, where `XDG_STATE_HOME` counts only as an absolute path and `~/.local/state` is the default), or, with `--record`, in the `delegate-runs` directory of `.pose`. The state directory may be reached through a link of the user's own; resolved, it and every directory above it must belong to the user or to root and be writable by no group or other user unless sticky, and `pose`, `pose/delegate` and the project's directory below it must be real directories of the user's that no group or other user can write; a task refuses to record or read anywhere else and names the directory (on Windows only links are refused). `--detach` starts a task as the review purposes start a detached run and returns its attempt, its log and the place of its record; a prompt piped to `task -` or `resume --prompt -` is read before detaching and written to the detached run through a pipe, never a file, and a refusal before the attempt is reserved returns the foreground's document and exit code. A detached call keeps its log and hand-back in `.pose/review-private/supervisors`, which, with every directory up to the project root, must be the user's and writable by no group or other user, and whose root's ancestors must belong to the user or root and be writable by no one else unless sticky; the root is resolved once and only that resolved root is used, a caller whose current directory is gone is refused, and a project's private task history is keyed by its resolved root (records an earlier engine kept under a linked spelling are still read). A detached call believes a hand-back only once a piped prompt is through and a run reserved the attempt it names. A checkout that fails this can still run in the foreground; on Windows only links and non-directories are refused, and ACLs are not checked. A task is never evidence: no review reader reads it, `pose review attest --run` refuses it by name, and `wait` returns 0 when the agent succeeded, with no decision. `ls`, `watch`, `wait`, `cancel`, `resume` and `handoff` work on tasks; `resume` without `--prompt` sends a default continuation message, with the agent's `resume.commands` for the task's access, and `--agent auto` routes against the launching session. A task can also continue a session POSE never recorded, such as one a personal launcher opened, with `--session <id> --agent <name>`: the agent's resume command for the access runs with that session, the prompt optional, and the record says it continued a session without keeping it. `pose review dispatch`, `resume` and `status`, the aliases this surface deprecated, were removed: each exits 2 and names its `pose delegate` replacement.\n \n `delegation.json` is schema 2: `agents` (vendor, model, `cli`, `events`, per-access `commands`, `effort`, `timeout`, `limit`, `session`, `resume`, `executor`, `containment`, `on_terminal`, `probe` — `command` and an optional `timeout` up to 60s, default 10s, with no placeholder), `routing` (`prefer`, `on_unavailable`, `lead_models` as `{vendor: model}` in lower case, `max_wait` up to 24h), per-purpose budgets (`purposes.<review|adjudicate|smoke|task>.max_runs_per_bundle`, `timeout`) and `env_unset`. Command templates are argv arrays; `{output}`, `{session}` and `{effort}` are whole elements, never interpolated, and `{effort}` becomes the argv fragment of the agent's effort level. An agent's own `max_runs_per_bundle` wins over the purpose's; a purpose's `timeout` wins over the agent's. `pose update` converts `reviewers.json` (schema 1) into `delegation.json` deterministically and removes it: each adapter becomes an agent whose `read` command is the adapter's command, a budget all adapters share moves to the review-path purposes, and every agent projects exactly the adapter it came from. The converted file is archived outside `.pose/policy` and named in `migrated_from`, so a run recorded before the conversion keeps its policy baseline while `delegation.json` is exactly that conversion; editing `delegation.json` ends that, as any policy change does. The engine reads `reviewers.json` while `delegation.json` is absent and refuses when both exist. A schema 1 adapter that interpolates `{output}` or `{session}` inside an argument (in `sh -c` code, for example) is not converted: `pose update` warns and keeps `reviewers.json` until the template passes the placeholder as a whole element.\ndiff --git a/pose-mcp/internal/cli/doctor.go b/pose-mcp/internal/cli/doctor.go\nindex 8944a53d..d091206a 100644\n--- a/pose-mcp/internal/cli/doctor.go\n+++ b/pose-mcp/internal/cli/doctor.go\n@@ -262,6 +262,7 @@ func runDoctorDiagnostics(locale cliLocale) (root string, findings []doctorFindi\n \t}\n \tadd(\"instance.pose-dir\", \"ok\", text(\".pose/ present\", \".pose/ presente\"), \"\")\n \tdiagnoseProjectState(root, add, text)\n+\tdiagnoseCloseoutReviewPolicy(root, add, text)\n \tdiagnoseReviewContinuity(root, add)\n \n \t// 3. Native engine contract.\n@@ -1574,3 +1575,30 @@ func declaredMCPProjectID(raw []byte) string {\n \tid, _ := doc.MCPServers[\"pose\"].Env[\"POSE_DEFAULT_PROJECT_ID\"].(string)\n \treturn id\n }\n+\n+// diagnoseCloseoutReviewPolicy reports open milestones and roadmaps that owe\n+// their own review under the adopted closeout review policy, because of the\n+// policy or of their composition (spec pose-closeout-review-policy-by-cost-benefit\n+// R6). It only reports: `pose close` remains the gate.\n+func diagnoseCloseoutReviewPolicy(root string, add func(string, string, string, string), text func(string, string) string) {\n+\t// The store `pose close` uses, with the resolver the environment binds,\n+\t// so an external or transferred member resolves here as it does there\n+\t// (review round 11, N37).\n+\tstore := cliGovernedStore(root)\n+\tpolicy, err := store.GetReviewPolicy()\n+\tif err != nil || !policy.CloseoutReviewAdopted() {\n+\t\treturn\n+\t}\n+\towing, err := store.CloseoutReviewsOwed()\n+\tif err != nil {\n+\t\tadd(\"closeout-review.owed\", \"warn\", fmt.Sprintf(text(\"open scopes owing a closeout review could not be listed: %v\", \"escopos abertos que devem revisão de fechamento não puderam ser listados: %v\"), err), text(\"run `pose closeout-check <scope>` for each open milestone and roadmap\", \"rode `pose closeout-check <escopo>` para cada milestone e roadmap aberto\"))\n+\t\treturn\n+\t}\n+\tif len(owing) == 0 {\n+\t\tadd(\"closeout-review.owed\", \"ok\", fmt.Sprintf(text(\"no open scope owes a review it lacks (milestone_review_required=%s, roadmap_review_required=%s)\", \"nenhum escopo aberto deve uma revisão que não tem (milestone_review_required=%s, roadmap_review_required=%s)\"), policy.MilestoneReviewRequired, policy.RoadmapReviewRequired), \"\")\n+\t\treturn\n+\t}\n+\tfor _, item := range owing {\n+\t\tadd(\"closeout-review.owed\", \"warn\", fmt.Sprintf(text(\"%s owes its own review: %s=%s, %s; previous rule %s\", \"%s deve revisão própria: %s=%s, %s; regra anterior %s\"), item.Scope, item.Decision.PolicyKey, item.Decision.PolicyValue, item.Decision.Reason, item.Previous), item.Action)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/surface_check.go b/pose-mcp/internal/cli/surface_check.go\nindex 1c9cd9c2..179ff26f 100644\n--- a/pose-mcp/internal/cli/surface_check.go\n+++ b/pose-mcp/internal/cli/surface_check.go\n@@ -397,12 +397,16 @@ func roadmapGate(root, slug, milestone string) (roadmapGateResult, error) {\n \t\t}\n \t\tfound = true\n \t\tfor _, member := range candidate.Specs {\n-\t\t\tlocal := member\n-\t\t\tif ref, err := posemodel.ParseArtifactRef(member); err == nil && ref.Project != \"\" {\n-\t\t\t\tif ref.Project != project {\n-\t\t\t\t\tcontinue\n-\t\t\t\t}\n-\t\t\t\tlocal = ref.Slug\n+\t\t\t// The member as the closeout review policy counts it: a local\n+\t\t\t// member a transfer moved is judged at its destination, and an\n+\t\t\t// external one by federated acceptance (review round 6, N24).\n+\t\t\tlocal, external, unresolved := store.CloseoutMemberTarget(member)\n+\t\t\tif unresolved != \"\" {\n+\t\t\t\tblockers = append(blockers, \"member spec is not resolvable: \"+unresolved)\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tif external {\n+\t\t\t\tcontinue\n \t\t\t}\n \t\t\tstate, err := store.GetCloseoutState(\"spec:\" + local)\n \t\t\tif err != nil || !state.Terminal {\ndiff --git a/pose-mcp/internal/pose/spec.go b/pose-mcp/internal/pose/spec.go\nindex bd17f7a4..aada4858 100644\n--- a/pose-mcp/internal/pose/spec.go\n+++ b/pose-mcp/internal/pose/spec.go\n@@ -56,6 +56,10 @@ type Store struct {\n \tRoot               string // project root containing .pose/\n \tFederatedProjectID string\n \tFederatedResolver  *ArtifactResolver\n+\t// closeoutChain is the chain of local aggregate scopes whose terminal\n+\t// verification is asking for this one, through their dependency edges:\n+\t// a scope already in it is a cycle and is not proven closed.\n+\tcloseoutChain []string\n \t// specs, when set, is the spec listing of one operation, read once\n \t// (spec pose-attention-within-a-second). Nil outside such an operation.\n \tspecs *specSnapshot\n@@ -67,6 +71,10 @@ type Store struct {\n \t// the disk, a preview reads its staged view. A store built from this one\n \t// carries it on.\n \tFS Files\n+\t// planWithoutCloseoutGate builds a review plan without asking the\n+\t// closeout review gate, for the gate's own question about the plan's\n+\t// effective independence (spec pose-closeout-review-policy-by-cost-benefit).\n+\tplanWithoutCloseoutGate bool\n }\n \n // fsys is the store's filesystem.\n","exit_code":0,"status":"completed"}}
