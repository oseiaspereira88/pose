tCloseoutReviewPolicyReceipt(t *testing.T) {\n393:\tstate, err := s.GetCloseoutState(ref)\n402:\tif state.Review.Required || state.Review.CloseoutReview == nil || state.Review.CloseoutReview.Review() != \"not-required\" {\n409:\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n416:\tif err := s.PublishCloseoutReceipt(receipt); err != nil {\n419:\tif err := s.PublishCloseoutReceipt(receipt); err != ErrCloseoutReceiptExists {\n422:\tstate, err = s.GetCloseoutState(ref)\n423:\tif err != nil || !state.Terminal || state.CloseoutReceipt == nil || state.CloseRequired {\n431:\t\tsetCloseoutPolicy(t, root, \"always\", \"always\")\n432:\t\tstate, err := s.GetCloseoutState(ref)\n438:\t\tpath, _ := s.CloseoutReceiptPath(ref)\n440:\t\tstate, err := s.GetCloseoutState(ref)\n444:\t\tif err := s.PublishCloseoutReceipt(receipt); err == nil {\n450:func TestCloseoutReviewPolicyHistory(t *testing.T) {\n464:\t\tsetCloseoutPolicy(t, root, mode, mode)\n469:\t\tif receipt, err := s.ReadCloseoutReceipt(ref); err != nil || receipt != nil {\n472:\t\tif eval, err := s.ReviewCheck(ref); err != nil || eval.CloseoutReview != nil {\n478:func TestCloseoutReviewPolicyUnavailable(t *testing.T) {\n505:\t\tif _, err := s.EvaluateCloseoutReview(\"milestone:program/one\"); err == nil {\n511:func TestCloseoutReviewPolicyFederation(t *testing.T) {\n514:\tsetCloseoutPolicy(t, root, \"never\", \"never\")\n533:\tif state, err := s.GetCloseoutState(ref); err == nil && state.Terminal {\n538:func TestCloseoutReviewPolicyReceiptIntegrity(t *testing.T) {\n541:\tstate, err := s.GetCloseoutState(ref)\n545:\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n551:\t\tforged.Decision.PolicyValue = CloseoutReviewAlways\n552:\t\tif _, err := parseCloseoutReceipt(CanonicalJSON(forged)); err == nil {\n556:\tif err := s.PublishCloseoutReceipt(receipt); err != nil {\n570:\t\tpath, _ := s.CloseoutReceiptPath(ref)\n578:func TestCloseoutReviewPolicyInterruptedRoadmapClose(t *testing.T) {\n581:\tdecision, err := s.CurrentCloseoutDecision(ref)\n585:\tif err := s.PublishCloseoutIntent(ref, decision, reviewFixtureNow); err != nil {\n590:\tif err != nil || eval.CloseoutReview == nil {\n593:\tif err := s.ClearCloseoutIntent(ref); err != nil {\n597:\tif eval, err := s.ReviewCheck(\"milestone:program/core\"); err != nil || eval.CloseoutReview == nil {\n603:\tif eval, err := s.ReviewCheck(\"milestone:program/core\"); err != nil || eval.CloseoutReview != nil {\n608:func TestCloseoutReviewPolicyFederatedReceiptProof(t *testing.T) {\n615:\tstate, err := s.GetCloseoutState(ref)\n619:\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n623:\tif err := s.PublishCloseoutReceipt(receipt); err != nil {\n650:func TestCloseoutReviewPolicyStatusAloneIsNotHistory(t *testing.T) {\n659:\tif eval, err := s.ReviewCheck(\"milestone:program/core\"); err != nil || eval.CloseoutReview == nil || !eval.Required {\n664:func TestCloseoutReviewPolicyRoundTwo(t *testing.T) {\n672:\t\tif d, err := s.CurrentCloseoutDecision(\"milestone:program/one\"); err != nil || d.Required {\n677:\t\tif d, err := s.CurrentCloseoutDecision(\"milestone:program/one\"); err != nil || !d.Required || !strings.Contains(d.Reason, \"mandatory-human\") {\n711:\t\tstate, err := s.GetCloseoutState(ref)\n715:\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n716:\t\tif err != nil || s.PublishCloseoutReceipt(receipt) != nil {\n730:\t\tstate, _ := s.GetCloseoutState(ref)\n731:\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n732:\t\tif err != nil || s.PublishCloseoutReceipt(receipt) != nil {\n743:\t\tif state, err := s.GetCloseoutState(ref); err == nil && state.Terminal {\n749:func TestCloseoutReviewPolicyRoundThree(t *testing.T) {\n767:\t\tstate, _ := s.GetCloseoutState(ref)\n768:\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n769:\t\tif err != nil || s.PublishCloseoutReceipt(receipt) != nil {\n782:\t\tdecision, err := s.CurrentCloseoutDecision(ref)\n786:\t\tstate, _ := s.GetCloseoutState(ref)\n787:\t\treceipt, err := s.NewCloseoutReceipt(ref, decision, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n788:\t\tif err != nil || s.PublishCloseoutReceipt(receipt) != nil {\n799:\t\tstate, _ := s.GetCloseoutState(ref)\n800:\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n837:func TestCloseoutReviewPolicyRoundFour(t *testing.T) {\n844:\t\td, err := s.CurrentCloseoutDecision(\"milestone:program/two\")\n860:\t\tsetCloseoutPolicy(t, root, \"always\", \"always\")\n862:\t\tif err != nil || eval.CloseoutReview != nil || !eval.Approved {\n865:\t\tif state, err := s.GetCloseoutState(ref); err != nil || state.CloseRequired {\n883:func TestCloseoutReviewPolicyRoundFive(t *testing.T) {\n887:\t\tsetCloseoutPolicy(t, root, \"always\", \"always\")\n904:\t\tstate, err := s.GetCloseoutState(ref)\n908:\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n909:\t\tif err != nil || s.PublishCloseoutReceipt(receipt) != nil {\n961:\t\tstate, err := s.GetCloseoutState(\"milestone:program/two\")\n968:\t\tgateless, err := s.GetCloseoutState(\"milestone:program/three\")\n994:\t\t\t\td, err := s.EvaluateCloseoutReview(\"roadmap:pair\")\n1003:func TestCloseoutReviewPolicyRoundSix(t *testing.T) {\n1008:\t\tstate, err := s.GetCloseoutState(\"milestone:program/one\")\n1030:\t\tstate, err := s.GetCloseoutState(ref)\n1034:\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n1035:\t\tif err != nil || s.PublishCloseoutReceipt(receipt) != nil {\n1061:\t\t// Historical by its own recorded approval, not by the legacy\n1069:\t\tif state, err := s.GetCloseoutState(\"roadmap:program\"); err != nil || !state.Terminal {\n1072:\t\tsetCloseoutPolicy(t, root, \"never\", \"never\")\n1073:\t\tif !s.closeoutScopeHistorical(ScopeRef{Kind: \"roadmap\", Slug: \"program\"}) {\n1076:\t\tif owing, err := s.CloseoutReviewsOwed(); err != nil || len(owing) != 0 {\n1081:\t\tif state, err := s.GetCloseoutState(\"milestone:program/core\"); err == nil && state.Terminal {\n1084:\t\towing, err := s.CloseoutReviewsOwed()\n1104:\t\tstate, err := s.GetCloseoutState(\"milestone:moves/m\")\n1111:\t\ttarget, external, unresolved := s.CloseoutMemberTarget(\"moved\")\n1123:\tstate, err := s.GetCloseoutState(ref)\n1127:\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n1128:\tif err != nil || s.PublishCloseoutReceipt(receipt) != nil {\n1133:func TestCloseoutReviewPolicyRoundSeven(t *testing.T) {\n1169:\t\towing, err := s.CloseoutReviewsOwed()\n1210:\t\tdecision, err := s.CurrentCloseoutDecision(roadmapRef)\n1214:\t\tstate, _ := s.GetCloseoutState(roadmapRef)\n1215:\t\treceipt, err := s.NewCloseoutReceipt(roadmapRef, decision, state.Review, state.ScopeDigest, reviewFixtureNow.Add(2*time.Hour))\n1216:\t\tif err != nil || s.PublishCloseoutReceipt(receipt) != nil {\n1228:\t\tif state, err := s.GetCloseoutState(\"milestone:program/core\"); err == nil && state.Terminal {\n1237:func TestCloseoutReviewPolicyRoundEight(t *testing.T) {\n1283:\t\tdecision, err := s.CurrentCloseoutDecision(roadmap)\n1287:\t\tcloseout, _ := s.GetCloseoutState(roadmap)\n1288:\t\treceipt, err := s.NewCloseoutReceipt(roadmap, decision, closeout.Review, closeout.ScopeDigest, reviewFixtureNow.Add(2*time.Hour))\n1289:\t\tif err != nil || s.PublishCloseoutReceipt(receipt) != nil {\n1298:func TestCloseoutReviewPolicyRoundNine(t *testing.T) {\n1307:\t\tstate, err := s.GetCloseoutState(ref)\n1308:\t\tif err != nil || state.Review.CloseoutReview == nil {\n1311:\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n1312:\t\tif err != nil || s.PublishCloseoutReceipt(receipt) != nil {\n1361:func TestCloseoutReviewPolicyRoundTen(t *testing.T) {\n1455:func TestCloseoutReviewPolicyRoundTwelve(t *testing.T) {\n1473:\t\t\t\td, err := s.EvaluateCloseoutReview(\"roadmap:pair\")\n1514:\t\tstate, err := s.GetCloseoutState(ref)\n1515:\t\tif err != nil || state.Review.CloseoutReview == nil {\n1518:\t\treceipt, err := s.NewCloseoutReceipt(ref, *state.Review.CloseoutReview, state.Review, state.ScopeDigest, reviewFixtureNow.Add(time.Hour))\n1519:\t\tif err != nil || s.PublishCloseoutReceipt(receipt) != nil {\n1527:\t\t\tstate, _ := s.getCloseoutState(ref, true)\n1532:\t\tif child, err := s.getCloseoutState(\"spec:backend\", false); err != nil || child.Terminal {\n1541:func TestCloseoutReviewPolicyRoundThirteen(t *testing.T) {\n1549:\t\tif bundle.Payload.Plan.CloseoutReview == nil {\n1554:\t\tif s.closeoutScopeHistorical(ScopeRef{Kind: \"roadmap\", Slug: \"program\"}) {\n1562:\t\tif s.closeoutScopeHistorical(ScopeRef{Kind: \"roadmap\", Slug: \"program\"}) {\n1585:\t\t\t\"spaced key\":           \"adrs : [adr:decision.md]\\n\",\n1586:\t\t\t\"spaced duplicate\":     \"adrs: []\\nadrs : [adr:decision.md]\\n\",\n","exit_code":0,"status":"completed"}}
