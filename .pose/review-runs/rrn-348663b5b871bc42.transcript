emodel.GitEmptyTree(trailerCommits[0]), posemodel.GitEmptyTree(trailerCommits[0]), nil\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\treturn posemodel.ChangeSet{}, err\n\t\t}\n","exit_code":0,"status":"completed"}}
