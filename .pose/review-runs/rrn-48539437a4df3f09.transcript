lePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure, CloseoutReview: plan.CloseoutReview, AcceptedLimits: append([]ReviewAcceptedLimit(nil), plan.AcceptedLimits...)}\n \n \tscopeProjection, excluded, err := s.reviewBundleScopeProjection(scope)\n \tif err != nil {\n \t\treturn ReviewBundle{}, err\n \t}\n@@ -1967,11 +1972,14 @@ func reviewBundlePlanDigest(plan ReviewPlan) (string, error) {\n \t\tSelectedProfiles          []ReviewPlanProfile   `json:\"selected_profiles\"`\n \t\tCriteria                  []ReviewPlanCriterion `json:\"criteria\"`\n \t\tTools                     []ReviewPlanTool      `json:\"tools\"`\n \t\tLimitations               []string              `json:\"limitations,omitempty\"`\n \t\tDelegatedRunProofRequired bool                  `json:\"delegated_run_proof_required,omitempty\"`\n-\t}{plan.SchemaVersion, plan.PolicySchemaVersion, plan.BaseProfile, plan.Independence, append([]ReviewPlanComponent{}, plan.Components...), append([]ReviewPlanProfile{}, plan.SelectedProfiles...), append([]ReviewPlanCriterion{}, plan.Criteria...), append([]ReviewPlanTool{}, plan.Tools...), plan.Limitations, plan.DelegatedRunProofRequired}\n+\t\t// The sealed limits enter the bundle's plan digest too; omitted when\n+\t\t// none, so every other bundle keeps its digest (review round 6, N1).\n+\t\tAcceptedLimits []ReviewAcceptedLimit `json:\"accepted_limits,omitempty\"`\n+\t}{plan.SchemaVersion, plan.PolicySchemaVersion, plan.BaseProfile, plan.Independence, append([]ReviewPlanComponent{}, plan.Components...), append([]ReviewPlanProfile{}, plan.SelectedProfiles...), append([]ReviewPlanCriterion{}, plan.Criteria...), append([]ReviewPlanTool{}, plan.Tools...), plan.Limitations, plan.DelegatedRunProofRequired, plan.AcceptedLimits}\n \treturn digestJSON(contract)\n }\n \n func normalizeReviewBundlePayload(payload *ReviewBundlePayload) {\n \tsort.Slice(payload.Scope.Sections, func(i, j int) bool { return payload.Scope.Sections[i].Path < payload.Scope.Sections[j].Path })\n@@ -2132,10 +2140,13 @@ func (s Store) sealReviewBundle(ref string, identity *ReviewBundleImplementation\n \t\t}\n \t\treplaced := *identity\n \t\treplaced.Replaces = governing.BundleID\n \t\tidentity = &replaced\n \t}\n+\tif blockers := s.sealReadinessBlockers(bundle); len(blockers) > 0 {\n+\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", strings.Join(blockers, \"; \"))\n+\t}\n \t// A bundle already sealed reads as it was; a new seal holds a validation result,\n \t// whatever the lifecycle of the scope says.\n \tif !holdsValidationResult(bundle.Payload.Evidence) {\n \t\tscope, err := ParseScopeRef(bundle.Payload.Scope.Ref)\n \t\tif err != nil {\n@@ -3889,10 +3900,19 @@ func (s Store) validateBundleAttestationWith(bundle ReviewBundle, att ReviewAtte\n \t\t\t\t\tblockers = append(blockers, \"review policy requires human approval\")\n \t\t\t\t}\n \t\t\t}\n \t\t}\n \t}\n+\treturn append(blockers, s.attestationContentBlockers(bundle, att, skipEvidenceSupport)...)\n+}\n+\n+// attestationContentBlockers judges what an attestation says about its bundle,\n+// apart from who signed it: criteria, mappings, findings, evidence and tools.\n+// It is the part a reviewer's draft can be checked against before the run\n+// ends (spec pose-review-readiness-before-seal R3).\n+func (s Store) attestationContentBlockers(bundle ReviewBundle, att ReviewAttestation, skipEvidenceSupport bool) []string {\n+\tblockers := []string{}\n \trequired := map[string]ReviewPlanCriterion{}\n \tfor _, criterion := range bundle.Payload.Plan.Criteria {\n \t\tif criterion.Required {\n \t\t\trequired[criterion.ID] = criterion\n \t\t}\n@@ -4057,10 +4077,19 @@ func reviewFindingDecisionBlockers(bundle ReviewBundle, att ReviewAttestation) [\n \t\t\t// Leaving a finding unresolved accepts its risk regardless of the\n \t\t\t// disposition's spelling. Use the policy frozen into this bundle.\n \t\t\tif !allowedRisk[finding.Severity] || finding.Owner == \"\" || finding.Rationale == \"\" || finding.ReviewBy == \"\" {\n \t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has unapproved or incomplete accepted risk\")\n \t\t\t}\n+\t\tcase \"within-limit\":\n+\t\t\t// Inside a limit the spec declared and the bundle sealed, whatever\n+\t\t\t// its severity; a limit the bundle did not seal accepts nothing\n+\t\t\t// (spec pose-review-declared-threat-model R3).\n+\t\t\tif !sealedAcceptedLimit(bundle, finding.Limit) {\n+\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" names accepted limit \"+firstNonempty(finding.Limit, \"(none)\")+\", which this bundle did not seal\")\n+\t\t\t} else if strings.TrimSpace(finding.Rationale) == \"\" {\n+\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is within limit \"+finding.Limit+\" without saying why\")\n+\t\t\t}\n \t\tcase \"open\", \"changes-requested\":\n \t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is \"+finding.Disposition)\n \t\tdefault:\n \t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has invalid disposition\")\n \t\t}\ndiff --git a/pose-mcp/internal/pose/review_closeout.go b/pose-mcp/internal/pose/review_closeout.go\nindex c298ec5e..3e3c028e 100644\n--- a/pose-mcp/internal/pose/review_closeout.go\n+++ b/pose-mcp/internal/pose/review_closeout.go\n@@ -380,10 +380,13 @@ type ReviewFinding struct {\n \tAction      string `json:\"action,omitempty\"`\n \tDisposition string `json:\"disposition\"`\n \tOwner       string `json:\"owner,omitempty\"`\n \tRationale   string `json:\"rationale,omitempty\"`\n \tReviewBy    string `json:\"review_by,omitempty\"`\n+\t// Limit is the declared accepted limit a finding disposed within-limit\n+\t// falls inside (spec pose-review-declared-threat-model R3).\n+\tLimit string `json:\"limit,omitempty\"`\n }\n \n type ReviewToolDisposition struct {\n \tID          string `json:\"id\"`\n \tComponent   string `json:\"component,omitempty\"`\ndiff --git a/pose-mcp/internal/pose/review_conclusions.go b/pose-mcp/internal/pose/review_conclusions.go\nindex b660055d..056373dc 100644\n--- a/pose-mcp/internal/pose/review_conclusions.go\n+++ b/pose-mcp/internal/pose/review_conclusions.go\n@@ -120,19 +120,34 @@ func (s Store) reviewConclusionChecks(run ReviewRun) ([]string, *ReviewBundle, *\n \t}\n \tbundle, err := s.LoadReviewBundle(run.BundleID)\n \tif err != nil {\n \t\treturn append(reasons, \"the run's bundle cannot be read: \"+err.Error()), nil, draft\n \t}\n+\t// The run's own record must stand whatever it concludes. Whether its\n+\t// bundle is still the current subject matters only to an approval: a\n+\t// verdict that requests changes or rejects is a fact about the bundle it\n+\t// reviewed, and the working tree the implementer is already fixing does\n+\t// not change it (spec pose-review-conclude-ignores-unrelated-local-edits R1).\n+\tif why := s.ReviewRunRecordStands(run); why != \"\" {\n+\t\treasons = append(reasons, \"the run no longer governs: \"+why)\n+\t}\n+\treasons = append(reasons, s.verdictCoverageReasons(run, bundle, draft)...)\n+\treturn reasons, &bundle, draft\n+}\n+\n+// reviewConclusionCurrency is why an approval of run's bundle would no longer\n+// approve the current subject.\n+func (s Store) reviewConclusionCurrency(run ReviewRun, bundle ReviewBundle) []string {\n+\tvar reasons []string\n \tcurrent, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref)\n \tif err != nil || current == nil || current.BundleID != bundle.BundleID {\n \t\treasons = append(reasons, \"the run's bundle no longer governs \"+bundle.Payload.Scope.Ref+\": the subject, the plan or the policy changed since it was sealed\")\n \t}\n \tif why := s.ReviewRunStillGoverns(run); why != \"\" {\n \t\treasons = append(reasons, \"the run no longer governs: \"+why)\n \t}\n-\treasons = append(reasons, s.verdictCoverageReasons(run, bundle, draft)...)\n-\treturn reasons, &bundle, draft\n+\treturn reasons\n }\n \n // reviewAttestationFromDraft builds the attestation a draft concludes, for\n // the run that wrote it. Evidence is the run itself and each evidence the\n // draft names; a criterion or a tool the draft does not answer is left for\n@@ -161,10 +176,16 @@ func reviewAttestationFromDraft(run ReviewRun, bundle ReviewBundle, draft Review\n \t\t// an approval. The engine never writes the action for the reviewer\n \t\t// (review round 1, B3).\n \t\tif f.Disposition == \"follow-up\" && f.Action != \"\" && f.Owner != \"\" && f.ReviewBy != \"\" {\n \t\t\tfinding.Disposition, finding.Owner, finding.ReviewBy, finding.Rationale = \"accepted-risk\", f.Owner, f.ReviewBy, f.Summary\n \t\t}\n+\t\t// A follow-up the reviewer classified inside a declared accepted\n+\t\t// limit is recorded as such, naming the limit (spec\n+\t\t// pose-review-declared-threat-model R3).\n+\t\tif f.Disposition == \"follow-up\" && f.Limit != \"\" {\n+\t\t\tfinding.Disposition, finding.Limit, finding.Rationale, finding.Owner, finding.ReviewBy = \"within-limit\", f.Limit, f.Summary, f.Owner, f.ReviewBy\n+\t\t}\n \t\tatt.Findings = append(att.Findings, finding)\n \t}\n \tfor ref := range evidence {\n \t\tatt.EvidenceRefs = append(att.EvidenceRefs, ref)\n \t}\n@@ -531,10 +552,23 @@ func (s Store) concludeReviewRun(id, issuer string, apply bool, now time.Time, t\n \tresult.BundleID, result.Scope, result.Kind = run.BundleID, run.Scope, run.Kind\n \treasons, bundle, draft := s.reviewConclusionChecks(run)\n \tif draft != nil {\n \t\tresult.Decision = draft.Decision\n \t}\n+\tif bundle != nil && draft != nil && reviewDecisionApproves(draft.Decision) {\n+\t\tif current := s.reviewConclusionCurrency(run, *bundle); len(current) > 0 {\n+\t\t\tif len(reasons) == 0 {\n+\t\t\t\t// Refused only because the subject the working tree holds is\n+\t\t\t\t// not the bundle's: nothing about the run is wrong, so the\n+\t\t\t\t// refusal is not recorded and the run concludes once the tree\n+\t\t\t\t// matches its bundle again (R2).\n+\t\t\t\tresult.Reasons = append(current, \"not recorded: conclude this run again once the working tree holds its bundle's subject (commit or set aside the local edits)\")\n+\t\t\t\treturn result, nil\n+\t\t\t}\n+\t\t\treasons = append(reasons, current...)\n+\t\t}\n+\t}\n \tvar key IssuerKey\n \tif len(reasons) == 0 {\n \t\tkey, err = LoadIssuerKey(s.Root, issuer)\n \t\tif err != nil {\n \t\t\treasons = append(reasons, \"the conclusions issuer cannot sign: \"+strings.TrimPrefix(err.Error(), \"pose: \"))\ndiff --git a/pose-mcp/internal/pose/review_plan.go b/pose-mcp/internal/pose/review_plan.go\nindex 7182af75..d038610a 100644\n--- a/pose-mcp/internal/pose/review_plan.go\n+++ b/pose-mcp/internal/pose/review_plan.go\n@@ -124,10 +124,14 @@ type ReviewPlan struct {\n \t// Structure is the observed structural context, resolved only when an\n \t// adopted profile selects on it. Unlike the summaries above it is an\n \t// obligation input, so it enters the plan digest: see review_structure.go.\n \tStructure   *ReviewPlanStructure `json:\"structure,omitempty\"`\n \tLimitations []string             `json:\"limitations,omitempty\"`\n+\t// AcceptedLimits are the residual limits the scope's spec declares; they\n+\t// are sealed so the brief lists them and the conclusion classifies\n+\t// findings against them (spec pose-review-declared-threat-model).\n+\tAcceptedLimits []ReviewAcceptedLimit `json:\"accepted_limits,omitempty\"`\n \t// A change disabling an adopted baseline must still prove its review.\n \tDelegatedRunProofRequired bool     `json:\"delegated_run_proof_required,omitempty\"`\n \tWarnings                  []string `json:\"warnings,omitempty\"`\n \tBlockers                  []string `json:\"blockers,omitempty\"`\n \tExplain                   []string `json:\"explain\"`\n@@ -395,10 +399,11 @@ func (s Store) ReviewPlan(ref string) (ReviewPlan, error) {\n \t\tif reviewBandRank[band.Band] > reviewBandRank[plan.Band] {\n \t\t\tplan.Band = band.Band\n \t\t}\n \t}\n \tplan.Projection = projectDeclaredReviewObligations(plan, scope, base, floor, overlays, context)\n+\tplan.AcceptedLimits = s.acceptedLimitsOf(scope)\n \tplan.PlanDigest, err = digestReviewPlan(plan)\n \tif err != nil {\n \t\treturn ReviewPlan{}, err\n \t}\n \t// Warnings and Explain enter the digest; the decision does not, so it is\n@@ -1383,21 +1388,21 @@ func reviewToolArgs(id string, scope ScopeRef, component string) []string {\n \t\tif path == \"\" {\n \t\t\tpath = \".\"\n \t\t}\n \t\treturn []string{\"pose\", \"suggest\", \"review\", \"--path\", path}\n \tcase \"assess-discover\":\n-\t\targs := []string{\"pose\", \"assess\", \"discover\"}\n+\t\targs := []string{\"pose\", \"assess\", \"discover\", \"--no-persist\"}\n \t\tif component != \"\" {\n \t\t\targs = append(args, \"--component\", component)\n \t\t}\n \t\treturn args\n \tcase \"assess-design\":\n \t\treturn []string{\"pose\", \"assess\", \"design\", \"--spec\", scope.Slug, \"--json\"}\n \tcase \"assess-integrate\":\n-\t\treturn []string{\"pose\", \"assess\", \"integrate\"}\n+\t\treturn []string{\"pose\", \"assess\", \"integrate\", \"--no-persist\"}\n \tcase \"assess-tech-debt\":\n-\t\treturn []string{\"pose\", \"assess\", \"tech-debt\"}\n+\t\treturn []string{\"pose\", \"assess\", \"tech-debt\", \"--no-persist\"}\n \tcase \"artifact-check\":\n \t\treturn []string{\"pose\", \"artifact-check\", \"--spec\", scope.Slug, \"--strict\"}\n \tcase \"validate\":\n \t\targs := []string{\"pose\", \"validate\", \"--strict\"}\n \t\tif component != \"\" {\n@@ -1447,11 +1452,12 @@ func digestReviewPlan(plan ReviewPlan) (string, error) {\n \t\tWarnings, Blockers                            []string\n \t\tExplain                                       []string\n \t\tStructure                                     *[]ReviewStructuralFact `json:\",omitempty\"`\n \t\tLimitations                                   []string                `json:\",omitempty\"`\n \t\tDelegatedRunProofRequired                     bool                    `json:\",omitempty\"`\n-\t}{plan.SchemaVersion, plan.Scope, plan.ScopeDigest, plan.BaseProfile, plan.Independence, plan.PolicySchemaVersion, components, plan.SelectedProfiles, plan.Criteria, plan.Tools, plan.Warnings, plan.Blockers, plan.Explain, structure, plan.Limitations, plan.DelegatedRunProofRequired})\n+\t\tAcceptedLimits                                []ReviewAcceptedLimit   `json:\",omitempty\"`\n+\t}{plan.SchemaVersion, plan.Scope, plan.ScopeDigest, plan.BaseProfile, plan.Independence, plan.PolicySchemaVersion, components, plan.SelectedProfiles, plan.Criteria, plan.Tools, plan.Warnings, plan.Blockers, plan.Explain, structure, plan.Limitations, plan.DelegatedRunProofRequired, plan.AcceptedLimits})\n }\n \n func validateReviewPath(files Files, root, value string) error {\n \tclean, err := validateArtifactPathSyntax(value)\n \tif err != nil {\ndiff --git a/pose-mcp/internal/pose/review_rounds.go b/pose-mcp/internal/pose/review_rounds.go\nindex 26cae729..3e3d64db 100644\n--- a/pose-mcp/internal/pose/review_rounds.go\n+++ b/pose-mcp/internal/pose/review_rounds.go\n@@ -55,10 +55,13 @@ type ReviewDraftFinding struct {\n \t// the attestation the engine records (spec\n \t// pose-delegated-review-conclusions R1).\n \tAction   string `json:\"action,omitempty\"`\n \tOwner    string `json:\"owner,omitempty\"`\n \tReviewBy string `json:\"review_by,omitempty\"`\n+\t// Limit names the declared accepted limit the finding falls inside\n+\t// (spec pose-review-declared-threat-model R2).\n+\tLimit string `json:\"limit,omitempty\"`\n }\n \n // ReviewDraftCriterion answers one criterion of the plan, as the reviewer of\n // a recorded attestation does (spec pose-delegated-review-conclusions R1).\n type ReviewDraftCriterion struct {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc \"rg --files .pose/specs | rg 'declared-threat-model' | xargs -r sed -n '1,240p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/usr/bin/bash -lc \"rg --files .pose/specs | rg 'declared-threat-model' | xargs -r sed -n '1,240p'\"","aggregated_output":"---\nslug: pose-review-declared-threat-model\nstatus: in-progress\ncreated_at: 2026-11-23\ncompleted_at:\nsupersedes:\ndepends_on: \nremediates:\npriority: 4\ncomponents: pose-mcp\ntask_type: feature\nsurface: standard\ndelivers: capability:review-declared-threat-model\n---\n\n# Spec: pose-review-declared-threat-model\n\n## 1. Intent\n\n### Goal\nLet a spec declare the accepted residual limits of a guarantee it makes, and let the review brief treat findings inside those limits as follow-ups to classify, not blockers to chase.\n\n### Business value\nEach of the 23 rounds of `pose-validate-carries-unchanged-checks` found a more remote adversarial variant: concurrent HEAD movement, case folding, Unicode normalization, symlinks inside submodules. Every one was real, but no round could converge, because the spec had no place to say which environment the guarantee assumes. A cap on rounds would approve something unreviewed; a declared threat model converges by explicit classification.\n\n### Constraints\nA declared limit never hides a defect inside the declared scope. The reviewer may dispute a limit; the dispute is a finding with its own classification. Declared limits are visible in the closeout and the attestation.\n\n### Non-goals\nLimiting the number of review rounds.\n\n## 2. Requirements\n\n### Functional\n- R1: A spec shall be able to declare `### Accepted limits` entries with stable ids (`L<N>`), each naming the assumption and why it is accepted.\n- R2: The review brief shall list the declared limits and instruct the reviewer to classify a finding that falls inside one as a follow-up naming the limit, or to dispute the limit explicitly.\n- R3: The conclusion and the attestation shall record which findings were classified under which limit.\n- R4: `lint-spec --ready-check` shall require accepted limits to be justified and the ADR, when present, to reference them.\n\n### Non-functional\nExisting behaviour outside the stated requirements is unchanged.\n\n### Security\nNo new input crosses a trust boundary without the existing confinement.\n\n### Compatibility\nRecords and indexes written by earlier engines keep their meaning.\n\n## 3. Technical Plan\n\n### Affected areas\n`pose-mcp` (CLI and engine), the manual and its embedded copy.\n\n### Artifacts\n- created: .pose/specs/2026-11-23-pose-review-declared-threat-model.md\n- created: pose-mcp/internal/pose/accepted_limits.go\n- created: pose-mcp/internal/pose/accepted_limits_test.go\n- modified: pose-mcp/internal/pose/review_plan.go\n- modified: pose-mcp/internal/pose/review_bundle.go\n- modified: pose-mcp/internal/pose/review_rounds.go\n- modified: pose-mcp/internal/pose/review_closeout.go\n- modified: pose-mcp/internal/pose/review_conclusions.go\n- modified: pose-mcp/internal/pose/review_brief.go\n- modified: pose-mcp/internal/pose/review_brief_test.go\n- modified: pose-mcp/internal/pose/review_brief_versions_test.go\n- modified: pose-mcp/internal/pose/review_brief_conclusion_rules_test.go\n- modified: pose-mcp/internal/pose/testdata/review_brief_template_digests.json\n- modified: pose-mcp/internal/cli/lintspec.go\n- created: pose-mcp/internal/cli/accepted_limits_lint_test.go\n- modified: POSE.md\n- modified: locales/pt-BR/POSE.md\n- modified: pose-mcp/internal/scaffold/dist/POSE.md\n- modified: pose-mcp/internal/scaffold/dist/locales/pt-BR/POSE.md\n\n\n### Delivery targets\n\n- capability:review-declared-threat-model module:pose-mcp profile:composed-capability entrypoint:pose-mcp/internal/cli/lintspec.go\n\n\n### Accepted limits\n- L1: The limits are written by the implementer, so a limit can be broader than it should be. Accepted because the brief presents them as data to verify and a disputed limit is a blocking finding of its own.\n- L2: A spec edited after sealing changes its limits only through a new bundle. Accepted because the limits enter the plan digest, so an edit stales the review as any other change does.\n\n### API/contract changes\nA spec section `### Accepted limits` with `- L<N>: <assumption>. Accepted because <reason>.` entries. The review plan and the bundle seal them as `accepted_limits` (omitted when none, so every other plan and bundle keeps its digest). A draft finding may carry `limit`; the attestation records it with disposition `within-limit`. Brief template `review-brief/11`. `lint-spec --ready-check` checks the section.\n\n\n### Data/storage changes\n`accepted_limits` in review plans and bundles and `limit` in draft and attestation findings, all omitted when empty.\n\n\n### Technical risks\nA limit could be used to wave a real defect through. It is the spec's own declaration, sealed into the plan digest and visible in the brief and the attestation; the reviewer may dispute it with a finding of its own, which then blocks as any finding does.\n\n\n## 4. Tasks\n\n### Planning\n- [ ] Confirm the requirements against the current engine before starting.\n\n### Implementation\n- [ ] Implement each requirement with a test that fails before it.\n\n### Validation\n- [ ] `pose validate --carry` and `pose check --strict`.\n\n## 5. Decisions\n\n### Decision D1\n- Basis: R1, R2, R3\nA finding inside a declared limit is neither an open finding nor an accepted risk: it gets its own disposition, `within-limit`, which does not block an approval whatever its severity, requires a sealed limit and a reason, and records the limit's id. Accepted risks keep their severity bound; a limit is the spec's statement of scope, decided before the review.\n\n### Decision D2\n- Basis: R1, R4\nThe limits are sealed in the plan and the bundle, and in the plan digest, so the brief and the conclusion read them from what was reviewed, never from the current spec; both fields are omitted when empty so no earlier plan or bundle changes digest.\n\n## 6. Validation\n\n### Strategy\nEach requirement gets a regression test shown failing before its code.\n\n### Deterministic checks\n\n#### Test\n- Command: `go test ./...` (in `pose-mcp`), then `pose validate --carry`.\n\n### Execution log\n- 2026-11-25: implemented R1–R4: `ParseAcceptedLimits`, the plan and bundle `accepted_limits`, the draft `limit` and the `within-limit` disposition, `review-brief/11` and the ready check. Each has a test that fails with it mutated out; the first digest test survived because the spec edit changed the scope digest too, and now compares the plan's digest with and without the limits.\n- 2026-11-25: review round 1 (rrn-d1680df442b23d12) requested changes. N1: in a scope with several specs (a milestone or a roadmap) each limit id is qualified by its spec as `<spec>#L<N>`, with the spec recorded, so a finding names exactly one sealed limit. N2: the reason must follow `Accepted because`, not only the marker. N3: an ADR names a limit only by the id as a word, so L10 does not name L1. Each fix has a test that fails with it mutated out.\n- 2026-11-25: review round 2 (rrn-256db7e6eea5a6e2) found that punctuation after the marker passed as a reason and a one-letter first word failed. The reason must now hold at least two words with letters (`hasAcceptedLimitReason`), with a test that fails with the rule mutated out.\n- 2026-11-25: review round 3 (rrn-0af0d413761142d8) found that the marker matched inside a sentence, so 'Not accepted because ...' passed. The marker must now open a sentence (start of the text or after `.`, `;`, `:`, `!` or `?`), as the format `<assumption>. Accepted because <reason>.` states; the test fails with the boundary mutated out.\n- 2026-11-25: review round 4 (rrn-721e2a4c9bd37e2e) found that an entry with no assumption, or with an empty reason followed by other prose, passed. The entry is now read structurally: an assumption of at least two words, the marker opening a sentence, and a reason of at least two words within that same sentence. Each rule has a test case that fails with it mutated out.\n- 2026-11-25: review round 5 (rrn-9f6867b3c3e42377): N1, a whitespace-only reason of a `within-limit` finding is refused; N2, the ready check fails closed on an ADR directory or file it cannot read, keeping the absent-directory case. Both have tests that fail with them mutated out.\n- 2026-11-25: review round 6 (rrn-a5b61489ac04873d) found the bundle's plan digest did not cover the sealed limits; it now does, omitted when empty so every other bundle keeps its digest. `TestTheBundlePlanDigestCoversTheAcceptedLimits` checks both and fails with the field mutated out.\n- 2026-11-25: review round 7 (rrn-1236e104ff346a2d): N2, the ready check reads an ADR only as a regular file, without following a link and within 1 MiB, so a link to an endless source fails instead of hanging; the test fails with the bounded read mutated out. N1 (low) was classified by the reviewer within L1: the check is a format gate, and the substance of a limit is judged in review.\n\n\n### Results summary\nThe full `pose-mcp` suite passes; the canonical result is refreshed with `pose validate --carry`.\n\n\n### Requirement trace\n- R1 [satisfied] test:TestAcceptedLimitsAreParsed, test:TestTheReviewPlanSealsTheAcceptedLimits, test:TestTheBundlePlanDigestCoversTheAcceptedLimits, test:TestLimitsAcrossSpecsAreQualified, test:TestAnAcceptedLimitNeedsWordsAsItsReason\n- R2 [satisfied] test:TestTheCurrentBriefListsTheAcceptedLimits\n- R3 [satisfied] test:TestAFindingWithinASealedLimitDoesNotBlockApproval\n- R4 [satisfied] test:TestReadyCheckJudgesAcceptedLimits\n\n\n### Known gaps\nNone.\n\n\n## 7. Final Report\n\n### Delivered scope\nSpecs declare accepted limits; the review plan and bundle seal them; `review-brief/11` lists them and tells the reviewer to classify a finding inside one with `limit`; the attestation records it `within-limit`, which does not block an approval; `lint-spec --ready-check` requires each limit to say why it is accepted and an ADR citing the spec to name it.\n\n\n### Files and modules changed\n`pose-mcp` (plan, bundle, conclusion, brief, lint), the manual in both locales and its embedded copies.\n\n\n### Validation executed\n`go test ./...` in `pose-mcp`; `pose check --strict`; `pose validate --carry --json-out .pose/results/delivery-validation.json`.\n\n\n### Residual risks\nL1 and L2 above.\n\n\n### Follow-ups\nNone.\n\n\n","exit_code":0,"status":"completed"}}
