ms, \"accepted limit \"+m[1]+\" does not say why it is accepted ('Accepted because ...')\")\npose-mcp/internal/pose/accepted_limits.go:84:\t\tlimits = append(limits, ReviewAcceptedLimit{ID: m[1], Text: strings.TrimSpace(m[2])})\npose-mcp/internal/pose/accepted_limits.go:90:func (s Store) acceptedLimitsOf(scope ScopeRef) []ReviewAcceptedLimit {\npose-mcp/internal/pose/accepted_limits.go:95:\treturn acceptedLimitsOfSpecs(specs)\npose-mcp/internal/pose/accepted_limits.go:98:// acceptedLimitsOfSpecs collects the limits specs declare, qualifying each id\npose-mcp/internal/pose/accepted_limits.go:100:func acceptedLimitsOfSpecs(specs []Spec) []ReviewAcceptedLimit {\npose-mcp/internal/pose/accepted_limits.go:101:\tvar out []ReviewAcceptedLimit\npose-mcp/internal/pose/accepted_limits.go:103:\t\tlimits, _ := ParseAcceptedLimits(spec.Body)\npose-mcp/internal/pose/accepted_limits.go:116:// sealedAcceptedLimit reports whether the bundle sealed limit id.\npose-mcp/internal/pose/accepted_limits.go:117:func sealedAcceptedLimit(bundle ReviewBundle, id string) bool {\npose-mcp/internal/pose/accepted_limits.go:118:\tfor _, l := range bundle.Payload.Plan.AcceptedLimits {\npose-mcp/internal/pose/review_conclusions.go:185:\t\t\tfinding.Disposition, finding.Limit, finding.Rationale, finding.Owner, finding.ReviewBy = \"within-limit\", f.Limit, f.Summary, f.Owner, f.ReviewBy\npose-mcp/internal/pose/review_closeout.go:385:\t// Limit is the declared accepted limit a finding disposed within-limit\npose-mcp/internal/pose/review_bundle.go:122:\t// AcceptedLimits seals the residual limits the scope's spec declares, so\npose-mcp/internal/pose/review_bundle.go:126:\tAcceptedLimits []ReviewAcceptedLimit `json:\"accepted_limits,omitempty\"`\npose-mcp/internal/pose/review_bundle.go:523:\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure, CloseoutReview: plan.CloseoutReview, AcceptedLimits: append([]ReviewAcceptedLimit(nil), plan.AcceptedLimits...)}\npose-mcp/internal/pose/review_bundle.go:4079:\t\tcase \"within-limit\":\npose-mcp/internal/pose/review_bundle.go:4083:\t\t\tif !sealedAcceptedLimit(bundle, finding.Limit) {\npose-mcp/internal/pose/review_bundle.go:4084:\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" names accepted limit \"+firstNonempty(finding.Limit, \"(none)\")+\", which this bundle did not seal\")\npose-mcp/internal/pose/review_plan.go:129:\t// AcceptedLimits are the residual limits the scope's spec declares; they\npose-mcp/internal/pose/review_plan.go:132:\tAcceptedLimits []ReviewAcceptedLimit `json:\"accepted_limits,omitempty\"`\npose-mcp/internal/pose/review_plan.go:404:\tplan.AcceptedLimits = s.acceptedLimitsOf(scope)\npose-mcp/internal/pose/review_plan.go:1457:\t\tAcceptedLimits                                []ReviewAcceptedLimit   `json:\",omitempty\"`\npose-mcp/internal/pose/review_plan.go:1458:\t}{plan.SchemaVersion, plan.Scope, plan.ScopeDigest, plan.BaseProfile, plan.Independence, plan.PolicySchemaVersion, components, plan.SelectedProfiles, plan.Criteria, plan.Tools, plan.Warnings, plan.Blockers, plan.Explain, structure, plan.Limitations, plan.DelegatedRunProofRequired, plan.AcceptedLimits})\npose-mcp/internal/pose/review_brief.go:30:\tReviewBriefKindReview:       reviewBriefTemplateAcceptedLimits,\npose-mcp/internal/pose/review_brief.go:82:\t// reviewBriefTemplateAcceptedLimits is the current template: /10 plus the\npose-mcp/internal/pose/review_brief.go:83:\t// accepted limits the bundle sealed and how a finding inside one is\npose-mcp/internal/pose/review_brief.go:85:\treviewBriefTemplateAcceptedLimits = \"review-brief/11\"\npose-mcp/internal/pose/review_brief.go:116:\treturn template == reviewBriefTemplateFinishCommands || template == reviewBriefTemplateAcceptedLimits\npose-mcp/internal/pose/review_brief.go:466:\tif template == reviewBriefTemplateAcceptedLimits {\npose-mcp/internal/pose/review_brief.go:469:\t\tif len(plan.AcceptedLimits) == 0 {\npose-mcp/internal/pose/review_brief.go:470:\t\t\tline(\"The scope's spec declares no accepted limit: every finding is judged on its own.\")\npose-mcp/internal/pose/review_brief.go:473:\t\t\tfor _, l := range plan.AcceptedLimits {\n","exit_code":0,"status":"completed"}}
