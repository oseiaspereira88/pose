nt...)\n+\t\t}\n+\t}\n \tvar key IssuerKey\n \tif len(reasons) == 0 {\n \t\tkey, err = LoadIssuerKey(s.Root, issuer)\n \t\tif err != nil {\n \t\t\treasons = append(reasons, \"the conclusions issuer cannot sign: \"+strings.TrimPrefix(err.Error(), \"pose: \"))\n \t\t}\n \t}\n \tif len(reasons) > 0 {\n \t\tresult.Reasons = reasons\n \t\treturn s.publishReviewConclusion(result, apply, takeOver)\n \t}\n \tif !apply {\n \t\tresult.State = ReviewConclusionRecorded\n \t\tresult.Reasons = []string{\"preview: the run passes the conclusion checks; on apply its proof and its attestation are signed by \" + issuer + \" and recorded if the attestation preflight admits them, which a preview does not run\"}\n \t\treturn result, nil\n \t}\n \t// The reservation records that a conclusion started, for a later one to\n \t// recover if this one is interrupted.\n \tpending := result\n \tpending.State, pending.Reasons = ReviewConclusionPending, nil\n \treservation, err := s.writeReviewConclusion(pending, takeOver)\n \tif err != nil {\n \t\treturn result, err\n \t}\n \tfinish := func(final ReviewConclusion) (ReviewConclusion, error) {\n \t\treturn s.publishReviewConclusion(final, true, reservation)\n \t}\n \tproof, err := s.SignReviewRunProof(run.RunID, key, 0, now, true)\n \tif err != nil {\n \t\tresult.Reasons = []string{\"the run's proof cannot be signed: \" + strings.TrimPrefix(err.Error(), \"pose: \")}\n \t\treturn finish(result)\n \t}\n \tassurance, err := s.VerifyReviewRunProof(run.RunID, proof.ProofID)\n \tif err != nil || !assurance.CompleteReview {\n \t\twhy := \"the signed proof does not establish a complete review\"\n \t\tif err != nil {\n \t\t\twhy = \"the signed proof does not verify: \" + strings.TrimPrefix(err.Error(), \"pose: \")\n \t\t}\n \t\tresult.ProofID, result.Reasons = proof.ProofID, []string{why}\n \t\treturn finish(result)\n \t}\n \tif run.Kind != ReviewBriefKindReview {\n \t\t// An adjudication or a smoke verdict is recorded where its origin\n \t\t// reads it, never as an approval, and only from a run that meets the\n \t\t// independence its plan requires (spec\n \t\t// pose-delegated-verdict-destinations; review round 1, B01).\n \t\tif why := verdictIndependenceReason(*bundle, assurance, run.RunID); why != \"\" {\n \t\t\tresult.ProofID, result.Reasons = proof.ProofID, []string{why}\n \t\t\treturn finish(result)\n \t\t}\ndiff --git a/pose-mcp/internal/pose/review_plan.go b/pose-mcp/internal/pose/review_plan.go\nindex 7182af75..d038610a 100644\n--- a/pose-mcp/internal/pose/review_plan.go\n+++ b/pose-mcp/internal/pose/review_plan.go\n@@ -79,100 +79,104 @@ type ReviewPlanTool struct {\n \t// required tool may only be disposed `passed` or `failed` citing a result\n \t// of a class it accepts — so the reviewer's options are to cite another\n \t// component's result, which is false, or to stay blocked forever.\n \t//\n \t// This is the same failure the profile loader already refuses one level up:\n \t// a profile demanding a class no registered check may emit plans a gate\n \t// only a fabricated disposition can pass. Per component, the matrix is what\n \t// says so, and the plan had not been reading it.\n \t//\n \t// Empty means the ordinary case: producers exist, or the matrix does not\n \t// say otherwise and the tool stays required. The engine claims the gap only\n \t// where the repository declared it.\n \tProducerCoverage string   `json:\"producer_coverage,omitempty\"`\n \tArgs             []string `json:\"args\"`\n \tRationale        string   `json:\"rationale\"`\n \tEvidenceClasses  []string `json:\"evidence_classes,omitempty\"`\n \tCriteria         []string `json:\"criteria,omitempty\"`\n \tComponent        string   `json:\"component,omitempty\"`\n \tPreconditions    []string `json:\"preconditions,omitempty\"`\n }\n \n type ReviewPlan struct {\n \tSchemaVersion       int                   `json:\"schema_version\"`\n \tScope               string                `json:\"scope\"`\n \tScopeDigest         string                