se/review_closeout.go:27:\npose-mcp/internal/pose/review_closeout.go:28:// Spec authority transfer is another explicit opt-in contract. Schema 4 is\npose-mcp/internal/pose/review_closeout.go:29:// refused by older engines so they cannot silently operate on transfer state.\npose-mcp/internal/pose/review_closeout.go:30:const SpecAuthorityTransferPolicySchemaVersion = 4\npose-mcp/internal/pose/review_closeout.go:31:\npose-mcp/internal/pose/review_closeout.go:32:// CloseoutReviewPolicySchemaVersion carries milestone_review_required and\npose-mcp/internal/pose/review_closeout.go:33:// roadmap_review_required (spec pose-closeout-review-policy-by-cost-benefit).\npose-mcp/internal/pose/review_closeout.go:34:// Older engines refuse it, so none of them reads an adopted exemption as the\npose-mcp/internal/pose/review_closeout.go:35:// legacy rule. It decouples the schema number from qualified references and\npose-mcp/internal/pose/review_closeout.go:36:// authority transfer: both stay optional under it.\npose-mcp/internal/pose/review_closeout.go:37:const CloseoutReviewPolicySchemaVersion = 5\npose-mcp/internal/pose/review_closeout.go:38:\npose-mcp/internal/pose/review_closeout.go:39:// ScopeRef is the canonical address of a reviewable POSE scope.\npose-mcp/internal/pose/review_closeout.go:40:type ScopeRef struct {\npose-mcp/internal/pose/review_closeout.go:41:\tKind      string `json:\"kind\"`\npose-mcp/internal/pose/review_closeout.go:42:\tSlug      string `json:\"slug,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:43:\tRoadmap   string `json:\"roadmap,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:44:\tMilestone string `json:\"milestone,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:45:}\npose-mcp/internal/pose/review_closeout.go:46:\npose-mcp/internal/pose/review_closeout.go:47:func (r ScopeRef) String() string {\npose-mcp/internal/pose/review_closeout.go:48:\tif r.Kind == \"milestone\" {\npose-mcp/internal/pose/review_closeout.go:49:\t\treturn \"milestone:\" + r.Roadmap + \"/\" + r.Milestone\npose-mcp/internal/pose/review_closeout.go:50:\t}\npose-mcp/internal/pose/review_closeout.go:51:\treturn r.Kind + \":\" + r.Slug\npose-mcp/internal/pose/review_closeout.go:52:}\npose-mcp/internal/pose/review_closeout.go:53:\npose-mcp/internal/pose/review_closeout.go:54:func ParseScopeRef(value string) (ScopeRef, error) {\npose-mcp/internal/pose/review_closeout.go:55:\tparts := strings.SplitN(strings.TrimSpace(value), \":\", 2)\npose-mcp/internal/pose/review_closeout.go:56:\tif len(parts) != 2 {\npose-mcp/internal/pose/review_closeout.go:57:\t\treturn ScopeRef{}, fmt.Errorf(\"pose: invalid scope ref %q\", value)\npose-mcp/internal/pose/review_closeout.go:58:\t}\npose-mcp/internal/pose/review_closeout.go:59:\tif !reviewScopeKindSupported(parts[0]) {\npose-mcp/internal/pose/review_closeout.go:60:\t\treturn ScopeRef{}, fmt.Errorf(\"pose: unsupported scope kind %q\", parts[0])\npose-mcp/internal/pose/review_closeout.go:61:\t}\npose-mcp/internal/pose/review_closeout.go:62:\tswitch parts[0] {\npose-mcp/internal/pose/review_closeout.go:63:\tcase \"spec\", \"roadmap\":\npose-mcp/internal/pose/review_closeout.go:64:\t\tif err := ValidateSlug(parts[1]); err != nil {\npose-mcp/internal/pose/review_closeout.go:65:\t\t\treturn ScopeRef{}, fmt.Errorf(\"pose: invalid %s scope: %w\", parts[0], err)\npose-mcp/internal/pose/review_closeout.go:66:\t\t}\npose-mcp/internal/pose/review_closeout.go:67:\t\treturn ScopeRef{Kind: parts[0], Slug: parts[1]}, nil\npose-mcp/internal/pose/review_closeout.go:68:\tcase \"milestone\":\npose-mcp/internal/pose/review_closeout.go:69:\t\tpair := strings.Split(parts[1], \"/\")\npose-mcp/internal/pose/review_closeout.go:70:\t\tif len(pair) != 2 || ValidateSlug(pair[0]) != nil || ValidateSlug(pair[1]) != nil {\npose-mcp/internal/pose/review_closeout.go:71:\t\t\treturn ScopeRef{}, fmt.Errorf(\"pose: invalid milestone scope %q\", value)\npose-mcp/internal/pose/review_closeout.go:72:\t\t}\npose-mcp/internal/pose/review_closeout.go:73:\t\treturn ScopeRef{Kind: \"milestone\", Roadmap: pair[0], Milestone: pair[1]}, nil\npose-mcp/internal/pose/review_closeout.go:74:\tdefault:\npose-mcp/internal/pose/review_closeout.go:75:\t\treturn ScopeRef{}, fmt.Errorf(\"pose: unsupported scope kind %q\", parts[0])\npose-mcp/internal/pose/review_closeout.go:76:\t}\npose-mcp/internal/pose/review_closeout.go:77:}\npose-mcp/internal/pose/review_closeout.go:78:\npose-mcp/internal/pose/review_closeout.go:79:type ReviewCriterionProfile struct {\npose-mcp/internal/pose/review_closeout.go:80:\tID          string `json:\"id\"`\npose-mcp/internal/pose/review_closeout.go:81:\tDescription string `json:\"description\"`\npose-mcp/internal/pose/review_closeout.go:82:\t// Kind is `mechanical` or `judgment`, and says who may answer this\npose-mcp/internal/pose/review_closeout.go:83:\t// criterion. A mechanical one is answered by a registered producer: it\npose-mcp/internal/pose/review_closeout.go:84:\t// names evidence classes, a check emits them, and citing a sealed result\npose-mcp/internal/pose/review_closeout.go:85:\t// of that class is a complete answer. A judgment one is not — it asks\npose-mcp/internal/pose/review_closeout.go:86:\t// whether the change is safe, compatible, operable or in scope, and no\npose-mcp/internal/pose/review_closeout.go:87:\t// check emits that. Absent, it is derived rather than defaulted; see\npose-mcp/internal/pose/review_closeout.go:88:\t// ReviewCriterionKind.\npose-mcp/internal/pose/review_closeout.go:89:\tKind            string   `json:\"kind,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:90:\tRules           []string `json:\"rules,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:91:\tEvidenceClasses []string `json:\"evidence_classes,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:92:\tRequired        *bool    `json:\"required,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:93:\t// RequiresStructuralMapping says this criterion answers for the material\npose-mcp/internal/pose/review_closeout.go:94:\t// structural facts observed on the sealed subject: passing it then has to\npose-mcp/internal/pose/review_closeout.go:95:\t// map each of them to a decision basis, or dispose of it explicitly. The\npose-mcp/internal/pose/review_closeout.go:96:\t// profile declares which criterion carries that obligation, so the engine\npose-mcp/internal/pose/review_closeout.go:97:\t// never has to know a criterion id by name.\npose-mcp/internal/pose/review_closeout.go:98:\tRequiresStructuralMapping bool `json:\"requires_structural_mapping,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:99:}\npose-mcp/internal/pose/review_closeout.go:100:\npose-mcp/internal/pose/review_closeout.go:101:// ReviewCriterionKindMechanical and ReviewCriterionKindJudgment are the closed\npose-mcp/internal/pose/review_closeout.go:102:// set. There is deliberately no third value: a criterion nobody can answer is\npose-mcp/internal/pose/review_closeout.go:103:// not a weaker criterion, it is an unstated one.\npose-mcp/internal/pose/review_closeout.go:104:const (\npose-mcp/internal/pose/review_closeout.go:105:\tReviewCriterionKindMechanical = \"mechanical\"\npose-mcp/internal/pose/review_closeout.go:106:\tReviewCriterionKindJudgment   = \"judgment\"\npose-mcp/internal/pose/review_closeout.go:107:)\npose-mcp/internal/pose/review_closeout.go:108:\npose-mcp/internal/pose/review_closeout.go:109:// DeriveReviewCriterionKind answers what a criterion is when it does not say.\npose-mcp/internal/pose/review_closeout.go:110://\npose-mcp/internal/pose/review_closeout.go:111:// The rule is the one the engine can defend: a criterion that names evidence\npose-mcp/internal/pose/review_closeout.go:112:// classes has a registered producer and can be answered by citing what that\npose-mcp/internal/pose/review_closeout.go:113:// producer emitted; a criterion that names none has no producer at all, so\npose-mcp/internal/pose/review_closeout.go:114:// nothing mechanical can satisfy it. Deriving rather than defaulting matters\npose-mcp/internal/pose/review_closeout.go:115:// because the distributed profiles predate the field — `spec-closeout` has five\npose-mcp/internal/pose/review_closeout.go:116:// criteria with no class, `roadmap-outcome` has six, and every one of them was\npose-mcp/internal/pose/review_closeout.go:117:// being answered by whatever sealed result happened to be first in the bundle.\npose-mcp/internal/pose/review_closeout.go:118:func DeriveReviewCriterionKind(evidenceClasses []string) string {\npose-mcp/internal/pose/review_closeout.go:119:\tif len(evidenceClasses) > 0 {\npose-mcp/internal/pose/review_closeout.go:120:\t\treturn ReviewCriterionKindMechanical\npose-mcp/internal/pose/review_closeout.go:121:\t}\npose-mcp/internal/pose/review_closeout.go:122:\treturn ReviewCriterionKindJudgment\npose-mcp/internal/pose/review_closeout.go:123:}\npose-mcp/internal/pose/review_closeout.go:124:\npose-mcp/internal/pose/review_closeout.go:125:type ReviewProfileSelectors struct {\npose-mcp/internal/pose/review_closeout.go:126:\tLanguages     []string `json:\"languages,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:127:\tDomains       []string `json:\"domains,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:128:\tComponentIDs  []string `json:\"component_ids,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:129:\tDeliveryKinds []string `json:\"delivery_kinds,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:130:\tCriticalities []string `json:\"criticalities,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:131:\t// StructuralKinds selects on what the subject was observed to do, not on\npose-mcp/internal/pose/review_closeout.go:132:\t// what the scope declared. It composes conjunctively with the selectors\npose-mcp/internal/pose/review_closeout.go:133:\t// above, exactly like DeliveryKinds: a profile naming both matches only a\npose-mcp/internal/pose/review_closeout.go:134:\t// scope that satisfies both. It is what lets an undeclared scope still be\npose-mcp/internal/pose/review_closeout.go:135:\t// material — a dependency the author did not mention is a fact — without\npose-mcp/internal/pose/review_closeout.go:136:\t// making a Markdown extension proof of low risk.\npose-mcp/internal/pose/review_closeout.go:137:\t//\npose-mcp/internal/pose/review_closeout.go:138:\t// The vocabulary is closed to the kinds a detector can emit as material.\npose-mcp/internal/pose/review_closeout.go:139:\t// A profile selecting a kind nothing can observe would plan a gate only a\npose-mcp/internal/pose/review_closeout.go:140:\t// fabricated disposition could pass, which is the failure the evidence-class\npose-mcp/internal/pose/review_closeout.go:141:\t// vocabulary already refuses one level up.\npose-mcp/internal/pose/review_closeout.go:142:\tStructuralKinds []string `json:\"structural_kinds,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:143:}\npose-mcp/internal/pose/review_closeout.go:144:\npose-mcp/internal/pose/review_closeout.go:145:type ReviewProfileTool struct {\npose-mcp/internal/pose/review_closeout.go:146:\tID              string   `json:\"id\"`\npose-mcp/internal/pose/review_closeout.go:147:\tRequiredness    string   `json:\"requiredness,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:148:\tEvidenceClasses []string `json:\"evidence_classes,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:149:\tCriteria        []string `json:\"criteria,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:150:\tPreconditions   []string `json:\"preconditions,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:151:}\npose-mcp/internal/pose/review_closeout.go:152:\npose-mcp/internal/pose/review_closeout.go:153:type ReviewProfile struct {\npose-mcp/internal/pose/review_closeout.go:154:\tSchemaVersion int                      `json:\"schema_version\"`\npose-mcp/internal/pose/review_closeout.go:155:\tID            string                   `json:\"id\"`\npose-mcp/internal/pose/review_closeout.go:156:\tVersion       int                      `json:\"version\"`\npose-mcp/internal/pose/review_closeout.go:157:\tScope         string                   `json:\"scope\"`\npose-mcp/internal/pose/review_closeout.go:158:\tCriteria      []ReviewCriterionProfile `json:\"criteria\"`\npose-mcp/internal/pose/review_closeout.go:159:\tSelectors     ReviewProfileSelectors   `json:\"selectors,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:160:\tTools         []ReviewProfileTool      `json:\"tools,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:161:\tIndependence  string                   `json:\"independence,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:162:}\npose-mcp/internal/pose/review_closeout.go:163:\npose-mcp/internal/pose/review_closeout.go:164:func (p ReviewProfile) Ref() string { return fmt.Sprintf(\"%s@%d\", p.ID, p.Version) }\npose-mcp/internal/pose/review_closeout.go:165:\npose-mcp/internal/pose/review_closeout.go:166:type ReviewPolicy struct {\npose-mcp/internal/pose/review_closeout.go:167:\tQualifiedArtifactRefsVersion int `json:\"qualified_artifact_refs_version,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:168:\tSpecAuthorityTransferVersion int `json:\"spec_authority_transfer_version,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:169:\t// ContractNodesVersion adopts the R/A/D amendment gate (spec\npose-mcp/internal/pose/review_closeout.go:170:\t// pose-abm-contract-nodes); 0 keeps the requirement-only gate.\npose-mcp/internal/pose/review_closeout.go:171:\tContractNodesVersion int `json:\"contract_nodes_version,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:172:\t// AtomicStartVersion adopts `pose start --apply` (spec\npose-mcp/internal/pose/review_closeout.go:173:\t// pose-abm-atomic-start); preview needs no adoption.\npose-mcp/internal/pose/review_closeout.go:174:\tAtomicStartVersion int `json:\"atomic_start_version,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:175:\t// AtomicStartAdoptedAt (YYYY-MM-DD) limits the capability to specs\npose-mcp/internal/pose/review_closeout.go:176:\t// created on or after it; older in-progress specs are reported without a\npose-mcp/internal/pose/review_closeout.go:177:\t// reconciliation (spec pose-atomic-start-adoption-cutoff).\npose-mcp/internal/pose/review_closeout.go:178:\tAtomicStartAdoptedAt string `json:\"atomic_start_adopted_at,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:179:\t// AgencyReadinessVersion adopts governed effects: unsatisfied action\npose-mcp/internal/pose/review_closeout.go:180:\t// requests refuse the transitions they restrict (spec\npose-mcp/internal/pose/review_closeout.go:181:\t// pose-governed-effect-enforcement); 0 keeps the legacy behaviour.\npose-mcp/internal/pose/review_closeout.go:182:\tAgencyReadinessVersion int `json:\"agency_readiness_version,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:183:\t// CausalityCloseoutVersion stamps the causality-closeout contract on new\npose-mcp/internal/pose/review_closeout.go:184:\t// bundles (spec pose-abm-causality-attestation).\npose-mcp/internal/pose/review_closeout.go:185:\tCausalityCloseoutVersion int `json:\"causality_closeout_version,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:186:\t// CausalityCloseoutAdoptedAt (YYYY-MM-DD) limits the contract to scopes\npose-mcp/internal/pose/review_closeout.go:187:\t// with a spec created on or after it (spec\npose-mcp/internal/pose/review_closeout.go:188:\t// pose-causality-closeout-adoption-cutoff).\npose-mcp/internal/pose/review_closeout.go:189:\tCausalityCloseoutAdoptedAt string `json:\"causality_closeout_adopted_at,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:190:\t// OverlayAdoptedAt dates an overlay adopted after work was under way: a\npose-mcp/internal/pose/review_closeout.go:191:\t// dated overlay selects only scopes with a spec created on or after its\npose-mcp/internal/pose/review_closeout.go:192:\t// date. An overlay without a date applies to every scope, as before.\npose-mcp/internal/pose/review_closeout.go:193:\tOverlayAdoptedAt                 map[string]string `json:\"overlay_adopted_at,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:194:\tSchemaVersion                    int               `json:\"schema_version\"`\npose-mcp/internal/pose/review_closeout.go:195:\tEnabled                          bool              `json:\"enabled\"`\npose-mcp/internal/pose/review_closeout.go:196:\tAdoptedAt                        string            `json:\"adopted_at,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:197:\tProfiles                         map[string]string `json:\"profiles\"`\npose-mcp/internal/pose/review_closeout.go:198:\tAllowApprovedWithReservations    bool              `json:\"allow_approved_with_reservations,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:199:\tAcceptedRiskSeverities           []string          `json:\"accepted_risk_severities,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:200:\tReviewerIndependence             map[string]string `json:\"reviewer_independence,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:201:\tContinuousCloseout               bool              `json:\"continuous_closeout,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:202:\tAllowInScopeRemediationSpec      bool              `json:\"allow_in_scope_remediation_spec,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:203:\tRequireReviewForLegacyDoneScopes bool              `json:\"require_review_for_legacy_done_scopes,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:204:\tComponentAware                   bool              `json:\"component_aware,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:205:\tComponentAwareAdoptedAt          string            `json:\"component_aware_adopted_at,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:206:\tEvidenceVocabularyReconciledAt   string            `json:\"evidence_vocabulary_reconciled_at,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:207:\tContractAdoptions                map[string]string `json:\"contract_adoptions,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:208:\tUnmappedComponentBehavior        string            `json:\"unmapped_component_behavior,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:209:\tOverlayProfiles                  []string          `json:\"overlay_profiles,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:210:\tReviewBundles                    bool              `json:\"review_bundles,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:211:\tReviewBundlesAdoptedAt           string            `json:\"review_bundles_adopted_at,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:212:\t// ExplicitJudgmentAdoptedAt and StructuralCausalityAdoptedAt are the legacy\npose-mcp/internal/pose/review_closeout.go:213:\t// keys the registry names for the two 6.0.0 contracts. They were declared\npose-mcp/internal/pose/review_closeout.go:214:\t// in policies and named by the registry long before the typed policy read\npose-mcp/internal/pose/review_closeout.go:215:\t// them, so a configured cutoff produced no effect (spec\npose-mcp/internal/pose/review_closeout.go:216:\t// pose-legacy-contract-cutoffs). `contract_adoptions` still wins.\npose-mcp/internal/pose/review_closeout.go:217:\tExplicitJudgmentAdoptedAt    string   `json:\"explicit_judgment_adopted_at,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:218:\tStructuralCausalityAdoptedAt string   `json:\"structural_causality_adopted_at,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:219:\tAllowCriterionReuse          bool     `json:\"allow_criterion_reuse,omitempty\"`\npose-mcp/internal/pose/review_closeout.go:220:\tRequireSignedAttestations    bool     `json:\"require_signed_attestations,omitempty\"`\n","exit_code":0,"status":"completed"}}
