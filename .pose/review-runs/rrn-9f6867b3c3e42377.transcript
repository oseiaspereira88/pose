{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/accepted_limits_test.go | sed -n '1,210p'; nl -ba pose-mcp/internal/cli/accepted_limits_lint_test.go | sed -n '1,180p'\"","aggregated_output":"     1\tpackage pose\n     2\t\n     3\timport (\n     4\t\t\"os\"\n     5\t\t\"path/filepath\"\n     6\t\t\"strings\"\n     7\t\t\"testing\"\n     8\t)\n     9\t\n    10\tconst limitsSection = `\n    11\t### Accepted limits\n    12\t- L1: A process that clears its environment escapes. Accepted because the shim covers it.\n    13\t- L2: Windows is untested here. Accepted because the host is Linux.\n    14\t`\n    15\t\n    16\t// Spec pose-review-declared-threat-model R1: the section is read as\n    17\t// written, and what does not say why it is accepted is reported.\n    18\tfunc TestAcceptedLimitsAreParsed(t *testing.T) {\n    19\t\tlimits, problems := ParseAcceptedLimits(\"## 3. Technical Plan\\n\" + limitsSection + \"\\n### Other\\n- L9: not a limit here.\\n\")\n    20\t\tif len(problems) != 0 || len(limits) != 2 || limits[0].ID != \"L1\" || limits[1].ID != \"L2\" {\n    21\t\t\tt.Fatalf(\"limits %+v problems %v\", limits, problems)\n    22\t\t}\n    23\t\t_, problems = ParseAcceptedLimits(\"### Accepted limits\\n- L1: no reason given.\\n- L1: twice. Accepted because yes.\\n- X1: wrong id. Accepted because no.\\n- L3: a marker with nothing after it. Accepted because\\n\")\n    24\t\tjoined := strings.Join(problems, \"\\n\")\n    25\t\tfor _, want := range []string{\"L1 does not say why it is accepted\", \"L1 is declared twice\", \"is not written as\", \"L3 does not say why it is accepted\"} {\n    26\t\t\tif !strings.Contains(joined, want) {\n    27\t\t\t\tt.Fatalf(\"missing problem %q in %v\", want, problems)\n    28\t\t\t}\n    29\t\t}\n    30\t}\n    31\t\n    32\t// R1: the review plan seals the limits the spec declares, and they enter the\n    33\t// plan digest; a spec without limits keeps its digest.\n    34\tfunc TestTheReviewPlanSealsTheAcceptedLimits(t *testing.T) {\n    35\t\troot, store := reviewBundleFixture(t)\n    36\t\tbefore, err := store.ReviewPlan(\"spec:backend\")\n    37\t\tif err != nil || len(before.AcceptedLimits) != 0 {\n    38\t\t\tt.Fatalf(\"plan without limits: %+v %v\", before.AcceptedLimits, err)\n    39\t\t}\n    40\t\tpath := filepath.Join(root, \".pose/specs/backend/spec.md\")\n    41\t\traw, _ := os.ReadFile(path)\n    42\t\tif err := os.WriteFile(path, []byte(strings.Replace(string(raw), \"### Technical risks\", strings.TrimPrefix(limitsSection, \"\\n\")+\"\\n### Technical risks\", 1)), 0o644); err != nil {\n    43\t\t\tt.Fatal(err)\n    44\t\t}\n    45\t\tafter, err := store.ReviewPlan(\"spec:backend\")\n    46\t\tif err != nil || len(after.AcceptedLimits) != 2 || after.AcceptedLimits[0].ID != \"L1\" {\n    47\t\t\tt.Fatalf(\"plan with limits: %+v %v\", after.AcceptedLimits, err)\n    48\t\t}\n    49\t\twithout := after\n    50\t\twithout.AcceptedLimits = nil\n    51\t\tif digest, err := digestReviewPlan(without); err != nil || digest == after.PlanDigest {\n    52\t\t\tt.Fatalf(\"the accepted limits did not enter the plan digest: %v\", err)\n    53\t\t}\n    54\t}\n    55\t\n    56\t// R2, R3: a follow-up the reviewer classifies inside a sealed limit is\n    57\t// recorded within-limit, naming it, and does not block an approval whatever\n    58\t// its severity; a limit the bundle did not seal accepts nothing.\n    59\tfunc TestAFindingWithinASealedLimitDoesNotBlockApproval(t *testing.T) {\n    60\t\tvar bundle ReviewBundle\n    61\t\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"x. Accepted because y.\"}}\n    62\t\tdraft := ReviewDraft{Decision: \"approved\", Findings: []ReviewDraftFinding{\n    63\t\t\t{ID: \"N1\", Severity: \"high\", Disposition: \"follow-up\", Summary: \"an orphan that clears its environment escapes; that is L1\", Limit: \"L1\"},\n    64\t\t}}\n    65\t\tatt := reviewAttestationFromDraft(ReviewRun{RunID: \"rrn-0000000000000001\"}, bundle, draft, \"agent:reviewer\")\n    66\t\tif len(att.Findings) != 1 || att.Findings[0].Disposition != \"within-limit\" || att.Findings[0].Limit != \"L1\" {\n    67\t\t\tt.Fatalf(\"the finding was not recorded within its limit: %+v\", att.Findings)\n    68\t\t}\n    69\t\tatt.Decision = \"approved\"\n    70\t\tif blockers := reviewFindingDecisionBlockers(bundle, att); len(blockers) != 0 {\n    71\t\t\tt.Fatalf(\"a finding within a sealed limit blocked the approval: %v\", blockers)\n    72\t\t}\n    73\t\tatt.Findings[0].Limit = \"L9\"\n    74\t\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"L9, which this bundle did not seal\") {\n    75\t\t\tt.Fatalf(\"an unsealed limit was accepted: %s\", blockers)\n    76\t\t}\n    77\t\tatt.Findings[0].Limit, att.Findings[0].Rationale = \"L1\", \"\"\n    78\t\tif blockers := strings.Join(reviewFindingDecisionBlockers(bundle, att), \"\\n\"); !strings.Contains(blockers, \"without saying why\") {\n    79\t\t\tt.Fatalf(\"a finding within a limit without a reason was accepted: %s\", blockers)\n    80\t\t}\n    81\t}\n    82\t\n    83\t// Review round 1, N1: across the specs of a composite scope each limit is\n    84\t// qualified by its spec, so a finding names exactly one.\n    85\tfunc TestLimitsAcrossSpecsAreQualified(t *testing.T) {\n    86\t\tbody := \"### Accepted limits\\n- L1: one. Accepted because it is rare.\\n\"\n    87\t\tsingle := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}})\n    88\t\tif len(single) != 1 || single[0].ID != \"L1\" || single[0].Spec != \"\" {\n    89\t\t\tt.Fatalf(\"a single spec's limit was qualified: %+v\", single)\n    90\t\t}\n    91\t\tboth := acceptedLimitsOfSpecs([]Spec{{Slug: \"alpha\", Body: body}, {Slug: \"beta\", Body: body}})\n    92\t\tif len(both) != 2 || both[0].ID != \"alpha#L1\" || both[1].ID != \"beta#L1\" || both[1].Spec != \"beta\" {\n    93\t\t\tt.Fatalf(\"limits across specs are ambiguous: %+v\", both)\n    94\t\t}\n    95\t}\n    96\t\n    97\t// Review round 2, N1: punctuation is not a reason, and a reason may start\n    98\t// with a one-letter word.\n    99\tfunc TestAnAcceptedLimitNeedsWordsAsItsReason(t *testing.T) {\n   100\t\tfor text, want := range map[string]bool{\n   101\t\t\t\"x. Accepted because ..\":                                          false,\n   102\t\t\t\"x. Accepted because -- !\":                                        false,\n   103\t\t\t\"x. Accepted because rare\":                                        false,\n   104\t\t\t\"An escape. Accepted because a shim covers it.\":                   true,\n   105\t\t\t\"Uma fuga. Aceito porque o shim cobre o caso.\":                    true,\n   106\t\t\t\"Not accepted because this would violate scope.\":                  false,\n   107\t\t\t\"Accepted because it is rare.\":                                    false,\n   108\t\t\t\"An escape. Accepted because. Then unrelated prose follows here.\": false,\n   109\t\t\t\"An escape. Accepted because a shim covers it. More context.\":     true,\n   110\t\t\t\"An escape. Accepted because ; later prose has words.\":            false,\n   111\t\t\t\"X. Accepted because a shim covers it.\":                           false,\n   112\t\t\t\"x, accepted because it is rare.\":                                 false,\n   113\t\t} {\n   114\t\t\tif got := hasAcceptedLimitReason(text); got != want {\n   115\t\t\t\tt.Errorf(\"%q: reason=%t, want %t\", text, got, want)\n   116\t\t\t}\n   117\t\t}\n   118\t}\n     1\tpackage cli\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"os\"\n     6\t\t\"path/filepath\"\n     7\t\t\"strings\"\n     8\t\t\"testing\"\n     9\t)\n    10\t\n    11\t// Spec pose-review-declared-threat-model R4: the ready check refuses an\n    12\t// accepted limit without its reason, and one an ADR citing the spec omits.\n    13\tfunc TestReadyCheckJudgesAcceptedLimits(t *testing.T) {\n    14\t\troot := t.TempDir()\n    15\t\twrite := func(rel, body string) {\n    16\t\t\tp := filepath.Join(root, rel)\n    17\t\t\tif err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {\n    18\t\t\t\tt.Fatal(err)\n    19\t\t\t}\n    20\t\t\tif err := os.WriteFile(p, []byte(body), 0o644); err != nil {\n    21\t\t\t\tt.Fatal(err)\n    22\t\t\t}\n    23\t\t}\n    24\t\tspec := func(limits string) string {\n    25\t\t\treturn \"---\\nslug: limited\\nstatus: draft\\ncreated_at: 2026-11-25\\n---\\n\\n# Spec: limited\\n\\n## 1. Intent\\n\\n### Goal\\nA goal worth stating.\\n\\n## 2. Requirements\\n\\n### Functional\\n- R1: It works.\\n\\n## 3. Technical Plan\\n\\n### Affected areas\\nThe engine.\\n\" + limits + \"\\n## 4. Tasks\\n- [ ] Do it.\\n\"\n    26\t\t}\n    27\t\tpath := filepath.Join(root, \".pose/specs/limited/spec.md\")\n    28\t\trun := func() (int, string) {\n    29\t\t\tvar out, errOut bytes.Buffer\n    30\t\t\tcode := lintOneSpec(path, false, true, &out, &errOut)\n    31\t\t\treturn code, out.String() + errOut.String()\n    32\t\t}\n    33\t\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape. Accepted because it is rare.\\n\"))\n    34\t\tif code, out := run(); code != 0 {\n    35\t\t\tt.Fatalf(\"a justified limit failed the ready check: %d %s\", code, out)\n    36\t\t}\n    37\t\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape with no reason.\\n\"))\n    38\t\tif code, out := run(); code == 0 || !strings.Contains(out, \"does not say why it is accepted\") {\n    39\t\t\tt.Fatalf(\"an unjustified limit passed: %d %s\", code, out)\n    40\t\t}\n    41\t\twrite(\".pose/specs/limited/spec.md\", spec(\"\\n### Accepted limits\\n- L1: an escape. Accepted because it is rare.\\n- L2: another. Accepted because it is rarer.\\n\"))\n    42\t\t// Review round 1, N3: L10 does not name L1.\n    43\t\twrite(\".pose/adr/2026-11-25-limited.md\", \"# ADR\\n\\nFor `limited`. L10 and L2 are accepted.\\n\")\n    44\t\tif code, out := run(); code == 0 || !strings.Contains(out, \"accepted limit L1 is not named by the ADR\") {\n    45\t\t\tt.Fatalf(\"L10 was taken as naming L1: %d %s\", code, out)\n    46\t\t}\n    47\t\twrite(\".pose/adr/2026-11-25-limited.md\", \"# ADR\\n\\nFor `limited`. L1 is accepted.\\n\")\n    48\t\tif code, out := run(); code == 0 || !strings.Contains(out, \"accepted limit L2 is not named by the ADR\") {\n    49\t\t\tt.Fatalf(\"a limit the ADR omits passed: %d %s\", code, out)\n    50\t\t}\n    51\t}\n","exit_code":0,"status":"completed"}}
