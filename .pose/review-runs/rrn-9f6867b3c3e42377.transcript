tfinding.Rationale = parts[6]\n  1285\t\t\t}\n  1286\t\t\tif len(parts) > 7 {\n  1287\t\t\t\tfinding.ReviewBy = parts[7]\n  1288\t\t\t}\n  1289\t\t\tresult = append(result, finding)\n  1290\t\t}\n  1291\t\treturn result, nil\n  1292\t}\n  1293\t\n  1294\tfunc cmdReviewRecord(root string, args []string, stdout, stderr io.Writer) int {\n  1295\t\tvar ref, reviewer, decision, expectedPlanDigest string\n  2970\t\t}\n  2971\t\tsort.Slice(pending, func(i, j int) bool { return pending[i].Criterion < pending[j].Criterion })\n  2972\t\treturn att, pending, nil\n  2973\t}\n  2974\t\n  2975\t// RecordReviewAttestation appends an immutable decision for one sealed bundle.\n  2976\tfunc (s Store) RecordReviewAttestation(att ReviewAttestation, now time.Time) (ReviewAttestation, error) {\n  2977\t\tvar result ReviewAttestation\n  2978\t\terr := s.withReviewAttestationWriteGuard(\"review.attestation.record\", att, func(guarded Store) error {\n  2979\t\t\tvar err error\n  2980\t\t\tresult, err = guarded.recordReviewAttestation(att, now, false)\n  2981\t\t\treturn err\n  2982\t\t})\n  2983\t\treturn result, err\n  2984\t}\n  2985\t\n  2986\tfunc (s Store) recordReviewAttestation(att ReviewAttestation, now time.Time, signed bool) (ReviewAttestation, error) {\n  2987\t\tbundle, err := s.LoadReviewBundle(att.BundleID)\n  2988\t\tif err != nil {\n  2989\t\t\treturn ReviewAttestation{}, err\n  2990\t\t}\n  2991\t\tpolicy, _, err := s.loadReviewPolicy()\n  2992\t\tif err != nil {\n  2993\t\t\treturn ReviewAttestation{}, err\n  2994\t\t}\n  2995\t\tif policy.RequireSignedAttestations && !signed {\n  2996\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review policy requires a trusted signed attestation envelope\")\n  2997\t\t}\n  2998\t\tatt, err = completeReviewAttestation(bundle, att, now)\n  2999\t\tif err != nil {\n  3000\t\t\treturn ReviewAttestation{}, err\n  3001\t\t}\n  3002\t\t// The approval preflight runs here, in the one writer every channel shares,\n  3003\t\t// before anything is written: an approval the verifier would reject is\n  3004\t\t// refused, not recorded and rejected later (spec\n  3005\t\t// pose-review-approval-domain-preflight).\n  3006\t\tif blockers := s.reviewApprovalAdmissionBlockers(bundle, att, now); len(blockers) > 0 {\n  3007\t\t\treturn ReviewAttestation{}, &ReviewApprovalRefusal{BundleID: bundle.BundleID, Blockers: blockers}\n  3008\t\t}\n  3009\t\tatt.Path = filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\", att.AttestationID+\".json\"))\n  3010\t\tdir, err := ensureReviewArtifactDirIn(s.fsys(), s.Root, filepath.ToSlash(filepath.Join(\".pose\", \"review-attestations\")), true)\n  3011\t\tif err != nil {\n  3012\t\t\treturn ReviewAttestation{}, err\n  3013\t\t}\n  3014\t\tpath := filepath.Join(dir, att.AttestationID+\".json\")\n  3015\t\tif existing, loadErr := s.LoadReviewAttestation(att.AttestationID); loadErr == nil {\n  3016\t\t\texistingRaw, _ := json.Marshal(existing)\n  3017\t\t\tcandidateRaw, _ := json.Marshal(att)\n  3018\t\t\tif bytes.Equal(existingRaw, candidateRaw) {\n  3019\t\t\t\treturn existing, nil\n  3020\t\t\t}\n  3021\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation identity collision for %s\", att.AttestationID)\n  3022\t\t}\n  3023\t\traw, err := json.MarshalIndent(att, \"\", \"  \")\n  3024\t\tif err != nil {\n  3025\t\t\treturn ReviewAttestation{}, err\n  3026\t\t}\n  3027\t\tif err := writeImmutableJSONIn(s.fsys(), path, append(raw, '\\n')); err != nil {\n  3028\t\t\tvar durability *PublishDurabilityError\n  3029\t\t\tif errors.As(err, &durability) {\n  3030\t\t\t\treturn att, err\n  3031\t\t\t}\n  3032\t\t\treturn ReviewAttestation{}, err\n  3033\t\t}\n  3034\t\treturn att, nil\n  3035\t}\n  3110\t}\n  3111\t\n  3112\t// RecordReviewAttestationEnvelope verifies a trusted issuer's envelope and,\n  3113\t// with apply, records the attestation it carries: the path both\n  3114\t// `pose review attest --envelope` and the MCP tool take.\n  3115\tfunc (s Store) RecordReviewAttestationEnvelope(envelope ReviewAttestationEnvelope, apply bool) (ReviewAttestation, error) {\n  3116\t\tif !apply {\n  3117\t\t\treturn s.VerifyReviewAttestationEnvelope(envelope)\n  3118\t\t}\n  3119\t\tvar result ReviewAttestation\n  3120\t\terr := s.withReviewAttestationWriteGuard(\"review.attestation.envelope\", envelope.Attestation, func(guarded Store) error {\n  3121\t\t\tattestation, err := guarded.VerifyReviewAttestationEnvelope(envelope)\n  3122\t\t\tif err != nil {\n  3123\t\t\t\treturn err\n  3124\t\t\t}\n  3125\t\t\tresult, err = guarded.recordReviewAttestation(attestation, guarded.reviewClock(), true)\n  3126\t\t\treturn err\n  3127\t\t})\n  3128\t\treturn result, err\n  3129\t}\n  3130\t\n  3131\t// ErrReviewApprovalRefused classifies a ReviewApprovalRefusal for errors.Is.\n  3132\tvar ErrReviewApprovalRefused = errors.New(\"pose: review approval refused before persistence\")\n  3133\t\n  3134\t// ReviewApprovalRefusal is the typed result of the domain approval preflight:\n  3135\t// every reason the verifier would reject the approval, returned before any\n  3136\t// artifact of the attempt is written. Every channel — Store, CLI, signed\n  3137\t// import and MCP — receives this same value.\n  3138\ttype ReviewApprovalRefusal struct {\n  3139\t\tBundleID string   `json:\"bundle_id\"`\n  3140\t\tBlockers []string `json:\"blockers\"`\n  3141\t}\n  3142\t\n  3143\tfunc (e *ReviewApprovalRefusal) Error() string {\n  3144\t\treturn \"pose: verify would reject this approval for bundle \" + e.BundleID + \", so nothing was written: \" + strings.Join(e.Blockers, \"; \")\n  3145\t}\n  3146\t\n  3147\tfunc (e *ReviewApprovalRefusal) Unwrap() error { return ErrReviewApprovalRefused }\n  3148\t\n  3149\tfunc reviewDecisionApproves(decision string) bool {\n  3150\t\treturn decision == \"approved\" || decision == \"approved-with-reservations\"\n  3151\t}\n  3152\t\n  3153\t// reviewApprovalAdmissionBlockers is the semantic admission of a new approving\n  3154\t// attestation, completed as it will be recorded. It reuses the verifier itself\n  3155\t// over the bundle's sealed gates and the deliberately live signing and trust\n  3156\t// requirements, adds the time admissibility of a new operation, and requires\n  3157\t// the bundle to still be the current sealed subject of its scope, so the\n  3158\t// approval of a stale preview or of a superseded bundle is not written.\n  3159\t//\n  3160\t// A non-approving decision is an audit record the verifier rejects for\n  3161\t// closeout by definition, so its criteria are not held to the approval bar;\n  3162\t// its channel's authentication still applies in the writer.\n  3163\tfunc (s Store) reviewApprovalAdmissionBlockers(bundle ReviewBundle, att ReviewAttestation, now time.Time) []string {\n  3164\t\tif !reviewDecisionApproves(att.Decision) {\n  3165\t\t\treturn nil\n  3166\t\t}\n  3167\t\tblockers := s.atReviewTime(now).validateBundleAttestation(bundle, att)\n  3168\t\tblockers = append(blockers, reviewNewOperationTimeBlockers(att, now)...)\n  3169\t\tcurrent, err := s.CurrentReviewBundle(bundle.Payload.Scope.Ref)\n  3170\t\tswitch {\n  3171\t\tcase err != nil:\n  3172\t\t\tblockers = append(blockers, \"the current review subject of \"+bundle.Payload.Scope.Ref+\" cannot be established: \"+strings.TrimPrefix(err.Error(), \"pose: \"))\n  3173\t\tcase current == nil:\n  3174\t\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" no longer represents the current semantic inputs of \"+bundle.Payload.Scope.Ref+\"; seal the current bundle and review it\")\n  3175\t\tcase current.BundleID != bundle.BundleID:\n  3176\t\t\tblockers = append(blockers, \"bundle \"+bundle.BundleID+\" is superseded by \"+current.BundleID+\"; review the current bundle\")\n  3177\t\t}\n  3178\t\treturn uniqueSorted(blockers)\n  3179\t}\n  3180\t\n  3181\t// PreflightReviewAttestation returns the reasons the domain writer would\n  3182\t// refuse an approving attestation, without writing anything. It completes the\n  3183\t// attestation exactly as recording would and runs the same admission, so a\n  3184\t// preview and the write cannot disagree (specs\n  3185\t// pose-attest-refuses-what-verify-rejects, pose-review-approval-domain-preflight).\n  3186\tfunc (s Store) PreflightReviewAttestation(att ReviewAttestation, now time.Time) []string {\n  3187\t\tif !reviewDecisionApproves(att.Decision) {\n  3188\t\t\treturn nil\n  3189\t\t}\n  3190\t\tbundle, err := s.LoadReviewBundle(att.BundleID)\n  3191\t\tif err != nil {\n  3192\t\t\treturn []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n  3193\t\t}\n  3194\t\tatt.Path = \"\"\n  3195\t\tcompleted, err := completeReviewAttestation(bundle, att, now)\n  3196\t\tif err != nil {\n  3197\t\t\treturn []string{strings.TrimPrefix(err.Error(), \"pose: \")}\n  3198\t\t}\n  3199\t\treturn s.reviewApprovalAdmissionBlockers(bundle, completed, now)\n  3200\t}\n  3201\t\n  3202\t// VerifyReviewAttestationEnvelope verifies an optional provider-neutral\n  3203\t// Ed25519 envelope. Trust is pinned as <issuer>#sha256:<public-key-digest> in\n  3204\t// review policy; a self-declared issuer or public key is never trusted alone.\n  3205\tfunc (s Store) VerifyReviewAttestationEnvelope(envelope ReviewAttestationEnvelope) (ReviewAttestation, error) {\n  3206\t\tif envelope.SchemaVersion != ReviewBundleSchemaVersion || envelope.Algorithm != \"ed25519\" {\n  3207\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: unsupported review attestation envelope\")\n  3208\t\t}\n  3209\t\tif envelope.Subject != envelope.Attestation.BundleID || envelope.Issuer == \"\" || strings.ContainsAny(envelope.Issuer, \"\\r\\n\") {\n  3210\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation envelope subject or issuer mismatch\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_bundle.go | sed -n '2855,2975p;3202,3255p' && nl -ba pose-mcp/internal/mcpserver/server.go | sed -n '1410,1476p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_bundle.go | sed -n '2855,2975p;3202,3255p' && nl -ba pose-mcp/internal/mcpserver/server.go | sed -n '1410,1476p'\"","aggregated_output":"  2855\t\t\t\t//\n  2856\t\t\t\t// Where the scope is expected to carry validation evidence, the\n  2857\t\t\t\t// honest answer is to refuse: the check exists and was not run, and\n  2858\t\t\t\t// a reviewer must run it or disposition the criterion themselves\n  2859\t\t\t\t// with a reason. Where it is not — a documentation-only spec with no\n  2860\t\t\t\t// delivery target, the case the same distinction already exempts\n  2861\t\t\t\t// above — the criterion is recorded not-applicable, naming what is\n  2862\t\t\t\t// missing. Either way the absence is visible instead of dressed as\n  2863\t\t\t\t// a pass.\n  2864\t\t\t\tif requiresEvidence {\n  2865\t\t\t\t\tif len(criterion.EvidenceClasses) > 0 {\n  2866\t\t\t\t\t\treturn ReviewAttestation{}, nil, fmt.Errorf(\"pose: criterion %s requires evidence class %s and bundle %s seals none; run the check, or record the criterion as not-applicable with a rationale using `pose review attest`\", criterion.ID, strings.Join(criterion.EvidenceClasses, \"|\"), bundleID)\n  2867\t\t\t\t\t}\n  2868\t\t\t\t\treturn ReviewAttestation{}, nil, fmt.Errorf(\"pose: criterion %s has no evidence in bundle %s; run a check, or record the criterion as not-applicable with a rationale using `pose review attest`\", criterion.ID, bundleID)\n  2869\t\t\t\t}\n  2870\t\t\t\trationale := \"the scope carries no delivery target, so no validation evidence is collected for it\"\n  2871\t\t\t\tif len(criterion.EvidenceClasses) > 0 {\n  2872\t\t\t\t\trationale = \"the scope carries no delivery target, so no evidence of class \" + strings.Join(criterion.EvidenceClasses, \"|\") + \" is collected for it\"\n  2873\t\t\t\t}\n  2874\t\t\t\tcriteria = append(criteria, ReviewCriterion{\n  2875\t\t\t\t\tID:          criterion.ID,\n  2876\t\t\t\t\tDisposition: \"not-applicable\",\n  2877\t\t\t\t\tRationale:   rationale,\n  2878\t\t\t\t})\n  2879\t\t\t\tcontinue\n  2880\t\t\t}\n  2881\t\t\tevidenceRefs = append(evidenceRefs, critEvidence)\n  2882\t\t\tcriteria = append(criteria, ReviewCriterion{\n  2883\t\t\t\tID:          criterion.ID,\n  2884\t\t\t\tDisposition: \"passed\",\n  2885\t\t\t\tEvidence:    critEvidence,\n  2886\t\t\t})\n  2887\t\t}\n  2888\t\tevidenceRefs = uniqueSorted(evidenceRefs)\n  2889\t\n  2890\t\ttools := make([]ReviewToolDisposition, 0, len(bundle.Payload.Plan.Tools))\n  2891\t\tfor _, tool := range bundle.Payload.Plan.Tools {\n  2892\t\t\tdisposition := ReviewToolDisposition{\n  2893\t\t\t\tID:        tool.ID,\n  2894\t\t\t\tComponent: tool.Component,\n  2895\t\t\t}\n  2896\t\t\tif containsFold(tool.Preconditions, \"review-complete\") {\n  2897\t\t\t\tdisposition.Disposition = \"deferred\"\n  2898\t\t\t\tdisposition.Rationale = \"post-review gate\"\n  2899\t\t\t} else if tool.ProducerCoverage == \"none\" {\n  2900\t\t\t\t// A fact the engine computed from the matrix, not a judgment: this\n  2901\t\t\t\t// component declares that it runs no check, so nothing can produce\n  2902\t\t\t\t// what the tool asks for. Preparing it here is what keeps the\n  2903\t\t\t\t// reviewer from having to cite another component's result.\n  2904\t\t\t\tdisposition.Disposition = \"not-used\"\n  2905\t\t\t\tdisposition.Rationale = \"the validation matrix declares this component runs no check, so no producer can emit evidence of class \" + strings.Join(tool.EvidenceClasses, \"|\")\n  2906\t\t\t} else if tool.Requiredness == \"recommended\" {\n  2907\t\t\t\tdisposition.Disposition = \"not-used\"\n  2908\t\t\t\tdisposition.Rationale = \"not used during automated attestation\"\n  2909\t\t\t} else {\n  2910\t\t\t\ttoolEv := \"\"\n  2911\t\t\t\ttoolComponents := []string{}\n  2912\t\t\t\tif tool.Component != \"\" {\n  2913\t\t\t\t\ttoolComponents = append(toolComponents, tool.Component)\n  2914\t\t\t\t}\n  2915\t\t\t\ttoolEv = pickScoped(tool.EvidenceClasses, toolComponents)\n  2916\t\t\t\tif toolEv == \"\" && len(tool.EvidenceClasses) == 0 {\n  2917\t\t\t\t\t// A tool that declares no evidence class does not report a\n  2918\t\t\t\t\t// validation result at all — `artifact-check` and `review-check`\n  2919\t\t\t\t\t// are POSE commands, and what supports their disposition is that\n  2920\t\t\t\t\t// the command ran. Naming the tool is a real reference to that;\n  2921\t\t\t\t\t// reaching for an unrelated sealed result, as this used to, said\n  2922\t\t\t\t\t// nothing about whether the tool ran.\n  2923\t\t\t\t\ttoolEv = \"check:\" + tool.ID\n  2924\t\t\t\t}\n  2925\t\t\t\tif toolEv == \"\" {\n  2926\t\t\t\t\t// The same invention the criteria path stopped doing one spec\n  2927\t\t\t\t\t// ago, on the other half of the attestation: `validation:auto-\n  2928\t\t\t\t\t// attest`, `<class>:auto-attest`, `docs:auto-attest` — none of\n  2929\t\t\t\t\t// them pointing at anything, and nothing downstream checking.\n  2930\t\t\t\t\t// The distinction between a judged review and a stamped one\n  2931\t\t\t\t\t// does not survive one half of it being fabricated.\n  2932\t\t\t\t\tif requiresEvidence {\n  2933\t\t\t\t\t\tif len(tool.EvidenceClasses) > 0 {\n  2934\t\t\t\t\t\t\treturn ReviewAttestation{}, nil, fmt.Errorf(\"pose: review tool %s requires evidence class %s and bundle %s seals none; run the tool, or record its disposition with `pose review attest --tool`\", tool.ID, strings.Join(tool.EvidenceClasses, \"|\"), bundleID)\n  2935\t\t\t\t\t\t}\n  2936\t\t\t\t\t\treturn ReviewAttestation{}, nil, fmt.Errorf(\"pose: review tool %s has no evidence in bundle %s; run the tool, or record its disposition with `pose review attest --tool`\", tool.ID, bundleID)\n  2937\t\t\t\t\t}\n  2938\t\t\t\t\t// `deferred`, not `not-used`: a required tool recorded not-used\n  2939\t\t\t\t\t// is a blocker whatever the reason, while a deferral is the\n  2940\t\t\t\t\t// disposition the engine already accepts for a tool whose\n  2941\t\t\t\t\t// precondition this scope cannot meet.\n  2942\t\t\t\t\tdisposition.Disposition = \"deferred\"\n  2943\t\t\t\t\tdisposition.Rationale = \"the scope carries no delivery target, so no evidence this tool reports is collected for it\"\n  2944\t\t\t\t\ttools = append(tools, disposition)\n  2945\t\t\t\t\tcontinue\n  2946\t\t\t\t}\n  2947\t\t\t\tdisposition.Disposition = \"passed\"\n  2948\t\t\t\tdisposition.Evidence = toolEv\n  2949\t\t\t}\n  2950\t\t\ttools = append(tools, disposition)\n  2951\t\t}\n  2952\t\n  2953\t\tdecision := \"approved\"\n  2954\t\tif len(pending) > 0 {\n  2955\t\t\t// A preparation that still owes answers is not an approval waiting to\n  2956\t\t\t// be written. Naming the decision `changes-requested` keeps the object\n  2957\t\t\t// honest if anything persists it anyway: the verifier refuses it, which\n  2958\t\t\t// is the correct outcome for a review nobody finished.\n  2959\t\t\tdecision = \"changes-requested\"\n  2960\t\t}\n  2961\t\tatt := ReviewAttestation{\n  2962\t\t\tBundleID:     bundle.BundleID,\n  2963\t\t\tBundleDigest: bundle.BundleDigest,\n  2964\t\t\tReviewer:     reviewer,\n  2965\t\t\tDecision:     decision,\n  2966\t\t\tCriteria:     criteria,\n  2967\t\t\tTools:        tools,\n  2968\t\t\tEvidenceRefs: evidenceRefs,\n  2969\t\t\tFindings:     []ReviewFinding{},\n  2970\t\t}\n  2971\t\tsort.Slice(pending, func(i, j int) bool { return pending[i].Criterion < pending[j].Criterion })\n  2972\t\treturn att, pending, nil\n  2973\t}\n  2974\t\n  2975\t// RecordReviewAttestation appends an immutable decision for one sealed bundle.\n  3202\t// VerifyReviewAttestationEnvelope verifies an optional provider-neutral\n  3203\t// Ed25519 envelope. Trust is pinned as <issuer>#sha256:<public-key-digest> in\n  3204\t// review policy; a self-declared issuer or public key is never trusted alone.\n  3205\tfunc (s Store) VerifyReviewAttestationEnvelope(envelope ReviewAttestationEnvelope) (ReviewAttestation, error) {\n  3206\t\tif envelope.SchemaVersion != ReviewBundleSchemaVersion || envelope.Algorithm != \"ed25519\" {\n  3207\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: unsupported review attestation envelope\")\n  3208\t\t}\n  3209\t\tif envelope.Subject != envelope.Attestation.BundleID || envelope.Issuer == \"\" || strings.ContainsAny(envelope.Issuer, \"\\r\\n\") {\n  3210\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation envelope subject or issuer mismatch\")\n  3211\t\t}\n  3212\t\tpublicKey, err := base64.StdEncoding.DecodeString(envelope.PublicKey)\n  3213\t\tif err != nil || len(publicKey) != ed25519.PublicKeySize {\n  3214\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid Ed25519 public key\")\n  3215\t\t}\n  3216\t\tsignature, err := base64.StdEncoding.DecodeString(envelope.Signature)\n  3217\t\tif err != nil || len(signature) != ed25519.SignatureSize {\n  3218\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: invalid Ed25519 signature\")\n  3219\t\t}\n  3220\t\tpolicy, _, err := s.loadReviewPolicy()\n  3221\t\tif err != nil {\n  3222\t\t\treturn ReviewAttestation{}, err\n  3223\t\t}\n  3224\t\tpin := envelope.Issuer + \"#\" + digestBytes(publicKey)\n  3225\t\ttrusted := false\n  3226\t\tfor _, candidate := range policy.TrustedAttestationIssuers {\n  3227\t\t\tif candidate == pin {\n  3228\t\t\t\ttrusted = true\n  3229\t\t\t\tbreak\n  3230\t\t\t}\n  3231\t\t}\n  3232\t\tif !trusted {\n  3233\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: untrusted review attestation issuer or public key\")\n  3234\t\t}\n  3235\t\tattestation := envelope.Attestation\n  3236\t\tattestation.Path = \"\"\n  3237\t\tattestation.Envelope = nil\n  3238\t\traw, err := json.Marshal(attestation)\n  3239\t\tif err != nil || !ed25519.Verify(ed25519.PublicKey(publicKey), raw, signature) {\n  3240\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: review attestation signature verification failed\")\n  3241\t\t}\n  3242\t\tbundle, err := s.LoadReviewBundle(attestation.BundleID)\n  3243\t\tif err != nil {\n  3244\t\t\treturn ReviewAttestation{}, err\n  3245\t\t}\n  3246\t\tif attestation.BundleDigest != bundle.BundleDigest {\n  3247\t\t\treturn ReviewAttestation{}, fmt.Errorf(\"pose: signed attestation does not bind the exact bundle\")\n  3248\t\t}\n  3249\t\tattestation.Envelope = &ReviewAttestationSignature{Issuer: envelope.Issuer, Subject: envelope.Subject, Algorithm: envelope.Algorithm, PublicKey: envelope.PublicKey, Signature: envelope.Signature}\n  3250\t\treturn attestation, nil\n  3251\t}\n  3252\t\n  3253\tfunc (s Store) ImportReviewAttestationEnvelope(rel string, apply bool) (ReviewAttestation, error) {\n  3254\t\treadEnvelope := func(store Store) (ReviewAttestationEnvelope, error) {\n  3255\t\t\tif err := ValidateArtifactPathIn(store.fsys(), store.Root, rel, false); err != nil {\n  1410\t\t\t\t}\n  1411\t\t\t}\n  1412\t\t\treturn store.PrepareReviewAttestation(a.BundleID, a.Reviewer, time.Now())\n  1413\t\tcase \"pose_review_attest\":\n  1414\t\t\t// The MCP way to record a review attestation (spec\n  1415\t\t\t// pose-mcp-review-attest-signed-only): only inside a trusted issuer's\n  1416\t\t\t// envelope, the proof `pose review attest --envelope` verifies. Without\n  1417\t\t\t// apply it previews: a draft is completed as recording would and the\n  1418\t\t\t// exact bytes to sign are returned; an envelope is verified, not stored.\n  1419\t\t\tvar a struct {\n  1420\t\t\t\tAttestation *pose.ReviewAttestation         `json:\"attestation\"`\n  1421\t\t\t\tEnvelope    *pose.ReviewAttestationEnvelope `json:\"envelope\"`\n  1422\t\t\t\tApply       bool                            `json:\"apply\"`\n  1423\t\t\t}\n  1424\t\t\tif err := json.Unmarshal(args, &a); err != nil {\n  1425\t\t\t\treturn nil, fmt.Errorf(\"pose_review_attest: invalid arguments\")\n  1426\t\t\t}\n  1427\t\t\tif a.Apply {\n  1428\t\t\t\tif a.Envelope == nil {\n  1429\t\t\t\t\treturn nil, fmt.Errorf(\"pose_review_attest: a review attestation over MCP is recorded only inside a trusted issuer's envelope (the proof `pose review attest --envelope` verifies); a reviewer or confirming principal written by an agent is a declaration, not a proof\")\n  1430\t\t\t\t}\n  1431\t\t\t\t// Refuse an untrusted envelope before the write guard discovers and\n  1432\t\t\t\t// leases the affected bundle roots. The guarded writer verifies it\n  1433\t\t\t\t// again against the bytes held through publication.\n  1434\t\t\t\tif _, err := store.VerifyReviewAttestationEnvelope(*a.Envelope); err != nil {\n  1435\t\t\t\t\treturn nil, err\n  1436\t\t\t\t}\n  1437\t\t\t\trecorded, err := store.RecordReviewAttestationEnvelope(*a.Envelope, true)\n  1438\t\t\t\tif err != nil {\n  1439\t\t\t\t\tvar durability *pose.PublishDurabilityError\n  1440\t\t\t\t\tif errors.As(err, &durability) && recorded.AttestationID != \"\" {\n  1441\t\t\t\t\t\tpersisted, readErr := store.LoadReviewAttestation(recorded.AttestationID)\n  1442\t\t\t\t\t\tif readErr == nil && persisted.BundleDigest == recorded.BundleDigest {\n  1443\t\t\t\t\t\t\treturn map[string]any{\"recorded\": true, \"attestation\": persisted, \"durability_confirmed\": false, \"warning\": durability.Error()}, nil\n  1444\t\t\t\t\t\t}\n  1445\t\t\t\t\t}\n  1446\t\t\t\t\treturn nil, err\n  1447\t\t\t\t}\n  1448\t\t\t\treturn map[string]any{\"recorded\": true, \"attestation\": recorded}, nil\n  1449\t\t\t}\n  1450\t\t\tif a.Envelope != nil {\n  1451\t\t\t\tverified, err := store.RecordReviewAttestationEnvelope(*a.Envelope, false)\n  1452\t\t\t\tif err != nil {\n  1453\t\t\t\t\treturn nil, err\n  1454\t\t\t\t}\n  1455\t\t\t\t// A verified signature is identity, not admissibility: report what\n  1456\t\t\t\t// the domain writer would refuse before apply is attempted.\n  1457\t\t\t\tblockers := store.PreflightReviewAttestation(verified, time.Now())\n  1458\t\t\t\tif blockers == nil {\n  1459\t\t\t\t\tblockers = []string{}\n  1460\t\t\t\t}\n  1461\t\t\t\treturn map[string]any{\"preview\": true, \"verified\": true, \"attestation\": verified, \"verify_blockers\": blockers, \"apply\": \"false (call again with the same envelope and apply: true to record it)\"}, nil\n  1462\t\t\t}\n  1463\t\t\tif a.Attestation == nil {\n  1464\t\t\t\treturn nil, fmt.Errorf(\"pose_review_attest: required argument %q missing\", \"attestation or envelope\")\n  1465\t\t\t}\n  1466\t\t\tcompleted, canonical, err := store.SignableReviewAttestation(*a.Attestation, time.Now())\n  1467\t\t\tif err != nil {\n  1468\t\t\t\treturn nil, err\n  1469\t\t\t}\n  1470\t\t\tblockers := store.PreflightReviewAttestation(completed, time.Now())\n  1471\t\t\tif blockers == nil {\n  1472\t\t\t\tblockers = []string{}\n  1473\t\t\t}\n  1474\t\t\treturn map[string]any{\n  1475\t\t\t\t\"preview\":         true,\n  1476\t\t\t\t\"attestation\":     completed,\n","exit_code":0,"status":"completed"}}
