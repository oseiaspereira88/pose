{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/cli/lintspec.go | sed -n '1185,1222p'; nl -ba pose-mcp/internal/pose/accepted_limits.go | sed -n '60,88p'; nl -ba pose-mcp/internal/pose/review_bundle.go | sed -n '4070,4090p'\"","aggregated_output":"  1185\t}\n  1186\t\n  1187\t// acceptedLimitsMissingFromADRs names each declared limit an ADR that cites\n  1188\t// the spec does not mention. With no ADR citing the spec nothing is required.\n  1189\tfunc acceptedLimitsMissingFromADRs(root, slug string, limits []posepkg.ReviewAcceptedLimit) []string {\n  1190\t\tentries, err := os.ReadDir(filepath.Join(root, \".pose\", \"adr\"))\n  1191\t\tif err != nil {\n  1192\t\t\treturn nil\n  1193\t\t}\n  1194\t\tvar citing []string\n  1195\t\tfor _, e := range entries {\n  1196\t\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".md\") {\n  1197\t\t\t\tcontinue\n  1198\t\t\t}\n  1199\t\t\traw, err := os.ReadFile(filepath.Join(root, \".pose\", \"adr\", e.Name()))\n  1200\t\t\tif err != nil || !strings.Contains(string(raw), slug) {\n  1201\t\t\t\tcontinue\n  1202\t\t\t}\n  1203\t\t\tciting = append(citing, string(raw))\n  1204\t\t}\n  1205\t\tif len(citing) == 0 {\n  1206\t\t\treturn nil\n  1207\t\t}\n  1208\t\tvar missing []string\n  1209\t\tfor _, l := range limits {\n  1210\t\t\tfound := false\n  1211\t\t\t// The id as a word: L10 does not name L1 (review round 1, N3).\n  1212\t\t\tnamed := regexp.MustCompile(`\\b` + regexp.QuoteMeta(l.ID) + `\\b`)\n  1213\t\t\tfor _, adr := range citing {\n  1214\t\t\t\tfound = found || named.MatchString(adr)\n  1215\t\t\t}\n  1216\t\t\tif !found {\n  1217\t\t\t\tmissing = append(missing, \"DoR: accepted limit \"+l.ID+\" is not named by the ADR that cites \"+slug)\n  1218\t\t\t}\n  1219\t\t}\n  1220\t\treturn missing\n  1221\t}\n    60\t\tin := false\n    61\t\tseen := map[string]bool{}\n    62\t\tfor _, line := range strings.Split(body, \"\\n\") {\n    63\t\t\ttrimmed := strings.TrimSpace(line)\n    64\t\t\tif strings.HasPrefix(trimmed, \"#\") {\n    65\t\t\t\tin = strings.EqualFold(strings.TrimSpace(strings.TrimLeft(trimmed, \"#\")), \"Accepted limits\") || strings.EqualFold(strings.TrimSpace(strings.TrimLeft(trimmed, \"#\")), \"Limites aceitos\")\n    66\t\t\t\tcontinue\n    67\t\t\t}\n    68\t\t\tif !in || !strings.HasPrefix(trimmed, \"- \") {\n    69\t\t\t\tcontinue\n    70\t\t\t}\n    71\t\t\tm := acceptedLimitRE.FindStringSubmatch(trimmed)\n    72\t\t\tif m == nil {\n    73\t\t\t\tproblems = append(problems, \"accepted limit \"+quoteLedgerText(trimmed)+\" is not written as '- L<N>: <assumption>. Accepted because <reason>.'\")\n    74\t\t\t\tcontinue\n    75\t\t\t}\n    76\t\t\tif seen[m[1]] {\n    77\t\t\t\tproblems = append(problems, \"accepted limit \"+m[1]+\" is declared twice\")\n    78\t\t\t\tcontinue\n    79\t\t\t}\n    80\t\t\tseen[m[1]] = true\n    81\t\t\tif !hasAcceptedLimitReason(m[2]) {\n    82\t\t\t\tproblems = append(problems, \"accepted limit \"+m[1]+\" does not say why it is accepted ('Accepted because ...')\")\n    83\t\t\t}\n    84\t\t\tlimits = append(limits, ReviewAcceptedLimit{ID: m[1], Text: strings.TrimSpace(m[2])})\n    85\t\t}\n    86\t\treturn limits, problems\n    87\t}\n    88\t\n  4070\t\t\t}\n  4071\t\t\tswitch finding.Disposition {\n  4072\t\t\tcase \"resolved\":\n  4073\t\t\tcase \"accepted-risk\", \"wont-fix\":\n  4074\t\t\t\t// Leaving a finding unresolved accepts its risk regardless of the\n  4075\t\t\t\t// disposition's spelling. Use the policy frozen into this bundle.\n  4076\t\t\t\tif !allowedRisk[finding.Severity] || finding.Owner == \"\" || finding.Rationale == \"\" || finding.ReviewBy == \"\" {\n  4077\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" has unapproved or incomplete accepted risk\")\n  4078\t\t\t\t}\n  4079\t\t\tcase \"within-limit\":\n  4080\t\t\t\t// Inside a limit the spec declared and the bundle sealed, whatever\n  4081\t\t\t\t// its severity; a limit the bundle did not seal accepts nothing\n  4082\t\t\t\t// (spec pose-review-declared-threat-model R3).\n  4083\t\t\t\tif !sealedAcceptedLimit(bundle, finding.Limit) {\n  4084\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" names accepted limit \"+firstNonempty(finding.Limit, \"(none)\")+\", which this bundle did not seal\")\n  4085\t\t\t\t} else if finding.Rationale == \"\" {\n  4086\t\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is within limit \"+finding.Limit+\" without saying why\")\n  4087\t\t\t\t}\n  4088\t\t\tcase \"open\", \"changes-requested\":\n  4089\t\t\t\tblockers = append(blockers, \"finding \"+finding.ID+\" is \"+finding.Disposition)\n  4090\t\t\tdefault:\n","exit_code":0,"status":"completed"}}
