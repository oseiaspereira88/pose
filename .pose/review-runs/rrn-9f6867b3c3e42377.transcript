l R2: the current brief lists the\n+// sealed accepted limits and says how a finding inside one is classified;\n+// /10 never did.\n+func TestTheCurrentBriefListsTheAcceptedLimits(t *testing.T) {\n+\tcurrent := renderReviewBriefBody(richBriefBundle(), ReviewBriefKindReview, reviewBriefTemplates[ReviewBriefKindReview], \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif !strings.Contains(current, \"## Accepted limits\") || !strings.Contains(current, \"- L1: A process that clears its environment escapes.\") || !strings.Contains(current, \"with `limit` set to its id\") {\n+\t\tt.Fatalf(\"the current brief does not list the accepted limits:\\n%s\", current)\n+\t}\n+\tearlier := renderReviewBriefBody(richBriefBundle(), ReviewBriefKindReview, reviewBriefTemplateFinishCommands, \"\", nil, &ReviewRound{Number: 1}, true, nil)\n+\tif strings.Contains(earlier, \"## Accepted limits\") {\n+\t\tt.Fatal(\"review-brief/10 changed under the runs briefed with it\")\n+\t}\n+}\ndiff --git a/pose-mcp/internal/pose/review_brief_test.go b/pose-mcp/internal/pose/review_brief_test.go\nindex fa231421..088b80b5 100644\n--- a/pose-mcp/internal/pose/review_brief_test.go\n+++ b/pose-mcp/internal/pose/review_brief_test.go\n@@ -32,9 +32,9 @@ func TestReviewBriefIsRenderedFromTheBundleDeterministically(t *testing.T) {\n \t}\n \tif first.Text != second.Text || first.Digest != second.Digest || !strings.HasPrefix(first.Digest, \"sha256:\") {\n \t\tt.Fatal(\"the same bundle rendered different briefs\")\n \t}\n-\tfor _, want := range []string{\"template: review-brief/7\", bundle.BundleID, bundle.BundleDigest, \"## Boundaries\", \"Do not change the repository\", \"Do not record an attestation\", \"## Criteria to answer\", \"## Sealed evidence\", \"brief-digest: \" + first.Digest} {\n+\tfor _, want := range []string{\"template: review-brief/11\", bundle.BundleID, bundle.BundleDigest, \"## Boundaries\", \"Do not change the repository\", \"Do not record an attestation\", \"## Criteria to answer\", \"## Sealed evidence\", \"brief-digest: \" + first.Digest} {\n \t\tif !strings.Contains(first.Text, want) {\n \t\t\tt.Fatalf(\"brief lacks %q:\\n%s\", want, first.Text)\n \t\t}\n \t}\ndiff --git a/pose-mcp/internal/pose/review_brief_versions_test.go b/pose-mcp/internal/pose/review_brief_versions_test.go\nindex 303d62cc..88b16a10 100644\n--- a/pose-mcp/internal/pose/review_brief_versions_test.go\n+++ b/pose-mcp/internal/pose/review_brief_versions_test.go\n@@ -53,8 +53,9 @@ func richBriefBundle() ReviewBundle {\n \t}}\n \tbundle.Payload.Plan.Tools = append(bundle.Payload.Plan.Tools, ReviewPlanTool{ID: \"assess-discover\", Component: \"core\", Requiredness: \"recommended\", Args: []string{\"pose\", \"assess\", \"discover\"}})\n \tbundle.Payload.Subject.Entries = append(bundle.Payload.Subject.Entries, ReviewBundleSubjectEntry{Action: \"renamed\", OldPath: \"core/old.go\", NewPath: \"core/new.go\", Class: \"source\", Reason: \"moved\"})\n \tbundle.Payload.Plan.Criteria = append(bundle.Payload.Plan.Criteria, ReviewPlanCriterion{ID: \"documentation\", Description: \"The docs say it.\", Required: false, Kind: ReviewCriterionKindMechanical})\n+\tbundle.Payload.Plan.AcceptedLimits = []ReviewAcceptedLimit{{ID: \"L1\", Text: \"A process that clears its environment escapes. Accepted because the shim covers it.\"}}\n \treturn bundle\n }\n \n // renderFixedBriefs renders a template every way a brief can differ: bare, with implementer\ndiff --git a/pose-mcp/internal/pose/testdata/review_brief_template_digests.json b/pose-mcp/internal/pose/testdata/review_brief_template_digests.json\nindex 0a913887..3e58cc9b 100644\n--- a/pose-mcp/internal/pose/testdata/review_brief_template_digests.json\n+++ b/pose-mcp/internal/pose/testdata/review_brief_template_digests.json\n@@ -1,9 +1,13 @@\n {\n   \"review-brief/1\": \"sha256:044c5e094cc0bc9f91268e64c8aa7af3c9e4a941b4d6516c7b2ed2e1b3a4de24\",\n+  \"review-brief/10\": \"sha256:7bc73ce9b27c5360350867235a0a458ff96c4409f14df58cfec0caa64d3992a4\",\n+  \"review-brief/11\": \"sha256:5604ca97964d38cadfa559e2f66f7c4636c43c91b705288e3797b97df9870250\",\n   \"review-brief/2\": \"sha256:de1a8d85203b31bbda2fe4441348abfde0c2bb6b466febdb1a88731c9dfc4d1f\",\n   \"review-brief/3\": \"sha256:36231de8df017908ea02753d257660316d8ffb57f02a4b9e217ec87e4f9fbbfd\",\n   \"review-brief/4\": \"sha256:f6f98745b15e24041ef42b55bf19e4850b72610223b7c7662356a6c4383ab4e9\",\n   \"review-brief/5\": \"sha256:3a8019cc31749e160d0d9b1d89a280581ca46eda48061db1ab5dd51a25bab3ce\",\n   \"review-brief/6\": \"sha256:cdfac24cfa83d18d44426f33213bece9a6b454d81b69a717666bb5cb84590082\",\n-  \"review-brief/7\": \"sha256:75bee416b983c24f93b2cc8cf97a46dd971386a9a025b3b8386a93af48f8be27\"\n+  \"review-brief/7\": \"sha256:75bee416b983c24f93b2cc8cf97a46dd971386a9a025b3b8386a93af48f8be27\",\n+  \"review-brief/8\": \"sha256:dcd7d088e3edab7fed949acc383a4828e4fead69c9de49e565f9c5d0e4cd9f3b\",\n+  \"review-brief/9\": \"sha256:a91b66fabcca7286fd0bda0722b48b9bccc8efde7aa90e496ee630dd34f19ab8\"\n }\n","exit_code":0,"status":"completed"}}
