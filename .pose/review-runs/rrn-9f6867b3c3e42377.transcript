{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba pose-mcp/internal/pose/review_bundle.go | sed -n '3840,3975p;2100,2165p' && rg -n \\\"sealReadinessBlockers|AcceptedLimits\\\" pose-mcp/internal/pose/review_bundle.go\"","aggregated_output":"  2100\tfunc (s Store) sealReviewBundleLead(ref, lead string, now time.Time) (ReviewBundle, error) {\n  2101\t\tidentity, warning, err := s.SealingIdentity(lead)\n  2102\t\tif err != nil {\n  2103\t\t\treturn ReviewBundle{}, err\n  2104\t\t}\n  2105\t\tif identity.Vendor == ImplementationUnknown {\n  2106\t\t\twarning = joinWarnings(warning, \"the seal records an unknown implementation vendor: no agent session was detected; seal from the implementing session or declare it with --lead\")\n  2107\t\t} else if identity.ExecutionDigest == \"\" {\n  2108\t\t\twarning = joinWarnings(warning, \"the seal names no implementation execution (no \"+identity.Vendor+\" session reference in the environment), so a review that must prove a different actor cannot be attested against it\")\n  2109\t\t}\n  2110\t\treturn s.sealReviewBundle(ref, &identity, lead != \"\", warning, now)\n  2111\t}\n  2112\t\n  2113\t// sealReviewBundle seals ref recording identity; declared reseals content a\n  2114\t// bundle already holds when that bundle records another identity. A nil\n  2115\t// identity seals the way bundles were sealed before they recorded one, which\n  2116\t// only the tests of the legacy reading need.\n  2117\tfunc (s Store) sealReviewBundle(ref string, identity *ReviewBundleImplementation, declared bool, warning string, now time.Time) (ReviewBundle, error) {\n  2118\t\tbundle, err := s.PrepareReviewBundle(ref)\n  2119\t\tif err != nil {\n  2120\t\t\treturn ReviewBundle{}, err\n  2121\t\t}\n  2122\t\tif len(bundle.Blockers) > 0 {\n  2123\t\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", strings.Join(bundle.Blockers, \"; \"))\n  2124\t\t}\n  2125\t\tsealed, err := s.ListReviewBundles(bundle.Payload.Scope.Ref)\n  2126\t\tif err != nil {\n  2127\t\t\treturn ReviewBundle{}, err\n  2128\t\t}\n  2129\t\t// Content a sealed bundle already holds keeps the bundle that governs it,\n  2130\t\t// unless a declared identity names another: then the new seal replaces\n  2131\t\t// that bundle's identity by name, so it governs whatever the seal instants\n  2132\t\t// say, and a historical identity declared again is a new seal, never the\n  2133\t\t// historical bundle handed back (spec pose-delegation-routing D3).\n  2134\t\tif governing := governingSealedBundle(sealed, bundle); governing != nil {\n  2135\t\t\tif !declared || identity == nil || governing.Payload.Implementation != nil && sameImplementation(*governing.Payload.Implementation, *identity) {\n  2136\t\t\t\treturn *governing, nil\n  2137\t\t\t}\n  2138\t\t\treplaced := *identity\n  2139\t\t\treplaced.Replaces = governing.BundleID\n  2140\t\t\tidentity = &replaced\n  2141\t\t}\n  2142\t\tif blockers := s.sealReadinessBlockers(bundle); len(blockers) > 0 {\n  2143\t\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", strings.Join(blockers, \"; \"))\n  2144\t\t}\n  2145\t\t// A bundle already sealed reads as it was; a new seal holds a validation result,\n  2146\t\t// whatever the lifecycle of the scope says.\n  2147\t\tif !holdsValidationResult(bundle.Payload.Evidence) {\n  2148\t\t\tscope, err := ParseScopeRef(bundle.Payload.Scope.Ref)\n  2149\t\t\tif err != nil {\n  2150\t\t\t\treturn ReviewBundle{}, err\n  2151\t\t\t}\n  2152\t\t\tgraph, err := s.GetDeliveryIntegrity(\"\")\n  2153\t\t\tif err != nil {\n  2154\t\t\t\treturn ReviewBundle{}, err\n  2155\t\t\t}\n  2156\t\t\tif s.reviewScopeRequiresValidationEvidence(scope, bundle.Payload.Plan, graph) {\n  2157\t\t\t\treturn bundle, fmt.Errorf(\"pose: review bundle is not sealable: %s\", noValidationEvidenceBlocker)\n  2158\t\t\t}\n  2159\t\t}\n  2160\t\tif identity != nil {\n  2161\t\t\tbundle.Payload.Implementation = identity\n  2162\t\t\tdigest, err := reviewBundlePayloadDigest(bundle.Payload)\n  2163\t\t\tif err != nil {\n  2164\t\t\t\treturn ReviewBundle{}, err\n  2165\t\t\t}\n  3840\t\tif policyErr != nil {\n  3841\t\t\tblockers = append(blockers, policyErr.Error())\n  3842\t\t}\n  3843\t\tif strings.Join(att.Limitations, \"\\x00\") != strings.Join(bundle.Payload.Plan.Limitations, \"\\x00\") {\n  3844\t\t\tblockers = append(blockers, \"attestation does not retain the sealed review limitations\")\n  3845\t\t}\n  3846\t\tif att.BundleDigest != bundle.BundleDigest || att.BundleID != bundle.BundleID {\n  3847\t\t\tblockers = append(blockers, \"attestation does not reference the exact sealed bundle\")\n  3848\t\t}\n  3849\t\t// The one gate that stays live, deliberately. Everything else a bundle is\n  3850\t\t// judged by is sealed with it, because a setting flipped today must not\n  3851\t\t// re-judge a review recorded years ago. Signing is the opposite case: a\n  3852\t\t// project that starts requiring signed attestations is raising a bar, and a\n  3853\t\t// bundle sealed before that must not be permanently exempt from it — the\n  3854\t\t// exemption would be exactly the work an attacker or a hurry would want\n  3855\t\t// (spec pose-reuse-is-sealed-signing-stays-live).\n  3856\t\t// Verified authority checks the signature in the shared proof path below,\n  3857\t\t// also used by disclosure. Declared records retain their signing gate.\n  3858\t\tif bundle.Payload.SealedGates().IdentityAssurance != ReviewIdentityAssuranceVerified && (policy.RequireSignedAttestations || att.Envelope != nil) {\n  3859\t\t\tif err := s.verifyStoredReviewAttestationSignature(att); err != nil {\n  3860\t\t\t\tblockers = append(blockers, err.Error())\n  3861\t\t\t}\n  3862\t\t}\n  3863\t\tif _, err := time.Parse(time.RFC3339, att.AttestedAt); err != nil {\n  3864\t\t\tblockers = append(blockers, \"attested_at must be RFC3339\")\n  3865\t\t}\n  3866\t\tif !strings.HasPrefix(att.Reviewer, \"agent:\") && !strings.HasPrefix(att.Reviewer, \"human:\") {\n  3867\t\t\tblockers = append(blockers, \"reviewer execution identity is malformed\")\n  3868\t\t}\n  3869\t\tif err := ValidateReviewAttribution(att); err != nil {\n  3870\t\t\tblockers = append(blockers, strings.TrimPrefix(err.Error(), \"pose: \"))\n  3871\t\t}\n  3872\t\t// Two axes, kept apart. Independence says what separation the review\n  3873\t\t// requires; assurance says whether the reviewer's identity is read from the\n  3874\t\t// string they wrote or from an authority an authorized issuer signed.\n  3875\t\t//\n  3876\t\t// Under `declared` this is the prefix check it always was, and the warning\n  3877\t\t// beside it stops the enum being read as proof: `agent:independent-anything`\n  3878\t\t// satisfies `different-actor`, and `human:` satisfies `mandatory-human`,\n  3879\t\t// because nothing here compares a principal, a session or a grant\n  3880\t\t// (spec pose-abm-review-authority).\n  3881\t\tif att.Run != nil {\n  3882\t\t\tblockers = append(blockers, s.runBackedReviewBlockers(bundle, att)...)\n  3883\t\t} else if (policy.DelegatedReview || bundle.Payload.Plan.DelegatedRunProofRequired) && strings.HasPrefix(att.Reviewer, \"agent:\") && bundle.Payload.Plan.Independence == \"different-actor\" {\n  3884\t\t\tblockers = append(blockers, \"delegated-review requires a signed run reference; reviewer prefix does not prove independence\")\n  3885\t\t} else {\n  3886\t\t\tswitch bundle.Payload.SealedGates().IdentityAssurance {\n  3887\t\t\tcase ReviewIdentityAssuranceVerified:\n  3888\t\t\t\tblockers = append(blockers, s.verifiedAuthorityBlockers(bundle, att)...)\n  3889\t\t\tdefault:\n  3890\t\t\t\tswitch bundle.Payload.Plan.Independence {\n  3891\t\t\t\tcase \"different-actor\":\n  3892\t\t\t\t\tif !strings.HasPrefix(att.Reviewer, \"agent:independent-\") && !strings.HasPrefix(att.Reviewer, \"human:\") {\n  3893\t\t\t\t\t\tblockers = append(blockers, \"review policy requires a different-actor reviewer identity; under declared assurance that is read from the reviewer prefix, not authenticated\")\n  3894\t\t\t\t\t}\n  3895\t\t\t\tcase \"mandatory-human\":\n  3896\t\t\t\t\tif !strings.HasPrefix(att.Reviewer, \"human:\") {\n  3897\t\t\t\t\t\tblockers = append(blockers, \"review policy requires human approval\")\n  3898\t\t\t\t\t}\n  3899\t\t\t\t}\n  3900\t\t\t}\n  3901\t\t}\n  3902\t\treturn append(blockers, s.attestationContentBlockers(bundle, att, skipEvidenceSupport)...)\n  3903\t}\n  3904\t\n  3905\t// attestationContentBlockers judges what an attestation says about its bundle,\n  3906\t// apart from who signed it: criteria, mappings, findings, evidence and tools.\n  3907\t// It is the part a reviewer's draft can be checked against before the run\n  3908\t// ends (spec pose-review-readiness-before-seal R3).\n  3909\tfunc (s Store) attestationContentBlockers(bundle ReviewBundle, att ReviewAttestation, skipEvidenceSupport bool) []string {\n  3910\t\tblockers := []string{}\n  3911\t\trequired := map[string]ReviewPlanCriterion{}\n  3912\t\tfor _, criterion := range bundle.Payload.Plan.Criteria {\n  3913\t\t\tif criterion.Required {\n  3914\t\t\t\trequired[criterion.ID] = criterion\n  3915\t\t\t}\n  3916\t\t}\n  3917\t\t// The findings this attestation records, so a criterion disposed as\n  3918\t\t// `finding` can be checked against them. The CLI parser already refused a\n  3919\t\t// criterion naming a finding it does not record; the Store did not, so any\n  3920\t\t// other caller — a Store client, a signed import, a reuse — could approve a\n  3921\t\t// criterion that explicitly did not pass while filing nothing. A signature\n  3922\t\t// authenticates bytes; it does not repair a reference to something that\n  3923\t\t// does not exist (spec pose-abm-review-soundness).\n  3924\t\trecordedFindings := map[string]bool{}\n  3925\t\tfor _, finding := range att.Findings {\n  3926\t\t\trecordedFindings[finding.ID] = true\n  3927\t\t}\n  3928\t\tsealedClasses := map[string]bool{}\n  3929\t\tfor _, ev := range bundle.Payload.Evidence {\n  3930\t\t\tsealedClasses[ev.EvidenceClass] = true\n  3931\t\t}\n  3932\t\tjudgmentGoverned, _ := BundleGovernedBy(bundle, \"explicit-judgment\")\n  3933\t\tif structuralGoverned, _ := BundleGovernedBy(bundle, \"structural-causality\"); structuralGoverned {\n  3934\t\t\tblockers = append(blockers, s.reviewStructuralCausalityBlockers(bundle.Payload.Scope.Ref, bundle.Payload.Plan.Structure, required, att.Criteria)...)\n  3935\t\t}\n  3936\t\tif closeoutGoverned, _ := BundleGovernedBy(bundle, CausalityCloseoutContract); closeoutGoverned {\n  3937\t\t\tblockers = append(blockers, s.reviewCausalityCloseoutBlockers(bundle.Payload.Scope.Ref, bundle.Payload.Plan.Structure, bundle.Payload.Plan.Band, required, att.Criteria)...)\n  3938\t\t}\n  3939\t\t// Validation evidence can be required by implementation components even\n  3940\t\t// when no delivery target is declared. A target-gated tool must use the\n  3941\t\t// sealed declaration, not the broader evidence requirement.\n  3942\t\thasDeliveryTarget := len(bundle.Payload.Scope.Deliveries) > 0\n  3943\t\tif bundle.Payload.Scope.Kind != \"spec\" {\n  3944\t\t\ttoolScope, _ := ParseScopeRef(bundle.Payload.Scope.Ref)\n  3945\t\t\ttoolGraph, _ := s.GetDeliveryIntegrity(\"\")\n  3946\t\t\thasDeliveryTarget = s.reviewScopeRequiresValidationEvidence(toolScope, bundle.Payload.Plan, toolGraph)\n  3947\t\t}\n  3948\t\tseen := map[string]bool{}\n  3949\t\tnotApplicable := 0\n  3950\t\tfor _, criterion := range att.Criteria {\n  3951\t\t\tif seen[criterion.ID] {\n  3952\t\t\t\tblockers = append(blockers, \"duplicate criterion \"+criterion.ID)\n  3953\t\t\t}\n  3954\t\t\tseen[criterion.ID] = true\n  3955\t\t\tplanned, known := required[criterion.ID]\n  3956\t\t\tif !known {\n  3957\t\t\t\tblockers = append(blockers, \"unknown criterion \"+criterion.ID)\n  3958\t\t\t}\n  3959\t\t\tif criterion.Disposition != \"passed\" && criterion.Disposition != \"not-applicable\" && criterion.Disposition != \"finding\" {\n  3960\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" has invalid disposition\")\n  3961\t\t\t}\n  3962\t\t\tif criterion.Disposition == \"not-applicable\" {\n  3963\t\t\t\tnotApplicable++\n  3964\t\t\t\tif criterion.Rationale == \"\" {\n  3965\t\t\t\t\tblockers = append(blockers, \"criterion \"+criterion.ID+\" lacks not-applicable rationale\")\n  3966\t\t\t\t}\n  3967\t\t\t\t// Inapplicability and absence are different states, and only one of\n  3968\t\t\t\t// them is an answer. A criterion that asks for a class the bundle\n  3969\t\t\t\t// actually seals is applicable by construction: dispensing with it\n  3970\t\t\t\t// would be reading missing judgment as missing relevance.\n  3971\t\t\t\t//\n  3972\t\t\t\t// Gated, unlike the finding-reference rule beside it. That one is\n  3973\t\t\t\t// referential integrity — a criterion naming a finding nobody filed\n  3974\t\t\t\t// is incomplete under any policy, and no stored record does it. This\n  3975\t\t\t\t// one is a stricter judgment default, and 12 of the 499 attestations\n122:\t// AcceptedLimits seals the residual limits the scope's spec declares, so\n126:\tAcceptedLimits []ReviewAcceptedLimit `json:\"accepted_limits,omitempty\"`\n523:\tbundle.Payload.Plan = ReviewBundlePlan{DelegatedRunProofRequired: plan.DelegatedRunProofRequired, Limitations: append([]string(nil), plan.Limitations...), PlanDigest: bundlePlanDigest, Independence: plan.Independence, Components: append([]ReviewPlanComponent{}, plan.Components...), Criteria: append([]ReviewPlanCriterion{}, plan.Criteria...), Tools: append([]ReviewPlanTool{}, plan.Tools...), SelectedProfiles: append([]ReviewPlanProfile{}, plan.SelectedProfiles...), Structure: plan.Structure, CloseoutReview: plan.CloseoutReview, AcceptedLimits: append([]ReviewAcceptedLimit(nil), plan.AcceptedLimits...)}\n2142:\tif blockers := s.sealReadinessBlockers(bundle); len(blockers) > 0 {\n","exit_code":0,"status":"completed"}}
