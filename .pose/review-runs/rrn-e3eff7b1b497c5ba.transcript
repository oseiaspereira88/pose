t HEAD below the repository top is not a new transition. N2–N6: the redaction is withdrawn (D1). N7: scope selection runs its diff with `--relative`. `TestReadyTransitionsSeeSpecsBelowTheRepositoryTop` and `TestTheReportStatesNoPath` fail with `HEAD:./`, `--relative` or the note mutated.\n - 2026-11-27: review round 2 (rrn-3dba382397f270c7) requested changes: `--relative` dropped changes outside the root, narrowing validation (N1). Withdrawn: the diff names changes from the repository top, and each is named from the root (`scopeRootRelative`): inside it without the prefix, outside it as `../<name>`, a change outside every module that selects the root. The test changes a tracked file at the top and fails with either branch mutated out. N3: R3 and R5 no longer name the removed note bound, and the bounded-note assertion is gone. N4: the report warning test requires Git's message. N2 is a follow-up.\n+- 2026-11-27: review round 3 (rrn-c3a4b1c0fd2bd2d6) requested changes: `diff.relative=true` in the configuration made the diff root-relative, so the new naming misplaced changes (N1); the diff now pins `diff.relative=false`. N2: the root prefix keeps a leading space and a failed lookup fails the selection. N3: a change outside the root is named by its relative path from the root, also for a root two levels down. N5: stale comments fixed. `TestReadyTransitionsSeeSpecsBelowTheRepositoryTop` (with `diff.relative=true`) and `TestScopeSelectionBelowADirectoryWithALeadingSpace` fail with the pin or the prefix rule mutated. N4 is a follow-up.\n \n ### Results summary\n The full `pose-mcp` suite passes; the canonical result is refreshed with `pose validate --carry`.\n \n ### Requirement trace\n-- R1 [satisfied] test:TestReadyTransitionsSeeSpecsBelowTheRepositoryTop\n+- R1 [satisfied] test:TestReadyTransitionsSeeSpecsBelowTheRepositoryTop, test:TestScopeSelectionBelowADirectoryWithALeadingSpace\n - R2 [satisfied] test:TestTheReportStatesNoPath\n - R3 [satisfied] test:TestBoundsCutAtACharacter\n - R4 [satisfied] test:TestScopeSelectionReportsAFailedUntrackedListing\n@@ -141,3 +142,4 @@ L1 above.\n ### Follow-ups\n Origin: `pose-validate-read-only-index-followups` (done 2026-11-27).\n - [open] Name carry exclusions and the `show <head>:<path>` reads of carry from the root, as scope selection now does, for when carry runs below the repository top (review round 2, N2). (owner:@pose-maintainers crit:low review:2026-12-27)\n+- [open] List untracked files outside the root when the root is below the repository top, as tracked changes outside it now are (review round 3, N4; pre-existing). (owner:@pose-maintainers crit:low review:2026-12-27)\ndiff --git a/pose-mcp/internal/cli/report.go b/pose-mcp/internal/cli/report.go\nindex 16594b7d..d3522546 100644\n--- a/pose-mcp/internal/cli/report.go\n+++ b/pose-mcp/internal/cli/report.go\n@@ -299,10 +299,9 @@ func readLastReportRecord(path string) *reportRecord {\n \n // reportChangedFilesNoted is reportChangedFiles for the report: outside a\n // repository Git can open at all the plain listing stays silent, as before\n-// (review round 1, N9; round 3, N19);\n-// any other failure is returned to warn about, with Git's message, while the\n-// list states only that it could not be read (spec\n-// pose-validate-index-reads-residuals D1).\n+// (review round 1, N9; round 3, N19); any other failure is returned to warn\n+// about, with Git's message, while the list states only that it could not be\n+// read (spec pose-validate-index-reads-residuals D1).\n func reportChangedFilesNoted(root, since string, locale cliLocale) ([]string, error) {\n \tfiles, err := reportChangedFiles(root, since)\n \tif err == nil {\ndiff --git a/pose-mcp/internal/cli/validate_index_residuals_test.go b/pose-mcp/internal/cli/validate_index_residuals_test.go\nindex c15e622a..f2a1a901 100644\n--- a/pose-mcp/internal/cli/validate_index_residuals_test.go\n+++ b/pose-mcp/internal/cli/validate_index_residuals_test.go\n@@ -101,6 +101,22 @@ func TestReadyTransitionsSeeSpecsBelowTheRepositoryTop(t *testing.T) {\n \tif err != nil || !strings.Contains(strings.Join(sel.Changed, \",\"), \"../outside.txt\") {\n \t\tt.Fatalf(\"a change outside the root vanished: %v %v\", sel.Changed, err)\n \t}\n+\t// Review round 3, N1: diff.relative in the configuration changes nothing.\n+\tif out, err := exec.Command(\"git\", \"-C\", top, \"config\", \"diff.relative\", \"true\").CombinedOutput(); err != nil {\n+\t\tt.Fatal(err, string(out))\n+\t}\n+\tsel, err = computeChangedScopeWith(root, \"HEAD~2\", \"HEAD\", nil, scopeMetadata{})\n+\tif err != nil || strings.Contains(strings.Join(sel.Changed, \",\"), \"../x.txt\") || !strings.Contains(strings.Join(sel.Changed, \",\"), \"x.txt\") {\n+\t\tt.Fatalf(\"diff.relative changed the names: %v %v\", sel.Changed, err)\n+\t}\n+\t// Review round 3, N3: outside a root two levels down, the name is the\n+\t// relative path from the root.\n+\tif got := scopeRootRelative(\"a/b/\", \"a/c/f.txt\"); got != \"../c/f.txt\" {\n+\t\tt.Fatalf(\"a change beside a deeper root: %s\", got)\n+\t}\n+\tif got := scopeRootRelative(\" sp/\", \" sp/x.txt\"); got != \"x.txt\" {\n+\t\tt.Fatalf(\"a root whose name starts with a space: %s\", got)\n+\t}\n }\n \n // R2: the versioned report carries no message of Git, so no path of the\n@@ -131,8 +147,8 @@ func TestScopeSelectionReportsAFailedUntrackedListing(t *testing.T) {\n \t}\n }\n \n-// R5: the check runs its diff in English; the report bounds its note and\n-// warns on standard error; an X^- base is resolved by its revision.\n+// R5: the check runs its listing in English; the report warns on standard\n+// error with Git's message; an X^- base is resolved by its revision.\n func TestTheRemainingIndexReadGuards(t *testing.T) {\n \troot, _ := staleIndexRepo(t)\n \tt.Setenv(\"LC_ALL\", \"pt_BR.UTF-8\")\n@@ -159,3 +175,29 @@ func TestTheRemainingIndexReadGuards(t *testing.T) {\n \t\tt.Fatalf(\"an X^- base whose read failed was taken for an unknown revision: %v\", err)\n \t}\n }\n+\n+// Review round 3, N2: a root below a directory whose name starts with a space\n+// keeps its prefix whole, so its changes are named from it.\n+func TestScopeSelectionBelowADirectoryWithALeadingSpace(t *testing.T) {\n+\ttop := t.TempDir()\n+\troot := filepath.Join(top, \" sp\")\n+\tif err := os.MkdirAll(root, 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfile := filepath.Join(root, \"x.txt\")\n+\tif err := os.WriteFile(file, []byte(\"x\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor _, args := range [][]string{{\"init\", \"-q\"}, {\"add\", \"-A\"}, {\"-c\", \"user.name=t\", \"-c\", \"user.email=t@t\", \"commit\", \"-q\", \"-m\", \"i\"}} {\n+\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", top}, args...)...).CombinedOutput(); err != nil {\n+\t\t\tt.Fatal(args, err, string(out))\n+\t\t}\n+\t}\n+\tif err := os.WriteFile(file, []byte(\"changed\\n\"), 0o644); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tsel, err := computeChangedScopeWith(root, \"HEAD\", \"\", nil, scopeMetadata{})\n+\tif err != nil || len(sel.Changed) != 1 || sel.Changed[0] != \"x.txt\" {\n+\t\tt.Fatalf(\"a root below a leading-space directory: %v %v\", sel.Changed, err)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/validate_scope.go b/pose-mcp/internal/cli/validate_scope.go\nindex 3684d7f8..99563768 100644\n--- a/pose-mcp/internal/cli/validate_scope.go\n+++ b/pose-mcp/internal/cli/validate_scope.go\n@@ -99,7 +99,9 @@ func computeChangedScopeWith(root, base, head string, modules []validationModule\n \t// keeps its owner, and a rename names both its source and its destination\n \t// (review round 2, N1 and N3).\n \t// Configuration never hides a changed gitlink (review round 8, N23).\n-\tgitArgs := []string{\"-C\", root, \"-c\", \"diff.ignoreSubmodules=none\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"-z\", \"--no-renames\", base}\n+\t// diff.relative=false: the names are read as top-relative below\n+\t// (review round 3, N1).\n+\tgitArgs := []string{\"-C\", root, \"-c\", \"diff.ignoreSubmodules=none\", \"-c\", \"diff.relative=false\", \"diff\", \"--ignore-submodules=none\", \"--name-only\", \"-z\", \"--no-renames\", base}\n \tif head != \"\" {\n \t\tgitArgs = append(gitArgs, head)\n \t}\n@@ -114,7 +116,10 @@ func computeChangedScopeWith(root, base, head string, modules []validationModule\n \t// change inside the root is named from the root, so its module owns it,\n \t// and one outside stays a change outside every module, which selects the\n \t// root, never nothing (review rounds 1 N7, 2 N1).\n-\tprefix := scopeRootPrefix(root)\n+\tprefix, err := scopeRootPrefix(root)\n+\tif err != nil {\n+\t\treturn sel, fmt.Errorf(\"scope selection over %s: %v\", sel.rangeLabel(), err)\n+\t}\n \tfor _, name := range strings.Split(string(out), \"\\x00\") {\n \t\tif name != \"\" {\n \t\t\tsel.Changed = append(sel.Changed, scopeRootRelative(prefix, filepath.ToSlash(name)))\n@@ -314,17 +319,25 @@ func scopeRevisions(base, head string) []string {\n }\n \n // scopeRootPrefix is the root's path from the repository top, with a trailing\n-// slash, or \"\" at the top.\n-func scopeRootPrefix(root string) string {\n-\tout, err := posemodel.RawGit(\"-C\", root, \"rev-parse\", \"--show-prefix\").Output()\n+// slash, or \"\" at the top. Only the newline Git ends it with is removed, so a\n+// directory named with spaces keeps them; a failure fails the selection\n+// rather than misnaming every change (review round 3, N2).\n+func scopeRootPrefix(root string) (string, error) {\n+\tcmd := posemodel.RawGit(\"-C\", root, \"rev-parse\", \"--show-prefix\")\n+\tposemodel.GitEnglish(cmd)\n+\tvar stderr bytes.Buffer\n+\tcmd.Stderr = &stderr\n+\tout, err := cmd.Output()\n \tif err != nil {\n-\t\treturn \"\"\n+\t\treturn \"\", posemodel.GitReadError(\"git rev-parse --show-prefix\", err, stderr.Bytes())\n \t}\n-\treturn strings.TrimSpace(string(out))\n+\treturn strings.TrimSuffix(string(out), \"\\n\"), nil\n }\n \n // scopeRootRelative names a top-relative path from the root: inside it\n-// without the prefix, outside it as ../ plus its top-relative name.\n+// without the prefix; outside it as the relative path from the root (../ as\n+// many times as the root is deep), a change outside every module of the\n+// root, which selects the root (review rounds 2 N1, 3 N3).\n func scopeRootRelative(prefix, name string) string {\n \tif prefix == \"\" {\n \t\treturn name\n@@ -332,5 +345,9 @@ func scopeRootRelative(prefix, name string) string {\n \tif rest, ok := strings.CutPrefix(name, prefix); ok {\n \t\treturn rest\n \t}\n-\treturn \"../\" + name\n+\trel, err := filepath.Rel(filepath.FromSlash(strings.TrimSuffix(prefix, \"/\")), filepath.FromSlash(name))\n+\tif err != nil {\n+\t\treturn \"../\" + name\n+\t}\n+\treturn filepath.ToSlash(rel)\n }","is_error":false}]},"parent_tool_use_id":null,"session_id":"[private-session]","uuid":"e0839172-fef0-476c-bb14-ecdb5ce6434e","timestamp":"2026-11-27T20:25:47.335Z","tool_use_result":{"stdout":"0cad568a chore(pose): bind the ires matrix to its review\nf7cbff7a chore(pose): index the ires matrix\ndedf273a chore(pose): record the ires matrix\n70dc24f6 chore(pose): index the ires round r4 fixes\n8743d6c5 fix(pose): pin diff.relative, keep the root prefix whole, name outside changes by their relative path\n791abf59 chore(pose): record review round 3 of the index-reads residuals\n1d651553 chore(pose): index the ires binding\ndiff --git a/.pose/specs/2026-11-27-pose-validate-index-reads-residuals.md b/.pose/specs/2026-11-27-pose-validate-index-reads-residuals.md\nindex eb80566d..e17f6f96 100644\n--- a/.pose/specs/2026-11-27-pose-validate-index-reads-residuals.md\n+++ b/.pose/specs/2026-11-27-pose-validate-index-reads-residuals.md\n@@ -110,12 +110,13 @@ Each requirement gets a regression test shown failing before its code.\n - 2026-11-27: R1 adds `--relative` to the ready-transition diff; R2 replaces the root, repository top, Git directories, temporary and home directories whole 