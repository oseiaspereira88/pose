{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 9d495d5024c94dfbd7d81f5943576fba20b8b290 5690b25710615f5b0f9aba1f2642eaa6a917ccd9 -- pose-mcp/internal/pose/closeout_review_policy.go pose-mcp/internal/cli/review_closeout.go pose-mcp/internal/pose/closeout_adr_associations.go'","aggregated_output":"diff --git a/pose-mcp/internal/cli/review_closeout.go b/pose-mcp/internal/cli/review_closeout.go\nindex 95be9cc1..22bfa902 100644\n--- a/pose-mcp/internal/cli/review_closeout.go\n+++ b/pose-mcp/internal/cli/review_closeout.go\n@@ -2457,32 +2457,30 @@ func closeoutReceiptPreflight(store posemodel.Store, ref string, scope posemodel\n \t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n \t\t\treturn nil, 1\n \t\t}\n+\t\t// The gates the close passed are verified again, independently of the\n+\t\t// policy: a receipt does not stand for a gate that no longer holds.\n+\t\tif blocker := closeGateBlocker(store.Root, scope); blocker != \"\" {\n+\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + blocker)\n+\t\t\treturn nil, 1\n+\t\t}\n \t\treceipt := state.CloseoutReceipt\n \t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; closeout receipt of \"+receipt.ClosedAt+\" stands (review: \"+receipt.Review+\"); applicable terminal verifier passed; no transition executed\")\n \t\treturn nil, 0\n \t}\n \tdecision := state.Review.CloseoutReview\n \tif decision == nil {\n-\t\tif scope.Kind != \"roadmap\" || !state.LifecycleDone {\n-\t\t\treturn nil, -1\n-\t\t}\n-\t\trecovered, exempt, err := store.CloseoutRecoveryDecision(ref)\n-\t\tif err != nil {\n-\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + err.Error())\n-\t\t\treturn nil, 1\n-\t\t}\n-\t\tif recovered.Required && !state.Review.Approved {\n-\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + ref + \" is done without a receipt and owes an approved review (\" + recovered.PolicyKey + \"=\" + recovered.PolicyValue + \", \" + recovered.Reason + \"); next action: \" + state.NextAction)\n-\t\t\treturn nil, 1\n-\t\t}\n-\t\tif !recovered.Required && !exempt && !state.Review.Approved {\n-\t\t\trender(io.Discard, stderr).Failure(\"pose close: \" + ref + \" has a review on file that is not approved; it stands until remediated\")\n-\t\t\treturn nil, 1\n-\t\t}\n-\t\tdecision = &recovered\n-\t\tif exempt {\n-\t\t\tstate.Review.CloseoutReview, state.Review.Required = decision, false\n+\t\t// No decision: a scope of a roadmap closed before adoption, verified by\n+\t\t// the contract it was sealed under. It never gets a receipt; for a done\n+\t\t// roadmap the close is a read-only verification.\n+\t\tif scope.Kind == \"roadmap\" && state.LifecycleDone {\n+\t\t\tif !state.Terminal {\n+\t\t\t\trender(io.Discard, stderr).Failure(\"pose close: terminal verification blocked: \" + strings.Join(state.Blockers, \"; \") + \"; \" + state.NextAction)\n+\t\t\t\treturn nil, 1\n+\t\t\t}\n+\t\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; closed before the closeout review policy was adopted; its sealed contract verifies; no transition executed\")\n+\t\t\treturn nil, 0\n \t\t}\n+\t\treturn nil, -1\n \t}\n \tif !decision.Known {\n \t\trender(io.Discard, stderr).Failure(\"pose close: the closeout review of \" + ref + \" cannot be decided: \" + strings.Join(decision.Diagnostics, \"; \"))\n@@ -2575,3 +2573,24 @@ func onlyLifecycleBlockers(blockers []string) bool {\n \t}\n \treturn true\n }\n+\n+// closeGateBlocker runs the gate the close of an aggregate scope passed: the\n+// milestone gate, or the roadmap check with its cut criteria.\n+func closeGateBlocker(root string, scope posemodel.ScopeRef) string {\n+\tswitch scope.Kind {\n+\tcase \"milestone\":\n+\t\tgate, err := roadmapGate(root, scope.Roadmap, scope.Milestone)\n+\t\tif err != nil {\n+\t\t\treturn \"milestone gate failed: \" + err.Error()\n+\t\t}\n+\t\tif blockers := uniqueCLIStrings(gate.blockers); len(blockers) > 0 {\n+\t\t\treturn \"milestone gate failed: \" + strings.Join(blockers, \"; \")\n+\t\t}\n+\tcase \"roadmap\":\n+\t\tvar gateOut, gateErr bytes.Buffer\n+\t\tif code := cmdRoadmapCheck(root, []string{scope.Slug, \"--strict\"}, &gateOut, &gateErr); code != 0 {\n+\t\t\treturn \"roadmap gate failed: \" + strings.TrimSpace(gateErr.String()+gateOut.String())\n+\t\t}\n+\t}\n+\treturn \"\"\n+}\ndiff --git a/pose-mcp/internal/pose/closeout_adr_associations.go b/pose-mcp/internal/pose/closeout_adr_associations.go\nindex 38051a34..eaf946c0 100644\n--- a/pose-mcp/internal/pose/closeout_adr_associations.go\n+++ b/pose-mcp/internal/pose/closeout_adr_associations.go\n@@ -138,7 +138,7 @@ func (s Store) closeoutADRAssociations(rm *Roadmap, project string) ([]string, [\n \t\t// Every candidate is read, the associated ones included: its size,\n \t\t// its readability and its own declaration are inputs. One that\n \t\t// cannot be read could hold a backlink, so it is unknown.\n-\t\tif entry.IsDir() || !strings.HasSuffix(name, \".md\") || strings.EqualFold(name, \"README.md\") && !found[name] {\n+\t\tif entry.IsDir() || !strings.HasSuffix(name, \".md\") {\n \t\t\tcontinue\n \t\t}\n \t\tif err := s.regularADR(name); err != nil {\n@@ -167,7 +167,14 @@ func (s Store) closeoutADRAssociations(rm *Roadmap, project string) ([]string, [\n \t\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %q, not roadmap:<slug>\", name, item))\n \t\t\t\t\t\tcontinue\n \t\t\t\t\t}\n-\t\t\t\t\tif ref.Slug == rm.Slug && (ref.Project == \"\" || ref.Project == project) {\n+\t\t\t\t\tif ref.Project != \"\" && ref.Project != project {\n+\t\t\t\t\t\tcontinue // a roadmap of another project: not this association\n+\t\t\t\t\t}\n+\t\t\t\t\tif _, err := s.GetRoadmap(ref.Slug); err != nil {\n+\t\t\t\t\t\tdiagnostics = append(diagnostics, fmt.Sprintf(\"ADR %s declares %s, which names no roadmap of this project\", name, item))\n+\t\t\t\t\t\tcontinue\n+\t\t\t\t\t}\n+\t\t\t\t\tif ref.Slug == rm.Slug {\n \t\t\t\t\t\tfound[name] = true\n \t\t\t\t\t}\n \t\t\t\t}\ndiff --git a/pose-mcp/internal/pose/closeout_review_policy.go b/pose-mcp/internal/pose/closeout_review_policy.go\nindex e93d6b0a..730eeef9 100644\n--- a/pose-mcp/internal/pose/closeout_review_policy.go\n+++ b/pose-mcp/internal/pose/closeout_review_policy.go\n@@ -289,37 +289,36 @@ func (s Store) currentCloseoutDecision(ref string, policy ReviewPolicy) (Closeou\n \t}\n \tscope, _ := ParseScopeRef(ref)\n \ts.protectCloseoutDecision(scope, &decision)\n-\tif !decision.Required && s.mandatoryHumanReview(scope.Kind, policy) {\n+\tif !decision.Required && s.mandatoryHumanReview(ref, scope.Kind, policy) {\n \t\tdecision.Required = true\n \t\tdecision.Reason += \"; a mandatory-human review is never dispensed\"\n \t}\n \treturn decision, nil\n }\n \n-// mandatoryHumanReview reports a scope kind whose policy or base profile asks\n-// for a human reviewer. No setting dispenses that review. A profile that\n-// cannot be read is treated as asking for it.\n-func (s Store) mandatoryHumanReview(kind string, policy ReviewPolicy) bool {\n+// mandatoryHumanReview reports a scope whose effective review plan asks for a\n+// human reviewer: the base profile, the overlays the plan selects for it with\n+// their cutoffs, and the protected baseline when the scope changes the review\n+// contract, exactly as the plan composes them. No setting dispenses that\n+// review. A plan that cannot be built is treated as asking for one, unless the\n+// policy names no profile for the kind, where no review can be asked at all.\n+func (s Store) mandatoryHumanReview(ref, kind string, policy ReviewPolicy) bool {\n \tif policy.ReviewerIndependence[kind] == \"mandatory-human\" {\n \t\treturn true\n \t}\n-\trefs := append([]string{}, policy.OverlayProfiles...)\n-\tif ref := policy.Profiles[kind]; ref != \"\" {\n-\t\trefs = append(refs, ref)\n+\tif policy.Profiles[kind] == \"\" {\n+\t\treturn false\n \t}\n-\t// An adopted overlay for this kind that can ask for a human counts\n-\t// whether or not its selector matches now: an exemption must not depend\n-\t// on a selection the review plan makes later.\n-\tfor _, ref := range refs {\n-\t\tprofile, _, err := s.loadReviewProfile(ref)\n-\t\tif err != nil {\n-\t\t\treturn true\n-\t\t}\n-\t\tif (profile.Scope == kind || profile.Scope == \"\" || ref == policy.Profiles[kind]) && profile.Independence == \"mandatory-human\" {\n-\t\t\treturn true\n-\t\t}\n+\tplanner := s\n+\tplanner.planWithoutCloseoutGate = true\n+\tplan, err := planner.ReviewPlan(ref)\n+\tif err != nil || plan.Independence == \"mandatory-human\" {\n+\t\treturn true\n \t}\n-\treturn false\n+\t// The plan composes the overlays' independence; the base profile's own is\n+\t// read from the profile the plan named.\n+\tbase, _, err := s.loadReviewProfile(plan.BaseProfile)\n+\treturn err != nil || base.Independence == \"mandatory-human\"\n }\n \n // closeoutReviewGate is the one place the readers of an approval ask whether\n@@ -410,9 +409,19 @@ func (s Store) protectCloseoutDecision(scope ScopeRef, decision *CloseoutReviewD\n \t\trestore(\"the protected baseline policy cannot be read: \" + err.Error())\n \t\treturn\n \t}\n-\tif !base.Enabled {\n+\tif !base.Enabled && !base.CloseoutReviewAdopted() {\n+\t\treturn\n+\t}\n+\tif base.ReviewerIndependence[scope.Kind] == \"mandatory-human\" {\n+\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires a mandatory-human review\")\n \t\treturn\n \t}\n+\tif ref := base.Profiles[scope.Kind]; ref != \"\" {\n+\t\tif profile, err := s.parseReviewProfileAt(guard.Revision, ref); err != nil || profile.Independence == \"mandatory-human\" {\n+\t\t\trestore(\"the protected baseline at \" + guard.Revision + \" requires a mandatory-human review or its profile cannot be read\")\n+\t\t\treturn\n+\t\t}\n+\t}\n \tif !base.CloseoutReviewAdopted() {\n \t\trestore(\"the protected baseline at \" + guard.Revision + \" keeps the legacy rule, under which this scope owes its review\")\n \t\treturn\n@@ -454,6 +463,16 @@ func (s Store) closeoutSubject(ref string) ([]string, string, []string, error) {\n \t\t\tgate = digestText(milestone.ExitGate)\n \t\t}\n \t}\n+\tif scope.Kind == \"roadmap\" {\n+\t\t// A roadmap's gate is its cut criteria; its milestones' gates are\n+\t\t// bound by their own receipts.\n+\t\tcriteria, problems := ParseRoadmapCriteria(*rm)\n+\t\traw, _ := json.Marshal(struct {\n+\t\t\tCriteria []RoadmapCriterion\n+\t\t\tProblems []string\n+\t\t}{criteria, problems})\n+\t\tgate = \"sha256:\" + digestHex(raw)\n+\t}\n \tmembers, diagnostics := s.closeoutCanonicalMembers(raws, project)\n \treturn members, gate, diagnostics, nil\n }\n@@ -511,7 +530,13 @@ func (s Store) closedByReceipt(ref string) (bool, error) {\n \tif s.closeoutReceiptStands(*receipt, policy) != nil {\n \t\treturn false, nil\n \t}\n-\treturn !s.milestoneReviewRefused(ref), nil\n+\t// The applicable verifier, as closeout asks it: a review recorded after\n+\t// the receipt, complete or not, is judged like any other.\n+\teval, err := s.reviewCheck(ref)\n+\tif err != nil {\n+\t\treturn false, nil\n+\t}\n+\treturn (eval.Approved || !eval.Required) && len(eval.Blockers) == 0, nil\n }\n \n // scopeReviewRecorded reports a review of the scope on file: a bundle or a\n@@ -602,18 +627,3 @@ func mustScope(ref string) ScopeRef {\n \tscope, _ := ParseScopeRef(ref)\n \treturn scope\n }\n-\n-// CloseoutRecoveryDecision decides a roadmap left done without its receipt,\n-// under the same rules as an open scope: the protected decision, and an\n-// exemption only when every input is known and no review is on file.\n-func (s Store) CloseoutRecoveryDecision(ref string) (CloseoutReviewDecision, bool, error) {\n-\tpolicy, _, err := s.loadReviewPolicy()\n-\tif err != nil {\n-\t\treturn CloseoutReviewDecision{}, false, err\n-\t}\n-\tdecision, err := s.currentCloseoutDecision(ref, policy)\n-\tif err != nil {\n-\t\treturn decision, false, err\n-\t}\n-\treturn decision, !decision.Required && decision.Known && !s.scopeReviewRecorded(ref), nil\n-}\n","exit_code":0,"status":"completed"}}
