{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 8e3009b2c7305cd94500009875ddc1b7880d8331 5690b25710615f5b0f9aba1f2642eaa6a917ccd9 -- pose-mcp/internal/pose/review_closeout.go pose-mcp/internal/pose/roadmaps.go pose-mcp/internal/pose/federated_acceptance.go pose-mcp/internal/pose/obligation_projection.go pose-mcp/internal/pose/review_bundle.go'","aggregated_output":"diff --git a/pose-mcp/internal/pose/federated_acceptance.go b/pose-mcp/internal/pose/federated_acceptance.go\nindex 93ff8452..f52c5aa7 100644\n--- a/pose-mcp/internal/pose/federated_acceptance.go\n+++ b/pose-mcp/internal/pose/federated_acceptance.go\n@@ -692,6 +692,18 @@ func federatedSourceProof(files Files, source Store, identity ArtifactRef, pinne\n \tif err != nil || !state.Terminal {\n \t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-not-terminal\"}\n \t}\n+\t// A milestone or roadmap the source closed without its own review, under\n+\t// its adopted closeout review policy, is proven by the receipt of that\n+\t// close: the source's policy decides, never the consumer's. Its members\n+\t// are federated with their own reviews (spec\n+\t// pose-closeout-review-policy-by-cost-benefit).\n+\tif receipt := state.CloseoutReceipt; receipt != nil && !receipt.Decision.Required && (identity.Kind == \"milestone\" || identity.Kind == \"roadmap\") {\n+\t\traw, err := json.Marshal(receipt)\n+\t\tif err != nil {\n+\t\t\treturn \"\", \"\", \"\", \"\", nil, nil, []string{scope + \":source-closeout-receipt-unreadable\"}\n+\t\t}\n+\t\treturn \"closeout-receipt:\" + scope, \"sha256:\" + digestHex(raw), receipt.SubjectDigest, receipt.PolicyDigest, nil, nil, nil\n+\t}\n \tverification, err := source.VerifyReviewBundle(scope)\n \t// A milestone its roadmap declares has no review of its own: what a consumer can\n \t// hold is the review of that roadmap, which sealed the declaration.\ndiff --git a/pose-mcp/internal/pose/obligation_projection.go b/pose-mcp/internal/pose/obligation_projection.go\nindex b12bb466..4d5b8497 100644\n--- a/pose-mcp/internal/pose/obligation_projection.go\n+++ b/pose-mcp/internal/pose/obligation_projection.go\n@@ -676,10 +676,23 @@ func (s Store) milestoneReachedObligations(project, scope string, coverage *Cove\n \t\tif err != nil {\n \t\t\treturn lost(err)\n \t\t}\n-\t\tmember, sole := s.soleMemberOf(parsed)\n-\t\towed := !recorded[ref] && !(sole && recorded[\"spec:\"+member]) && s.declaredUnreviewed(parsed) == \"\"\n-\t\tif !required || !owed && !refused[ref] {\n-\t\t\tcontinue\n+\t\tif policy.CloseoutReviewAdopted() {\n+\t\t\t// Under an adopted closeout review policy a reached milestone is\n+\t\t\t// closed only by its explicit close, which publishes a receipt,\n+\t\t\t// approved review or not (spec pose-closeout-review-policy-by-cost-benefit).\n+\t\t\tclosed, err := s.closedByReceipt(ref)\n+\t\t\tif err != nil {\n+\t\t\t\treturn lost(err)\n+\t\t\t}\n+\t\t\tif closed {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t} else {\n+\t\t\tmember, sole := s.soleMemberOf(parsed)\n+\t\t\towed := !recorded[ref] && !(sole && recorded[\"spec:\"+member]) && s.declaredUnreviewed(parsed) == \"\"\n+\t\t\tif !required || !owed && !refused[ref] {\n+\t\t\t\tcontinue\n+\t\t\t}\n \t\t}\n \t\tsource := QualifyNodeRef(project, ArtifactRef{Kind: \"milestone\", Slug: parsed.Roadmap, Milestone: parsed.Milestone}, \"\", \"\")\n \t\to := newObligation(project, \"closeout\", source, \"milestone-reached\", ref)\ndiff --git a/pose-mcp/internal/pose/review_bundle.go b/pose-mcp/internal/pose/review_bundle.go\nindex 355f8f37..a06be335 100644\n--- a/pose-mcp/internal/pose/review_bundle.go\n+++ b/pose-mcp/internal/pose/review_bundle.go\n@@ -1196,7 +1196,7 @@ func reviewBundlePathClass(path string, scope ScopeRef, components []ReviewPlanC\n \t\t// like the repository's own LICENSE and NOTICE (found in review).\n \t\treturn \"documentation\", true\n \t}\n-\tfor _, prefix := range []string{\".pose/state/\", \".pose/assessments/\", \".pose/reports/\", \".pose/results/\", \".pose/reviews/\", \".pose/review-bundles/\", \".pose/review-attestations/\", \".pose/review-attribution-supplements/\", \".pose/closeout-plans/\", \".pose/contributions/\", \".pose/feedback/\", \".pose/review-runs/\", \".pose/review-attempts/\", \".pose/review-run-ledger/\", \".pose/review-continuations/\", \".pose/review-private/\", \".pose/review-run-proofs/\", \".pose/delegate-runs/\", \".pose/review-conclusions/\", \".pose/adjudications/\", \".pose/events/\", \".pose/investigations/\"} {\n+\tfor _, prefix := range []string{\".pose/state/\", \".pose/assessments/\", \".pose/reports/\", \".pose/results/\", \".pose/reviews/\", \".pose/review-bundles/\", \".pose/review-attestations/\", \".pose/review-attribution-supplements/\", \".pose/closeout-plans/\", \".pose/contributions/\", \".pose/feedback/\", \".pose/review-runs/\", \".pose/review-attempts/\", \".pose/review-run-ledger/\", \".pose/review-continuations/\", \".pose/review-private/\", \".pose/review-run-proofs/\", \".pose/delegate-runs/\", \".pose/review-conclusions/\", \".pose/review-closeouts/\", \".pose/adjudications/\", \".pose/events/\", \".pose/investigations/\"} {\n \t\tif strings.HasPrefix(path, prefix) {\n \t\t\treturn \"derived-evidence\", false\n \t\t}\n@@ -3456,17 +3456,43 @@ func (s Store) proportionalReviewVerification(scope string) (ReviewBundleVerific\n \t\treturn own, err\n \t}\n \tref, parseErr := ParseScopeRef(scope)\n-\tif parseErr != nil || ref.Kind != \"milestone\" {\n+\tif parseErr != nil || (ref.Kind != \"milestone\" && ref.Kind != \"roadmap\") {\n \t\treturn own, nil\n \t}\n \t// A policy without bundles answers through its review attempts alone, and has no\n \t// bundle of the spec to stand on.\n-\tif policy, err := s.GetReviewPolicy(); err != nil || !policy.ReviewBundles {\n+\tpolicy, err := s.GetReviewPolicy()\n+\tif err != nil || !policy.ReviewBundles {\n \t\treturn own, nil\n \t}\n \tif s.milestoneReviewRefused(scope) {\n \t\treturn own, nil\n \t}\n+\t// An adopted closeout review policy is the only rule for an open scope:\n+\t// legacy inheritance and declared exemptions cannot weaken `always`, and\n+\t// the policy's own exemption reads the same gate as reviewCheck. A roadmap\n+\t// closed before adoption keeps the legacy reading below.\n+\tadopted := policy.CloseoutReviewAdopted() && !s.closeoutScopeHistorical(ref)\n+\tif adopted {\n+\t\tdecision, exempt, gateErr := s.closeoutReviewGate(scope, policy)\n+\t\tif gateErr != nil || decision == nil || !exempt || !decision.Known {\n+\t\t\treturn own, nil\n+\t\t}\n+\t\tif ref.Kind == \"milestone\" && s.FederatedResolver != nil {\n+\t\t\tacceptance, err := s.FederatedMilestoneAcceptance(s.FederatedProjectID, ref.Roadmap, ref.Milestone, *s.FederatedResolver)\n+\t\t\tif err != nil || !acceptance.Ready {\n+\t\t\t\treturn own, nil\n+\t\t\t}\n+\t\t}\n+\t\treturn ReviewBundleVerification{\n+\t\t\tScope: scope, State: \"closed\", Fresh: true, Approved: true, NextAction: \"none\",\n+\t\t\tWarnings:       []string{closeoutExemptionWarning(scope, *decision)},\n+\t\t\tApprovalOrigin: closeoutApprovalOrigin(*decision), inherited: true,\n+\t\t}, nil\n+\t}\n+\tif ref.Kind != \"milestone\" {\n+\t\treturn own, nil\n+\t}\n \t// Edges still bind: a milestone inherits a review, not the acceptance of what it\n \t// depends on, and revoked trust or an open predecessor leaves it where it was.\n \tif s.FederatedResolver != nil {\ndiff --git a/pose-mcp/internal/pose/review_closeout.go b/pose-mcp/internal/pose/review_closeout.go\nindex 8c4bfe79..c9bf55e5 100644\n--- a/pose-mcp/internal/pose/review_closeout.go\n+++ b/pose-mcp/internal/pose/review_closeout.go\n@@ -29,6 +29,13 @@ const QualifiedArtifactPolicySchemaVersion = 3\n // refused by older engines so they cannot silently operate on transfer state.\n const SpecAuthorityTransferPolicySchemaVersion = 4\n \n+// CloseoutReviewPolicySchemaVersion carries milestone_review_required and\n+// roadmap_review_required 