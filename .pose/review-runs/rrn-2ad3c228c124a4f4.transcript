tf(stderr, \"pose continuous-closeout: %v\\n\", err)\n2270:\t\t\tfmt.Fprintln(stderr, \"pose continuous-closeout: an active terminal scope already exists\")\n2274:\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: %v\\n\", err)\n2277:\t\tfmt.Fprintf(stdout, \"Continuous closeout started: %s\\n\", ref)\n2285:\t\t\t\tfmt.Fprintln(stderr, \"Usage: pose continuous-closeout status [--json]\")\n2290:\t\tresult := continuousCloseoutStatus(root, path)\n2297:\t\t\tfmt.Fprintln(stderr, \"pose continuous-closeout: \"+result.Error.Message)\n2311:\t\t\tfmt.Fprintln(stderr, \"Usage: pose continuous-closeout complete --apply\")\n2316:\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: %v\\n\", err)\n2319:\t\tvar selection continuousCloseoutSelection\n2321:\t\t\tfmt.Fprintln(stderr, \"pose continuous-closeout: invalid persisted selection\")\n2324:\t\tstate, err := cliCloseoutState(root, selection.Scope)\n2326:\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: terminal success is not satisfied; next action: %s\\n\", state.NextAction)\n2330:\t\t\tfmt.Fprintf(stderr, \"pose continuous-closeout: %v\\n\", err)\n2333:\t\tfmt.Fprintf(stdout, \"Continuous closeout completed: %s\\n\", selection.Scope)\n2336:\t\tfmt.Fprintln(stderr, \"Usage: pose continuous-closeout <start|status|complete> [...]\")\n2341:func hasOpenChild(children []posemodel.CloseoutState) bool {\n2406:// the closeout.\n2432:// or a review the adopted closeout review policy does not require.\n2433:func closeReviewSatisfied(state posemodel.CloseoutState) bool {\n2434:\treturn state.Review.Approved || state.Review.CloseoutReview != nil && !state.Review.Required\n2437:// closeoutReceiptPreflight decides whether this close publishes a receipt.\n2443:func closeoutReceiptPreflight(store posemodel.Store, ref string, scope posemodel.ScopeRef, state *posemodel.CloseoutState, stdout, stderr io.Writer) (*posemodel.CloseoutReviewDecision, int) {\n2452:\tif !policy.CloseoutReviewAdopted() {\n2455:\tif state.CloseoutReceipt != nil {\n2466:\t\treceipt := state.CloseoutReceipt\n2467:\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; closeout receipt of \"+receipt.ClosedAt+\" stands (review: \"+receipt.Review+\"); applicable terminal verifier passed; no transition executed\")\n2470:\tdecision := state.Review.CloseoutReview\n2480:\t\t\trender(stdout, stderr).Field(\"close.already-satisfied\", ref+\"; closed before the closeout review policy was adopted; its sealed contract verifies; no transition executed\")\n2486:\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout review of \" + ref + \" cannot be decided: \" + strings.Join(decision.Diagnostics, \"; \"))\n2499:// verifyCloseoutPublication judges the whole authorization once more inside\n2501:// associations, and a closeout state still eligible. It returns that state,\n2503:func verifyCloseoutPublication(store posemodel.Store, ref string, decision posemodel.CloseoutReviewDecision, guard func() error, stderr io.Writer) (posemodel.CloseoutState, int) {\n2507:\t\t\treturn posemodel.CloseoutState{}, 1\n2510:\tchanged := func(why string) (posemodel.CloseoutState, int) {\n2511:\t\trender(io.Discard, stderr).Failure(\"pose close: the closeout of \" + ref + \" changed while its gates ran (\" + why + \"); run `pose close \" + ref + \"` again\")\n2512:\t\treturn posemodel.CloseoutState{}, 1\n2514:\tcurrent, err := store.CurrentCloseoutDecision(ref)\n2517:\t\treturn posemodel.CloseoutState{}, 1\n2523:\tstate, err := cliCloseoutStateForStore(store, ref)\n2526:\t\treturn posemodel.CloseoutState{}, 1\n2528:\tif state.CloseoutReceipt != nil {\n2543:// publishCloseoutReceipt publishes the receipt of a close from the state the\n2545:func publishCloseoutReceipt(store posemodel.Store, ref string, decision posemodel.CloseoutReviewDecision, judged posemodel.CloseoutState, stdout, stderr io.Writer) int {\n2546:\treceipt, err := store.NewCloseoutReceipt(ref, decision, judged.Review, judged.ScopeDigest, time.Now())\n2551:\tif err := store.PublishCloseoutReceipt(receipt); err != nil {\n2555:\t\t\trender(io.Discard, stderr).Failure(\"pose close: closeout receipt not published: \" + err.Error() + \"; `pose close \" + ref + \"` verifies again and publishes it\")\n2559:\tif err := store.ClearCloseoutIntent(ref); err != nil {\n","exit_code":0,"status":"completed"}}
