{"type":"item.completed","item":{"id":"item_84","type":"command_execution","command":"/usr/bin/bash -lc \"rg -n 'parseReviewPolicy.*|Profiles|profiles' pose-mcp/internal/pose/review_closeout.go\"","aggregated_output":"115:// because the distributed profiles predate the field — `spec-closeout` has five\n197:\tProfiles                         map[string]string `json:\"profiles\"`\n209:\tOverlayProfiles                  []string          `json:\"overlay_profiles,omitempty\"`\n665:\tpolicy, err := s.parseReviewPolicy(raw)\n672:// parseReviewPolicy validates policy bytes whatever their source. The\n676:func (s Store) parseReviewPolicy(raw []byte) (ReviewPolicy, error) {\n726:\t\tfor _, overlay := range p.OverlayProfiles {\n730:\t\t\treturn ReviewPolicy{}, fmt.Errorf(\"pose: overlay_adopted_at dates %q, which overlay_profiles does not list\", ref)\n871:\tpath := filepath.Join(s.Root, \".pose\", \"review-profiles\", parts[0]+\".json\")\n929:\t\t// profiles keep their historical namespaces so repositories that never\n1039:\tprofileRef := policy.Profiles[scope.Kind]\n1350:\tprofileRef := policy.Profiles[scope.Kind]\n1549:\tprofileRef := policy.Profiles[scope.Kind]\n","exit_code":0,"status":"completed"}}
