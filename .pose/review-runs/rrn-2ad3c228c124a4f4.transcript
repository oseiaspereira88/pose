{"type":"item.completed","item":{"id":"item_104","type":"command_execution","command":"/usr/bin/bash -lc 'git diff 8e3009b2c7305cd94500009875ddc1b7880d8331 5690b25710615f5b0f9aba1f2642eaa6a917ccd9 -- pose-mcp/internal/cli/doctor.go pose-mcp/internal/pose/artifact_ref.go pose-mcp/internal/pose/spec_transfer.go pose-mcp/internal/cli/release_compatibility_test.go'","aggregated_output":"diff --git a/pose-mcp/internal/cli/doctor.go b/pose-mcp/internal/cli/doctor.go\nindex 8944a53d..4e1d0789 100644\n--- a/pose-mcp/internal/cli/doctor.go\n+++ b/pose-mcp/internal/cli/doctor.go\n@@ -262,6 +262,7 @@ func runDoctorDiagnostics(locale cliLocale) (root string, findings []doctorFindi\n \t}\n \tadd(\"instance.pose-dir\", \"ok\", text(\".pose/ present\", \".pose/ presente\"), \"\")\n \tdiagnoseProjectState(root, add, text)\n+\tdiagnoseCloseoutReviewPolicy(root, add, text)\n \tdiagnoseReviewContinuity(root, add)\n \n \t// 3. Native engine contract.\n@@ -1574,3 +1575,27 @@ func declaredMCPProjectID(raw []byte) string {\n \tid, _ := doc.MCPServers[\"pose\"].Env[\"POSE_DEFAULT_PROJECT_ID\"].(string)\n \treturn id\n }\n+\n+// diagnoseCloseoutReviewPolicy reports open milestones and roadmaps that owe\n+// their own review under the adopted closeout review policy, because of the\n+// policy or of their composition (spec pose-closeout-review-policy-by-cost-benefit\n+// R6). It only reports: `pose close` remains the gate.\n+func diagnoseCloseoutReviewPolicy(root string, add func(string, string, string, string), text func(string, string) string) {\n+\tstore := posemodel.Store{Root: root}\n+\tpolicy, err := store.GetReviewPolicy()\n+\tif err != nil || !policy.CloseoutReviewAdopted() {\n+\t\treturn\n+\t}\n+\towing, err := store.CloseoutReviewsOwed()\n+\tif err != nil {\n+\t\tadd(\"closeout-review.owed\", \"warn\", fmt.Sprintf(text(\"open scopes owing a closeout review could not be listed: %v\", \"escopos abertos que devem revisão de fechamento não puderam ser listados: %v\"), err), text(\"run `pose closeout-check <scope>` for each open milestone and roadmap\", \"rode `pose closeout-check <escopo>` para cada milestone e roadmap aberto\"))\n+\t\treturn\n+\t}\n+\tif len(owing) == 0 {\n+\t\tadd(\"closeout-review.owed\", \"ok\", fmt.Sprintf(text(\"no open scope owes a review it lacks (milestone_review_required=%s, roadmap_review_required=%s)\", \"nenhum escopo aberto deve uma revisão que não tem (milestone_review_required=%s, roadmap_review_required=%s)\"), policy.MilestoneReviewRequired, policy.RoadmapReviewRequired), \"\")\n+\t\treturn\n+\t}\n+\tfor _, item := range owing {\n+\t\tadd(\"closeout-review.owed\", \"warn\", fmt.Sprintf(text(\"%s owes its own review: %s=%s, %s; previous rule %s\", \"%s deve revisão própria: %s=%s, %s; regra anterior %s\"), item.Scope, item.Decision.PolicyKey, item.Decision.PolicyValue, item.Decision.Reason, item.Previous), item.Action)\n+\t}\n+}\ndiff --git a/pose-mcp/internal/cli/release_compatibility_test.go b/pose-mcp/internal/cli/release_compatibility_test.go\nindex d6200e08..e5a727f2 100644\n--- a/pose-mcp/internal/cli/release_compatibility_test.go\n+++ b/pose-mcp/internal/cli/release_compatibility_test.go\n@@ -62,6 +62,34 @@ func TestPreviousReleaseReadsThisEnginesReviewPolicy(t *testing.T) {\n \t\tt.Fatal(err)\n \t}\n \n+\t// A fresh install adopts the closeout review policy, review policy schema\n+\t// 5, which older engines refuse by design (ADR\n+\t// closeout-review-policy-by-cost-and-benefit): they must not read an\n+\t// adopted exemption as the legacy rule. The refusal has to be the clean\n+\t// schema refusal, never a misread of another field.\n+\tvar written map[string]any\n+\tif err := json.Unmarshal(original, &written); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif _, adopted := written[\"milestone_review_required\"]; adopted {\n+\t\tif out := runRelease(t, prev, instance); mentionsPolicy(out) && !strings.Contains(out, \"unsupported review policy schema 5\") {\n+\t\t\tt.Fatalf(\"%s refused the schema-5 policy for another reason than its schema:\\n%s\", tag, out)\n+\t\t}\n+\t\t// What an update leaves behind stays readable: a policy that has not\n+\t\t// adopted the pair keeps its schema, and update never adopts it.\n+\t\twritePolicyWith(t, policy, func(p map[string]any) {\n+\t\t\tdelete(p, \"milestone_review_required\")\n+\t\t\tdelete(p, \"roadmap_review_required\")\n+\t\t\tp[\"schema_version\"] = 2\n+\t\t})\n+\t\tif code, out := runPose(t, instance, \"update\", \"--no-self\", \"--force\"); code != 0 {\n+\t\t\tt.Fatalf(\"update of the legacy instance: %d %s\", code, out)\n+\t\t}\n+\t\tupdated, _ := os.ReadFile(policy)\n+\t\tif strings.Contains(string(updated), \"milestone_review_required\") {\n+\t\t\tt.Fatalf(\"pose update adopted the closeout review policy:\\n%s\", updated)\n+\t\t}\n+\t}\n \tif out := runRelease(t, prev, instance); mentionsPolicy(out) {\n \t\tt.Fatalf(\"%s cannot read the review policy v%s writes, so an instance updated to v%s stops working for anyone still on %s:\\n%s\",\n \t\t\ttag, version.ReleaseBase(), version.ReleaseBase(), tag, out)\ndiff --git a/pose-mcp/internal/pose/artifact_ref.go b/pose-mcp/internal/pose/artifact_ref.go\nindex 22fc3d8a..f9f09763 100644\n--- a/pose-mcp/internal/pose/artifact_ref.go\n+++ b/pose-mcp/internal/pose/artifact_ref.go\n@@ -201,7 +201,13 @@ func (r ArtifactResolver) resolve(localProject, raw string, redirectPath map[str\n \t\trefsRequired := policy.SchemaVersion == QualifiedArtifactPolicySchemaVersion || policy.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion\n \t\ttransferValid := policy.SchemaVersion == SpecAuthorityTransferPolicySchemaVersion && policy.TransferVersion == 1 || policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && policy.TransferVersion == 0\n \t\trefsCompatible := policy.RefsVersion == 0 || policy.RefsVersion == 1 && refsRequired\n-\t\tif !refsCompatible || refsRequired && policy.RefsVersion != 1 || policy.SchemaVersion > SpecAuthorityTransferPolicySchemaVersion || !transferValid {\n+\t\tif policy.SchemaVersion == CloseoutReviewPolicySchemaVersion {\n+\t\t\t// Schema 5 (closeout review pair) keeps references and transfer\n+\t\t\t// optional: 0, or 1 as schemas 3 and 4 define them.\n+\t\t\trefsCompatible = policy.RefsVersion == 0 || policy.RefsVersion == 1\n+\t\t\ttransferValid = policy.TransferVersion == 0 || policy.TransferVersion == 1 && policy.RefsVersion == 1\n+\t\t}\n+\t\tif !refsCompatible || refsRequired && policy.RefsVersion != 1 || policy.SchemaVersion > CloseoutReviewPolicySchemaVersion || !transferValid {\n \t\t\tout.State = \"unsupported-artifact-contract\"\n \t\t\treturn out\n \t\t}\ndiff --git a/pose-mcp/internal/pose/spec_transfer.go b/pose-mcp/internal/pose/spec_transfer.go\nindex 09ae1fe4..1fd62349 100644\n--- a/pose-mcp/internal/pose/spec_transfer.go\n+++ b/pose-mcp/internal/pose/spec_transfer.go\n@@ -528,7 +528,7 @@ func requireSpecTransferCapability(files Files, store Store) error {\n \tif err != nil {\n \t\treturn specTransferError(\"unsupported-policy\")\n \t}\n-\tif policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion || policy.QualifiedArtifactRefsVersion != 1 || policy.SpecAuthorityTransferVersion != 1 {\n+\tif (policy.SchemaVersion != SpecAuthorityTransferPolicySchemaVersion && policy.SchemaVersion != CloseoutReviewPolicySchemaVersion) || policy.QualifiedArtifactRefsVersion != 1 || policy.SpecAuthorityTransferVersion != 1 {\n \t\treturn specTransferError(\"spec-authority-transfer-capability-not-adopted\")\n \t}\n \treturn nil\n","exit_code":0,"status":"completed"}}
