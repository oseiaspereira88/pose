{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/usr/bin/bash -lc \"git diff --check dec2e64c..bae831df -- pose-mcp/internal/cli/validate.go pose-mcp/internal/cli/validate_carry.go pose-mcp/internal/cli/validate_scope.go; git status --short; nl -ba pose-mcp/internal/cli/validate_carry.go | sed -n '670,750p'; rg -n 'F1:|F2:' .pose/specs/*pose-validate-carries-unchanged-checks.md\"","aggregated_output":"   670\tfunc validationMaterialClean(root, head string) bool {\n   671\t\tif !materialWorktreeClean(root) {\n   672\t\t\treturn false\n   673\t\t}\n   674\t\tif hidden, err := hiddenIndexEntries(root, head); err != nil || hidden != \"\" {\n   675\t\t\treturn false\n   676\t\t}\n   677\t\tif submodulesCheckedOut(root, head) != \"\" {\n   678\t\t\treturn false\n   679\t\t}\n   680\t\t// Nested submodules are neither witnessed nor checked: a run over them\n   681\t\t// cannot claim its recorded material (review round 16, N48).\n   682\t\tlinks, err := gitlinks(root, head)\n   683\t\tif err != nil {\n   684\t\t\treturn false\n   685\t\t}\n   686\t\tfor sub, commit := range links {\n   687\t\t\tnested, err := gitlinks(filepath.Join(root, filepath.FromSlash(sub)), commit)\n   688\t\t\tif err != nil || len(nested) > 0 {\n   689\t\t\t\treturn false\n   690\t\t\t}\n   691\t\t}\n   692\t\treturn true\n   693\t}\n   694\t\n   695\t// finalizeCancellation records a cancelled run: not clean, and binding no\n   696\t// material, whatever was decided before the signal was seen (review round 16,\n   697\t// N47). It returns true for the run's cancelled field.\n   698\tfunc finalizeCancellation(run *validationRunResult) bool {\n   699\t\trun.MaterialClean = false\n   700\t\tfor spec := range run.MaterialProvenance {\n   701\t\t\trun.MaterialProvenance[spec] = posemodel.MaterialBindingUnavailable\n   702\t\t}\n   703\t\treturn true\n   704\t}\n   705\t\n   706\t// workingFileDiffersFromHead reports whether rel in the working copy differs\n   707\t// from its blob at head; absent on both sides is equal.\n   708\tfunc workingFileDiffersFromHead(root, head, rel string) (bool, error) {\n   709\t\tworking, werr := os.ReadFile(filepath.Join(root, filepath.FromSlash(rel)))\n   710\t\tcommitted, cerr := posemodel.RawGit(\"-C\", root, \"show\", head+\":\"+rel).Output()\n   711\t\tswitch {\n   712\t\tcase errors.Is(werr, os.ErrNotExist) && cerr != nil:\n   713\t\t\treturn false, nil\n   714\t\tcase werr != nil || cerr != nil:\n   715\t\t\treturn true, nil\n   716\t\t}\n   717\t\treturn !bytes.Equal(working, committed), nil\n   718\t}\n   719\t\n   720\t// movementWitness summarizes the reflog lengths of HEAD and of every\n   721\t// checked-out submodule's HEAD; \"\" when any cannot be read, so the witness\n   722\t// never passes by default.\n   723\tfunc movementWitness(root, head string) string {\n   724\t\tparent := headReflogLength(root)\n   725\t\tif parent < 0 || head == \"\" {\n   726\t\t\treturn \"\"\n   727\t\t}\n   728\t\tparts := []string{fmt.Sprintf(\".=%d\", parent)}\n   729\t\tlinks, err := gitlinks(root, head)\n   730\t\tif err != nil {\n   731\t\t\treturn \"\"\n   732\t\t}\n   733\t\tsubs := make([]string, 0, len(links))\n   734\t\tfor sub := range links {\n   735\t\t\tsubs = append(subs, sub)\n   736\t\t}\n   737\t\tsort.Strings(subs)\n   738\t\tfor _, sub := range subs {\n   739\t\t\trepo := filepath.Join(root, filepath.FromSlash(sub))\n   740\t\t\tif _, err := os.Stat(filepath.Join(repo, \".git\")); err != nil {\n   741\t\t\t\tparts = append(parts, sub+\"=absent\")\n   742\t\t\t\tcontinue\n   743\t\t\t}\n   744\t\t\tn := headReflogLength(repo)\n   745\t\t\tif n < 0 {\n   746\t\t\t\treturn \"\"\n   747\t\t\t}\n   748\t\t\tparts = append(parts, fmt.Sprintf(\"%s=%d\", sub, n))\n   749\t\t}\n   750\t\treturn strings.Join(parts, \",\")\n253:- [open] F1: cover with an end-to-end test that a review bundle sealed over a carried record judges the carried head (seal, verify and closeout-check on a fixture). (owner:@pose-maintainers crit:low review:2026-12-15)\n254:- [open] F2: `--carry --report` lists carried checks as executed commands without their `carried_from` head and time; exclude them from the executed summary and label reused results (review round 13, N39). (owner:@pose-maintainers crit:low review:2026-12-15)\n","exit_code":0,"status":"completed"}}
