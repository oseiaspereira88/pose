'/usr/bin/bash' -c 'file /home/go/.local/bin/pose; ps -eo pid,ppid,etime,args | rg '\"'\"'pose artifact|pose suggest|pose validate|go test|go vet|pose-review-run|go build'\"'\"''\n      2       1       00:00 /usr/bin/bash -c file /home/go/.local/bin/pose; ps -eo pid,ppid,etime,args | rg 'pose artifact|pose suggest|pose validate|go test|go vet|pose-review-run|go build'\n      5       2       00:00 rg pose artifact|pose suggest|pose validate|go test|go vet|pose-review-run|go build\n","exit_code":0,"status":"completed"}}
