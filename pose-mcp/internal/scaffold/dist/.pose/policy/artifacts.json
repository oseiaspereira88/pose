{
  "schema_version": 1,
  "enabled": true,
  "adopted_at": "2026-08-03",
  "governed_roots": [
    ".agents/skills",
    ".github/workflows",
    ".pose/templates",
    ".pose/workflows",
    "docs-site/docs",
    "pose-mcp/internal",
    "scripts"
  ],
