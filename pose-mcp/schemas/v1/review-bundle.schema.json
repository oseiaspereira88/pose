{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pose.dev/schemas/v1/review-bundle.schema.json",
  "title": "POSE sealed review bundle",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "bundle_id", "bundle_digest", "state", "payload"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"type": "string", "pattern": "^rvb-[a-f0-9]{16}$"},
    "bundle_digest": {"$ref": "#/$defs/digest"},
    "state": {"enum": ["prepared", "sealed", "superseded", "attested"]},
    "sealed_at": {"type": "string", "format": "date-time"},
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["scope", "subject", "plan", "evidence", "consumed_inputs"],
      "properties": {
        "scope": {"type": "object", "properties": {"remediates": {"type": "array", "items": {"type": "string"}}}},
        "subject": {
          "type": "object",
          "required": ["change_sets", "patch_digest", "tree_digest", "entries"],
          "properties": {
            "change_sets": {"type": "array", "items": {"type": "string"}},
            "implementation_digest": {"$ref": "#/$defs/digest"},
            "patch_digest": {"$ref": "#/$defs/digest"},
            "tree_digest": {"$ref": "#/$defs/digest"},
            "entries": {"type": "array", "items": {"type": "object"}}
          }
        },
        "plan": {
          "type": "object",
          "required": ["plan_digest", "independence", "components", "criteria", "tools"],
          "properties": {"plan_digest": {"$ref": "#/$defs/digest"}}
        },
        "gates": {
          "type": "object",
          "properties": {
            "identity_assurance": {"enum": ["declared", "verified"]}
          }
        },
        "evidence": {"type": "array", "items": {"type": "object", "properties": {"subject_observation": {"type": "string", "enum": ["observed", "carried-forward", "unknown"]}}}},
        "children": {"type": "array", "items": {"type": "object"}},
        "consumed_inputs": {"type": "array", "items": {"type": "object"}}
      }
    },
    "excluded_inputs": {"type": "array", "items": {"type": "object"}}, "range_observations": {"type": "array", "items": {"type": "object", "required": ["change_set", "state"], "properties": {"change_set": {"type": "string"}, "state": {"type": "string", "enum": ["clean", "contaminated", "unknown"]}}}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "path": {"type": "string"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
